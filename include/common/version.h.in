#ifndef INCLUDE_COMMON_VERSION_H_
#define INCLUDE_COMMON_VERSION_H_

#include <string>

namespace vocconv {
namespace version {

constexpr char kGitRevision[] = "@GIT_SHA1@";
constexpr char kGitBranch[] = "@GIT_REFSPEC@";
constexpr char kGitStatus[] = "@GIT_STATUS@";
constexpr char kBuildTime[] = "@BUILD_TIME@";

const std::string GitBranch() {
    return kGitBranch;
}

const std::string GitRevision() {
    return std::string(kGitRevision) + " " + std::string(kGitStatus);
}

const std::string BuildTime() {
    return kBuildTime;
}

}  // namepsace version
}  // namespace vocconv

#endif  // INCLUDE_COMMON_VERSION_H_
/** \} */  // end of addtogroup
