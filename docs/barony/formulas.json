{
  "version": 1,
  "items": [
    {
      "id": "domain.summary",
      "title": "Barony Summary (Domain Panel grand total)",
      "category": "domain-panel",
      "implementation": "BaronyCalc.SummarizeSections / PpbMath.Summarize",
      "notes": "All Domain Panel sections contribute Additive and Percent. final = Σ Additive + SumScalableAdditive × (Σ Percent / 100). Scalable = positive Additive per row (negative for Corruption). No separate base row.",
      "formula": "final = Σadd + scalable_add × (Σpct / 100)"
    },
    {
      "id": "terrain.village.unfortified",
      "title": "Unfortified Village",
      "category": "terrain-improvement",
      "implementation": "DA_Common/Barony/VillagePpbFormulas.cs",
      "additive": {
        "Food": "farmYield(Fertility) - Population",
        "Economy": "Population / 2",
        "Production": "Population",
        "Loyalty": "-Population",
        "Stability": "-2 * Population",
        "Law": "-Population / 2",
        "Corruption": "Population / 4",
        "Science": "Population / 4",
        "Magic": "Population / 8",
        "Culture": "Population / 4",
        "Defense": "Population",
        "Treasury": "(Nob%/100)*Population*5 + (Burg%/100)*Population*5 + (Peas%/100)*Population*15"
      }
    },
    {
      "id": "terrain.village.fortified",
      "title": "Village with palisade",
      "category": "terrain-improvement",
      "implementation": "DA_Common/Barony/VillagePpbFormulas.cs",
      "notes": "Same as unfortified except Stability +3, Law +1, Defense +5 when HasPalisade.",
      "additive": {
        "Food": "farmYield(Fertility) - Population",
        "Economy": "Population / 2",
        "Production": "Population",
        "Loyalty": "-Population",
        "Stability": "-2 * Population + 3",
        "Law": "-Population / 2 + 1",
        "Corruption": "Population / 4",
        "Science": "Population / 4",
        "Magic": "Population / 8",
        "Culture": "Population / 4",
        "Defense": "Population + 5",
        "Treasury": "(Nob%/100)*Population*5 + (Burg%/100)*Population*5 + (Peas%/100)*Population*15"
      }
    },
      "title": "Town",
      "category": "terrain-improvement",
      "implementation": "DA_Common/Barony/TownPpbFormulas.cs",
      "additive": {
        "Food": "-Population",
        "Economy": "Population",
        "Production": "2 * Population",
        "Loyalty": "-2 * Population",
        "Stability": "-3 * Population",
        "Law": "-Population",
        "Corruption": "Population",
        "Science": "Population / 2",
        "Magic": "Population / 4",
        "Culture": "Population / 2",
        "Defense": "2 * Population",
        "Treasury": "(Nob%/100)*Population*20 + (Burg%/100)*Population*25 + (Peas%/100)*Population*10"
      }
    },
    {
      "id": "community.hunger",
      "title": "Hunger",
      "category": "community-penalty",
      "implementation": "DA_Common/Barony/HungerPpbFormulas.cs",
      "input": "Hunger = max(0, -FoodBalance)",
      "additive": {
        "Loyalty": "-Hunger * 3",
        "Stability": "-Hunger * 3",
        "Law": "-Hunger * 2",
        "Corruption": "Hunger * 1"
      },
      "percent": {
        "Economy": "max(-Hunger * 10, -50)",
        "Production": "max(-Hunger * 10, -50)"
      }
    },
    {
      "id": "community.crime",
      "title": "Crime",
      "category": "community-penalty",
      "implementation": "DA_Common/Barony/CrimePpbFormulas.cs",
      "input": "Crime = max(0, -LawBalance)",
      "additive": {
        "Loyalty": "-Crime * 1",
        "Stability": "-Crime * 2",
        "Corruption": "Crime / 2"
      },
      "percent": {
        "Economy": "max(-Crime * 5, -50)",
        "Production": "max(-Crime * 5, -50)"
      }
    },
    {
      "id": "community.corruption",
      "title": "Corruption",
      "category": "community-penalty",
      "implementation": "DA_Common/Barony/CorruptionPpbFormulas.cs",
      "input": "Corruption = max(0, CorruptionBalance)",
      "additive": {
        "Loyalty": "-Corruption * 2",
        "Stability": "-Corruption * 1"
      },
      "percent": {
        "Economy": "max(-Corruption * 5, -50)",
        "Production": "max(-Corruption * 5, -50)"
      }
    },
    {
      "id": "community.unrest",
      "title": "Unrest",
      "category": "community-penalty",
      "implementation": "DA_Common/Barony/UnrestPpbFormulas.cs",
      "input": "Unrest = Barony.Unrest",
      "additive": {
        "Loyalty": "-Unrest * 3",
        "Stability": "-Unrest * 3",
        "Law": "-Unrest * 3"
      },
      "percent": {
        "Economy": "-Unrest * 15",
        "Production": "-Unrest * 15"
      }
    },
    {
      "id": "community.economy",
      "title": "Economy (conjuncture)",
      "category": "community-penalty",
      "implementation": "DA_Common/Barony/EconomyConjunctureFormulas.cs",
      "notes": "Economy = Economy additive before Community rows. Population = settlement population (towns + city buildings + villages). Conjuncture = 2d6 turn roll + MG modifier. Net Gold profit is additive; % applies to Gold, Production, Loyalty, Stability, Magic, Culture, Science, Defense.",
      "inputs": [
        {
          "name": "Economy",
          "type": "decimal",
          "description": "Sum of Economy additive from sections before Community"
        },
        {
          "name": "Population",
          "type": "int",
          "min": 0,
          "description": "Settlement population"
        },
        {
          "name": "Conjuncture",
          "type": "int",
          "description": "ConjunctureDice + ConjunctureModifier"
        }
      ],
      "additive": {
        "Treasury": "(Economy + Conjuncture) * 2"
      },
      "percent": {
        "Treasury": "clamp(50 * (Economy / (2 * Population) - 1) + (Conjuncture - 7), -40, 40)",
        "Production": "clamp(50 * (Economy / (2 * Population) - 1) + (Conjuncture - 7), -40, 40)",
        "Loyalty": "clamp(50 * (Economy / (2 * Population) - 1) + (Conjuncture - 7), -40, 40)",
        "Stability": "clamp(50 * (Economy / (2 * Population) - 1) + (Conjuncture - 7), -40, 40)",
        "Magic": "clamp(50 * (Economy / (2 * Population) - 1) + (Conjuncture - 7), -40, 40)",
        "Culture": "clamp(50 * (Economy / (2 * Population) - 1) + (Conjuncture - 7), -40, 40)",
        "Science": "clamp(50 * (Economy / (2 * Population) - 1) + (Conjuncture - 7), -40, 40)",
        "Defense": "clamp(50 * (Economy / (2 * Population) - 1) + (Conjuncture - 7), -40, 40)"
      }
    },
    {
      "id": "budget.liege-tribute",
      "title": "Liege tribute (Fief dues)",
      "category": "budget",
      "implementation": "DA_Common/Barony/FiefTributeFormulas.cs",
      "notes": "Barons pay their senior a share of gross gold income before expenses. Rate stored on Barony.LiegeTributePercent (MG-editable on Budget). Treasury turn balance = Domain Panel Final Gold − Tribute.",
      "inputs": [
        {
          "name": "GrossIncome",
          "type": "decimal",
          "description": "Domain Panel positive Gold income including % remainder, before expenses"
        },
        {
          "name": "LiegeTributePercent",
          "type": "decimal",
          "min": 0,
          "max": 100,
          "description": "Default 15"
        }
      ],
      "additive": {
        "Treasury": "-GrossIncome * (LiegeTributePercent / 100)"
      }
    },
    {
      "id": "budget.vassal-fief-dues",
      "title": "Vassal fief dues (village gold)",
      "category": "budget",
      "implementation": "DA_Common/Barony/FiefTributeFormulas.cs",
      "notes": "Villages on vassal fiefs contribute only this share of their gold to the baron. Rate stored on Barony.VassalTributePercent (MG-editable on Budget). Applied in BaronyCalc.ImprovementRows; other village PPB unchanged.",
      "inputs": [
        {
          "name": "FullVillageGold",
          "type": "decimal",
          "description": "Village Additive Treasury before vassal share"
        },
        {
          "name": "VassalTributePercent",
          "type": "decimal",
          "min": 0,
          "max": 100,
          "description": "Default 15"
        }
      ],
      "additive": {
        "Treasury": "FullVillageGold * (VassalTributePercent / 100)"
      }
    },
    {
      "id": "turn.control-dc",
      "title": "Control DC and loyalty test",
      "category": "turn",
      "implementation": "DA_Common/Barony/ControlDcFormulas.cs",
      "notes": "Run at Resolve Turn when Domain Panel Final Stability ≤ 0. Size synced from primary-domain tiles. Population = settlement population.",
      "inputs": [
        {
          "name": "Size",
          "type": "int",
          "description": "Primary domain tile count"
        },
        {
          "name": "Population",
          "type": "int",
          "description": "Settlement population"
        },
        {
          "name": "Loyalty",
          "type": "decimal",
          "description": "Domain Panel Final Loyalty"
        },
        {
          "name": "d20",
          "type": "int",
          "min": 1,
          "max": 20
        }
      ],
      "additive": {
        "Unrest": "0 if (Loyalty+d20-ControlDc)>=0; +2 if result<=-(2*firstDigit(ControlDc)); else +1"
      }
    },
    {
      "id": "baron.skills",
      "title": "From Skills",
      "category": "baron-influence",
      "implementation": "DA_Common/Barony/BaronSkillPpbFormulas.cs",
      "notes": "Skill SumBonus + attribute ModifierAbsolute; all results floored.",
      "additive": {
        "Food": "floor((Plants and mushrooms + Animals care + Beasts) / 3)",
        "Economy": "floor((Mathematics and logic + Races and nations + Trade) / 3)",
        "Production": "floor(Craft + Intelligence mod)",
        "Loyalty": "floor((Bluff + Public speech + Sense motives) / 3)",
        "Stability": "floor((Intimidate + History and religion + Persuasion) / 3)",
        "Law": "floor((Investigation + Observation + Tracking) / 3)",
        "Corruption": "−floor((Vigilance + Gambling + Acting) / 3)",
        "Science": "floor(Knowledge + Intelligence mod)",
        "Magic": "floor(Magic + Willpower mod)",
        "Culture": "floor((Fine arts + Linguistics + Diplomacy) / 3)",
        "Intelligence": "floor(Perception / 2 + Survival / 2 + Deceit)",
        "Defense": "floor((Strategy and tactics + Inspire + Geography) / 3)"
      }
    },
    {
      "id": "baron.advisor-row",
      "title": "Baron and Advisors — baron row",
      "category": "baron-influence",
      "implementation": "DagoniteEmpire/Pages/Barony/BaronyCalc.cs (BuildBaronAdvisorRow)",
      "notes": "X = SumInfluenceRows(BuildInfluenceRows): From Skills ± management + Prestige/Honor/Fear + BaronInfluenceModifier skill-unit sources. Then Additive = MapToAdvisorAdditive(X), Percent = MapToAdvisorPercent(X). Food/Economy/Production/Defense are percent-only. Corruption stored signed. Treasury excluded. Custom sources are never injected as raw Additive after the map.",
      "additive": {
        "Loyalty": "X: Loyalty",
        "Stability": "X: Stability",
        "Law": "X: Law",
        "Science": "X: Science",
        "Magic": "X: Magic",
        "Culture": "X: Culture",
        "Intelligence": "X: Intelligence",
        "Corruption": "X: Corruption (negative on Baron Card)",
        "Food": "none (percent only)",
        "Economy": "none (percent only)",
        "Production": "none (percent only)",
        "Defense": "none (percent only)"
      },
      "additiveTooltips": {
        "_default": "= {ppb} skill",
        "Corruption": "= corruption skill",
        "Food": "none",
        "Economy": "none",
        "Production": "none",
        "Defense": "none",
        "Treasury": "none"
      },
      "percent": {
        "Food": "+X/60 (X = Food skill total; rounded to 0.1 pp)",
        "Economy": "+X/60 (X = Economy skill total; rounded to 0.1 pp)",
        "Production": "+X/60 (X = Production skill total; rounded to 0.1 pp)",
        "Defense": "+X/60 (X = Defense skill total; rounded to 0.1 pp)",
        "Loyalty": "+X/100 (X = Loyalty skill total)",
        "Stability": "+X/100 (X = Stability skill total)",
        "Law": "+X/100 (X = Law skill total)",
        "Corruption": "X/100 (X = Corruption skill total; negative on Baron Card)",
        "Science": "+X/100 (X = Science skill total)",
        "Magic": "+X/100 (X = Magic skill total)",
        "Culture": "+X/100 (X = Culture skill total)",
        "Intelligence": "+X/100 (X = Intelligence skill total)",
        "Treasury": "none"
      },
      "percentTooltips": {
        "Food": "= food skill/60",
        "Economy": "= economy skill/60",
        "Production": "= production skill/60",
        "Defense": "= defense skill/60",
        "_default": "= {ppb} skill/100",
        "Corruption": "= corruption skill/100",
        "Treasury": "none"
      }
    },
    {
      "id": "advisors.office-row",
      "title": "Baron and Advisors — office holder rows",
      "category": "baron-influence",
      "implementation": "BaronyCalc.ApplyAdvisorSkillInfluence",
      "notes": "X = SumAdvisorInfluenceRows(BuildAdvisorInfluenceRows): Advisor.Skills + AdvisorInfluenceModifier skill-unit sources, masked to SignificantSkills. Then Additive/Percent = MapToAdvisor*(X) same as baron.advisor-row. Custom sources are never injected as raw Additive after the map.",
      "activeSkills": {
        "Chancellor": ["Loyalty", "Stability", "Culture"],
        "GuardCaptain": ["Law", "Corruption", "Defense"],
        "Steward": ["Food", "Production", "Economy"]
      },
      "mapping": "baron.advisor-row (scoped to active skills)"
    }
  ]
}
