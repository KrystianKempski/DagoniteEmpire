@inject ICharacterRepository _characterRepository
@inject IBaronyRepository _baronyRepo
@inject ISnackbar _snackBar

<MudDialog>
    <DialogContent>
        <MudRadioGroup T="string"
                       @bind-Value="_seedProfile"
                       Label="Profil baronii"
                       Class="mb-3">
            <MudRadio T="string" Value='@("darkhold")'>Darkhold (gotowy seed)</MudRadio>
            <MudRadio T="string" Value='@("custom")'>Własna (pusty start)</MudRadio>
        </MudRadioGroup>

        <MudTextField @bind-Value="_name"
                      Label="Nazwa baronii"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Required="true"
                      Disabled="@IsDarkholdProfile"
                      Class="mb-3" />
        <MudTextField @bind-Value="_description"
                      Label="Opis"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Lines="3"
                      Class="mb-3" />
        <MudSelect T="CharacterDTO?"
                   Label="Postać barona (Duke)"
                   @bind-Value="_selectedCharacter"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Dense="true"
                   Required="true"
                   Placeholder="Wybierz postać typu Duke">
            @foreach (var character in _eligibleCharacters)
            {
                <MudSelectItem Value="@character">@CharacterLabel(character)</MudSelectItem>
            }
        </MudSelect>
        @if (_eligibleCharacters.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3" Dense="true">
                Brak dostępnych postaci typu Duke. Utwórz i zatwierdź postać typu Duke, która nie ma jeszcze baronii.
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">Anuluj</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(_eligibleCharacters.Count == 0)"
                   OnClick="SaveAsync">
            Utwórz baronię
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private string _name = string.Empty;
    private string? _description;
    private string _seedProfile = "darkhold";
    private CharacterDTO? _selectedCharacter;
    private List<CharacterDTO> _eligibleCharacters = new();
    private bool IsDarkholdProfile => string.Equals(_seedProfile, "darkhold", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        _name = DarkholdSeeder.BaronyName;

        var allCharacters = (await _characterRepository.GetAllApproved(fullIncludes: false)).ToList();
        var dukeCharacters = allCharacters
            .Where(c => c.NPCType == SD.NPCType.Duke && c.IsApproved)
            .OrderBy(c => c.NPCName, StringComparer.OrdinalIgnoreCase)
            .ToList();

        var assignedCharacterIds = (await _baronyRepo.GetAllSummaries())
            .Select(b => b.CharacterId)
            .ToHashSet();

        _eligibleCharacters = dukeCharacters
            .Where(c => !assignedCharacterIds.Contains(c.Id))
            .ToList();
    }

    private static string CharacterLabel(CharacterDTO character)
    {
        var owner = string.IsNullOrWhiteSpace(character.UserName) ? "—" : character.UserName;
        return $"{character.NPCName} ({owner})";
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            _snackBar.Add("Nazwa baronii jest wymagana.", Severity.Warning);
            return;
        }

        if (_selectedCharacter is null)
        {
            _snackBar.Add("Wybierz postać barona.", Severity.Warning);
            return;
        }

        try
        {
            var effectiveName = IsDarkholdProfile
                ? DarkholdSeeder.BaronyName
                : _name.Trim();

            var barony = await _baronyRepo.CreateForCharacter(
                _selectedCharacter.Id,
                effectiveName,
                _description,
                _seedProfile);

            _snackBar.Add($"Utworzono baronię \"{barony.Name}\" (wraz z kampanią).", Severity.Success);
            MudDialog.Close(DialogResult.Ok(barony));
        }
        catch (RepositoryErrorException ex)
        {
            _snackBar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            _snackBar.Add("Błąd tworzenia baronii: " + ex.Message, Severity.Error);
        }
    }
}
