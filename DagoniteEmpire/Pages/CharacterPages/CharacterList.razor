@page "/character"
@using DA_Business.Services
@inject ICharacterRepository _characterRepository
@inject ISpecialSkillRepository _specialSkillRepository
@inject ICampaignRepository _campaignRepository
@inject NavigationManager _navigationManager
@inject IMobRepository _mobRepository
@inject IUserService _userService;
@inject IJSRuntime _jsRuntime
@inject IDialogService DialogService
@inject IBrowserViewportService _vieportService
@implements IDisposable
<PageTitle>Dagonie Empire | Character list</PageTitle>
@if (IsLoading)
{
        <LoadingPage></LoadingPage>
}
else
{
    <div class="page">

        <div class="row m-0 mt-4">
            <div class="row p-0">
                <div class="col-12 col-md-8">
                    <h4 class="card-title px-2 mx-2">@Title</h4>
                </div>
            </div>
            
        </div>
        <div class="row m-0 mt-4">
            <div class="col-12">
                <MudStack Row="true" Spacing="2" Class="mb-2">
                    @if (UserInfo?.IsDemoSession != true && (Characters.Count() < 6 || UserInfo?.HasGlobalCharacterAccess == true))
                    {
                        <MudButton Class="pa-2 justify-content-start w-auto" StartIcon="@Icons.Material.Filled.Add" ButtonType="MudBlazor.ButtonType.Button" Disabled="false" OnClick="@(() => _navigationManager.NavigateTo("/character/create/"))">@L["Add Character"]</MudButton>
                    }
                    else
                    {
                        <MudTooltip Text="@(L["Maximum 6 characters allowed"])">
                            <MudButton Class="pa-2 justify-content-start w-auto" StartIcon="@Icons.Material.Filled.Add" ButtonType="MudBlazor.ButtonType.Button" Disabled="true">@L["Add Character"]</MudButton>
                        </MudTooltip>
                    }
                </MudStack>
                
                @* Character Grid *@
                <div class="character-grid-container">
                    <MudGrid Spacing="4" Justify="Justify.FlexStart">
                        @foreach (var character in Characters)
                        {
                            <MudItem>
                            <div class="character-tile"
                                 style="background-image: url('@(string.IsNullOrEmpty(character.ImageUrl) ? "/images/default-avatar.png" : character.ImageUrl)');">
                                <div class="character-overlay">
                                    <span class="character-name">@character.NPCName</span>
                                    <span class="character-info">@character.RaceName</span>
                                </div>
                                <div class="character-actions">
                                    <WikiNavLink CharacterName="@character.NPCName" Label="" Variant="Variant.Text" Color="Color.Inherit" Class="pa-0" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" 
                                                   Style="color: white;" 
                                                   OnClick="@(() => _navigationManager.NavigateTo($"/character/edit/{character.Id}"))" 
                                                   OnClickStopPropagation="true" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" 
                                                   Style="color: white;" 
                                                   OnClick="@(() => HandleDelete(character.Id))" 
                                                   OnClickStopPropagation="true" />
                                </div>
                            </div>
                            </MudItem>
                        }
                    </MudGrid>
                </div>
            </div>
        </div>

        @if (UserInfo?.HasGlobalCharacterAccess == true)
        {
            <MobsListComponent></MobsListComponent>
        }
    </div>
    
}

@code {
    private IEnumerable<CharacterDTO> Characters { get; set; } = new List<CharacterDTO>();
    private IEnumerable<CharacterDTO> ApprovedCharacters { get; set; } = new List<CharacterDTO>();
    public bool IsLoading { get; set; } = true;
    private string Title { get; set; } = "Your characters";

    public UserInfo? UserInfo { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            IsLoading = true;
            UserInfo = await _userService.GetUserInfo();
            if (UserInfo?.IsAuthenticated != true)
            {
                var uri = new Uri(_navigationManager.Uri);

                _navigationManager.NavigateTo($"/account/login?returnUrl={uri.LocalPath}", forceLoad: true);
            }

            await LoadCharacters();

            IsLoading = false;

        }catch(Exception ex)
        {
            IsLoading = false;
            await _jsRuntime.ToastrError("Error while initialize: " + ex.ToString());
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // if (UserInfo?.IsAuthenticated != true)
            // {
            //     var uri = new Uri(_navigationManager.Uri);

            //     _navigationManager.NavigateTo($"/account/login?returnUrl={uri.LocalPath}", forceLoad: true);
            // }
        }
    }

    private async Task LoadCharacters()
    {

        if(UserInfo is null)
        {
            UserInfo = await _userService.GetUserInfo();
            if (UserInfo is null)
            {
                IsLoading = false;
                await _jsRuntime.ToastrError("Error while initialize user info");
            }
        }

        if (UserInfo?.HasGlobalCharacterAccess == true)
        {
            Title = "All avalible characters";
            Characters = await _characterRepository.GetAll();
            ApprovedCharacters = await _characterRepository.GetAllApproved();
        }
        else if (UserInfo?.IsDemoSession == true)
        {
            Title = "Characters of " + UserInfo.UserName;
            Characters = await LoadDemoSessionCharacter();
            ApprovedCharacters = Characters.Where(c => c.IsApproved).ToList();
        }
        else
        {
            Title = "Characters of " + UserInfo?.UserName;
            Characters = await _characterRepository.GetAllForUser(UserInfo?.UserName);
            ApprovedCharacters = await _characterRepository.GetAllApproved(UserInfo?.UserName);
        }
    }

    private async Task<IEnumerable<CharacterDTO>> LoadDemoSessionCharacter()
    {
        var id = UserInfo?.SelectedCharacterId ?? 0;
        if (id <= 0)
            return Array.Empty<CharacterDTO>();
        var character = await _characterRepository.GetById(id);
        return character.Id > 0 ? new[] { character } : Array.Empty<CharacterDTO>();
    }

    private async Task HandleDelete(int id)
    {
        var character = Characters.FirstOrDefault(c => c.Id == id);
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Delete Character",
            $"Are you sure you want to delete {character?.NPCName ?? "this character"}?",
            yesText: "Delete",
            cancelText: "Cancel");
        
        if (result == true)
        {
            IsLoading = true;
            StateHasChanged();
            
            await _characterRepository.Delete(id);
            if (UserInfo?.SelectedCharacter?.Id == id)
            {
                _userService?.SetSelectedCharId(0);
                UserInfo = await _userService.GetUserInfo();
            }
            await LoadCharacters();
            
            IsLoading = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        
    }
}

