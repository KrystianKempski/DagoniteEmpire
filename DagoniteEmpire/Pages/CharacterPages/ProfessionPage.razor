    private int GetSkillUseCount(TraitProfessionDTO skill) =>
        ProfessionDTO.GetSkillUseCount(skill, AllParams);

    private int GetMaxSkillUseCount(TraitProfessionDTO skill) =>
        ProfessionDTO.GetMaxSkillUseCount(skill, AllParams);

    private async Task IncrSkillUse(TraitProfessionDTO skill) =>
        await ChangeSkillUseCount(skill, GetSkillUseCount(skill) + 1);

    private async Task DecrSkillUse(TraitProfessionDTO skill) =>
        await ChangeSkillUseCount(skill, GetSkillUseCount(skill) - 1);

    private async Task ChangeSkillUseCount(TraitProfessionDTO skill, int newValue)
    {
        if (string.IsNullOrEmpty(skill.Name))
        {
            await _jsruntime.ToastrWarning("Define skill first");
            return;
        }

        if (ProfessionDTO.ClassLevel < skill.Level)
        {
            return;
        }

        var res = ProfessionDTO.SetSkillUseCount(skill, newValue, AllParams);
        if (string.IsNullOrEmpty(res) == false)
        {
            await _jsruntime.ToastrWarning(res);
        }

        skill.UseCount = ProfessionDTO.GetSkillUseCount(skill, AllParams);
        IsLeaveAllowed = false;
        StateHasChanged();
    }

    public async Task ConfirmLeave_Click(bool isConfirmed)
    {
        IsLoading = true;
        StateHasChanged();
        if (isConfirmed == true)
        {
            IsLeaveAllowed = true;
            await _jsruntime.InvokeVoidAsync("HideLeavePageModal");
            _navigationManager.NavigateTo(TargetLocation);
        }
        IsLoading = false;
        StateHasChanged();
        await _jsruntime.InvokeVoidAsync("HideLeavePageModal");
    }

    private ValueTask OnLocationChanging(LocationChangingContext context)
    {
        if (!IsLeaveAllowed)
        {
            TargetLocation = context.TargetLocation;
            context.PreventNavigation();
            HandleLeavePage();
        }

        return ValueTask.CompletedTask;
    }
    private void HandleLeavePage() => _jsruntime.InvokeVoidAsync("ShowLeavePageModal");
}
