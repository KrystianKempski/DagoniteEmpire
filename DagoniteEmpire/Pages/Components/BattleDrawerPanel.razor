<div class="battle-drawer-panel mb-2">
    <MudText Typo="Typo.subtitle2" Class="battle-drawer-panel-title">
        Battle in progress!
    </MudText>
    <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="1" Class="battle-drawer-panel-actions">
        @if (WikiDeployed)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       Size="Size.Small"
                       OnClick="OnOpenCombatRules">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <img src="@MyIcon.AttackWhite" width="16" height="16" alt="" />
                    <span>Rules</span>
                </MudStack>
            </MudButton>
        }
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   Size="Size.Small"
                   OnClick="OnOpenBattleMap">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.GridOn" Size="Size.Small" />
                <span>Map</span>
            </MudStack>
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   Size="Size.Small"
                   OnClick="OnOpenBattleLog">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Small" />
                <span>Log</span>
            </MudStack>
        </MudButton>
    </MudStack>
</div>

@code {
    [Parameter] public bool WikiDeployed { get; set; }
    [Parameter] public EventCallback OnOpenCombatRules { get; set; }
    [Parameter] public EventCallback OnOpenBattleMap { get; set; }
    [Parameter] public EventCallback OnOpenBattleLog { get; set; }
}
