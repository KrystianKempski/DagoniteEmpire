@inject IDialogService DialogService
@inject IJSRuntime _jsRuntime
@inject IUserService _userService
@using DagoniteEmpire.Pages.Dialogs

<div class="languages">
    <div class="languages-summary">
        <span>Znane: @AllParams.GetUsedLanguageSlots() / @AllParams.GetMaxLanguageSlots()</span>
    </div>
    <div class="table-container">
        <table class="table align-middle languages-table">
            <thead>
                <tr>
                    <th scope="col" class="name-row">Nazwa</th>
                    <th scope="col">Kategoria</th>
                    <th scope="col">Pismo</th>
                    <th scope="col">Typowi użytkownicy</th>
                    @if (CanDelete)
                    {
                        <th scope="col" class="languages-actions-col"></th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (AllParams.Languages.Any() == false)
                {
                    <tr>
                        <td colspan="@(CanDelete ? 5 : 4)" class="text-center languages-empty">Nie wybrano języków.</td>
                    </tr>
                }
                else
                {
                    @foreach (var language in AllParams.Languages.OrderBy(l => l.Index).ThenBy(l => l.Name))
                    {
                        <tr>
                            <td>
                                <label class="name-label">@language.Name</label>
                                @if (SD.Languages.IsCommon(language.Name))
                                {
                                    <span class="language-free-badge">darmowy</span>
                                }
                            </td>
                            <td><label class="name-label">@language.Category</label></td>
                            <td><label class="name-label">@language.Script</label></td>
                            <td><label class="name-label">@language.Description</label></td>
                            @if (CanDelete)
                            {
                                <td class="languages-actions-col">
                                    @if (!SD.Languages.IsCommon(language.Name))
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                       Class="languages-delete-btn"
                                                       OnClick="@(() => RemoveLanguage(language))" />
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (CanAdd && CanAddMore)
    {
        <div class="buttons-row">
            <button @onclick="OpenAddLanguageDialog" class="add-trait">Dodaj język</button>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    public AllParamsModel AllParams { get; set; } = null!;

    [Parameter]
    public EventCallback OnLanguagesChange { get; set; }

    public UserInfo? UserInfo { get; set; }

    protected override async Task OnInitializedAsync()
    {
        UserInfo = await _userService.GetUserInfo();
    }

    private bool CanDelete =>
        UserInfo?.IsAdminOrMG == true || AllParams.Character.IsApproved == false;

    private bool CanAdd =>
        UserInfo?.IsAdminOrMG == true || AllParams.Character.IsApproved == false;

    // The game master can grant extra languages even when the rule-based slots are full.
    private bool CanAddMore =>
        UserInfo?.IsAdminOrMG == true || AllParams.GetUsedLanguageSlots() < AllParams.GetMaxLanguageSlots();

    private async Task OpenAddLanguageDialog()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };

        var parameters = new DialogParameters
        {
            { nameof(SelectLanguageDialog.KnownLanguages), AllParams.Languages },
            { nameof(SelectLanguageDialog.AvailableLanguages), AllParams.AvailableLanguages }
        };

        var dialog = await DialogService.ShowAsync<SelectLanguageDialog>("Wybierz język", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not LanguageDTO selected)
            return;

        if (AllParams.Languages.Any(l => l.Id == selected.Id))
            return;

        if (UserInfo?.IsAdminOrMG != true && AllParams.GetUsedLanguageSlots() >= AllParams.GetMaxLanguageSlots())
        {
            await _jsRuntime.ToastrWarning("Brak wolnych slotów na języki.");
            return;
        }

        AllParams.Languages.Add(selected);
        await OnLanguagesChange.InvokeAsync();
    }

    private async Task RemoveLanguage(LanguageDTO language)
    {
        if (SD.Languages.IsCommon(language.Name))
            return;

        if (!CanDelete)
        {
            await _jsRuntime.ToastrWarning("Nie można usuwać języków z ukończonej postaci.");
            return;
        }

        AllParams.Languages.Remove(language);
        await OnLanguagesChange.InvokeAsync();
    }
}
