@using DA_Models
@inject ICharacterRepository _characterRepository
@inject IMobRepository _mobRepository
@inject IAttributeRepository _attributeRepository
@inject IBaseSkillRepository _baseSkillRepository
@inject ISpecialSkillRepository _specialSkillRepository
@inject ITraitRepository<TraitCharacterDTO> _traitCharacterRepository
@inject ITraitRepository<TraitRaceDTO> _traitRaceRepository
@inject ITraitRepository<TraitEquipmentDTO> _traitEquipmentRepository
@inject ITraitRepository<TraitProfessionDTO> _traitProfessionRepository
@inject IWoundRepository _woundRepository
@inject IEquipmentRepository _equipmentRepository
@inject IRaceRepository _raceRepository
@inject IProfessionRepository _professionRepository
@inject IEquipmentSlotRepository _equipmentSlotRepository
@inject IUserService _userService
@inject IBaronyRepository _baronyRepo
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager _navigationManager

<MudPaper>
    @if (IsLoading)
    {
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="100%" />
    }
    else
    {
        <MudStack Class="pa-1" Spacing="2">
            <MudButton Style="@BackgroundColor" Class="pa-1" OnClick="OnExpandCollapseClick">
                <div class="w-100 d-flex px-2 justify-content-between">
                    <div class="image-frame">
                        <MudImage Width="80" ObjectFit="ObjectFit.ScaleDown" Src="@ImageUrl" Alt="Character image" Elevation="25" Class="rounded-lg" />
                        <div class="image-cover">
                            <MudPaper Style="opacity:0.4; background-color:red;" Height="@WoundLevel" Width="100%" Outlined="false" Elevation="0" ></MudPaper>
                            
                        </div>
                        @if (NoTurnLeftIcon != string.Empty)
                        {
                            <div class="image-Icon"> 
                                <MudTooltip Placement="Placement.Right" TooltipClass="character-status-tooltip">
                                    <ChildContent>
                                        <img src="@NoTurnLeftIcon" class="character-status-no-turn-icon" width="30" height="30" alt="" />
                                    </ChildContent>
                                    <TooltipContent>
                                        <span class="character-status-tooltip-text">
                                            <span class="character-status-tooltip-name">@L["No turn"]</span>
                                            <span class="character-status-tooltip-duration">@L["No actions"]</span>
                                        </span>
                                    </TooltipContent>
                                </MudTooltip> 
                            </div>
                        }
                    </div>
                    <div class="flex-grow-1 d-flex flex-column py-2 justify-content-around">
                        <MudText Class="px-2" Typo="Typo.h5">@Name</MudText>
                        @if(IsMob == true)
                        {
                            <MudText Typo="Typo.subtitle1">@ProfessionName | @RaceName</MudText>
                        }
                        <MudText Class="character-status-icons">
                            @foreach(var icon in Icons)
                            {
                                <MudTooltip Placement="Placement.Right" TooltipClass="character-status-tooltip">
                                    <ChildContent>
                                        <img src="@icon.Item2" width="25" height="25" class="pr-1" alt="" />
                                    </ChildContent>
                                    <TooltipContent>
                                        <span class="character-status-tooltip-text">
                                            <span class="character-status-tooltip-name">@LocCatalog.Name(icon.Item1, L)</span>
                                            <span class="character-status-tooltip-duration">@FormatStateDuration(icon.Item3)</span>
                                        </span>
                                    </TooltipContent>
                                </MudTooltip>

                            }
                        </MudText>
                         
                    </div>
                </div>
            </MudButton>
            @if (IsExpanded && (ShowActionsPanel || ShowMobTurnPanel || ShowClassButton || ShowGrantExtraActionButton))
            {
                <MudPaper Elevation="1" Class="pa-1 mx-1 character-actions-panel">
                    <MudText Class="p-1" Typo="Typo.button" Style="text-transform:uppercase">@L["Actions"]</MudText>
                    @if (ShowActionsPanel)
                    {
                    <MudTooltip Placement="Placement.Right" TooltipClass="character-action-tooltip">
                        <ChildContent>
                        <span class="@GetActionWrapperClass(CanDeclareFullDefence)">
                            <MudIconButton Icon="@MudBlazor.Icons.Material.Filled.Shield"
                                           Color="@(CanDeclareFullDefence ? Color.Info : Color.Default)"
                                           Disabled="!CanDeclareFullDefence"
                                           Size="Size.Small"
                                           aria-label="@(L["Declare full defence"])"
                                           OnClick="ConfirmFullDefenceAsync" />
                        </span>
                        </ChildContent>
                        <TooltipContent>
                            <span class="character-status-tooltip-text">
                                <span class="character-status-tooltip-name">@FullDefenceTooltipLines.Title</span>
                                <span class="character-status-tooltip-duration">@FullDefenceTooltipLines.Detail</span>
                            </span>
                        </TooltipContent>
                    </MudTooltip>
                    }
                    @if (ShowActionsPanel || ShowMobTurnPanel)
                    {
                    <MudTooltip Placement="Placement.Right" TooltipClass="character-action-tooltip">
                        <ChildContent>
                        <span class="@GetActionWrapperClass(CanDeclareHalfAction)">
                            <MudIconButton Disabled="!CanDeclareHalfAction"
                                           Size="Size.Small"
                                           aria-label="@(L["Do half action"])"
                                           OnClick="ConfirmHalfActionAsync">
                                <img src="@MyIcon.HalfAction" class="character-action-icon" width="22" height="22" alt="" />
                            </MudIconButton>
                        </span>
                        </ChildContent>
                        <TooltipContent>
                            <span class="character-status-tooltip-text">
                                <span class="character-status-tooltip-name">@HalfActionTooltipLines.Title</span>
                                <span class="character-status-tooltip-duration">@HalfActionTooltipLines.Detail</span>
                            </span>
                        </TooltipContent>
                    </MudTooltip>
                    }
                    @if (ShowGrantExtraActionButton)
                    {
                    <MudTooltip Placement="Placement.Right" TooltipClass="character-action-tooltip">
                        <ChildContent>
                        <span class="@GetActionWrapperClass(HasUsedAtLeastOneAction)">
                            <MudIconButton Disabled="!CanGrantExtraAction"
                                           Color="@(HasUsedAtLeastOneAction ? Color.Info : Color.Default)"
                                           Size="Size.Small"
                                           aria-label="@(L["Grant extra action"])"
                                           OnClick="GrantExtraActionAsync">
                                <img src="@MyIcon.NoTurn" class="character-action-icon" width="22" height="22" alt="" />
                            </MudIconButton>
                        </span>
                        </ChildContent>
                        <TooltipContent>
                            <span class="character-status-tooltip-text">
                                <span class="character-status-tooltip-name">@GrantExtraActionTooltipLines.Title</span>
                                <span class="character-status-tooltip-duration">@GrantExtraActionTooltipLines.Detail</span>
                            </span>
                        </TooltipContent>
                    </MudTooltip>
                    }
                    @if (ShowClassButton)
                    {
                    <MudTooltip Placement="Placement.Right" TooltipClass="character-action-tooltip">
                        <ChildContent>
                            <MudIconButton Size="Size.Small"
                                           aria-label="@(L["Open class"])"
                                           OnClick="OpenClassAsync">
                                <img src="@MyIcon.Anvil" class="character-action-icon" width="22" height="22" alt="" />
                            </MudIconButton>
                        </ChildContent>
                        <TooltipContent>
                            <span class="character-status-tooltip-text">
                                <span class="character-status-tooltip-name">@L["Open class"]</span>
                                <span class="character-status-tooltip-duration">@ProfessionName</span>
                            </span>
                        </TooltipContent>
                    </MudTooltip>
                    }
                </MudPaper>
            }
            <MudCollapse Expanded="IsExpanded">
                <MudPaper Elevation="0" Class="ma-1">
                    @if(BattleProperties is not null && ( UserInfo?.IsAdminOrMG == true || Relation == Relation.Teammate || Relation == Relation.Ally)){

                    <MudPaper Elevation="1" Class="my-1">
                        <MudText Class="p-1" Typo="Typo.button">ATTACK  ( base: @BattleProperties[SD.BattleProperty.AttackBase].SumBonus )</MudText>
                        <MudGrid Spacing="1" Justify="Justify.SpaceBetween">
                            <MudItem xs="3">
                                <label class="w-100 text-center">Dodge: @BattleProperties[SD.BattleProperty.AttackDodge].SumBonus</label>
                            </MudItem>
                            <MudItem xs="3">
                                <label class="w-100 text-center">Parry: @BattleProperties[SD.BattleProperty.AttackParry].SumBonus</label>
                            </MudItem>
                            <MudItem xs="3">
                                <label class="w-100 text-center">Shield: @BattleProperties[SD.BattleProperty.AttackShield].SumBonus</label>
                            </MudItem>
                            <MudItem xs="3">
                                <label class="w-100 text-center">Armor: @BattleProperties[SD.BattleProperty.AttackArmor].SumBonus</label>
                            </MudItem>
                        </MudGrid>
                        <MudText Class="p-1" Typo="Typo.button">DEFENCE ( absorbtion: @BattleProperties[SD.BattleProperty.ArmorClass].SumBonus )</MudText>
                        <MudGrid Spacing="1" Justify="Justify.SpaceBetween">
                            <MudItem xs="3">
                                <label class="w-100 text-center">Dodge: @BattleProperties[SD.BattleProperty.DefenceDodge].SumBonus</label>
                            </MudItem>
                            <MudItem xs="3">
                                <label class="w-100 text-center">Parry: @BattleProperties[SD.BattleProperty.DefenceParry].SumBonus</label>
                            </MudItem>
                            <MudItem xs="3">
                                <label class="w-100 text-center">Shield: @BattleProperties[SD.BattleProperty.DefenceShield].SumBonus</label>
                            </MudItem>
                            <MudItem xs="3">
                                <label class="w-100 text-center">Armor: @BattleProperties[SD.BattleProperty.DefenceArmor].SumBonus</label>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                    }
                    <MudGrid Spacing="1" Justify="Justify.SpaceBetween">                    
                        @if (BattlePropertyModel?.MainWeaponUsed is not null)
                        {
                        <MudItem xs="6">
                            <MudPaper Class="p-1 w-100 h-100" Elevation="1">

                            <div class="d-flex">
                                <div class="flex-grow-1 weapon-prop-label">
                                        <MudText Typo="Typo.button">Main: @BattlePropertyModel.MainWeaponUsed.DisplayName(L)</MudText>
                                </div>
                            </div>
                                @if (BattlePropertyModel.MainWeaponUsed.IsTwoHanded == true)
                            {
                                <div class="d-flex">
                                    <div class="flex-grow-1 weapon-prop-label">
                                        <label>@L["Two handed weapon"]</label>
                                    </div>
                                </div>
                            }
                            @if(MainWeaponProps is not null)
                            {
                                @foreach (var prop in MainWeaponProps)
                                {
                                    @if (prop is not null && string.IsNullOrEmpty(prop.Name) == false)
                                    {
                                        <div class="d-flex">

                                            <div class="flex-grow-1 weapon-prop-label">
                                                <label>@LocCatalog.Name(prop.Name, L): </label>
                                            </div>
                                            @if (prop.SumBonus != 0)
                                            {
                                                <div class="weapon-prop-value">
                                                    @prop.SumBonus
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            }
                            </MudPaper>
                        </MudItem>
                     }
                    @if (BattlePropertyModel?.OffWeaponUsed is not null)
                    {
                        <MudItem xs="6">
                            <MudPaper Class="p-1 w-100 h-100" Elevation="1">
                            <div class="d-flex">
                                <div class="flex-grow-1 weapon-prop-label">
                                        <MudText Typo="Typo.button">Off: @BattlePropertyModel.OffWeaponUsed.DisplayName(L)</MudText>
                                </div>
                            </div>
                                @if (BattlePropertyModel.OffWeaponUsed.IsTwoHanded == true)
                            {
                                <div class="d-flex">
                                    <div class="flex-grow-1 weapon-prop-label">
                                        <label>@L["Two handed weapon"]</label>
                                    </div>
                                </div>
                            }
                            @if (OffWeaponProps is not null)
                            {
                                @foreach (var prop in OffWeaponProps)
                                {
                                    @if (prop is not null && string.IsNullOrEmpty(prop.Name) == false)
                                    {
                                        <div class="d-flex">

                                            <div class="flex-grow-1 weapon-prop-label">
                                                <label>@LocCatalog.Name(prop.Name, L): </label>
                                            </div>
                                            @if (prop.SumBonus != 0)
                                            {
                                                <div class="weapon-prop-value">
                                                    @prop.SumBonus
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            }
                            </MudPaper>
                        </MudItem>
                    }
                    @if (BattlePropertyModel?.ArmorUsed is not null)
                    {
                        <MudItem xs="6">
                            <MudPaper Class="p-1 w-100 h-100" Elevation="1">
                            <div class="d-flex">
                                <div class="flex-grow-1 weapon-prop-label">
                                        <MudText Typo="Typo.button">Armor: @BattlePropertyModel.ArmorUsed.DisplayName(L)</MudText>
                                </div>
                            </div>
                            @if (ArmorProps is not null)
                            {
                                @foreach (var prop in ArmorProps)
                                {
                                    @if (prop is not null && string.IsNullOrEmpty(prop.Name) == false)
                                    {
                                        <div class="d-flex">

                                            <div class="flex-grow-1 weapon-prop-label">
                                                <label>@LocCatalog.Name(prop.Name, L): </label>
                                            </div>
                                            @if (prop.SumBonus != 0)
                                            {
                                                <div class="weapon-prop-value">
                                                    @prop.SumBonus
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            }
                            </MudPaper>
                        </MudItem>
                    }
                    @if (BattlePropertyModel?.ShieldUsed is not null)
                    {
                        <MudItem xs="6">
                            <MudPaper Class="p-1 w-100 h-100" Elevation="1">
                            <div class="d-flex">
                                <div class="flex-grow-1 weapon-prop-label">
                                        <MudText Typo="Typo.button">Shield: @BattlePropertyModel.ShieldUsed.DisplayName(L)</MudText>
                                </div>
                            </div>
                            @if (ShieldProps is not null)
                            {
                                @foreach (var prop in ShieldProps)
                                {
                                    @if (prop is not null && string.IsNullOrEmpty(prop.Name) == false)
                                    {
                                        <div class="d-flex">

                                            <div class="flex-grow-1 weapon-prop-label">
                                                <label>@LocCatalog.Name(prop.Name, L): </label>
                                            </div>
                                            @if (prop.SumBonus != 0)
                                            {
                                                <div class="weapon-prop-value">
                                                    @prop.SumBonus
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            }
                            </MudPaper>
                        </MudItem>
                    }
                    @if (Icons is not null && Icons.Any())
                    {
                        <MudItem xs="12">
                            <MudPaper Class="p-1 w-100 h-100" Elevation="1">
                            <div class="d-flex">
                                <div class="flex-grow-1 weapon-prop-label">
                                        <MudText Typo="Typo.button">@L["Temporary states"]</MudText>
                                </div>
                            </div>
                            @foreach (var icon in Icons)
                            {
                                @if (icon is not null && string.IsNullOrEmpty(icon.Item1) == false)
                                {
                                    <div class="d-inline-block">
                                        <img src="@icon.Item2" width="25" height="25" class="pr-1 d-inline-block" />
                                        <div class="weapon-prop-label ">
                                        <label>@LocCatalog.Name(icon.Item1, L): @icon.Item3,</label>
                                        </div>
                                    </div>
                                }
                            }
                            
                            </MudPaper>
                        </MudItem>
                    }
                    @if (AllParams?.Health.GetAll() is not null && AllParams?.Health.CurrentWounds > 0)
                    {
                        <MudItem xs="12">
                            <MudPaper Class="p-1 w-100 h-100" Elevation="1">
                                <div class="d-flex">
                                    <div class="flex-grow-1 weapon-prop-label">
                                        <MudText Typo="Typo.button">@L["Wounds"]</MudText>
                                    </div>
                                </div>
                                @foreach (var wound in AllParams?.Health.GetAll())
                                {
                                    @if (wound is not null && string.IsNullOrEmpty(wound.Severity) == false)
                                    {
                                        <div class="d-inline-block">
                                            <img src="@Wounds.GetIcon(wound.IsTended)" width="25" height="25" class="pr-1 d-inline-block" />
                                            <div class="weapon-prop-label ">
                                                <label>@wound.DisplaySeverity(L),</label>
                                            </div>
                                        </div>
                                    }
                                }

                            </MudPaper>
                        </MudItem>
                    }
                      
                </MudGrid>
                </MudPaper>
            </MudCollapse>
        </MudStack>
    }


</MudPaper>

@code {
    [Parameter]
    public AllParamsModel? AllParams { get; set; } = null;
    [Parameter]
    public MobDTO? Mob { get; set; } = null;
    [Parameter]
    public int Id { get; set; } = 0;
    [Parameter]
    public bool IsMob { get; set; } = false;
    [Parameter]
    public bool OngoingBattle { get; set; }
    [Parameter]
    public EventCallback<int> OnFullDefenceApplied { get; set; }
    [Parameter]
    public EventCallback<int> OnMobActionApplied { get; set; }

    private bool IsExpanded = false;
    private bool IsLoading = false;
    private BattlePropertyModel? BattlePropertyModel = null;
    private IDictionary<string, BattlePropertyDTO>? BattleProperties= null;
    private IEnumerable<BattlePropertyDTO>? MainWeaponProps = null;
    private IEnumerable<BattlePropertyDTO>? OffWeaponProps = null;
    private IEnumerable<BattlePropertyDTO>? ArmorProps = null;
    private IEnumerable<BattlePropertyDTO>? ShieldProps = null;
    private string ImageUrl = "";
    private string ProfessionName = "";
    private string RaceName = "";
    private string Name = "";
    private string BackgroundColor = "";
    private string StatesString = "";
    private string WoundLevel = "0%";
    private List<Tuple<string, string, int>> Icons = new List<Tuple<string, string, int>>();
    private string NoTurnLeftIcon = string.Empty;
    private Relation Relation = Relation.Teammate;
    public UserInfo? UserInfo { get; set; }
    private List<string> MobWounds { get; set; } = new List<string>();
    private bool _initialized;
    private string _trackedCharacterSignature = string.Empty;
    private string _trackedMobSignature = string.Empty;

    private static string GetCharacterSignature(AllParamsModel allParams) =>
        $"{allParams.States}|{allParams.Health?.CurrentWounds ?? 0}|{allParams.Health?.MaxWounds ?? 0}";

    private static string GetMobSignature(MobDTO mob) =>
        $"{mob.States}|{mob.CurrentWounds}|{mob.MaxWounds}";

    private bool IsOwnCharacter =>
        !IsMob
        && AllParams?.Character is not null
        && UserInfo?.SelectedCharacter?.Id == AllParams.Character.Id;

    private bool ShowActionsPanel =>
        OngoingBattle
        && !IsMob
        && AllParams?.Character is not null
        && (IsOwnCharacter || UserInfo?.IsAdminOrMG == true);

    private bool ShowMobTurnPanel =>
        OngoingBattle
        && IsMob
        && Mob is not null
        && UserInfo?.IsAdminOrMG == true;

    private bool ShowClassButton =>
        !IsMob
        && AllParams?.Character is not null
        && (IsOwnCharacter || UserInfo?.IsAdminOrMG == true);

    private bool ShowGrantExtraActionButton =>
        OngoingBattle
        && UserInfo?.IsAdminOrMG == true
        && ((IsMob && Mob is not null) || (!IsMob && AllParams?.Character is not null));

    private bool HasUsedAtLeastOneAction =>
        HasTemporaryState(States.Names.HalfTurn) || HasTemporaryState(States.Names.NoTurn);

    private bool CanGrantExtraAction =>
        ShowGrantExtraActionButton && HasUsedAtLeastOneAction;

    private bool HasTemporaryState(string stateName) =>
        IsMob
            ? Mob is not null && CombatStateString.HasState(Mob.States, stateName)
            : AllParams?.TraitsTemporary?.Any(t => t.Name == stateName) == true;

    private bool IsFullDefenceBlocked =>
        HasTemporaryState(States.Names.NoTurn)
        || HasTemporaryState(States.Names.HalfTurn)
        || HasTemporaryState(States.Names.Unconscious)
        || HasTemporaryState(States.Names.Dead)
        || HasTemporaryState(States.Names.FullDefence);

    private bool CanDeclareFullDefence =>
        ShowActionsPanel && !IsFullDefenceBlocked;

    private bool HasHalfTurn => HasTemporaryState(States.Names.HalfTurn);

    private bool IsHalfActionBlocked =>
        HasTemporaryState(States.Names.Dead)
        || HasTemporaryState(States.Names.Unconscious)
        || HasTemporaryState(States.Names.FullDefence)
        || (HasTemporaryState(States.Names.NoTurn) && !HasHalfTurn);

    private bool CanDeclareHalfAction =>
        (ShowActionsPanel || ShowMobTurnPanel) && !IsHalfActionBlocked;

    private (string Title, string Detail) FullDefenceTooltipLines
    {
        get
        {
            if (HasTemporaryState(States.Names.Dead))
                return ("Full defence", "Blocked: dead");
            if (HasTemporaryState(States.Names.Unconscious))
                return ("Full defence", "Blocked: unconscious");
            if (HasTemporaryState(States.Names.NoTurn))
                return ("Full defence", "Blocked: no actions");
            if (HasHalfTurn)
                return ("Full defence", "Blocked: half action used");
            if (HasTemporaryState(States.Names.FullDefence))
                return ("Full defence", "Already active");
            return ("Full defence", "No attack; +5 DEF next round");
        }
    }

    private (string Title, string Detail) HalfActionTooltipLines
    {
        get
        {
            if (HasTemporaryState(States.Names.Dead))
                return ("Half action", "Blocked: dead");
            if (HasTemporaryState(States.Names.Unconscious))
                return ("Half action", "Blocked: unconscious");
            if (HasTemporaryState(States.Names.FullDefence))
                return ("Half action", "Blocked: full defence");
            if (HasTemporaryState(States.Names.NoTurn) && !HasHalfTurn)
                return ("Half action", "Blocked: no actions");
            if (HasHalfTurn)
                return ("End turn", "Half turn → No turn");
            return ("Half action", "Gain Half turn; click again to end");
        }
    }

    private (string Title, string Detail) GrantExtraActionTooltipLines
    {
        get
        {
            if (!HasUsedAtLeastOneAction)
                return (L["Add another action"], L["Requires a used action"]);
            if (HasTemporaryState(States.Names.NoTurn))
                return (L["Add another action"], "No turn → Half turn");
            if (HasTemporaryState(States.Names.HalfTurn))
                return (L["Add another action"], L["Removes Half turn"]);
            return (L["Add another action"], L["Requires a used action"]);
        }
    }

    private static string GetActionWrapperClass(bool canUse) =>
        canUse ? "character-action-wrapper" : "character-action-wrapper character-action-inactive-wrapper";

    private static string FormatStateDuration(int turns) =>
        turns == 1 ? "1 turn left" : $"{turns} turns left";

    private void OnExpandCollapseClick()
    {
        IsExpanded = !IsExpanded;
    }

    private async Task OpenClassAsync()
    {
        if (!ShowClassButton || AllParams?.Character is null)
            return;

        try
        {
            UserInfo = await _userService.GetUserInfo();

            if (UserInfo?.HasGlobalCharacterAccess != true)
            {
                if (string.IsNullOrEmpty(UserInfo?.UserName))
                    return;

                var ownsCharacter = UserInfo.IsDemoSession
                    ? UserInfo.CanAccessCharacter(Id)
                    : await _characterRepository.CheckIfCharacterBelongToUser(UserInfo.UserName, Id);
                if (!ownsCharacter)
                {
                    Snackbar.Add(L["You can only open class for your own character."], Severity.Warning);
                    return;
                }

                if (UserInfo.SelectedCharacter?.Id != Id)
                    await _userService.SetSelectedCharId(Id);
            }

            _navigationManager.NavigateTo($"/profession/{Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Error opening class: "] + ex.Message, Severity.Warning);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            UserInfo = await _userService.GetUserInfo();
            IsLoading = true;
            //StateHasChanged();
            if(IsMob==false)
            {
                await LoadCharacter();
            }
            else
            {
                await LoadMob();
            }

            IsLoading = false;
            _initialized = true;
           // StateHasChanged();
        }
        catch (Exception ex)
        {            
            Snackbar.Add(L["Error initializing panel Character: "] + ex.Message, Severity.Warning);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized)
            return;

        try
        {
            if (IsMob && Mob is not null)
            {
                var signature = GetMobSignature(Mob);
                if (signature != _trackedMobSignature)
                {
                    _trackedMobSignature = signature;
                    await ApplyMobDisplayAsync(Mob);
                    StateHasChanged();
                }
            }
            else if (!IsMob && AllParams is not null)
            {
                var signature = GetCharacterSignature(AllParams);
                if (signature != _trackedCharacterSignature)
                {
                    _trackedCharacterSignature = signature;
                    ApplyCharacterDisplay(AllParams);
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Error refreshing panel: "] + ex.Message, Severity.Warning);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (AllParams is null && IsMob == false)
        {
            IsLoading = true;

            StateHasChanged();
            await LoadCharacter();
            IsLoading = false;
            StateHasChanged();
        }
        if(Mob is null && IsMob)
        {
            IsLoading = true;

            StateHasChanged();
            await LoadMob();
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadCharacter()
    {
        try
        {
            var shouldRecalculateDerivedState = false;
            if (AllParams is null){

                AllParams = new();
                AllParams.Character = await _characterRepository.GetById(Id);
                AllParams.Attributes.FillPropertiesContainer(await _attributeRepository.GetAll(Id));
                AllParams.BaseSkills = await _baseSkillRepository.GetAll(Id);
                AllParams.SpecialSkills.FillPropertiesContainer(await _specialSkillRepository.GetAll(Id));
                AllParams.TraitsCharacter = (await _traitCharacterRepository.GetAll(Id)).Where(u => u.IsTemporary == false).Cast<TraitDTO>().ToList();
                AllParams.TraitsTemporary = (await _traitCharacterRepository.GetAll(Id)).Where(u => u.IsTemporary == true).Cast<TraitDTO>().ToList();
                AllParams.CurrentRace = await _raceRepository.GetById(AllParams.Character.RaceId);
                AllParams.Profession = await _professionRepository.GetById(AllParams.Character.ProfessionId);
                AllParams.Profession.Traits = (await _traitProfessionRepository.GetAll(AllParams.Character.Id)).ToList();
                AllParams.EquipmentSlots = (await _equipmentSlotRepository.GetAll(Id)).ToList();
                AllParams.Races = (await _raceRepository.GetAllApproved()).ToList();
                ICollection<WoundDTO> wounds = (await _woundRepository.GetAll(Id)).ToList();
                ICollection<WoundDTO> conds = (await _woundRepository.GetAllCond(Id)).Cast<WoundDTO>().ToList();
                wounds = wounds.Concat(conds).ToList();
                AllParams.Health.FillPropertiesContainer(wounds);
                shouldRecalculateDerivedState = true;
            }

            if (shouldRecalculateDerivedState)
            {
                AllParams.SpecialSkills.AddRelatedParametes();
                await BaronReputationCharacterOverlay.ApplyAsync(AllParams, _baronyRepo, Id);
                AllParams.AllTraitsChange();
                AllParams.Profession.CalculateClassParams(AllParams.Attributes.GetAll());
                AllParams.Health.UpdateHealthBonusesInAttributes();
            }

            ApplyCharacterDisplay(AllParams);
            _trackedCharacterSignature = GetCharacterSignature(AllParams);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Error loading Character: "] + ex.Message, Severity.Warning);
        }
    }

    private void ApplyCharacterDisplay(AllParamsModel allParams)
    {
        MainWeaponProps = allParams.BattleProperties.GetWeaponQualityListFromItem(allParams.BattleProperties.MainWeaponUsed);
        OffWeaponProps = allParams.BattleProperties.GetWeaponQualityListFromItem(allParams.BattleProperties.OffWeaponUsed);
        ArmorProps = allParams.BattleProperties.GetWeaponQualityListFromItem(allParams.BattleProperties.ArmorUsed);
        ShieldProps = allParams.BattleProperties.GetWeaponQualityListFromItem(allParams.BattleProperties.ShieldUsed);
        BattleProperties = allParams.BattleProperties.GetAll();
        BattlePropertyModel = allParams.BattleProperties;
        ProfessionName = allParams.Profession.Name;
        RaceName = allParams.CurrentRace.Name;
        ImageUrl = allParams.Character.ImageUrl;
        Name = allParams.Character.NPCName;
        Relation = allParams.Character.Relation;
        StatesString = allParams.States;
        LoadHealthBar();
        LoadIcons();
        BackgroundColor = $"background:{Colors.Blue.Lighten5};";

        if (BattleProperties is null)
            throw new Exception();
    }

    private async Task LoadMob()
    {
        try
        {
            Mob ??= await _mobRepository.GetById(Id);
            if (Mob.BattleProperties is null)
                Mob.BattleProperties = new MobBattlePropertyModel(Mob);

            await ApplyMobDisplayAsync(Mob);
            _trackedMobSignature = GetMobSignature(Mob);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Error loading Character: "] + ex.Message, Severity.Warning);
        }
    }

    private async Task ApplyMobDisplayAsync(MobDTO mob)
    {
        if (mob.BattleProperties is null)
        {
            mob.BattleProperties = new MobBattlePropertyModel(mob);
            if (string.IsNullOrEmpty(mob.MainWeaponName) == false)
            {
                mob.MainWeapon = await _equipmentRepository.GetByName(mob.MainWeaponName);
                MainWeaponProps = mob.BattleProperties.GetWeaponQualityListFromItem(mob.MainWeapon);
            }
            if (string.IsNullOrEmpty(mob.OffWeaponName) == false)
            {
                mob.OffWeapon = await _equipmentRepository.GetByName(mob.OffWeaponName);
                OffWeaponProps = mob.BattleProperties.GetWeaponQualityListFromItem(mob.OffWeapon);
            }
            if (string.IsNullOrEmpty(mob.ShieldWeaponName) == false)
            {
                mob.ShieldWeapon = await _equipmentRepository.GetByName(mob.ShieldWeaponName);
                ShieldProps = mob.BattleProperties.GetWeaponQualityListFromItem(mob.ShieldWeapon);
            }
            if (string.IsNullOrEmpty(mob.ArmorName) == false)
            {
                mob.Armor = await _equipmentRepository.GetByName(mob.ArmorName);
                ArmorProps = mob.BattleProperties.GetWeaponQualityListFromItem(mob.Armor);
            }
        }
        else
        {
            mob.BattleProperties.CalculateBattleStats();
            if (string.IsNullOrEmpty(mob.MainWeaponName) == false && mob.MainWeapon is not null)
                MainWeaponProps = mob.BattleProperties.GetWeaponQualityListFromItem(mob.MainWeapon);
            if (string.IsNullOrEmpty(mob.OffWeaponName) == false && mob.OffWeapon is not null)
                OffWeaponProps = mob.BattleProperties.GetWeaponQualityListFromItem(mob.OffWeapon);
            if (string.IsNullOrEmpty(mob.ShieldWeaponName) == false && mob.ShieldWeapon is not null)
                ShieldProps = mob.BattleProperties.GetWeaponQualityListFromItem(mob.ShieldWeapon);
            if (string.IsNullOrEmpty(mob.ArmorName) == false && mob.Armor is not null)
                ArmorProps = mob.BattleProperties.GetWeaponQualityListFromItem(mob.Armor);
        }

        BattlePropertyModel = mob.BattleProperties;
        ImageUrl = mob.ImageUrl;
        ProfessionName = mob.ProfessionName;
        RaceName = mob.RaceName;
        Name = mob.Name;
        Relation = mob.Relation;
        if (mob.Relation == Relation.Ally)
            BackgroundColor = $"background:{Colors.Green.Lighten5};";
        else if (mob.Relation == Relation.Neutral)
            BackgroundColor = $"background:{Colors.Yellow.Lighten5};";
        else if (mob.Relation == Relation.Enemy)
            BackgroundColor = $"background:{Colors.Red.Lighten5};";

        StatesString = mob.States;
        LoadHealthBar();
        LoadIcons();
        BattleProperties = mob.BattleProperties.GetAll();

        if (BattleProperties is null)
            throw new Exception();
    }

    public void LoadIcons()
    {
        try{
            Icons = new List<Tuple<string, string, int>>();
            NoTurnLeftIcon = string.Empty;
            foreach (var (stateName, duration) in CombatStateString.Parse(StatesString))
            {
                if (stateName == States.Names.HalfTurn) continue;
                if (stateName == States.Names.NoTurn)
                {
                    NoTurnLeftIcon = MyIcon.NoTurn;
                    continue;
                }

                Icons.Add(new(stateName, States.GetIcon(stateName), duration));
            }
        }
        catch(Exception ex)
        {
            Snackbar.Add(L["Error loading icons: "] + ex.Message, Severity.Warning);
        }
    }

    public void LoadHealthBar()
    {
        int cover = 0;

        if (AllParams?.Health is not null && AllParams.Health.MaxWounds > 0)
            cover = (int)(100.0 * AllParams.Health.CurrentWounds / AllParams.Health.MaxWounds);
        else if (Mob is not null && Mob.MaxWounds > 0)
            cover = (int)(100.0 * Mob.CurrentWounds / Mob.MaxWounds);

        WoundLevel = cover <= 0 ? "0%" : cover > 100 ? "100%" : $"{cover}%";
    }

    private async Task ConfirmFullDefenceAsync()
    {
        if (!CanDeclareFullDefence || AllParams?.Character is null)
            return;

        var characterName = AllParams.Character.NPCName;
        bool? result = await DialogMessageBox.ShowCompactAsync(
            DialogService,
            "Full defence",
            $"Declare for {characterName}?",
            "No attack; +5 DEF next round",
            yesText: "Declare");

        if (result is not true)
            return;

        await ApplyFullDefenceAsync();
    }

    private async Task ApplyFullDefenceAsync()
    {
        if (AllParams?.Character is null)
            return;

        var halfTurn = AllParams.TraitsTemporary.FirstOrDefault(t => t.Name == States.Names.HalfTurn);
        if (halfTurn is not null)
        {
            await _traitCharacterRepository.Delete(halfTurn.Id);
            AllParams.TraitsTemporary.Remove(halfTurn);
        }

        await _traitCharacterRepository.Create(StateSeeder.GetStateDTO(States.Names.FullDefence, false, 1, Id));
        await _traitCharacterRepository.Create(StateSeeder.GetStateDTO(States.Names.NoTurn, false, 1, Id));

        Snackbar.Add(L["Full defence declared."], Severity.Success);
        await OnFullDefenceApplied.InvokeAsync(Id);
    }

    private async Task ConfirmHalfActionAsync()
    {
        if (!CanDeclareHalfAction)
            return;

        if (!IsMob && AllParams?.Character is null)
            return;
        if (IsMob && Mob is null)
            return;

        var participantName = IsMob ? Mob!.Name : AllParams!.Character.NPCName;
        string title;
        string line1;
        string line2;
        string yesText;

        if (HasHalfTurn)
        {
            title = "End turn";
            line1 = $"End turn for {participantName}?";
            line2 = "Half turn → No turn";
            yesText = "End turn";
        }
        else
        {
            title = "Half action";
            line1 = $"Half action for {participantName}?";
            line2 = "Grants Half turn; click again to end";
            yesText = "Use half action";
        }

        bool? result = await DialogMessageBox.ShowCompactAsync(
            DialogService,
            title,
            line1,
            line2,
            yesText: yesText);

        if (result is not true)
            return;

        await ApplyHalfActionAsync();
    }

    private async Task ApplyHalfActionAsync()
    {
        if (IsMob)
        {
            if (Mob is null)
                return;

            if (CombatStateString.HasState(Mob.States, States.Names.HalfTurn))
            {
                Mob.States = CombatStateString.Add(Mob.States, States.Names.NoTurn, States.Duration.SingleTurn);
                Snackbar.Add(L["Turn ended — no actions left."], Severity.Success);
            }
            else
            {
                Mob.States = CombatStateString.Add(Mob.States, States.Names.HalfTurn, States.Duration.SingleTurn);
                Snackbar.Add(L["Half action declared."], Severity.Success);
            }

            await _mobRepository.Update(Mob);
            await ApplyMobDisplayAsync(Mob);
            _trackedMobSignature = GetMobSignature(Mob);
            await OnMobActionApplied.InvokeAsync(Id);
            return;
        }

        if (AllParams?.Character is null)
            return;

        var halfTurn = AllParams.TraitsTemporary.FirstOrDefault(t => t.Name == States.Names.HalfTurn);
        if (halfTurn is not null)
        {
            await _traitCharacterRepository.Delete(halfTurn.Id);
            AllParams.TraitsTemporary.Remove(halfTurn);
            await _traitCharacterRepository.Create(StateSeeder.GetStateDTO(States.Names.NoTurn, false, 1, Id));
            Snackbar.Add(L["Turn ended — no actions left."], Severity.Success);
        }
        else
        {
            await _traitCharacterRepository.Create(StateSeeder.GetStateDTO(States.Names.HalfTurn, false, 1, Id));
            Snackbar.Add(L["Half action declared."], Severity.Success);
        }

        await OnFullDefenceApplied.InvokeAsync(Id);
    }

    private async Task GrantExtraActionAsync()
    {
        if (!CanGrantExtraAction)
            return;

        if (IsMob)
        {
            if (Mob is null)
                return;

            if (CombatStateString.HasState(Mob.States, States.Names.NoTurn))
            {
                Mob.States = RemoveMobState(Mob.States, States.Names.NoTurn);
                Mob.States = CombatStateString.Add(Mob.States, States.Names.HalfTurn, States.Duration.SingleTurn);
                Snackbar.Add(L["Half turn granted."], Severity.Success);
            }
            else if (CombatStateString.HasState(Mob.States, States.Names.HalfTurn))
            {
                Mob.States = RemoveMobState(Mob.States, States.Names.HalfTurn);
                Snackbar.Add(L["Half turn removed — full turn restored."], Severity.Success);
            }

            await _mobRepository.Update(Mob);
            await ApplyMobDisplayAsync(Mob);
            _trackedMobSignature = GetMobSignature(Mob);
            await OnMobActionApplied.InvokeAsync(Id);
            return;
        }

        if (AllParams?.Character is null)
            return;

        if (HasTemporaryState(States.Names.NoTurn))
        {
            var noTurn = AllParams.TraitsTemporary.FirstOrDefault(t => t.Name == States.Names.NoTurn);
            if (noTurn is not null)
            {
                await _traitCharacterRepository.Delete(noTurn.Id);
                AllParams.TraitsTemporary.Remove(noTurn);
            }

            await _traitCharacterRepository.Create(
                StateSeeder.GetStateDTO(States.Names.HalfTurn, false, States.Duration.SingleTurn, Id));
            Snackbar.Add(L["Half turn granted."], Severity.Success);
        }
        else if (HasTemporaryState(States.Names.HalfTurn))
        {
            var halfTurn = AllParams.TraitsTemporary.FirstOrDefault(t => t.Name == States.Names.HalfTurn);
            if (halfTurn is not null)
            {
                await _traitCharacterRepository.Delete(halfTurn.Id);
                AllParams.TraitsTemporary.Remove(halfTurn);
            }

            Snackbar.Add(L["Half turn removed — full turn restored."], Severity.Success);
        }

        await OnFullDefenceApplied.InvokeAsync(Id);
    }

    private static string RemoveMobState(string? states, string stateName)
    {
        var survivors = CombatStateString.Parse(states)
            .Where(e => !string.Equals(e.Name, stateName, StringComparison.Ordinal));
        return CombatStateString.Format(survivors);
    }
