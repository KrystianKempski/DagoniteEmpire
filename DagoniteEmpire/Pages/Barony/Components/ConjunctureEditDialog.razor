@namespace DagoniteEmpire.Pages.Barony.Components
@using DA_Common
@inject ISnackbar _snackBar

<MudDialog Class="baron-influence-dialog"
           ContentClass="baron-influence-dialog-content"
           ActionsClass="baron-influence-dialog-actions">
    <DialogContent>
        <div class="barony-dialog-theme baron-influence-edit-dialog">
            <MudText Typo="Typo.body2" Class="mb-2" Style="color:var(--barony-muted);">
                Koniunktura = 2k6 + modyfikator MG. Rzucane na początku tury.
                Zysk netto w złocie = (Gospodarka + Koniunktura) × 2; przesuwa też % Gospodarki społeczności.
            </MudText>
            <MudNumericField @bind-Value="_dice"
                             Label="Rzut 2k6"
                             HelperText="Surowa suma kości (2–12). Użyj Przerzuć, aby wylosować nową wartość tury."
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Min="2"
                             Max="12"
                             Class="baron-influence-field" />
            <MudNumericField @bind-Value="_modifier"
                             Label="Modyfikator MG"
                             HelperText="Tylko MG. Wojna −3, dobre żniwa +2 itp."
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Class="baron-influence-field" />
            <MudText Typo="Typo.subtitle2" Class="mt-2">
                Efektywnie: @_dice + @_modifier = <b>@(_dice + _modifier)</b>
                (Złoto używa Gospodarka + Koniunktura; % używa Koniunktura − 7 = @(_dice + _modifier - 7))
            </MudText>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Reroll">Przerzuć 2k6</MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">Anuluj</MudButton>
        <MudButton Class="baron-influence-save-btn" Variant="Variant.Filled" OnClick="Save">Zapisz</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public int ConjunctureDice { get; set; } = 7;
    [Parameter] public int ConjunctureModifier { get; set; }

    private int _dice;
    private int _modifier;

    protected override void OnInitialized()
    {
        _dice = Math.Clamp(ConjunctureDice, 2, 12);
        _modifier = ConjunctureModifier;
    }

    private void Reroll()
    {
        var roll = RollService.Roll2d6();
        _dice = roll.Sum;
        _snackBar.Add($"Wyrzucono {roll.Text}", Severity.Info);
    }

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        _dice = Math.Clamp(_dice, 2, 12);
        MudDialog.Close(DialogResult.Ok(new ConjunctureEditResult
        {
            Dice = _dice,
            Modifier = _modifier,
        }));
    }

    public sealed class ConjunctureEditResult
    {
        public int Dice { get; set; }
        public int Modifier { get; set; }
    }
}
