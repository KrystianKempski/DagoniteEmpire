@namespace DagoniteEmpire.Pages.Barony.Components

<div class="terrain-brush">
    <MudText Typo="Typo.caption" Class="terrain-brush__hint">
        Paint an improvement onto the center of a tile. Select None to erase. Clear layer removes all improvements.
    </MudText>
    <div class="terrain-brush__body">
        <div class="terrain-brush__options">
            <BaronyTooltip Text="Clear improvement">
                <button type="button"
                        class="terrain-type-option @(string.IsNullOrEmpty(Value) ? "terrain-type-option--selected" : "")"
                        aria-label="Clear improvement"
                        @onclick="() => SelectAsync(null)">
                    <MudIcon Icon="@Icons.Material.Filled.Block" Size="Size.Small" />
                    <span>None</span>
                </button>
            </BaronyTooltip>
            @foreach (var improvement in MapImprovement.All)
            {
                var i = improvement;
                var selected = Value == i;
                <BaronyTooltip Text="@MapImprovement.DisplayName(i)">
                    <button type="button"
                            class="terrain-type-option @(selected ? "terrain-type-option--selected" : "")"
                            aria-label="@MapImprovement.DisplayName(i)"
                            @onclick="() => SelectAsync(i)">
                        <img src="@MapImprovement.IconUrl(i)"
                             alt="@MapImprovement.DisplayName(i)"
                             class="terrain-improvement-option__icon" />
                        <span>@MapImprovement.DisplayName(i)</span>
                    </button>
                </BaronyTooltip>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    private Task SelectAsync(string? improvement) => ValueChanged.InvokeAsync(improvement);
}
