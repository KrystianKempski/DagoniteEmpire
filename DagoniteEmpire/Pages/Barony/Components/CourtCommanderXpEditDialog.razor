@namespace DagoniteEmpire.Pages.Barony.Components

<MudDialog Class="baron-influence-dialog barony-dialog"
           ContentClass="baron-influence-dialog-content"
           ActionsClass="baron-influence-dialog-actions">
    <TitleContent>
        <MudText Typo="Typo.h6">@L["Commander XP pool"]</MudText>
    </TitleContent>
    <DialogContent>
        <div class="barony-dialog-theme baron-influence-edit-dialog">
            <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mb-2">
                @L["Total CX pool for {0}. Spent: {1}.", AdvisorName, Spent]
            </MudText>
            <MudNumericField T="int"
                             @bind-Value="_value"
                             Label="@(L["CX pool"])"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Min="@Spent"
                             Class="baron-influence-field" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Class="baron-influence-save-btn" Variant="Variant.Filled" OnClick="Save">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string AdvisorName { get; set; } = string.Empty;
    [Parameter] public int Value { get; set; }
    [Parameter] public int Spent { get; set; }

    private int _value;

    protected override void OnInitialized() => _value = Value;

    private void Cancel() => MudDialog.Cancel();
    private void Save() => MudDialog.Close(DialogResult.Ok(_value));
}
