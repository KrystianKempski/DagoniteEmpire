@namespace DagoniteEmpire.Pages.Barony.Components
@inject ISnackbar _snackBar

<MudDialog Class="baron-influence-dialog"
           ContentClass="baron-influence-dialog-content"
           ActionsClass="baron-influence-dialog-actions">
    <DialogContent>
        <div class="barony-dialog-theme baron-influence-edit-dialog">
            <MudTextField @bind-Value="_personName"
                          Label="Advisor name"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="baron-influence-field" />
            <MudSelect T="int"
                       Label="Assigned person"
                       Value="_selectedAvailableId"
                       ValueChanged="OnAvailableChanged"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Class="baron-influence-field">
                <MudSelectItem Value="0">Manual / none</MudSelectItem>
                @foreach (var person in SelectableAvailableAdvisors)
                {
                    <MudSelectItem Value="@person.Id">@person.Name</MudSelectItem>
                }
            </MudSelect>
            @if (AllowTitleEdit)
            {
                <MudTextField @bind-Value="_title"
                              Label="Office title"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="baron-influence-field"
                              Required="true" />
            }
            <MudTextField @bind-Value="_description"
                          Label="Description"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="3"
                          Class="baron-influence-field" />
            <MudNumericField T="decimal"
                             @bind-Value="_upkeepGold"
                             Label="Upkeep cost (gold / turn)"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Min="0"
                             Class="baron-influence-field" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">Cancel</MudButton>
        <MudButton Class="baron-influence-save-btn" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public AdvisorDTO Advisor { get; set; } = new();
    [Parameter] public bool AllowTitleEdit { get; set; }
    [Parameter] public List<AvailableAdvisorDTO> AvailableAdvisors { get; set; } = new();
    [Parameter] public HashSet<int> OccupiedAvailableAdvisorIds { get; set; } = new();

    private string _personName = string.Empty;
    private string _title = string.Empty;
    private string? _description;
    private decimal _upkeepGold;
    private int _selectedAvailableId;

    private IEnumerable<AvailableAdvisorDTO> SelectableAvailableAdvisors =>
        AvailableAdvisors
            .Where(a => !OccupiedAvailableAdvisorIds.Contains(a.Id) || a.Id == Advisor.AvailableAdvisorId)
            .OrderBy(a => a.Name, StringComparer.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        _personName = Advisor.PersonName;
        _title = Advisor.Title;
        _description = Advisor.Description;
        _upkeepGold = Advisor.UpkeepGold;
        _selectedAvailableId = Advisor.AvailableAdvisorId ?? 0;
    }

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        if (AllowTitleEdit && string.IsNullOrWhiteSpace(_title))
        {
            _snackBar.Add("Office title is required.", Severity.Warning);
            return;
        }

        Advisor.PersonName = _personName.Trim();
        if (AllowTitleEdit)
            Advisor.Title = _title.Trim();
        Advisor.Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim();
        Advisor.UpkeepGold = _upkeepGold;
        Advisor.AvailableAdvisorId = _selectedAvailableId > 0 ? _selectedAvailableId : null;
        MudDialog.Close(DialogResult.Ok(Advisor));
    }

    private void OnAvailableChanged(int id)
    {
        _selectedAvailableId = id;
        if (id <= 0)
            return;

        var selected = AvailableAdvisors.FirstOrDefault(a => a.Id == id);
        if (selected is null)
            return;

        _personName = selected.Name;
        _description = selected.Description;
        Advisor.Skills = selected.Skills.Clone();
        Advisor.Skills[Ppb.Treasury] = 0m;
    }
}
