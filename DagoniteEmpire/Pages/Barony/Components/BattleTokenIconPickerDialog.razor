@namespace DagoniteEmpire.Pages.Barony.Components
@using DA_Common.Barony

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Wybierz ikonę</MudText>
    </TitleContent>
    <DialogContent>
        <div class="bbm-icon-picker">
            @foreach (var icon in BattleTokenIconCatalog.All)
            {
                <BaronyTooltip Text="@icon.Label">
                    <button type="button"
                            class="bbm-icon-picker__item @(string.Equals(icon.Key, SelectedKey, StringComparison.OrdinalIgnoreCase) ? "selected" : null)"
                            @onclick="() => Select(icon.Key)">
                        <img src="/@icon.Path" alt="@icon.Label" />
                        <span>@icon.Label</span>
                    </button>
                </BaronyTooltip>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Class="march-map-toolbar__btn">Anuluj</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string? SelectedKey { get; set; }

    private void Select(string key) => MudDialog.Close(DialogResult.Ok(key));

    private void Cancel() => MudDialog.Cancel();
}
