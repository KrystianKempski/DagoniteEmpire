@namespace DagoniteEmpire.Pages.Barony.Components
@using DA_Business.Repository.BaronyRepos
@inject IBaronyRepository _baronyRepo
@inject ISnackbar _snackBar

<BaronySection Title="Unit generator">
    <Summary>
        <span class="projects-summary">
            <span class="projects-summary__item">Live preview updates with every selector</span>
        </span>
    </Summary>
    <ChildContent>
        <div class="unit-workshop">
            <div class="unit-workshop__body">
                @* ---- Left: costs + selectors ---- *@
                <div class="unit-workshop__left">
                    <MudTextField @bind-Value="_name"
                                  @bind-Value:after="Recalc"
                                  Immediate="true"
                                  Label="Unit name"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Disabled="@(!CanEdit)"
                                  Class="baron-influence-field" />

                    @* ---- Total cost (Excel “KOSZT CAŁKOWITY”) — above recruit/training ---- *@
                    <div class="unit-workshop__costs">
                        <div class="unit-workshop__costs-title">Total cost</div>
                        <div class="unit-workshop__cost-grid">
                            <BaronyTooltip Title="Production"
                                           Text="Production needed to craft gear for the unit. Items set to Buy or Defense contribute 0 here.">
                                <div class="unit-workshop__cost">
                                    <span class="unit-workshop__cost-label">Production</span>
                                    <span class="unit-workshop__cost-value unit-workshop__cost-value--production">
                                        @_costs.Production
                                        <BaronyResourceIcon Resource="Ppb.Production" Size="xs" />
                                    </span>
                                </div>
                            </BaronyTooltip>
                            <BaronyTooltip Title="Gold total"
                                           Text="Total gold before training completes: recruit hire gold + gear gold + one-time training fee.">
                                <div class="unit-workshop__cost">
                                    <span class="unit-workshop__cost-label">Gold (total)</span>
                                    <span class="unit-workshop__cost-value unit-workshop__cost-value--gold">
                                        @_costs.GoldTotal
                                        <BaronyResourceIcon Resource="Ppb.Treasury" Size="xs" />
                                    </span>
                                    <span class="unit-workshop__cost-sub">
                                        Rec @_costs.GoldRecruit · Gear @_costs.GoldEquipment · Trn @_costs.GoldTraining
                                    </span>
                                </div>
                            </BaronyTooltip>
                            <BaronyTooltip Title="Defense"
                                           Text="Defense needed to create the unit: recruit selection + gear acquired as Defense (2× market gold) + accelerate (50 Defense per turn cut).">
                                <div class="unit-workshop__cost">
                                    <span class="unit-workshop__cost-label">Defense</span>
                                    <span class="unit-workshop__cost-value unit-workshop__cost-value--defense">
                                        @_costs.DefenseTotal
                                        <BaronyResourceIcon Resource="Ppb.Defense" Size="xs" />
                                    </span>
                                    <span class="unit-workshop__cost-sub">
                                        Rec @_costs.DefenseRecruit · Gear @_costs.DefenseEquipment · Acc @_costs.DefenseAccelerate
                                    </span>
                                </div>
                            </BaronyTooltip>
                            <BaronyTooltip Title="Wage / turn"
                                           Text="@WageTurnTip">
                                <div class="unit-workshop__cost">
                                    <span class="unit-workshop__cost-label">Wage / turn</span>
                                    <span class="unit-workshop__cost-value unit-workshop__cost-value--gold">
                                        @_previewUpkeep.Gold
                                        <BaronyResourceIcon Resource="Ppb.Treasury" Size="xs" />
                                    </span>
                                    <span class="unit-workshop__cost-sub">
                                        Base @_previewUpkeep.BaseWage · Gear @_previewUpkeep.GearGold
                                        · Def/t @_previewUpkeep.Defense
                                    </span>
                                </div>
                            </BaronyTooltip>
                            <BaronyTooltip Title="Time"
                                           Text="Turns required to finish the unit after acceleration. Express can complete in 0 turns.">
                                <div class="unit-workshop__cost">
                                    <span class="unit-workshop__cost-label">Time (turns)</span>
                                    <span class="unit-workshop__cost-value">@_costs.Turns</span>
                                </div>
                            </BaronyTooltip>
                            <BaronyTooltip Title="Gold (gear)"
                                           Text="Gold for weapons and armor at project start: Craft uses catalog gold; Buy uses market (Mkt); Defense items add 0 here.">
                                <div class="unit-workshop__cost">
                                    <span class="unit-workshop__cost-label">Gold (gear)</span>
                                    <span class="unit-workshop__cost-value unit-workshop__cost-value--gold">
                                        @_costs.GoldEquipment
                                        <BaronyResourceIcon Resource="Ppb.Treasury" Size="xs" />
                                    </span>
                                </div>
                            </BaronyTooltip>
                            <BaronyTooltip Title="Gold (training)"
                                           Text="Recruit hire gold (e.g. mercenaries) plus the one-time training fee (Express 10 · Accelerated 20 · Standard 40 · Elite 75). Paid when the project starts — not per turn.">
                                <div class="unit-workshop__cost">
                                    <span class="unit-workshop__cost-label">Gold (training)</span>
                                    <span class="unit-workshop__cost-value unit-workshop__cost-value--gold">
                                        @(_costs.GoldTraining + _costs.GoldRecruit)
                                        <BaronyResourceIcon Resource="Ppb.Treasury" Size="xs" />
                                    </span>
                                    <span class="unit-workshop__cost-sub">
                                        Rec @_costs.GoldRecruit · Trn @_costs.GoldTraining
                                    </span>
                                </div>
                            </BaronyTooltip>
                            <BaronyTooltip Title="Experience points"
                                           Text="Experience points (XP) to spend after training finishes. Attribute raise = target level × 10; base skill = level × 3; specialization = level × 1 (cannot exceed parent); discipline raise = current level.">
                                <div class="unit-workshop__cost">
                                    <span class="unit-workshop__cost-label">XP</span>
                                    <span class="unit-workshop__cost-value">@_costs.Pd</span>
                                </div>
                            </BaronyTooltip>
                        </div>
                        <MudText Typo="Typo.caption" Class="unit-workshop__howto">
                            Recruit → training → gear. Per item: Craft (Prod+Gold), Buy (Mkt), or Defense (2×Mkt). Max units ≈ Society; each unit is 50 troops.
                        </MudText>
                    </div>

                    <div class="unit-workshop__pair">
                        <section class="unit-workshop__block unit-workshop__block--compact">
                            <BaronyTooltip Title="Recruit selection"
                                           Text="Choose how you select recruits. Sets starting attributes and max base skill (combined with training’s Skl — the lower wins). Cost may be Defense and/or gold; Forced hire also adds a Loyalty/Stability event.">
                                <h3 class="unit-workshop__heading">Recruit</h3>
                            </BaronyTooltip>
                            <MudRadioGroup T="string"
                                           Value="_recruitKey"
                                           ValueChanged="OnRecruitChanged"
                                           Disabled="@(!CanEdit)">
                                <table class="ppb-table ppb-table--source ppb-table--lined unit-workshop__table unit-workshop__table--compact">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th class="ppb-row-label">Option</th>
                                            <th>
                                                <BaronyTooltip Title="Attributes"
                                                               Text="Attribute level for the unit (Build, Agility, Will, Perception start at this score)."
                                                               Placement="Placement.Top">
                                                    <span>Att</span>
                                                </BaronyTooltip>
                                            </th>
                                            <th>
                                                <BaronyTooltip Title="Defense"
                                                               Text="Defense resource cost for this selection (0 for mercenaries / forced hire)."
                                                               Placement="Placement.Top">
                                                    <span class="unit-workshop__th-res">
                                                        <BaronyResourceIcon Resource="Ppb.Defense" Size="xs" />
                                                    </span>
                                                </BaronyTooltip>
                                            </th>
                                            <th>
                                                <BaronyTooltip Title="Gold"
                                                               Text="Hire gold for this selection (mercenaries). Added to the project gold track."
                                                               Placement="Placement.Top">
                                                    <span class="unit-workshop__th-res">
                                                        <BaronyResourceIcon Resource="Ppb.Treasury" Size="xs" />
                                                    </span>
                                                </BaronyTooltip>
                                            </th>
                                            <th>
                                                <BaronyTooltip Title="Max base skill"
                                                               Text="Maximum base skill rank reachable by graduation. Combined with training’s Skl (the lower wins)."
                                                               Placement="Placement.Top">
                                                    <span>Skl</span>
                                                </BaronyTooltip>
                                            </th>
                                            <th>
                                                <BaronyTooltip Title="Wage"
                                                               Text="Share of the unit’s wage after training. Total wage = recruit + training."
                                                               Placement="Placement.Top">
                                                    <span>Wag</span>
                                                </BaronyTooltip>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in UnitRecruitSelectionCatalog.All)
                                        {
                                            <tr class="@(_recruitKey == r.Key ? "unit-workshop__row--active" : null)"
                                                @onclick="() => SelectRecruit(r.Key)">
                                                <td><MudRadio T="string" Value="@r.Key" Dense="true" /></td>
                                                <td class="ppb-row-label">
                                                    <BaronyTooltip Title="@r.Name"
                                                                   Text="@RecruitTip(r)"
                                                                   Placement="Placement.Right">
                                                        <span>@r.Name</span>
                                                    </BaronyTooltip>
                                                </td>
                                                <td>@r.AttributeScore</td>
                                                <td>@r.DefenseCost</td>
                                                <td>@r.GoldCost</td>
                                                <td>@r.MaxBaseSkill</td>
                                                <td>@r.Wage</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </MudRadioGroup>
                        </section>

                        <section class="unit-workshop__block unit-workshop__block--compact">
                            <BaronyTooltip Title="Training"
                                           Text="Grants XP on graduation, a one-time gold fee, turns (Trn), starting discipline (Dis), max base skill (Skl), and wage (Wag). Standard/Elite also grant free attribute points after graduation.">
                                <h3 class="unit-workshop__heading">Training</h3>
                            </BaronyTooltip>
                            <MudRadioGroup T="string"
                                           Value="_trainingKey"
                                           ValueChanged="OnTrainingChanged"
                                           Disabled="@(!CanEdit)">
                                <table class="ppb-table ppb-table--source ppb-table--lined unit-workshop__table unit-workshop__table--compact">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th class="ppb-row-label">Type</th>
                                            <th>
                                                <BaronyTooltip Title="Experience points"
                                                               Text="Experience points (XP) available to spend after training finishes."
                                                               Placement="Placement.Top">
                                                    <span>XP</span>
                                                </BaronyTooltip>
                                            </th>
                                            <th>
                                                <BaronyTooltip Title="Gold"
                                                               Text="One-time training fee in gold: Express 10 · Accelerated 20 · Standard 40 · Elite 75."
                                                               Placement="Placement.Top">
                                                    <span class="unit-workshop__th-res">
                                                        <BaronyResourceIcon Resource="Ppb.Treasury" Size="xs" />
                                                    </span>
                                                </BaronyTooltip>
                                            </th>
                                            <th>
                                                <BaronyTooltip Title="Turns"
                                                               Text="Turns needed to finish training before acceleration."
                                                               Placement="Placement.Top">
                                                    <span>Trn</span>
                                                </BaronyTooltip>
                                            </th>
                                            <th>
                                                <BaronyTooltip Title="Max base skill"
                                                               Text="Max base skill at graduation. Combined with recruit’s Skl (the lower wins)."
                                                               Placement="Placement.Top">
                                                    <span>Skl</span>
                                                </BaronyTooltip>
                                            </th>
                                            <th>
                                                <BaronyTooltip Title="Discipline"
                                                               Text="Starting discipline after training (range 1–18). Raising discipline later costs XP equal to the current level."
                                                               Placement="Placement.Top">
                                                    <span>Dis</span>
                                                </BaronyTooltip>
                                            </th>
                                            <th>
                                                <BaronyTooltip Title="Wage"
                                                               Text="Training share of wage after graduation. Total wage = recruit + training."
                                                               Placement="Placement.Top">
                                                    <span>Wag</span>
                                                </BaronyTooltip>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var t in UnitTrainingTypeCatalog.All)
                                        {
                                            var trainTip = string.IsNullOrWhiteSpace(t.Notes)
                                                ? $"{t.Name}: {t.Pd} XP · {t.GoldCost} Gld · {t.Turns} Trn · Dis {t.StartingDiscipline}"
                                                : $"{t.Name}: {t.Notes}. {t.Pd} XP · {t.GoldCost} Gld · {t.Turns} Trn · Dis {t.StartingDiscipline}";
                                            <tr class="@(_trainingKey == t.Key ? "unit-workshop__row--active" : null)"
                                                @onclick="() => SelectTraining(t.Key)">
                                                <td><MudRadio T="string" Value="@t.Key" Dense="true" /></td>
                                                <td class="ppb-row-label">
                                                    <BaronyTooltip Title="@t.Name" Text="@trainTip" Placement="Placement.Right">
                                                        <span>@t.Name</span>
                                                    </BaronyTooltip>
                                                </td>
                                                <td>@t.Pd</td>
                                                <td>@t.GoldCost</td>
                                                <td>@t.Turns</td>
                                                <td>@t.MaxBaseSkill</td>
                                                <td>@t.StartingDiscipline</td>
                                                <td>@t.Wage</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </MudRadioGroup>
                            <div class="unit-workshop__accel">
                                <BaronyTooltip Title="Accelerate"
                                               Text="Speed up training with Defense. Cutting one turn costs 50 Defense. Enter how many turns to cut — usable any time during training (here: at project start).">
                                    <div class="unit-workshop__accel-field">
                                        <span class="unit-workshop__accel-icon" aria-hidden="true">
                                            <BaronyResourceIcon Resource="Ppb.Defense" Size="xs" />
                                        </span>
                                        <MudNumericField T="int"
                                                         Value="_accelerate"
                                                         ValueChanged="OnAccelerateChanged"
                                                         Label="Accel (−50 / turn)"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         Min="0"
                                                         Max="@_maxAccel"
                                                         Disabled="@(!CanEdit)"
                                                         Class="baron-influence-field" />
                                    </div>
                                </BaronyTooltip>
                            </div>
                        </section>
                    </div>

                    @if (_race.BonusBaseSkillPicks > 0)
                    {
                        <section class="unit-workshop__block unit-workshop__block--compact">
                            <BaronyTooltip Title="@($"{_race.Name} race bonus")"
                                           Text="@($"Humans get +{_race.BonusBaseSkillAmount} Other on {_race.BonusBaseSkillPicks} base skills of your choice (shown in the Other skill column).")">
                                <h3 class="unit-workshop__heading">Race bonus — @_race.Name</h3>
                            </BaronyTooltip>
                            <div class="unit-workshop__race-picks">
                                <MudSelect T="string"
                                           Label="Base skill +1"
                                           Value="@(_raceBonus1 ?? string.Empty)"
                                           ValueChanged="OnRaceBonus1Changed"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Dense="true"
                                           Disabled="@(!CanEdit)"
                                           Class="baron-influence-field">
                                    <MudSelectItem Value="@string.Empty">—</MudSelectItem>
                                    @foreach (var s in UnitRaceSkillBonus.EligibleBaseSkills
                                                  .Where(x => !string.Equals(x.Key, _raceBonus2, StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <MudSelectItem Value="@s.Key">@s.Name</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudSelect T="string"
                                           Label="Base skill +1"
                                           Value="@(_raceBonus2 ?? string.Empty)"
                                           ValueChanged="OnRaceBonus2Changed"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Dense="true"
                                           Disabled="@(!CanEdit)"
                                           Class="baron-influence-field">
                                    <MudSelectItem Value="@string.Empty">—</MudSelectItem>
                                    @foreach (var s in UnitRaceSkillBonus.EligibleBaseSkills
                                                  .Where(x => !string.Equals(x.Key, _raceBonus1, StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <MudSelectItem Value="@s.Key">@s.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>
                            <MudText Typo="Typo.caption" Class="unit-workshop__note unit-workshop__note--tight">
                                Cap max base skill: <b>@_costs.MaxBaseSkill</b>
                                (lower of recruit/training Skl)
                            </MudText>
                        </section>
                    }

                    <section class="unit-workshop__block unit-workshop__block--compact">
                        <div class="unit-workshop__gear-head">
                            <BaronyTooltip Title="Gear"
                                           Text="How each item is acquired: Craft = Production + catalog gold; Buy = market gold (Mkt) only, no Production; Defense = 2× Mkt as Defense. Weapon 1 quality (Good +1 / Poor −1 Atk &amp; Dmg) is set by the GM for the whole barony.">
                                <h3 class="unit-workshop__heading">Gear</h3>
                            </BaronyTooltip>
                            @if (CanManageAsMg)
                            {
                                <MudSelect T="string"
                                           Label="Gear quality (MG)"
                                           Value="_quality"
                                           ValueChanged="OnQualityChanged"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Dense="true"
                                           Class="baron-influence-field unit-workshop__quality">
                                    @foreach (var q in UnitWeaponQuality.All)
                                    {
                                        <MudSelectItem Value="@q">@q</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Class="unit-workshop__quality-ro">
                                    Quality: <b>@_quality</b>
                                    <span style="color:var(--barony-muted);"> (GM)</span>
                                </MudText>
                            }
                        </div>
                        <MudText Typo="Typo.caption" Class="unit-workshop__note unit-workshop__note--tight">
                            Acquire:
                            <BaronyResourceIcon Resource="Ppb.Production" Size="xs" /> Craft ·
                            <BaronyResourceIcon Resource="Ppb.Treasury" Size="xs" /> Buy (Mkt) ·
                            <BaronyResourceIcon Resource="Ppb.Defense" Size="xs" /> Def (2×Mkt)
                        </MudText>
                        <div class="unit-gear-pay">
                            @GearPayRow("W1", _w1?.Name, _w1?.ProductionCost, _w1?.GoldCost, _w1?.MarketGold,
                                _payW1, OnPayW1Changed, required: true)
                            @GearPayRow("W2", UnitWeaponCatalog.Find(_weapon2)?.Name,
                                UnitWeaponCatalog.Find(_weapon2)?.ProductionCost,
                                UnitWeaponCatalog.Find(_weapon2)?.GoldCost,
                                UnitWeaponCatalog.Find(_weapon2)?.MarketGold,
                                _payW2, OnPayW2Changed, required: false)
                            @GearPayRow("Arm", _armorDef?.Name, _armorDef?.ProductionCost, _armorDef?.GoldCost, _armorDef?.MarketGold,
                                _payArmor, OnPayArmorChanged, required: false)
                            @GearPayRow("Shd", _shieldDef?.Name, _shieldDef?.ProductionCost, _shieldDef?.GoldCost, _shieldDef?.MarketGold,
                                _payShield, OnPayShieldChanged, required: false)
                            @GearPayRow("Mnt", _mountDef?.Name, _mountDef?.ProductionCost, _mountDef?.GoldCost, _mountDef?.MarketGold,
                                _payMount, OnPayMountChanged, required: false)
                        </div>
                    </section>

                    @if (CanEdit)
                    {
                        <MudButton Class="barony-turn-btn barony-turn-btn--solid"
                                   Variant="Variant.Filled"
                                   Disabled="@(_busy)"
                                   OnClick="StartAsync">
                            Start training project
                        </MudButton>
                    }
                </div>

                @* ---- Right: live unit card (Excel “FORMOWANY ODDZIAŁ”) ---- *@
                <div class="unit-workshop__right">
                    @if (_xpDirty)
                    {
                        <div class="unit-xp-bar">
                            <span class="unit-xp-bar__text">
                                Pending XP: <b>@XpSpentPending</b>
                                · left <b>@_draft.RemainingPd</b>
                                @if (FreeAttrsSpentPending > 0)
                                {
                                    <text> · free attrs <b>@FreeAttrsSpentPending</b></text>
                                }
                            </span>
                            <div class="unit-xp-bar__actions">
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Filled"
                                           Class="barony-turn-btn barony-turn-btn--solid"
                                           OnClick="SaveDraftXp">
                                    Save
                                </MudButton>
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Outlined"
                                           Class="barony-turn-btn barony-turn-btn--ghost"
                                           OnClick="UndoDraftXp">
                                    Undo
                                </MudButton>
                            </div>
                        </div>
                    }
                    <UnitDraftCardPreview Unit="@_draft"
                                          TitleEyebrow="Forming unit"
                                          CanManageAsMg="@CanManageAsMg"
                                          CanSpendPd="@CanEdit"
                                          SkillsChanged="OnDraftSkillsChanged"
                                          OnXpDraftChanged="OnDraftXpChanged" />
                </div>
            </div>

            <UnitEquipmentPicker Unit="@_draft"
                                 Weapon1Key="@_weapon1"
                                 Weapon2Key="@_weapon2"
                                 ArmorKey="@_armorKey"
                                 ShieldKey="@_shieldKey"
                                 MountKey="@_mountKey"
                                 CanEdit="@CanEdit"
                                 Availability="@_availability"
                                 Weapon1Changed="OnWeapon1Changed"
                                 Weapon2Changed="OnWeapon2Changed"
                                 ArmorChanged="OnArmorChanged"
                                 ShieldChanged="OnShieldChanged"
                                 MountChanged="OnMountChanged" />
        </div>
    </ChildContent>
</BaronySection>

@code {
    [Parameter] public int BaronyId { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanManageAsMg { get; set; }
    [Parameter] public EventCallback<StartUnitTrainingResult> OnStarted { get; set; }

    private string _name = string.Empty;
    private string _recruitKey = UnitRecruitSelectionCatalog.BestAvailable.Key;
    private string _trainingKey = UnitTrainingTypeCatalog.Standard.Key;
    private string _weapon1 = "short-spears";
    private string? _weapon2 = "simple-bows";
    private string? _armorKey = null;
    private string? _shieldKey = "wooden-medium-shield";
    private string? _mountKey = null;
    private string _quality = UnitWeaponQuality.Normal;
    private string _payW1 = UnitEquipmentAcquireMode.Craft;
    private string _payW2 = UnitEquipmentAcquireMode.Craft;
    private string _payArmor = UnitEquipmentAcquireMode.Craft;
    private string _payShield = UnitEquipmentAcquireMode.Craft;
    private string _payMount = UnitEquipmentAcquireMode.Craft;
    private int _accelerate;
    private bool _busy;
    private string? _raceBonus1;
    private string? _raceBonus2;

    private UnitTrainingCostSummary _costs = default!;
    private UnitUpkeepTotals _previewUpkeep;
    private BaronyUnitDTO _draft = new();
    private UnitWeaponDef? _w1;
    private UnitArmorDef? _armorDef;
    private UnitArmorDef? _shieldDef;
    private UnitMountDef? _mountDef;
    private UnitRaceDef _race => UnitRaceCatalog.Find(_draft.RaceKey);
    private bool _sanitizingGear;
    private TradeGoodAvailabilitySnapshot? _availability;

    private string WageTurnTip => UnitUpkeepFormulas.Explain(_previewUpkeep)
        + " Food defaults to 0.5/turn once Active (Domain Panel → Army).";

    private string _xpRecruitKey = string.Empty;
    private string _xpTrainingKey = string.Empty;
    private bool _xpDirty;
    private DraftXpBaseline? _xpBaseline;

    private int XpSpentPending =>
        _xpBaseline is null ? 0 : Math.Max(0, _xpBaseline.RemainingPd - _draft.RemainingPd);

    private int FreeAttrsSpentPending =>
        _xpBaseline is null ? 0 : Math.Max(0, _xpBaseline.FreeAttributePoints - _draft.FreeAttributePoints);

    private int _maxAccel => UnitTrainingTypeCatalog.Find(_trainingKey)?.Turns ?? 0;

    protected override async Task OnInitializedAsync()
    {
        // Recalc before any await so the first render never sees a null upkeep preview.
        Recalc();
        await LoadBaronyQualityAsync();
        if (BaronyId > 0)
            _availability = await _baronyRepo.GetTradeGoodAvailability(BaronyId);
        Recalc();
    }

    private async Task LoadBaronyQualityAsync()
    {
        if (BaronyId <= 0) return;
        try
        {
            var barony = await _baronyRepo.GetById(BaronyId);
            if (barony is not null)
                _quality = UnitWeaponQuality.Normalize(barony.DefaultUnitWeaponQuality);
        }
        catch
        {
            _quality = UnitWeaponQuality.Normal;
        }
    }

    private async Task OnQualityChanged(string v)
    {
        if (!CanManageAsMg) return;
        _quality = UnitWeaponQuality.Normalize(v);
        Recalc();
        try
        {
            var barony = await _baronyRepo.GetById(BaronyId);
            if (barony is null) return;
            barony.DefaultUnitWeaponQuality = _quality;
            await _baronyRepo.UpdateBarony(barony);
            _snackBar.Add($"Default gear quality set to {_quality}.", Severity.Success);
        }
        catch (Exception ex)
        {
            _snackBar.Add("Could not save gear quality: " + ex.Message, Severity.Error);
        }
    }

    private void SelectRecruit(string key)
    {
        if (!CanEdit) return;
        _recruitKey = key;
        Recalc();
    }

    private void SelectTraining(string key)
    {
        if (!CanEdit) return;
        _trainingKey = key;
        _accelerate = Math.Min(_accelerate, _maxAccel);
        Recalc();
    }

    private Task OnRecruitChanged(string v) { _recruitKey = v; Recalc(); return Task.CompletedTask; }

    private static string RecruitTip(UnitRecruitSelection r)
    {
        var tip = $"Att {r.AttributeScore} · Def {r.DefenseCost} · Gold {r.GoldCost} · Skl {r.MaxBaseSkill} · Wag {r.Wage}";
        if (!string.IsNullOrWhiteSpace(r.Notes))
            tip += $"\n\n{r.Notes}";
        return tip;
    }

    private Task OnTrainingChanged(string v)
    {
        _trainingKey = v;
        _accelerate = Math.Min(_accelerate, _maxAccel);
        Recalc();
        return Task.CompletedTask;
    }

    private Task OnRaceBonus1Changed(string v)
    {
        _raceBonus1 = string.IsNullOrWhiteSpace(v) ? null : v;
        if (string.Equals(_raceBonus1, _raceBonus2, StringComparison.OrdinalIgnoreCase))
            _raceBonus2 = null;
        Recalc();
        return Task.CompletedTask;
    }

    private Task OnRaceBonus2Changed(string v)
    {
        _raceBonus2 = string.IsNullOrWhiteSpace(v) ? null : v;
        if (string.Equals(_raceBonus1, _raceBonus2, StringComparison.OrdinalIgnoreCase))
            _raceBonus1 = null;
        Recalc();
        return Task.CompletedTask;
