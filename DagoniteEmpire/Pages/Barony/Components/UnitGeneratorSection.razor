    private Task OnPayW1Changed(string v) { _payW1 = UnitEquipmentAcquireMode.Normalize(v); Recalc(); return Task.CompletedTask; }
    private Task OnPayW2Changed(string v) { _payW2 = UnitEquipmentAcquireMode.Normalize(v); Recalc(); return Task.CompletedTask; }
    private Task OnPayArmorChanged(string v) { _payArmor = UnitEquipmentAcquireMode.Normalize(v); Recalc(); return Task.CompletedTask; }
    private Task OnPayShieldChanged(string v) { _payShield = UnitEquipmentAcquireMode.Normalize(v); Recalc(); return Task.CompletedTask; }
