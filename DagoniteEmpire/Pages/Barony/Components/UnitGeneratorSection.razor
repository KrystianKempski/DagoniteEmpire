    private UnitEquipmentPayModes CurrentPayModes => new(
        UnitEquipmentAcquireMode.Normalize(_payW1),
        _weapon2 is null ? UnitEquipmentAcquireMode.Craft : UnitEquipmentAcquireMode.Normalize(_payW2),
        _armorKey is null ? UnitEquipmentAcquireMode.Craft : UnitEquipmentAcquireMode.Normalize(_payArmor),
        _shieldKey is null ? UnitEquipmentAcquireMode.Craft : UnitEquipmentAcquireMode.Normalize(_payShield),
        _mountKey is null ? UnitEquipmentAcquireMode.Craft : UnitEquipmentAcquireMode.Normalize(_payMount));

    private RenderFragment GearPayRow(
        string slot,
        string? name,
        int? prod,
        int? gold,
        int? market,
        string mode,
        Func<string, Task> onChanged,
        bool required) => __builder =>
    {
        var hasItem = !string.IsNullOrWhiteSpace(name);
        var m = UnitEquipmentAcquireMode.Normalize(mode);
        var tipTitle = $"{slot}: {(hasItem ? name : (required ? "wymagane" : "brak"))}";
        var tipText = !hasItem
            ? (required ? "Broń 1 jest wymagana." : "Opcjonalne — wybierz z katalogu poniżej.")
            : m switch
            {
                UnitEquipmentAcquireMode.Buy =>
                    $"Kup za {market} złota (Ryn). Bez produkcji.",
                UnitEquipmentAcquireMode.Defense =>
                    $"Płacone Obroną: {market * 2} (2× Ryn {market}). Bez produkcji/złota.",
                _ =>
                    $"Wytwórz: Produkcja {prod} · Złoto {gold}. Albo Kup (Ryn {market}) / Obrona (2×Ryn).",
            };
        var rowMod = !hasItem ? null
            : m == UnitEquipmentAcquireMode.Buy ? "unit-gear-pay__row--buy"
            : m == UnitEquipmentAcquireMode.Defense ? "unit-gear-pay__row--defense"
            : "unit-gear-pay__row--craft";
        <BaronyTooltip Title="@tipTitle" Text="@tipText" Placement="Placement.Right">
            <div class="unit-gear-pay__row @rowMod">
                <span class="unit-gear-pay__slot">@slot</span>
                <span class="unit-gear-pay__name">@(hasItem ? name : (required ? "—" : "brak"))</span>
                @if (hasItem)
                {
                    <MudRadioGroup T="string"
                                   Value="@m"
                                   ValueChanged="EventCallback.Factory.Create<string>(this, onChanged)"
                                   Disabled="@(!CanEdit)"
                                   Class="unit-gear-pay__modes">
                        <BaronyTooltip Title="Wytwórz" Text="@($"Produkcja {prod} + złoto {gold}.")">
                            <MudRadio T="string" Value="@UnitEquipmentAcquireMode.Craft" Dense="true" Class="unit-gear-pay__mode">
                                <BaronyResourceIcon Resource="Ppb.Production" Size="xs" />
                            </MudRadio>
                        </BaronyTooltip>
                        <BaronyTooltip Title="Kup" Text="@($"Złoto rynkowe {market} (Ryn). Bez produkcji.")">
                            <MudRadio T="string" Value="@UnitEquipmentAcquireMode.Buy" Dense="true" Class="unit-gear-pay__mode">
                                <BaronyResourceIcon Resource="Ppb.Treasury" Size="xs" />
                            </MudRadio>
                        </BaronyTooltip>
                        <BaronyTooltip Title="Obrona" Text="@($"2× rynek = {(market ?? 0) * 2} Obrony.")">
                            <MudRadio T="string" Value="@UnitEquipmentAcquireMode.Defense" Dense="true" Class="unit-gear-pay__mode">
                                <BaronyResourceIcon Resource="Ppb.Defense" Size="xs" />
                            </MudRadio>
                        </BaronyTooltip>
                    </MudRadioGroup>
                }
            </div>
        </BaronyTooltip>
    };

    private void Recalc()
    {
        var recruit = UnitRecruitSelectionCatalog.Find(_recruitKey) ?? UnitRecruitSelectionCatalog.Volunteers;
        var training = UnitTrainingTypeCatalog.Find(_trainingKey) ?? UnitTrainingTypeCatalog.Standard;
        _w1 = UnitWeaponCatalog.Find(_weapon1);
        _armorDef = UnitArmorCatalog.Find(_armorKey);
        _shieldDef = UnitArmorCatalog.Find(_shieldKey);
        _mountDef = UnitMountCatalog.Find(_mountKey);

        _costs = UnitTrainingCostFormulas.Compute(
            recruit, training,
            _w1,
            UnitWeaponCatalog.Find(_weapon2),
            _armorDef,
            _shieldDef,
            _mountDef,
            CurrentPayModes, _accelerate);

        var sameRecruitTraining =
            string.Equals(_xpRecruitKey, _recruitKey, StringComparison.OrdinalIgnoreCase)
            && string.Equals(_xpTrainingKey, _trainingKey, StringComparison.OrdinalIgnoreCase)
            && !string.IsNullOrEmpty(_xpRecruitKey);

        // Same recruit/training: keep XP spends, skill bases, Other sources across gear/name tweaks.
        // Recruit or training changed: full reset to catalog defaults (attrs, discipline, XP, skill bases).
        Dictionary<string, int>? keepBase = null;
        Dictionary<string, int>? keepOther = null;
        Dictionary<string, List<UnitCombatModifierEntry>>? keepSkillOtherSources = null;
        Dictionary<string, List<UnitCombatModifierEntry>>? keepCombatOther = null;
        Dictionary<string, List<UnitCombatModifierEntry>>? keepAttrOtherSources = null;
        int keepBuild = 0, keepAgi = 0, keepWill = 0, keepPer = 0, keepDis = 0, keepPd = 0, keepFree = 0;

        if (sameRecruitTraining)
        {
            keepBase = new Dictionary<string, int>(_draft.SkillBase, StringComparer.OrdinalIgnoreCase);
            keepOther = new Dictionary<string, int>(_draft.SkillOther, StringComparer.OrdinalIgnoreCase);
            keepSkillOtherSources = CloneNamedModifiers(_draft.SkillOtherSources);
            keepCombatOther = CloneNamedModifiers(_draft.CombatOther);
            keepAttrOtherSources = CloneNamedModifiers(_draft.AttrOtherSources);
            keepBuild = _draft.Build;
            keepAgi = _draft.Agility;
            keepWill = _draft.Will;
            keepPer = _draft.Perception;
            keepDis = _draft.Discipline;
            keepPd = _draft.RemainingPd;
            keepFree = _draft.FreeAttributePoints;
        }

        _draft = UnitDraftFactory.FromGenerator(
            _name, _recruitKey, _trainingKey,
            _weapon1, _weapon2, _armorKey, _shieldKey, _mountKey, _quality,
            _costs);

        if (sameRecruitTraining)
        {
            foreach (var (key, value) in keepBase!)
                _draft.SkillBase[key] = value;
            foreach (var (key, value) in keepOther!)
                _draft.SkillOther[key] = value;
            _draft.SkillOtherSources = keepSkillOtherSources!;
            UnitCombatOtherFormulas.ApplySkillOtherTotals(_draft.SkillOtherSources, _draft.SkillOther);
            _draft.CombatOther = keepCombatOther!;
            var (atk, def, dmg, mov, arm, hp) = UnitCombatOtherFormulas.SumAll(_draft.CombatOther);
            _draft.OtherAttack = atk;
            _draft.OtherDefense = def;
            _draft.OtherDamage = dmg;
            _draft.OtherMove = mov;
            _draft.OtherArmor = arm;
            _draft.OtherHp = hp;

            _draft.AttrOtherSources = keepAttrOtherSources!;
            UnitCombatOtherFormulas.ApplyAttrOtherTotals(
                _draft.AttrOtherSources,
                out var oBuild, out var oAgi, out var oWill, out var oPer);
            _draft.AttrOtherBuild = oBuild;
            _draft.AttrOtherAgility = oAgi;
            _draft.AttrOtherWill = oWill;
            _draft.AttrOtherPerception = oPer;

            _draft.Build = keepBuild;
            _draft.Agility = keepAgi;
            _draft.Will = keepWill;
            _draft.Perception = keepPer;
            _draft.Discipline = keepDis;
            _draft.RemainingPd = keepPd;
            _draft.FreeAttributePoints = keepFree;
            ClampBaseSkillsToCap(_draft);
            ApplyRaceSkillBonus(_draft);
            _draft.CurrentHp = UnitStatHelper.Compute(_draft).MaxHp;
            if (!_xpDirty)
                _xpBaseline = DraftXpBaseline.Capture(_draft);
        }
        else
        {
            ApplyRaceSkillBonus(_draft);
            _xpRecruitKey = _recruitKey;
            _xpTrainingKey = _trainingKey;
            _xpBaseline = DraftXpBaseline.Capture(_draft);
            _xpDirty = false;
        }

        if (!_sanitizingGear && SanitizeGearKeys())
        {
            _sanitizingGear = true;
            try { Recalc(); }
            finally { _sanitizingGear = false; }
        }

        _previewUpkeep = UnitStatHelper.ComputeUpkeep(_draft);
    }

    /// <summary>
    /// Drop armor/shield/mount/weapons the draft can no longer wear (stats / Riding / trade access).
    /// Returns true when keys changed and Recalc must run again.
    /// </summary>
    private bool SanitizeGearKeys()
    {
        var build = _draft.EffectiveBuild;
        var skillTotals = UnitStatHelper.BuildSkillTotals(_draft);
        var armorSkill = skillTotals.GetValueOrDefault(UnitSkillKey.ArmorSkill);
        var ridingSkill = skillTotals.GetValueOrDefault(UnitSkillKey.Riding);
        var changed = false;

        if (_armorKey is not null)
        {
            var a = UnitArmorCatalog.Find(_armorKey);
            if (a is null || !UnitEquipmentTradeAccess.MeetsArmor(a, build, armorSkill, _availability, out _))
            {
                _armorKey = null;
                _payArmor = UnitEquipmentAcquireMode.Craft;
                changed = true;
            }
        }

        if (_shieldKey is not null)
        {
            var s = UnitArmorCatalog.Find(_shieldKey);
            if (s is null || !UnitEquipmentTradeAccess.MeetsArmor(s, build, armorSkill, _availability, out _))
            {
                _shieldKey = null;
                _payShield = UnitEquipmentAcquireMode.Craft;
                changed = true;
            }
        }

        if (_mountKey is not null)
        {
            var m = UnitMountCatalog.Find(_mountKey);
            if (m is null || !UnitEquipmentTradeAccess.MeetsMount(m, ridingSkill, _availability, out _))
            {
                _mountKey = null;
                _payMount = UnitEquipmentAcquireMode.Craft;
                changed = true;
            }
        }

        // Armor/shield change affects Agility penalties — rebuild before weapon checks.
        if (changed)
            return true;

        var agility = _draft.EffectiveAgility;
        var w1 = UnitWeaponCatalog.Find(_weapon1);
        if (w1 is null || !UnitEquipmentTradeAccess.MeetsWeapon(w1, build, agility, _availability, out _))
        {
            _weapon1 = UnitEquipmentTradeAccess.FirstEligibleWeaponKey(build, agility, _availability) ?? "short-spears";
            _payW1 = UnitEquipmentAcquireMode.Craft;
            changed = true;
        }

        if (_weapon2 is not null)
        {
            var w2 = UnitWeaponCatalog.Find(_weapon2);
            if (w2 is null
                || string.Equals(_weapon2, _weapon1, StringComparison.OrdinalIgnoreCase)
                || !UnitEquipmentTradeAccess.MeetsWeapon(w2, build, agility, _availability, out _))
            {
                _weapon2 = null;
                _payW2 = UnitEquipmentAcquireMode.Craft;
                changed = true;
            }
        }

        return changed;
    }

    private void ApplyRaceSkillBonus(BaronyUnitDTO dto)
    {
        dto.SkillOtherSources ??= new Dictionary<string, List<UnitCombatModifierEntry>>(StringComparer.OrdinalIgnoreCase);
        dto.SkillOther ??= new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        UnitRaceSkillBonus.ApplyPicks(
            dto.SkillOtherSources,
            dto.SkillOther,
            UnitRaceCatalog.Find(dto.RaceKey),
            _raceBonus1,
            _raceBonus2);
    }

    private static void ClampBaseSkillsToCap(BaronyUnitDTO dto)
    {
        var cap = dto.MaxBaseSkillAtGraduation;
        if (cap <= 0) return;
        foreach (var def in UnitSkillTree.All.Where(d => d.IsBase))
        {
            if (dto.SkillBase.TryGetValue(def.Key, out var v) && v > cap)
                dto.SkillBase[def.Key] = cap;
        }
    }

    private static Dictionary<string, List<UnitCombatModifierEntry>> CloneNamedModifiers(
        Dictionary<string, List<UnitCombatModifierEntry>>? source)
    {
        var copy = new Dictionary<string, List<UnitCombatModifierEntry>>(StringComparer.OrdinalIgnoreCase);
        if (source is null) return copy;
        foreach (var (key, list) in source)
        {
            copy[key] = list
                .Select(m => new UnitCombatModifierEntry { Label = m.Label, Value = m.Value })
                .ToList();
        }
        return copy;
    }

    private Task OnDraftSkillsChanged() => InvokeAsync(StateHasChanged);

    private Task OnDraftXpChanged()
    {
        // Baseline must already exist from Recalc/Save — do not recapture after the raise.
        _xpDirty = true;
        return InvokeAsync(StateHasChanged);
    }

    private void SaveDraftXp()
    {
        _xpBaseline = DraftXpBaseline.Capture(_draft);
        _xpDirty = false;
    }

    private void UndoDraftXp()
    {
        if (_xpBaseline is null) return;
        _xpBaseline.Restore(_draft);
        ApplyRaceSkillBonus(_draft);
        _draft.CurrentHp = UnitStatHelper.Compute(_draft).MaxHp;
        _xpDirty = false;
    }

    private async Task StartAsync()
    {
        if (_busy) return;
        if (string.IsNullOrWhiteSpace(_name))
        {
            _snackBar.Add("Najpierw nadaj nazwę oddziałowi.", Severity.Warning);
            return;
        }

        var race = UnitRaceCatalog.Find(_draft.RaceKey);
        if (race.BonusBaseSkillPicks > 0)
        {
            var picks = new[] { _raceBonus1, _raceBonus2 }
                .Where(k => !string.IsNullOrWhiteSpace(k))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
            if (picks.Count < race.BonusBaseSkillPicks)
            {
                _snackBar.Add(
                    $"Wybierz {race.BonusBaseSkillPicks} umiejętności bazowych dla premii rasowej {race.Name} (+{race.BonusBaseSkillAmount} Other każda).",
                    Severity.Warning);
                return;
            }
        }

        ApplyRaceSkillBonus(_draft);

        _busy = true;
        try
        {
            var result = await _baronyRepo.StartUnitTraining(new StartUnitTrainingRequest
            {
                BaronyId = BaronyId,
                Name = _name.Trim(),
                RecruitSelectionKey = _recruitKey,
                TrainingTypeKey = _trainingKey,
                RaceKey = _draft.RaceKey,
                Weapon1Key = _weapon1,
                Weapon2Key = _weapon2,
                ArmorKey = _armorKey,
                ShieldKey = _shieldKey,
                MountKey = _mountKey,
                Weapon1Quality = _quality,
                Weapon1AcquireMode = _payW1,
                Weapon2AcquireMode = _payW2,
                ArmorAcquireMode = _payArmor,
                ShieldAcquireMode = _payShield,
                MountAcquireMode = _payMount,
                AccelerateTurns = _accelerate,
                DefenseSkillKey = _draft.DefenseSkillKey,
                SkillBase = new Dictionary<string, int>(_draft.SkillBase, StringComparer.OrdinalIgnoreCase),
                SkillOther = new Dictionary<string, int>(_draft.SkillOther, StringComparer.OrdinalIgnoreCase),
                SkillOtherSources = CloneNamedModifiers(_draft.SkillOtherSources),
                CombatOther = CloneNamedModifiers(_draft.CombatOther),
                AttrOtherSources = CloneNamedModifiers(_draft.AttrOtherSources),
                Build = _draft.Build,
                Agility = _draft.Agility,
                Will = _draft.Will,
                Perception = _draft.Perception,
                Discipline = _draft.Discipline,
                RemainingPd = _draft.RemainingPd,
                FreeAttributePoints = _draft.FreeAttributePoints,
            });
            _name = string.Empty;
            _draft.SkillBase.Clear();
            _draft.SkillOther.Clear();
            _draft.SkillOtherSources.Clear();
            _draft.CombatOther.Clear();
            _xpDirty = false;
            _xpBaseline = null;
            _xpRecruitKey = string.Empty;
            _xpTrainingKey = string.Empty;
            Recalc();
            await OnStarted.InvokeAsync(result);
        }
        catch (Exception ex)
        {
            _snackBar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class DraftXpBaseline
    {
        public int Build { get; init; }
        public int Agility { get; init; }
        public int Will { get; init; }
        public int Perception { get; init; }
        public int Discipline { get; init; }
        public int RemainingPd { get; init; }
        public int FreeAttributePoints { get; init; }
        public Dictionary<string, int> SkillBase { get; init; } = new(StringComparer.OrdinalIgnoreCase);

        public static DraftXpBaseline Capture(BaronyUnitDTO u) => new()
        {
            Build = u.Build,
            Agility = u.Agility,
            Will = u.Will,
            Perception = u.Perception,
            Discipline = u.Discipline,
            RemainingPd = u.RemainingPd,
            FreeAttributePoints = u.FreeAttributePoints,
            SkillBase = new Dictionary<string, int>(u.SkillBase, StringComparer.OrdinalIgnoreCase),
        };

        public void Restore(BaronyUnitDTO u)
        {
            u.Build = Build;
            u.Agility = Agility;
            u.Will = Will;
            u.Perception = Perception;
            u.Discipline = Discipline;
            u.RemainingPd = RemainingPd;
            u.FreeAttributePoints = FreeAttributePoints;
            u.SkillBase.Clear();
            foreach (var (k, v) in SkillBase)
                u.SkillBase[k] = v;
        }
    }
}
