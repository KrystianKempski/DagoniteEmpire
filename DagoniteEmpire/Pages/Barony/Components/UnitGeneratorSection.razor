@namespace DagoniteEmpire.Pages.Barony.Components
@using DA_Business.Repository.BaronyRepos
@inject IBaronyRepository _baronyRepo
@inject ISnackbar _snackBar

<BaronySection Title="Generator oddziałów">
    <Summary>
        <span class="projects-summary">
            <span class="projects-summary__item">Podgląd na żywo aktualizuje się przy każdym wyborze</span>
        </span>
    </Summary>
    <ChildContent>
        <div class="unit-workshop">
            <div class="unit-workshop__body">
                @* ---- Left: costs + selectors ---- *@
                <div class="unit-workshop__left">
                    <MudTextField @bind-Value="_name"
                                  @bind-Value:after="Recalc"
                                  Immediate="true"
                                  Label="Nazwa oddziału"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Disabled="@(!CanEdit)"
                                  Class="baron-influence-field" />

                    @* ---- Total cost (Excel “KOSZT CAŁKOWITY”) — above recruit/training ---- *@
                    <div class="unit-workshop__costs">
                        <div class="unit-workshop__costs-title">Koszt całkowity</div>
                        <div class="unit-workshop__cost-grid">
                            <BaronyTooltip Title="Produkcja"
                                           Text="Produkcja potrzebna do wytworzenia ekwipunku oddziału. Przedmioty ustawione na Kup lub Obrona wnoszą tu 0.">
                                <div class="unit-workshop__cost">
                                    <span class="unit-workshop__cost-label">Produkcja</span>
                                    <span class="unit-workshop__cost-value unit-workshop__cost-value--production">
                                        @_costs.Production
                                        <BaronyResourceIcon Resource="Ppb.Production" Size="xs" />
                                    </span>
                                </div>
                            </BaronyTooltip>
                            <BaronyTooltip Title="Złoto łącznie"
                                           Text="Całkowite złoto przed zakończeniem szkolenia: złoto za najem rekrutów + złoto na ekwipunek + jednorazowa opłata za szkolenie.">
                                <div class="unit-workshop__cost">
                                    <span class="unit-workshop__cost-label">Złoto (razem)</span>
                                    <span class="unit-workshop__cost-value unit-workshop__cost-value--gold">
                                        @_costs.GoldTotal
                                        <BaronyResourceIcon Resource="Ppb.Treasury" Size="xs" />
                                    </span>
                                    <span class="unit-workshop__cost-sub">
                                        Rekr @_costs.GoldRecruit · Ekwip @_costs.GoldEquipment · Szkol @_costs.GoldTraining
                                    </span>
                                </div>
                            </BaronyTooltip>
                            <BaronyTooltip Title="Obrona"
                                           Text="Obrona potrzebna do utworzenia oddziału: wybór rekrutów + ekwipunek pozyskany jako Obrona (2× złoto rynkowe) + przyspieszenie (50 Obrony za skróconą turę).">
                                <div class="unit-workshop__cost">
                                    <span class="unit-workshop__cost-label">Obrona</span>
                                    <span class="unit-workshop__cost-value unit-workshop__cost-value--defense">
                                        @_costs.DefenseTotal
                                        <BaronyResourceIcon Resource="Ppb.Defense" Size="xs" />
                                    </span>
                                    <span class="unit-workshop__cost-sub">
                                        Rekr @_costs.DefenseRecruit · Ekwip @_costs.DefenseEquipment · Przysp @_costs.DefenseAccelerate
                                    </span>
                                </div>
                            </BaronyTooltip>
                            <BaronyTooltip Title="Żołd / tura"
                                           Text="@WageTurnTip">
                                <div class="unit-workshop__cost">
                                    <span class="unit-workshop__cost-label">Żołd / tura</span>
                                    <span class="unit-workshop__cost-value unit-workshop__cost-value--gold">
                                        @_previewUpkeep.Gold
                                        <BaronyResourceIcon Resource="Ppb.Treasury" Size="xs" />
                                    </span>
                                    <span class="unit-workshop__cost-sub">
                                        Baza @_previewUpkeep.BaseWage · Ekwip @_previewUpkeep.GearGold
                                        · Obr/t @_previewUpkeep.Defense
                                    </span>
                                </div>
                            </BaronyTooltip>
                            <BaronyTooltip Title="Czas"
                                           Text="Tury potrzebne do ukończenia oddziału po przyspieszeniu. Express może ukończyć w 0 tur.">
                                <div class="unit-workshop__cost">
                                    <span class="unit-workshop__cost-label">Czas (tury)</span>
                                    <span class="unit-workshop__cost-value">@_costs.Turns</span>
                                </div>
                            </BaronyTooltip>
                            <BaronyTooltip Title="Złoto (ekwipunek)"
                                           Text="Złoto na broń i pancerz na starcie projektu: Wytwórz używa złota z katalogu; Kup używa rynku (Ryn); przedmioty na Obronę dodają tu 0.">
                                <div class="unit-workshop__cost">
                                    <span class="unit-workshop__cost-label">Złoto (ekwip.)</span>
                                    <span class="unit-workshop__cost-value unit-workshop__cost-value--gold">
                                        @_costs.GoldEquipment
                                        <BaronyResourceIcon Resource="Ppb.Treasury" Size="xs" />
                                    </span>
                                </div>
                            </BaronyTooltip>
                            <BaronyTooltip Title="Złoto (szkolenie)"
                                           Text="Złoto za najem rekrutów (np. najemnicy) plus jednorazowa opłata za szkolenie (Express 10 · Accelerated 20 · Standard 40 · Elite 75). Płatne przy starcie projektu — nie co turę.">
                                <div class="unit-workshop__cost">
                                    <span class="unit-workshop__cost-label">Złoto (szkolenie)</span>
                                    <span class="unit-workshop__cost-value unit-workshop__cost-value--gold">
                                        @(_costs.GoldTraining + _costs.GoldRecruit)
                                        <BaronyResourceIcon Resource="Ppb.Treasury" Size="xs" />
                                    </span>
                                    <span class="unit-workshop__cost-sub">
                                        Rekr @_costs.GoldRecruit · Szkol @_costs.GoldTraining
                                    </span>
                                </div>
                            </BaronyTooltip>
                            <BaronyTooltip Title="Punkty doświadczenia"
                                           Text="Punkty doświadczenia (XP) do wydania po zakończeniu szkolenia. Podniesienie atrybutu = poziom docelowy × 10; umiejętność bazowa = poziom × 3; specjalizacja = poziom × 1 (nie może przekroczyć nadrzędnej); podniesienie dyscypliny = aktualny poziom.">
                                <div class="unit-workshop__cost">
                                    <span class="unit-workshop__cost-label">XP</span>
                                    <span class="unit-workshop__cost-value">@_costs.Pd</span>
                                </div>
                            </BaronyTooltip>
                        </div>
                        <MudText Typo="Typo.caption" Class="unit-workshop__howto">
                            Rekrutacja → szkolenie → ekwipunek. Na przedmiot: Wytwórz (Prod+Złoto), Kup (Ryn) lub Obrona (2×Ryn). Maks. oddziałów ≈ Społeczeństwo; każdy oddział liczy 50 ludzi.
                        </MudText>
                    </div>

                    <div class="unit-workshop__pair">
                        <section class="unit-workshop__block unit-workshop__block--compact">
                            <BaronyTooltip Title="Wybór rekrutów"
                                           Text="Wybierz sposób pozyskania rekrutów. Ustawia startowe atrybuty i maks. umiejętność bazową (łączone z Um szkolenia — wygrywa niższa). Koszt może być w Obronie i/lub złocie; opcja Forced hire dodaje też wydarzenie Lojalności/Stabilności.">
                                <h3 class="unit-workshop__heading">Rekrutacja</h3>
                            </BaronyTooltip>
                            <MudRadioGroup T="string"
                                           Value="_recruitKey"
                                           ValueChanged="OnRecruitChanged"
                                           Disabled="@(!CanEdit)">
                                <table class="ppb-table ppb-table--source ppb-table--lined unit-workshop__table unit-workshop__table--compact">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th class="ppb-row-label">Opcja</th>
                                            <th>
                                                <BaronyTooltip Title="Atrybuty"
                                                               Text="Poziom atrybutu oddziału (Budowa, Zręczność, Wola, Percepcja startują z tą wartością)."
                                                               Placement="Placement.Top">
                                                    <span>Atr</span>
                                                </BaronyTooltip>
                                            </th>
                                            <th>
                                                <BaronyTooltip Title="Obrona"
                                                               Text="Koszt w zasobie Obrony dla tego wyboru (0 dla najemników / przymusowego poboru)."
                                                               Placement="Placement.Top">
                                                    <span class="unit-workshop__th-res">
                                                        <BaronyResourceIcon Resource="Ppb.Defense" Size="xs" />
                                                    </span>
                                                </BaronyTooltip>
                                            </th>
                                            <th>
                                                <BaronyTooltip Title="Złoto"
                                                               Text="Złoto za najem dla tego wyboru (najemnicy). Dodawane do puli złota projektu."
                                                               Placement="Placement.Top">
                                                    <span class="unit-workshop__th-res">
                                                        <BaronyResourceIcon Resource="Ppb.Treasury" Size="xs" />
                                                    </span>
                                                </BaronyTooltip>
                                            </th>
                                            <th>
                                                <BaronyTooltip Title="Maks. umiejętność bazowa"
                                                               Text="Maksymalny poziom umiejętności bazowej osiągalny do ukończenia. Łączone z Um szkolenia (wygrywa niższa)."
                                                               Placement="Placement.Top">
                                                    <span>Um</span>
                                                </BaronyTooltip>
                                            </th>
                                            <th>
                                                <BaronyTooltip Title="Żołd"
                                                               Text="Udział w żołdzie oddziału po szkoleniu. Całkowity żołd = rekrutacja + szkolenie."
                                                               Placement="Placement.Top">
                                                    <span>Żołd</span>
                                                </BaronyTooltip>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in UnitRecruitSelectionCatalog.All)
                                        {
                                            <tr class="@(_recruitKey == r.Key ? "unit-workshop__row--active" : null)"
                                                @onclick="() => SelectRecruit(r.Key)">
                                                <td><MudRadio T="string" Value="@r.Key" Dense="true" /></td>
                                                <td class="ppb-row-label">
                                                    <BaronyTooltip Title="@r.Name"
                                                                   Text="@RecruitTip(r)"
                                                                   Placement="Placement.Right">
                                                        <span>@r.Name</span>
                                                    </BaronyTooltip>
                                                </td>
                                                <td>@r.AttributeScore</td>
                                                <td>@r.DefenseCost</td>
                                                <td>@r.GoldCost</td>
                                                <td>@r.MaxBaseSkill</td>
                                                <td>@r.Wage</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </MudRadioGroup>
                        </section>

                        <section class="unit-workshop__block unit-workshop__block--compact">
                            <BaronyTooltip Title="Szkolenie"
                                           Text="Daje XP po ukończeniu, jednorazową opłatę w złocie, tury (Tur), startową dyscyplinę (Dysc), maks. umiejętność bazową (Um) i żołd (Żołd). Standard/Elite dają też darmowe punkty atrybutów po ukończeniu.">
                                <h3 class="unit-workshop__heading">Szkolenie</h3>
                            </BaronyTooltip>
                            <MudRadioGroup T="string"
                                           Value="_trainingKey"
                                           ValueChanged="OnTrainingChanged"
                                           Disabled="@(!CanEdit)">
                                <table class="ppb-table ppb-table--source ppb-table--lined unit-workshop__table unit-workshop__table--compact">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th class="ppb-row-label">Typ</th>
                                            <th>
                                                <BaronyTooltip Title="Punkty doświadczenia"
                                                               Text="Punkty doświadczenia (XP) do wydania po zakończeniu szkolenia."
                                                               Placement="Placement.Top">
                                                    <span>XP</span>
                                                </BaronyTooltip>
                                            </th>
                                            <th>
                                                <BaronyTooltip Title="Złoto"
                                                               Text="Jednorazowa opłata za szkolenie w złocie: Express 10 · Accelerated 20 · Standard 40 · Elite 75."
                                                               Placement="Placement.Top">
                                                    <span class="unit-workshop__th-res">
                                                        <BaronyResourceIcon Resource="Ppb.Treasury" Size="xs" />
                                                    </span>
                                                </BaronyTooltip>
                                            </th>
                                            <th>
                                                <BaronyTooltip Title="Tury"
                                                               Text="Tury potrzebne do ukończenia szkolenia przed przyspieszeniem."
                                                               Placement="Placement.Top">
                                                    <span>Tur</span>
                                                </BaronyTooltip>
                                            </th>
                                            <th>
                                                <BaronyTooltip Title="Maks. umiejętność bazowa"
                                                               Text="Maks. umiejętność bazowa przy ukończeniu. Łączone z Um rekrutacji (wygrywa niższa)."
                                                               Placement="Placement.Top">
                                                    <span>Um</span>
                                                </BaronyTooltip>
                                            </th>
                                            <th>
                                                <BaronyTooltip Title="Dyscyplina"
                                                               Text="Startowa dyscyplina po szkoleniu (zakres 1–18). Późniejsze podniesienie dyscypliny kosztuje XP równe aktualnemu poziomowi."
                                                               Placement="Placement.Top">
                                                    <span>Dysc</span>
                                                </BaronyTooltip>
                                            </th>
                                            <th>
                                                <BaronyTooltip Title="Żołd"
                                                               Text="Udział szkolenia w żołdzie po ukończeniu. Całkowity żołd = rekrutacja + szkolenie."
                                                               Placement="Placement.Top">
                                                    <span>Żołd</span>
                                                </BaronyTooltip>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var t in UnitTrainingTypeCatalog.All)
                                        {
                                            var trainTip = string.IsNullOrWhiteSpace(t.Notes)
                                                ? $"{t.Name}: {t.Pd} XP · {t.GoldCost} Zł · {t.Turns} Tur · Dysc {t.StartingDiscipline}"
                                                : $"{t.Name}: {t.Notes}. {t.Pd} XP · {t.GoldCost} Zł · {t.Turns} Tur · Dysc {t.StartingDiscipline}";
                                            <tr class="@(_trainingKey == t.Key ? "unit-workshop__row--active" : null)"
                                                @onclick="() => SelectTraining(t.Key)">
                                                <td><MudRadio T="string" Value="@t.Key" Dense="true" /></td>
                                                <td class="ppb-row-label">
                                                    <BaronyTooltip Title="@t.Name" Text="@trainTip" Placement="Placement.Right">
                                                        <span>@t.Name</span>
                                                    </BaronyTooltip>
                                                </td>
                                                <td>@t.Pd</td>
                                                <td>@t.GoldCost</td>
                                                <td>@t.Turns</td>
                                                <td>@t.MaxBaseSkill</td>
                                                <td>@t.StartingDiscipline</td>
                                                <td>@t.Wage</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </MudRadioGroup>
                            <div class="unit-workshop__accel">
                                <BaronyTooltip Title="Przyspieszenie"
                                               Text="Przyspiesz szkolenie Obroną. Skrócenie jednej tury kosztuje 50 Obrony. Podaj, ile tur skrócić — można w dowolnym momencie szkolenia (tutaj: przy starcie projektu).">
                                    <div class="unit-workshop__accel-field">
                                        <span class="unit-workshop__accel-icon" aria-hidden="true">
                                            <BaronyResourceIcon Resource="Ppb.Defense" Size="xs" />
                                        </span>
                                        <MudNumericField T="int"
                                                         Value="_accelerate"
                                                         ValueChanged="OnAccelerateChanged"
                                                         Label="Przysp. (−50 / tura)"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         Min="0"
                                                         Max="@_maxAccel"
                                                         Disabled="@(!CanEdit)"
                                                         Class="baron-influence-field" />
                                    </div>
                                </BaronyTooltip>
                            </div>
                        </section>
                    </div>

                    @if (_race.BonusBaseSkillPicks > 0)
                    {
                        <section class="unit-workshop__block unit-workshop__block--compact">
                            <BaronyTooltip Title="@($"Premia rasowa: {_race.Name}")"
                                           Text="@($"Ludzie otrzymują +{_race.BonusBaseSkillAmount} Other do {_race.BonusBaseSkillPicks} wybranych umiejętności bazowych (pokazane w kolumnie Other).")">
                                <h3 class="unit-workshop__heading">Premia rasowa — @_race.Name</h3>
                            </BaronyTooltip>
                            <div class="unit-workshop__race-picks">
                                <MudSelect T="string"
                                           Label="Umiejętność bazowa +1"
                                           Value="@(_raceBonus1 ?? string.Empty)"
                                           ValueChanged="OnRaceBonus1Changed"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Dense="true"
                                           Disabled="@(!CanEdit)"
                                           Class="baron-influence-field">
                                    <MudSelectItem Value="@string.Empty">—</MudSelectItem>
                                    @foreach (var s in UnitRaceSkillBonus.EligibleBaseSkills
                                                  .Where(x => !string.Equals(x.Key, _raceBonus2, StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <MudSelectItem Value="@s.Key">@s.Name</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudSelect T="string"
                                           Label="Umiejętność bazowa +1"
                                           Value="@(_raceBonus2 ?? string.Empty)"
                                           ValueChanged="OnRaceBonus2Changed"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Dense="true"
                                           Disabled="@(!CanEdit)"
                                           Class="baron-influence-field">
                                    <MudSelectItem Value="@string.Empty">—</MudSelectItem>
                                    @foreach (var s in UnitRaceSkillBonus.EligibleBaseSkills
                                                  .Where(x => !string.Equals(x.Key, _raceBonus1, StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <MudSelectItem Value="@s.Key">@s.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>
                            <MudText Typo="Typo.caption" Class="unit-workshop__note unit-workshop__note--tight">
                                Limit umiejętności bazowej: <b>@_costs.MaxBaseSkill</b>
                                (niższa wartość z rekrutacji/szkolenia)
                            </MudText>
                        </section>
                    }

                    <section class="unit-workshop__block unit-workshop__block--compact">
                        <div class="unit-workshop__gear-head">
                            <BaronyTooltip Title="Ekwipunek"
                                           Text="Jak pozyskiwany jest każdy przedmiot: Wytwórz = Produkcja + złoto z katalogu; Kup = tylko złoto rynkowe (Ryn), bez Produkcji; Obrona = 2× Ryn jako Obrona. Jakość Broni 1 (Good +1 / Poor −1 Atk &amp; Dmg) ustawia MG dla całej baronii.">
                                <h3 class="unit-workshop__heading">Ekwipunek</h3>
                            </BaronyTooltip>
                            @if (CanManageAsMg)
                            {
                                <MudSelect T="string"
                                           Label="Jakość ekwipunku (MG)"
                                           Value="_quality"
                                           ValueChanged="OnQualityChanged"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Dense="true"
                                           Class="baron-influence-field unit-workshop__quality">
                                    @foreach (var q in UnitWeaponQuality.All)
                                    {
                                        <MudSelectItem Value="@q">@q</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Class="unit-workshop__quality-ro">
                                    Jakość: <b>@_quality</b>
                                    <span style="color:var(--barony-muted);"> (MG)</span>
                                </MudText>
                            }
                        </div>
                        <MudText Typo="Typo.caption" Class="unit-workshop__note unit-workshop__note--tight">
                            Pozyskanie:
                            <BaronyResourceIcon Resource="Ppb.Production" Size="xs" /> Wytwórz ·
                            <BaronyResourceIcon Resource="Ppb.Treasury" Size="xs" /> Kup (Ryn) ·
                            <BaronyResourceIcon Resource="Ppb.Defense" Size="xs" /> Obr (2×Ryn)
                        </MudText>
                        <div class="unit-gear-pay">
                            @GearPayRow("W1", _w1?.Name, _w1?.ProductionCost, _w1?.GoldCost, _w1?.MarketGold,
                                _payW1, OnPayW1Changed, required: true)
                            @GearPayRow("W2", UnitWeaponCatalog.Find(_weapon2)?.Name,
                                UnitWeaponCatalog.Find(_weapon2)?.ProductionCost,
                                UnitWeaponCatalog.Find(_weapon2)?.GoldCost,
                                UnitWeaponCatalog.Find(_weapon2)?.MarketGold,
                                _payW2, OnPayW2Changed, required: false)
                            @GearPayRow("Arm", _armorDef?.Name, _armorDef?.ProductionCost, _armorDef?.GoldCost, _armorDef?.MarketGold,
                                _payArmor, OnPayArmorChanged, required: false)
                            @GearPayRow("Shd", _shieldDef?.Name, _shieldDef?.ProductionCost, _shieldDef?.GoldCost, _shieldDef?.MarketGold,
                                _payShield, OnPayShieldChanged, required: false)
                            @GearPayRow("Mnt", _mountDef?.Name, _mountDef?.ProductionCost, _mountDef?.GoldCost, _mountDef?.MarketGold,
                                _payMount, OnPayMountChanged, required: false)
                        </div>
                    </section>

                    @if (CanEdit)
                    {
                        <MudButton Class="barony-turn-btn barony-turn-btn--solid"
                                   Variant="Variant.Filled"
                                   Disabled="@(_busy)"
                                   OnClick="StartAsync">
                            Rozpocznij projekt szkolenia
                        </MudButton>
                    }
                </div>

                @* ---- Right: live unit card (Excel “FORMOWANY ODDZIAŁ”) ---- *@
                <div class="unit-workshop__right">
                    @if (_xpDirty)
                    {
                        <div class="unit-xp-bar">
                            <span class="unit-xp-bar__text">
                                Oczekujące XP: <b>@XpSpentPending</b>
                                · pozostało <b>@_draft.RemainingPd</b>
                                @if (FreeAttrsSpentPending > 0)
                                {
                                    <text> · wolne atrybuty <b>@FreeAttrsSpentPending</b></text>
                                }
                            </span>
                            <div class="unit-xp-bar__actions">
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Filled"
                                           Class="barony-turn-btn barony-turn-btn--solid"
                                           OnClick="SaveDraftXp">
                                    Zapisz
                                </MudButton>
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Outlined"
                                           Class="barony-turn-btn barony-turn-btn--ghost"
                                           OnClick="UndoDraftXp">
                                    Cofnij
                                </MudButton>
                            </div>
                        </div>
                    }
                    <UnitDraftCardPreview Unit="@_draft"
                                          TitleEyebrow="Formowany oddział"
                                          CanManageAsMg="@CanManageAsMg"
                                          CanSpendPd="@CanEdit"
                                          SkillsChanged="OnDraftSkillsChanged"
                                          OnXpDraftChanged="OnDraftXpChanged" />
                </div>
            </div>

            <UnitEquipmentPicker Unit="@_draft"
                                 Weapon1Key="@_weapon1"
                                 Weapon2Key="@_weapon2"
                                 ArmorKey="@_armorKey"
                                 ShieldKey="@_shieldKey"
                                 MountKey="@_mountKey"
                                 CanEdit="@CanEdit"
                                 Availability="@_availability"
                                 Weapon1Changed="OnWeapon1Changed"
                                 Weapon2Changed="OnWeapon2Changed"
                                 ArmorChanged="OnArmorChanged"
                                 ShieldChanged="OnShieldChanged"
                                 MountChanged="OnMountChanged" />
        </div>
    </ChildContent>
</BaronySection>

@code {
    [Parameter] public int BaronyId { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanManageAsMg { get; set; }
    [Parameter] public EventCallback<StartUnitTrainingResult> OnStarted { get; set; }

    private string _name = string.Empty;
    private string _recruitKey = UnitRecruitSelectionCatalog.BestAvailable.Key;
    private string _trainingKey = UnitTrainingTypeCatalog.Standard.Key;
    private string _weapon1 = "short-spears";
    private string? _weapon2 = "simple-bows";
