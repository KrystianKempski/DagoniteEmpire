    private string _payW1 = UnitEquipmentAcquireMode.Craft;
    private string _payW2 = UnitEquipmentAcquireMode.Craft;
    private string _payArmor = UnitEquipmentAcquireMode.Craft;
    private string _payShield = UnitEquipmentAcquireMode.Craft;
    private string _payMount = UnitEquipmentAcquireMode.Craft;
    private int _accelerate;
    private bool _busy;
    private string? _raceBonus1;
    private string? _raceBonus2;

    private UnitTrainingCostSummary _costs = default!;
    private UnitUpkeepTotals _previewUpkeep;
    private BaronyUnitDTO _draft = new();
    private UnitWeaponDef? _w1;
    private UnitArmorDef? _armorDef;
    private UnitArmorDef? _shieldDef;
    private UnitMountDef? _mountDef;
    private UnitRaceDef _race => UnitRaceCatalog.Find(_draft.RaceKey);
    private bool _sanitizingGear;
    private TradeGoodAvailabilitySnapshot? _availability;

    private string WageTurnTip => UnitUpkeepFormulas.Explain(_previewUpkeep)
        + " Żywność domyślnie 0,5/turę po aktywacji (Panel Domeny → Armia).";

    private string _xpRecruitKey = string.Empty;
    private string _xpTrainingKey = string.Empty;
    private bool _xpDirty;
    private DraftXpBaseline? _xpBaseline;

    private int XpSpentPending =>
        _xpBaseline is null ? 0 : Math.Max(0, _xpBaseline.RemainingPd - _draft.RemainingPd);

    private int FreeAttrsSpentPending =>
        _xpBaseline is null ? 0 : Math.Max(0, _xpBaseline.FreeAttributePoints - _draft.FreeAttributePoints);

    private int _maxAccel => UnitTrainingTypeCatalog.Find(_trainingKey)?.Turns ?? 0;

    protected override async Task OnInitializedAsync()
    {
        // Recalc before any await so the first render never sees a null upkeep preview.
        Recalc();
        await LoadBaronyQualityAsync();
        if (BaronyId > 0)
            _availability = await _baronyRepo.GetTradeGoodAvailability(BaronyId);
        Recalc();
    }

    private async Task LoadBaronyQualityAsync()
    {
        if (BaronyId <= 0) return;
        try
        {
            var barony = await _baronyRepo.GetById(BaronyId);
            if (barony is not null)
                _quality = UnitWeaponQuality.Normalize(barony.DefaultUnitWeaponQuality);
        }
        catch
        {
            _quality = UnitWeaponQuality.Normal;
        }
    }

    private async Task OnQualityChanged(string v)
    {
        if (!CanManageAsMg) return;
        _quality = UnitWeaponQuality.Normalize(v);
        Recalc();
        try
        {
            var barony = await _baronyRepo.GetById(BaronyId);
            if (barony is null) return;
            barony.DefaultUnitWeaponQuality = _quality;
            await _baronyRepo.UpdateBarony(barony);
            _snackBar.Add($"Ustawiono domyślną jakość ekwipunku na {_quality}.", Severity.Success);
        }
        catch (Exception ex)
        {
            _snackBar.Add("Nie udało się zapisać jakości ekwipunku: " + ex.Message, Severity.Error);
        }
    }

    private void SelectRecruit(string key)
    {
        if (!CanEdit) return;
        _recruitKey = key;
        Recalc();
    }

    private void SelectTraining(string key)
    {
        if (!CanEdit) return;
        _trainingKey = key;
        _accelerate = Math.Min(_accelerate, _maxAccel);
        Recalc();
    }

    private Task OnRecruitChanged(string v) { _recruitKey = v; Recalc(); return Task.CompletedTask; }

    private static string RecruitTip(UnitRecruitSelection r)
    {
        var tip = $"Atr {r.AttributeScore} · Obr {r.DefenseCost} · Złoto {r.GoldCost} · Um {r.MaxBaseSkill} · Żołd {r.Wage}";
        if (!string.IsNullOrWhiteSpace(r.Notes))
            tip += $"\n\n{r.Notes}";
        return tip;
    }

    private Task OnTrainingChanged(string v)
    {
        _trainingKey = v;
        _accelerate = Math.Min(_accelerate, _maxAccel);
        Recalc();
        return Task.CompletedTask;
    }

    private Task OnRaceBonus1Changed(string v)
    {
        _raceBonus1 = string.IsNullOrWhiteSpace(v) ? null : v;
        if (string.Equals(_raceBonus1, _raceBonus2, StringComparison.OrdinalIgnoreCase))
            _raceBonus2 = null;
        Recalc();
        return Task.CompletedTask;
    }

    private Task OnRaceBonus2Changed(string v)
    {
        _raceBonus2 = string.IsNullOrWhiteSpace(v) ? null : v;
        if (string.Equals(_raceBonus1, _raceBonus2, StringComparison.OrdinalIgnoreCase))
            _raceBonus1 = null;
        Recalc();
        return Task.CompletedTask;
    }
    private Task OnWeapon1Changed(string v)
    {
        if (string.IsNullOrWhiteSpace(v)) return Task.CompletedTask;
        _weapon1 = v;
        if (_weapon2 == v) { _weapon2 = null; _payW2 = UnitEquipmentAcquireMode.Craft; }
        Recalc();
        return Task.CompletedTask;
    }
