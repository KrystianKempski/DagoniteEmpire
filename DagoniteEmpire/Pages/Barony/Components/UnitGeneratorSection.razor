        if (_armorKey is null) _payArmor = UnitEquipmentAcquireMode.Craft;
        Recalc();
        return Task.CompletedTask;
    }
    private Task OnShieldChanged(string? v)
    {
        _shieldKey = string.IsNullOrWhiteSpace(v) ? null : v;
        if (_shieldKey is null) _payShield = UnitEquipmentAcquireMode.Craft;
        Recalc();
        return Task.CompletedTask;
