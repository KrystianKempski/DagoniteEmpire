@namespace DagoniteEmpire.Pages.Barony.Components
@using MapGrid = DA_Common.Barony.TerrainMapGrid

<div class="terrain-brush">
    <MudText Typo="Typo.caption" Class="terrain-brush__hint">
        Powiększ lub zmniejsz mapę od każdej krawędzi. Nowe pola to puste równiny.
        Zmniejszanie trwale usuwa pola krawędziowe oraz wszelkie ulepszenia na nich.
    </MudText>
    <div class="terrain-brush__body terrain-map-size">
        <div class="terrain-map-size__current">
            Aktualny rozmiar: <strong>@Width</strong> × <strong>@Height</strong>
            <span class="terrain-map-size__limits">
                (min @MapGrid.MinSize … maks @MapGrid.MaxSize)
            </span>
        </div>

        <div class="terrain-map-size__amount">
            <MudNumericField T="int"
                             Label="Pól na kliknięcie"
                             @bind-Value="_amount"
                             Min="1"
                             Max="10"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Disabled="_busy"
                             Class="terrain-map-size__amount-field" />
        </div>

        <div class="terrain-map-size__pad">
            <div class="terrain-map-size__edge terrain-map-size__edge--top">
                <span class="terrain-map-size__edge-label">Góra</span>
                <BaronyTooltip Text="Usuń wiersze z góry">
                    <MudIconButton Icon="@Icons.Material.Filled.Remove"
                                   Size="Size.Small"
                                   Disabled="@(_busy || !CanShrinkTop)"
                                   OnClick="@(() => ApplyAsync(0, 0, -Amount, 0))" />
                </BaronyTooltip>
                <BaronyTooltip Text="Dodaj wiersze na górze">
                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                   Size="Size.Small"
                                   Disabled="@(_busy || !CanGrowTop)"
                                   OnClick="@(() => ApplyAsync(0, 0, Amount, 0))" />
                </BaronyTooltip>
            </div>

            <div class="terrain-map-size__middle">
                <div class="terrain-map-size__edge terrain-map-size__edge--left">
                    <span class="terrain-map-size__edge-label">Lewa</span>
                    <BaronyTooltip Text="Usuń kolumny z lewej">
                        <MudIconButton Icon="@Icons.Material.Filled.Remove"
                                       Size="Size.Small"
                                       Disabled="@(_busy || !CanShrinkLeft)"
                                       OnClick="@(() => ApplyAsync(-Amount, 0, 0, 0))" />
                    </BaronyTooltip>
                    <BaronyTooltip Text="Dodaj kolumny z lewej">
                        <MudIconButton Icon="@Icons.Material.Filled.Add"
                                       Size="Size.Small"
                                       Disabled="@(_busy || !CanGrowLeft)"
                                       OnClick="@(() => ApplyAsync(Amount, 0, 0, 0))" />
                    </BaronyTooltip>
                </div>

                <div class="terrain-map-size__preview" aria-hidden="true">
                    @Width × @Height
                </div>

                <div class="terrain-map-size__edge terrain-map-size__edge--right">
                    <span class="terrain-map-size__edge-label">Prawa</span>
                    <BaronyTooltip Text="Dodaj kolumny z prawej">
                        <MudIconButton Icon="@Icons.Material.Filled.Add"
                                       Size="Size.Small"
                                       Disabled="@(_busy || !CanGrowRight)"
                                       OnClick="@(() => ApplyAsync(0, Amount, 0, 0))" />
                    </BaronyTooltip>
                    <BaronyTooltip Text="Usuń kolumny z prawej">
                        <MudIconButton Icon="@Icons.Material.Filled.Remove"
                                       Size="Size.Small"
                                       Disabled="@(_busy || !CanShrinkRight)"
                                       OnClick="@(() => ApplyAsync(0, -Amount, 0, 0))" />
                    </BaronyTooltip>
                </div>
            </div>

            <div class="terrain-map-size__edge terrain-map-size__edge--bottom">
                <span class="terrain-map-size__edge-label">Dół</span>
                <BaronyTooltip Text="Dodaj wiersze na dole">
                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                   Size="Size.Small"
                                   Disabled="@(_busy || !CanGrowBottom)"
                                   OnClick="@(() => ApplyAsync(0, 0, 0, Amount))" />
                </BaronyTooltip>
                <BaronyTooltip Text="Usuń wiersze z dołu">
                    <MudIconButton Icon="@Icons.Material.Filled.Remove"
                                   Size="Size.Small"
                                   Disabled="@(_busy || !CanShrinkBottom)"
                                   OnClick="@(() => ApplyAsync(0, 0, 0, -Amount))" />
                </BaronyTooltip>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int Width { get; set; } = MapGrid.DefaultSize;
    [Parameter] public int Height { get; set; } = MapGrid.DefaultSize;
    [Parameter] public EventCallback<(int DeltaLeft, int DeltaRight, int DeltaTop, int DeltaBottom)> OnResize { get; set; }

    private bool _busy;
    private int _amount = 1;

    private int Amount => Math.Clamp(_amount <= 0 ? 1 : _amount, 1, 10);

    private bool CanGrowLeft => Width + Amount <= MapGrid.MaxSize;
    private bool CanGrowRight => Width + Amount <= MapGrid.MaxSize;
    private bool CanGrowTop => Height + Amount <= MapGrid.MaxSize;
    private bool CanGrowBottom => Height + Amount <= MapGrid.MaxSize;
    private bool CanShrinkLeft => Width - Amount >= MapGrid.MinSize;
    private bool CanShrinkRight => Width - Amount >= MapGrid.MinSize;
    private bool CanShrinkTop => Height - Amount >= MapGrid.MinSize;
    private bool CanShrinkBottom => Height - Amount >= MapGrid.MinSize;

    private async Task ApplyAsync(int deltaLeft, int deltaRight, int deltaTop, int deltaBottom)
    {
        if (_busy)
            return;
        _busy = true;
        try
        {
            await OnResize.InvokeAsync((deltaLeft, deltaRight, deltaTop, deltaBottom));
        }
        finally
        {
            _busy = false;
        }
    }
}
