@namespace DagoniteEmpire.Pages.Barony.Components

<MudDialog Class="baron-influence-dialog"
           ContentClass="baron-influence-dialog-content"
           ActionsClass="baron-influence-dialog-actions">
    <DialogContent>
        <div class="barony-dialog-theme baron-influence-edit-dialog">
            <MudText Typo="Typo.body2" Class="mb-2">@_subtitle</MudText>
            <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mb-2">
                @L["Adds PPB and Prestige / Honor / Fear to this audience and posts a “Resource change” note."]
                @L["Non-cumulative PPB → Events · Cumulative PPB → Resources (Expected Income) · PHP → Baron Card (From Adventures)."]
            </MudText>
            <MudTextField @bind-Value="_note"
                          Label="@(L["Description of changes"])"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="4"
                          Immediate="true"
                          HelperText="@(L["Shown under the Resource change entry"])"
                          Class="baron-influence-field mb-2" />
            <PpbVectorEditor @bind-Value="_delta" Title="@(L["PPB change (+)"])" Compact="true" />
            <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">@L["Prestige / Honor / Fear"]</MudText>
            <div class="baron-php-edit-fields">
                <MudNumericField @bind-Value="_prestige"
                                 Label="@(L["Prestige"])"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Immediate="true"
                                 Class="baron-influence-field php-field php-field--prestige" />
                <MudNumericField @bind-Value="_honor"
                                 Label="@(L["Honor"])"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Immediate="true"
                                 Class="baron-influence-field php-field php-field--honor" />
                <MudNumericField @bind-Value="_fear"
                                 Label="@(L["Fear"])"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Immediate="true"
                                 Class="baron-influence-field php-field php-field--fear" />
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Class="baron-influence-save-btn" Variant="Variant.Filled" OnClick="Save" Disabled="!CanSave">
            @L["Add resources"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public BaronAudienceDTO Audience { get; set; } = new();

    private string _subtitle = "";
    private string _note = "";
    private PpbVector _delta = new();
    private int _prestige;
    private int _honor;
    private int _fear;

    private bool HasPhp => _prestige != 0 || _honor != 0 || _fear != 0;

    private bool CanSave =>
        !string.IsNullOrWhiteSpace(_note) && (!_delta.IsEmpty || HasPhp);

    protected override void OnInitialized()
    {
        _subtitle = $"{Audience.Title} — {Audience.PetitionerName}";
        _delta = new PpbVector();
    }

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        if (!CanSave)
            return;
        MudDialog.Close(DialogResult.Ok(new AudienceResourcesResult(
            _delta.Clone(),
            _note.Trim(),
            _prestige,
            _honor,
            _fear)));
    }

    public sealed record AudienceResourcesResult(
        PpbVector Delta,
        string Note,
        int Prestige,
        int Honor,
        int Fear);
}
