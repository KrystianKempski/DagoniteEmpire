@namespace DagoniteEmpire.Pages.Barony.Components

<MudDialog Class="baron-influence-dialog"
           ContentClass="baron-influence-dialog-content"
           ActionsClass="baron-influence-dialog-actions">
    <DialogContent>
        <div class="barony-dialog-theme baron-influence-edit-dialog">
            <MudText Typo="Typo.body2" Class="mb-2">@_subtitle</MudText>
            <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mb-2">
                Adds PPB to this audience and posts a “Resource change” note in the dialogue.
                Non-cumulative → Events · Cumulative → Project Summary.
            </MudText>
            <MudTextField @bind-Value="_note"
                          Label="Description of changes"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="4"
                          HelperText="Shown under the Resource change entry"
                          Class="baron-influence-field mb-2" />
            <PpbVectorEditor @bind-Value="_delta" Title="PPB change (+)" Compact="true" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">Cancel</MudButton>
        <MudButton Class="baron-influence-save-btn" Variant="Variant.Filled" OnClick="Save" Disabled="!CanSave">
            Add resources
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public BaronAudienceDTO Audience { get; set; } = new();

    private string _subtitle = "";
    private string _note = "";
    private PpbVector _delta = new();

    private bool CanSave =>
        !string.IsNullOrWhiteSpace(_note) && !_delta.IsEmpty;

    protected override void OnInitialized()
    {
        _subtitle = $"{Audience.Title} — {Audience.PetitionerName}";
        _delta = new PpbVector();
    }

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        if (!CanSave)
            return;
        MudDialog.Close(DialogResult.Ok(new AudienceResourcesResult(_delta.Clone(), _note.Trim())));
    }

    public sealed record AudienceResourcesResult(PpbVector Delta, string Note);
}
