@namespace DagoniteEmpire.Pages.Barony.Components
@inject ISnackbar _snackBar

<MudDialog Class="baron-influence-dialog"
           ContentClass="baron-influence-dialog-content"
           ActionsClass="baron-influence-dialog-actions">
    <DialogContent>
        <div class="barony-dialog-theme baron-influence-edit-dialog city-building-edit-dialog project-edit-dialog">
            <MudTextField @bind-Value="_name"
                          Label="@(L["Name"])"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Required="true"
                          Class="baron-influence-field" />
            <MudTextField @bind-Value="_description"
                          Label="@(L["Description"])"
                          HelperText="@(L["Shown under the project name."])"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="3"
                          Class="baron-influence-field" />
            <MudSelect @bind-Value="_outputKind"
                       Label="@(L["Output type"])"
                       HelperText="@OutputKindHelper"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Class="baron-influence-field">
                @foreach (var kind in ProjectOutputKind.All)
                {
                    <MudSelectItem Value="@kind">@L[kind]</MudSelectItem>
                }
            </MudSelect>

            @if (IsStandardKind)
            {
                <MudSelect @bind-Value="_standardSubtype"
                           Label="@(L["Standard project subtype"])"
                           HelperText="@(L["Resource exchange template for this project."])"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="baron-influence-field">
                    @foreach (var subtype in ProjectStandardSubtype.All)
                    {
                        <MudSelectItem Value="@subtype">@L[subtype]</MudSelectItem>
                    }
                </MudSelect>

                @if (IsBuyProductionSubtype)
                {
                    <MudPaper Class="pa-3 mb-3" Outlined="true">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Buy Production"]</MudText>
                        <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mb-2">
                            @L["Spend gold from Treasury to gain Production. 1 Production costs {0} imperials. Maximum purchase: floor(Loyalty ÷ 2) = {1} Production (Loyalty: {2}).",
                                ProjectStandardFormulas.BuyProductionGoldPerUnit,
                                _maxProduction,
                                PpbFormat.Additive(LoyaltyTotal)]
                        </MudText>
                        @if (_maxProduction <= 0)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                                @L["Loyalty is too low to buy Production (need at least 2 Loyalty)."]
                            </MudAlert>
                        }
                        else
                        {
                            <MudSlider T="int"
                                       Value="_buyProductionGold"
                                       ValueChanged="OnBuyProductionGoldChanged"
                                       Min="0"
                                       Max="@_maxGoldSpend"
                                       Step="@ProjectStandardFormulas.BuyProductionGoldPerUnit"
                                       Color="Color.Primary"
                                       Class="mb-2" />
                            <div class="d-flex flex-wrap gap-3">
                                <MudText Typo="Typo.body2">
                                    @L["Gold spent"]: <strong>@_buyProductionGold</strong>
                                </MudText>
                                <MudText Typo="Typo.body2">
                                    @L["Production gained"]: <strong>@_buyProductionAmount</strong>
                                </MudText>
                            </div>
                        }
                    </MudPaper>
                }
            }

            <MudTextField @bind-Value="_resultDescription"
                          Label="@(L["Output summary"])"
                          HelperText="@ResultSummaryHelper"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="2"
                          Class="baron-influence-field" />

            @if (CanManage)
            {
                <MudCheckBox @bind-Value="_hideResultFromBaron"
                             Label="@(L["Hide result for baron"])"
                             Color="Color.Default"
                             Dense="true"
                             Class="barony-checkbox baron-influence-field" />
                <MudText Typo="Typo.caption" Style="color:var(--barony-muted); margin-top:-0.5rem; margin-bottom:0.75rem;">
                    @L["Baron still sees the project description, but result resources and output summary stay hidden until the project is completed."]
                </MudText>
                <MudSelect @bind-Value="_status"
                           Label="@(L["Status"])"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="baron-influence-field">
                    @foreach (var status in ProjectStatus.All)
                    {
                        <MudSelectItem Value="@status">@StatusLabel(status)</MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField @bind-Value="_turnsRemaining"
                                 Label="@(L["Turns remaining"])"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="0"
                                 Class="baron-influence-field" />
                @if (!IsStandardKind)
                {
                    <MudTextField @bind-Value="_notes"
                                  Label="@(L["Notes"])"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="2"
                                  Class="baron-influence-field" />
                    <MudSelect @bind-Value="_allowedCostModes"
                               Label="@(L["Payment options"])"
                               HelperText="@(L["Which ways players can cover this project's cost."])"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Class="baron-influence-field">
                        @foreach (var option in ProjectAllowedCostModes.All)
                        {
                            <MudSelectItem Value="@option">@AllowedCostModesLabel(option)</MudSelectItem>
                        }
                    </MudSelect>
                    <PpbVectorEditor @bind-Value="_costGoldProduction"
                                     Title="@(L["Cost — Gold & Production"])"
                                     Compact="true"
                                     Columns="@ProjectCostCatalog.GoldProduction" />
                    <PpbVectorEditor @bind-Value="_costMaterials"
                                     Title="@(L["Cost — Materials"])"
                                     Compact="true"
                                     Columns="@ProjectCostCatalog.Materials" />
                    @if (_outputKind == ProjectOutputKind.OneTimeResources)
                    {
                        <PpbVectorEditor @bind-Value="_resultAdditive"
                                         Title="@(L["Resources granted on completion (added to stocks)"])"
                                         Compact="true"
                                         Columns="@ResourceCatalog.All" />
                    }
                    else if (!IsOtherKind)
                    {
                        <PpbVectorEditor @bind-Value="_resultAdditive"
                                         Title="@(L["Expected output — additive (+)"])"
                                         Compact="true" />
                        <PpbVectorEditor @bind-Value="_resultPercent"
                                         Title="@(L["Expected output — percent (%)"])"
                                         Compact="true"
                                         Percent="true" />
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mb-1">
                            @L["Other projects grant no automatic resources or PPB — only the description / output summary when completed."]
                        </MudText>
                    }
                }
                else
                {
                    <MudTextField @bind-Value="_notes"
                                  Label="@(L["Notes"])"
                                  HelperText="@(L["Optional MG notes. Subtype is stored automatically."])"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="2"
                                  Class="baron-influence-field" />
                }
            }
            else if (!IsStandardKind)
            {
                <MudText Typo="Typo.caption" Style="color:var(--barony-muted);">
                    @L["New projects are saved as Draft. The game master sets costs, PPB output, and status."]
                </MudText>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Class="baron-influence-save-btn" Variant="Variant.Filled" OnClick="Save">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public BaronyProjectDTO Project { get; set; } = new();
    /// <summary>When false, only player-facing draft fields are editable (create flow).</summary>
    [Parameter] public bool CanManage { get; set; }
    /// <summary>Domain Panel Loyalty total — caps Buy Production projects.</summary>
    [Parameter] public decimal LoyaltyTotal { get; set; }

    private string _name = string.Empty;
    private string? _description;
    private string _outputKind = ProjectOutputKind.DecreeOrTechnology;
    private string _standardSubtype = ProjectStandardSubtype.BuyProduction;
    private int _buyProductionGold;
    private string _status = ProjectStatus.Draft;
    private int _turnsRemaining;
    private string? _resultDescription;
    private bool _hideResultFromBaron;
    private string? _notes;
    private string _allowedCostModes = ProjectAllowedCostModes.PlayerChoice;
    private PpbVector _costGoldProduction = new();
    private PpbVector _costMaterials = new();
    private PpbVector _resultAdditive = new();
    private PpbVector _resultPercent = new();

    private bool IsStandardKind =>
        ProjectStandardFormulas.IsStandardKind(_outputKind);

    private bool IsBuyProductionSubtype =>
        string.Equals(_standardSubtype, ProjectStandardSubtype.BuyProduction, StringComparison.OrdinalIgnoreCase);

    private bool IsOtherKind =>
        string.Equals(_outputKind, ProjectOutputKind.Other, StringComparison.OrdinalIgnoreCase);

    private int _maxProduction => ProjectStandardFormulas.MaxProductionFromLoyalty(LoyaltyTotal);
    private int _maxGoldSpend => ProjectStandardFormulas.GoldForProduction(_maxProduction);
    private int _buyProductionAmount => ProjectStandardFormulas.ProductionFromGold(_buyProductionGold);

    private string OutputKindHelper => IsStandardKind
        ? L["Exchange one resource for another when the project is funded and completed."]
        : IsOtherKind
            ? L["Like one-time resources, but no stock grant is required — only the description / output summary."]
            : L["What this project becomes when completed."];

    private string ResultSummaryHelper => IsStandardKind
        ? L["Short summary of the exchange (auto-filled for Buy Production)."]
        : IsOtherKind
            ? L["What the project achieves when completed (narrative only — no automatic bonuses)."]
            : L["Short description of the expected result (decree, event, building, etc.)."];

    protected override void OnInitialized()
    {
        _name = Project.Name;
        _description = Project.Description;
        _outputKind = string.IsNullOrWhiteSpace(Project.OutputKind)
            ? ProjectOutputKind.DecreeOrTechnology
            : Project.OutputKind;
        _status = Project.Status;
        _turnsRemaining = Project.TurnsRemaining;
        _resultDescription = Project.ResultDescription;
        _hideResultFromBaron = Project.HideResultFromBaron;
        _notes = Project.Notes;
        _allowedCostModes = string.IsNullOrWhiteSpace(Project.AllowedCostModes)
            ? ProjectAllowedCostModes.PlayerChoice
            : Project.AllowedCostModes;
        _costGoldProduction = ProjectCostCatalog.SliceGoldProduction(Project.CostGoldProduction).Clone();
        _costMaterials = ProjectCostCatalog.SliceMaterials(Project.CostMaterials).Clone();
        _resultAdditive = Project.ResultAdditive.Clone();
        _resultPercent = Project.ResultPercent.Clone();

        _standardSubtype = ProjectStandardNotes.GetSubtype(Project.Notes)
            ?? ProjectStandardSubtype.BuyProduction;

        if (IsStandardKind && IsBuyProductionSubtype)
        {
            var gold = (int)_costGoldProduction[Ppb.Treasury];
            _buyProductionGold = ProjectStandardFormulas.ClampGoldSpend(gold, LoyaltyTotal);
        }
    }

    private void OnBuyProductionGoldChanged(int value)
    {
        _buyProductionGold = ProjectStandardFormulas.ClampGoldSpend(value, LoyaltyTotal);
    }

    private void Cancel() => MudDialog.Cancel();

    private bool TryApplyStandardExchange(out string? error)
    {
        error = null;
        if (!IsStandardKind)
            return true;

        if (!IsBuyProductionSubtype)
        {
            error = L["This standard project subtype is not configured yet."];
            return false;
        }

        if (_maxProduction <= 0)
        {
            error = L["Loyalty is too low to buy Production (need at least 2 Loyalty)."];
            return false;
        }

        if (_buyProductionGold <= 0)
        {
            error = L["Select how much gold to spend on Production."];
            return false;
        }

        _costGoldProduction = new();
        _costMaterials = new();
        _resultAdditive = new();
        _resultPercent = new();
        _costGoldProduction[Ppb.Treasury] = _buyProductionGold;
        _resultAdditive[Ppb.Production] = _buyProductionAmount;
        _allowedCostModes = ProjectAllowedCostModes.GoldProductionOnly;
        _turnsRemaining = 0;
        _notes = ProjectStandardNotes.SetSubtype(_notes, _standardSubtype);

        if (string.IsNullOrWhiteSpace(_resultDescription))
        {
            _resultDescription = L["Buy {0} Production for {1} imperials.",
                _buyProductionAmount, _buyProductionGold];
        }

        return true;
    }

    private void Save()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            _snackBar.Add(L["Name is required."], Severity.Warning);
            return;
        }

        if (IsStandardKind && !TryApplyStandardExchange(out var standardError))
        {
            _snackBar.Add(standardError!, Severity.Warning);
            return;
        }

        Project.Name = _name.Trim();
        Project.Description = string.IsNullOrWhiteSpace(_description) ? string.Empty : _description.Trim();
        Project.OutputKind = _outputKind;
        Project.ResultDescription = string.IsNullOrWhiteSpace(_resultDescription) ? string.Empty : _resultDescription.Trim();

        if (CanManage)
        {
            Project.HideResultFromBaron = _hideResultFromBaron;
            Project.Status = _status;
            Project.TurnsRemaining = Math.Max(0, _turnsRemaining);
            Project.Notes = string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim();
            Project.AllowedCostModes = _allowedCostModes;
            Project.CostGoldProduction = ProjectCostCatalog.SliceGoldProduction(_costGoldProduction).Clone();
            Project.CostMaterials = ProjectCostCatalog.SliceMaterials(_costMaterials).Clone();
            if (_outputKind == ProjectOutputKind.OneTimeResources)
            {
                Project.ResultAdditive = ResourceCatalog.Slice(_resultAdditive);
                Project.ResultPercent = new();
                if (Project.ResultAdditive.IsEmpty)
                {
                    _snackBar.Add(
                        L["One-time resources need at least one cumulative resource (Food, Gold, Production, …)."],
                        Severity.Warning);
                    return;
                }
            }
            else if (IsOtherKind)
            {
                Project.ResultAdditive = new();
                Project.ResultPercent = new();
            }
            else if (IsStandardKind)
            {
                Project.ResultAdditive = ResourceCatalog.Slice(_resultAdditive);
                Project.ResultPercent = new();
            }
            else
            {
                Project.ResultAdditive = _resultAdditive.Clone();
                Project.ResultPercent = _resultPercent.Clone();
            }
        }
        else if (IsStandardKind)
        {
            Project.Status = ProjectStatus.Draft;
            Project.TurnsRemaining = 0;
            Project.HideResultFromBaron = false;
            Project.AllowedCostModes = ProjectAllowedCostModes.GoldProductionOnly;
            Project.CostGoldProduction = ProjectCostCatalog.SliceGoldProduction(_costGoldProduction).Clone();
            Project.CostMaterials = new();
            Project.ResultAdditive = ResourceCatalog.Slice(_resultAdditive);
            Project.ResultPercent = new();
            Project.Notes = ProjectStandardNotes.SetSubtype(null, _standardSubtype);
            Project.Allocated = new();
            Project.SelectedCostMode = null;
        }
        else
        {
            Project.Status = ProjectStatus.Draft;
            Project.TurnsRemaining = 0;
            Project.Notes = null;
            Project.HideResultFromBaron = false;
            Project.AllowedCostModes = ProjectAllowedCostModes.PlayerChoice;
            Project.CostGoldProduction = new();
            Project.CostMaterials = new();
            Project.ResultAdditive = new();
            Project.ResultPercent = new();
            Project.Allocated = new();
            Project.SelectedCostMode = null;
        }

        MudDialog.Close(DialogResult.Ok(Project));
    }

    private static string AllowedCostModesLabel(string option) => option switch
    {
        ProjectAllowedCostModes.GoldProductionOnly => DA_Common.Localization.Loc.T("Gold & Production only"),
        ProjectAllowedCostModes.MaterialsOnly => DA_Common.Localization.Loc.T("Materials only"),
        ProjectAllowedCostModes.PlayerChoice => DA_Common.Localization.Loc.T("Player choice (both tracks)"),
        ProjectAllowedCostModes.Combined => DA_Common.Localization.Loc.T("Combined (Gold, Production & Materials together)"),
        _ => option,
    };

    private static string StatusLabel(string status) =>
        LocCatalog.NameOrRaw(status, ProjectStatus.All);
}
