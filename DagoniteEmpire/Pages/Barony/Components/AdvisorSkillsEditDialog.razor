@namespace DagoniteEmpire.Pages.Barony.Components

<MudDialog Class="baron-influence-dialog"
           ContentClass="baron-influence-dialog-content"
           ActionsClass="baron-influence-dialog-actions">
    <DialogContent>
        <div class="barony-dialog-theme baron-influence-edit-dialog">
            <PpbVectorEditor @bind-Value="_skills"
                             Title="Administrative skills"
                             Compact="true"
                             ExcludeTreasury="true"
                             SignificantKeys="@_significantKeys" />
            @if (_significantKeys.Count > 0)
            {
                <MudText Typo="Typo.caption" Class="mt-2 significant-skills-hint">
                    Bold labels mark significant skills for this office. All skills can be edited; only significant ones currently affect barony parameters.
                </MudText>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">Cancel</MudButton>
        <MudButton Class="baron-influence-save-btn" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public PpbVector Skills { get; set; } = new();
    [Parameter] public IReadOnlySet<Ppb>? SignificantKeys { get; set; }

    private PpbVector _skills = new();
    private HashSet<Ppb> _significantKeys = new();

    protected override void OnInitialized()
    {
        _skills = Skills.Clone();
        _significantKeys = SignificantKeys?.ToHashSet() ?? new HashSet<Ppb>();
    }

    private void Cancel() => MudDialog.Cancel();

    private void Save() => MudDialog.Close(DialogResult.Ok(_skills));
}
