@namespace DagoniteEmpire.Pages.Barony.Components
@inject IBaronyRepository _baronyRepo
@inject ISnackbar _snackBar
@inject IDialogService _dialogService

<BaronySection Title="@(L["Chambers"])">
    <Summary>
        <PpbSummaryChips Vector="@Glance" />
    </Summary>
    <ChildContent>
        @if (CanManage)
        {
            <div class="lords-seat-toolbar">
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.GridOn"
                           OnClick="EditGridAsync">
                    @L["Grid ({0}×{1})", Seat.GridWidth, Seat.GridHeight]
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddRoomAsync">
                    @L["Add chamber"]
                </MudButton>
            </div>
            <div class="lords-seat-levelbar">
                <span class="lords-seat-levelbar__label">@L["Floor"]</span>
                @foreach (var level in ActiveLevels)
                {
                    <button type="button"
                            class="@LevelChipClass(level)"
                            @onclick="() => SelectLevel(level)">
                        @level
                    </button>
                }
                @if (AvailableLevelsToAdd.Any())
                {
                    <span class="lords-seat-levelbar__label lords-seat-levelbar__label--add">@L["Add"]</span>
                    @foreach (var level in AvailableLevelsToAdd)
                    {
                        var levelToAdd = level;
                        <BaronyTooltip Text="@($"Add {SeatFloorLevel.Label(levelToAdd)}")">
                            <button type="button"
                                    class="lords-seat-levelchip lords-seat-levelchip--add"
                                    @onclick="() => AddLevelAsync(levelToAdd)">
                                +@levelToAdd
                            </button>
                        </BaronyTooltip>
                    }
                }
                <BaronyTooltip Text="@(L["Remove current floor"])">
                    <MudIconButton Icon="@Icons.Material.Filled.Remove"
                                   Size="Size.Small"
                                   Disabled="@(_currentLevel == SeatFloorLevel.Ground || ActiveLevels.Count <= 1)"
                                   OnClick="RemoveCurrentLevelAsync" />
                </BaronyTooltip>
            </div>
            <div class="lords-seat-paintbar">
                <span class="lords-seat-levelbar__label">@L["Paint"]</span>
                <BaronyTooltip Text="@SeatTileKind.Label(SeatTileKind.Wall)">
                    <button type="button"
                            class="@PaintChipClassWall()"
                            @onclick="PaintWall">@L["Wall"]</button>
                </BaronyTooltip>
                <BaronyTooltip Text="@SeatTileKind.Label(SeatTileKind.Ground)">
                    <button type="button"
                            class="@PaintChipClassGround()"
                            @onclick="PaintGround">@L["Ground"]</button>
                </BaronyTooltip>
                <BaronyTooltip Text="@SeatTileKind.Label(SeatTileKind.Water)">
                    <button type="button"
                            class="@PaintChipClassWater()"
                            @onclick="PaintWater">@L["Water"]</button>
                </BaronyTooltip>
                <BaronyTooltip Text="@(L["Erase painted tile"])">
                    <button type="button"
                            class="@PaintChipClassErase()"
                            @onclick="PaintErase">@L["Erase"]</button>
                </BaronyTooltip>
                @if (_paintKind is not null)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearPaintMode">@L["Done"]</MudButton>
                }
            </div>
        }
        else if (ActiveLevels.Count > 1)
        {
            <div class="lords-seat-levelbar">
                <span class="lords-seat-levelbar__label">@L["Floor"]</span>
                @foreach (var level in ActiveLevels)
                {
                    <button type="button"
                            class="@LevelChipClass(level)"
                            @onclick="() => SelectLevel(level)">
                        @level
                    </button>
                }
            </div>
        }

        @if (CanManage || Seat.Rooms.Any(r => r.GridW > 0 && r.GridH > 0) || Seat.Tiles.Count > 0 || ActiveLevels.Count > 0)
        {
            <div class="lords-seat-plan-wrap">
                @if (CanManage && _placementMode)
                {
                    <MudText Typo="Typo.caption" Class="lords-seat-placement-hint">
                        @L["Click a grid cell on {0} to place a new chamber (2×2).", SeatFloorLevel.Label(_currentLevel)]
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="CancelPlacementMode">@L["Cancel"]</MudButton>
                    </MudText>
                }
                else if (CanManage && _paintKind is not null)
                {
                    <MudText Typo="Typo.caption" Class="lords-seat-placement-hint">
                        @L["Painting {0} on {1}. Click or drag across cells.", PaintModeLabel(), SeatFloorLevel.Label(_currentLevel)]
                    </MudText>
                }
                else if (CanManage)
                {
                    <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="lords-seat-placement-hint">
                        @L["{0}. Click a chamber to assign purpose. Drag to reposition. Use paint for walls, ground, and water.", SeatFloorLevel.Label(_currentLevel)]
                    </MudText>
                }
                <div class="@PlanClass()"
                     style="--seat-cols:@Seat.GridWidth; --seat-rows:@Seat.GridHeight;"
                     @ondragover="OnPlanDragOver"
                     @ondragover:preventDefault
                     @onmouseup="EndPaintStroke"
                     @onmouseleave="EndPaintStroke">
                    @* Painted terrain layer (always visible under chambers). *@
                    @foreach (var paint in CurrentLevelTileList)
                    {
                        <div class="@PaintLayerClass(paint.Kind)"
                             style="grid-column:@(paint.X + 1); grid-row:@(paint.Y + 1);"
                             aria-hidden="true">
                        </div>
                    }
                    @for (var y = 0; y < Seat.GridHeight; y++)
                    {
                        for (var x = 0; x < Seat.GridWidth; x++)
                        {
                            var cellX = x;
                            var cellY = y;
                            <BaronyTooltip Text="@CellTitle(cellX, cellY)"
                                           Class="lords-seat-plan__room-tip"
                                           Style="@($"grid-column:{cellX + 1}; grid-row:{cellY + 1};")">
                                <div @key="@($"seat-cell-{_currentLevel}-{cellX}-{cellY}")"
                                     class="lords-seat-plan__cell @CellDropClass(cellX, cellY)"
                                     @ondragenter="() => OnCellDragEnter(cellX, cellY)"
                                     @ondragleave="() => OnCellDragLeave(cellX, cellY)"
                                     @ondragover="e => OnCellDragOver(e, cellX, cellY)"
                                     @ondragover:preventDefault
                                     @ondrop="e => OnCellDrop(e, cellX, cellY)"
                                     @ondrop:preventDefault
                                     @onmousedown="() => OnCellMouseDown(cellX, cellY)"
                                     @onmousedown:preventDefault="@IsPainting"
                                     @onmouseenter="() => OnCellMouseEnter(cellX, cellY)"
                                     @onclick="() => OnCellClick(cellX, cellY)">
                                </div>
                            </BaronyTooltip>
                        }
                    }
                    @foreach (var room in PlacedRooms)
                    {
                        var layoutIssue = GetLayoutIssue(room);
                        var purposeName = PurposeNameOnly(room);
                        <div @key="@($"seat-room-{room.Id}")"
                             class="lords-seat-plan__room-slot"
                             style="grid-column:@(room.GridX + 1) / span @room.GridW; grid-row:@(room.GridY + 1) / span @room.GridH;">
                            <BaronyTooltip Title="@room.Name"
                                           Text="@RoomPlanTooltip(room, layoutIssue)"
                                           Class="lords-seat-plan__room-tip"
                                           Placement="Placement.Top">
                                <div draggable="@DraggableAttr()"
                                     class="@RoomElementClass(room, layoutIssue)"
                                     @onclick:stopPropagation="true"
                                     @onclick="() => OnRoomClickAsync(room)"
                                     @ondragstart="e => OnRoomDragStart(e, room)"
                                     @ondragend="OnRoomDragEndAsync">
                                    @if (!string.IsNullOrWhiteSpace(purposeName))
                                    {
                                        <span class="lords-seat-plan__room-purpose">@purposeName</span>
                                    }
                                    <span class="lords-seat-plan__room-name">@room.Name</span>
                                    <span class="lords-seat-plan__room-meta">@room.SizeCategory</span>
                                </div>
                            </BaronyTooltip>
                        </div>
                    }
                    @if (DropPreview is { } preview)
                    {
                        <div class="lords-seat-plan__ghost @preview.CssClass"
                             style="grid-column:@(preview.X + 1) / span @preview.W; grid-row:@(preview.Y + 1) / span @preview.H;"
                             aria-hidden="true">
                        </div>
                    }
                </div>
            </div>
        }

        @if (Seat.Rooms.Count == 0)
        {
            <MudText Typo="Typo.body2" Style="color:var(--barony-muted);">
                @L["No chambers yet."]
                @if (CanManage)
                {
                    <text> @L["Use “Add chamber” to create the lord's seat layout."]</text>
                }
            </MudText>
        }
        else
        {
            <div class="lords-seat-table-wrap">
                <table class="ppb-table ppb-table--advisors ppb-table--lined lords-seat-table">
                    <colgroup>
                        <col class="lords-seat-col-name" />
                        <col class="lords-seat-col-purpose" />
                        <col class="lords-seat-col-level" />
                        <col class="lords-seat-col-size" />
                        <col class="lords-seat-col-occupant" />
                        <col class="lords-seat-col-prestige" />
                        @foreach (var _ in PpbCatalog.All)
                        {
                            <col class="ppb-pair-col" />
                            <col class="ppb-pair-col" />
                        }
                    </colgroup>
                    <thead>
                        <tr>
                            <th rowspan="2" class="ppb-row-label lords-seat-col-name">@L["Chamber"]</th>
                            <th rowspan="2" class="ppb-row-label lords-seat-col-purpose">@L["Purpose"]</th>
                            <th rowspan="2" class="lords-seat-col-level">
                                <BaronyTooltip Text="@(L["Floor level"])">
                                    <span>@L["Floor"]</span>
                                </BaronyTooltip>
                            </th>
                            <th rowspan="2" class="lords-seat-col-size">
                                <BaronyTooltip Text="@(L["Size category (tiles)"])">
                                    <span>@L["Size"]</span>
                                </BaronyTooltip>
                            </th>
                            <th rowspan="2" class="lords-seat-col-occupant">@L["Occupant"]</th>
                            <th rowspan="2" class="lords-seat-col-prestige seat-php-header">
                                <BaronyTooltip Text="@(L["Prestige / Honor / Fear (per-chamber, × multiplier)"])">
                                    <span>@L["Prestige"]</span>
                                </BaronyTooltip>
                            </th>
                            @foreach (var info in PpbCatalog.All)
                            {
                                <th colspan="2">
                                    <BaronyTooltip Text="@info.Code">
                                        <span>@PpbShort(info.Key)</span>
                                    </BaronyTooltip>
                                </th>
                            }
                        </tr>
                        <tr>
                            @foreach (var _ in PpbCatalog.All)
                            {
                                <th class="ppb-subcol ppb-subcol--add">+</th>
                                <th class="ppb-subcol ppb-subcol--pct">%</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var room in OrderedRooms)
                        {
                            var (additive, percent) = RoomPpbValues(room);
                            <tr class="@RowClass(room)">
                                <td class="lords-seat-col-name">
                                    <div class="city-building-name-cell">
                                        <BaronyTooltip Title="@(L["Chamber"])" Text="@RoomTooltip(room, GetLayoutIssue(room))">
                                            <span class="city-building-name-text">@room.Name</span>
                                        </BaronyTooltip>
                                        @if (CanManage)
                                        {
                                            <span class="city-building-name-actions">
                                                <BaronyTooltip Text="@(L["Edit chamber"])">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                                   Size="Size.Small"
                                                                   OnClick="@(() => EditRoomAsync(room))" />
                                                </BaronyTooltip>
                                                <BaronyTooltip Text="@(L["Remove chamber"])">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                   Size="Size.Small"
                                                                   Color="Color.Error"
                                                                   OnClick="@(() => DeleteRoomAsync(room))" />
                                                </BaronyTooltip>
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="lords-seat-col-purpose">
                                    <div class="city-building-name-cell">
                                        <BaronyTooltip Title="@(L["Purpose"])" Text="@PurposeTooltip(room)">
                                            <span class="city-building-name-text">@PurposeLabel(room)</span>
                                        </BaronyTooltip>
                                        @if (CanEdit && !room.IsRuin)
                                        {
                                            <span class="city-building-name-actions">
                                                <BaronyTooltip Text="@(L["Assign purpose"])">
                                                    <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz"
                                                                   Size="Size.Small"
                                                                   OnClick="@(() => AssignPurposeAsync(room))" />
                                                </BaronyTooltip>
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="lords-seat-col-level">
                                    <BaronyTooltip Text="@SeatFloorLevel.Label(room.Level)">
                                        <span>@room.Level</span>
                                    </BaronyTooltip>
                                </td>
                                <td class="lords-seat-col-size">
                                    <BaronyTooltip Text="@($"{room.SizeCategory} · {room.TileCount} tiles")">
                                        <span>@(SeatRoomSizeCategory.Letter(room.SizeCategory))(@room.TileCount)</span>
                                    </BaronyTooltip>
                                </td>
                                <td class="lords-seat-col-occupant">
                                    @{
                                        var occupantName = OccupantNameOnly(room);
                                        var occupantTip = OccupantSubtitle(room);
                                    }
                                    @if (string.IsNullOrWhiteSpace(occupantName))
                                    {
                                        <span class="lords-seat-muted">—</span>
                                    }
                                    else
                                    {
                                        <BaronyTooltip Title="@(L["Occupant"])" Text="@(occupantTip ?? occupantName)">
                                            <span class="lords-seat-occupant-name">@occupantName</span>
                                        </BaronyTooltip>
                                    }
                                </td>
                                <td class="lords-seat-col-prestige seat-php-cell">
                                    @{
                                        var php = RoomPhpTotals(room);
                                        var mult = room.PrestigeMultiplier;
                                    }
                                    <BaronyTooltip Title="@(L["Prestige / Honor / Fear"])"
                                                   Text="@PhpTooltip(room, php, mult)">
                                        @if (php is null)
                                        {
                                                <span class="seat-php-values seat-php-values--stacked seat-php-values--empty">
                                                <span class="seat-php-value @BaronPhpVisuals.CssClass(PhpMetric.Prestige)">
                                                    <PhpMetricIcon Metric="PhpMetric.Prestige" Title="" />
                                                    <span class="seat-php-value__num">—</span>
                                                </span>
                                                <span class="seat-php-value @BaronPhpVisuals.CssClass(PhpMetric.Honor)">
                                                    <PhpMetricIcon Metric="PhpMetric.Honor" Title="" />
                                                    <span class="seat-php-value__num">—</span>
                                                </span>
                                                <span class="seat-php-value @BaronPhpVisuals.CssClass(PhpMetric.Fear)">
                                                    <PhpMetricIcon Metric="PhpMetric.Fear" Title="" />
                                                    <span class="seat-php-value__num">—</span>
                                                </span>
                                                <span class="lords-seat-prestige-mult">(×@mult.ToString("0.##"))</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="seat-php-values seat-php-values--stacked">
                                                <span class="seat-php-value @BaronPhpVisuals.CssClass(PhpMetric.Prestige)">
                                                    <PhpMetricIcon Metric="PhpMetric.Prestige" Title="" />
                                                    <span class="seat-php-value__num">@FmtPhp(php.Value.Prestige)</span>
                                                </span>
                                                <span class="seat-php-value @BaronPhpVisuals.CssClass(PhpMetric.Honor)">
                                                    <PhpMetricIcon Metric="PhpMetric.Honor" Title="" />
                                                    <span class="seat-php-value__num">@FmtPhp(php.Value.Honor)</span>
                                                </span>
                                                <span class="seat-php-value @BaronPhpVisuals.CssClass(PhpMetric.Fear)">
                                                    <PhpMetricIcon Metric="PhpMetric.Fear" Title="" />
                                                    <span class="seat-php-value__num">@FmtPhp(php.Value.Fear)</span>
                                                </span>
                                                <span class="lords-seat-prestige-mult">(×@mult.ToString("0.##"))</span>
                                            </span>
                                        }
                                    </BaronyTooltip>
                                </td>
                                @foreach (var info in PpbCatalog.All)
                                {
                                    <td class="@($"{PpbCellStyle.ValueClass(info.Key, additive[info.Key])}{(room.IsRuin ? " ppb-cell-struck" : "")}")">@FmtAdd(additive[info.Key])</td>
                                    <td class="@($"{PpbCellStyle.ValueClass(info.Key, percent[info.Key])}{(room.IsRuin ? " ppb-cell-struck" : "")}")">@FmtPct(percent[info.Key])</td>
                                }
                            </tr>
                        }
                        @if (OrderedRooms.Any())
                        {
                            <tr class="ppb-summary-row">
                                <td class="ppb-row-label" colspan="5">@L["Σ Lord's Seat"]</td>
                                <td class="lords-seat-col-prestige seat-php-cell">
                                    <BaronyTooltip Title="@(L["Prestige / Honor / Fear"])"
                                                   Text="@($"Lord's Seat total: Prestige {FmtPhp(SeatPhpSum.Prestige)} · Honor {FmtPhp(SeatPhpSum.Honor)} · Fear {FmtPhp(SeatPhpSum.Fear)}")">
                                        <span class="seat-php-values">
                                            <span class="seat-php-value @BaronPhpVisuals.CssClass(PhpMetric.Prestige)">
                                                <PhpMetricIcon Metric="PhpMetric.Prestige" Title="" />
                                                <span class="seat-php-value__num">@FmtPhp(SeatPhpSum.Prestige)</span>
                                            </span>
                                            <span class="seat-php-value @BaronPhpVisuals.CssClass(PhpMetric.Honor)">
                                                <PhpMetricIcon Metric="PhpMetric.Honor" Title="" />
                                                <span class="seat-php-value__num">@FmtPhp(SeatPhpSum.Honor)</span>
                                            </span>
                                            <span class="seat-php-value @BaronPhpVisuals.CssClass(PhpMetric.Fear)">
                                                <PhpMetricIcon Metric="PhpMetric.Fear" Title="" />
                                                <span class="seat-php-value__num">@FmtPhp(SeatPhpSum.Fear)</span>
                                            </span>
                                        </span>
                                    </BaronyTooltip>
                                </td>
                                @foreach (var info in PpbCatalog.All)
                                {
                                    <td class="@PpbCellStyle.ValueClass(info.Key, AdditiveSum[info.Key])"><b>@FmtAdd(AdditiveSum[info.Key])</b></td>
                                    <td class="@PpbCellStyle.ValueClass(info.Key, PercentSum[info.Key])"><b>@FmtPct(PercentSum[info.Key])</b></td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </ChildContent>
</BaronySection>

@code {
    [Parameter] public BaronySeatDTO Seat { get; set; } = new();
    [Parameter] public List<SeatPurposeTemplateDTO> PurposeTemplates { get; set; } = new();
    [Parameter] public List<AdvisorDTO> Advisors { get; set; } = new();
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanManage { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool _placementMode;
    private string? _paintKind;
    private bool _paintStrokeActive;
    private int _currentLevel = SeatFloorLevel.Ground;
    private int? _dragRoomId;
    private int _dragRoomW = 1;
    private int _dragRoomH = 1;
    /// <summary>Tile within the chamber that was grabbed (0,0 = top-left).</summary>
    private int _grabOffsetX;
    private int _grabOffsetY;
    /// <summary>Grid cell currently under the cursor while dragging.</summary>
    private int? _hoverCellX;
    private int? _hoverCellY;
    private int? _lastHoverCellX;
    private int? _lastHoverCellY;
    private bool _layoutMovePending;
    private bool _suppressRoomClick;

    /// <summary>Matches CSS <c>--seat-tile</c> + gap on <c>.lords-seat-plan</c>.</summary>
    private const double SeatTilePx = 32;
    private const double SeatGapPx = 0;

    private sealed record DropPreviewInfo(int X, int Y, int W, int H, string CssClass);

    private (int X, int Y)? DropOrigin
    {
        get
        {
            if (_hoverCellX is not int hx || _hoverCellY is not int hy)
                return null;
            return (hx - _grabOffsetX, hy - _grabOffsetY);
        }
    }

    private DropPreviewInfo? DropPreview
    {
        get
        {
            if (_dragRoomId is null || DropOrigin is not { } origin)
                return null;

            var issue = SeatRoomLayout.GetIssue(
                _dragRoomId.Value,
                origin.X,
                origin.Y,
                _dragRoomW,
                _dragRoomH,
                LevelFootprints,
                Seat.GridWidth,
                Seat.GridHeight);

            var css = issue switch
            {
                SeatRoomLayoutIssue.Overlap => "lords-seat-plan__ghost--overlap",
                SeatRoomLayoutIssue.OutOfBounds => "lords-seat-plan__ghost--invalid",
                _ => "lords-seat-plan__ghost--valid",
            };
            return new DropPreviewInfo(origin.X, origin.Y, _dragRoomW, _dragRoomH, css);
        }
    }

    private IReadOnlyList<int> ActiveLevels =>
        Seat.ActiveLevels is { Count: > 0 }
            ? Seat.ActiveLevels
            : new List<int> { SeatFloorLevel.Ground };

    private IEnumerable<int> AvailableLevelsToAdd =>
        Enumerable.Range(SeatFloorLevel.Min, SeatFloorLevel.Max - SeatFloorLevel.Min + 1)
            .Where(l => !ActiveLevels.Contains(l));

    private IEnumerable<SeatRoomDTO> PlacedRooms =>
        Seat.Rooms.Where(r => r.Level == _currentLevel && r.GridW > 0 && r.GridH > 0);

    private IEnumerable<(int Id, int X, int Y, int W, int H)> LevelFootprints =>
        Seat.Rooms.Where(r => r.Level == _currentLevel)
            .Select(r => (r.Id, r.GridX, r.GridY, r.GridW, r.GridH));

    private IEnumerable<SeatTileDTO> CurrentLevelTileList =>
        Seat.Tiles.Where(t => t.Level == _currentLevel);

    private IReadOnlyDictionary<(int X, int Y), string> CurrentLevelTiles =>
        CurrentLevelTileList
            .GroupBy(t => (t.X, t.Y))
            .ToDictionary(g => g.Key, g => g.First().Kind);

    private string? TileKindAt(int x, int y) =>
        CurrentLevelTiles.TryGetValue((x, y), out var kind) ? kind : null;

    private string? CellTitle(int x, int y)
    {
        var kind = TileKindAt(x, y);
        return kind is null ? null : SeatTileKind.Label(kind);
    }

    private static string PaintLayerClass(string kind) => SeatTileKind.Normalize(kind) switch
    {
        SeatTileKind.Wall => "lords-seat-plan__paint lords-seat-plan__paint--wall",
        SeatTileKind.Ground => "lords-seat-plan__paint lords-seat-plan__paint--ground",
        SeatTileKind.Water => "lords-seat-plan__paint lords-seat-plan__paint--water",
        _ => "lords-seat-plan__paint",
    };

    private bool IsPainting => CanManage && _paintKind is not null;

    private string LevelChipClass(int level) =>
        _currentLevel == level
            ? "lords-seat-levelchip lords-seat-levelchip--active"
            : "lords-seat-levelchip";

    private string PaintChipClass(string kind, string? colorClass)
    {
        var active = _paintKind == kind ? " lords-seat-paintchip--active" : string.Empty;
        return string.IsNullOrEmpty(colorClass)
            ? $"lords-seat-paintchip{active}"
            : $"lords-seat-paintchip {colorClass}{active}";
    }

    private string PaintChipClassWall() => PaintChipClass(SeatTileKind.Wall, "lords-seat-paintchip--wall");
    private string PaintChipClassGround() => PaintChipClass(SeatTileKind.Ground, "lords-seat-paintchip--ground");
    private string PaintChipClassWater() => PaintChipClass(SeatTileKind.Water, "lords-seat-paintchip--water");
    private string PaintChipClassErase() => PaintChipClass(string.Empty, null);

    private void PaintWall() => TogglePaint(SeatTileKind.Wall);
    private void PaintGround() => TogglePaint(SeatTileKind.Ground);
    private void PaintWater() => TogglePaint(SeatTileKind.Water);
    private void PaintErase() => TogglePaint(string.Empty);

    private string PaintModeLabel() =>
        string.IsNullOrEmpty(_paintKind) ? "erase" : SeatTileKind.Label(_paintKind!);

    private string DraggableAttr() => CanManage && !IsPainting ? "true" : "false";

    private string PlanClass()
    {
        var parts = new List<string> { "lords-seat-plan" };
        if (CanManage)
            parts.Add("lords-seat-plan--editable");
        if (_dragRoomId is not null)
            parts.Add("lords-seat-plan--dragging");
        if (IsPainting)
            parts.Add("lords-seat-plan--painting");
        return string.Join(' ', parts);
    }

    private string RoomElementClass(SeatRoomDTO room, SeatRoomLayoutIssue layoutIssue)
    {
        var parts = new List<string> { "lords-seat-plan__room", RoomPlanClass(room, layoutIssue) };
        if (_dragRoomId == room.Id)
            parts.Add("lords-seat-plan__room--dragging");
