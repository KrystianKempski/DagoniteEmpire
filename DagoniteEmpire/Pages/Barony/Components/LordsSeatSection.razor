    private static SeatRoomDTO CloneRoom(SeatRoomDTO source) => new()
    {
        Id = source.Id,
        SeatId = source.SeatId,
        BaronyId = source.BaronyId,
        Name = source.Name,
        Level = source.Level,
        GridX = source.GridX,
        GridY = source.GridY,
        GridW = source.GridW,
        GridH = source.GridH,
        Material = source.Material,
        PrestigeMultiplier = source.PrestigeMultiplier,
        Status = source.Status,
        Additive = source.Additive.Clone(),
        Percent = source.Percent.Clone(),
        PurposeTemplateId = source.PurposeTemplateId,
        OccupantAdvisorId = source.OccupantAdvisorId,
        OccupantCustom = source.OccupantCustom,
        SortOrder = source.SortOrder,
        Traits = source.Traits.Select(t => new SeatRoomTraitDTO
        {
            Id = t.Id,
            Kind = t.Kind,
            Text = t.Text,
            SortOrder = t.SortOrder,
        }).ToList(),
    };

    private static DialogOptions DialogOptions() => new()
    {
        CloseOnEscapeKey = true,
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
    };
}
