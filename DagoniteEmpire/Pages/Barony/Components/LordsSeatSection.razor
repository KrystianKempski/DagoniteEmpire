    private IReadOnlyDictionary<int, SeatPurposeTemplateDTO> PurposeLookup =>
        BaronyCalc.PurposeLookup(PurposeTemplates);

    private IReadOnlyDictionary<int, AdvisorDTO> AdvisorLookup =>
        Advisors.ToDictionary(a => a.Id);

    private IEnumerable<SeatRoomDTO> OrderedRooms =>
        Seat.Rooms.OrderBy(r => r.Level).ThenBy(r => r.SortOrder).ThenBy(r => r.Name, StringComparer.OrdinalIgnoreCase);

    private PpbVector Glance =>
        BaronyCalc.SectionGlance(BaronyCalc.LordsSeatDetailRows(Seat.Rooms, PurposeLookup));

    private PpbVector AdditiveSum =>
        PpbVector.Sum(Seat.Rooms.Where(r => r.ContributesPpb)
            .Select(r => RoomEffectivePpb(r).Additive));

    private PpbVector PercentSum =>
        PpbVector.Sum(Seat.Rooms.Where(r => r.ContributesPpb)
            .Select(r => RoomEffectivePpb(r).Percent));

    private (decimal Prestige, decimal Honor, decimal Fear) SeatPhpSum
    {
        get
        {
            decimal prestige = 0m;
            decimal honor = 0m;
            decimal fear = 0m;

            foreach (var room in Seat.Rooms.Where(r => r.ContributesPpb))
            {
                if (RoomPhpTotals(room) is not { } php)
                    continue;

                prestige += php.Prestige;
                honor += php.Honor;
                fear += php.Fear;
            }

            return (prestige, honor, fear);
        }
    }

    private (PpbVector Additive, PpbVector Percent) RoomEffectivePpb(SeatRoomDTO room) =>
        BaronyCalc.SeatRoomEffectivePpb(room, PurposeLookup);

    private (PpbVector Additive, PpbVector Percent) RoomPpbValues(SeatRoomDTO room)
    {
        var add = room.Additive.Clone();
        var pct = room.Percent.Clone();
        if (room.PurposeTemplateId is int pid && PurposeLookup.TryGetValue(pid, out var purpose))
        {
            add = PpbVector.Sum(new[] { add, purpose.Additive });
            pct = PpbVector.Sum(new[] { pct, purpose.Percent });
        }

        return (add, pct);
    }

    private string PurposeNameOnly(SeatRoomDTO room)
    {
        if (room.PurposeTemplateId is int pid && PurposeLookup.TryGetValue(pid, out var p))
            return p.DisplayName();
        return string.Empty;
    }

    private string PurposeLabel(SeatRoomDTO room)
    {
        if (room.PurposeTemplateId is not int pid || !PurposeLookup.TryGetValue(pid, out var p))
            return "—";
        return p.DisplayName();
    }

    private string? OccupantNameOnly(SeatRoomDTO room)
    {
        if (!string.IsNullOrWhiteSpace(room.OccupantCustom))
            return room.OccupantCustom.Trim();

        if (room.OccupantAdvisorId is int aid && AdvisorLookup.TryGetValue(aid, out var advisor))
        {
            var name = advisor.PersonName?.Trim();
            return string.IsNullOrWhiteSpace(name) ? null : name;
        }

        return null;
    }

    private string? OccupantSubtitle(SeatRoomDTO room)
    {
        if (!string.IsNullOrWhiteSpace(room.OccupantCustom))
            return room.OccupantCustom.Trim();

        if (room.OccupantAdvisorId is not int aid || !AdvisorLookup.TryGetValue(aid, out var advisor))
            return null;

        return OccupantDisplayName(advisor);
    }

    private static string OccupantDisplayName(AdvisorDTO advisor)
    {
        var name = advisor.PersonName.Trim();
        if (!string.IsNullOrWhiteSpace(advisor.Title))
            return $"{name} — {advisor.Title}";
        if (!advisor.IsBaron)
        {
            var role = BaronyCalc.AdvisorRoleLabel(advisor);
            if (!string.IsNullOrWhiteSpace(role))
                return $"{name} — {role}";
        }

        return name;
    }

    private string PurposeTooltip(SeatRoomDTO room)
    {
        if (room.PurposeTemplateId is not int pid || !PurposeLookup.TryGetValue(pid, out var p))
            return "No purpose assigned.";

        var lines = new List<string> { p.Name };
        var occupant = OccupantSubtitle(room);
        if (!string.IsNullOrWhiteSpace(occupant))
            lines.Add($"Assigned: {occupant}");
        else if (!string.IsNullOrWhiteSpace(p.WhoOccupies))
            lines.Add($"Typical occupant: {p.WhoOccupies}");
        if (p.SleepCapacity > 0)
            lines.Add($"Sleep capacity: {p.SleepCapacity}");
        if (!string.IsNullOrWhiteSpace(p.Description))
            lines.Add(p.Description);
        return string.Join("\n", lines);
    }

    private string DescriptionText(SeatRoomDTO room)
    {
        var parts = new List<string>();
        if (room.PurposeTemplateId is int pid && PurposeLookup.TryGetValue(pid, out var p)
            && !string.IsNullOrWhiteSpace(p.Description))
        {
            parts.Add(p.Description);
        }

        foreach (var trait in room.Traits.OrderBy(t => t.SortOrder))
            parts.Add($"[{trait.Kind}] {trait.Text}");

        return string.Join(" ", parts);
    }

    private (decimal Prestige, decimal Honor, decimal Fear)? RoomPhpTotals(SeatRoomDTO room)
    {
        if (room.PurposeTemplateId is not int pid || !PurposeLookup.TryGetValue(pid, out var purpose))
            return null;

        var mult = room.PrestigeMultiplier;
        return (
            mult * purpose.AdditivePrestige,
            mult * purpose.AdditiveHonor,
            mult * purpose.AdditiveFear);
    }

    private string PhpTooltip(SeatRoomDTO room, (decimal Prestige, decimal Honor, decimal Fear)? totals, decimal mult)
    {
        if (room.PurposeTemplateId is not int pid || !PurposeLookup.TryGetValue(pid, out var purpose))
            return $"Chamber multiplier: ×{mult:0.##}. Assign a purpose with prestige / honor / fear to see totals.";

        var t = totals ?? (0m, 0m, 0m);
        return
            $"Prestige {FmtPhp(t.Prestige)}  (purpose {FmtPhp(purpose.AdditivePrestige)} × ×{mult:0.##})\n"
            + $"Honor {FmtPhp(t.Honor)}  (purpose {FmtPhp(purpose.AdditiveHonor)} × ×{mult:0.##})\n"
            + $"Fear {FmtPhp(t.Fear)}  (purpose {FmtPhp(purpose.AdditiveFear)} × ×{mult:0.##})";
    }

    private static string FmtPhp(decimal v) => v == 0m
        ? "0"
        : (v > 0m ? $"+{v.ToString("0.##")}" : v.ToString("0.##"));

    private string RoomPlanTooltip(SeatRoomDTO room, SeatRoomLayoutIssue layoutIssue)
    {
        var lines = new List<string>();

        var purpose = PurposeNameOnly(room);
        if (!string.IsNullOrWhiteSpace(purpose))
            lines.Add($"Purpose: {purpose}");
        else
            lines.Add("Purpose: —");

        var occupant = OccupantSubtitle(room);
        if (!string.IsNullOrWhiteSpace(occupant))
            lines.Add($"Occupant: {occupant}");

        lines.Add(SeatFloorLevel.Label(room.Level));
        lines.Add($"Size: {SeatRoomSizeCategory.OptionLabel(room.SizeCategory)} ({room.TileCount} tiles)");
        lines.Add($"Material: {SeatRoomMaterial.OptionLabel(room.Material)}");
        lines.Add($"Prestige multiplier: ×{room.PrestigeMultiplier:0.##} ({SeatRoomPrestige.FormulaHint(room.Material, room.TileCount)})");

        if (RoomPhpTotals(room) is { } php)
            lines.Add($"P/H/F: {FmtPhp(php.Prestige)} / {FmtPhp(php.Honor)} / {FmtPhp(php.Fear)}");

        lines.Add(room.IsRuin ? "Status: Ruin (excluded from totals)" : "Status: Active");

        if (room.GridW > 0 && room.GridH > 0)
            lines.Add($"Grid: ({room.GridX},{room.GridY}) {room.GridW}×{room.GridH}");

        if (layoutIssue != SeatRoomLayoutIssue.None)
            lines.Add($"Layout: {SeatRoomLayout.IssueLabel(layoutIssue)}");

        foreach (var trait in room.Traits.OrderBy(t => t.SortOrder))
        {
            if (!string.IsNullOrWhiteSpace(trait.Text))
                lines.Add($"[{trait.Kind}] {trait.Text}");
        }

        return string.Join("\n", lines);
    }

    private static string RoomTooltip(SeatRoomDTO room, SeatRoomLayoutIssue layoutIssue = SeatRoomLayoutIssue.None)
    {
        var lines = new List<string>
        {
            $"Tiles: {room.TileCount} ({room.SizeCategory})",
            SeatFloorLevel.Label(room.Level),
            $"Material: {SeatRoomMaterial.DisplayName(room.Material)}",
            room.IsRuin ? "Inactive (ruin) — excluded from totals." : "Active",
            $"Prestige multiplier: ×{room.PrestigeMultiplier:0.##}",
        };
        if (room.GridW > 0 && room.GridH > 0)
            lines.Add($"Grid: ({room.GridX},{room.GridY}) {room.GridW}×{room.GridH}");
        if (layoutIssue != SeatRoomLayoutIssue.None)
            lines.Add($"Layout: {SeatRoomLayout.IssueLabel(layoutIssue)}");
        return string.Join("\n", lines);
    }

    private SeatRoomLayoutIssue GetLayoutIssue(SeatRoomDTO room) =>
        SeatRoomLayout.GetIssue(
            room.Id,
            room.GridX,
            room.GridY,
            room.GridW,
            room.GridH,
            Seat.Rooms.Where(r => r.Level == room.Level)
                .Select(r => (r.Id, r.GridX, r.GridY, r.GridW, r.GridH)),
            Seat.GridWidth,
            Seat.GridHeight);

    private string? RowClass(SeatRoomDTO room)
    {
        var classes = new List<string>();
        if (room.IsRuin)
            classes.Add("lords-seat-row--ruin");
        var issue = GetLayoutIssue(room);
        if (issue == SeatRoomLayoutIssue.OutOfBounds)
            classes.Add("lords-seat-row--layout-invalid");
        else if (issue == SeatRoomLayoutIssue.Overlap)
            classes.Add("lords-seat-row--layout-overlap");
        return classes.Count == 0 ? null : string.Join(' ', classes);
    }

    private static string RoomPlanClass(SeatRoomDTO room, SeatRoomLayoutIssue layoutIssue)
    {
        var classes = new List<string>();
        if (room.IsRuin)
            classes.Add("lords-seat-plan__room--ruin");
        if (layoutIssue != SeatRoomLayoutIssue.None)
            classes.Add(layoutIssue == SeatRoomLayoutIssue.Overlap
                ? "lords-seat-plan__room--layout-overlap"
                : "lords-seat-plan__room--layout-invalid");
        if (!room.IsRuin && layoutIssue == SeatRoomLayoutIssue.None)
            classes.Add("lords-seat-plan__room--layout-valid");
        return string.Join(' ', classes);
    }

    private string CellDropClass(int x, int y)
    {
        if (DropOrigin is { } origin
            && x >= origin.X && x < origin.X + _dragRoomW
            && y >= origin.Y && y < origin.Y + _dragRoomH)
        {
            return "lords-seat-plan__cell--drop-target";
        }

        if (_placementMode)
            return "lords-seat-plan__cell--placement";
        return string.Empty;
    }

    private void OnPlanDragOver(DragEventArgs e) => e.DataTransfer.DropEffect = "move";

    private void OnRoomDragStart(DragEventArgs e, SeatRoomDTO room)
    {
        _placementMode = false;
        _dragRoomId = room.Id;
        _dragRoomW = Math.Max(1, room.GridW);
        _dragRoomH = Math.Max(1, room.GridH);

        var pitch = SeatTilePx + SeatGapPx;
        _grabOffsetX = Math.Clamp((int)Math.Floor(e.OffsetX / pitch), 0, Math.Max(0, _dragRoomW - 1));
        _grabOffsetY = Math.Clamp((int)Math.Floor(e.OffsetY / pitch), 0, Math.Max(0, _dragRoomH - 1));

        // Seed hover so the ghost starts aligned with the chamber under the cursor.
        RememberHoverCell(room.GridX + _grabOffsetX, room.GridY + _grabOffsetY);
        _layoutMovePending = false;
        e.DataTransfer.EffectAllowed = "move";
    }

    private void RememberHoverCell(int x, int y)
    {
        if (_dragRoomId is null)
            return;
        if (_hoverCellX == x && _hoverCellY == y)
            return;
        _hoverCellX = x;
        _hoverCellY = y;
        _lastHoverCellX = x;
        _lastHoverCellY = y;
    }

    private void OnCellDragEnter(int x, int y) => RememberHoverCell(x, y);

    private void OnCellDragOver(DragEventArgs e, int x, int y)
    {
        e.DataTransfer.DropEffect = "move";
        RememberHoverCell(x, y);
    }

    private void OnCellDragLeave(int x, int y)
    {
        // Keep the footprint preview while moving across its own cells.
    }

    private async Task OnCellDrop(DragEventArgs e, int x, int y)
    {
        RememberHoverCell(x, y);
        _layoutMovePending = true;
        if (DropOrigin is { } origin)
            await ApplyRoomMoveAsync(origin.X, origin.Y);
    }

    private async Task OnRoomDragEndAsync()
    {
        if (_dragRoomId is not null
            && _lastHoverCellX is int hx
            && _lastHoverCellY is int hy
            && !_layoutMovePending)
        {
            var originX = hx - _grabOffsetX;
            var originY = hy - _grabOffsetY;
            await ApplyRoomMoveAsync(originX, originY);
        }

        _dragRoomId = null;
        _dragRoomW = 1;
        _dragRoomH = 1;
        _grabOffsetX = 0;
        _grabOffsetY = 0;
        _hoverCellX = null;
        _hoverCellY = null;
        _lastHoverCellX = null;
        _lastHoverCellY = null;
        _layoutMovePending = false;
    }

    private async Task OnRoomClickAsync(SeatRoomDTO room)
    {
        if (_suppressRoomClick)
        {
            _suppressRoomClick = false;
            return;
        }

        if (!CanEdit || room.IsRuin)
            return;

        await AssignPurposeAsync(room);
    }

    private async Task ApplyRoomMoveAsync(int x, int y)
    {
        if (_dragRoomId is not int roomId)
            return;

        var room = Seat.Rooms.FirstOrDefault(r => r.Id == roomId);
        if (room is null || (room.GridX == x && room.GridY == y))
            return;

        var draft = CloneRoom(room);
        draft.GridX = x;
        draft.GridY = y;

        var others = Seat.Rooms
            .Where(r => r.Id != roomId && r.Level == draft.Level)
            .Select(r => (r.Id, r.GridX, r.GridY, r.GridW, r.GridH));
        var issue = SeatRoomLayout.GetIssue(
            draft.Id,
            draft.GridX,
            draft.GridY,
            draft.GridW,
            draft.GridH,
            others,
            Seat.GridWidth,
            Seat.GridHeight);

        try
        {
            await _baronyRepo.SaveSeatRoom(draft);
            _suppressRoomClick = true;
            if (issue == SeatRoomLayoutIssue.None)
                _snackBar.Add(L["Chamber moved."], Severity.Success);
            else
                _snackBar.Add(L["Chamber moved — {0}.", SeatRoomLayout.IssueLabel(issue)], Severity.Warning);

            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _snackBar.Add(L["Could not move chamber: "] + ex.Message, Severity.Error);
        }
    }

    private void CancelPlacementMode()
    {
        _placementMode = false;
    }

    private void ClearPaintMode()
    {
        _paintKind = null;
        _paintStrokeActive = false;
    }

    private void TogglePaint(string kind)
    {
        _placementMode = false;
        _dragRoomId = null;
        _paintKind = _paintKind == kind ? null : kind;
        _paintStrokeActive = false;
    }

    private void SelectLevel(int level)
    {
        if (_currentLevel == level)
            return;

        _currentLevel = level;
        _paintStrokeActive = false;
        _placementMode = false;
    }

    private void EndPaintStroke() => _paintStrokeActive = false;

    private async Task OnCellMouseDown(int x, int y)
    {
        if (!IsPainting || _dragRoomId is not null || _placementMode)
            return;

        _paintStrokeActive = true;
        await PaintCellAsync(x, y);
    }

    private async Task OnCellMouseEnter(int x, int y)
    {
        if (!_paintStrokeActive || !IsPainting)
            return;

        await PaintCellAsync(x, y);
    }

    private async Task PaintCellAsync(int x, int y)
    {
        if (!IsPainting)
            return;

        var kind = string.IsNullOrEmpty(_paintKind) ? null : _paintKind;
        var previous = TileKindAt(x, y);
        if (string.Equals(previous, kind, StringComparison.Ordinal))
            return;

        ApplyLocalTile(x, y, kind);
        await InvokeAsync(StateHasChanged);

        try
        {
            await _baronyRepo.SetSeatTile(Seat.Id, _currentLevel, x, y, kind);
        }
        catch (Exception ex)
        {
            ApplyLocalTile(x, y, previous);
            await InvokeAsync(StateHasChanged);
            _snackBar.Add(L["Could not paint tile: "] + ex.Message, Severity.Error);
            _paintStrokeActive = false;
        }
    }

    private void ApplyLocalTile(int x, int y, string? kind)
    {
        Seat.Tiles.RemoveAll(t => t.Level == _currentLevel && t.X == x && t.Y == y);
        if (!string.IsNullOrEmpty(kind))
        {
            Seat.Tiles.Add(new SeatTileDTO
            {
                SeatId = Seat.Id,
                Level = _currentLevel,
                X = x,
                Y = y,
                Kind = kind,
            });
        }
    }

    private async Task AddLevelAsync(int level)
    {
        if (!SeatFloorLevel.IsValid(level) || ActiveLevels.Contains(level))
            return;

        var next = ActiveLevels.Append(level).Distinct().OrderBy(l => l).ToList();
        try
        {
            await _baronyRepo.SaveSeatActiveLevels(Seat.Id, next);
            Seat.ActiveLevels = next;
            _currentLevel = level;
            _snackBar.Add(L["Added {0}.", SeatFloorLevel.Label(level)], Severity.Success);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _snackBar.Add(L["Could not add floor: "] + ex.Message, Severity.Error);
        }
    }

    private async Task RemoveCurrentLevelAsync()
    {
        if (_currentLevel == SeatFloorLevel.Ground || ActiveLevels.Count <= 1)
            return;

        var removed = _currentLevel;
        var next = ActiveLevels.Where(l => l != removed).ToList();
        try
        {
            await _baronyRepo.SaveSeatActiveLevels(Seat.Id, next);
            Seat.ActiveLevels = next;
            Seat.Tiles.RemoveAll(t => t.Level == removed);
            _currentLevel = next.Contains(SeatFloorLevel.Ground) ? SeatFloorLevel.Ground : next[0];
            _snackBar.Add(L["Floor removed."], Severity.Success);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _snackBar.Add(L["Could not remove floor: "] + ex.Message, Severity.Error);
        }
    }

    private async Task OnCellClick(int x, int y)
    {
        if (!CanManage || _dragRoomId is not null)
            return;

        if (_paintKind is not null)
        {
            // Click is more reliable than mousedown alone (esp. after circuit/UI refresh).
            await PaintCellAsync(x, y);
            return;
        }

        if (_placementMode)
        {
            _placementMode = false;
            await OpenRoomDialog(new SeatRoomDTO
            {
                SeatId = Seat.Id,
                BaronyId = Seat.BaronyId,
                Level = _currentLevel,
                GridX = x,
                GridY = y,
                GridW = 2,
                GridH = 2,
                Material = SeatRoomMaterial.Stone,
                PrestigeMultiplier = SeatRoomPrestige.Suggested(SeatRoomMaterial.Stone, 4),
            }, isNew: true);
        }
    }

