    private async Task OpenRoomDialog(SeatRoomDTO draft, bool isNew)
    {
        var parameters = new DialogParameters<SeatRoomEditDialog>
        {
            { x => x.Room, draft },
            { x => x.Seat, Seat },
            { x => x.PurposeTemplates, PurposeTemplates },
