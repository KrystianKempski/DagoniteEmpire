@namespace DagoniteEmpire.Pages.Barony.Components
@inject IBaronyRepository _baronyRepo
@inject ISnackbar _snackBar
@inject IDialogService _dialogService

<BaronySection Title="Purpose templates">
    <Summary>
        <span class="projects-summary__item">@Templates.Count template@(Templates.Count == 1 ? "" : "s")</span>
    </Summary>
    <ChildContent>
        <div class="lords-seat-templates-wrap">
            <table class="ppb-table ppb-table--advisors ppb-table--lined lords-seat-templates-table">
                <colgroup>
                    <col class="lords-seat-templates-col-name" />
                    <col class="lords-seat-templates-col-size" />
                    <col class="lords-seat-templates-col-desc" />
                    <col class="lords-seat-templates-col-prestige" />
                    @foreach (var _ in PpbCatalog.All)
                    {
                        <col class="ppb-pair-col" />
                        <col class="ppb-pair-col" />
                    }
                </colgroup>
                <thead>
                    <tr>
                        <th rowspan="2" class="ppb-row-label lords-seat-templates-col-name">Name</th>
                        <th rowspan="2" class="lords-seat-templates-col-size">Min size</th>
                        <th rowspan="2" class="lords-seat-templates-col-desc">Description</th>
                        <th rowspan="2" class="lords-seat-templates-col-prestige seat-php-header">
                            <BaronyTooltip Title="Prestige" Text="Prestige / Honor / Fear (additive)">Prestige</BaronyTooltip>
                        </th>
                        @foreach (var info in PpbCatalog.All)
                        {
                            <th colspan="2"><BaronyTooltip Text="@info.NameEn">@PpbShort(info.Key)</BaronyTooltip></th>
                        }
                    </tr>
                    <tr>
                        @foreach (var _ in PpbCatalog.All)
                        {
                            <th class="ppb-subcol ppb-subcol--add">+</th>
                            <th class="ppb-subcol ppb-subcol--pct">%</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Ordered)
                    {
                        <tr>
                            <td class="lords-seat-templates-col-name">
                                <div class="city-building-name-cell">
                                    <BaronyTooltip Title="@t.Name" Text="@TemplateTooltip(t)">
                                        <span class="city-building-name-text">@t.Name</span>
                                    </BaronyTooltip>
                                    <span class="city-building-name-actions">
                                        <BaronyTooltip Text="Edit template">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Size="Size.Small"
                                                           OnClick="@(() => EditAsync(t))" />
                                        </BaronyTooltip>
                                        <BaronyTooltip Text="Delete template">
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Size="Size.Small"
                                                           Color="Color.Error"
                                                           OnClick="@(() => DeleteAsync(t))" />
                                        </BaronyTooltip>
                                    </span>
                                </div>
                            </td>
                            <td class="lords-seat-templates-col-size">@t.MinSizeCategory</td>
                            <td class="lords-seat-templates-col-desc">
                                @if (string.IsNullOrWhiteSpace(t.Description))
                                {
                                    <span class="lords-seat-muted">—</span>
                                }
                                else
                                {
                                    <BaronyTooltip Title="Description" Text="@t.Description">
                                        <span class="lords-seat-ellipsis">@t.Description</span>
                                    </BaronyTooltip>
                                }
                            </td>
                            <td class="lords-seat-templates-col-prestige seat-php-cell">
                                <BaronyTooltip Title="Prestige / Honor / Fear" Text="@TemplatePhpTooltip(t)">
                                    <span class="seat-php-values seat-php-values--stacked seat-php-values--stacked-singlecol">
                                        <span class="seat-php-value @BaronPhpVisuals.CssClass(PhpMetric.Prestige)">
                                            <PhpMetricIcon Metric="PhpMetric.Prestige" Title="" />
                                            <span class="seat-php-value__num">@FmtPhp(t.AdditivePrestige)</span>
                                        </span>
                                        <span class="seat-php-value @BaronPhpVisuals.CssClass(PhpMetric.Honor)">
                                            <PhpMetricIcon Metric="PhpMetric.Honor" Title="" />
                                            <span class="seat-php-value__num">@FmtPhp(t.AdditiveHonor)</span>
                                        </span>
                                        <span class="seat-php-value @BaronPhpVisuals.CssClass(PhpMetric.Fear)">
                                            <PhpMetricIcon Metric="PhpMetric.Fear" Title="" />
                                            <span class="seat-php-value__num">@FmtPhp(t.AdditiveFear)</span>
                                        </span>
                                    </span>
                                </BaronyTooltip>
                            </td>
                            @foreach (var info in PpbCatalog.All)
                            {
                                <td class="@PpbCellStyle.ValueClass(info.Key, t.Additive[info.Key])">@FmtAdd(t.Additive[info.Key])</td>
                                <td class="@PpbCellStyle.ValueClass(info.Key, t.Percent[info.Key])">@FmtPct(t.Percent[info.Key])</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <MudButton Variant="Variant.Outlined"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Add"
                   Class="mt-2"
                   OnClick="AddAsync">
            Add purpose template
        </MudButton>
    </ChildContent>
</BaronySection>

@code {
    [Parameter] public int BaronyId { get; set; }
    [Parameter] public List<SeatPurposeTemplateDTO> Templates { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }

    private IEnumerable<SeatPurposeTemplateDTO> Ordered =>
        Templates.OrderBy(t => t.SortOrder).ThenBy(t => t.Name, StringComparer.OrdinalIgnoreCase);

    private static string TemplateTooltip(SeatPurposeTemplateDTO t)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(t.Description))
            parts.Add(t.Description.Trim());
        parts.Add($"Min chamber size: {t.MinSizeCategory}");
        if (!string.IsNullOrWhiteSpace(t.WhoOccupies))
            parts.Add($"Occupied by: {t.WhoOccupies}");
        if (t.SleepCapacity > 0)
            parts.Add($"Sleep capacity: {t.SleepCapacity}");
        parts.Add(t.IsUniversal ? "Scope: all baronies" : "Scope: this barony");
        return string.Join("\n\n", parts);
    }

    private static string PpbShort(Ppb p) => p switch
    {
        Ppb.Food => "Food",
        Ppb.Economy => "Econ",
        Ppb.Production => "Prod",
        Ppb.Loyalty => "Loy",
        Ppb.Stability => "Stab",
        Ppb.Law => "Law",
        Ppb.Corruption => "Corr",
        Ppb.Science => "Sci",
        Ppb.Magic => "Mag",
        Ppb.Culture => "Cult",
        Ppb.Intelligence => "Intel",
        Ppb.Defense => "Def",
        Ppb.Treasury => "Gold",
        _ => p.ToString(),
    };

    private static string FmtAdd(decimal v) => PpbFormat.Additive(v);

    private static string FmtPct(decimal v) => PpbFormat.Percent(v);

    private static string FmtPhp(decimal v) => v == 0m
        ? "0"
        : (v > 0m ? $"+{v.ToString("0.##")}" : v.ToString("0.##"));

    private static string TemplatePhpTooltip(SeatPurposeTemplateDTO t) =>
        $"Prestige {FmtPhp(t.AdditivePrestige)} · Honor {FmtPhp(t.AdditiveHonor)} · Fear {FmtPhp(t.AdditiveFear)}"
        + " (per chamber, before multiplier)";

    private Task AddAsync() => OpenDialog(new SeatPurposeTemplateDTO { IsUniversal = true, BaronyId = BaronyId }, isNew: true);

    private Task EditAsync(SeatPurposeTemplateDTO t) => OpenDialog(Clone(t), isNew: false);

    private async Task OpenDialog(SeatPurposeTemplateDTO draft, bool isNew)
    {
        var parameters = new DialogParameters<SeatPurposeTemplateEditDialog>
        {
            { x => x.Template, draft },
            { x => x.BaronyId, BaronyId },
        };

        var dialog = await _dialogService.ShowAsync<SeatPurposeTemplateEditDialog>(
            isNew ? "Add purpose template" : "Edit purpose template",
            parameters,
            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not SeatPurposeTemplateDTO saved)
            return;

        if (string.IsNullOrWhiteSpace(saved.Name))
        {
            _snackBar.Add("Template name is required.", Severity.Warning);
            return;
        }

        if (!saved.IsUniversal)
            saved.BaronyId = BaronyId;

        try
        {
            await _baronyRepo.SaveSeatPurposeTemplate(saved);
            _snackBar.Add(isNew ? "Template added." : "Template updated.", Severity.Success);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _snackBar.Add("Could not save template: " + ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(SeatPurposeTemplateDTO t)
    {
        try
        {
            await _baronyRepo.DeleteSeatPurposeTemplate(t.Id);
            _snackBar.Add("Template removed.", Severity.Success);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _snackBar.Add("Could not delete template: " + ex.Message, Severity.Error);
        }
    }

    private static SeatPurposeTemplateDTO Clone(SeatPurposeTemplateDTO s) => new()
    {
        Id = s.Id,
        Name = s.Name,
        Description = s.Description,
        MinSizeCategory = s.MinSizeCategory,
        WhoOccupies = s.WhoOccupies,
        SleepCapacity = s.SleepCapacity,
        AdditivePrestige = s.AdditivePrestige,
        AdditiveHonor = s.AdditiveHonor,
        AdditiveFear = s.AdditiveFear,
        Additive = s.Additive.Clone(),
        Percent = s.Percent.Clone(),
        IsUniversal = s.IsUniversal,
        BaronyId = s.BaronyId,
        SortOrder = s.SortOrder,
    };
}
