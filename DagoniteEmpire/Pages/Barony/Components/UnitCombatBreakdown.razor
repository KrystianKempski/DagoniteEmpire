@namespace DagoniteEmpire.Pages.Barony.Components
@inject IDialogService _dialogService

@* Excel-style combat breakdown: full block titles, short column labels. *@
<div class="unit-combat-break">
    @Block("Atak",
        $"Umiejętność ({AttackSkillName}) + atak broni (± jakość) + dowódca + inne + straty.",
        UnitCombatStatKey.Attack,
        Combat.LossAttack,
        ("Skl", "Umiejętność", Combat.AttackSkill, "Suma umiejętności typu broni"),
        ("Gear", "Sprzęt", Combat.WeaponAttackBonus, "Atak broni wraz z jakością"),
        ("Cmd", "Dowódca", Combat.CommanderAttack, "Premia dowódcy"),
        Combat.Attack)

    @Block("Obrona",
        $"Najwyższa kwalifikująca się umiejętność obrony ({DefenseSkillName}): Uniki zawsze; Tarcze tylko z tarczą; Pancerz tylko z pancerzem. Plus obrona sprzętu + dowódca + inne + straty.",
        UnitCombatStatKey.Defense,
        Combat.LossDefense,
        ("Skl", "Umiejętność", Combat.DefenseSkill, $"Najwyższa kwalifikująca się umiejętność obrony ({DefenseSkillName})"),
        ("Gear", "Sprzęt", Combat.WeaponDefenseBonus, "Obrona broni + pancerza + tarczy"),
        ("Cmd", "Dowódca", Combat.CommanderDefense, "Premia dowódcy"),
        Combat.Defense)

    @Block("Obrażenia",
        $"Obrażenia broni (± jakość) + {UnitAttr.Label(Combat.DamageAttrKey ?? UnitAttr.Build)} (z głównej umiejętności broni) + inne.",
        UnitCombatStatKey.Damage,
        lossValue: null,
        (UnitAttr.Letter(Combat.DamageAttrKey ?? UnitAttr.Build),
            UnitAttr.Label(Combat.DamageAttrKey ?? UnitAttr.Build),
            Combat.AttrDamageBonus,
            $"{UnitAttr.Label(Combat.DamageAttrKey ?? UnitAttr.Build)} powiązane z umiejętnością wyposażonej broni"),
        ("Gear", "Sprzęt", Combat.WeaponDamageBonus, "Obrażenia broni wraz z jakością"),
        Combat.Damage)

    @Block("Ruch",
        "Ruch rasy + floor(Run/3) + kary do ruchu od sprzętu + inne.",
        UnitCombatStatKey.Move,
        lossValue: null,
        ("Race", "Rasa", Combat.RaceMove, RaceMoveTip),
        ("Run", "Bieg", Combat.RunMove, "floor(Run / 3)"),
        ("Gear", "Sprzęt", Combat.EquipmentMovePenalty, "Kary do ruchu od broni/pancerza/tarczy"),
        Combat.Move)

    @Block("Pancerz",
        "Wartość pancerza tylko ze zbroi (tarcze nie dodają Pancerza). Redukuje otrzymywane obrażenia.",
        UnitCombatStatKey.Armor,
        lossValue: null,
        ("Gear", "Sprzęt", Combat.ArmorFromGear, "Wartość pancerza ze zbroi"),
        Combat.Armor)

    @HpBlock()
</div>

@code {
    [Parameter] public UnitCombatTotals Combat { get; set; } = default!;
    [Parameter] public BaronyUnitDTO? Unit { get; set; }
    [Parameter] public int? CurrentHp { get; set; }
    [Parameter] public bool CanEditOther { get; set; }
    [Parameter] public EventCallback OtherChanged { get; set; }

    private string AttackSkillName =>
        UnitSkillTree.Find(Combat.AttackSkillKey)?.Name ?? Combat.AttackSkillKey ?? "—";

    private string DefenseSkillName =>
        UnitSkillTree.Find(Combat.DefenseSkillKeyUsed)?.Name ?? Combat.DefenseSkillKeyUsed ?? "—";

    private string RaceMoveTip
    {
        get
        {
            var race = UnitRaceCatalog.Find(Unit?.RaceKey);
            return $"{race.Name}: Ruch +{race.MoveBonus}.";
        }
    }

    private string LossTip => UnitCasualtyFormulas.Explain(Combat.TroopCount, Combat.FullTroopCount);

    private int OtherValue(string statKey) => UnitCombatOtherFormulas.Sum(
        UnitCombatOtherFormulas.Get(Unit?.CombatOther, statKey));

    private string OtherTip(string tipTitle, string statKey)
    {
        var lines = UnitCombatOtherFormulas.TooltipLines(UnitCombatOtherFormulas.Get(Unit?.CombatOther, statKey));
        return CanEditOther
            ? $"{tipTitle}\n\n{lines}\n\nKliknij, aby edytować źródła."
            : $"{tipTitle}\n\n{lines}";
    }

    private RenderFragment Block(
        string title,
        string tipText,
        string otherStatKey,
        int? lossValue,
        (string Label, string TipTitle, int Value, string ColTip) a,
        int total) => __builder =>
    {
        <div class="unit-combat-break__block">
            <BaronyTooltip Title="@title" Text="@tipText" Placement="Placement.Bottom">
                <div class="unit-combat-break__title">@title</div>
            </BaronyTooltip>
            <div class="unit-combat-break__cols">
                @Col(a.Label, a.TipTitle, a.Value, a.ColTip)
                @OtherCol(otherStatKey)
                @if (lossValue.HasValue)
                {
                    @LossCol(lossValue.Value)
                }
                @Tot(total)
            </div>
        </div>
    };

    private RenderFragment Block(
        string title,
        string tipText,
        string otherStatKey,
        int? lossValue,
        (string Label, string TipTitle, int Value, string ColTip) a,
        (string Label, string TipTitle, int Value, string ColTip) b,
        int total) => __builder =>
    {
        <div class="unit-combat-break__block">
            <BaronyTooltip Title="@title" Text="@tipText" Placement="Placement.Bottom">
                <div class="unit-combat-break__title">@title</div>
            </BaronyTooltip>
            <div class="unit-combat-break__cols">
                @Col(a.Label, a.TipTitle, a.Value, a.ColTip)
                @Col(b.Label, b.TipTitle, b.Value, b.ColTip)
                @OtherCol(otherStatKey)
                @if (lossValue.HasValue)
                {
                    @LossCol(lossValue.Value)
                }
                @Tot(total)
            </div>
        </div>
    };

    private RenderFragment Block(
        string title,
        string tipText,
        string otherStatKey,
        int? lossValue,
        (string Label, string TipTitle, int Value, string ColTip) a,
        (string Label, string TipTitle, int Value, string ColTip) b,
        (string Label, string TipTitle, int Value, string ColTip) c,
        int total) => __builder =>
    {
        <div class="unit-combat-break__block unit-combat-break__block--wide">
            <BaronyTooltip Title="@title" Text="@tipText" Placement="Placement.Bottom">
                <div class="unit-combat-break__title">@title</div>
            </BaronyTooltip>
            <div class="unit-combat-break__cols">
                @Col(a.Label, a.TipTitle, a.Value, a.ColTip)
                @Col(b.Label, b.TipTitle, b.Value, b.ColTip)
                @Col(c.Label, c.TipTitle, c.Value, c.ColTip)
                @OtherCol(otherStatKey)
                @if (lossValue.HasValue)
                {
                    @LossCol(lossValue.Value)
                }
                @Tot(total)
            </div>
        </div>
    };

    private RenderFragment HpBlock() => __builder =>
    {
        var baseHp = Combat.MaxHp - Combat.OtherHp - Combat.LossHp;
        var cur = CurrentHp ?? Combat.MaxHp;
        <div class="unit-combat-break__block">
            <BaronyTooltip Title="Punkty życia"
                           Text="Maksimum = Build×2 + Will×2 + Endurance + Discipline×3 + inne + straty. Bieżące odzwierciedla rany w trakcie gry."
                           Placement="Placement.Bottom">
                <div class="unit-combat-break__title">Punkty życia</div>
            </BaronyTooltip>
            <div class="unit-combat-break__cols">
                @Col("Max", "Maksimum", baseHp, "Maksimum ze wzoru przed modyfikatorami inne i strat")
                @OtherCol(UnitCombatStatKey.Hp)
                @LossCol(Combat.LossHp)
                @Tot(Combat.MaxHp)
                @if (CurrentHp.HasValue)
                {
                    @Col("Cur", "Bieżące", cur, "Bieżące punkty życia")
                }
            </div>
        </div>
    };

    private RenderFragment Col(string label, string tipTitle, int value, string tip) => __builder =>
    {
        <BaronyTooltip Title="@tipTitle" Text="@tip" Placement="Placement.Top">
            <div class="unit-combat-break__col @(value != 0 ? null : "unit-combat-break__col--zero")">
                <span class="unit-combat-break__lab">@label</span>
                <b class="unit-combat-break__val">@value</b>
            </div>
        </BaronyTooltip>
    };

    private RenderFragment LossCol(int value) => __builder =>
    {
        <BaronyTooltip Title="Straty" Text="@LossTip" Placement="Placement.Top">
            <div class="unit-combat-break__col @(value != 0 ? "unit-combat-break__col--loss" : "unit-combat-break__col--zero")">
                <span class="unit-combat-break__lab">Loss</span>
                <b class="unit-combat-break__val">@value</b>
            </div>
        </BaronyTooltip>
    };

    private RenderFragment OtherCol(string statKey) => __builder =>
    {
        var value = OtherValue(statKey);
        var tip = OtherTip("Inne modyfikatory — nazwane źródła zsumowane w tej kolumnie.", statKey);
        <BaronyTooltip Title="Inne" Text="@tip" Placement="Placement.Top">
            @if (CanEditOther && Unit is not null)
            {
                <button type="button"
                        class="unit-combat-break__col unit-combat-break__col--btn @(value != 0 ? null : "unit-combat-break__col--zero")"
                        @onclick="@(() => EditOtherAsync(statKey))">
                    <span class="unit-combat-break__lab">Oth</span>
                    <b class="unit-combat-break__val">@value</b>
                </button>
            }
            else
            {
                <div class="unit-combat-break__col @(value != 0 ? null : "unit-combat-break__col--zero")">
                    <span class="unit-combat-break__lab">Oth</span>
                    <b class="unit-combat-break__val">@value</b>
                </div>
            }
        </BaronyTooltip>
    };

    private RenderFragment Tot(int value) => __builder =>
    {
        <BaronyTooltip Title="Suma" Text="Suma kolumn po lewej (z minimalnymi wartościami przy wyczerpaniu)." Placement="Placement.Top">
            <div class="unit-combat-break__col unit-combat-break__col--tot">
                <span class="unit-combat-break__lab">Tot</span>
                <b class="unit-combat-break__val">@value</b>
            </div>
        </BaronyTooltip>
    };

    private async Task EditOtherAsync(string statKey)
    {
        if (!CanEditOther || Unit is null) return;

        var existing = UnitCombatOtherFormulas.Get(Unit.CombatOther, statKey)
            .Select(m => new UnitCombatModifierEntry { Label = m.Label, Value = m.Value })
            .ToList();

        var parameters = new DialogParameters
        {
            [nameof(UnitNamedModifiersDialog.Title)] = $"{UnitCombatStatKey.Label(statKey)} — inne",
            [nameof(UnitNamedModifiersDialog.Hint)] =
                "Każdy wiersz to nazwane źródło (np. błogosławieństwo, teren, magia). Suma wypełnia kolumnę Inne.",
            [nameof(UnitNamedModifiersDialog.Modifiers)] = existing,
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await _dialogService.ShowAsync<UnitNamedModifiersDialog>(
            $"{UnitCombatStatKey.Label(statKey)} — inne",
            parameters,
            options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not List<UnitCombatModifierEntry> saved)
            return;

        Unit.CombatOther ??= new Dictionary<string, List<UnitCombatModifierEntry>>(StringComparer.OrdinalIgnoreCase);
        Unit.CombatOther[statKey] = saved;
        var (atk, def, dmg, mov, arm, hp) = UnitCombatOtherFormulas.SumAll(Unit.CombatOther);
        Unit.OtherAttack = atk;
        Unit.OtherDefense = def;
        Unit.OtherDamage = dmg;
        Unit.OtherMove = mov;
        Unit.OtherArmor = arm;
        Unit.OtherHp = hp;

        await OtherChanged.InvokeAsync();
    }
}
