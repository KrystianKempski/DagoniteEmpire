@namespace DagoniteEmpire.Pages.Barony.Components

<BaronySection Title="@(L["Trade good bonus summary"])" DefaultOpen="true">
    <Summary>
        <span class="projects-summary__item">@SelectedCount good@(SelectedCount == 1 ? "" : "s")</span>
        <span class="projects-summary__item">@L[LuxuryTier.NameEn]</span>
        <PpbSummaryChips Vector="@GlanceAdditive" />
    </Summary>
    <ChildContent>
        @if (SelectedCount == 0 && !HasLuxuryBonus && TreatyRouteEconomyBonus == 0m && TreatyGoldOutflowPerTurn == 0m)
        {
            <MudText Typo="Typo.body2" Style="color:var(--barony-muted);">
                @L["Available goods (from production, trade, or MG override), luxury access, route economy, and treaty gold contribute to Domain Panel PPB."]
            </MudText>
        }
        else
        {
            <div class="trade-goods-ppb-summary">
                <table class="ppb-table ppb-table--lined trade-goods-ppb-table">
                    <thead>
                        <tr>
                            <th>PPB</th>
                            <th>@L["Additive"]</th>
                            <th>@L["Percent"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Rows)
                        {
                            <tr>
                                <td>@row.Label</td>
                                <td class="trade-goods-ppb-num">@row.Additive</td>
                                <td class="trade-goods-ppb-num">@row.Percent</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </ChildContent>
</BaronySection>

@code {
    [Parameter] public IReadOnlyList<TradeGoodEntry> Selected { get; set; } = Array.Empty<TradeGoodEntry>();
    [Parameter] public IReadOnlyList<TradeGoodEntry> TreatyGoods { get; set; } = Array.Empty<TradeGoodEntry>();
    [Parameter] public decimal TreatyRouteEconomyBonus { get; set; }
    /// <summary>Net gold leaving the barony per turn (customs + sweeteners). Applied as −Treasury.</summary>
    [Parameter] public decimal TreatyGoldOutflowPerTurn { get; set; }
    [Parameter] public string LuxuryAccessKey { get; set; } = LuxuryGoodsAccessCatalog.DefaultKey;

    private int SelectedCount =>
        Selected.Concat(TreatyGoods)
            .Select(g => g.Key)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();
    private LuxuryGoodsAccessTier LuxuryTier => LuxuryGoodsAccessCatalog.Find(LuxuryAccessKey);

    private bool HasLuxuryBonus =>
        PpbCatalog.All.Any(info => LuxuryTier.BonusAdditive[info.Key] != 0m);

    private void BuildTotals(out PpbVector add, out PpbVector pct)
    {
        var merged = Selected.Concat(TreatyGoods)
            .GroupBy(g => g.Key, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .ToList();
        TradeGoodsBonusAggregator.Sum(merged, out add, out pct);
        add.AddInPlace(LuxuryTier.BonusAdditive);
        if (TreatyRouteEconomyBonus != 0m)
            add[Ppb.Economy] += TreatyRouteEconomyBonus;
        if (TreatyGoldOutflowPerTurn != 0m)
            add[Ppb.Treasury] -= TreatyGoldOutflowPerTurn;
    }

    private PpbVector GlanceAdditive
    {
        get
        {
            BuildTotals(out var add, out _);
            return add;
        }
    }

    private IEnumerable<PpbRow> Rows
    {
        get
        {
            BuildTotals(out var add, out var pct);
            foreach (var info in PpbCatalog.All)
            {
                var a = add[info.Key];
                var p = pct[info.Key];
                if (a == 0m && p == 0m)
                    continue;
                yield return new PpbRow(
                    info.Name,
                    a == 0m ? "—" : PpbFormat.Additive(a),
                    p == 0m ? "—" : PpbFormat.Percent(p));
            }
        }
    }

    private sealed record PpbRow(string Label, string Additive, string Percent);
}
