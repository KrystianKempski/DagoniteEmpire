@namespace DagoniteEmpire.Pages.Barony.Components
@implements IAsyncDisposable
@inject IUserService _userService
@inject IBaronyRepository _baronyRepo
@inject NavigationManager _nav

@* Baron badge query already skips TurnResolving baronies; a positive count means openable mail. *@
@if (_visible && _unreadCount > 0)
{
    <div class="baron-letter-inbox-fab">
        <MudBadge Content="@_unreadCount" Color="Color.Error" Overlap="true" Bordered="true">
            <BaronyTooltip Text="@($"New letters: {_unreadCount}")">
                <button type="button"
                        class="baron-letter-inbox-fab__btn"
                        @onclick="OpenInboxAsync">
                    <img src="@($"/{MyIcon.TiedScroll}")" alt="" class="baron-letter-inbox-fab__icon" />
                </button>
            </BaronyTooltip>
        </MudBadge>
    </div>
}

@code {
    private bool _visible;
    private bool _asGm;
    private int _unreadCount;
    private int? _latestThreadId;
    private int? _latestCharacterId;
    private CancellationTokenSource? _cts;
    private PeriodicTimer? _timer;
    private Task? _loop;

    protected override async Task OnInitializedAsync()
    {
        var user = await _userService.GetUserInfo();
        _asGm = user?.IsAdminOrMG == true
            || user?.Role == SD.Role_Admin
            || user?.Role == SD.Role_GameMaster;
        var isBaron = user?.Role == SD.Role_DukePlayer && !_asGm;
        _visible = isBaron || _asGm;
        if (!_visible)
            return;

        // Always poll — barony/character may resolve after BaronySwitcher runs.
        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(45));
        _loop = PollLoopAsync(_cts.Token);
        _nav.LocationChanged += OnLocationChanged;

        await RefreshAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(RefreshAsync);

    private async Task PollLoopAsync(CancellationToken ct)
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(ct))
                await InvokeAsync(RefreshAsync);
        }
        catch (OperationCanceledException) { }
    }

    private async Task RefreshAsync()
    {
        if (!_visible)
            return;

        try
        {
            var badge = _asGm
                ? await _baronyRepo.GetLetterInboxBadgeForGm()
                : await _baronyRepo.GetLetterInboxBadgeForBaron(await OwnBaronyIdsAsync());

            _unreadCount = badge.UnreadCount;
            _latestThreadId = badge.LatestThreadId;
            _latestCharacterId = badge.CharacterId;

            StateHasChanged();
        }
        catch
        {
            // Keep last known badge state on transient errors.
        }
    }

    /// <summary>
    /// Every barony of this account, so the badge counts letters the player has not read in any of
    /// them — not only in the one whose character happens to be selected.
    /// </summary>
    private async Task<List<int>> OwnBaronyIdsAsync()
    {
        var user = await _userService.GetUserInfo();
        if (string.IsNullOrWhiteSpace(user?.UserName))
            return new List<int>();

        var baronies = await _baronyRepo.GetSummariesForUser(user.UserName);
        return baronies.Select(b => b.Id).ToList();
    }

    private async Task OpenInboxAsync()
    {
        var url = _latestThreadId is int id
            ? $"/barony/letters?thread={id}"
            : "/barony/letters";

        // The newest openable letter may belong to another barony — Letters shows the selected one.
        if (_latestCharacterId is int charId and > 0)
        {
            var user = await _userService.GetUserInfo();
            if (user?.SelectedCharacter?.Id != charId)
            {
                await _userService.SetSelectedCharId(charId);
                _nav.NavigateTo(url, forceLoad: true);
                return;
            }
        }

        _nav.NavigateTo(url);
    }

    public async ValueTask DisposeAsync()
    {
        _nav.LocationChanged -= OnLocationChanged;
        if (_cts is not null)
        {
            await _cts.CancelAsync();
            _cts.Dispose();
        }

        _timer?.Dispose();
        if (_loop is not null)
        {
            try { await _loop; }
            catch (OperationCanceledException) { }
        }
    }
}
