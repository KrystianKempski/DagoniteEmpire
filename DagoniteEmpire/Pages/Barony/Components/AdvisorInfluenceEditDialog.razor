@namespace DagoniteEmpire.Pages.Barony.Components
@inject ISnackbar _snackBar

<MudDialog Class="baron-influence-dialog"
           ContentClass="baron-influence-dialog-content"
           ActionsClass="baron-influence-dialog-actions">
    <DialogContent>
        <div class="barony-dialog-theme baron-influence-edit-dialog">
            <MudTextField @bind-Value="_source"
                          Label="Source"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="baron-influence-field"
                          Required="true" />
            <MudTextField @bind-Value="_description"
                          Label="Description"
                          HelperText="Optional. Shown on hover over the source in the table."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="2"
                          Class="baron-influence-field" />
            <MudNumericField T="decimal"
                             @bind-Value="_costGold"
                             Label="Cost"
                             HelperText="Added to the office upkeep total (gold / turn)."
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Min="0"
                             Class="baron-influence-field" />
            <PpbVectorEditor @bind-Value="_values" Title="PPB bonuses" Compact="true" ExcludeTreasury="true" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">Cancel</MudButton>
        <MudButton Class="baron-influence-save-btn" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public AdvisorInfluenceModifierDTO Modifier { get; set; } = new();

    private string _source = string.Empty;
    private string? _description;
    private decimal _costGold;
    private PpbVector _values = new();

    protected override void OnInitialized()
    {
        _source = Modifier.Source;
        _description = Modifier.Description;
        _costGold = Modifier.CostGold;
        _values = Modifier.Additive.Clone();
    }

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        if (string.IsNullOrWhiteSpace(_source))
        {
            _snackBar.Add("Source name is required.", Severity.Warning);
            return;
        }

        Modifier.Source = _source.Trim();
        Modifier.Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim();
        Modifier.CostGold = _costGold;
        Modifier.Additive = _values;
        MudDialog.Close(DialogResult.Ok(Modifier));
    }
}
