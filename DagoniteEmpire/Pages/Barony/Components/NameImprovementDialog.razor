@namespace DagoniteEmpire.Pages.Barony.Components
@inject ISnackbar _snackBar

<MudDialog Class="baron-influence-dialog"
           ContentClass="baron-influence-dialog-content"
           ActionsClass="baron-influence-dialog-actions">
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <div class="barony-dialog-theme baron-influence-edit-dialog">
            <MudTextField @bind-Value="_name"
                          Label="Name"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="baron-influence-field"
                          Required="true"
                          Immediate="true" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">Cancel</MudButton>
        <MudButton Class="baron-influence-save-btn" Variant="Variant.Filled" OnClick="Save">Confirm</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string ImprovementKind { get; set; } = MapImprovement.Town;
    [Parameter] public string? InitialName { get; set; }

    private string _name = string.Empty;

    private string Title => $"Name this {MapImprovement.DisplayName(ImprovementKind).ToLowerInvariant()}";

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(InitialName))
            _name = InitialName;
    }

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        var trimmed = _name.Trim();
        if (string.IsNullOrWhiteSpace(trimmed))
        {
            _snackBar.Add("Enter a name.", Severity.Warning);
            return;
        }

        MudDialog.Close(DialogResult.Ok(trimmed));
    }
}
