@namespace DagoniteEmpire.Pages.Barony.Components
@using DA_Common.Barony

<MudDialog Class="baron-influence-dialog"
           ContentClass="baron-influence-dialog-content"
           ActionsClass="baron-influence-dialog-actions">
    <TitleContent>
        <MudText Typo="Typo.h6">Punkty życia</MudText>
    </TitleContent>
    <DialogContent>
        <div class="barony-dialog-theme baron-influence-edit-dialog">
            @if (!string.IsNullOrWhiteSpace(UnitName))
            {
                <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mb-2">
                    @UnitName
                </MudText>
            }
            <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mb-2">
                Ustaw bieżące HP dla tego oddziału (0–@MaxHp). Maksymalne HP wynika z Budowy, Woli,
                Wytrzymałości, Dyscypliny, Innych oraz strat w wyniku ofiar.
            </MudText>
            <MudNumericField T="int"
                             @bind-Value="_value"
                             Label="Bieżące HP"
                             HelperText="@($"Maks. {_max}")"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Min="0"
                             Max="@_max"
                             Class="baron-influence-field" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">Anuluj</MudButton>
        <MudButton Class="baron-influence-save-btn" Variant="Variant.Filled" OnClick="Save">Zapisz</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string? UnitName { get; set; }
    [Parameter] public int Value { get; set; }
    [Parameter] public int MaxHp { get; set; }

    private int _value;
    private int _max;

    protected override void OnInitialized()
    {
        _max = Math.Max(1, MaxHp);
        _value = Math.Clamp(Value, 0, _max);
    }

    private void Cancel() => MudDialog.Cancel();

    private void Save()
        => MudDialog.Close(DialogResult.Ok(Math.Clamp(_value, 0, _max)));
}
