@namespace DagoniteEmpire.Pages.Barony.Components
@implements IAsyncDisposable
@using DA_Business.Repository.BaronyRepos
@using DA_Business.Services
@using DA_Business.Services.Interfaces
@using DA_Models.ChatModels
@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager _navigationManager
@inject IUserService _userService
@inject IBaronyRepository _baronyRepo
@inject IBaronyBattleMapRepository _battleMapRepo
@inject CallbackService _callbackService

<nav class="barony-tabbar"
     aria-label="@(L["Barony tabs"])"
     @ondragover="OnNavDragOver"
     @ondragover:preventDefault>
    @foreach (var tab in _orderedTabs)
    {
        var key = tab.Key;
        var locked = IsTabLocked(key);
        <BaronyTooltip Text="@(locked ? L["Closed while the Game Master resolves the turn"] : L["Hold and drag to reorder"])">
        <div role="link"
             tabindex="0"
             draggable="true"
             class="barony-tabbar__tab @(IsActive(tab.Href) ? "barony-tabbar__tab--active" : "") @(locked ? "barony-tabbar__tab--locked" : "") @(_dragKey == key ? "barony-tabbar__tab--dragging" : "") @(_dropTargetKey == key ? "barony-tabbar__tab--drop-target" : "")"
             @ondragstart="e => OnDragStart(e, key)"
             @ondragenter="e => OnDragEnter(e, key)"
             @ondragleave="() => OnDragLeave(key)"
             @ondragover="e => OnItemDragOver(e, key)"
             @ondragover:preventDefault
             @ondrop="e => OnDrop(e, key)"
             @ondrop:preventDefault
             @ondragend="OnDragEndAsync"
             @onclick="() => OnTabActivate(tab.Href, key)"
             @onkeydown="e => OnTabKeyDown(e, tab.Href, key)">
            @if (!string.IsNullOrEmpty(tab.SvgIcon))
            {
                <img src="@tab.SvgIcon"
                     class="barony-tabbar__svg-icon @(tab.Key == "relations" ? "barony-tabbar__svg-icon--lg" : "")"
                     alt="" />
            }
            else if (!string.IsNullOrEmpty(tab.Icon))
            {
                var mudIcon = tab.Icon;
                <MudIcon Icon="@mudIcon" Size="Size.Small" />
            }
            @L[tab.Label]
            @if (locked)
            {
                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="barony-tabbar__lock" />
            }
            else if (key == "audience-hall" && _hallEventPendingCount > 0)
            {
                <span class="barony-tabbar__badge">@_hallEventPendingCount</span>
            }
        </div>
        </BaronyTooltip>
    }
</nav>

@code {
    private sealed record TabItem(string Key, string Label, string Href, string? Icon = null, string? SvgIcon = null);

    private static readonly TabItem[] DefaultTabs =
    {
        new("audience-hall", "Audience Hall", "/barony/audience-hall", SvgIcon: "/" + MyIcon.StoneThrone),
        new("domain", "Domain Panel", "/barony", Icons.Material.Filled.Dashboard),
        new("audiences", "Audiences", "/barony/audiences", SvgIcon: "/" + MyIcon.TiedScroll),
        new("offices", "Court", "/barony/offices", SvgIcon: "/" + MyIcon.People),
        new("terrain", "Terrain", "/barony/terrain", SvgIcon: "/" + MyIcon.WindmillBlack),
        new("lords-seat", "Seat", "/barony/lords-seat", Icons.Material.Filled.Castle),
        new("march-map", "March map", "/barony/march-map", SvgIcon: "/" + MyIcon.Compass),
        new("projects", "Projects", "/barony/projects", SvgIcon: "/" + MyIcon.GearHammer),
        new("letters", "Letters", "/barony/letters", SvgIcon: "/" + MyIcon.WaxSeal),
        new("trade-goods", "Trade", "/barony/trade-goods", SvgIcon: "/" + MyIcon.Trade),
        new("character-card", "Baron", "/barony/character-card", SvgIcon: "/" + MyIcon.JewelCrown),
        new("army", "Army", "/barony/army", Icons.Material.Filled.Shield),
        new("battle-map", "Battle", "/barony/battle-map", SvgIcon: "/" + MyIcon.AxeSword),
        new("resources", "Resources", "/barony/resources", SvgIcon: "/" + MyIcon.WoodenCrate),
        new("relations", "Relations", "/barony/relations", SvgIcon: "/" + MyIcon.ShakingHands),
        new("known-lords", "Lords", "/barony/known-lords", SvgIcon: "/" + MyIcon.VerticalBanner),
        new("buildings", "Buildings", "/barony/buildings", SvgIcon: "/" + MyIcon.WoodCabinBlack),
        new("notes", "Notes", "/barony/notes", SvgIcon: "/" + MyIcon.Quill),
        new("log", "Chronicle", "/barony/log", Icons.Material.Filled.History),
    };

    private List<TabItem> _orderedTabs = DefaultTabs.ToList();
    private string? _dragKey;
    private string? _dropTargetKey;
    private string? _lastHoverKey;
    private bool _orderChanged;
    private bool _suppressNextClick;
    private bool _showBattleMapTab = true;
    private bool _showNotesTab;
    private bool _showAudienceHallTab;
    private bool _isMg;
    private bool _turnResolving;
    private int _hallEventPendingCount;
    private HubConnection? _hubConnection;
    private int _baronyId;

    protected override async Task OnInitializedAsync()
    {
        _navigationManager.LocationChanged += OnLocationChanged;
        _callbackService.OnChange += OnSelectedCharacterChanged;
        await LoadBattleMapVisibilityAsync();
        await RefreshHallEventBadgeAsync();
        await LoadOrderAsync();
        await InitializeSignalRAsync();
    }

    private void OnSelectedCharacterChanged() =>
        InvokeAsync(async () =>
        {
            await LoadBattleMapVisibilityAsync();
            await RefreshHallEventBadgeAsync();
            StateHasChanged();
        });

    private async Task InitializeSignalRAsync()
    {
        if (_baronyId <= 0)
            return;
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(_navigationManager.ToAbsoluteUri(ChatHub.HubUrl))
                .WithAutomaticReconnect()
                .Build();
            _hubConnection.On<int>("BaronyBattleMapUpdated", OnBattleMapUpdated);
            _hubConnection.On<int, bool>("BaronyTurnResolvingChanged", OnTurnResolvingChanged);
            if (_hubConnection.State == HubConnectionState.Disconnected)
                await _hubConnection.StartAsync();
        }
        catch
        {
            // Tab visibility refresh is best-effort; page reload still works.
        }
    }

    private async Task OnBattleMapUpdated(int baronyId)
    {
        if (baronyId != _baronyId)
            return;
        await InvokeAsync(async () =>
        {
            await LoadBattleMapVisibilityAsync();
            _orderedTabs = ApplySavedOrder(await SafeGetTabOrderJson());
            StateHasChanged();
        });
    }

    /// <summary>
    /// The MG writes the turn between Resolve Turn and Finish Resolving — the baron is kept
    /// out of the tabs being written, the MG keeps them.
    /// </summary>
    private async Task OnTurnResolvingChanged(int baronyId, bool resolving)
    {
        if (baronyId != _baronyId || _isMg)
            return;

        await InvokeAsync(() =>
        {
            _turnResolving = resolving;

            // A baron sitting on a gated tab has to be moved onto the lock screen (or back in).
            if (BaronyTurnGate.IsLockedPath(CurrentPath))
                _navigationManager.NavigateTo(_navigationManager.Uri, forceLoad: true);
            else
                StateHasChanged();
        });
    }

    private string CurrentPath
    {
        get
        {
            var relative = _navigationManager.ToBaseRelativePath(_navigationManager.Uri);
            var pathOnly = relative.Split('?', '#')[0].TrimEnd('/');
            return pathOnly.Length == 0 ? "/" : "/" + pathOnly;
        }
    }

    private bool IsTabLocked(string tabKey) =>
        _turnResolving && !_isMg && BaronyTurnGate.IsLockedTab(tabKey);

    private async Task LoadBattleMapVisibilityAsync()
    {
        try
        {
            var user = await _userService.GetUserInfo();
            _isMg = user?.IsAdminOrMG == true;
            if (user?.IsAdminOrMG == true)
            {
                // MG gets its own private Notes scope (separate from the baron's).
                _showBattleMapTab = true;
                _showNotesTab = true;
                _showAudienceHallTab = true;
                _turnResolving = false;
                var mgCharacterId = user?.SelectedCharacter?.Id ?? 0;
                if (mgCharacterId > 0 && mgCharacterId != -1)
                {
                    var mgBarony = await _baronyRepo.GetByCharacterId(mgCharacterId);
                    if (mgBarony is not null)
                        _baronyId = mgBarony.Id;
                }
                else
                {
                    var summaries = await _baronyRepo.GetAllSummaries();
                    if (summaries.Count > 0)
                        _baronyId = summaries[0].Id;
                }

                await RefreshHallEventBadgeAsync();
                return;
            }

            var characterId = user?.SelectedCharacter?.Id ?? 0;
            if (characterId <= 0 || characterId == -1)
            {
                _showBattleMapTab = false;
                _showNotesTab = false;
                _showAudienceHallTab = false;
                _turnResolving = false;
                return;
            }

            var barony = await _baronyRepo.GetByCharacterId(characterId);
            if (barony is null)
            {
                _showBattleMapTab = false;
                _showNotesTab = false;
                _showAudienceHallTab = false;
                _turnResolving = false;
                _baronyId = 0;
                return;
            }

            _baronyId = barony.Id;
            _turnResolving = barony.TurnResolving;
            _showNotesTab = true;
            _showAudienceHallTab = true;
            _showBattleMapTab = await _battleMapRepo.IsActive(barony.Id);
        }
        catch
        {
            _showBattleMapTab = false;
            _showNotesTab = false;
            _showAudienceHallTab = false;
            _baronyId = 0;
        }

        await RefreshHallEventBadgeAsync();
    }

    private async Task RefreshHallEventBadgeAsync()
    {
        if (_baronyId <= 0)
        {
            _hallEventPendingCount = 0;
            return;
        }

        try
        {
            var badge = await _baronyRepo.GetHallEventInboxBadge(_baronyId);
            _hallEventPendingCount = badge.PendingCount;
        }
        catch
        {
            _hallEventPendingCount = 0;
        }
    }

    private IEnumerable<TabItem> VisibleDefaultTabs =>
        DefaultTabs.Where(t => (t.Key != "battle-map" || _showBattleMapTab)
                               && (t.Key != "notes" || _showNotesTab)
                               && (t.Key != "log" || _isMg)
                               && (t.Key != "audience-hall" || _showAudienceHallTab));

    private async Task LoadOrderAsync()
    {
        try
        {
            var json = await _userService.GetBaronyTabOrderJson();
            _orderedTabs = ApplySavedOrder(json);
        }
        catch
        {
            _orderedTabs = VisibleDefaultTabs.ToList();
        }
    }

    private List<TabItem> ApplySavedOrder(string? json)
    {
        var visible = VisibleDefaultTabs.ToList();
        var byKey = visible.ToDictionary(t => t.Key, StringComparer.Ordinal);
        var result = new List<TabItem>();

        if (!string.IsNullOrWhiteSpace(json))
        {
            try
            {
                var keys = System.Text.Json.JsonSerializer.Deserialize<List<string>>(json);
                if (keys is not null)
                {
                    foreach (var key in keys)
                    {
                        if (byKey.Remove(key, out var tab))
                            result.Add(tab);
                    }
                }
            }
            catch
            {
                // fall through
            }
        }

        foreach (var tab in visible)
        {
            if (byKey.Remove(tab.Key, out var leftover))
                result.Add(leftover);
        }

        return result.Count > 0 ? result : visible;
    }

    private async Task PersistOrderAsync()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(_orderedTabs.Select(t => t.Key).ToList());
        try
        {
            await _userService.SetBaronyTabOrderJson(json);
        }
        catch
        {
            // Ignore persistence failures.
        }
    }

    private void OnDragStart(DragEventArgs e, string key)
    {
        _dragKey = key;
        _dropTargetKey = null;
        _lastHoverKey = null;
        _orderChanged = false;
        _suppressNextClick = false;
        e.DataTransfer.EffectAllowed = "move";
    }

    private void OnNavDragOver(DragEventArgs e) => e.DataTransfer.DropEffect = "move";

    private void RememberHover(string key)
    {
        if (_dragKey is null || _dragKey == key)
            return;
        _dropTargetKey = key;
        _lastHoverKey = key;
    }

    private void OnItemDragOver(DragEventArgs e, string key)
    {
        e.DataTransfer.DropEffect = "move";
        RememberHover(key);
    }

    private void OnDragEnter(DragEventArgs e, string key)
    {
        e.DataTransfer.DropEffect = "move";
        RememberHover(key);
    }

    private void OnDragLeave(string key)
    {
        // Only clear highlight — keep _lastHoverKey for dragend fallback.
        if (_dropTargetKey == key)
            _dropTargetKey = null;
    }

    private void OnDrop(DragEventArgs e, string targetKey)
    {
        _lastHoverKey = targetKey;
        ApplyMove(_dragKey, targetKey);
        _suppressNextClick = true;
    }

    private void ApplyMove(string? dragKey, string? targetKey)
    {
        if (dragKey is null || targetKey is null)
            return;
        if (MoveTab(dragKey, targetKey))
            _orderChanged = true;
    }

    /// <summary>
    /// Moves <paramref name="dragKey"/> to the slot of <paramref name="targetKey"/>.
    /// </summary>
    private bool MoveTab(string dragKey, string targetKey)
    {
        if (string.Equals(dragKey, targetKey, StringComparison.Ordinal))
            return false;

        var from = _orderedTabs.FindIndex(t => t.Key == dragKey);
        var to = _orderedTabs.FindIndex(t => t.Key == targetKey);
        if (from < 0 || to < 0 || from == to)
            return false;

        var item = _orderedTabs[from];
        _orderedTabs.RemoveAt(from);
        // Do not decrement `to` when moving right — that would no-op on an adjacent tab.
        _orderedTabs.Insert(to, item);
        return true;
    }

    private async Task OnDragEndAsync()
    {
        // Browsers / Blazor sometimes skip drop; commit using last hover target.
        if (!_orderChanged)
            ApplyMove(_dragKey, _lastHoverKey);

        if (_orderChanged)
        {
            _suppressNextClick = true;
            await PersistOrderAsync();
        }

        _dragKey = null;
        _dropTargetKey = null;
        _lastHoverKey = null;
        _orderChanged = false;
        await InvokeAsync(StateHasChanged);
    }

    private void OnTabActivate(string href, string key)
    {
        if (_suppressNextClick)
        {
            _suppressNextClick = false;
            return;
        }

        if (IsTabLocked(key))
            return;

        if (!IsActive(href))
            _navigationManager.NavigateTo(href);
    }

    private void OnTabKeyDown(KeyboardEventArgs e, string href, string key)
    {
        if (e.Key is "Enter" or " ")
            OnTabActivate(href, key);
    }

    private bool IsActive(string href)
    {
        var current = "/" + _navigationManager.ToBaseRelativePath(_navigationManager.Uri);
        var path = current.Split('?')[0].TrimEnd('/');
        if (path.Length == 0)
            path = "/";

        if (href == "/barony")
            return path == "/barony";

        if (href == "/barony/resources")
            return path is "/barony/resources" or "/barony/budget";

        return path == href;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        InvokeAsync(async () =>
        {
            await LoadBattleMapVisibilityAsync();
            await RefreshHallEventBadgeAsync();
            _orderedTabs = ApplySavedOrder(await SafeGetTabOrderJson());
            StateHasChanged();
        });

    private async Task<string?> SafeGetTabOrderJson()
    {
        try { return await _userService.GetBaronyTabOrderJson(); }
        catch { return null; }
    }

    public async ValueTask DisposeAsync()
    {
        _navigationManager.LocationChanged -= OnLocationChanged;
        _callbackService.OnChange -= OnSelectedCharacterChanged;
        if (_hubConnection is not null)
        {
            try { await _hubConnection.DisposeAsync(); }
            catch { /* ignore */ }
        }
    }
}
