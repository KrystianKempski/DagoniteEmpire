@namespace DagoniteEmpire.Pages.Barony.Components
@implements IAsyncDisposable
@inject IUserService _userService
@inject IBaronyRepository _baronyRepo
@inject IBaronQaRepository _qaRepo
@inject NavigationManager _nav

@if (_visible && _unreadCount > 0)
{
    <div class="baron-letter-inbox-fab baron-letter-inbox-fab--qa">
        <MudBadge Content="@_unreadCount" Color="Color.Error" Overlap="true" Bordered="true">
            <BaronyTooltip Text="@string.Format(L["New questions: {0}"].Value, _unreadCount)">
                <button type="button"
                        class="baron-letter-inbox-fab__btn"
                        @onclick="OpenInboxAsync">
                    <img src="@($"/{MyIcon.QuestionBubble}")" alt="" class="baron-letter-inbox-fab__icon" />
                </button>
            </BaronyTooltip>
        </MudBadge>
    </div>
}

@code {
    private bool _visible;
    private bool _asGm;
    private int _baronyId;
    private int _unreadCount;
    private int? _latestThreadId;
    private CancellationTokenSource? _cts;
    private PeriodicTimer? _timer;
    private Task? _loop;

    protected override async Task OnInitializedAsync()
    {
        var user = await _userService.GetUserInfo();
        _asGm = user?.IsAdminOrMG == true
            || user?.Role == SD.Role_Admin
            || user?.Role == SD.Role_GameMaster;
        var isBaron = user?.Role == SD.Role_DukePlayer && !_asGm;
        _visible = isBaron || _asGm;
        if (!_visible)
            return;

        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(45));
        _loop = PollLoopAsync(_cts.Token);
        _nav.LocationChanged += OnLocationChanged;

        await RefreshAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(RefreshAsync);

    private async Task PollLoopAsync(CancellationToken ct)
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(ct))
                await InvokeAsync(RefreshAsync);
        }
        catch (OperationCanceledException) { }
    }

    private async Task RefreshAsync()
    {
        if (!_visible)
            return;

        try
        {
            if (_baronyId <= 0)
            {
                var user = await _userService.GetUserInfo();
                var characterId = user?.SelectedCharacter?.Id ?? 0;
                if (characterId <= 0)
                {
                    _unreadCount = 0;
                    StateHasChanged();
                    return;
                }

                var barony = await _baronyRepo.GetByCharacterId(characterId);
                if (barony is null)
                {
                    _unreadCount = 0;
                    StateHasChanged();
                    return;
                }

                _baronyId = barony.Id;
            }

            var badge = _asGm
                ? await _qaRepo.GetInboxBadgeForGm(_baronyId)
                : await _qaRepo.GetInboxBadgeForBaron(_baronyId);
            _unreadCount = badge.UnreadCount;
            _latestThreadId = badge.LatestThreadId;

            StateHasChanged();
        }
        catch
        {
            // Keep last known badge state on transient errors.
        }
    }

    private void OpenInboxAsync()
    {
        var url = _latestThreadId is int id
            ? $"/barony/notes?tab=qa&thread={id}"
            : "/barony/notes?tab=qa";
        _nav.NavigateTo(url);
    }

    public async ValueTask DisposeAsync()
    {
        _nav.LocationChanged -= OnLocationChanged;
        if (_cts is not null)
        {
            await _cts.CancelAsync();
            _cts.Dispose();
        }

        _timer?.Dispose();
        if (_loop is not null)
        {
            try { await _loop; }
            catch (OperationCanceledException) { }
        }
    }
}
