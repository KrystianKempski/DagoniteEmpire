@namespace DagoniteEmpire.Pages.Barony.Components
@using DA_Common.Barony
@using DA_Models.BaronyModels

<div class="bbm-grid-root" style="--bbm-cell:@(CellPx)px;">
    <div class="bbm-scroll" @onmouseleave="OnMapMouseLeave">
        @if (_hoverCell is not null)
        {
            <div class="bbm-cursor-pos">@FormatCell(_hoverCell.Value.X, _hoverCell.Value.Y)</div>
        }
        <div class="bbm-labeled-grid" style="--row-label-width:@RowLabelWidth; grid-template-columns: @RowLabelWidth max-content;">
            <div class="bbm-corner" aria-hidden="true" style="width:@RowLabelWidth; min-width:@RowLabelWidth; max-width:@RowLabelWidth;"></div>
            <div class="bbm-col-labels" style="grid-template-columns:repeat(@Width, var(--bbm-cell));">
                @for (int x = 0; x < Width; x++)
                {
                    <span class="bbm-axis-label bbm-axis-label--col">@ColumnLetter(x)</span>
                }
            </div>
            <div class="bbm-row-labels" style="width:@RowLabelWidth; min-width:@RowLabelWidth; max-width:@RowLabelWidth;">
                @for (int y = 0; y < Height; y++)
                {
                    <div class="bbm-axis-label bbm-axis-label--row">@(y + 1)</div>
                }
            </div>
            <div class="bbm-grid-stack">
                <div class="bbm-grid" style="grid-template-columns:repeat(@Width, var(--bbm-cell));">
                    @for (int y = 0; y < Height; y++)
                    {
                        for (int x = 0; x < Width; x++)
                        {
                            var cx = x;
                            var cy = y;
                            var cell = GetCell(cx, cy);
                            var token = AnchoredTokenAt(cx, cy);
                            var waypoint = IsAnimating ? null : AnchoredWaypointAt(cx, cy);
                            var hasOccupant = GetTokenAt(cx, cy) is not null;
                            var isSelected = SelectedTokenId is not null && GetTokenAt(cx, cy)?.Id == SelectedTokenId;
                            var inRange = !IsAnimating && RangeCells.Contains((cx, cy));
                            var isActiveTurn = ActiveTokenId is not null && token?.Id == ActiveTokenId;
                            var large = token is not null && TokenSize(token) > 1;
                            var hideToken = token is not null && IsTokenAnimating(token.Id);
                            <div class="bbm-cell @(Interactive ? "interactive" : null) @(isSelected ? "selected" : null) @(isActiveTurn ? "active-order" : null) @(hasOccupant && large ? "has-large-token" : null) @TerrainClass(cell)"
                                 style="background-color:@(cell?.Color ?? "transparent")"
                                 @onclick="@(() => OnCellClick.InvokeAsync((cx, cy)))"
                                 @onmouseenter="@(() => OnCellMouseEnter(cx, cy))">
                                @if (inRange)
                                {
                                    <div class="bbm-range"></div>
                                }
                                @if (ChargePreviewCells.Contains((cx, cy)))
                                {
                                    <div class="bbm-charge-preview"></div>
                                }
                                @if (cell?.Terrain == BaronyBattleTerrain.Difficult)
                                {
                                    <div class="bbm-terrain bbm-terrain--difficult" title="Difficult">∿</div>
                                }
                                else if (cell?.Terrain == BaronyBattleTerrain.Impassable)
                                {
                                    <div class="bbm-terrain bbm-terrain--impassable" title="Impassable">✕</div>
                                }
                                else if (cell?.Terrain == BaronyBattleTerrain.Deploy && ShowDeployZone)
                                {
                                    <div class="bbm-terrain bbm-terrain--deploy" title="Deployment zone"></div>
                                }
                                @if (!string.IsNullOrWhiteSpace(cell?.Text))
                                {
                                    <span class="bbm-cell-text" style="color:@(cell!.TextColor ?? "var(--barony-ink)")">@cell.Text</span>
                                }
                                @if (token is not null && !hideToken)
                                {
                                    <div class="bbm-token-slot @(large ? "large" : null) @(isActiveTurn ? "active-order" : null)" style="@TokenFootprintStyle(token)">
                                        @HpBar(token)
                                        <div class="bbm-token-rect @(token.IsEnemy ? "enemy" : "ally") @(isSelected ? "selected" : null) @(isActiveTurn ? "active-turn" : null)"
                                             style="--bbm-facing:@(FacingDegreesForToken(token).ToString(System.Globalization.CultureInfo.InvariantCulture))deg"
                                             title="@($"{token.Label} · HP {token.Hp}/{Math.Max(1, token.MaxHp)}")">
                                            @TokenIcon(token.IconKey, token.Label)
                                        </div>
                                        <div class="bbm-token-label @(token.IsEnemy ? "bbm-name--enemy" : "bbm-name--ally")">@token.Label</div>
                                        @if (ShowMoveBadge(token))
                                        {
                                            <span class="bbm-move-badge" title="Move points">@(OriginMoveBadge(token))</span>
                                        }
                                        @if (ShowOriginFacingButton(token))
                                        {
                                            <button type="button"
                                                    class="bbm-facing-btn"
                                                    title="@(AllowSetupFacing ? "Change facing" : "Change facing (1 move)")"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="@(() => OnFacingButton.InvokeAsync(token.Id))">
                                                <img class="bbm-facing-btn__icon" src="/icons/clockwise-rotation.svg" alt="" aria-hidden="true" />
                                            </button>
                                        }
                                        @if (ShowOriginChargeButton(token))
                                        {
                                            <button type="button"
                                                    class="bbm-charge-btn"
                                                    title="Charge (min 3 move; 3 straight / 2 diagonal tiles)"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="@(() => OnChargeButton.InvokeAsync(token.Id))">
                                                <img class="bbm-charge-btn__icon" src="/icons/shield-bash.svg" alt="" aria-hidden="true" />
                                            </button>
                                        }
                                    </div>
                                    @if (IsEngagedToken(token))
                                    {
                                        <span class="bbm-engage-badge @(ShowOriginChargeButton(token) || ShowFogFacingOnlyBadge(token) ? "shifted" : null)" title="@EngagementTooltip(token)">
                                            <img class="bbm-engage-badge__icon" src="/icons/crossed-swords.svg" alt="" aria-hidden="true" />
                                            @if (token.EngagedEnemyIds.Count > 1)
                                            {
                                                <span class="bbm-engage-badge__count">@token.EngagedEnemyIds.Count</span>
                                            }
                                        </span>
                                    }
                                    @if (ShowFogFacingOnlyBadge(token))
                                    {
                                        <span class="bbm-facing-only-badge" title="This unit is only changing facing (no move).">
                                            <img class="bbm-facing-only-badge__icon" src="/icons/clockwise-rotation.svg" alt="" aria-hidden="true" />
                                        </span>
                                    }
                                    @if (IsRangedToken(token))
                                    {
                                        <span class="bbm-ranged-badge" title="@RangedTooltip(token)">
                                            <img class="bbm-ranged-badge__icon" src="/icons/archer.svg" alt="" aria-hidden="true" />
                                            <span class="bbm-ranged-badge__count">@token.Range</span>
                                        </span>
                                    }
                                    @if (ShowInPlaceFacingGhost(token))
                                    {
                                        var facingTip = token.LastWaypoint!;
                                        var plannedFacingDeg = FacingDegreesForTip(token, facingTip);
                                        <div class="bbm-token-slot bbm-token-slot--ghost bbm-token-slot--facing-ghost @(large ? "large" : null)"
                                             style="@TokenFootprintStyle(token)"
                                             aria-hidden="true">
                                            <div class="bbm-token-rect bbm-token-rect--ghost @(token.IsEnemy ? "enemy" : "ally") locked"
                                                 style="--bbm-facing:@(plannedFacingDeg.ToString(System.Globalization.CultureInfo.InvariantCulture))deg"
                                                 title="@($"{token.Label} (planned facing)")">
                                                @TokenIcon(token.IconKey, token.Label)
                                            </div>
                                        </div>
                                    }
                                }
                                @if (waypoint is not null)
                                {
                                    var (owner, wp) = waypoint.Value;
                                    var ghostLarge = TokenSize(owner) > 1;
                                    var tipFacingDeg = FacingDegreesForTip(owner, wp);
                                    var showFacingBtn = ShowFacingButton(owner, wp);
                                    var showChargeBtn = ShowChargeButton(owner, wp);
                                    <div class="bbm-token-slot bbm-token-slot--ghost @(ghostLarge ? "large" : null) @(wp.Locked ? "locked" : null)"
                                         style="@TokenFootprintStyle(owner)">
                                        <div class="bbm-token-rect bbm-token-rect--ghost @(owner.IsEnemy ? "enemy" : "ally") @(wp.Locked ? "locked" : null)"
                                             style="--bbm-facing:@(tipFacingDeg.ToString(System.Globalization.CultureInfo.InvariantCulture))deg"
                                             title="@(wp.Locked ? $"{owner.Label} (locked)" : $"{owner.Label} (destination)")">
                                            @TokenIcon(owner.IconKey, owner.Label)
                                        </div>
                                        <div class="bbm-token-label @(owner.IsEnemy ? "bbm-name--enemy" : "bbm-name--ally")">@owner.Label</div>
                                        <span class="bbm-move-badge" title="Move left">@wp.RemainingMoveAfter</span>
                                        @if (wp.Locked)
                                        {
                                            <span class="bbm-lock-badge" title="Locked" aria-hidden="true"></span>
                                        }
                                        @if (showFacingBtn)
                                        {
                                            <button type="button"
                                                    class="bbm-facing-btn"
                                                    title="Change facing (1 move)"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="@(() => OnFacingButton.InvokeAsync(owner.Id))">
                                                <img class="bbm-facing-btn__icon" src="/icons/clockwise-rotation.svg" alt="" aria-hidden="true" />
                                            </button>
                                        }
                                        @if (showChargeBtn)
                                        {
                                            <button type="button"
                                                    class="bbm-charge-btn"
                                                    title="Charge (min 3 move; 3 straight / 2 diagonal tiles)"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="@(() => OnChargeButton.InvokeAsync(owner.Id))">
                                                <img class="bbm-charge-btn__icon" src="/icons/shield-bash.svg" alt="" aria-hidden="true" />
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
                @{
                    var arrowGw = Width * (CellPx + GridGap) - GridGap;
                    var arrowGh = Height * (CellPx + GridGap) - GridGap;
                }
                <svg class="bbm-path-overlay" width="@arrowGw" height="@arrowGh" viewBox="0 0 @arrowGw @arrowGh" style="pointer-events:none" aria-hidden="true">
                    <defs>
                        <marker id="bbm-arrow-ally" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto" markerUnits="strokeWidth">
                            <path d="M0,0 L6,3 L0,6 Z" fill="rgba(47,107,79,0.55)" />
                        </marker>
                        <marker id="bbm-arrow-enemy" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto" markerUnits="strokeWidth">
                            <path d="M0,0 L6,3 L0,6 Z" fill="rgba(168,52,52,0.55)" />
                        </marker>
                    </defs>
                    @foreach (var token in Tokens)
                    {
                        var points = NonChargeRoutePoints(token);
                        if (points.Count < 2) continue;
                        var arrowClass = token.IsEnemy ? "bbm-path-arrow bbm-path-arrow--enemy" : "bbm-path-arrow bbm-path-arrow--ally";
                        var markerId = token.IsEnemy ? "bbm-arrow-enemy" : "bbm-arrow-ally";
                        // Fog hints are not exact destinations — draw the shaft only, no arrowhead.
                        var showHead = !(FogEnemyPlans && token.IsEnemy);
                        for (var i = 0; i < points.Count - 1; i++)
                        {
                            var a = points[i];
                            var b = points[i + 1];
                            var isLast = i == points.Count - 2;
                            <line class="@arrowClass"
                                  x1="@a.cx.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                  y1="@a.cy.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                  x2="@b.cx.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                  y2="@b.cy.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                  marker-end="@(showHead && isLast ? $"url(#{markerId})" : null)" />
                        }
                    }
                </svg>
                <svg class="bbm-path-overlay bbm-attack-plan-overlay" width="@arrowGw" height="@arrowGh" viewBox="0 0 @arrowGw @arrowGh" style="pointer-events:none" aria-hidden="true">
                    <defs>
                        <marker id="bbm-attack-arrow-ally" markerWidth="2" markerHeight="2" refX="-0.5" refY="1" orient="auto" markerUnits="strokeWidth">
                            <path d="M0,0 L2,1 L0,2 Z" fill="rgb(199, 144, 26)" fill-opacity="0.58" />
                        </marker>
                        <marker id="bbm-attack-arrow-enemy" markerWidth="2" markerHeight="2" refX="-0.5" refY="1" orient="auto" markerUnits="strokeWidth">
                            <path d="M0,0 L2,1 L0,2 Z" fill="rgb(183, 56, 56)" fill-opacity="0.58" />
                        </marker>
                    </defs>
                    @foreach (var charger in Tokens)
                    {
                        var chargePoints = ChargeArrowPoints(charger);
                        if (chargePoints.Count < 2) continue;
                        // One continuous shaft + single head (charges are always straight).
                        var a = chargePoints[0];
                        var b = chargePoints[^1];
                        var arrowClass = charger.IsEnemy
                            ? "bbm-attack-plan-arrow bbm-attack-plan-arrow--enemy"
                            : "bbm-attack-plan-arrow bbm-attack-plan-arrow--ally";
                        var markerId = charger.IsEnemy ? "bbm-attack-arrow-enemy" : "bbm-attack-arrow-ally";
                        var dx = b.cx - a.cx;
                        var dy = b.cy - a.cy;
                        var len = Math.Sqrt(dx * dx + dy * dy);
                        const double headLenPx = 32.0;
                        var pullBack = Math.Min(headLenPx, Math.Max(0.0, len - 1.0));
                        var shaftToX = len > 0.001 ? b.cx - dx / len * pullBack : b.cx;
                        var shaftToY = len > 0.001 ? b.cy - dy / len * pullBack : b.cy;
                        <line class="@arrowClass"
                              x1="@a.cx.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                              y1="@a.cy.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                              x2="@shaftToX.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                              y2="@shaftToY.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                              marker-end="url(#@markerId)" />
                    }
                    @foreach (var attacker in Tokens)
                    {
                        if (!ShouldDrawAttackArrow(attacker)) continue;
                        var target = Tokens.FirstOrDefault(t => t.Id == attacker.AttackTargetId);
                        if (target is null) continue;

                        var baseFrom = CellCenter(attacker.X, attacker.Y, TokenSize(attacker));
                        var baseTo = CellCenter(target.X, target.Y, TokenSize(target));
                        var dx = baseTo.cx - baseFrom.cx;
                        var dy = baseTo.cy - baseFrom.cy;
                        var len = Math.Sqrt(dx * dx + dy * dy);
                        var from = baseFrom;
                        var to = baseTo;

                        // If both units target each other, draw two parallel arrows on opposite sides.
                        // During combat focus anim, always draw a single centered shaft.
                        if (!CombatAnimActive
                            && !string.IsNullOrWhiteSpace(target.AttackTargetId)
                            && string.Equals(target.AttackTargetId, attacker.Id, StringComparison.Ordinal)
                            && len > 0.001)
                        {
                            var firstIsAttacker = string.CompareOrdinal(attacker.Id, target.Id) <= 0;
                            var p1 = firstIsAttacker ? baseFrom : baseTo;
                            var p2 = firstIsAttacker ? baseTo : baseFrom;
                            var pdx = p2.cx - p1.cx;
                            var pdy = p2.cy - p1.cy;
                            var plen = Math.Sqrt(pdx * pdx + pdy * pdy);
                            if (plen > 0.001)
                            {
                                var nx = -pdy / plen;
                                var ny = pdx / plen;
                                var side = firstIsAttacker ? 1.0 : -1.0;
                                const double parallelOffsetPx = 8.0;
                                var ox = nx * parallelOffsetPx * side;
                                var oy = ny * parallelOffsetPx * side;
                                from = (baseFrom.cx + ox, baseFrom.cy + oy);
                                to = (baseTo.cx + ox, baseTo.cy + oy);
                                dx = to.cx - from.cx;
                                dy = to.cy - from.cy;
                                len = Math.Sqrt(dx * dx + dy * dy);
                            }
                        }

                        const double headLenPx = 32.0; // marker tip span (2) * stroke-width (16)
                        var pullBack = Math.Min(headLenPx, Math.Max(0.0, len - 1.0));
                        var isDiagonal = Math.Abs(dx) > 0.001 && Math.Abs(dy) > 0.001;
                        if (isDiagonal)
                            pullBack = Math.Max(0.0, pullBack - 1.0);
                        var shaftToX = len > 0.001 ? to.cx - dx / len * pullBack : to.cx;
                        var shaftToY = len > 0.001 ? to.cy - dy / len * pullBack : to.cy;
                        var arrowClass = attacker.IsEnemy
                            ? "bbm-attack-plan-arrow bbm-attack-plan-arrow--enemy"
                            : "bbm-attack-plan-arrow bbm-attack-plan-arrow--ally";
                        var markerId = attacker.IsEnemy ? "bbm-attack-arrow-enemy" : "bbm-attack-arrow-ally";

                        <line class="@arrowClass @(CombatAnimActive ? "bbm-attack-plan-arrow--focus" : null)"
                              x1="@from.cx.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                              y1="@from.cy.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            x2="@shaftToX.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            y2="@shaftToY.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                              marker-end="url(#@markerId)" />
                    }
                </svg>
                @if (CombatFx is not null)
                {
                    var atk = Tokens.FirstOrDefault(t => t.Id == CombatFx.AttackerId);
                    var def = Tokens.FirstOrDefault(t => t.Id == CombatFx.DefenderId);
                    if (atk is not null && def is not null)
                    {
                        var atkCenter = TokenCenter(atk);
                        var defCenter = TokenCenter(def);
                        var midX = (atkCenter.cx + defCenter.cx) / 2.0;
                        var midY = (atkCenter.cy + defCenter.cy) / 2.0;
                        <div class="bbm-combat-fx-layer" aria-hidden="true">
                            @if (CombatFx.ShowClash)
                            {
                                @if (CombatFx.IsShot)
                                {
                                    <div class="bbm-combat-clash bbm-combat-clash--shot"
                                         style="left:@(defCenter.cx.ToString(System.Globalization.CultureInfo.InvariantCulture))px; top:@(defCenter.cy.ToString(System.Globalization.CultureInfo.InvariantCulture))px;">
                                        <img src="/icons/archer.svg" alt="" />
                                    </div>
                                }
                                else
                                {
                                    <div class="bbm-combat-clash"
                                         style="left:@(midX.ToString(System.Globalization.CultureInfo.InvariantCulture))px; top:@(midY.ToString(System.Globalization.CultureInfo.InvariantCulture))px;">
                                        <img src="/icons/crossed-swords.svg" alt="" />
                                    </div>
                                }
                            }
                            @if (CombatFx.ShowDamage)
                            {
                                @if (CombatFx.DealtToDefender > 0)
                                {
                                    <div class="bbm-combat-float bbm-combat-float--hit"
                                         style="left:@(defCenter.cx.ToString(System.Globalization.CultureInfo.InvariantCulture))px; top:@(defCenter.cy.ToString(System.Globalization.CultureInfo.InvariantCulture))px;">
                                        -@CombatFx.DealtToDefender
                                    </div>
                                }
                                @if (CombatFx.DealtToAttacker > 0)
                                {
                                    <div class="bbm-combat-float bbm-combat-float--riposte"
                                         style="left:@(atkCenter.cx.ToString(System.Globalization.CultureInfo.InvariantCulture))px; top:@(atkCenter.cy.ToString(System.Globalization.CultureInfo.InvariantCulture))px;">
                                        -@CombatFx.DealtToAttacker
                                    </div>
                                }
                            }
                        </div>
                    }
                }
                @if (ShowThreatRadius)
                {
                    var gw = Width * (CellPx + GridGap) - GridGap;
                    var gh = Height * (CellPx + GridGap) - GridGap;
                    <svg class="bbm-path-overlay bbm-threat-overlay" width="@gw" height="@gh" viewBox="0 0 @gw @gh" style="pointer-events:none" aria-hidden="true">
                        @foreach (var token in Tokens.Where(t => !IsTokenAnimating(t.Id)))
                        {
                            var ts = TokenSize(token);
                            var (cx, cy) = CellCenter(token.X, token.Y, ts);
                            var r  = ThreatFactor * ts * 0.5 * CellPx;
                            var fill   = token.IsEnemy ? "rgba(210,60,60,0.15)"  : "rgba(60,110,210,0.15)";
                            var stroke = token.IsEnemy ? "rgba(210,60,60,0.70)"  : "rgba(60,110,210,0.70)";
                            <circle cx="@cx.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    cy="@cy.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    r="@r.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    fill="@fill" stroke="@stroke" stroke-width="1.5" stroke-dasharray="4 3" />
                        }
                    </svg>
                }
                @if (IsAnimating)
                {
                    <div class="bbm-anim-layer" aria-hidden="true">
                        @foreach (var frame in AnimatingTokens)
                        {
                            var token = Tokens.FirstOrDefault(t => t.Id == frame.TokenId);
                            if (token is null) continue;
                            var size = Math.Max(1, frame.Size);
                            var facingDeg = frame.FacingDeg;
                            <div class="bbm-token-slot bbm-token-slot--anim @(AnimTransitions ? "bbm-token-slot--anim-run" : null) @(size > 1 ? "large" : null)"
                                 style="left:@(frame.LeftPx)px; top:@(frame.TopPx)px; width:@(size * CellPx)px; height:@(size * CellPx)px; transition:left @(frame.TransitionMs)ms linear,top @(frame.TransitionMs)ms linear;">
                                @if (ShowThreatRadius)
                                {
                                    var ringPx = ThreatFactor * size * CellPx;
                                    <div class="bbm-threat-ring @(token.IsEnemy ? "enemy" : "ally")"
                                         style="width:@(ringPx.ToString(System.Globalization.CultureInfo.InvariantCulture))px; height:@(ringPx.ToString(System.Globalization.CultureInfo.InvariantCulture))px;"></div>
                                }
                                @HpBar(token)
                                <div class="bbm-token-rect @(token.IsEnemy ? "enemy" : "ally")"
                                     style="--bbm-facing:@(facingDeg.ToString(System.Globalization.CultureInfo.InvariantCulture))deg"
                                     title="@($"{token.Label} · HP {token.Hp}/{Math.Max(1, token.MaxHp)}")">
                                    @TokenIcon(token.IconKey, token.Label)
                                </div>
                                <div class="bbm-token-label @(token.IsEnemy ? "bbm-name--enemy" : "bbm-name--ally")">@token.Label</div>
                                @if (IsEngagedToken(token))
                                {
                                    <span class="bbm-engage-badge" title="@EngagementTooltip(token)">
                                        <img class="bbm-engage-badge__icon" src="/icons/crossed-swords.svg" alt="" aria-hidden="true" />
                                        @if (token.EngagedEnemyIds.Count > 1)
                                        {
                                            <span class="bbm-engage-badge__count">@token.EngagedEnemyIds.Count</span>
                                        }
                                    </span>
                                }
                                @if (IsRangedToken(token))
                                {
                                    <span class="bbm-ranged-badge" title="@RangedTooltip(token)">
                                        <img class="bbm-ranged-badge__icon" src="/icons/archer.svg" alt="" aria-hidden="true" />
                                        <span class="bbm-ranged-badge__count">@token.Range</span>
                                    </span>
                                }
                            </div>
                        }
                    </div>
                }
                @if (IsFacingEdit || IsChargeEdit)
                {
                    <div class="bbm-facing-overlay @(IsChargeEdit ? "bbm-facing-overlay--charge" : null)"
                         @onmousemove="OnFacingMouseMove"
                         @onclick="OnFacingOverlayClick"></div>
                }
            </div>
        </div>
    </div>
    <div class="bbm-legend">
        <span class="bbm-legend__item"><i class="bbm-legend__swatch bbm-legend__swatch--range"></i> Movement</span>
        <span class="bbm-legend__item"><i class="bbm-legend__swatch bbm-legend__swatch--ghost"></i> Destination</span>
        <span class="bbm-legend__item"><i class="bbm-legend__swatch bbm-legend__swatch--locked"></i> Locked</span>
        <span class="bbm-legend__item"><i class="bbm-legend__swatch bbm-legend__swatch--deploy"></i> Deploy</span>
        <span class="bbm-legend__item"><i class="bbm-legend__swatch bbm-legend__swatch--difficult"></i> Difficult ×2</span>
        <span class="bbm-legend__item"><i class="bbm-legend__swatch bbm-legend__swatch--impassable"></i> Impassable</span>
    </div>
</div>

@code {
    private const int CellPx = 64;

    [Parameter] public int Width { get; set; } = 20;
    [Parameter] public int Height { get; set; } = 16;
    [Parameter] public IReadOnlyList<BaronyBattleCellDTO> Cells { get; set; } = Array.Empty<BaronyBattleCellDTO>();
    [Parameter] public IReadOnlyList<BaronyBattleTokenDTO> Tokens { get; set; } = Array.Empty<BaronyBattleTokenDTO>();
    [Parameter] public string? SelectedTokenId { get; set; }
    [Parameter] public string? ActiveTokenId { get; set; }
    [Parameter] public HashSet<(int X, int Y)> RangeCells { get; set; } = new();
    [Parameter] public bool Interactive { get; set; } = true;
    [Parameter] public bool ShowActiveMoveBadge { get; set; }
    [Parameter] public IReadOnlyList<BattleMoveAnimFrame> AnimatingTokens { get; set; } = Array.Empty<BattleMoveAnimFrame>();
    [Parameter] public bool AnimTransitions { get; set; }
    [Parameter] public bool ShowDeployZone { get; set; } = true;
    [Parameter] public bool AllowSetupFacing { get; set; }
    /// <summary>False when the unit on the clock belongs to a side the viewer may not order.</summary>
    [Parameter] public bool AllowActiveOrders { get; set; } = true;
    [Parameter] public bool ShowThreatRadius { get; set; }
    [Parameter] public double ThreatFactor { get; set; } = 1.3;
    [Parameter] public IReadOnlyDictionary<string, List<(int X, int Y)>> PlannedRoutes { get; set; }
        = new Dictionary<string, List<(int X, int Y)>>();
    /// <summary>
    /// When true (Baron in movement phase), enemy destination ghosts and full arrows are hidden;
    /// only a short direction hint from PlannedRoutes (or a facing-only badge) is shown.
    /// </summary>
    [Parameter] public bool FogEnemyPlans { get; set; }
    /// <summary>When true, only the focused attacker's arrow is drawn (or none if focus is null).</summary>
    [Parameter] public bool CombatAnimActive { get; set; }
    [Parameter] public string? CombatFocusAttackerId { get; set; }
    [Parameter] public BattleCombatFx? CombatFx { get; set; }
    [Parameter] public string? FacingEditTokenId { get; set; }
    [Parameter] public double? FacingPreviewDegrees { get; set; }
    /// <summary>When set, overlay confirms a charge direction instead of facing.</summary>
    [Parameter] public string? ChargeEditTokenId { get; set; }
    [Parameter] public HashSet<(int X, int Y)> ChargePreviewCells { get; set; } = new();
    [Parameter] public EventCallback<(int X, int Y)> OnCellClick { get; set; }
    [Parameter] public EventCallback<string> OnFacingButton { get; set; }
    [Parameter] public EventCallback<string> OnChargeButton { get; set; }
    [Parameter] public EventCallback<double> OnFacingPreview { get; set; }
    [Parameter] public EventCallback OnFacingConfirm { get; set; }
    [Parameter] public EventCallback OnChargeConfirm { get; set; }

    private (int X, int Y)? _hoverCell;

    private string RowLabelWidth => "32px";

    private bool IsAnimating => AnimatingTokens.Count > 0;
    private bool IsFacingEdit =>
        !string.IsNullOrEmpty(FacingEditTokenId)
        && Tokens.Any(t => t.Id == FacingEditTokenId);
    private bool IsChargeEdit =>
        !string.IsNullOrEmpty(ChargeEditTokenId)
        && Tokens.Any(t => t.Id == ChargeEditTokenId);

    private bool IsTokenAnimating(string tokenId) =>
        AnimatingTokens.Any(a => a.TokenId == tokenId);

    private static bool IsEngagedToken(BaronyBattleTokenDTO token) =>
        token.EngagedEnemyIds.Count > 0;

    private static bool IsRangedToken(BaronyBattleTokenDTO token) =>
        token.Range > 0;

    private string EngagementTooltip(BaronyBattleTokenDTO token)
    {
        if (token.EngagedEnemyIds.Count == 0)
            return "Engaged";
        var names = token.EngagedEnemyIds
            .Select(id => Tokens.FirstOrDefault(t => t.Id == id)?.Label ?? "unknown")
            .ToList();
        return names.Count == 1
            ? $"Engaged with {names[0]}"
            : $"Engaged with {string.Join(", ", names)}";
    }

    private static string RangedTooltip(BaronyBattleTokenDTO token) =>
        $"Ranged · range {token.Range} · −2 attack per tile past point-blank " +
        "(cannot shoot while engaged in melee)";

    private bool ShouldDrawAttackArrow(BaronyBattleTokenDTO attacker)
    {
        if (string.IsNullOrWhiteSpace(attacker.AttackTargetId))
            return false;
        // While a charge path is still planned/animating, show the long charge arrow instead.
        if (attacker.ChargeBonus && (attacker.HasPath || IsTokenAnimating(attacker.Id)))
            return false;
        if (!CombatAnimActive)
            return true;
        return !string.IsNullOrWhiteSpace(CombatFocusAttackerId)
            && string.Equals(attacker.Id, CombatFocusAttackerId, StringComparison.Ordinal);
    }

    /// <summary>
    /// Long attack-style arrow along a declared charge (full charge length), not toward the enemy's current tile.
    /// Starts at the charge origin (ChargeOrigin / last non-charge waypoint), never at an earlier march segment.
    /// </summary>
    private List<(double cx, double cy)> ChargeArrowPoints(BaronyBattleTokenDTO token)
    {
        if (!token.ChargeBonus)
            return new List<(double cx, double cy)>();

        // Baron fog: short start hint is drawn as the ordinary path arrow (PlannedRoutes).
        // Never show the full charge shaft / destination.
        if (FogEnemyPlans && token.IsEnemy)
            return new List<(double cx, double cy)>();

        var size = TokenSize(token);
        var origin = ResolveChargeOrigin(token);
        var chargeWps = token.Path.Where(w => w.IsCharge).ToList();

        // Prefer exact tile hops when available (planning + resolve animation).
        if (PlannedRoutes is not null
            && PlannedRoutes.TryGetValue(token.Id, out var cells)
            && cells.Count > 1)
        {
            var startIdx = cells.FindIndex(c => c.X == origin.X && c.Y == origin.Y);
            // Origin not on this route (truncated before charge) → no charge arrow.
            if (startIdx < 0)
                return new List<(double cx, double cy)>();

            // During resolve animation PlannedRoutes is the pre-collision plan — keep the
            // full charge shaft even if the live Path was truncated by a collision.
            if (IsAnimating || chargeWps.Count == 0)
            {
                if (startIdx < cells.Count - 1)
                    return cells.Skip(startIdx).Select(c => CellCenter(c.X, c.Y, size)).ToList();
                return new List<(double cx, double cy)>();
            }

            var end = chargeWps[^1];
            var endIdx = cells.FindLastIndex(c => c.X == end.X && c.Y == end.Y);
            if (endIdx > startIdx)
                return cells.Skip(startIdx).Take(endIdx - startIdx + 1)
                    .Select(c => CellCenter(c.X, c.Y, size)).ToList();

            if (startIdx < cells.Count - 1)
                return cells.Skip(startIdx).Select(c => CellCenter(c.X, c.Y, size)).ToList();

            return new List<(double cx, double cy)>();
        }

        if (chargeWps.Count == 0)
            return new List<(double cx, double cy)>();

        var points = new List<(double cx, double cy)> { CellCenter(origin.X, origin.Y, size) };
        foreach (var wp in chargeWps)
            points.Add(CellCenter(wp.X, wp.Y, size));
        return points;
    }

    private static (int X, int Y) ResolveChargeOrigin(BaronyBattleTokenDTO token)
    {
        if (token.ChargeOriginX is int ox && token.ChargeOriginY is int oy)
            return (ox, oy);
        var prior = token.Path.LastOrDefault(w => !w.IsCharge);
        return prior is not null ? (prior.X, prior.Y) : (token.X, token.Y);
    }

    private BaronyBattleCellDTO? GetCell(int x, int y) =>
        Cells.FirstOrDefault(c => c.X == x && c.Y == y);

    private static int TokenSize(BaronyBattleTokenDTO token) => Math.Clamp(token.Size <= 0 ? 1 : token.Size, 1, 3);

    private BaronyBattleTokenDTO? GetTokenAt(int x, int y) =>
        Tokens.FirstOrDefault(t => Covers(t, x, y));

    private BaronyBattleTokenDTO? AnchoredTokenAt(int x, int y) =>
        Tokens.FirstOrDefault(t => t.X == x && t.Y == y);

    private (BaronyBattleTokenDTO Owner, BaronyBattleWaypointDTO Wp)? AnchoredWaypointAt(int x, int y)
    {
        foreach (var t in Tokens)
        {
            // Baron fog: never show enemy destination ghosts (arrow hint comes from PlannedRoutes).
            if (FogEnemyPlans && t.IsEnemy)
                continue;

            var wp = t.Path.FirstOrDefault(w => w.X == x && w.Y == y && (w.X != t.X || w.Y != t.Y));
            if (wp is null)
                continue;

            // Charge is visualized with a single destination ghost (not one per tile).
            if (wp.IsCharge && !ReferenceEquals(wp, t.Path.LastOrDefault(w => w.IsCharge)))
                continue;

            return (t, wp);
        }
        return null;
    }

    private bool ShowFogFacingOnlyBadge(BaronyBattleTokenDTO token)
    {
        if (!FogEnemyPlans || !token.IsEnemy || IsAnimating)
            return false;
        if (ActiveTokenId == token.Id)
            return false;
        if (!token.HasPath || token.Path.Any(w => !w.Locked))
            return false;
        if (token.Path.Any(w => w.X != token.X || w.Y != token.Y))
            return false;
        var tip = token.LastWaypoint;
        if (tip is null)
            return false;
        return tip.FacingCostPaid > 0
               || BaronyBattleFacing.Clamp(tip.Facing) != BaronyBattleFacing.Clamp(token.Facing);
    }

    /// <summary>
    /// In-place facing change during movement planning: keep the living token on its current
    /// heading and show a ghost with the planned facing (applied only when movement resolves).
    /// </summary>
    private bool ShowInPlaceFacingGhost(BaronyBattleTokenDTO token)
    {
        if (IsAnimating || AllowSetupFacing)
            return false;
        // Baron fog already uses the rotation badge instead of a facing ghost.
        if (FogEnemyPlans && token.IsEnemy)
            return false;
        var tip = token.LastWaypoint;
        if (tip is null || !IsInPlaceTip(token, tip))
            return false;
        if (FacingEditTokenId == token.Id)
            return true;
        return tip.FacingCostPaid > 0
               || BaronyBattleFacing.Clamp(tip.Facing) != BaronyBattleFacing.Clamp(token.Facing);
    }

    private bool ShowMoveBadge(BaronyBattleTokenDTO token) =>
        ShowActiveMoveBadge && ActiveTokenId == token.Id;

    private bool IsInPlaceTip(BaronyBattleTokenDTO token, BaronyBattleWaypointDTO wp) =>
        wp.X == token.X && wp.Y == token.Y;

    private bool ShowOriginFacingButton(BaronyBattleTokenDTO token)
    {
        if (IsAnimating || IsFacingEdit || IsChargeEdit || !Interactive)
            return false;

        // Setup / deploy: rotate any selected token for free.
        if (AllowSetupFacing && SelectedTokenId == token.Id)
            return true;

        if (!AllowActiveOrders)
            return false;
        if (ActiveTokenId != token.Id)
            return false;
        // A declared charge fixes the heading and takes no further orders.
        if (token.ChargeBonus)
            return false;
        var tip = token.LastWaypoint;
        // Destination tip elsewhere already has its own facing button.
        if (tip is not null && !IsInPlaceTip(token, tip))
            return false;
        var moveLeft = tip?.RemainingMoveAfter ?? token.RemainingMove;
        var paid = tip?.FacingCostPaid ?? 0;
        return moveLeft >= 1 || paid > 0;
    }

    private bool ShowOriginChargeButton(BaronyBattleTokenDTO token)
    {
        if (IsAnimating || IsFacingEdit || IsChargeEdit || !Interactive)
            return false;
        if (AllowSetupFacing || !AllowActiveOrders)
            return false;
        if (ActiveTokenId != token.Id)
            return false;
        // One charge per unit per round.
        if (token.ChargeBonus)
            return false;
        var tip = token.LastWaypoint;
        if (tip is not null && !IsInPlaceTip(token, tip))
            return false;
        var moveLeft = tip?.RemainingMoveAfter ?? token.RemainingMove;
        return moveLeft >= 3;
    }

    private int OriginMoveBadge(BaronyBattleTokenDTO token)
    {
        var tip = token.LastWaypoint;
        if (tip is not null && IsInPlaceTip(token, tip))
            return tip.RemainingMoveAfter;
        return token.RemainingMove > 0 ? token.RemainingMove : token.Move;
    }

    private bool ShowFacingButton(BaronyBattleTokenDTO owner, BaronyBattleWaypointDTO wp)
    {
        if (IsAnimating || IsFacingEdit || IsChargeEdit || !AllowActiveOrders)
            return false;
        if (ActiveTokenId != owner.Id)
            return false;
        // A declared charge fixes the heading and takes no further orders.
        if (owner.ChargeBonus)
            return false;
        if (owner.LastWaypoint != wp)
            return false;
        return wp.RemainingMoveAfter >= 1 || wp.FacingCostPaid > 0;
    }

    private bool ShowChargeButton(BaronyBattleTokenDTO owner, BaronyBattleWaypointDTO wp)
    {
        if (IsAnimating || IsFacingEdit || IsChargeEdit || AllowSetupFacing || !AllowActiveOrders)
            return false;
        if (ActiveTokenId != owner.Id)
            return false;
        // One charge per unit per round.
        if (owner.ChargeBonus)
            return false;
        if (owner.LastWaypoint != wp)
            return false;
        return wp.RemainingMoveAfter >= 3;
    }

    private double FacingDegreesForToken(BaronyBattleTokenDTO token)
    {
        // Setup / deploy: facing edits apply immediately to the living token.
        if (AllowSetupFacing)
        {
            if (FacingEditTokenId == token.Id && FacingPreviewDegrees is double setupPreview)
                return setupPreview;
            return BaronyBattleFacing.ToDegrees(token.Facing);
        }

        // Movement planning: the living token keeps its current facing until resolve.
        // Planned facing is shown on the destination ghost or the in-place facing ghost.
        return BaronyBattleFacing.ToDegrees(token.Facing);
    }

    private double FacingDegreesForTip(BaronyBattleTokenDTO owner, BaronyBattleWaypointDTO wp)
    {
        if ((FacingEditTokenId == owner.Id || ChargeEditTokenId == owner.Id)
            && FacingPreviewDegrees is double preview)
            return preview;
        return BaronyBattleFacing.ToDegrees(wp.Facing);
    }

    private RenderFragment HpBar(BaronyBattleTokenDTO token) => builder =>
    {
        var max = Math.Max(1, token.MaxHp);
        var cur = Math.Clamp(token.Hp, 0, max);
        var pct = 100.0 * cur / max;
        var pctText = pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "bbm-hp-bar");
        builder.AddAttribute(2, "title", $"HP {cur}/{max}");
        builder.OpenElement(3, "div");
        builder.AddAttribute(4, "class", "bbm-hp-bar__fill");
        builder.AddAttribute(5, "style", $"width:{pctText}%");
        builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment TokenIcon(string? iconKey, string label) => builder =>
    {
        var iconPath = BattleTokenIconCatalog.PathFor(iconKey);
        if (!string.IsNullOrEmpty(iconPath))
        {
            builder.OpenElement(0, "img");
            builder.AddAttribute(1, "class", "bbm-token-icon");
            builder.AddAttribute(2, "src", "/" + iconPath);
            builder.AddAttribute(3, "alt", "");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "bbm-token-fallback");
            builder.AddContent(2, label.Length > 0 ? label[0] : '?');
            builder.CloseElement();
        }
    };

    private static List<(double cx, double cy)> PathPoints(BaronyBattleTokenDTO token)
    {
        var size = TokenSize(token);
        var list = new List<(double, double)> { CellCenter(token.X, token.Y, size) };
        foreach (var wp in token.Path)
            list.Add(CellCenter(wp.X, wp.Y, size));
        return list;
    }

    // Arrow polyline for a token: the exact tile-by-tile route when known (so diagonal
    // corner steps are drawn accurately), otherwise fall back to the waypoint anchors.
    private List<(double cx, double cy)> RouteCellsFor(BaronyBattleTokenDTO token)
    {
        var size = TokenSize(token);
        if (PlannedRoutes is not null
            && PlannedRoutes.TryGetValue(token.Id, out var cells)
            && cells.Count > 1)
            return cells.Select(c => CellCenter(c.X, c.Y, size)).ToList();

        // Baron fog: never fall back to full Path waypoints (would leak destination).
        if (FogEnemyPlans && token.IsEnemy)
            return new List<(double cx, double cy)>();

        if (token.Path.Count > 0)
            return PathPoints(token);
        return new List<(double cx, double cy)>();
    }

    /// <summary>Movement path before a charge segment (ordinary path arrows).</summary>
    private List<(double cx, double cy)> NonChargeRoutePoints(BaronyBattleTokenDTO token)
    {
        var size = TokenSize(token);
        var hasChargeSegment = token.ChargeBonus
            || token.Path.Any(w => w.IsCharge)
            || (token.ChargeOriginX is not null && token.ChargeOriginY is not null);

        // Baron fog: PlannedRoutes already carries the short reveal hint (or nothing).
        if (FogEnemyPlans && token.IsEnemy)
        {
            if (PlannedRoutes is not null
                && PlannedRoutes.TryGetValue(token.Id, out var fogCells)
                && fogCells.Count > 1)
                return fogCells.Select(c => CellCenter(c.X, c.Y, size)).ToList();
            return new List<(double cx, double cy)>();
        }

        if (!hasChargeSegment)
            return RouteCellsFor(token);

        var end = ResolveChargeOrigin(token);
        // Charge from standstill — no separate movement arrow.
        if (end.X == token.X && end.Y == token.Y)
            return new List<(double cx, double cy)>();

        if (PlannedRoutes is not null
            && PlannedRoutes.TryGetValue(token.Id, out var cells)
            && cells.Count > 1)
        {
            var endIdx = cells.FindIndex(c => c.X == end.X && c.Y == end.Y);
            if (endIdx > 0)
                return cells.Take(endIdx + 1).Select(c => CellCenter(c.X, c.Y, size)).ToList();
            // Truncated before reaching charge origin — show the whole remaining march as movement.
            return cells.Select(c => CellCenter(c.X, c.Y, size)).ToList();
        }

        var points = new List<(double cx, double cy)> { CellCenter(token.X, token.Y, size) };
        foreach (var wp in token.Path.Where(w => !w.IsCharge))
        {
            if (wp.X == token.X && wp.Y == token.Y)
                continue;
            points.Add(CellCenter(wp.X, wp.Y, size));
            if (wp.X == end.X && wp.Y == end.Y)
                break;
        }
        return points.Count > 1 ? points : new List<(double cx, double cy)>();
    }

    // Each CSS-grid cell is CellPx wide plus 1px gap, so true DOM offset = x * (CellPx + 1).
    private const int GridGap = 1;
    private static (double cx, double cy) CellCenter(int x, int y, int size)
    {
        const int step = CellPx + GridGap;
        return (x * step + size * step * 0.5 - GridGap * 0.5,
                y * step + size * step * 0.5 - GridGap * 0.5);
    }

    /// <summary>
    /// Where a token's sprite actually is right now. Mid-replay the DTO still holds the
    /// start-of-phase tile, so overlays anchored to it would drift away from the moving unit.
    /// </summary>
    private (double cx, double cy) TokenCenter(BaronyBattleTokenDTO token)
    {
        var frame = AnimatingTokens.FirstOrDefault(a => a.TokenId == token.Id);
        if (frame is null)
            return CellCenter(token.X, token.Y, TokenSize(token));

        const int step = CellPx + GridGap;
        var size = Math.Max(1, frame.Size);
        return (frame.LeftPx + size * step * 0.5 - GridGap * 0.5,
                frame.TopPx + size * step * 0.5 - GridGap * 0.5);
    }

    private static bool Covers(BaronyBattleTokenDTO token, int x, int y)
    {
        int size = TokenSize(token);
        return x >= token.X && x < token.X + size && y >= token.Y && y < token.Y + size;
    }

    private static string TokenFootprintStyle(BaronyBattleTokenDTO token)
    {
        int size = TokenSize(token);
        if (size <= 1)
            return string.Empty;
        return $"--bbm-footprint:calc(var(--bbm-cell) * {size} + {size - 1}px);";
    }

    private static string TerrainClass(BaronyBattleCellDTO? cell) => cell?.Terrain switch
    {
        BaronyBattleTerrain.Difficult => "terrain-difficult",
        BaronyBattleTerrain.Impassable => "terrain-impassable",
        BaronyBattleTerrain.Deploy => "terrain-deploy",
        _ => string.Empty
    };

    private static char ColumnLetter(int x) => (char)('A' + x);
    private static string FormatCell(int x, int y) => $"{ColumnLetter(x)}{y + 1}";

    private void OnCellMouseEnter(int x, int y) => _hoverCell = (x, y);
    private void OnMapMouseLeave() => _hoverCell = null;

    private async Task OnFacingMouseMove(MouseEventArgs e)
    {
        var editId = FacingEditTokenId ?? ChargeEditTokenId;
        if (editId is null)
            return;
        var token = Tokens.FirstOrDefault(t => t.Id == editId);
        if (token is null)
            return;

        var size = TokenSize(token);
        // Aim from the same cell the next plan segment starts from (ghost tip, else token).
        // Charge after a move must use the tip — not the real token — or cursor angles drift.
        var tip = token.LastWaypoint;
        var (cx, cy) = tip is not null
            ? CellCenter(tip.X, tip.Y, size)
            : CellCenter(token.X, token.Y, size);
        var deg = BaronyBattleFacing.DegreesToward(cx, cy, e.OffsetX, e.OffsetY);
        await OnFacingPreview.InvokeAsync(deg);
    }

    private async Task OnFacingOverlayClick(MouseEventArgs e)
    {
        // Final preview from click position, then confirm snap.
        await OnFacingMouseMove(e);
        if (IsChargeEdit)
            await OnChargeConfirm.InvokeAsync();
        else
            await OnFacingConfirm.InvokeAsync();
    }
}
