@namespace DagoniteEmpire.Pages.Barony.Components
@using DA_Common.Barony
@using DA_Models.BaronyModels

<div class="bbm-grid-root" style="--bbm-cell:@(CellPx)px;">
    <div class="bbm-scroll" @onmouseleave="OnMapMouseLeave">
        @if (_hoverCell is not null)
        {
            <div class="bbm-cursor-pos">@FormatCell(_hoverCell.Value.X, _hoverCell.Value.Y)</div>
        }
        <div class="bbm-labeled-grid" style="--row-label-width:@RowLabelWidth; grid-template-columns: @RowLabelWidth max-content;">
            <div class="bbm-corner" aria-hidden="true" style="width:@RowLabelWidth; min-width:@RowLabelWidth; max-width:@RowLabelWidth;"></div>
            <div class="bbm-col-labels" style="grid-template-columns:repeat(@Width, var(--bbm-cell));">
                @for (int x = 0; x < Width; x++)
                {
                    <span class="bbm-axis-label bbm-axis-label--col">@ColumnLetter(x)</span>
                }
            </div>
            <div class="bbm-row-labels" style="width:@RowLabelWidth; min-width:@RowLabelWidth; max-width:@RowLabelWidth;">
                @for (int y = 0; y < Height; y++)
                {
                    <div class="bbm-axis-label bbm-axis-label--row">@(y + 1)</div>
                }
            </div>
            <div class="bbm-grid-stack">
                <div class="bbm-grid" style="grid-template-columns:repeat(@Width, var(--bbm-cell));">
                    @for (int y = 0; y < Height; y++)
                    {
                        for (int x = 0; x < Width; x++)
                        {
                            var cx = x;
                            var cy = y;
                            var cell = GetCell(cx, cy);
                            var token = AnchoredTokenAt(cx, cy);
                            var waypoint = IsAnimating ? null : AnchoredWaypointAt(cx, cy);
                            var hasOccupant = GetTokenAt(cx, cy) is not null;
                            var isSelected = SelectedTokenId is not null && GetTokenAt(cx, cy)?.Id == SelectedTokenId;
                            var inRange = !IsAnimating && RangeCells.Contains((cx, cy));
                            var isActiveTurn = ActiveTokenId is not null && token?.Id == ActiveTokenId;
                            var large = token is not null && TokenSize(token) > 1;
                            var hideToken = token is not null && IsTokenAnimating(token.Id);
                            <div class="bbm-cell @(Interactive ? "interactive" : null) @(isSelected ? "selected" : null) @(isActiveTurn ? "active-order" : null) @(hasOccupant && large ? "has-large-token" : null) @TerrainClass(cell)"
                                 style="background-color:@(cell?.Color ?? "transparent")"
                                 @onclick="@(() => OnCellClick.InvokeAsync((cx, cy)))"
                                 @onmouseenter="@(() => OnCellMouseEnter(cx, cy))">
                                @if (inRange)
                                {
                                    <div class="bbm-range"></div>
                                }
                                @if (cell?.Terrain == BaronyBattleTerrain.Difficult)
                                {
                                    <div class="bbm-terrain bbm-terrain--difficult" title="Difficult">∿</div>
                                }
                                else if (cell?.Terrain == BaronyBattleTerrain.Impassable)
                                {
                                    <div class="bbm-terrain bbm-terrain--impassable" title="Impassable">✕</div>
                                }
                                else if (cell?.Terrain == BaronyBattleTerrain.Deploy && ShowDeployZone)
                                {
                                    <div class="bbm-terrain bbm-terrain--deploy" title="Deployment zone"></div>
                                }
                                @if (!string.IsNullOrWhiteSpace(cell?.Text))
                                {
                                    <span class="bbm-cell-text" style="color:@(cell!.TextColor ?? "var(--barony-ink)")">@cell.Text</span>
                                }
                                @if (token is not null && !hideToken)
                                {
                                    var facingDeg = BaronyBattleFacing.ToDegrees(token.Facing);
                                    <div class="bbm-token-slot @(large ? "large" : null) @(isActiveTurn ? "active-order" : null)" style="@TokenFootprintStyle(token)">
                                        <div class="bbm-token-rect @(token.IsEnemy ? "enemy" : "ally") @(isSelected ? "selected" : null) @(isActiveTurn ? "active-turn" : null)"
                                             style="--bbm-facing:@(facingDeg.ToString(System.Globalization.CultureInfo.InvariantCulture))deg"
                                             title="@token.Label">
                                            @TokenIcon(token.IconKey, token.Label)
                                        </div>
                                        <span class="bbm-token-label">@token.Label</span>
                                        @if (ShowMoveBadge(token))
                                        {
                                            <span class="bbm-move-badge" title="Move points">@token.Move</span>
                                        }
                                    </div>
                                    @if (IsEngagedToken(token.Id))
                                    {
                                        <span class="bbm-engage-badge" title="Engaged">
                                            <img class="bbm-engage-badge__icon" src="/icons/crossed-swords.svg" alt="" aria-hidden="true" />
                                        </span>
                                    }
                                    @if (IsAttackTarget(token.Id))
                                    {
                                        <span class="bbm-attack-target-badge" title="Attack target">
                                            <img class="bbm-attack-target-badge__icon" src="/icons/crossed-swords.svg" alt="" aria-hidden="true" />
                                        </span>
                                    }
                                }
                                @if (waypoint is not null)
                                {
                                    var (owner, wp) = waypoint.Value;
                                    var ghostLarge = TokenSize(owner) > 1;
                                    var tipFacingDeg = FacingDegreesForTip(owner, wp);
                                    var showFacingBtn = ShowFacingButton(owner, wp);
                                    <div class="bbm-token-slot bbm-token-slot--ghost @(ghostLarge ? "large" : null) @(wp.Locked ? "locked" : null)"
                                         style="@TokenFootprintStyle(owner)">
                                        <div class="bbm-token-rect bbm-token-rect--ghost @(owner.IsEnemy ? "enemy" : "ally") @(wp.Locked ? "locked" : null)"
                                             style="--bbm-facing:@(tipFacingDeg.ToString(System.Globalization.CultureInfo.InvariantCulture))deg"
                                             title="@(wp.Locked ? $"{owner.Label} (locked)" : $"{owner.Label} (destination)")">
                                            @TokenIcon(owner.IconKey, owner.Label)
                                        </div>
                                        <span class="bbm-token-label">@owner.Label</span>
                                        <span class="bbm-move-badge" title="Move left">@wp.RemainingMoveAfter</span>
                                        @if (wp.Locked)
                                        {
                                            <span class="bbm-lock-badge" title="Locked" aria-hidden="true"></span>
                                        }
                                        @if (showFacingBtn)
                                        {
                                            <button type="button"
                                                    class="bbm-facing-btn"
                                                    title="Change facing (1 move)"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="@(() => OnFacingButton.InvokeAsync(owner.Id))">
                                                <img class="bbm-facing-btn__icon" src="/icons/clockwise-rotation.svg" alt="" aria-hidden="true" />
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
                @{
                    var arrowGw = Width * (CellPx + GridGap) - GridGap;
                    var arrowGh = Height * (CellPx + GridGap) - GridGap;
                }
                <svg class="bbm-path-overlay" width="@arrowGw" height="@arrowGh" viewBox="0 0 @arrowGw @arrowGh" style="pointer-events:none" aria-hidden="true">
                    <defs>
                        <marker id="bbm-arrow-ally" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto" markerUnits="strokeWidth">
                            <path d="M0,0 L6,3 L0,6 Z" fill="rgba(47,107,79,0.55)" />
                        </marker>
                        <marker id="bbm-arrow-enemy" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto" markerUnits="strokeWidth">
                            <path d="M0,0 L6,3 L0,6 Z" fill="rgba(168,52,52,0.55)" />
                        </marker>
                    </defs>
                    @foreach (var token in Tokens)
                    {
                        var points = RouteCellsFor(token);
                        if (points.Count < 2) continue;
                        var arrowClass = token.IsEnemy ? "bbm-path-arrow bbm-path-arrow--enemy" : "bbm-path-arrow bbm-path-arrow--ally";
                        var markerId = token.IsEnemy ? "bbm-arrow-enemy" : "bbm-arrow-ally";
                        for (var i = 0; i < points.Count - 1; i++)
                        {
                            var a = points[i];
                            var b = points[i + 1];
                            var isLast = i == points.Count - 2;
                            <line class="@arrowClass"
                                  x1="@a.cx.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                  y1="@a.cy.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                  x2="@b.cx.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                  y2="@b.cy.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                  marker-end="@(isLast ? $"url(#{markerId})" : null)" />
                        }
                    }
                </svg>
                @if (ShowThreatRadius)
                {
                    var gw = Width * (CellPx + GridGap) - GridGap;
                    var gh = Height * (CellPx + GridGap) - GridGap;
                    <svg class="bbm-path-overlay bbm-threat-overlay" width="@gw" height="@gh" viewBox="0 0 @gw @gh" style="pointer-events:none" aria-hidden="true">
                        @foreach (var token in Tokens.Where(t => !IsTokenAnimating(t.Id)))
                        {
                            var ts = TokenSize(token);
                            var (cx, cy) = CellCenter(token.X, token.Y, ts);
                            var r  = ThreatFactor * ts * 0.5 * CellPx;
                            var fill   = token.IsEnemy ? "rgba(210,60,60,0.15)"  : "rgba(60,110,210,0.15)";
                            var stroke = token.IsEnemy ? "rgba(210,60,60,0.70)"  : "rgba(60,110,210,0.70)";
                            <circle cx="@cx.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    cy="@cy.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    r="@r.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    fill="@fill" stroke="@stroke" stroke-width="1.5" stroke-dasharray="4 3" />
                        }
                    </svg>
                }
                @if (IsAnimating)
                {
                    <div class="bbm-anim-layer" aria-hidden="true">
                        @foreach (var frame in AnimatingTokens)
                        {
                            var token = Tokens.FirstOrDefault(t => t.Id == frame.TokenId);
                            if (token is null) continue;
                            var size = Math.Max(1, frame.Size);
                            var facingDeg = frame.FacingDeg;
                            <div class="bbm-token-slot bbm-token-slot--anim @(AnimTransitions ? "bbm-token-slot--anim-run" : null) @(size > 1 ? "large" : null)"
                                 style="left:@(frame.LeftPx)px; top:@(frame.TopPx)px; width:@(size * CellPx)px; height:@(size * CellPx)px; transition:left @(frame.TransitionMs)ms linear,top @(frame.TransitionMs)ms linear;">
                                @if (ShowThreatRadius)
                                {
                                    var ringPx = ThreatFactor * size * CellPx;
                                    <div class="bbm-threat-ring @(token.IsEnemy ? "enemy" : "ally")"
                                         style="width:@(ringPx.ToString(System.Globalization.CultureInfo.InvariantCulture))px; height:@(ringPx.ToString(System.Globalization.CultureInfo.InvariantCulture))px;"></div>
                                }
                                <div class="bbm-token-rect @(token.IsEnemy ? "enemy" : "ally")"
                                     style="--bbm-facing:@(facingDeg.ToString(System.Globalization.CultureInfo.InvariantCulture))deg"
                                     title="@token.Label">
                                    @TokenIcon(token.IconKey, token.Label)
                                </div>
                                <span class="bbm-token-label">@token.Label</span>
                                @if (IsEngagedToken(token.Id))
                                {
                                    <span class="bbm-engage-badge" title="Engaged">
                                        <img class="bbm-engage-badge__icon" src="/icons/crossed-swords.svg" alt="" aria-hidden="true" />
                                    </span>
                                }
                            </div>
                        }
                    </div>
                }
                @if (IsFacingEdit)
                {
                    <div class="bbm-facing-overlay"
                         @onmousemove="OnFacingMouseMove"
                         @onclick="OnFacingOverlayClick"></div>
                }
            </div>
        </div>
    </div>
    <div class="bbm-legend">
        <span class="bbm-legend__item"><i class="bbm-legend__swatch bbm-legend__swatch--range"></i> Movement</span>
        <span class="bbm-legend__item"><i class="bbm-legend__swatch bbm-legend__swatch--ghost"></i> Destination</span>
        <span class="bbm-legend__item"><i class="bbm-legend__swatch bbm-legend__swatch--locked"></i> Locked</span>
        <span class="bbm-legend__item"><i class="bbm-legend__swatch bbm-legend__swatch--deploy"></i> Deploy</span>
        <span class="bbm-legend__item"><i class="bbm-legend__swatch bbm-legend__swatch--difficult"></i> Difficult ×2</span>
        <span class="bbm-legend__item"><i class="bbm-legend__swatch bbm-legend__swatch--impassable"></i> Impassable</span>
    </div>
</div>

@code {
    private const int CellPx = 64;

    [Parameter] public int Width { get; set; } = 20;
    [Parameter] public int Height { get; set; } = 16;
    [Parameter] public IReadOnlyList<BaronyBattleCellDTO> Cells { get; set; } = Array.Empty<BaronyBattleCellDTO>();
    [Parameter] public IReadOnlyList<BaronyBattleTokenDTO> Tokens { get; set; } = Array.Empty<BaronyBattleTokenDTO>();
    [Parameter] public string? SelectedTokenId { get; set; }
    [Parameter] public string? ActiveTokenId { get; set; }
    [Parameter] public HashSet<(int X, int Y)> RangeCells { get; set; } = new();
    [Parameter] public bool Interactive { get; set; } = true;
    [Parameter] public bool ShowActiveMoveBadge { get; set; }
    [Parameter] public IReadOnlyList<BattleMoveAnimFrame> AnimatingTokens { get; set; } = Array.Empty<BattleMoveAnimFrame>();
    [Parameter] public bool AnimTransitions { get; set; }
    [Parameter] public bool ShowDeployZone { get; set; } = true;
    [Parameter] public bool ShowThreatRadius { get; set; }
    [Parameter] public double ThreatFactor { get; set; } = 1.3;
    [Parameter] public IReadOnlyDictionary<string, List<(int X, int Y)>> PlannedRoutes { get; set; }
        = new Dictionary<string, List<(int X, int Y)>>();
    [Parameter] public IReadOnlySet<string> EngagedTokenIds { get; set; } = new HashSet<string>();
    [Parameter] public IReadOnlySet<string> AttackTargetIds { get; set; } = new HashSet<string>();
    [Parameter] public string? FacingEditTokenId { get; set; }
    [Parameter] public double? FacingPreviewDegrees { get; set; }
    [Parameter] public EventCallback<(int X, int Y)> OnCellClick { get; set; }
    [Parameter] public EventCallback<string> OnFacingButton { get; set; }
    [Parameter] public EventCallback<double> OnFacingPreview { get; set; }
    [Parameter] public EventCallback OnFacingConfirm { get; set; }

    private (int X, int Y)? _hoverCell;

    private string RowLabelWidth => "32px";

    private bool IsAnimating => AnimatingTokens.Count > 0;
    private bool IsFacingEdit =>
        !string.IsNullOrEmpty(FacingEditTokenId)
        && Tokens.Any(t => t.Id == FacingEditTokenId);

    private bool IsTokenAnimating(string tokenId) =>
        AnimatingTokens.Any(a => a.TokenId == tokenId);

    private bool IsEngagedToken(string tokenId) =>
        EngagedTokenIds.Contains(tokenId);

    private bool IsAttackTarget(string tokenId) =>
        AttackTargetIds.Contains(tokenId);

    private BaronyBattleCellDTO? GetCell(int x, int y) =>
        Cells.FirstOrDefault(c => c.X == x && c.Y == y);

    private static int TokenSize(BaronyBattleTokenDTO token) => Math.Clamp(token.Size <= 0 ? 1 : token.Size, 1, 3);

    private BaronyBattleTokenDTO? GetTokenAt(int x, int y) =>
        Tokens.FirstOrDefault(t => Covers(t, x, y));

    private BaronyBattleTokenDTO? AnchoredTokenAt(int x, int y) =>
        Tokens.FirstOrDefault(t => t.X == x && t.Y == y);

    private (BaronyBattleTokenDTO Owner, BaronyBattleWaypointDTO Wp)? AnchoredWaypointAt(int x, int y)
    {
        foreach (var t in Tokens)
        {
            var wp = t.Path.FirstOrDefault(w => w.X == x && w.Y == y && (w.X != t.X || w.Y != t.Y));
            if (wp is not null)
                return (t, wp);
        }
        return null;
    }

    private bool ShowMoveBadge(BaronyBattleTokenDTO token) =>
        ShowActiveMoveBadge && ActiveTokenId == token.Id;

    private bool ShowFacingButton(BaronyBattleTokenDTO owner, BaronyBattleWaypointDTO wp)
    {
        if (IsAnimating || IsFacingEdit)
            return false;
        if (ActiveTokenId != owner.Id)
            return false;
        if (owner.LastWaypoint != wp)
            return false;
        return wp.RemainingMoveAfter >= 1 || wp.FacingCostPaid > 0;
    }

    private double FacingDegreesForTip(BaronyBattleTokenDTO owner, BaronyBattleWaypointDTO wp)
    {
        if (FacingEditTokenId == owner.Id && FacingPreviewDegrees is double preview)
            return preview;
        return BaronyBattleFacing.ToDegrees(wp.Facing);
    }

    private RenderFragment TokenIcon(string? iconKey, string label) => builder =>
    {
        var iconPath = BattleTokenIconCatalog.PathFor(iconKey);
        if (!string.IsNullOrEmpty(iconPath))
        {
            builder.OpenElement(0, "img");
            builder.AddAttribute(1, "class", "bbm-token-icon");
            builder.AddAttribute(2, "src", "/" + iconPath);
            builder.AddAttribute(3, "alt", "");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "bbm-token-fallback");
            builder.AddContent(2, label.Length > 0 ? label[0] : '?');
            builder.CloseElement();
        }
    };

    private static List<(double cx, double cy)> PathPoints(BaronyBattleTokenDTO token)
    {
        var size = TokenSize(token);
        var list = new List<(double, double)> { CellCenter(token.X, token.Y, size) };
        foreach (var wp in token.Path)
            list.Add(CellCenter(wp.X, wp.Y, size));
        return list;
    }

    // Arrow polyline for a token: the exact tile-by-tile route when known (so diagonal
    // corner steps are drawn accurately), otherwise fall back to the waypoint anchors.
    private List<(double cx, double cy)> RouteCellsFor(BaronyBattleTokenDTO token)
    {
        var size = TokenSize(token);
        if (PlannedRoutes is not null
            && PlannedRoutes.TryGetValue(token.Id, out var cells)
            && cells.Count > 1)
            return cells.Select(c => CellCenter(c.X, c.Y, size)).ToList();
        if (token.Path.Count > 0)
            return PathPoints(token);
        return new List<(double cx, double cy)>();
    }

    // Each CSS-grid cell is CellPx wide plus 1px gap, so true DOM offset = x * (CellPx + 1).
    private const int GridGap = 1;
    private static (double cx, double cy) CellCenter(int x, int y, int size)
    {
        const int step = CellPx + GridGap;
        return (x * step + size * step * 0.5 - GridGap * 0.5,
                y * step + size * step * 0.5 - GridGap * 0.5);
    }

    private static bool Covers(BaronyBattleTokenDTO token, int x, int y)
    {
        int size = TokenSize(token);
        return x >= token.X && x < token.X + size && y >= token.Y && y < token.Y + size;
    }

    private static string TokenFootprintStyle(BaronyBattleTokenDTO token)
    {
        int size = TokenSize(token);
        if (size <= 1)
            return string.Empty;
        return $"--bbm-footprint:calc(var(--bbm-cell) * {size} + {size - 1}px);";
    }

    private static string TerrainClass(BaronyBattleCellDTO? cell) => cell?.Terrain switch
    {
        BaronyBattleTerrain.Difficult => "terrain-difficult",
        BaronyBattleTerrain.Impassable => "terrain-impassable",
        BaronyBattleTerrain.Deploy => "terrain-deploy",
        _ => string.Empty
    };

    private static char ColumnLetter(int x) => (char)('A' + x);
    private static string FormatCell(int x, int y) => $"{ColumnLetter(x)}{y + 1}";

    private void OnCellMouseEnter(int x, int y) => _hoverCell = (x, y);
    private void OnMapMouseLeave() => _hoverCell = null;

    private async Task OnFacingMouseMove(MouseEventArgs e)
    {
        if (FacingEditTokenId is null)
            return;
        var token = Tokens.FirstOrDefault(t => t.Id == FacingEditTokenId);
        var tip = token?.LastWaypoint;
        if (token is null || tip is null)
            return;

        var size = TokenSize(token);
        var (cx, cy) = CellCenter(tip.X, tip.Y, size);
        var deg = BaronyBattleFacing.DegreesToward(cx, cy, e.OffsetX, e.OffsetY);
        await OnFacingPreview.InvokeAsync(deg);
    }

    private async Task OnFacingOverlayClick(MouseEventArgs e)
    {
        // Final preview from click position, then confirm snap.
        await OnFacingMouseMove(e);
        await OnFacingConfirm.InvokeAsync();
    }
}
