@namespace DagoniteEmpire.Pages.Barony.Components
@inject ISnackbar _snackBar
@inject NavigationManager _nav

<BaronySection Title="@(L["Trade treaties"])" DefaultOpen="true">
    <Summary>
        <span class="projects-summary">
            <span class="projects-summary__item">@Treaties.Count treaty@(Treaties.Count == 1 ? "" : "ies")</span>
            @if (_pendingCount > 0)
            {
                <span class="projects-summary__item trade-treaty-pending-summary">@_pendingCount pending MG approval</span>
            }
            @if (_customsPerTurn > 0m)
            {
                <span class="projects-summary__item">@_customsPerTurn.ToString("0.##") gold / turn customs</span>
            }
            @if (_sweetenerPerTurn != 0m)
            {
                <span class="projects-summary__item">
                    @if (_sweetenerPerTurn > 0m)
                    {
                        <text>@_sweetenerPerTurn.ToString("0.##") gold / turn sweeteners paid</text>
                    }
                    else
                    {
                        <text>@((-_sweetenerPerTurn).ToString("0.##")) gold / turn from sweeteners</text>
                    }
                </span>
            }
        </span>
        @if (_hasTreatyPpb)
        {
            <PpbSummaryChips Vector="@_treatyPpbGlance" />
        }
    </Summary>
    <ChildContent>
        <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mb-3 d-block">
            Treaties are designed on the March map.
            @if (!CanManageAsMg)
            {
                <text> @L["New and edited treaties require MG approval before trade bonuses and goods apply."]</text>
            }
        </MudText>

        @if (CanEdit)
        {
            <div class="mb-3">
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="CreateAsync">
                    @L["New trade treaty"]
                </MudButton>
            </div>
        }

        @if (Treaties.Count == 0)
        {
            <MudText Typo="Typo.body2" Style="color:var(--barony-muted);">
                No trade treaties yet.
                @if (CanEdit)
                {
                    <text> @L["Design a route on the March map to open shared goods and route bonuses."]</text>
                }
            </MudText>
        }
        else
        {
            <div class="trade-treaties-list">
                @foreach (var treaty in Treaties)
                {
                    var lord = KnownLordsCatalog.FindByKey(treaty.CounterpartyLordKey);
                    var title = !string.IsNullOrWhiteSpace(treaty.Title)
                        ? treaty.Title
                        : lord is not null
                            ? $"Treaty with {lord.Name} {lord.House}"
                            : treaty.CounterpartyLordKey;
                    var pending = TradeTreatyApproval.IsPending(treaty);
                    var received = TradeTreatyCalculator.BaronyReceivedGoods(new[] { treaty });
                    var previewReceived = pending
                        ? TradeTreatyCalculator.BaronyReceivedGoods(new[] { PreviewAsApproved(treaty) })
                        : received;
                    <div class="trade-treaty-card barony-panel mb-3 @(pending ? "trade-treaty-card--pending" : "")">
                        <div class="d-flex flex-wrap justify-space-between align-center gap-2 mb-2">
                            <div class="d-flex flex-wrap align-center gap-2">
                                <MudText Typo="Typo.subtitle1">@title</MudText>
                                @if (pending)
                                {
                                    <MudChip T="string" Size="Size.Small" Class="trade-treaty-pending-chip">@L["Awaiting MG approval"]</MudChip>
                                }
                            </div>
                            <div class="d-flex gap-2 flex-wrap">
                                @if (CanManageAsMg && pending)
                                {
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Filled"
                                               Class="baron-influence-save-btn"
                                               OnClick="() => ApproveAsync(treaty)">
                                        @L["Approve"]
                                    </MudButton>
                                }
                                @if (CanEdit)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => EditAsync(treaty)">@L["Edit route"]</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => DeleteAsync(treaty)">@L["Delete"]</MudButton>
                                }
                            </div>
                        </div>
                        @if (lord is not null)
                        {
                            <MudText Typo="Typo.caption" Style="color:var(--barony-muted);">
                                @lord.Title · @lord.Holdings · Wealth @lord.Wealth
                            </MudText>
                        }
                        <MudText Typo="Typo.body2" Class="mt-2">
                            <strong>@L["Route economy:"]</strong>
                            @if (pending)
                            {
                                <text> +@TradeTreatyCalculator.RouteEconomyBonus(treaty).ToString("0.##") after approval</text>
                            }
                            else
                            {
                                <text> +@TradeTreatyCalculator.RouteEconomyBonus(treaty).ToString("0.##")</text>
                            }
                            <span style="color:var(--barony-muted);"> (each seat on the route: Wealth − 2)</span>
                        </MudText>
                        @if (previewReceived.Count > 0)
                        {
                            <MudText Typo="Typo.body2" Class="mt-1">
                                <strong>@L["Goods received:"]</strong>
                                @string.Join(", ", previewReceived.Select(g => g.Name))
                                @if (pending)
                                {
                                    <span style="color:var(--barony-muted);"> @L["(after approval)"]</span>
                                }
                            </MudText>
                        }
                        @foreach (var (paragraph, idx) in treaty.Paragraphs.Select((p, i) => (p, i)))
                        {
                            var addressee = KnownLordsCatalog.FindByKey(paragraph.LordKey);
                            <div class="trade-treaty-paragraph mt-2">
                                <MudText Typo="Typo.caption">
                                    <strong>@(idx + 1). @TradeTreatyParagraphLabels.AddresseeHeading(paragraph)</strong>
                                </MudText>
                                @if (!paragraph.IsDestination)
                                {
                                    <MudText Typo="Typo.body2">Customs: @paragraph.CustomsGoldPerTurn.ToString("0.##") gold/turn</MudText>
                                }
                                @if (TradeTreatyParagraphLabels.SweetenerLabel(paragraph) is { } sweetener)
                                {
                                    <MudText Typo="Typo.body2">@sweetener</MudText>
                                }
                                @if (paragraph.BaronyGrantsGoodKeys.Count > 0)
                                {
                                    <MudText Typo="Typo.body2">Barony grants to @(addressee?.Name ?? "lord"): @FormatGoods(paragraph.BaronyGrantsGoodKeys)</MudText>
                                }
                                @if (paragraph.CounterpartyGrantsGoodKeys.Count > 0)
                                {
                                    <MudText Typo="Typo.body2">@(addressee?.Name ?? "Lord") grants: @FormatGoods(paragraph.CounterpartyGrantsGoodKeys)</MudText>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <TradeTreatyBonusSummary Treaties="@_approvedTreaties" />
        }
    </ChildContent>
</BaronySection>

@code {
    [Parameter] public int BaronyId { get; set; }
    [Parameter] public IReadOnlyList<BaronyTradeTreaty> Treaties { get; set; } = Array.Empty<BaronyTradeTreaty>();
    [Parameter] public IReadOnlyCollection<string> BaronyAvailableGoodKeys { get; set; } = Array.Empty<string>();
    [Parameter] public IReadOnlyCollection<string> BorderLordKeys { get; set; } = Array.Empty<string>();
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanManageAsMg { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<BaronyTradeTreaty>> TreatiesChanged { get; set; }

    private IReadOnlyList<BaronyTradeTreaty> _approvedTreaties =>
        TradeTreatyApproval.EffectivelyApproved(Treaties).ToList();

    private int _pendingCount => Treaties.Count(TradeTreatyApproval.IsPending);

    private decimal _customsPerTurn => TradeTreatyCalculator.TotalCustomsGoldPerTurn(_approvedTreaties);
    private decimal _sweetenerPerTurn => TradeTreatyCalculator.TotalSweetenerGoldPerTurn(_approvedTreaties);

    private PpbVector _treatyPpbGlance
    {
        get
        {
            TradeTreatyCalculator.SumTreatyBonuses(_approvedTreaties, out var add, out _);
            return add;
        }
    }

    private bool _hasTreatyPpb =>
        PpbCatalog.All.Any(info => _treatyPpbGlance[info.Key] != 0m);

    private static string FormatGoods(IEnumerable<string> keys) =>
        string.Join(", ", keys.Select(k => TradeGoodsCatalog.Find(k)?.Name ?? k));

    private static BaronyTradeTreaty PreviewAsApproved(BaronyTradeTreaty treaty) => new()
    {
        Id = treaty.Id,
        CounterpartyLordKey = treaty.CounterpartyLordKey,
        Title = treaty.Title,
        IsApproved = true,
        Paragraphs = treaty.Paragraphs,
    };

    private void CreateAsync() => _nav.NavigateTo("/barony/march-map?design=1");

    private void EditAsync(BaronyTradeTreaty treaty) =>
        _nav.NavigateTo($"/barony/march-map?treaty={Uri.EscapeDataString(treaty.Id)}");

    private async Task ApproveAsync(BaronyTradeTreaty treaty)
    {
        if (!CanManageAsMg || !TradeTreatyApproval.IsPending(treaty))
            return;

        var list = Treaties.ToList();
        var idx = list.FindIndex(t => string.Equals(t.Id, treaty.Id, StringComparison.OrdinalIgnoreCase));
        if (idx < 0)
            return;

        list[idx].IsApproved = true;
        await TreatiesChanged.InvokeAsync(list);
        _snackBar.Add(L["Trade treaty approved."], Severity.Success);
    }

    private async Task DeleteAsync(BaronyTradeTreaty treaty)
    {
        var list = Treaties.Where(t => !string.Equals(t.Id, treaty.Id, StringComparison.OrdinalIgnoreCase)).ToList();
        await TreatiesChanged.InvokeAsync(list);
        _snackBar.Add(L["Trade treaty removed."], Severity.Info);
    }
}
