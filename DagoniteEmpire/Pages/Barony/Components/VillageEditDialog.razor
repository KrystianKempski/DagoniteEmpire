@namespace DagoniteEmpire.Pages.Barony.Components
@inject ISnackbar _snackBar

<MudDialog Class="baron-influence-dialog"
           ContentClass="baron-influence-dialog-content"
           ActionsClass="baron-influence-dialog-actions">
    <TitleContent>
        <MudText Typo="Typo.h6">Edytuj wioskę</MudText>
    </TitleContent>
    <DialogContent>
        <div class="barony-dialog-theme baron-influence-edit-dialog">
            <MudTextField @bind-Value="_name"
                          Label="Nazwa"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Required="true"
                          Class="baron-influence-field" />
            <MudNumericField T="int"
                             @bind-Value="_population"
                             Label="Populacja (Pop)"
                             HelperText="PPB wioski jest obliczane z Populacji, żyzności pola i palisady."
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Min="0"
                             Class="baron-influence-field" />
            <MudCheckBox T="bool"
                         @bind-Value="_hasPalisade"
                         Label="Palisada (+5 Obrona, +3 Stabilność, +1 Prawo)"
                         Color="Color.Primary"
                         Dense="true"
                         Class="baron-influence-field" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">Anuluj</MudButton>
        <MudButton Class="baron-influence-save-btn" Variant="Variant.Filled" OnClick="Save">Zapisz</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public TerrainImprovementDTO Improvement { get; set; } = new();

    private string _name = string.Empty;
    private int _population;
    private bool _hasPalisade;

    protected override void OnInitialized()
    {
        _name = BaronyCalc.ImprovementDisplayLabel(Improvement);
        _population = Math.Max(0, Improvement.Population);
        _hasPalisade = Improvement.HasPalisade;
    }

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            _snackBar.Add("Nazwa jest wymagana.", Severity.Warning);
            return;
        }

        Improvement.Description = _name.Trim();
        Improvement.Population = Math.Max(0, _population);
        Improvement.HasPalisade = _hasPalisade;
        Improvement.FormulaText = VillagePpbFormulas.CatalogDescription;
        MudDialog.Close(DialogResult.Ok(Improvement));
    }
}
