@namespace DagoniteEmpire.Pages.Barony.Components

<MudDialog Class="baron-influence-dialog"
           ContentClass="baron-influence-dialog-content"
           ActionsClass="baron-influence-dialog-actions">
    <DialogContent>
        <div class="barony-dialog-theme baron-influence-edit-dialog">
            <MudText Typo="Typo.body2" Class="mb-2" Style="color:var(--barony-muted);">
                Niepokój społeczny (0–@UnrestPpbFormulas.Max). Zasila kary społeczności dla Lojalności,
                Stabilności, Prawa, Ekonomii i Produkcji. Rośnie przy nieudanych testach lojalności, gdy Stabilność ≤ 0.
            </MudText>
            <MudNumericField @bind-Value="_unrest"
                             Label="Niepokój"
                             HelperText="@($"0 do {UnrestPpbFormulas.Max}")"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Min="0"
                             Max="@UnrestPpbFormulas.Max"
                             Immediate="true"
                             Class="baron-influence-field" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">Anuluj</MudButton>
        <MudButton Class="baron-influence-save-btn" Variant="Variant.Filled" OnClick="Save">Zapisz</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public int Unrest { get; set; }

    private int _unrest;

    protected override void OnInitialized()
    {
        _unrest = UnrestPpbFormulas.Clamp(Unrest);
    }

    private void Cancel() => MudDialog.Cancel();

    private void Save() =>
        MudDialog.Close(DialogResult.Ok(UnrestPpbFormulas.Clamp(_unrest)));
}
