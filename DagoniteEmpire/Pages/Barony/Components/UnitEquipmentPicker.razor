@namespace DagoniteEmpire.Pages.Barony.Components
@using DA_Business.Repository.BaronyRepos
@using DA_Common.Barony
@using DA_Models.BaronyModels
@inject ISnackbar _snackBar

@* Excel-style weapon / armor catalog: weapons left, armor+shields right. *@
<div class="unit-equip-catalog">
    <div class="unit-equip-catalog__intro">
        <h3 class="unit-workshop__heading">Katalog broni i pancerza</h3>
        <MudText Typo="Typo.caption" Style="color:var(--barony-muted);">
            Wybierz <b>W1</b> / <b>W2</b> w wierszu broni (po lewej), pancerz lub tarczę po prawej.
            Wyszarzone wiersze wymagają więcej Budowy, Zwinności, umiejętności Pancerza lub Jazdy konnej, albo brakuje dostępu handlowego do broni wojskowej / prochu / poziomów pancerza / koni.
            Naprowadź na nagłówki kolumn, aby zobaczyć notatki. Koszty:
            <BaronyResourceIcon Resource="Ppb.Production" Size="xs" /> produkcja ·
            <BaronyResourceIcon Resource="Ppb.Treasury" Size="xs" /> złoto ·
            <b>Mkt</b> rynek (×2 =
            <BaronyResourceIcon Resource="Ppb.Defense" Size="xs" /> cena).
        </MudText>
    </div>

    <div class="unit-equip-catalog__split">
        <section class="unit-equip-tile">
            <div class="unit-equip-tile__title">Broń</div>
            <div class="unit-equip-tile__scroll">
                <table class="ppb-table ppb-table--source ppb-table--lined unit-equip-table">
                    <thead>
                        <tr>
                            <th class="unit-equip-table__pick">
                                <BaronyTooltip Title="Broń 1" Text="Wybierz jako broń podstawową." Placement="Placement.Top">
                                    <span>W1</span>
                                </BaronyTooltip>
                            </th>
                            <th class="unit-equip-table__pick">
                                <BaronyTooltip Title="Broń 2" Text="Wybierz jako broń drugorzędną (kliknij ponownie, aby wyczyścić)." Placement="Placement.Top">
                                    <span>W2</span>
                                </BaronyTooltip>
                            </th>
                            <th class="ppb-row-label">Nazwa</th>
                            <th>Typ</th>
                            @ColHeader("Atk", "Atak", "Premia do ataku broni dodawana do sumy Ataku.")
                            @ColHeader("Dmg", "Obrażenia", "Premia do obrażeń broni.")
                            @ColHeader("Def", "Obrona", "Premia do obrony broni dodawana, gdy ta broń wpływa na Obronę.")
                            @ColHeader("Prc", "Przebicie", "Przebicie pancerza.")
                            @ColHeader("Rng", "Zasięg", "Zasięg strzału bez kary; −4 przy podwójnym zasięgu, −8 przy potrójnym.")
                            @ColHeader("Mov", "Ruch", "Kara do ruchu od tej broni.")
                            @ColHeader("1H", "Jednoręczna", "Broń jest jednoręczna.")
                            @ColHeader("Bld", "Wymagana Budowa", "Minimalna wymagana Budowa.")
                            @ColHeader("Agi", "Wymagana Zwinność", "Minimalna wymagana Zwinność.")
                            @ResColHeader(Ppb.Production, "Produkcja", "Koszt produkcji tej broni dla jednego oddziału (50 ludzi), gdy dostępne są towary strategiczne.")
                            @ResColHeader(Ppb.Treasury, "Złoto", "Koszt w złocie dla jednego oddziału (50 ludzi).")
                            @ColHeader("Mkt", "Złoto rynkowe", "Złoto rynkowe. W wierszu Sprzęt wybierz Kup, aby zapłacić Mkt w złocie (bez Produkcji), lub Obronę, aby zapłacić 2×Mkt jako Obronę.")
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in new[] { "simple", "military", "powder" })
                        {
                            <tr class="unit-equip-table__group">
                                <td colspan="16">@UnitWeaponCatalog.CategoryLabel(cat)</td>
                            </tr>
                            @foreach (var w in UnitWeaponCatalog.ByCategory(cat))
                            {
                                var isW1 = Weapon1Key == w.Key;
                                var isW2 = Weapon2Key == w.Key;
                                var ok = MeetsWeapon(w, out var why);
                                <tr class="@RowClass(isW1 || isW2, ok)">
                                    <td class="unit-equip-table__pick">
                                        <BaronyTooltip Text="@(ok ? "Wybierz jako broń 1" : why)">
                                            <button type="button"
                                                    class="unit-equip-pick @(isW1 ? "unit-equip-pick--on" : null)"
                                                    disabled="@(!CanEdit)"
                                                    @onclick="@(() => SelectWeapon1(w))">@(isW1 ? "●" : "○")</button>
                                        </BaronyTooltip>
                                    </td>
                                    <td class="unit-equip-table__pick">
                                        <BaronyTooltip Text="@(ok ? "Wybierz jako broń 2 (kliknij ponownie, aby wyczyścić)" : why)">
                                            <button type="button"
                                                    class="unit-equip-pick @(isW2 ? "unit-equip-pick--on" : null)"
                                                    disabled="@(!CanEdit)"
                                                    @onclick="@(() => ToggleWeapon2(w))">@(isW2 ? "●" : "○")</button>
                                        </BaronyTooltip>
                                    </td>
                                    <td class="ppb-row-label">@w.Name</td>
                                    <td>@w.WeaponType</td>
                                    <td>@w.Attack</td>
                                    <td>@w.Damage</td>
                                    <td>@w.Defense</td>
                                    <td>@w.Pierce</td>
                                    <td>@(w.Range == 0 ? "—" : w.Range.ToString())</td>
                                    <td>@(w.MovePenalty == 0 ? "—" : w.MovePenalty.ToString())</td>
                                    <td>@(w.OneHanded ? "tak" : "nie")</td>
                                    <td class="@(Build < w.RequiredBuild ? "unit-equip-table__req--fail" : null)">@w.RequiredBuild</td>
                                    <td class="@(Agility < w.RequiredAgility ? "unit-equip-table__req--fail" : null)">@w.RequiredAgility</td>
                                    <td>@w.ProductionCost</td>
                                    <td>@w.GoldCost</td>
                                    <td>@w.MarketGold</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="unit-equip-tile">
            <div class="unit-equip-tile__title">Pancerz i tarcze</div>
            <div class="unit-equip-tile__scroll">
                <table class="ppb-table ppb-table--source ppb-table--lined unit-equip-table">
                    <thead>
                        <tr>
                            <th class="unit-equip-table__pick">
                                <BaronyTooltip Title="Wybierz" Text="Wybierz pancerz lub tarczę (kliknij ponownie, aby wyczyścić)." Placement="Placement.Top">
                                    <span>Wybór</span>
                                </BaronyTooltip>
                            </th>
                            <th class="ppb-row-label">Nazwa</th>
                            <th>Typ</th>
                            @ColHeader("Def", "Obrona", "Premia do obrony od tego pancerza lub tarczy.")
                            @ColHeader("Arm", "Pancerz", "Wartość pancerza tylko z pancerza właściwego — tarcze nie dodają Pancerza. Zmniejsza otrzymywane obrażenia.")
                            @ColHeader("Pen", "Kara do Zwinności", "Kara nakładana na atrybut Zwinności.")
                            @ColHeader("Mov", "Ruch", "Kara do ruchu.")
                            @ColHeader("Bld", "Wymagana Budowa", "Minimalna wymagana Budowa.")
                            @ColHeader("Ask", "Wymagana umiej. pancerza", "Minimalna wymagana umiejętność Pancerza.")
                            @ResColHeader(Ppb.Production, "Produkcja", "Koszt produkcji dla jednego oddziału (50 ludzi), gdy dostępne są towary strategiczne.")
                            @ResColHeader(Ppb.Treasury, "Złoto", "Koszt w złocie dla jednego oddziału (50 ludzi).")
                            @ColHeader("Mkt", "Złoto rynkowe", "Złoto rynkowe. W wierszu Sprzęt wybierz Kup, aby zapłacić Mkt w złocie (bez Produkcji), lub Obronę, aby zapłacić 2×Mkt jako Obronę.")
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (title, keys) in UnitArmorCatalog.ExcelTiers)
                        {
                            var items = UnitArmorCatalog.TierItems(keys).ToList();
                            var shields = items.Where(x => x.IsShield).ToList();
                            var bodies = items.Where(x => !x.IsShield).ToList();
                            <tr class="unit-equip-table__group">
                                <td colspan="12">@title</td>
                            </tr>
                            @if (shields.Count > 0)
                            {
                                <tr class="unit-equip-table__subgroup"><td colspan="12">Tarcze</td></tr>
                                @foreach (var a in shields)
                                {
                                    @ArmorRow(a)
                                }
                            }
                            @if (bodies.Count > 0)
                            {
                                <tr class="unit-equip-table__subgroup"><td colspan="12">Zbroja</td></tr>
                                @foreach (var a in bodies)
                                {
                                    @ArmorRow(a)
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <section class="unit-equip-tile unit-equip-tile--mounts">
        <div class="unit-equip-tile__title">Wierzchowce</div>
        <div class="unit-equip-tile__scroll">
            <table class="ppb-table ppb-table--source ppb-table--lined unit-equip-table">
                <thead>
                    <tr>
                        <th class="unit-equip-table__pick">
                            <BaronyTooltip Title="Wybierz" Text="Wybierz wierzchowca (kliknij ponownie, aby wyczyścić)." Placement="Placement.Top">
                                <span>Wybór</span>
                            </BaronyTooltip>
                        </th>
                        <th class="ppb-row-label">Nazwa</th>
                        @ColHeader("Atk", "Atak", "Premia do ataku od tego wierzchowca.")
                        @ColHeader("Def", "Obrona", "Premia do obrony od tego wierzchowca.")
                        @ColHeader("Dmg", "Obrażenia", "Premia do obrażeń od tego wierzchowca.")
                        @ColHeader("Mov", "Ruch", "Premia do ruchu od tego wierzchowca.")
                        @ColHeader("Rid", "Wymagana Jazda konna", "Minimalna wymagana suma umiejętności Jazdy konnej.")
                        @ResColHeader(Ppb.Production, "Produkcja", "Koszt produkcji dla jednego oddziału (50 ludzi), gdy dostępne są konie.")
                        @ResColHeader(Ppb.Treasury, "Złoto", "Koszt w złocie dla jednego oddziału (50 ludzi).")
                        @ColHeader("Mkt", "Złoto rynkowe", "Złoto rynkowe. Kup = Mkt złota; Obrona = 2×Mkt Obrony.")
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in UnitMountCatalog.All)
                    {
                        var ok = MeetsMount(m, out var why);
                        var selected = MountKey == m.Key;
                        <tr class="@RowClass(selected, ok)">
                            <td class="unit-equip-table__pick">
                                <BaronyTooltip Text="@(ok ? "Wybierz wierzchowca (kliknij ponownie, aby wyczyścić)" : why)">
                                    <button type="button"
                                            class="unit-equip-pick @(selected ? "unit-equip-pick--on" : null)"
                                            disabled="@(!CanEdit)"
                                            @onclick="@(() => PickMount(m))">@(selected ? "●" : "○")</button>
                                </BaronyTooltip>
                            </td>
                            <td class="ppb-row-label">@m.Name</td>
                            <td>@m.Attack</td>
                            <td>@m.Defense</td>
                            <td>@m.Damage</td>
                            <td>@FormatSigned(m.MoveBonus)</td>
                            <td class="@(RidingSkillTotal < m.RequiredRiding ? "unit-equip-table__req--fail" : null)">@m.RequiredRiding</td>
                            <td>@m.ProductionCost</td>
                            <td>@m.GoldCost</td>
                            <td>@m.MarketGold</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@code {
    [Parameter] public BaronyUnitDTO? Unit { get; set; }
    [Parameter] public string? Weapon1Key { get; set; }
    [Parameter] public string? Weapon2Key { get; set; }
    [Parameter] public string? ArmorKey { get; set; }
    [Parameter] public string? ShieldKey { get; set; }
    [Parameter] public string? MountKey { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    /// <summary>When set, military / powder / armor tiers / mounts require matching trade-good access.</summary>
    [Parameter] public TradeGoodAvailabilitySnapshot? Availability { get; set; }
    [Parameter] public EventCallback<string> Weapon1Changed { get; set; }
    [Parameter] public EventCallback<string?> Weapon2Changed { get; set; }
    [Parameter] public EventCallback<string?> ArmorChanged { get; set; }
    [Parameter] public EventCallback<string?> ShieldChanged { get; set; }
    [Parameter] public EventCallback<string?> MountChanged { get; set; }

    private int Build => Unit?.EffectiveBuild ?? 0;
    private int Agility => Unit?.EffectiveAgility ?? 0;
    private int ArmorSkillTotal
    {
        get
        {
            if (Unit is null) return 0;
            var totals = UnitStatHelper.BuildSkillTotals(Unit);
            return totals.GetValueOrDefault(UnitSkillKey.ArmorSkill);
        }
    }
    private int RidingSkillTotal
    {
        get
        {
            if (Unit is null) return 0;
            var totals = UnitStatHelper.BuildSkillTotals(Unit);
            return totals.GetValueOrDefault(UnitSkillKey.Riding);
        }
    }

    private bool MeetsWeapon(UnitWeaponDef w, out string reason) =>
        UnitEquipmentTradeAccess.MeetsWeapon(w, Build, Agility, Availability, out reason);

    private bool MeetsArmor(UnitArmorDef a, out string reason) =>
        UnitEquipmentTradeAccess.MeetsArmor(a, Build, ArmorSkillTotal, Availability, out reason);

    private bool MeetsMount(UnitMountDef m, out string reason) =>
        UnitEquipmentTradeAccess.MeetsMount(m, RidingSkillTotal, Availability, out reason);

    private static string? RowClass(bool selected, bool ok)
    {
        if (selected && ok) return "unit-equip-table__row--active";
        if (selected && !ok) return "unit-equip-table__row--active unit-equip-table__row--locked";
        if (!ok) return "unit-equip-table__row--locked";
        return null;
    }

    private async Task SelectWeapon1(UnitWeaponDef w)
    {
        if (!CanEdit) return;
        if (!MeetsWeapon(w, out var reason))
        {
            _snackBar.Add(reason, Severity.Info);
            return;
        }
        if (Weapon2Key == w.Key)
            await Weapon2Changed.InvokeAsync(null);
        await Weapon1Changed.InvokeAsync(w.Key);
    }

    private async Task ToggleWeapon2(UnitWeaponDef w)
    {
        if (!CanEdit) return;
        if (Weapon1Key == w.Key) return;
        // Allow clearing even if requirements are no longer met.
        if (Weapon2Key == w.Key)
        {
            await Weapon2Changed.InvokeAsync(null);
            return;
        }
        if (!MeetsWeapon(w, out var reason))
        {
            _snackBar.Add(reason, Severity.Info);
            return;
        }
        await Weapon2Changed.InvokeAsync(w.Key);
    }

    private async Task PickArmor(UnitArmorDef a)
    {
        if (!CanEdit) return;
        var selected = a.IsShield ? ShieldKey == a.Key : ArmorKey == a.Key;
        if (selected)
        {
            if (a.IsShield)
                await ShieldChanged.InvokeAsync(null);
            else
                await ArmorChanged.InvokeAsync(null);
            return;
        }
        if (!MeetsArmor(a, out var reason))
        {
            _snackBar.Add(reason, Severity.Info);
            return;
        }
        if (a.IsShield)
            await ShieldChanged.InvokeAsync(a.Key);
        else
            await ArmorChanged.InvokeAsync(a.Key);
    }

    private async Task PickMount(UnitMountDef m)
    {
        if (!CanEdit) return;
        if (MountKey == m.Key)
        {
            await MountChanged.InvokeAsync(null);
            return;
        }
        if (!MeetsMount(m, out var reason))
        {
            _snackBar.Add(reason, Severity.Info);
            return;
        }
        await MountChanged.InvokeAsync(m.Key);
    }

    private static string FormatSigned(int v) => v > 0 ? $"+{v}" : v.ToString();

    private RenderFragment ColHeader(string label, string title, string text) => __builder =>
    {
        <th>
            <BaronyTooltip Title="@title" Text="@text">
                <span class="unit-equip-table__th">@label</span>
            </BaronyTooltip>
        </th>
    };

    private RenderFragment ResColHeader(Ppb resource, string title, string text) => __builder =>
    {
        <th>
            <BaronyTooltip Title="@title" Text="@text">
                <span class="unit-equip-table__th unit-equip-table__th-res">
                    <BaronyResourceIcon Resource="@resource" Size="xs" />
                </span>
            </BaronyTooltip>
        </th>
    };

    private RenderFragment ArmorRow(UnitArmorDef a) => __builder =>
    {
        var selected = a.IsShield ? ShieldKey == a.Key : ArmorKey == a.Key;
        var ok = MeetsArmor(a, out var why);
        <tr class="@RowClass(selected, ok)">
            <td class="unit-equip-table__pick">
                <BaronyTooltip Text="@(ok ? (a.IsShield ? "Wybierz tarczę (kliknij ponownie, aby wyczyścić)" : "Wybierz pancerz (kliknij ponownie, aby wyczyścić)") : why)">
                    <button type="button"
                            class="unit-equip-pick @(selected ? "unit-equip-pick--on" : null)"
                            disabled="@(!CanEdit)"
                            @onclick="@(() => PickArmor(a))">@(selected ? "●" : "○")</button>
                </BaronyTooltip>
            </td>
            <td class="ppb-row-label">@a.Name</td>
            <td>@(a.IsShield ? "Tarcze" : a.ArmorClass)</td>
            <td>@a.Defense</td>
            <td>@(a.IsShield ? "—" : a.ArmorValue.ToString())</td>
            <td>@(a.AgilityPenalty == 0 ? "—" : a.AgilityPenalty.ToString())</td>
            <td>@(a.MovePenalty == 0 ? "—" : a.MovePenalty.ToString())</td>
            <td class="@(Build < a.RequiredBuild ? "unit-equip-table__req--fail" : null)">@a.RequiredBuild</td>
            <td class="@(ArmorSkillTotal < a.RequiredArmorSkill ? "unit-equip-table__req--fail" : null)">@a.RequiredArmorSkill</td>
            <td>@a.ProductionCost</td>
            <td>@a.GoldCost</td>
            <td>@a.MarketGold</td>
        </tr>
    };
}
