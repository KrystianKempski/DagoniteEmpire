@namespace DagoniteEmpire.Pages.Barony.Components
@inject ISnackbar _snackBar

<MudDialog Class="baron-influence-dialog"
           ContentClass="baron-influence-dialog-content"
           ActionsClass="baron-influence-dialog-actions">
    <DialogContent>
        <div class="barony-dialog-theme baron-influence-edit-dialog city-building-edit-dialog">
            <MudTextField @bind-Value="_name"
                          Label="Nazwa"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Required="true"
                          Class="baron-influence-field" />
            <MudTextField @bind-Value="_description"
                          Label="Opis"
                          HelperText="Opcjonalny opis wyświetlany po najechaniu na nazwę."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="2"
                          Class="baron-influence-field" />
            <MudNumericField T="decimal"
                             @bind-Value="_amount"
                             Label="Kwota złota"
                             HelperText="Dodatnia = dochód, ujemna = wydatek."
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             HideSpinButtons="true"
                             Format="0.#"
                             Class="baron-influence-field" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">Anuluj</MudButton>
        <MudButton Class="baron-influence-save-btn" Variant="Variant.Filled" OnClick="Save">Zapisz</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public BaronPurseSourceDTO Source { get; set; } = new();

    private string _name = string.Empty;
    private string? _description;
    private decimal _amount;

    protected override void OnInitialized()
    {
        _name = Source.Name;
        _description = Source.Description;
        _amount = Source.Amount;
    }

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            _snackBar.Add("Nazwa jest wymagana.", Severity.Warning);
            return;
        }

        Source.Name = _name.Trim();
        Source.Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim();
        Source.Amount = PpbFormat.Round(_amount);
        MudDialog.Close(DialogResult.Ok(Source));
    }
}
