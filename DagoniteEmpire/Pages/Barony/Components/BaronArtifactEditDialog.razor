@namespace DagoniteEmpire.Pages.Barony.Components
@inject ISnackbar _snackBar

<MudDialog Class="baron-influence-dialog"
           ContentClass="baron-influence-dialog-content"
           ActionsClass="baron-influence-dialog-actions">
    <DialogContent>
        <div class="barony-dialog-theme baron-influence-edit-dialog">
            @if (LocationOnly)
            {
                <MudText Typo="Typo.subtitle2" Class="mb-2">@_name</MudText>
                <MudText Typo="Typo.caption" Class="mb-2" Style="color:var(--barony-muted);">
                    @L["Choose a Lord's Seat chamber for this item. Domain PPB applies only while it is placed."]
                </MudText>
            }
            else
            {
                <MudTextField @bind-Value="_name"
                              Label="@(L["Name"])"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="baron-influence-field"
                              Required="true" />

                <MudSelect T="string"
                           @bind-Value="_kind"
                           Label="@(L["Type"])"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="baron-influence-field"
                           Dense="true">
                    @foreach (var kind in BaronArtifactKind.All)
                    {
                        <MudSelectItem Value="@kind">@L[kind]</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="string"
                           @bind-Value="_origin"
                           Label="@(L["Source"])"
                           HelperText="@(L["How the item was obtained"])"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="baron-influence-field"
                           Dense="true">
                    @foreach (var origin in BaronArtifactOrigin.All)
                    {
                        <MudSelectItem Value="@origin">@L[origin]</MudSelectItem>
                    }
                </MudSelect>

                <div class="baron-php-edit-fields">
                    <MudNumericField @bind-Value="_prestige"
                                     Label="@(L["Prestige"])"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Class="baron-influence-field php-field php-field--prestige" />
                    <MudNumericField @bind-Value="_honor"
                                     Label="@(L["Honor"])"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Class="baron-influence-field php-field php-field--honor" />
                    <MudNumericField @bind-Value="_fear"
                                     Label="@(L["Fear"])"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Class="baron-influence-field php-field php-field--fear" />
                </div>

                <MudText Typo="Typo.caption" Class="mt-1 mb-1" Style="color:var(--barony-muted);">
                    @L["Domain PPB applies only while the item is placed in a Lord's Seat chamber."]
                </MudText>
                <PpbVectorEditor @bind-Value="_additive" Title="@(L["PPB additive (+)"])" Compact="true" />
                <PpbVectorEditor @bind-Value="_percent" Title="@(L["PPB percent (%)"])" Compact="true" Percent="true" />
            }

            <MudSelect T="int?"
                       Value="_seatRoomId"
                       ValueChanged="OnRoomChanged"
                       Label="@(L["Location"])"
                       HelperText="@_roomHelper"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Class="baron-influence-field"
                       Dense="true"
                       Clearable="true">
                @foreach (var room in _rooms)
                {
                    <MudSelectItem T="int?" Value="@room.Id">@RoomOptionLabel(room)</MudSelectItem>
                }
            </MudSelect>

            @if (_selectedRoom is not null)
            {
                <MudText Typo="Typo.caption" Class="mt-1" Style="color:var(--barony-muted);">
                    @L["Chamber bonus: ×{0}", _selectedRoom.PrestigeMultiplier.ToString("0.##")]
                    · @L["Capacity: {0} / {1}", _capacityUsed, BaronArtifactCapacity.LimitLabel(_selectedRoom.SizeCategory)]
                    (@SeatRoomSizeCategory.DisplayName(_selectedRoom.SizeCategory, L))
                </MudText>
            }

            @if (!LocationOnly)
            {
                <MudTextField @bind-Value="_description"
                              Label="@(L["Description"])"
                              HelperText="@(L["Optional. Shown on hover over the name in the table."])"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Lines="3"
                              Class="baron-influence-field" />
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Class="baron-influence-save-btn" Variant="Variant.Filled" OnClick="Save">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public BaronArtifactDTO Artifact { get; set; } = new();
    [Parameter] public BaronySeatDTO? Seat { get; set; }
    [Parameter] public List<BaronArtifactDTO> ExistingArtifacts { get; set; } = new();
    /// <summary>When true, only chamber location can be changed (baron placement).</summary>
    [Parameter] public bool LocationOnly { get; set; }

    private string _name = string.Empty;
    private string _kind = BaronArtifactKind.Other;
    private string _origin = BaronArtifactOrigin.Acquired;
    private int _prestige;
    private int _honor;
    private int _fear;
    private PpbVector _additive = new();
    private PpbVector _percent = new();
    private int? _seatRoomId;
    private string? _description;
    private List<SeatRoomDTO> _rooms = new();
    private string _roomHelper =>
        L["Chamber where the item is displayed (applies prestige multiplier and activates domain PPB)."].Value;

    private SeatRoomDTO? _selectedRoom =>
        _seatRoomId is int id ? _rooms.FirstOrDefault(r => r.Id == id) : null;

    private int _capacityUsed =>
        _selectedRoom is null
            ? 0
            : BaronyCalc.ArtifactCountInRoom(
                ExistingArtifacts,
                _selectedRoom.Id,
                Artifact.Id > 0 ? Artifact.Id : null)
              + 1;

    protected override void OnInitialized()
    {
        _name = Artifact.Name;
        _kind = string.IsNullOrWhiteSpace(Artifact.Kind) ? BaronArtifactKind.Other : Artifact.Kind;
        _origin = string.IsNullOrWhiteSpace(Artifact.Origin) ? BaronArtifactOrigin.Acquired : Artifact.Origin;
        _prestige = Artifact.Prestige;
        _honor = Artifact.Honor;
        _fear = Artifact.Fear;
        _additive = Artifact.Additive?.Clone() ?? new PpbVector();
        _percent = Artifact.Percent?.Clone() ?? new PpbVector();
        _seatRoomId = Artifact.SeatRoomId;
        _description = Artifact.Description;
        _rooms = (Seat?.Rooms ?? new())
            .Where(r => !r.IsRuin)
            .OrderBy(r => r.SortOrder)
            .ThenBy(r => r.Name)
            .ToList();
    }

    private Task OnRoomChanged(int? roomId)
    {
        _seatRoomId = roomId;
        return Task.CompletedTask;
    }

    private string RoomOptionLabel(SeatRoomDTO room)
    {
        var used = BaronyCalc.ArtifactCountInRoom(
            ExistingArtifacts,
            room.Id,
            Artifact.Id > 0 ? Artifact.Id : null);
        var limit = BaronArtifactCapacity.LimitLabel(room.SizeCategory);
        var name = string.IsNullOrWhiteSpace(room.Name) ? $"Room #{room.Id}" : room.Name;
        return $"{name} (×{room.PrestigeMultiplier:0.##}, {used}/{limit})";
    }

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        if (LocationOnly)
        {
            if (_seatRoomId is int roomId)
            {
                var room = _rooms.FirstOrDefault(r => r.Id == roomId);
                var capacityError = BaronyCalc.ArtifactCapacityError(
                    room,
                    ExistingArtifacts,
                    Artifact.Id > 0 ? Artifact.Id : null);
                if (capacityError is not null)
                {
                    _snackBar.Add(capacityError, Severity.Warning);
                    return;
                }
            }

            Artifact.SeatRoomId = _seatRoomId;
            MudDialog.Close(DialogResult.Ok(Artifact));
            return;
        }

        if (string.IsNullOrWhiteSpace(_name))
        {
            _snackBar.Add(L["Name is required."], Severity.Warning);
            return;
        }

        if (_seatRoomId is int fullRoomId)
        {
            var room = _rooms.FirstOrDefault(r => r.Id == fullRoomId);
            var capacityError = BaronyCalc.ArtifactCapacityError(
                room,
                ExistingArtifacts,
                Artifact.Id > 0 ? Artifact.Id : null);
            if (capacityError is not null)
            {
                _snackBar.Add(capacityError, Severity.Warning);
                return;
            }
        }

        Artifact.Name = _name.Trim();
        Artifact.Kind = string.IsNullOrWhiteSpace(_kind) ? BaronArtifactKind.Other : _kind;
        Artifact.Origin = string.IsNullOrWhiteSpace(_origin) ? BaronArtifactOrigin.Acquired : _origin;
        Artifact.Prestige = _prestige;
        Artifact.Honor = _honor;
        Artifact.Fear = _fear;
        Artifact.Additive = _additive.Clone();
        Artifact.Percent = _percent.Clone();
        Artifact.SeatRoomId = _seatRoomId;
        Artifact.Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim();
        MudDialog.Close(DialogResult.Ok(Artifact));
    }
}
