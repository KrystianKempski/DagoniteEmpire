@namespace DagoniteEmpire.Pages.Barony.Components
@inject IDialogService _dialogService

<BaronySection Title="Czas barona">
    <Summary>
        <div class="baron-php-summary">
            <span class="baron-php-chip">Pula @_budget.TotalJc BT</span>
            <span class="baron-php-chip">Wydano @_budget.SpentJc</span>
            <span class="baron-php-chip @(_budget.RemainingJc < 0 ? "baron-time-chip--warn" : "")">
                Pozostało @_budget.RemainingJc
            </span>
        </div>
    </Summary>
    <ChildContent>
        <div class="baron-time-budget">
            <div class="baron-time-budget__formula">
                <BaronyTooltip Title="Pula BT"
                               Text="@PoolTooltip()">
                    <span>
                        (Wytrzymałość @_budget.Endurance + Siła woli @_budget.Willpower) × @BaronTimeRules.AttributeFactor
                        = @_budget.BaseJc BT
                        @if (_budget.ModifierPercent != 0m)
                        {
                            <text> · modyfikatory @BaronyCalc.FormatPercent(_budget.ModifierPercent) → <b>@_budget.TotalJc BT</b></text>
                        }
                        else
                        {
                            <text> → <b>@_budget.TotalJc BT</b></text>
                        }
                    </span>
                </BaronyTooltip>
            </div>

            <div class="baron-time-bars">
                <div class="baron-time-bar">
                    <div class="baron-time-bar__label">
                        <span>Alokacja tury</span>
                        <span>@_budget.SpentJc / @_budget.TotalJc BT</span>
                    </div>
                    <div class="baron-time-bar__track">
                        <div class="baron-time-bar__fill @UsedBarClass()"
                             style="@($"width:{UsedWidth()}%")"></div>
                    </div>
                </div>
                <div class="baron-time-bar">
                    <div class="baron-time-bar__label">
                        <span>Zarządzanie baronią</span>
                        <span>@_budget.ManagementJc / @BaronTimeRules.RequiredManagementJc BT</span>
                    </div>
                    <div class="baron-time-bar__track">
                        <div class="baron-time-bar__fill @ManagementBarClass()"
                             style="@($"width:{ManagementWidth()}%")"></div>
                        <BaronyTooltip Text="@($"Wymagane {BaronTimeRules.RequiredManagementJc} BT")">
                            <div class="baron-time-bar__marker"
                                 style="left:100%;"></div>
                        </BaronyTooltip>
                    </div>
                </div>
            </div>

            @if (_budget.IsManagementShort || _budget.IsExpeditionOverLimit || _budget.IsOverspent)
            {
                <div class="baron-time-warnings">
                    @if (_budget.IsManagementShort)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-1">
                            Niedobór zarządzania: @_budget.ManagementJc / @BaronTimeRules.RequiredManagementJc BT.
                            Możliwe kary do stabilności, lojalności, dochodu itp.
                        </MudAlert>
                    }
                    @if (_budget.IsExpeditionOverLimit)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-1">
                            Wyprawy: @_budget.ExpeditionWeeks.ToString("0.##") tyg.
                            (@_budget.AdventureJc BT). Bezpieczny limit to @BaronTimeRules.MaxSafeExpeditionWeeks tyg.
                            (@BaronTimeRules.MaxSafeExpeditionJc BT) bez dodatkowych kar do zarządzania.
                        </MudAlert>
                    }
                    @if (_budget.IsOverspent)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-1">
                            Przekroczono o @Math.Abs(_budget.RemainingJc) BT w tej turze.
                        </MudAlert>
                    }
                </div>
            }
        </div>

        <div class="baron-time-block">
            <div class="baron-time-block__title">Akcje w tej turze</div>
            <div style="overflow-x:auto;">
                <table class="ppb-table ppb-table--source ppb-table--lined baron-time-table">
                    <colgroup>
                        <col class="baron-time-col-name" />
                        <col class="baron-time-col-kind" />
                        <col class="baron-time-col-cost" />
                        <col class="baron-time-col-desc" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="ppb-row-label source-col">Akcja</th>
                            <th class="baron-time-col-kind">Typ</th>
                            <th class="baron-time-col-cost">Koszt</th>
                            <th class="baron-time-col-desc">Opis</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var action in _actions)
                        {
                            <tr class="@(action.IsSystem ? "source-row--system" : "")">
                                <td class="ppb-row-label source-col">
                                    <div class="source-cell">
                                        <span class="source-cell__name">@action.Name</span>
                                        @if (CanEdit)
                                        {
                                            <span class="source-cell__actions">
                                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditActionAsync(action))" />
                                                @if (!action.IsSystem)
                                                {
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteActionAsync(action))" />
                                                }
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="baron-time-col-kind">@action.Kind</td>
                                <td class="baron-time-cost">@action.CostJc BT</td>
                                <td class="baron-time-col-desc">@(action.Description ?? "")</td>
                            </tr>
                        }
                        <tr class="ppb-summary-row">
                            <td class="ppb-row-label" colspan="2">Σ wydano</td>
                            <td class="baron-time-cost"><b>@_budget.SpentJc BT</b></td>
                            <td class="baron-time-col-desc"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            @if (CanEdit)
            {
                <MudButton Variant="Variant.Outlined" Class="mt-2" StartIcon="@Icons.Material.Filled.Add" OnClick="AddActionAsync">
                    Dodaj akcję
                </MudButton>
            }
        </div>

        <div class="baron-time-block">
            <div class="baron-time-block__title">Modyfikatory puli (%)</div>
            @if (_modifiers.Count == 0)
            {
                <MudText Typo="Typo.body2" Style="color:var(--barony-muted);">
                    Brak modyfikatorów. Tu trafiają efekty zwiększające lub zmniejszające dostępny czas (choroba, błogosławieństwa, wydarzenia).
                </MudText>
            }
            else
            {
                <div style="overflow-x:auto;">
                    <table class="ppb-table ppb-table--source ppb-table--lined baron-time-table">
                        <colgroup>
                            <col class="baron-time-col-name" />
                            <col class="baron-time-col-cost" />
                            <col class="baron-time-col-desc" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th class="ppb-row-label source-col">Źródło</th>
                                <th class="baron-time-col-cost">%</th>
                                <th class="baron-time-col-desc">Opis</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mod in _modifiers)
                            {
                                <tr>
                                    <td class="ppb-row-label source-col">
                                        <div class="source-cell">
                                            <span class="source-cell__name">@mod.Source</span>
                                            @if (CanEdit)
                                            {
                                                <span class="source-cell__actions">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditModifierAsync(mod))" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteModifierAsync(mod))" />
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="@PercentClass(mod.Percent)">@BaronyCalc.FormatPercent(mod.Percent)</td>
                                    <td class="baron-time-col-desc">@(mod.Description ?? "")</td>
                                </tr>
                            }
                            <tr class="ppb-summary-row">
                                <td class="ppb-row-label">Σ modyfikatory</td>
                                <td class="@PercentClass(_budget.ModifierPercent)"><b>@BaronyCalc.FormatPercent(_budget.ModifierPercent)</b></td>
                                <td class="baron-time-col-desc"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            }
            @if (CanEdit)
            {
                <MudButton Variant="Variant.Outlined" Class="mt-2" StartIcon="@Icons.Material.Filled.Add" OnClick="AddModifierAsync">
                    Dodaj modyfikator
                </MudButton>
            }
        </div>

        <MudText Typo="Typo.caption" Class="mt-3" Style="color:var(--barony-muted);">
            Jedna tura = jeden kwartał. Tygodniowa wyprawa / przygoda = @BaronTimeRules.WeeklyExpeditionJc BT
            (do @BaronTimeRules.MaxSafeExpeditionWeeks tyg. / @BaronTimeRules.MaxSafeExpeditionJc BT bez dodatkowych kar do zarządzania).
            Wielkie Łowy: @BaronTimeSuggestedCosts.GreatHuntJc BT (baron lub oficer) + @BaronTimeSuggestedCosts.GreatHuntProduction Produkcji + @BaronTimeSuggestedCosts.GreatHuntGold złota;
            żywność z Tropienia głównego myśliwego, kosztem leśnej zwierzyny.
            Pozostałe koszty ustalane są podczas gry.
        </MudText>
    </ChildContent>
</BaronySection>

@code {
    [Parameter] public BaronyDTO Barony { get; set; } = new();
    [Parameter] public CharacterDTO? Character { get; set; }
    [Parameter] public List<BaronTimeActionDTO> Actions { get; set; } = new();
    [Parameter] public List<BaronTimeModifierDTO> Modifiers { get; set; } = new();
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    [Inject] private IBaronyRepository _baronyRepo { get; set; } = default!;
    [Inject] private ISnackbar _snackBar { get; set; } = default!;

    private List<BaronTimeActionDTO> _actions = new();
    private List<BaronTimeModifierDTO> _modifiers = new();
    private BaronTimeBudget _budget;

    protected override void OnParametersSet()
    {
        _actions = (Actions ?? new())
            .OrderBy(a => a.IsSystem ? 0 : 1)
            .ThenBy(a => a.SortOrder)
            .ThenBy(a => a.Id)
            .ToList();
        _modifiers = (Modifiers ?? new())
            .OrderBy(m => m.SortOrder)
            .ThenBy(m => m.Id)
            .ToList();
        _budget = BaronyCalc.BuildTimeBudget(Character, _modifiers, _actions);
    }

    private string PoolTooltip() =>
        $"Bazowe BT = (Wytrzymałość + Siła woli) × {BaronTimeRules.AttributeFactor}.\n"
        + $"Wytrzymałość {_budget.Endurance}, Siła woli {_budget.Willpower} → baza {_budget.BaseJc}.\n"
        + $"Modyfikatory procentowe: {BaronyCalc.FormatPercent(_budget.ModifierPercent)} → pula {_budget.TotalJc} BT.";

    private double UsedWidth() =>
        _budget.TotalJc <= 0 ? 0 : Math.Min(100d, (double)_budget.SpentJc * 100d / _budget.TotalJc);

    private double ManagementWidth() =>
        Math.Min(100d, (double)_budget.ManagementJc * 100d / BaronTimeRules.RequiredManagementJc);

    private string UsedBarClass() =>
        _budget.IsOverspent ? "baron-time-bar__fill--over"
        : _budget.UsedPercent >= 95m ? "baron-time-bar__fill--full"
        : "baron-time-bar__fill--ok";

    private string ManagementBarClass() =>
        _budget.IsManagementShort ? "baron-time-bar__fill--short"
        : "baron-time-bar__fill--mgmt";

    private static string PercentClass(decimal percent) =>
        percent > 0 ? "php-cell php-cell--pos"
        : percent < 0 ? "php-cell php-cell--neg"
        : "php-cell";

    private async Task AddActionAsync() =>
        await OpenActionDialog(new BaronTimeActionDTO
        {
            BaronyId = Barony.Id,
            Kind = BaronTimeActionKind.Other,
            CostJc = BaronTimeRules.WeeklyExpeditionJc,
            SortOrder = _actions.Count == 0 ? 1 : _actions.Max(a => a.SortOrder) + 1,
        });

    private async Task EditActionAsync(BaronTimeActionDTO item) =>
        await OpenActionDialog(CloneAction(item));

    private async Task OpenActionDialog(BaronTimeActionDTO draft)
    {
        var isNew = draft.Id <= 0;
        var parameters = new DialogParameters<BaronTimeActionEditDialog>
        {
            { x => x.Action, draft },
        };

        var dialog = await _dialogService.ShowAsync<BaronTimeActionEditDialog>(
            isNew ? "Dodaj akcję" : "Edytuj akcję",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not BaronTimeActionDTO saved)
            return;

        if (string.IsNullOrWhiteSpace(saved.Name))
        {
            _snackBar.Add("Nazwa akcji jest wymagana.", Severity.Warning);
            return;
        }

        await _baronyRepo.SaveBaronTimeAction(saved);
        _snackBar.Add("Zapisano akcję.", Severity.Success);
        await OnChanged.InvokeAsync();
    }

    private async Task DeleteActionAsync(BaronTimeActionDTO item)
    {
        if (item.Id <= 0 || item.IsSystem)
            return;

        await _baronyRepo.DeleteBaronTimeAction(item.Id);
        _snackBar.Add("Usunięto akcję.", Severity.Success);
        await OnChanged.InvokeAsync();
    }

    private async Task AddModifierAsync() =>
        await OpenModifierDialog(new BaronTimeModifierDTO
        {
            BaronyId = Barony.Id,
            SortOrder = _modifiers.Count == 0 ? 0 : _modifiers.Max(m => m.SortOrder) + 1,
        });

    private async Task EditModifierAsync(BaronTimeModifierDTO item) =>
        await OpenModifierDialog(new BaronTimeModifierDTO
        {
            Id = item.Id,
            BaronyId = item.BaronyId,
            Source = item.Source,
            Percent = item.Percent,
            Description = item.Description,
            SortOrder = item.SortOrder,
        });

    private async Task OpenModifierDialog(BaronTimeModifierDTO draft)
    {
        var isNew = draft.Id <= 0;
        var parameters = new DialogParameters<BaronTimeModifierEditDialog>
        {
            { x => x.Modifier, draft },
        };

        var dialog = await _dialogService.ShowAsync<BaronTimeModifierEditDialog>(
            isNew ? "Dodaj modyfikator" : "Edytuj modyfikator",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not BaronTimeModifierDTO saved)
            return;

        if (string.IsNullOrWhiteSpace(saved.Source))
        {
            _snackBar.Add("Źródło jest wymagane.", Severity.Warning);
            return;
        }

        await _baronyRepo.SaveBaronTimeModifier(saved);
        _snackBar.Add("Zapisano modyfikator.", Severity.Success);
        await OnChanged.InvokeAsync();
    }

    private async Task DeleteModifierAsync(BaronTimeModifierDTO item)
    {
        if (item.Id <= 0)
            return;

        await _baronyRepo.DeleteBaronTimeModifier(item.Id);
        _snackBar.Add("Usunięto modyfikator.", Severity.Success);
        await OnChanged.InvokeAsync();
    }

    private static BaronTimeActionDTO CloneAction(BaronTimeActionDTO a) => new()
    {
        Id = a.Id,
        BaronyId = a.BaronyId,
        Name = a.Name,
        Kind = a.Kind,
        CostJc = a.CostJc,
        Description = a.Description,
        SortOrder = a.SortOrder,
        IsSystem = a.IsSystem,
    };
}
