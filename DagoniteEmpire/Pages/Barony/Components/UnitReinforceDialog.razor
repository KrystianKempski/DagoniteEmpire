@namespace DagoniteEmpire.Pages.Barony.Components
@using DA_Common.Barony
@using DA_Models.BaronyModels

<MudDialog Class="baron-influence-dialog"
           ContentClass="baron-influence-dialog-content"
           ActionsClass="baron-influence-dialog-actions">
    <TitleContent>
        <MudText Typo="Typo.h6">Reinforce — @Unit.Name</MudText>
    </TitleContent>
    <DialogContent>
        <div class="barony-dialog-theme baron-influence-edit-dialog">
            <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mb-2">
                @L["People cost = Selected volunteers + Standard training, scaled by troops / {0} (floor).", Unit.FullTroopCount]
                @L["Gear = current loadout at {0}% salvage, then the same scale.", UnitRules.ReinforceGearSalvagePercent]
            </MudText>

            <MudNumericField T="int"
                             @bind-Value="_troopCount"
                             @bind-Value:after="Recalc"
                             Label="@(L["Troops to add"])"
                             HelperText="@(L["Missing {0}. Current {1}/{2}.", _missing, Unit.TroopCount, Unit.FullTroopCount])"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Min="1"
                             Max="@Math.Max(1, _missing)"
                             Class="baron-influence-field mb-3" />

            <MudText Typo="Typo.subtitle2" Class="mb-1">@L["Gear acquire"]</MudText>
            <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mb-2">
                @L["Craft · Buy (Mkt) · Defense (2×Mkt) — same as the unit generator. Costs below already include salvage + troop scale."]
            </MudText>
            <div class="unit-gear-pay mb-3">
                @PayRow("W1", _w1?.DisplayName(), _w1?.ProductionCost, _w1?.GoldCost, _w1?.MarketGold, _payW1, v => { _payW1 = v; Recalc(); }, required: true)
                @PayRow("W2", _w2?.DisplayName(), _w2?.ProductionCost, _w2?.GoldCost, _w2?.MarketGold, _payW2, v => { _payW2 = v; Recalc(); }, required: false)
                @PayRow("Armor", _armor?.DisplayName(), _armor?.ProductionCost, _armor?.GoldCost, _armor?.MarketGold, _payArmor, v => { _payArmor = v; Recalc(); }, required: false)
                @PayRow("Shield", _shield?.DisplayName(), _shield?.ProductionCost, _shield?.GoldCost, _shield?.MarketGold, _payShield, v => { _payShield = v; Recalc(); }, required: false)
                @PayRow("Mount", _mount?.DisplayName(), _mount?.ProductionCost, _mount?.GoldCost, _mount?.MarketGold, _payMount, v => { _payMount = v; Recalc(); }, required: false)
            </div>

            <MudText Typo="Typo.subtitle2" Class="mb-1">@L["Project cost"]</MudText>
            <div class="d-flex flex-wrap gap-3 mb-1">
                <span>
                    @L["Gold"] <b>@_costs.GoldTotal</b>
                    <span style="color:var(--barony-muted);">@L["(people {0} · gear {1})", _costs.GoldPeople, _costs.GoldGear]</span>
                </span>
                <span>
                    @L["Prod"] <b>@_costs.Production</b>
                </span>
                <span>
                    @L["Defense"] <b>@_costs.DefenseTotal</b>
                    <span style="color:var(--barony-muted);">@L["(people {0} · gear {1})", _costs.DefensePeople, _costs.DefenseGear]</span>
                </span>
                <span>@L["Turns"] <b>@_costs.Turns</b></span>
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Class="baron-influence-save-btn"
                   Variant="Variant.Filled"
                   Disabled="@(_costs.TroopCount <= 0 || _missing <= 0)"
                   OnClick="Confirm">
            @L["Create project"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public BaronyUnitDTO Unit { get; set; } = new();

    private int _missing;
    private int _troopCount = 1;
    private string _payW1 = UnitEquipmentAcquireMode.Craft;
    private string _payW2 = UnitEquipmentAcquireMode.Craft;
    private string _payArmor = UnitEquipmentAcquireMode.Craft;
    private string _payShield = UnitEquipmentAcquireMode.Craft;
    private string _payMount = UnitEquipmentAcquireMode.Craft;
    private UnitWeaponDef? _w1;
    private UnitWeaponDef? _w2;
    private UnitArmorDef? _armor;
    private UnitArmorDef? _shield;
    private UnitMountDef? _mount;
    private UnitReinforceCostSummary _costs;

    protected override void OnInitialized()
    {
        _w1 = UnitWeaponCatalog.Find(Unit.Weapon1Key);
        _w2 = UnitWeaponCatalog.Find(Unit.Weapon2Key);
        _armor = UnitArmorCatalog.Find(Unit.ArmorKey);
        _shield = UnitArmorCatalog.Find(Unit.ShieldKey);
        _mount = UnitMountCatalog.Find(Unit.MountKey);
        _missing = Math.Max(0, Unit.FullTroopCount - Unit.TroopCount);
        _troopCount = Math.Max(1, _missing);
        Recalc();
    }

    private void Recalc()
    {
        _missing = Math.Max(0, Unit.FullTroopCount - Unit.TroopCount);
        if (_troopCount < 1) _troopCount = 1;
        if (_troopCount > _missing && _missing > 0) _troopCount = _missing;

        _costs = UnitReinforceCostFormulas.Compute(
            Unit.TroopCount,
            _w1, _w2, _armor, _shield, _mount,
            new UnitEquipmentPayModes(_payW1, _payW2, _payArmor, _payShield, _payMount),
            _troopCount,
            Unit.FullTroopCount);
    }

    private RenderFragment PayRow(
        string slot,
        string? name,
        int? prod,
        int? gold,
        int? market,
        string mode,
        Action<string> onChanged,
        bool required) => __builder =>
    {
        var hasItem = !string.IsNullOrWhiteSpace(name);
        var m = UnitEquipmentAcquireMode.Normalize(mode);
        <div class="unit-gear-pay__row @(hasItem ? null : "unit-gear-pay__row--empty")">
            <span class="unit-gear-pay__slot">@slot</span>
            <span class="unit-gear-pay__name">@(hasItem ? name : (required ? "—" : "none"))</span>
            @if (hasItem)
            {
                <MudRadioGroup T="string"
                               Value="@m"
                               ValueChanged="EventCallback.Factory.Create<string>(this, onChanged)"
                               Class="unit-gear-pay__modes">
                    <BaronyTooltip Text="@($"Craft: Prod {prod} + Gold {gold}")">
                        <MudRadio T="string" Value="@UnitEquipmentAcquireMode.Craft" Dense="true" Class="unit-gear-pay__mode">
                            <BaronyResourceIcon Resource="Ppb.Production" Size="xs" />
                        </MudRadio>
                    </BaronyTooltip>
                    <BaronyTooltip Text="@($"Buy: Mkt {market}")">
                        <MudRadio T="string" Value="@UnitEquipmentAcquireMode.Buy" Dense="true" Class="unit-gear-pay__mode">
                            <BaronyResourceIcon Resource="Ppb.Treasury" Size="xs" />
                        </MudRadio>
                    </BaronyTooltip>
                    <BaronyTooltip Text="@($"Defense: 2×Mkt = {(market ?? 0) * 2}")">
                        <MudRadio T="string" Value="@UnitEquipmentAcquireMode.Defense" Dense="true" Class="unit-gear-pay__mode">
                            <BaronyResourceIcon Resource="Ppb.Defense" Size="xs" />
                        </MudRadio>
                    </BaronyTooltip>
                </MudRadioGroup>
            }
        </div>
    };

    private void Cancel() => MudDialog.Cancel();

    private void Confirm()
    {
        Recalc();
        if (_costs.TroopCount <= 0) return;
        MudDialog.Close(DialogResult.Ok(new StartUnitReinforceRequest
        {
            BaronyId = Unit.BaronyId,
            UnitId = Unit.Id,
            TroopCount = _costs.TroopCount,
            Weapon1AcquireMode = _payW1,
            Weapon2AcquireMode = _payW2,
            ArmorAcquireMode = _payArmor,
            ShieldAcquireMode = _payShield,
            MountAcquireMode = _payMount,
        }));
    }
}
