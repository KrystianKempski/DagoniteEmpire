@namespace DagoniteEmpire.Pages.Barony.Components

<table class="ppb-table ppb-table--catalog ppb-table--lined">
    <thead>
        <tr>
            <th class="catalog-col-name catalog-th--sortable @SortClass(SortName)" @onclick="() => ToggleSort(SortName)">
                Name<span class="catalog-sort-indicator">@SortIndicator(SortName)</span>
            </th>
            <th class="catalog-col-lordship catalog-th--sortable @SortClass(SortLordship)" title="Required lordship authority level" @onclick="() => ToggleSort(SortLordship)">
                Lordship<span class="catalog-sort-indicator">@SortIndicator(SortLordship)</span>
            </th>
            <th class="catalog-col-kind catalog-th--sortable @SortClass(SortType)" @onclick="() => ToggleSort(SortType)">
                Type<span class="catalog-sort-indicator">@SortIndicator(SortType)</span>
            </th>
            <th class="catalog-col-cost catalog-th--sortable @SortClass(SortProdCost)" title="Production cost" @onclick="() => ToggleSort(SortProdCost)">
                Prod.<span class="catalog-sort-indicator">@SortIndicator(SortProdCost)</span>
            </th>
            <th class="catalog-col-cost catalog-th--sortable @SortClass(SortGoldCost)" title="Gold cost" @onclick="() => ToggleSort(SortGoldCost)">
                Gold<span class="catalog-sort-indicator">@SortIndicator(SortGoldCost)</span>
            </th>
            <th class="catalog-col-desc">Description</th>
            @foreach (var info in PpbCatalog.All)
            {
                var sortKey = PpbSortKey(info.Key);
                <th class="catalog-th--sortable @SortClass(sortKey)" title="@info.NamePl" @onclick="() => ToggleSort(sortKey)">
                    @PpbShort(info.Key)<span class="catalog-sort-indicator">@SortIndicator(sortKey)</span>
                </th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in SortedItems)
        {
            <tr>
                <td class="catalog-col-name catalog-cell-name">@item.Name</td>
                <td class="catalog-col-lordship">@FmtLevel(item.RequiredLordshipLevel)</td>
                <td class="catalog-col-kind">@TypeLabel(item.Kind)</td>
                <td class="catalog-col-cost">@FmtCost(item.ProductionCost)</td>
                <td class="catalog-col-cost">@FmtCost(item.GoldCost)</td>
                <td class="catalog-col-desc">
                    @if (string.IsNullOrWhiteSpace(item.Description))
                    {
                        <span class="ppb-cell-zero">·</span>
                    }
                    else
                    {
                        <span title="@item.Description">@item.Description</span>
                    }
                </td>
                @foreach (var info in PpbCatalog.All)
                {
                    <td class="@CellClass(item, info.Key)">@((MarkupString)CellContent(item, info.Key))</td>
                }
            </tr>
        }
    </tbody>
</table>

@code {
    private const string SortName = "name";
    private const string SortLordship = "lordship";
    private const string SortType = "type";
    private const string SortProdCost = "prodcost";
    private const string SortGoldCost = "goldcost";

    [Parameter] public IEnumerable<BuildingTemplateDTO> Items { get; set; } = Array.Empty<BuildingTemplateDTO>();

    private string _sortKey = SortName;
    private bool _sortDesc;

    private IEnumerable<BuildingTemplateDTO> SortedItems => ApplySort(Items);

    private static string PpbSortKey(Ppb p) => $"ppb:{p}";

    private void ToggleSort(string key)
    {
        if (_sortKey == key)
            _sortDesc = !_sortDesc;
        else
        {
            _sortKey = key;
            _sortDesc = false;
        }
    }

    private string SortClass(string key)
        => _sortKey == key ? "catalog-th--sorted" : "";

    private string SortIndicator(string key)
    {
        if (_sortKey != key)
            return "";
        return _sortDesc ? " ▼" : " ▲";
    }

    private IEnumerable<BuildingTemplateDTO> ApplySort(IEnumerable<BuildingTemplateDTO> items)
    {
        if (_sortKey.StartsWith("ppb:", StringComparison.Ordinal))
        {
            if (!Enum.TryParse<Ppb>(_sortKey["ppb:".Length..], out var ppb))
                return items.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase);
            return SortByPpb(items, ppb, _sortDesc);
        }

        return _sortKey switch
        {
            SortLordship => _sortDesc
                ? items.OrderByDescending(x => x.RequiredLordshipLevel).ThenBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
                : items.OrderBy(x => x.RequiredLordshipLevel).ThenBy(x => x.Name, StringComparer.OrdinalIgnoreCase),
            SortType => _sortDesc
                ? items.OrderByDescending(x => x.Kind, StringComparer.OrdinalIgnoreCase).ThenBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
                : items.OrderBy(x => x.Kind, StringComparer.OrdinalIgnoreCase).ThenBy(x => x.Name, StringComparer.OrdinalIgnoreCase),
            SortProdCost => _sortDesc
                ? items.OrderByDescending(x => x.ProductionCost).ThenBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
                : items.OrderBy(x => x.ProductionCost).ThenBy(x => x.Name, StringComparer.OrdinalIgnoreCase),
            SortGoldCost => _sortDesc
                ? items.OrderByDescending(x => x.GoldCost).ThenBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
                : items.OrderBy(x => x.GoldCost).ThenBy(x => x.Name, StringComparer.OrdinalIgnoreCase),
            _ => _sortDesc
                ? items.OrderByDescending(x => x.Name, StringComparer.OrdinalIgnoreCase)
                : items.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase),
        };
    }

    private static IEnumerable<BuildingTemplateDTO> SortByPpb(IEnumerable<BuildingTemplateDTO> items, Ppb ppb, bool desc)
    {
        decimal Add(BuildingTemplateDTO x) => x.EffectAdditive[ppb];
        decimal Pct(BuildingTemplateDTO x) => x.EffectPercent[ppb];

        return desc
            ? items.OrderByDescending(Add).ThenByDescending(Pct).ThenBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
            : items.OrderBy(Add).ThenBy(Pct).ThenBy(x => x.Name, StringComparer.OrdinalIgnoreCase);
    }

    private static string TypeLabel(string? kind)
        => string.IsNullOrWhiteSpace(kind) ? "·" : kind;

    private static string FmtLevel(int level)
        => level <= 0 ? "·" : level.ToString();

    private static string FmtCost(decimal cost)
    {
        if (cost == 0m)
            return "·";
        var rounded = decimal.Round(cost, 2);
        return rounded == decimal.Truncate(rounded)
            ? ((long)rounded).ToString()
            : rounded.ToString("0.##");
    }

    private static string Fmt(decimal v)
    {
        if (v == 0m)
            return "·";
        var rounded = decimal.Round(v, 2);
        var text = rounded == decimal.Truncate(rounded)
            ? ((long)rounded).ToString()
            : rounded.ToString("0.##");
        return rounded > 0 ? "+" + text : text;
    }

    private static string CellContent(BuildingTemplateDTO item, Ppb p)
    {
        var add = item.EffectAdditive[p];
        var pct = item.EffectPercent[p];
        var parts = new List<string>();
        if (add != 0m)
            parts.Add(Fmt(add));
        if (pct != 0m)
            parts.Add(Fmt(pct) + "%");
        return parts.Count == 0 ? "<span class=\"ppb-cell-zero\">·</span>" : string.Join(" / ", parts);
    }

    private static string CellClass(BuildingTemplateDTO item, Ppb p)
    {
        var add = item.EffectAdditive[p];
        var pct = item.EffectPercent[p];
        if (add > 0m || pct > 0m) return "ppb-cell-pos";
        if (add < 0m || pct < 0m) return "ppb-cell-neg";
        return "ppb-cell-zero";
    }

    private static string PpbShort(Ppb p) => p switch
    {
        Ppb.Food => "Food",
        Ppb.Economy => "Econ",
        Ppb.Production => "Prod",
        Ppb.Loyalty => "Loy",
        Ppb.Stability => "Stab",
        Ppb.Law => "Law",
        Ppb.Corruption => "Corr",
        Ppb.Science => "Sci",
        Ppb.Magic => "Mag",
        Ppb.Culture => "Cult",
        Ppb.Intelligence => "Intel",
        Ppb.Defense => "Def",
        Ppb.Treasury => "Gold",
        _ => p.ToString(),
    };
}
