@namespace DagoniteEmpire.Pages.Barony.Components

<BaronySection Title="@SectionLabel">
    <Summary>
        <span class="projects-summary__item">@L["{0} / {1} available", AvailableCount, Items.Count]</span>
    </Summary>
    <ChildContent>
        <div style="overflow-x:auto;">
            <table class="ppb-table ppb-table--lined trade-goods-table">
                <colgroup>
                    <col class="trade-goods-col-check" />
                    <col class="trade-goods-col-name" />
                    <col class="trade-goods-col-source" />
                    <col class="trade-goods-col-desc" />
                    <col class="trade-goods-col-bonus" />
                    <col class="trade-goods-col-unlock" />
                    <col class="trade-goods-col-building" />
                    <col class="trade-goods-col-req" />
                    @if (CanOverride)
                    {
                        <col class="trade-goods-col-override" />
                    }
                </colgroup>
                <thead>
                    <tr>
                        <th class="trade-goods-col-check">@L["Available"]</th>
                        <th class="trade-goods-col-name">@L["Good"]</th>
                        <th class="trade-goods-col-source">@L["Source"]</th>
                        <th class="trade-goods-col-desc">@L["Description"]</th>
                        <th class="trade-goods-col-bonus">@L["PPB bonus"]</th>
                        <th class="trade-goods-col-unlock">@L["Unlocks"]</th>
                        <th class="trade-goods-col-building">@L["Production building"]</th>
                        <th class="trade-goods-col-req">@L["Requires"]</th>
                        @if (CanOverride)
                        {
                            <th class="trade-goods-col-override">
                                <BaronyTooltip Text="@(L["MG can force a good available without production or treaty"])">@L["MG override"]</BaronyTooltip>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Items)
                    {
                        var available = Availability.IsAvailable(item.Key);
                        var grantable = Availability.IsGrantable(item.Key);
                        <tr class="@(available ? "trade-goods-row--available" : "")">
                            <td class="trade-goods-col-check">
                                <MudCheckBox T="bool"
                                             Value="available"
                                             Disabled="true"
                                             Dense="true"
                                             ReadOnly="true"
                                             Color="Color.Default"
                                             Class="barony-checkbox" />
                            </td>
                            <td class="trade-goods-col-name">
                                <span class="trade-good-name">
                                    <TradeGoodIcon Good="@item" Title="@item.DisplayName(L)" />
                                    <span>@item.DisplayName(L)</span>
                                </span>
                                @if (available && !grantable)
                                {
                                    <div class="trade-goods-source-hint">@L["Trade only — cannot re-export"]</div>
                                }
                            </td>
                            <td class="trade-goods-col-source">
                                @(available ? Availability.SourceLabel(item.Key) : "—")
                            </td>
                            <td class="trade-goods-col-desc">
                                <BaronyTooltip Title="@item.DisplayName(L)" Text="@item.DisplayDescription(L)">
                                    <span class="relations-ellipsis">@item.DisplayDescription(L)</span>
                                </BaronyTooltip>
                            </td>
                            <td class="trade-goods-col-bonus">@item.DisplayBonus(L)</td>
                            <td class="trade-goods-col-unlock">
                                @if (!string.IsNullOrWhiteSpace(item.Unlocks))
                                {
                                    <BaronyTooltip Title="@(L["Unlocks"])" Text="@item.DisplayUnlocks(L)">
                                        <span class="relations-ellipsis">@item.DisplayUnlocks(L)</span>
                                    </BaronyTooltip>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td class="trade-goods-col-building">@(string.IsNullOrWhiteSpace(item.ProductionBuilding) ? "—" : item.DisplayProductionBuilding(L))</td>
                            <td class="trade-goods-col-req">
                                @if (!string.IsNullOrWhiteSpace(item.Requirements))
                                {
                                    <BaronyTooltip Title="@(L["Requires"])" Text="@item.DisplayRequirements(L)">
                                        <span class="relations-ellipsis">@item.DisplayRequirements(L)</span>
                                    </BaronyTooltip>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            @if (CanOverride)
                            {
                                <td class="trade-goods-col-override">
                                    <MudCheckBox T="bool"
                                                 Value="@Availability.IsOverride(item.Key)"
                                                 ValueChanged="@(v => OnOverrideToggleAsync(item.Key, v))"
                                                 Disabled="@OverrideDisabled"
                                                 Dense="true"
                                                 Color="Color.Default"
                                                 Class="barony-checkbox" />
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </ChildContent>
</BaronySection>

@code {
    [Parameter] public string SectionKey { get; set; } = "";
    [Parameter] public string SectionLabel { get; set; } = "";
    [Parameter] public IReadOnlyList<TradeGoodEntry> Items { get; set; } = Array.Empty<TradeGoodEntry>();
    [Parameter] public TradeGoodAvailabilitySnapshot Availability { get; set; } = new();
    [Parameter] public bool CanOverride { get; set; }
    [Parameter] public bool OverrideDisabled { get; set; }
    [Parameter] public EventCallback<(string Key, bool Enabled)> OnOverrideToggle { get; set; }

    private int AvailableCount => Items.Count(i => Availability.IsAvailable(i.Key));

    private Task OnOverrideToggleAsync(string key, bool enabled) => OnOverrideToggle.InvokeAsync((key, enabled));
}
