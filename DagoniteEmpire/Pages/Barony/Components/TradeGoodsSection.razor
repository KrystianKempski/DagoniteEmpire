@namespace DagoniteEmpire.Pages.Barony.Components

<BaronySection Title="@SectionLabel">
    <Summary>
        <span class="projects-summary__item">@AvailableCount / @Items.Count available</span>
    </Summary>
    <ChildContent>
        <div style="overflow-x:auto;">
            <table class="ppb-table ppb-table--lined trade-goods-table">
                <colgroup>
                    <col class="trade-goods-col-check" />
                    <col class="trade-goods-col-name" />
                    <col class="trade-goods-col-source" />
                    <col class="trade-goods-col-desc" />
                    <col class="trade-goods-col-bonus" />
                    <col class="trade-goods-col-unlock" />
                    <col class="trade-goods-col-building" />
                    <col class="trade-goods-col-req" />
                    @if (CanOverride)
                    {
                        <col class="trade-goods-col-override" />
                    }
                </colgroup>
                <thead>
                    <tr>
                        <th class="trade-goods-col-check">Available</th>
                        <th class="trade-goods-col-name">Good</th>
                        <th class="trade-goods-col-source">Source</th>
                        <th class="trade-goods-col-desc">Description</th>
                        <th class="trade-goods-col-bonus">PPB bonus</th>
                        <th class="trade-goods-col-unlock">Unlocks</th>
                        <th class="trade-goods-col-building">Production building</th>
                        <th class="trade-goods-col-req">Requires</th>
                        @if (CanOverride)
                        {
                            <th class="trade-goods-col-override">
                                <BaronyTooltip Text="MG can force a good available without production or treaty">MG override</BaronyTooltip>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Items)
                    {
                        var available = Availability.IsAvailable(item.Key);
                        var grantable = Availability.IsGrantable(item.Key);
                        <tr class="@(available ? "trade-goods-row--available" : "")">
                            <td class="trade-goods-col-check">
                                <MudCheckBox T="bool"
                                             Value="available"
                                             Disabled="true"
                                             Dense="true"
                                             ReadOnly="true" />
                            </td>
                            <td class="trade-goods-col-name">
                                <span class="trade-good-name">
                                    <TradeGoodIcon Good="@item" Title="@item.Name" />
                                    <span>@item.Name</span>
                                </span>
                                @if (available && !grantable)
                                {
                                    <div class="trade-goods-source-hint">Trade only — cannot re-export</div>
                                }
                            </td>
                            <td class="trade-goods-col-source">
                                @(available ? Availability.SourceLabel(item.Key) : "—")
                            </td>
                            <td class="trade-goods-col-desc">
                                <BaronyTooltip Title="@item.Name" Text="@item.Description">
                                    <span class="relations-ellipsis">@item.Description</span>
                                </BaronyTooltip>
                            </td>
                            <td class="trade-goods-col-bonus">@item.BonusDisplay</td>
                            <td class="trade-goods-col-unlock">
                                @if (!string.IsNullOrWhiteSpace(item.Unlocks))
                                {
                                    <BaronyTooltip Title="Unlocks" Text="@item.Unlocks">
                                        <span class="relations-ellipsis">@item.Unlocks</span>
                                    </BaronyTooltip>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td class="trade-goods-col-building">@(string.IsNullOrWhiteSpace(item.ProductionBuilding) ? "—" : item.ProductionBuilding)</td>
                            <td class="trade-goods-col-req">
                                @if (!string.IsNullOrWhiteSpace(item.Requirements))
                                {
                                    <BaronyTooltip Title="Requires" Text="@item.Requirements">
                                        <span class="relations-ellipsis">@item.Requirements</span>
                                    </BaronyTooltip>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            @if (CanOverride)
                            {
                                <td class="trade-goods-col-override">
                                    <MudCheckBox T="bool"
                                                 Value="@Availability.IsOverride(item.Key)"
                                                 ValueChanged="@(v => OnOverrideToggleAsync(item.Key, v))"
                                                 Disabled="@OverrideDisabled"
                                                 Dense="true" />
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </ChildContent>
</BaronySection>

@code {
    [Parameter] public string SectionKey { get; set; } = "";
    [Parameter] public string SectionLabel { get; set; } = "";
    [Parameter] public IReadOnlyList<TradeGoodEntry> Items { get; set; } = Array.Empty<TradeGoodEntry>();
    [Parameter] public TradeGoodAvailabilitySnapshot Availability { get; set; } = new();
    [Parameter] public bool CanOverride { get; set; }
    [Parameter] public bool OverrideDisabled { get; set; }
    [Parameter] public EventCallback<(string Key, bool Enabled)> OnOverrideToggle { get; set; }

    private int AvailableCount => Items.Count(i => Availability.IsAvailable(i.Key));

    private Task OnOverrideToggleAsync(string key, bool enabled) => OnOverrideToggle.InvokeAsync((key, enabled));
}
