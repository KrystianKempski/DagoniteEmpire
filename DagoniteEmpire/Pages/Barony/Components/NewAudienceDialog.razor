@namespace DagoniteEmpire.Pages.Barony.Components

<MudDialog Class="barony-dialog">
    <TitleContent>
        <MudText Typo="Typo.h6">@L["New audience"]</MudText>
    </TitleContent>
    <DialogContent>
        <div class="barony-dialog-theme">
        <MudTextField @bind-Value="_petitionerName"
                      Label="@(L["Petitioner"])"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      HelperText="@(L["Name of the person seeking audience"])"
                      Class="mb-2" />
        <MudTextField @bind-Value="_title"
                      Label="@(L["Audience title"])"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      HelperText="@(L["e.g. Plea for harvest help"])"
                      Class="mb-2" />
        <MudTextField @bind-Value="_opening"
                      Label="@(L["Opening words"])"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Lines="5"
                      Immediate="true"
                      HelperText="@(L["What the petitioner says first"])" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Class="baron-influence-save-btn" Variant="Variant.Filled" OnClick="Submit" Disabled="_busy || !CanSubmit">
            @L["Grant audience"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private string _petitionerName = "";
    private string _title = "";
    private string _opening = "";
    private bool _busy;

    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(_petitionerName)
        && !string.IsNullOrWhiteSpace(_title)
        && !string.IsNullOrWhiteSpace(_opening);

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (!CanSubmit) return;
        _busy = true;
        MudDialog.Close(DialogResult.Ok(new NewAudienceResult(
            _petitionerName.Trim(),
            _title.Trim(),
            _opening.Trim())));
    }

    public sealed record NewAudienceResult(string PetitionerName, string Title, string OpeningBody);
}
