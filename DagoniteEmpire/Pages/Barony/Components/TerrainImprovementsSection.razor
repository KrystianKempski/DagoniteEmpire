@namespace DagoniteEmpire.Pages.Barony.Components
@inject IBaronyRepository _baronyRepo
@inject ISnackbar _snackBar
@inject IDialogService _dialogService

<BaronySection Title="Terrain Improvements">
    <Summary>
        <PpbSummaryChips Vector="@Glance" />
    </Summary>
    <ChildContent>
        @if (VisibleImprovements.Count == 0)
        {
            <MudText Typo="Typo.body2" Style="color:var(--barony-muted);">No terrain improvements in your domain yet. Place them on tiles belonging to the baron’s primary domain.</MudText>
        }
        else
        {
            <div style="overflow-x:auto;">
                <table class="ppb-table ppb-table--advisors ppb-table--city-buildings ppb-table--terrain-improvements ppb-table--lined">
                    <colgroup>
                        <col class="city-building-col-name" />
                        <col class="city-building-col-owner" />
                        <col class="city-building-col-pop" />
                        @foreach (var _ in PpbCatalog.All)
                        {
                            <col class="ppb-pair-col" />
                            <col class="ppb-pair-col" />
                        }
                    </colgroup>
                    <thead>
                        <tr>
                            <th rowspan="2" class="ppb-row-label city-building-col-name">Name</th>
                            <th rowspan="2" class="city-building-col-owner" title="Land ownership">Owner</th>
                            <th class="city-building-col-pop" title="Population (additive)">Pop</th>
                            @foreach (var info in PpbCatalog.All)
                            {
                                <th colspan="2" title="@info.Code">@PpbShort(info.Key)</th>
                            }
                        </tr>
                        <tr>
                            <th class="ppb-subcol ppb-subcol--add city-building-col-pop">+</th>
                            @foreach (var _ in PpbCatalog.All)
                            {
                                <th class="ppb-subcol ppb-subcol--add">+</th>
                                <th class="ppb-subcol ppb-subcol--pct">%</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in VisibleImprovements)
                        {
                            var vassal = IsVassal(item);
                            var inactive = !item.IsActive;
                            <tr class="@(inactive ? "terrain-improvement-row--inactive" : null)">
                                <td class="city-building-col-name">
                                    <div class="city-building-name-cell">
                                        <BaronyTooltip Title="Description" Text="@NameTooltip(item)">
                                            <span class="city-building-name-text">@DisplayLabel(item)</span>
                                        </BaronyTooltip>
                                        @if (CanManage)
                                        {
                                            <span class="city-building-name-actions">
                                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                               Size="Size.Small"
                                                               title="Edit improvement"
                                                               OnClick="@(() => EditAsync(item))" />
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="city-building-col-owner">
                                    <BaronyTooltip Text="@BaronyCalc.OwnershipTooltip(vassal, VassalTributePercent)">
                                        @if (vassal)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Shield"
                                                     Size="Size.Small"
                                                     Class="terrain-improvement-owner terrain-improvement-owner--vassal" />
                                        }
                                        else
                                        {
                                            <img src="/icons/jewel-crown.svg"
                                                 alt="Demesne"
                                                 width="20"
                                                 height="20"
                                                 class="terrain-improvement-owner__crown" />
                                        }
                                    </BaronyTooltip>
                                </td>
                                <td class="@PopulationCellClass(item.Population, inactive, CanManage && BaronyCalc.IsVillage(item))"
                                    @onclick="@(() => EditPopulationAsync(item))">
                                    @if (BaronyCalc.IsVillage(item))
                                    {
                                        <BaronyTooltip Text="Population — input for village PPB formulas.">
                                            <span>@FmtAdd(item.Population)</span>
                                        </BaronyTooltip>
                                    }
                                    else
                                    {
                                        @FmtAdd(item.Population)
                                    }
                                </td>
                                @foreach (var info in PpbCatalog.All)
                                {
                                    var effective = EffectiveAdditive(item);
                                    <td class="@PpbCellClass(info.Key, effective[info.Key], inactive)">
                                        @{
                                            var tip = VillageAdditiveTooltip(item, info.Key, effective);
                                        }
                                        @if (tip is not null)
                                        {
                                            <BaronyTooltip Title="@info.NameEn" Text="@tip">
                                                <span>@FmtAdd(effective[info.Key])</span>
                                            </BaronyTooltip>
                                        }
                                        else
                                        {
                                            @FmtAdd(effective[info.Key])
                                        }
                                    </td>
                                    <td class="@PpbCellClass(info.Key, item.Percent[info.Key], inactive)">@FmtPct(item.Percent[info.Key])</td>
                                }
                            </tr>
                        }

                        <tr class="ppb-summary-row">
                            <td class="ppb-row-label city-building-col-name">Σ section</td>
                            <td class="city-building-col-owner"></td>
                            <td class="@PopulationCellClass(PopulationSum, inactive: false)"><b>@FmtAdd(PopulationSum)</b></td>
                            @foreach (var info in PpbCatalog.All)
                            {
                                <td class="@PpbCellStyle.ValueClass(info.Key, AdditiveSum[info.Key])"><b>@FmtAdd(AdditiveSum[info.Key])</b></td>
                                <td class="@PpbCellStyle.ValueClass(info.Key, PercentSum[info.Key])"><b>@FmtPct(PercentSum[info.Key])</b></td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    </ChildContent>
</BaronySection>

@code {
    [Parameter] public List<TerrainImprovementDTO> Improvements { get; set; } = new();
    [Parameter] public List<TerrainTileDTO> Tiles { get; set; } = new();
    [Parameter] public List<FiefDTO> Fiefs { get; set; } = new();
    [Parameter] public decimal VassalTributePercent { get; set; } = FiefTributeFormulas.DefaultPercent;
    [Parameter] public bool CanManage { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private Dictionary<int, TerrainTileDTO> TilesById =>
        Tiles.ToDictionary(t => t.Id);

    private Dictionary<int, FiefDTO> FiefsById =>
        Fiefs.ToDictionary(f => f.Id);

    private List<TerrainImprovementDTO> VisibleImprovements =>
        Improvements.Where(BaronyCalc.ShowsOnDomainPanel)
            .OrderByDescending(BaronyCalc.IsVillage)
            .ThenBy(DisplayLabel, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private IEnumerable<TerrainImprovementDTO> ActiveImprovements =>
        VisibleImprovements.Where(i => i.IsActive);

    private List<PpbModifierRow> SectionRows =>
        BaronyCalc.ImprovementRows(Improvements, Tiles, Fiefs, VassalTributePercent);

    private PpbVector AdditiveSum => BaronyCalc.SumAdditive(SectionRows);
    private PpbVector PercentSum => BaronyCalc.SumPercent(SectionRows);
    private PpbVector Glance => BaronyCalc.SectionGlance(SectionRows);
    private int PopulationSum => ActiveImprovements.Sum(i => BaronyCalc.IsVillage(i) ? i.Population : 0);

    private static string DisplayLabel(TerrainImprovementDTO item) => BaronyCalc.ImprovementDisplayLabel(item);

    private PpbVector EffectiveAdditive(TerrainImprovementDTO item)
        => BaronyCalc.ApplyVassalVillageGoldShare(
            item, TilesById, FiefsById, VassalTributePercent, out _);

    private string? NameTooltip(TerrainImprovementDTO item)
    {
        if (BaronyCalc.IsVillage(item))
        {
            var palisade = item.HasPalisade
                ? "surrounded by a palisade"
                : "without a palisade";
            var owner = VillageOwnerName(item);
            var text = $"A village {palisade}, owned by lord {owner}.";
            if (!item.IsActive)
            {
                var inactive = string.IsNullOrWhiteSpace(item.InactiveReason)
                    ? "Inactive — excluded from totals."
                    : item.InactiveReason.Trim();
                text = $"{text}\n\n{inactive}";
            }

            return text;
        }

        if (item.IsActive)
            return null;
        return string.IsNullOrWhiteSpace(item.InactiveReason)
            ? "Inactive — excluded from totals."
            : item.InactiveReason.Trim();
    }

    private string VillageOwnerName(TerrainImprovementDTO item)
    {
        if (item.TileId is int tileId
            && TilesById.TryGetValue(tileId, out var tile)
            && tile.FiefId is int fiefId
            && FiefsById.TryGetValue(fiefId, out var fief)
            && !string.IsNullOrWhiteSpace(fief.LiegeName))
        {
            return fief.LiegeName.Trim();
        }

        return "unknown";
    }

    private string? VillageAdditiveTooltip(TerrainImprovementDTO item, Ppb key, PpbVector effective)
    {
        if (!BaronyCalc.IsVillage(item))
            return null;

        var baseTip = VillagePpbFormulas.ExplainAdditive(key, item.HasPalisade);
        if (key != Ppb.Treasury || !IsVassal(item))
            return baseTip;

        var full = item.Additive[Ppb.Treasury];
        var kept = effective[Ppb.Treasury];
        var shareTip = FiefTributeFormulas.ExplainVassalShare(full, VassalTributePercent, kept);
        return string.IsNullOrWhiteSpace(baseTip) ? shareTip : $"{baseTip}\n\n{shareTip}";
    }

    private bool IsVassal(TerrainImprovementDTO item)
    {
        if (item.TileId is not int tileId || !TilesById.TryGetValue(tileId, out var tile))
            return false;
        return BaronyCalc.IsVassalFiefTile(tile, FiefsById);
    }

    private async Task EditAsync(TerrainImprovementDTO item)
    {
        var draft = Clone(item);
        if (string.Equals(item.Name, MapImprovement.Village, StringComparison.OrdinalIgnoreCase))
        {
            await EditVillageAsync(draft);
            return;
        }

        var parameters = new DialogParameters<TerrainImprovementEditDialog>
        {
            { x => x.Improvement, draft },
        };

        var dialog = await _dialogService.ShowAsync<TerrainImprovementEditDialog>(
            "Edit Improvement",
            parameters,
            new DialogOptions
            {
                CloseOnEscapeKey = true,
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
            });

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not TerrainImprovementDTO saved)
            return;

        try
        {
            await _baronyRepo.SaveImprovement(saved);
            _snackBar.Add("Improvement updated.", Severity.Success);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _snackBar.Add("Could not save improvement: " + ex.Message, Severity.Error);
        }
    }

    private async Task EditPopulationAsync(TerrainImprovementDTO item)
    {
        if (!CanManage || item.Id <= 0 || !BaronyCalc.IsVillage(item))
            return;

        var parameters = new DialogParameters<PopulationEditDialog>
        {
            { x => x.TargetName, DisplayLabel(item) },
            { x => x.Value, item.Population },
        };

        var dialog = await _dialogService.ShowAsync<PopulationEditDialog>(
            "Population",
            parameters,
            new DialogOptions
            {
                CloseOnEscapeKey = true,
                MaxWidth = MaxWidth.ExtraSmall,
                FullWidth = true,
            });

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not int population)
            return;

        var draft = Clone(item);
        draft.Population = population;

        try
        {
            await _baronyRepo.SaveImprovement(draft);
            _snackBar.Add("Population updated.", Severity.Success);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _snackBar.Add("Could not save improvement: " + ex.Message, Severity.Error);
        }
    }

    private async Task EditVillageAsync(TerrainImprovementDTO draft)
    {
        var parameters = new DialogParameters<VillageEditDialog>
        {
            { x => x.Improvement, draft },
        };

        var dialog = await _dialogService.ShowAsync<VillageEditDialog>(
            "Edit village",
            parameters,
            new DialogOptions
            {
                CloseOnEscapeKey = true,
                MaxWidth = MaxWidth.ExtraSmall,
                FullWidth = true,
            });

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not TerrainImprovementDTO saved)
            return;

        try
        {
            await _baronyRepo.SaveImprovement(saved);
            _snackBar.Add("Village updated.", Severity.Success);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _snackBar.Add("Could not save village: " + ex.Message, Severity.Error);
        }
    }

    private static TerrainImprovementDTO Clone(TerrainImprovementDTO source) => new()
    {
        Id = source.Id,
        BaronyId = source.BaronyId,
        TileId = source.TileId,
        TemplateId = source.TemplateId,
        Name = source.Name,
        Description = source.Description,
        FormulaText = source.FormulaText,
        IsActive = source.IsActive,
        InactiveReason = source.InactiveReason,
        IconUrl = source.IconUrl,
        Population = source.Population,
        HasPalisade = source.HasPalisade,
        Additive = source.Additive.Clone(),
        Percent = source.Percent.Clone(),
    };

    private static string PpbShort(Ppb p) => p switch
    {
        Ppb.Food => "Food",
        Ppb.Economy => "Econ",
        Ppb.Production => "Prod",
        Ppb.Loyalty => "Loy",
        Ppb.Stability => "Stab",
        Ppb.Law => "Law",
        Ppb.Corruption => "Corr",
        Ppb.Science => "Sci",
        Ppb.Magic => "Mag",
        Ppb.Culture => "Cult",
        Ppb.Intelligence => "Intel",
        Ppb.Defense => "Def",
        Ppb.Treasury => "Gold",
        _ => p.ToString(),
    };

    private static string FmtAdd(decimal v) => PpbFormat.Additive(v);
    private static string FmtPct(decimal v) => PpbFormat.Percent(v);

    private static string PpbCellClass(Ppb key, decimal v, bool inactive)
    {
        var valueClass = PpbCellStyle.ValueClass(key, v);
        return inactive ? $"{valueClass} ppb-cell-inactive ppb-cell-struck" : valueClass;
    }

    private static string PopulationCellClass(int population, bool inactive, bool editable = false)
    {
        var cls = "city-building-col-pop " + PpbCellStyle.ValueClassStandard(population);
        if (inactive)
            cls += " ppb-cell-inactive ppb-cell-struck";
        if (editable)
            cls += " city-building-col-pop--editable";
        return cls;
    }
}
