@namespace DagoniteEmpire.Pages.Barony.Components
@inject IBaronyRepository _baronyRepo
@inject ISnackbar _snackBar
@inject IDialogService _dialogService

<BaronySection Title="City and Buildings">
    <Summary>
        <PpbSummaryChips Vector="@Glance" />
    </Summary>
    <ChildContent>
        <div style="overflow-x:auto;">
            <table class="ppb-table ppb-table--advisors ppb-table--city-buildings ppb-table--lined">
                <thead>
                    <tr>
                        <th rowspan="2" class="ppb-row-label city-building-col-name">Name</th>
                        @foreach (var info in PpbCatalog.All)
                        {
                            <th colspan="2" title="@info.Code">@PpbShort(info.Key)</th>
                        }
                    </tr>
                    <tr>
                        @foreach (var _ in PpbCatalog.All)
                        {
                            <th class="ppb-subcol ppb-subcol--add">+</th>
                            <th class="ppb-subcol ppb-subcol--pct">%</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var core in CoreBuildings)
                    {
                        <tr class="city-building-row--core">
                            <td class="city-building-col-name">
                                <div class="city-building-name-cell">
                                    <span class="city-building-name-text">@RenderNameText(core.Name, core.Description)</span>
                                </div>
                            </td>
                            @foreach (var info in PpbCatalog.All)
                            {
                                <td class="@ValueClass(core.Additive[info.Key])">@FmtAdd(core.Additive[info.Key])</td>
                                <td class="@ValueClass(core.Percent[info.Key])">@FmtPct(core.Percent[info.Key])</td>
                            }
                        </tr>
                    }

                    @foreach (var building in SavedBuildings)
                    {
                        <tr>
                            <td class="city-building-col-name">
                                <div class="city-building-name-cell">
                                    <span class="city-building-name-text">@RenderNameText(building.Name, building.Description)</span>
                                    @if (CanManage)
                                    {
                                        <span class="city-building-name-actions">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Size="Size.Small"
                                                           title="Edit building"
                                                           OnClick="@(() => EditBuildingAsync(building))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Size="Size.Small"
                                                           Color="Color.Error"
                                                           title="Remove building"
                                                           OnClick="@(() => DeleteBuildingAsync(building))" />
                                        </span>
                                    }
                                </div>
                            </td>
                            @foreach (var info in PpbCatalog.All)
                            {
                                <td class="@ValueClass(building.Additive[info.Key])">@FmtAdd(building.Additive[info.Key])</td>
                                <td class="@ValueClass(building.Percent[info.Key])">@FmtPct(building.Percent[info.Key])</td>
                            }
                        </tr>
                    }

                    <tr class="ppb-summary-row">
                        <td class="ppb-row-label city-building-col-name">Σ section</td>
                        @foreach (var info in PpbCatalog.All)
                        {
                            <td class="@ValueClass(AdditiveSum[info.Key])"><b>@FmtAdd(AdditiveSum[info.Key])</b></td>
                            <td class="@ValueClass(PercentSum[info.Key])"><b>@FmtPct(PercentSum[info.Key])</b></td>
                        }
                    </tr>
                </tbody>
            </table>
        </div>

        @if (CanManage)
        {
            <div class="d-flex flex-wrap gap-2 mt-3">
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddBuildingAsync">
                    Add Building
                </MudButton>
            </div>
        }
    </ChildContent>
</BaronySection>

@code {
    [Parameter] public int BaronyId { get; set; }
    [Parameter] public List<BaronyBuildingDTO> SavedBuildings { get; set; } = new();
    [Parameter] public List<BuildingTemplateDTO> Catalog { get; set; } = new();
    [Parameter] public bool CanManage { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private IReadOnlyList<BaronyBuildingDTO> CoreBuildings => BaronyCalc.CoreCityBuildings(BaronyId);

    private PpbVector AdditiveSum => BaronyCalc.SumCityBuildings(BaronyId, SavedBuildings);
    private PpbVector PercentSum => BaronyCalc.SumCityBuildingsPercent(BaronyId, SavedBuildings);
    private PpbVector Glance => BaronyCalc.SectionGlance(BaronyCalc.CityBuildingSectionRows(BaronyId, SavedBuildings));

    private RenderFragment RenderNameText(string name, string? description) => builder =>
    {
        var display = string.IsNullOrWhiteSpace(name) ? "—" : name;
        if (string.IsNullOrWhiteSpace(description))
        {
            builder.AddContent(0, display);
            return;
        }

        builder.OpenComponent<MudTooltip>(0);
        builder.AddAttribute(1, "Text", description);
        builder.AddAttribute(2, "Placement", Placement.Top);
        builder.AddAttribute(3, "Arrow", true);
        builder.AddAttribute(4, "ChildContent", (RenderFragment)(b => b.AddContent(0, display)));
        builder.CloseComponent();
    };

    private async Task AddBuildingAsync()
    {
        await OpenBuildingDialog(new BaronyBuildingDTO
        {
            BaronyId = BaronyId,
            Kind = BuildingKind.Building,
        }, isNew: true);
    }

    private Task EditBuildingAsync(BaronyBuildingDTO building)
        => OpenBuildingDialog(CloneBuilding(building), isNew: false);

    private async Task OpenBuildingDialog(BaronyBuildingDTO draft, bool isNew)
    {
        var parameters = new DialogParameters<CityBuildingEditDialog>
        {
            { x => x.Building, draft },
            { x => x.Catalog, Catalog },
        };

        var dialog = await _dialogService.ShowAsync<CityBuildingEditDialog>(
            isNew ? "Add Building" : "Edit Building",
            parameters,
            DialogOptions());

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not BaronyBuildingDTO saved)
            return;

        if (string.IsNullOrWhiteSpace(saved.Name))
        {
            _snackBar.Add("Building name is required.", Severity.Warning);
            return;
        }

        saved.BaronyId = BaronyId;

        try
        {
            await _baronyRepo.SaveBuilding(saved);
            _snackBar.Add(isNew ? "Building added." : "Building updated.", Severity.Success);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _snackBar.Add("Could not save building: " + ex.Message, Severity.Error);
        }
    }

    private async Task DeleteBuildingAsync(BaronyBuildingDTO building)
    {
        if (building.Id <= 0)
            return;

        try
        {
            await _baronyRepo.DeleteBuilding(building.Id);
            _snackBar.Add("Building removed.", Severity.Success);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _snackBar.Add("Could not remove building: " + ex.Message, Severity.Error);
        }
    }

    private static BaronyBuildingDTO CloneBuilding(BaronyBuildingDTO source) => new()
    {
        Id = source.Id,
        BaronyId = source.BaronyId,
        TemplateId = source.TemplateId,
        Name = source.Name,
        Kind = source.Kind,
        Description = source.Description,
        Additive = source.Additive.Clone(),
        Percent = source.Percent.Clone(),
    };

    private static DialogOptions DialogOptions() => new()
    {
        MaxWidth = MaxWidth.False,
        FullWidth = false,
        CloseOnEscapeKey = true,
    };

    private static string PpbShort(Ppb p) => p switch
    {
        Ppb.Food => "Food",
        Ppb.Economy => "Econ",
        Ppb.Production => "Prod",
        Ppb.Loyalty => "Loy",
        Ppb.Stability => "Stab",
        Ppb.Law => "Law",
        Ppb.Corruption => "Corr",
        Ppb.Science => "Sci",
        Ppb.Magic => "Mag",
        Ppb.Culture => "Cult",
        Ppb.Intelligence => "Intel",
        Ppb.Defense => "Def",
        Ppb.Treasury => "Gold",
        _ => p.ToString(),
    };

    private static string FmtAdd(decimal v)
    {
        if (v == 0m)
            return "·";
        return (v > 0 ? "+" : "") + Num(v);
    }

    private static string FmtPct(decimal v)
    {
        if (v == 0m)
            return "·";
        return (v > 0 ? "+" : "") + Num(v) + "%";
    }

    private static string Num(decimal v)
    {
        var r = decimal.Round(v, 2);
        return r == decimal.Truncate(r) ? ((long)r).ToString() : r.ToString("0.##");
    }

    private static string ValueClass(decimal v)
    {
        if (v > 0m) return "ppb-cell-pos";
        if (v < 0m) return "ppb-cell-neg";
        return "ppb-cell-zero";
    }
}
