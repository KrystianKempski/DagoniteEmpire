@namespace DagoniteEmpire.Pages.Barony.Components
@inject ISnackbar _snackBar

<MudDialog Class="baron-influence-dialog"
           ContentClass="baron-influence-dialog-content"
           ActionsClass="baron-influence-dialog-actions">
    <DialogContent>
        <div class="barony-dialog-theme baron-influence-edit-dialog">
            <MudTextField @bind-Value="_name"
                          Label="Akcja"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="baron-influence-field"
                          Required="true"
                          Disabled="@Action.IsSystem" />

            <MudSelect T="string"
                       @bind-Value="_kind"
                       Label="Typ"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Class="baron-influence-field"
                       Dense="true"
                       Disabled="@Action.IsSystem">
                @foreach (var kind in KindOptions)
                {
                    <MudSelectItem Value="@kind">@kind</MudSelectItem>
                }
            </MudSelect>

            <MudNumericField @bind-Value="_costJc"
                             Label="Koszt (BT)"
                             HelperText="@CostHint"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Class="baron-influence-field"
                             Min="0" />

            <MudTextField @bind-Value="_description"
                          Label="Opis"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="2"
                          Class="baron-influence-field" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">Anuluj</MudButton>
        <MudButton Class="baron-influence-save-btn" Variant="Variant.Filled" OnClick="Save">Zapisz</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public BaronTimeActionDTO Action { get; set; } = new();

    private string _name = string.Empty;
    private string _kind = BaronTimeActionKind.Other;
    private int _costJc;
    private string? _description;

    private IEnumerable<string> KindOptions =>
        Action.IsSystem
            ? new[] { BaronTimeActionKind.Management }
            : BaronTimeActionKind.All.Where(k => k != BaronTimeActionKind.Management);

    private string CostHint =>
        _kind == BaronTimeActionKind.Adventure
            ? $"Cotygodniowa wyprawa ≈ {BaronTimeRules.WeeklyExpeditionJc} BT "
              + $"(bezpieczne maks. {BaronTimeRules.MaxSafeExpeditionWeeks} tygodni / {BaronTimeRules.MaxSafeExpeditionJc} BT)."
            : _kind == BaronTimeActionKind.Hunt
                ? $"Wielkie Polowanie: co najmniej {BaronTimeSuggestedCosts.GreatHuntJc} BT + "
                  + $"{BaronTimeSuggestedCosts.GreatHuntProduction} Produkcji + {BaronTimeSuggestedCosts.GreatHuntGold} złota."
            : _kind == BaronTimeActionKind.Management
                ? $"Wymagane w każdej turze: {BaronTimeRules.RequiredManagementJc} BT."
                : "BT wydane na tę akcję w tej turze.";

    protected override void OnInitialized()
    {
        _name = Action.Name;
        _kind = string.IsNullOrWhiteSpace(Action.Kind) ? BaronTimeActionKind.Other : Action.Kind;
        _costJc = Action.CostJc;
        _description = Action.Description;
    }

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            _snackBar.Add("Nazwa akcji jest wymagana.", Severity.Warning);
            return;
        }

        if (!Action.IsSystem)
        {
            Action.Name = _name.Trim();
            Action.Kind = string.IsNullOrWhiteSpace(_kind) ? BaronTimeActionKind.Other : _kind;
        }

        Action.CostJc = Math.Max(0, _costJc);
        Action.Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim();
        MudDialog.Close(DialogResult.Ok(Action));
    }
}
