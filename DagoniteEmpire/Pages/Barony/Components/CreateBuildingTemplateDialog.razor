@namespace DagoniteEmpire.Pages.Barony.Components
@inject ISnackbar _snackBar

<MudDialog Class="baron-influence-dialog"
           ContentClass="baron-influence-dialog-content"
           ActionsClass="baron-influence-dialog-actions">
    <TitleContent>
        <MudText Typo="Typo.h6">@DialogTitle</MudText>
    </TitleContent>
    <DialogContent>
        <div class="barony-dialog-theme baron-influence-edit-dialog city-building-edit-dialog">
            <MudTextField @bind-Value="_name"
                          Label="@(L["Name"])"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Required="true"
                          Immediate="true"
                          Class="baron-influence-field" />

            <div class="building-template-dialog__row">
                <MudNumericField T="int"
                                 @bind-Value="_lordship"
                                 Label="@(L["Lordship"])"
                                 HelperText="@(L["Minimum lordship level required."])"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="0"
                                 Max="10"
                                 Class="baron-influence-field building-template-dialog__lordship" />
                <MudSelect T="string"
                           Label="@(L["Type"])"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true"
                           Class="baron-influence-field building-template-dialog__kind"
                           @bind-Value="_kind">
                    <MudSelectItem Value="@BuildingKind.Building">@L["Building"]</MudSelectItem>
                    <MudSelectItem Value="@BuildingKind.Improvement">@L["Improvement"]</MudSelectItem>
                </MudSelect>
            </div>

            <div class="building-template-dialog__row">
                <MudNumericField T="decimal"
                                 @bind-Value="_productionCost"
                                 Label="@(L["Production cost"])"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="0"
                                 Class="baron-influence-field building-template-dialog__cost" />
                <MudNumericField T="decimal"
                                 @bind-Value="_goldCost"
                                 Label="@(L["Gold cost"])"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="0"
                                 Class="baron-influence-field building-template-dialog__cost" />
            </div>

            <MudTextField @bind-Value="_description"
                          Label="@(L["Description"])"
                          HelperText="@(L["Shown in the catalog (tooltips). Use separate lines for Produces / Requires trade access."])"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="4"
                          Class="baron-influence-field" />

            @if (IsImprovement)
            {
                <MudSelect T="string"
                           Label="@(L["Terrain requirement"])"
                           HelperText="@(L["Where this can be built on the map (catalog hint)."])"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true"
                           Class="baron-influence-field"
                           @bind-Value="_terrainPreset">
                    @foreach (var preset in TerrainPresets)
                    {
                        <MudSelectItem Value="@preset">@(string.IsNullOrEmpty(preset) ? "— (none)" : preset)</MudSelectItem>
                    }
                </MudSelect>

                <MudText Typo="Typo.caption" Class="mb-1" Style="color:var(--barony-muted);">@L["Map icon"]</MudText>
                <div class="custom-improvement-icon-picker">
                    @foreach (var icon in MapImprovement.IconChoices)
                    {
                        var url = icon;
                        var selected = string.Equals(_iconUrl, url, StringComparison.OrdinalIgnoreCase);
                        <BaronyTooltip Text="@url">
                            <button type="button"
                                    class="custom-improvement-icon-picker__btn @(selected ? "custom-improvement-icon-picker__btn--selected" : "")"
                                    aria-label="@url"
                                    @onclick="() => OnIconSelected(url)">
                                <img src="@url" alt="" class="custom-improvement-icon-picker__img" />
                            </button>
                        </BaronyTooltip>
                    }
                </div>
            }

            <PpbVectorEditor @bind-Value="_additive" Title="@(L["PPB additive (+)"])" Compact="true" />
            <PpbVectorEditor @bind-Value="_percent" Title="@(L["PPB percent (%)"])" Compact="true" Percent="true" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Class="baron-influence-save-btn" Variant="Variant.Filled" OnClick="Save">@SaveButtonLabel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly string[] TerrainPresets =
    {
        "",
        "Water",
        "Plains",
        "Hills",
        "Forest",
        "Dense forest",
        "Swamp",
        "Coast or river",
    };

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string? DefaultKind { get; set; }
    [Parameter] public IReadOnlySet<string> ExistingNames { get; set; } = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    [Parameter] public BuildingTemplateDTO? InitialTemplate { get; set; }

    private int _templateId;
    private string _name = string.Empty;
    private int _lordship = 1;
    private string _kind = BuildingKind.Building;
    private decimal _productionCost;
    private decimal _goldCost;
    private string? _description;
    private string _mapPinKind = MapImprovement.Farm;
    private string _terrainPreset = "";
    private string _iconUrl = MapImprovement.IconUrl(MapImprovement.Farm);
    private PpbVector _additive = new();
    private PpbVector _percent = new();

    private bool IsImprovement =>
        string.Equals(_kind, BuildingKind.Improvement, StringComparison.OrdinalIgnoreCase);
    private bool IsEditMode => _templateId > 0;
    private string DialogTitle => IsEditMode ? "Edit catalog entry" : "New catalog entry";
    private string SaveButtonLabel => IsEditMode ? "Save" : "Create";

    protected override void OnInitialized()
    {
        if (InitialTemplate is not null)
        {
            _templateId = InitialTemplate.Id;
            _name = InitialTemplate.Name;
            _lordship = Math.Max(0, InitialTemplate.RequiredLordshipLevel);
            _kind = string.IsNullOrWhiteSpace(InitialTemplate.Kind) ? BuildingKind.Building : InitialTemplate.Kind;
            _productionCost = Math.Max(0, InitialTemplate.ProductionCost);
            _goldCost = Math.Max(0, InitialTemplate.GoldCost);
            _description = InitialTemplate.Description;
            var initialTerrain = NormalizeTerrainRequirement(
                string.IsNullOrWhiteSpace(InitialTemplate.TerrainRequirement) ? "" : InitialTemplate.TerrainRequirement.Trim());
            _terrainPreset = TerrainPresets.Contains(initialTerrain, StringComparer.Ordinal)
                ? initialTerrain
                : "";
            _additive = InitialTemplate.EffectAdditive?.Clone() ?? new PpbVector();
            _percent = InitialTemplate.EffectPercent?.Clone() ?? new PpbVector();
            _mapPinKind = !string.IsNullOrWhiteSpace(InitialTemplate.MapPinKind)
                ? InitialTemplate.MapPinKind.Trim()
                : MapPinKindFromIcon(InitialTemplate.IconUrl) ?? MapImprovement.Farm;
            _iconUrl = !string.IsNullOrWhiteSpace(InitialTemplate.IconUrl)
                ? InitialTemplate.IconUrl.Trim()
                : MapImprovement.IconUrl(_mapPinKind);
        }
        else if (!string.IsNullOrWhiteSpace(DefaultKind)
                 && (DefaultKind == BuildingKind.Building || DefaultKind == BuildingKind.Improvement))
        {
            _kind = DefaultKind;
        }

        if (IsImprovement && InitialTemplate is null)
            _terrainPreset = "";
    }

    private void OnIconSelected(string url)
    {
        _iconUrl = url;
        var inferredPin = MapPinKindFromIcon(url);
        if (!string.IsNullOrWhiteSpace(inferredPin))
            _mapPinKind = inferredPin;
    }

    private static string? MapPinKindFromIcon(string? iconUrl)
    {
        if (string.IsNullOrWhiteSpace(iconUrl))
            return null;

        foreach (var pin in MapImprovement.All)
        {
            if (string.Equals(MapImprovement.IconUrl(pin), iconUrl.Trim(), StringComparison.OrdinalIgnoreCase))
                return pin;
        }

        return null;
    }

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        var trimmedName = _name.Trim();
        if (string.IsNullOrWhiteSpace(trimmedName))
        {
            _snackBar.Add("Name is required.", Severity.Warning);
            return;
        }

        if (ExistingNames.Contains(trimmedName)
            && !string.Equals(trimmedName, InitialTemplate?.Name, StringComparison.OrdinalIgnoreCase))
        {
            _snackBar.Add("A catalog entry with this name already exists.", Severity.Warning);
            return;
        }

        if (IsImprovement && string.IsNullOrWhiteSpace(_mapPinKind))
        {
            _snackBar.Add("Select an icon for improvements.", Severity.Warning);
            return;
        }

        string? terrainRequirement = IsImprovement
            ? NormalizeTerrainRequirement(_terrainPreset)
            : null;

        var dto = new BuildingTemplateDTO
        {
            Id = _templateId,
            Name = trimmedName,
            IsCustom = IsEditMode ? (InitialTemplate?.IsCustom ?? true) : true,
            RequiredLordshipLevel = Math.Max(0, _lordship),
            Kind = _kind,
            ProductionCost = Math.Max(0, _productionCost),
            GoldCost = Math.Max(0, _goldCost),
            Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
            TerrainRequirement = terrainRequirement,
            MapPinKind = IsImprovement ? _mapPinKind : null,
            IconUrl = IsImprovement ? _iconUrl : null,
            EffectAdditive = _additive.Clone(),
            EffectPercent = _percent.Clone(),
        };

        MudDialog.Close(DialogResult.Ok(dto));
    }

    private static string NormalizeTerrainRequirement(string? value) => value?.Trim() switch
    {
        "Woda" => "Water",
        "Równiny" => "Plains",
        "Wzgórza" => "Hills",
        "Las" => "Forest",
        "Gęsty las" => "Dense forest",
        "Bagna" => "Swamp",
        "Wybrzeże lub rzeka" => "Coast or river",
        _ => value?.Trim() ?? string.Empty,
    };
}
