@namespace DagoniteEmpire.Pages.Barony.Components

<div class="resource-stocks-hero">
    @foreach (var info in ResourceCatalog.All)
    {
        var v = Stocks[info.Key];
        var color = ResourceCatalog.ColorKey(info.Key);
        <BaronyTooltip Text="@info.NamePl" Class="resource-stocks-hero__tip">
            <div class="resource-stocks-hero__item resource-stocks-hero__item--@color">
                <span class="resource-stocks-hero__label">@info.NamePl</span>
                <span class="resource-stocks-hero__value">@PpbFormat.Number(v)</span>
            </div>
        </BaronyTooltip>
    }
</div>

@code {
    [Parameter] public PpbVector Stocks { get; set; } = new();
}
