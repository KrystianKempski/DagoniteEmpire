@namespace DagoniteEmpire.Pages.Barony.Components

<BaronySection Title="@(L["Community Penalties and Bonuses"])">
    <Summary>
        <PpbSummaryChips Vector="@Glance" />
    </Summary>
    <ChildContent>
        @if (RowList.Count == 0)
        {
            <MudText Typo="Typo.body2" Style="color:var(--barony-muted);">@L["No entries in this section."]</MudText>
        }
        else
        {
            <div style="overflow-x:auto;">
                <table class="ppb-table ppb-table--advisors ppb-table--community ppb-table--lined">
                    <colgroup>
                        <col class="community-col-source" />
                        @foreach (var _ in PpbCatalog.All)
                        {
                            <col class="ppb-pair-col" />
                            <col class="ppb-pair-col" />
                        }
                    </colgroup>
                    <thead>
                        <tr>
                            <th rowspan="2" class="ppb-row-label community-col-source">@L["Source"]</th>
                            @foreach (var info in PpbCatalog.All)
                            {
                                <th colspan="2"><BaronyTooltip Text="@info.Name">@PpbShort(info.Key)</BaronyTooltip></th>
                            }
                        </tr>
                        <tr>
                            @foreach (var _ in PpbCatalog.All)
                            {
                                <th class="ppb-subcol ppb-subcol--add">+</th>
                                <th class="ppb-subcol ppb-subcol--pct">%</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in RowList)
                        {
                            var sourceKey = CommunitySource.NormalizeKey(row.Label);
                            var addExplain = AdditiveExplain(sourceKey);
                            var pctExplain = PercentExplain(sourceKey);
                            <tr>
                                <td class="ppb-row-label community-col-source">
                                    @if (!string.IsNullOrWhiteSpace(row.Formula) || !string.IsNullOrWhiteSpace(row.Note))
                                    {
                                        <BaronyTooltip Title="@L[row.Label]" Text="@(row.Note is null ? row.Formula! : $"{row.Note}\n\n{row.Formula}")">
                                            <span>@L[row.Label]</span>
                                        </BaronyTooltip>
                                    }
                                    else
                                    {
                                        @L[row.Label]
                                    }
                                </td>
                                @foreach (var info in PpbCatalog.All)
                                {
                                    var add = row.Additive[info.Key];
                                    var pct = row.Percent[info.Key];
                                    var addTip = addExplain?.Invoke(info.Key);
                                    var pctTip = pctExplain?.Invoke(info.Key);
                                    <td class="@PpbCellStyle.ValueClass(info.Key, add)">
                                        @if (addTip is not null)
                                        {
                                            <BaronyTooltip Title="@info.Name" Text="@addTip"><span>@FmtAdd(add)</span></BaronyTooltip>
                                        }
                                        else
                                        {
                                            @FmtAdd(add)
                                        }
                                    </td>
                                    <td class="@PpbCellStyle.ValueClass(info.Key, pct)">
                                        @if (pctTip is not null)
                                        {
                                            <BaronyTooltip Title="@info.Name" Text="@pctTip"><span>@FmtPct(pct)</span></BaronyTooltip>
                                        }
                                        else
                                        {
                                            @FmtPct(pct)
                                        }
                                    </td>
                                }
                            </tr>
                        }
                        <tr class="ppb-summary-row">
                            <td class="ppb-row-label community-col-source">@L["Σ section"]</td>
                            @foreach (var info in PpbCatalog.All)
                            {
                                <td class="@PpbCellStyle.ValueClass(info.Key, AdditiveSum[info.Key])"><b>@FmtAdd(AdditiveSum[info.Key])</b></td>
                                <td class="@PpbCellStyle.ValueClass(info.Key, PercentSum[info.Key])"><b>@FmtPct(PercentSum[info.Key])</b></td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    </ChildContent>
</BaronySection>

@code {
    [Parameter] public IEnumerable<PpbModifierRow>? Rows { get; set; }

    private List<PpbModifierRow> RowList => Rows?.ToList() ?? new();
    private PpbVector AdditiveSum => BaronyCalc.SumAdditive(RowList);
    private PpbVector PercentSum => BaronyCalc.SumPercent(RowList);
    private PpbVector Glance => BaronyCalc.SectionGlance(RowList);

    private static Func<Ppb, string?>? AdditiveExplain(string sourceKey) => sourceKey switch
    {
        CommunitySource.Hunger => HungerPpbFormulas.ExplainAdditive,
        CommunitySource.Crime => CrimePpbFormulas.ExplainAdditive,
        CommunitySource.Corruption => CorruptionPpbFormulas.ExplainAdditive,
        CommunitySource.Unrest => UnrestPpbFormulas.ExplainAdditive,
        CommunitySource.Economy => EconomyConjunctureFormulas.ExplainAdditive,
        _ => null,
    };

    private static Func<Ppb, string?>? PercentExplain(string sourceKey) => sourceKey switch
    {
        CommunitySource.Hunger => HungerPpbFormulas.ExplainPercent,
        CommunitySource.Crime => CrimePpbFormulas.ExplainPercent,
        CommunitySource.Corruption => CorruptionPpbFormulas.ExplainPercent,
        CommunitySource.Unrest => UnrestPpbFormulas.ExplainPercent,
        CommunitySource.Economy => EconomyConjunctureFormulas.ExplainPercent,
        _ => null,
    };

    private static string PpbShort(Ppb p) => PpbCatalog.Short(p);

    private static string FmtAdd(decimal v) => PpbFormat.Additive(v);
    private static string FmtPct(decimal v) => PpbFormat.Percent(v);
}
