@namespace DagoniteEmpire.Pages.Barony.Components
@inject ISnackbar _snackBar

<MudDialog Class="baron-influence-dialog"
           ContentClass="baron-influence-dialog-content"
           ActionsClass="baron-influence-dialog-actions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsEdit ? "Edytuj domenę" : "Dodaj domenę")</MudText>
    </TitleContent>
    <DialogContent>
        <div class="barony-dialog-theme baron-influence-edit-dialog">
            <MudTextField @bind-Value="_name"
                          Label="Nazwa domeny"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="baron-influence-field"
                          Required="true" />
            <MudTextField @bind-Value="_lordName"
                          Label="Imię lorda"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="baron-influence-field"
                          Required="true" />
            <MudText Typo="Typo.caption" Style="color:var(--barony-muted);">Kolor domeny</MudText>
            <div class="terrain-domain-color-row">
                @foreach (var swatch in Swatches)
                {
                    <BaronyTooltip Text="@swatch">
                        <button type="button"
                                class="terrain-fertility-swatch @(swatch == _colorHex ? "terrain-fertility-swatch--selected" : "")"
                                style="background-color: @swatch"
                                aria-label="@($"Kolor {swatch}")"
                                @onclick="() => _colorHex = swatch"></button>
                    </BaronyTooltip>
                }
                <BaronyTooltip Text="Własny kolor">
                    <label class="terrain-domain-custom-color">
                        <input type="color"
                               class="terrain-domain-color-input"
                               value="@_colorHex"
                               @onchange="OnCustomColorChanged" />
                    </label>
                </BaronyTooltip>
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">Anuluj</MudButton>
        <MudButton Class="baron-influence-save-btn" Variant="Variant.Filled" OnClick="Save">@(IsEdit ? "Zapisz" : "Dodaj")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public TerrainMapDomainDTO? EditDomain { get; set; }

    private bool IsEdit => EditDomain is not null;
    private string _name = string.Empty;
    private string _lordName = string.Empty;
    private string _colorHex = "#c0392b";

    protected override void OnParametersSet()
    {
        if (EditDomain is null)
            return;

        _name = EditDomain.Name;
        _lordName = EditDomain.LordName;
        _colorHex = EditDomain.ColorHex;
    }

    private static readonly string[] Swatches =
    {
        "#c0392b", "#e67e22", "#f1c40f", "#27ae60",
        "#2980b9", "#8e44ad", "#7f8c8d", "#9c7a33",
    };

    private void Cancel() => MudDialog.Cancel();

    private void OnCustomColorChanged(ChangeEventArgs e)
    {
        if (e.Value is string value && !string.IsNullOrWhiteSpace(value))
            _colorHex = value;
    }

    private void Save()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            _snackBar.Add("Nazwa domeny jest wymagana.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_lordName))
        {
            _snackBar.Add("Imię lorda jest wymagane.", Severity.Warning);
            return;
        }

        var dto = EditDomain ?? new TerrainMapDomainDTO { SortOrder = 100 };
        dto.Name = _name.Trim();
        dto.LordName = _lordName.Trim();
        dto.ColorHex = _colorHex;
        MudDialog.Close(DialogResult.Ok(dto));
    }
}
