@namespace DagoniteEmpire.Pages.Barony.Components
@inject IBaronyRepository _baronyRepo
@inject ISnackbar _snackBar
@inject IDialogService _dialogService

<BaronySection Title="@(L[Category])">
    <Summary>
        <span class="projects-summary__item">@(Ordered.Count == 1 ? L["{0} contact", Ordered.Count] : L["{0} contacts", Ordered.Count])</span>
    </Summary>
    <ChildContent>
        @if (Ordered.Count == 0)
        {
            <MudText Typo="Typo.body2" Style="color:var(--barony-muted);">
                @L["No contacts in this section."]
                @if (CanManage)
                {
                    <text> @L["Add one below."]</text>
                }
            </MudText>
        }
        else
        {
            <div style="overflow-x:auto;">
                <table class="ppb-table ppb-table--lined relations-table">
                    <colgroup>
                        <col class="relations-col-group" />
                        <col class="relations-col-name" />
                        <col class="relations-col-title" />
                        <col class="relations-col-age" />
                        <col class="relations-col-desc" />
                        <col class="relations-col-troops" />
                        <col class="relations-col-attitude" />
                        <col class="relations-col-mods" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="relations-col-group">@L["Group"]</th>
                            <th class="relations-col-name">@L["Name"]</th>
                            <th class="relations-col-title">@L["Title"]</th>
                            <th class="relations-col-age">@L["Age"]</th>
                            <th class="relations-col-desc">@L["Description"]</th>
                            <th class="relations-col-troops">@L["Troops"]</th>
                            <th class="relations-col-attitude">@L["Attitude"]</th>
                            <th class="relations-col-mods">@L["Modifiers"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in Groups)
                        {
                            @for (var i = 0; i < group.Items.Count; i++)
                            {
                                var item = group.Items[i];
                                var showGroup = i == 0;
                                <tr>
                                    @if (showGroup)
                                    {
                                        <td class="relations-col-group relations-group-cell" rowspan="@group.Items.Count">
                                            @(string.IsNullOrWhiteSpace(group.Name) ? "—" : group.Name)
                                        </td>
                                    }
                                    <td class="relations-col-name">
                                        <div class="known-lords-name-cell">
                                            <CharacterMarkBadge Marks="@item.Marks" />
                                            <span class="known-lords-name-text">@item.Name</span>
                                            <span class="city-building-name-actions">
                                                @if (CanEdit)
                                                {
                                                    <CharacterMarkPicker Marks="@item.Marks"
                                                                         CanEdit="true"
                                                                         OnMarksChanged="marks => SaveRelationMarksAsync(item, marks)" />
                                                    <BaronyTooltip Text="@NotesTooltip(item.Notes)">
                                                        <MudIconButton Icon="@Icons.Material.Filled.EditNote"
                                                                       Size="Size.Small"
                                                                       Class="@NotesButtonClass(item.Notes)"
                                                                       OnClick="@(() => EditNotesAsync(item))" />
                                                    </BaronyTooltip>
                                                }
                                                else if (!string.IsNullOrWhiteSpace(item.Notes))
                                                {
                                                    <BaronyTooltip Title="@(L["Notes"])" Text="@item.Notes">
                                                        <MudIcon Icon="@Icons.Material.Filled.EditNote"
                                                                 Size="Size.Small"
                                                                 Class="known-lords-notes-icon known-lords-notes-icon--filled" />
                                                    </BaronyTooltip>
                                                }
                                                @if (CanManage)
                                                {
                                                    <BaronyTooltip Text="@(L["Edit Relation"])">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                                       Size="Size.Small"
                                                                       OnClick="@(() => EditAsync(item))" />
                                                    </BaronyTooltip>
                                                    <BaronyTooltip Text="@(L["Remove relation"])">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                       Size="Size.Small"
                                                                       Color="Color.Error"
                                                                       OnClick="@(() => DeleteAsync(item))" />
                                                    </BaronyTooltip>
                                                }
                                            </span>
                                        </div>
                                    </td>
                                    <td class="relations-col-title">@(string.IsNullOrWhiteSpace(item.Title) ? "—" : item.Title)</td>
                                    <td class="relations-col-age">@(item.Age?.ToString() ?? "—")</td>
                                    <td class="relations-col-desc">
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <BaronyTooltip Title="@(L["Description"])" Text="@item.Description">
                                                <span class="known-lords-desc-text">@item.Description</span>
                                            </BaronyTooltip>
                                        }
                                        else
                                        {
                                            <span>—</span>
                                        }
                                    </td>
                                    <td class="relations-col-troops">@item.TroopCount</td>
                                    <td class="relations-col-attitude">
                                        <BaronyTooltip Title="@(L["Attitude"])" Text="@ModifiersTooltip(item)">
                                            <span class="@AttitudeClass(item.Attitude)">
                                                <span class="relations-attitude-score">@FormatAttitude(item.Attitude)</span>
                                                <span class="relations-attitude-label">@item.AttitudeLabel</span>
                                            </span>
                                        </BaronyTooltip>
                                    </td>
                                    <td class="relations-col-mods">
                                        <div class="relations-mods-cell">
                                            <BaronyTooltip Title="@(L["Modifiers"])" Text="@ModifiersTooltip(item)">
                                                <span class="relations-mods-count">@item.Modifiers.Count</span>
                                            </BaronyTooltip>
                                            @if (CanManage)
                                            {
                                                <BaronyTooltip Text="@(L["Edit Modifiers"])">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Tune"
                                                                   Size="Size.Small"
                                                                   OnClick="@(() => EditModifiersAsync(item))" />
                                                </BaronyTooltip>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (CanManage)
        {
            <div class="d-flex flex-wrap gap-2 mt-3">
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddAsync">
                    @L["Add…"]
                </MudButton>
            </div>
        }
    </ChildContent>
</BaronySection>

@code {
    [Parameter] public int BaronyId { get; set; }
    [Parameter] public string Category { get; set; } = RelationCategory.Acquaintances;
    [Parameter] public List<BaronyRelationDTO> Relations { get; set; } = new();
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanManage { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<BaronyRelationDTO> Ordered =>
        Relations
            .Where(r => string.Equals(r.Category, Category, StringComparison.Ordinal))
            .OrderBy(r => r.SortOrder)
            .ThenBy(r => r.GroupName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(r => r.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private IEnumerable<RelationGroup> Groups =>
        Ordered
            .GroupBy(r => r.GroupName ?? "", StringComparer.OrdinalIgnoreCase)
            .Select(g => new RelationGroup(g.Key, g.ToList()));

    private async Task AddAsync()
    {
        var draft = new BaronyRelationDTO
        {
            BaronyId = BaronyId,
            Category = Category,
            SortOrder = Ordered.Count == 0 ? 0 : Ordered.Max(r => r.SortOrder) + 1,
        };
        await OpenEditAsync(draft, isNew: true);
    }

    private async Task EditAsync(BaronyRelationDTO item) => await OpenEditAsync(Clone(item), isNew: false);

    private async Task OpenEditAsync(BaronyRelationDTO draft, bool isNew)
    {
        var parameters = new DialogParameters<RelationEditDialog>
        {
            { x => x.Relation, draft },
            { x => x.AllRelations, Relations },
        };

        var dialog = await _dialogService.ShowAsync<RelationEditDialog>(
            isNew ? L["Add Relation"] : L["Edit Relation"],
            parameters,
            new DialogOptions
            {
                CloseOnEscapeKey = true,
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
            });

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not BaronyRelationDTO saved)
            return;

        try
        {
            await _baronyRepo.SaveRelation(saved);
            _snackBar.Add(isNew ? L["Relation added."] : L["Relation updated."], Severity.Success);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _snackBar.Add(L["Could not save relation: "] + ex.Message, Severity.Error);
        }
    }

    private async Task SaveRelationMarksAsync(BaronyRelationDTO item, IReadOnlyList<BaronyCharacterMarkDTO> marks)
    {
        try
        {
            var normalized = BaronyCharacterMarkDTO.NormalizeList(marks);
            await _baronyRepo.SaveRelationMarks(item.Id, normalized);
            _snackBar.Add(normalized.Count > 0 ? L["Marks updated."] : L["Marks cleared."], Severity.Success);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _snackBar.Add(L["Could not save marks: "] + ex.Message, Severity.Error);
        }
    }

    private async Task EditNotesAsync(BaronyRelationDTO item)
    {
        var parameters = new DialogParameters<RelationNotesDialog>
        {
            { x => x.RelationId, item.Id },
            { x => x.PersonName, item.Name },
            { x => x.Notes, item.Notes },
        };

        var dialog = await _dialogService.ShowAsync<RelationNotesDialog>(
            L["Edit Notes"],
            parameters,
            new DialogOptions
            {
                CloseOnEscapeKey = true,
                MaxWidth = MaxWidth.Large,
                FullWidth = true,
            });

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not string notes)
            return;

        try
        {
            await _baronyRepo.SaveRelationNotes(item.Id, string.IsNullOrWhiteSpace(notes) ? null : notes);
            _snackBar.Add(L["Notes updated."], Severity.Success);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _snackBar.Add(L["Could not save notes: "] + ex.Message, Severity.Error);
        }
    }

    private async Task EditModifiersAsync(BaronyRelationDTO item)
    {
        var draft = Clone(item);
        var parameters = new DialogParameters<RelationModifiersDialog>
        {
            { x => x.PersonName, item.Name },
            { x => x.Modifiers, draft.Modifiers },
        };

        var dialog = await _dialogService.ShowAsync<RelationModifiersDialog>(
            L["Edit Modifiers"],
            parameters,
            new DialogOptions
            {
                CloseOnEscapeKey = true,
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
            });

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not List<BaronyRelationModifierDTO> modifiers)
            return;

        draft.Modifiers = modifiers;

        try
        {
            await _baronyRepo.SaveRelation(draft);
            _snackBar.Add(L["Modifiers updated."], Severity.Success);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _snackBar.Add(L["Could not save modifiers: "] + ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(BaronyRelationDTO item)
    {
        var confirm = await _dialogService.ShowMessageBoxAsync(
            L["Remove relation"],
            L["Remove “{0}”?", item.Name],
            yesText: L["Remove"],
            cancelText: L["Cancel"]);
        if (confirm != true)
            return;

        try
        {
            await _baronyRepo.DeleteRelation(item.Id);
            _snackBar.Add(L["Relation removed."], Severity.Success);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _snackBar.Add(L["Could not remove relation: "] + ex.Message, Severity.Error);
        }
    }

    private string ModifiersTooltip(BaronyRelationDTO item)
    {
        if (item.Modifiers is null || item.Modifiers.Count == 0)
            return L["No modifiers."];

        return string.Join("\n", item.Modifiers
            .OrderBy(m => m.SortOrder)
            .Select(m =>
            {
                var sign = m.Value > 0 ? "+" : "";
                var desc = string.IsNullOrWhiteSpace(m.Description) ? L["(unnamed)"] : m.Description.Trim();
                return $"{desc}: {sign}{m.Value}";
            }));
    }

    private static string AttitudeClass(int attitude) =>
        attitude > 0 ? "relations-attitude relations-attitude--pos"
        : attitude < 0 ? "relations-attitude relations-attitude--neg"
        : "relations-attitude";

    private static string FormatAttitude(int attitude) =>
        attitude > 0 ? $"+{attitude}" : attitude.ToString();

    private string NotesTooltip(string? notes) =>
        string.IsNullOrWhiteSpace(notes) ? L["Edit Notes"] : notes;

    private static string NotesButtonClass(string? notes) =>
        string.IsNullOrWhiteSpace(notes)
            ? "known-lords-notes-btn"
            : "known-lords-notes-btn known-lords-notes-btn--filled";

    private static BaronyRelationDTO Clone(BaronyRelationDTO source) => new()
    {
        Id = source.Id,
        BaronyId = source.BaronyId,
        Category = source.Category,
        GroupName = source.GroupName,
        Name = source.Name,
        Title = source.Title,
        Age = source.Age,
        Description = source.Description,
        TroopCount = source.TroopCount,
        RelationDescription = source.RelationDescription,
        Notes = source.Notes,
        Marks = BaronyCharacterMarkDTO.NormalizeList(source.Marks),
        SortOrder = source.SortOrder,
        FiefId = source.FiefId,
        Modifiers = (source.Modifiers ?? new())
            .Select(m => new BaronyRelationModifierDTO
            {
                Id = m.Id,
                Description = m.Description,
                Value = m.Value,
                SortOrder = m.SortOrder,
            }).ToList(),
    };

    private sealed record RelationGroup(string Name, List<BaronyRelationDTO> Items);
}
