@namespace DagoniteEmpire.Pages.Barony.Components

<table class="ppb-table @TableClass">
    <thead>
        <tr>
            @if (ShowRowLabels)
            {
                <th class="ppb-row-label">@RowHeader</th>
            }
            @foreach (var info in PpbCatalog.All)
            {
                <th title="@info.NamePl">@info.ShortPl</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Rows)
        {
            <tr>
                @if (ShowRowLabels)
                {
                    <td class="ppb-row-label" title="@row.Formula">
                        @row.Label
                        @if (!string.IsNullOrWhiteSpace(row.Formula))
                        {
                            <MudIcon Icon="@Icons.Material.Outlined.Functions" Size="Size.Small" Class="ml-1" Style="vertical-align:text-bottom;opacity:.6;" />
                        }
                    </td>
                }
                @foreach (var info in PpbCatalog.All)
                {
                    <td class="@CellClass(row, info.Key)">@((MarkupString)CellContent(row, info.Key))</td>
                }
            </tr>
        }
        @if (Summary is not null)
        {
            <tr class="ppb-summary-row">
                @if (ShowRowLabels)
                {
                    <td class="ppb-row-label">@SummaryLabel</td>
                }
                @foreach (var info in PpbCatalog.All)
                {
                    var v = Summary[info.Key];
                    <td class="@ValueClass(v)">@Fmt(v)</td>
                }
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter] public IEnumerable<PpbModifierRow> Rows { get; set; } = Array.Empty<PpbModifierRow>();
    [Parameter] public PpbVector? Summary { get; set; }
    [Parameter] public string SummaryLabel { get; set; } = "Suma sekcji";
    [Parameter] public string RowHeader { get; set; } = "Modyfikator";
    [Parameter] public string TableClass { get; set; } = "ppb-table--zebra";
    [Parameter] public bool ShowRowLabels { get; set; } = true;

    private static string Fmt(decimal v)
    {
        if (v == 0m)
            return "·";
        var rounded = decimal.Round(v, 2);
        var text = rounded == decimal.Truncate(rounded)
            ? ((long)rounded).ToString()
            : rounded.ToString("0.##");
        return rounded > 0 ? "+" + text : text;
    }

    private static string CellContent(PpbModifierRow row, Ppb p)
    {
        var add = row.Additive?[p] ?? 0m;
        var pct = row.Percent?[p] ?? 0m;
        var parts = new List<string>();
        if (add != 0m)
            parts.Add(Fmt(add));
        if (pct != 0m)
            parts.Add(Fmt(pct) + "%");
        return parts.Count == 0 ? "<span class=\"ppb-cell-zero\">·</span>" : string.Join(" / ", parts);
    }

    private static string CellClass(PpbModifierRow row, Ppb p)
    {
        var add = row.Additive?[p] ?? 0m;
        var pct = row.Percent?[p] ?? 0m;
        var net = add + pct;
        return ValueClass(net);
    }

    private static string ValueClass(decimal v)
    {
        if (v > 0m) return "ppb-cell-pos";
        if (v < 0m) return "ppb-cell-neg";
        return "ppb-cell-zero";
    }
}
