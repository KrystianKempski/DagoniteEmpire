@namespace DagoniteEmpire.Pages.Barony.Components
@using DA_Common.Barony
@using DA_Models.BaronyModels

<MudDialog Class="baron-influence-dialog"
           ContentClass="baron-influence-dialog-content"
           ActionsClass="baron-influence-dialog-actions">
    <TitleContent>
        <MudText Typo="Typo.h6">Change equipment — @Unit.Name</MudText>
    </TitleContent>
    <DialogContent>
        <div class="barony-dialog-theme baron-influence-edit-dialog unit-change-equip-dialog">
            <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mb-2">
                Pick a new loadout and how to pay for each piece (Craft / Buy / Defense), same as the unit generator.
                Creates a <b>@L["Unit Change Equipment"]</b> project in Resource allocation — fund it on Projects.
                Cost is scaled by current troops (@Unit.TroopCount/@UnitRules.DefaultTroopCount).
                Gear quality stays as set by the GM (@CurrentQuality).
            </MudText>

            <UnitEquipmentPicker Unit="@Unit"
                                 Weapon1Key="@_weapon1"
                                 Weapon2Key="@_weapon2"
                                 ArmorKey="@_armor"
                                 ShieldKey="@_shield"
                                 MountKey="@_mount"
                                 CanEdit="true"
                                 Availability="@Availability"
                                 Weapon1Changed="OnWeapon1Changed"
                                 Weapon2Changed="OnWeapon2Changed"
                                 ArmorChanged="OnArmorChanged"
                                 ShieldChanged="OnShieldChanged"
                                 MountChanged="OnMountChanged" />

            <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">@L["Gear acquire"]</MudText>
            <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mb-2">
                Craft · Buy (Mkt) · Defense (2×Mkt). Costs below already include troop scale.
            </MudText>
            <div class="unit-gear-pay mb-3">
                @PayRow("W1", _w1?.Name, _w1?.ProductionCost, _w1?.GoldCost, _w1?.MarketGold, _payW1, v => { _payW1 = v; Recalc(); }, required: true)
                @PayRow("W2", _w2?.Name, _w2?.ProductionCost, _w2?.GoldCost, _w2?.MarketGold, _payW2, v => { _payW2 = v; Recalc(); }, required: false)
                @PayRow("Armor", _armorDef?.Name, _armorDef?.ProductionCost, _armorDef?.GoldCost, _armorDef?.MarketGold, _payArmor, v => { _payArmor = v; Recalc(); }, required: false)
                @PayRow("Shield", _shieldDef?.Name, _shieldDef?.ProductionCost, _shieldDef?.GoldCost, _shieldDef?.MarketGold, _payShield, v => { _payShield = v; Recalc(); }, required: false)
                @PayRow("Mount", _mountDef?.Name, _mountDef?.ProductionCost, _mountDef?.GoldCost, _mountDef?.MarketGold, _payMount, v => { _payMount = v; Recalc(); }, required: false)
            </div>

            <MudText Typo="Typo.subtitle2" Class="mb-1">@L["Project cost"]</MudText>
            <div class="d-flex flex-wrap gap-3 mb-1">
                <span>@L["Gold"] <b>@_costs.Gold</b></span>
                <span>Prod <b>@_costs.Production</b></span>
                <span>@L["Defense"] <b>@_costs.Defense</b></span>
                <span>@L["Turns"] <b>@_costs.Turns</b></span>
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Class="baron-influence-save-btn"
                   Variant="Variant.Filled"
                   Disabled="@(!CanConfirm)"
                   OnClick="Confirm">
            @L["Create project"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public BaronyUnitDTO Unit { get; set; } = new();
    [Parameter] public TradeGoodAvailabilitySnapshot? Availability { get; set; }

    private string? _weapon1;
    private string? _weapon2;
    private string? _armor;
    private string? _shield;
    private string? _mount;
    private string _payW1 = UnitEquipmentAcquireMode.Craft;
    private string _payW2 = UnitEquipmentAcquireMode.Craft;
    private string _payArmor = UnitEquipmentAcquireMode.Craft;
    private string _payShield = UnitEquipmentAcquireMode.Craft;
    private string _payMount = UnitEquipmentAcquireMode.Craft;
    private UnitWeaponDef? _w1;
    private UnitWeaponDef? _w2;
    private UnitArmorDef? _armorDef;
    private UnitArmorDef? _shieldDef;
    private UnitMountDef? _mountDef;
    private UnitChangeEquipmentCostSummary _costs;

    private string CurrentQuality => UnitWeaponQuality.Normalize(Unit.Weapon1Quality);

    private bool CanConfirm =>
        !string.IsNullOrWhiteSpace(_weapon1)
        && (_costs.Gold > 0 || _costs.Production > 0 || _costs.Defense > 0 || LoadoutChanged);

    private bool LoadoutChanged =>
        !string.Equals(Unit.Weapon1Key, _weapon1, StringComparison.OrdinalIgnoreCase)
        || !string.Equals(Unit.Weapon2Key ?? "", _weapon2 ?? "", StringComparison.OrdinalIgnoreCase)
        || !string.Equals(Unit.ArmorKey ?? "", _armor ?? "", StringComparison.OrdinalIgnoreCase)
        || !string.Equals(Unit.ShieldKey ?? "", _shield ?? "", StringComparison.OrdinalIgnoreCase)
        || !string.Equals(Unit.MountKey ?? "", _mount ?? "", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        _weapon1 = Unit.Weapon1Key;
        _weapon2 = Unit.Weapon2Key;
        _armor = Unit.ArmorKey;
        _shield = Unit.ShieldKey;
        _mount = Unit.MountKey;
        RefreshDefs();
        Recalc();
    }

    private Task OnWeapon1Changed(string key)
    {
        _weapon1 = key;
        RefreshDefs();
        Recalc();
        return Task.CompletedTask;
    }

    private Task OnWeapon2Changed(string? key)
    {
        _weapon2 = key;
        if (string.IsNullOrWhiteSpace(key))
            _payW2 = UnitEquipmentAcquireMode.Craft;
        RefreshDefs();
        Recalc();
        return Task.CompletedTask;
    }

    private Task OnArmorChanged(string? key)
    {
        _armor = key;
        if (string.IsNullOrWhiteSpace(key))
            _payArmor = UnitEquipmentAcquireMode.Craft;
        RefreshDefs();
        Recalc();
        return Task.CompletedTask;
    }

    private Task OnShieldChanged(string? key)
    {
        _shield = key;
        if (string.IsNullOrWhiteSpace(key))
            _payShield = UnitEquipmentAcquireMode.Craft;
        RefreshDefs();
        Recalc();
        return Task.CompletedTask;
    }

    private Task OnMountChanged(string? key)
    {
        _mount = key;
        if (string.IsNullOrWhiteSpace(key))
            _payMount = UnitEquipmentAcquireMode.Craft;
        RefreshDefs();
        Recalc();
        return Task.CompletedTask;
    }

    private void RefreshDefs()
    {
        _w1 = UnitWeaponCatalog.Find(_weapon1);
        _w2 = UnitWeaponCatalog.Find(_weapon2);
        _armorDef = UnitArmorCatalog.Find(_armor);
        _shieldDef = UnitArmorCatalog.Find(_shield);
        _mountDef = UnitMountCatalog.Find(_mount);
    }

    private void Recalc()
    {
        _costs = UnitChangeEquipmentCostFormulas.Compute(
            _w1, _w2, _armorDef, _shieldDef, _mountDef,
            new UnitEquipmentPayModes(_payW1, _payW2, _payArmor, _payShield, _payMount),
            Unit.TroopCount);
    }

    private RenderFragment PayRow(
        string slot,
        string? name,
        int? prod,
        int? gold,
        int? market,
        string mode,
        Action<string> onChanged,
        bool required) => __builder =>
    {
        var hasItem = !string.IsNullOrWhiteSpace(name);
        var m = UnitEquipmentAcquireMode.Normalize(mode);
        <div class="unit-gear-pay__row @(hasItem ? null : "unit-gear-pay__row--empty")">
            <span class="unit-gear-pay__slot">@slot</span>
            <span class="unit-gear-pay__name">@(hasItem ? name : (required ? "—" : "none"))</span>
            @if (hasItem)
            {
                <MudRadioGroup T="string"
                               Value="@m"
                               ValueChanged="EventCallback.Factory.Create<string>(this, onChanged)"
                               Class="unit-gear-pay__modes">
                    <BaronyTooltip Text="@($"Craft: Prod {prod} + Gold {gold}")">
                        <MudRadio T="string" Value="@UnitEquipmentAcquireMode.Craft" Dense="true" Class="unit-gear-pay__mode">
                            <BaronyResourceIcon Resource="Ppb.Production" Size="xs" />
                        </MudRadio>
                    </BaronyTooltip>
                    <BaronyTooltip Text="@($"Buy: Mkt {market}")">
                        <MudRadio T="string" Value="@UnitEquipmentAcquireMode.Buy" Dense="true" Class="unit-gear-pay__mode">
                            <BaronyResourceIcon Resource="Ppb.Treasury" Size="xs" />
                        </MudRadio>
                    </BaronyTooltip>
                    <BaronyTooltip Text="@($"Defense: 2×Mkt = {(market ?? 0) * 2}")">
                        <MudRadio T="string" Value="@UnitEquipmentAcquireMode.Defense" Dense="true" Class="unit-gear-pay__mode">
                            <BaronyResourceIcon Resource="Ppb.Defense" Size="xs" />
                        </MudRadio>
                    </BaronyTooltip>
                </MudRadioGroup>
            }
        </div>
    };

    private void Cancel() => MudDialog.Cancel();

    private void Confirm()
    {
        Recalc();
        if (string.IsNullOrWhiteSpace(_weapon1) || !LoadoutChanged)
            return;

        MudDialog.Close(DialogResult.Ok(new StartUnitChangeEquipmentRequest
        {
            BaronyId = Unit.BaronyId,
            UnitId = Unit.Id,
            Weapon1Key = _weapon1!,
            Weapon2Key = _weapon2,
            ArmorKey = _armor,
            ShieldKey = _shield,
            MountKey = _mount,
            Weapon1Quality = CurrentQuality,
            Weapon1AcquireMode = _payW1,
            Weapon2AcquireMode = _payW2,
            ArmorAcquireMode = _payArmor,
            ShieldAcquireMode = _payShield,
            MountAcquireMode = _payMount,
        }));
    }
}
