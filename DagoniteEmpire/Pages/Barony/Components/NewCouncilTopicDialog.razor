@namespace DagoniteEmpire.Pages.Barony.Components

<MudDialog Class="barony-dialog">
    <TitleContent>
        <MudText Typo="Typo.h6">@L["New council topic"]</MudText>
    </TitleContent>
    <DialogContent>
        <div class="barony-dialog-theme">
            <MudSelect T="string"
                       @bind-Value="_advisorLabel"
                       Label="@(L["Advisor"])"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Dense="true"
                       HelperText="@(L["Which advisor brings this topic to the Council"])"
                       Class="mb-2">
                @foreach (var name in Advisors)
                {
                    <MudSelectItem Value="@name">@name</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_title"
                          Label="@(L["Topic title"])"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          HelperText="@(L["e.g. Grain reserves before winter"])"
                          Class="mb-2" />
            <MudTextField @bind-Value="_opening"
                          Label="@(L["Opening words"])"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="5"
                          Immediate="true"
                          HelperText="@(L["What the advisor says first"])" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Class="baron-influence-save-btn" Variant="Variant.Filled" OnClick="Submit" Disabled="_busy || !CanSubmit">
            @L["Bring to Council"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public IReadOnlyList<string> Advisors { get; set; } = Array.Empty<string>();

    private string _advisorLabel = "";
    private string _title = "";
    private string _opening = "";
    private bool _busy;

    protected override void OnInitialized()
    {
        if (Advisors.Count > 0)
            _advisorLabel = Advisors[0];
    }

    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(_advisorLabel)
        && !string.IsNullOrWhiteSpace(_title)
        && !string.IsNullOrWhiteSpace(_opening);

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (!CanSubmit) return;
        _busy = true;
        MudDialog.Close(DialogResult.Ok(new NewCouncilTopicResult(
            _advisorLabel.Trim(),
            _title.Trim(),
            _opening.Trim())));
    }

    public sealed record NewCouncilTopicResult(string AdvisorLabel, string Title, string OpeningBody);
}
