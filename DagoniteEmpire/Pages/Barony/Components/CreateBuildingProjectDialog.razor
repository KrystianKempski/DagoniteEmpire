@namespace DagoniteEmpire.Pages.Barony.Components
@inject ISnackbar _snackBar

<MudDialog Class="baron-influence-dialog"
           ContentClass="baron-influence-dialog-content"
           ActionsClass="baron-influence-dialog-actions">
    <DialogContent>
        <div class="barony-dialog-theme baron-influence-edit-dialog city-building-edit-dialog project-edit-dialog">
            <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mb-2">
                Pole (@Tile.X, @Tile.Y) — projekt budowy na mapie (Ulepszenie), opłacany tylko Złotem i Produkcją.
            </MudText>

            @if (Templates.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    Żadne ulepszenia z katalogu nie pasują do tego pola (te same zasady co pędzel ulepszeń).
                </MudAlert>
            }
            else
            {
                @if (LockedHerdNotes.Count > 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                        Zablokowane, dopóki nie zdobędziesz zwierząt hodowlanych z handlu:
                        @string.Join("; ", LockedHerdNotes)
                    </MudAlert>
                }

                <MudSelect T="int"
                           Label="Ulepszenie"
                           Value="_templateId"
                           ValueChanged="OnTemplateChanged"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="baron-influence-field"
                           Required="true">
                    @foreach (var template in Templates.OrderBy(t => t.Name))
                    {
                        <MudSelectItem Value="@template.Id">@($"{template.Name} ({Fmt(template.GoldCost)} złota / {Fmt(template.ProductionCost)} prod.)")</MudSelectItem>
                    }
                </MudSelect>

                <MudTextField @bind-Value="_name"
                              Label="Nazwa projektu"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true"
                              Class="baron-influence-field mt-2" />
                <MudTextField @bind-Value="_description"
                              Label="Opis"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Lines="2"
                              Class="baron-influence-field" />

                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Koszt (wymuszony)</MudText>
                <div class="terrain-build-project-cost">
                    <span>Złoto: <b>@Fmt(_goldCost)</b></span>
                    <span>Produkcja: <b>@Fmt(_productionCost)</b></span>
                </div>
                <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mt-1">
                    Typ wyniku: @ProjectOutputKind.Improvement · Płatność: tylko Złoto i Produkcja
                </MudText>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">Zamknij</MudButton>
        <MudButton Class="baron-influence-save-btn"
                   Variant="Variant.Filled"
                   OnClick="MakeProject"
                   Disabled="@(Templates.Count == 0)">
            Utwórz projekt
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public int BaronyId { get; set; }
    [Parameter] public TerrainTileDTO Tile { get; set; } = new();
    [Parameter] public List<BuildingTemplateDTO> Templates { get; set; } = new();
    /// <summary>Herd/stud templates excluded because the barony lacks trade access to breeding stock.</summary>
    [Parameter] public List<string> LockedHerdNotes { get; set; } = new();

    private int _templateId;
    private string _name = string.Empty;
    private string? _description;
    private decimal _goldCost;
    private decimal _productionCost;
    private PpbVector _resultAdditive = new();
    private PpbVector _resultPercent = new();

    protected override void OnInitialized()
    {
        var first = Templates.OrderBy(t => t.Name).FirstOrDefault();
        if (first is not null)
            ApplyTemplate(first);
    }

    private void OnTemplateChanged(int id)
    {
        var template = Templates.FirstOrDefault(t => t.Id == id);
        if (template is null)
            return;
        ApplyTemplate(template);
    }

    private void ApplyTemplate(BuildingTemplateDTO template)
    {
        _templateId = template.Id;
        _name = $"Budowa {template.Name} w [{Tile.X},{Tile.Y}]";
        _description = template.Description;
        _goldCost = template.GoldCost;
        _productionCost = template.ProductionCost;
        _resultAdditive = template.EffectAdditive.Clone();
        _resultPercent = template.EffectPercent.Clone();
    }

    private void Cancel() => MudDialog.Cancel();

    private void MakeProject()
    {
        if (_templateId <= 0)
        {
            _snackBar.Add("Wybierz ulepszenie z katalogu.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_name))
        {
            _snackBar.Add("Nazwa projektu jest wymagana.", Severity.Warning);
            return;
        }

        if (Tile.Id <= 0)
        {
            _snackBar.Add("To pole nie jest jeszcze gotowe.", Severity.Warning);
            return;
        }

        var cost = new PpbVector();
        cost[Ppb.Treasury] = Math.Max(0m, _goldCost);
        cost[Ppb.Production] = Math.Max(0m, _productionCost);

        var displayName = _name.Trim();
        var template = Templates.FirstOrDefault(t => t.Id == _templateId);
        var templateName = template?.Name?.Trim();
        if (string.IsNullOrWhiteSpace(templateName))
            templateName = displayName;

        var project = new BaronyProjectDTO
        {
            BaronyId = BaronyId,
            Name = displayName,
            Description = string.IsNullOrWhiteSpace(_description) ? string.Empty : _description.Trim(),
            OutputKind = ProjectOutputKind.Improvement,
            AllowedCostModes = ProjectAllowedCostModes.GoldProductionOnly,
            SelectedCostMode = ProjectCostMode.GoldProduction,
            CostGoldProduction = ProjectCostCatalog.SliceGoldProduction(cost),
            CostMaterials = new(),
            ResultAdditive = _resultAdditive.Clone(),
            ResultPercent = _resultPercent.Clone(),
            ResultDescription = $"Budowa {templateName} w [{Tile.X},{Tile.Y}].",
            Status = ProjectStatus.ResourceAllocation,
            TileId = Tile.Id,
            BuildingTemplateId = _templateId,
        };

        MudDialog.Close(DialogResult.Ok(project));
    }

    private static string Fmt(decimal v) => PpbFormat.Number(v);
}
