@namespace DagoniteEmpire.Pages.Barony.Components
@using DA_Models.BaronyModels

<MudDialog Class="barony-dialog">
    <TitleContent>
        <MudText Typo="Typo.h6">@L["Turn resolved"]</MudText>
    </TitleContent>
    <DialogContent>
        <div class="barony-dialog-theme">
        @if (Report is not null)
        {
            <MudText Typo="Typo.body2" Style="white-space:pre-wrap;">@Report.SummaryText</MudText>
            @if (!Report.AppliedIncome.IsEmpty)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-3">@L["Income applied"]</MudText>
                <div class="d-flex flex-wrap gap-2 mt-1">
                    @foreach (var info in ResourceCatalog.All)
                    {
                        var v = Report.AppliedIncome[info.Key];
                        if (v == 0m)
                            continue;
                        <span class="@(v >= 0 ? "ppb-cell-pos" : "ppb-cell-neg")">
                            @info.Short @PpbFormat.Additive(v)
                        </span>
                    }
                </div>
            }
        }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="barony-turn-btn barony-turn-btn--solid" OnClick="Close">OK</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public TurnResolveReportDTO? Report { get; set; }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}
