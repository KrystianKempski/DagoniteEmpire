@namespace DagoniteEmpire.Pages.Barony.Components
@using DA_Common.Barony
@using DA_Models.BaronyModels
@inject IDialogService _dialogService

<MudDialog Class="barony-dialog">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isEdit ? L["Edit hall event"] : L["New hall event"])</MudText>
    </TitleContent>
    <DialogContent>
        <div class="barony-dialog-theme">
            @if (!_isEdit && Templates.Count > 0)
            {
                <MudSelect T="int?"
                           Value="_selectedTemplateId"
                           ValueChanged="OnTemplateSelected"
                           Label="@(L["Load from template"])"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true"
                           Clearable="true"
                           Class="mb-2">
                    @foreach (var template in Templates)
                    {
                        <MudSelectItem Value="@((int?)template.Id)">@template.Name</MudSelectItem>
                    }
                </MudSelect>
            }

            <div class="new-audience-icon-row">
                <button type="button"
                        class="new-audience-icon-row__pick"
                        title="@L["Choose icon"]"
                        @onclick="PickIconAsync">
                    <img src="@("/" + IconPath)" alt="" />
                    <span>@L["Choose icon"]</span>
                </button>
                <MudTextField @bind-Value="_title"
                              Label="@(L["Title"])"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Class="flex-grow-1" />
            </div>
            <MudSelect T="string"
                       @bind-Value="_triggerKind"
                       Label="@(L["Trigger"])"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Dense="true"
                       Disabled="_scheduleForNextTurn && !_isEdit"
                       Class="mt-2">
                @foreach (var kind in BaronyHallEventTriggerKind.All)
                {
                    <MudSelectItem Value="@kind">@L[BaronyHallEventTriggerKind.DisplayName(kind)]</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_body"
                          Label="@(L["Event text"])"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="12"
                          Immediate="true"
                          HelperText="@(L["Markdown supported — headings, lists, bold, etc. The baron will scroll through it on the hall screen."])"
                          Class="mt-2 hall-event-dialog__body" />

            @if (!_isEdit)
            {
                <MudCheckBox T="bool"
                             @bind-Value="_scheduleForNextTurn"
                             Label="@(L["Publish on next Resolve Turn"])"
                             Color="Color.Default"
                             Dense="true"
                             Class="barony-checkbox mt-2" />
                <MudText Typo="Typo.caption" Style="color:var(--barony-muted);">
                    @L["Stays hidden until the turn advances. Trigger becomes Turn start."]
                </MudText>
            }
            else if (Existing?.IsScheduled == true)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                    @L["Scheduled for turn {0}.", Existing.PublishAtTurn ?? Existing.TurnNumber]
                </MudAlert>
            }

            <MudExpansionPanels Class="mt-2 hall-event-dialog__ppb">
                <MudExpansionPanel Text="@(L["PPB consequence (optional)"])">
                    <MudText Typo="Typo.caption" Class="mb-2" Style="color:var(--barony-muted);">
                        @L["When the baron responds, a domain event with these modifiers is created."]
                    </MudText>
                    <PpbVectorEditor @bind-Value="_consequenceAdditive" Title="@(L["PPB additive (+)"])" Compact="true" />
                    <PpbVectorEditor @bind-Value="_consequencePercent" Title="@(L["PPB percent (%)"])" Compact="true" Percent="true" />
                    <div class="event-turn-fields mt-2">
                        <MudCheckBox T="bool"
                                     @bind-Value="_consequenceOngoing"
                                     Label="@(L["Ongoing (no end turn)"])"
                                     Color="Color.Default"
                                     Dense="true"
                                     Class="barony-checkbox" />
                        @if (!_consequenceOngoing)
                        {
                            <MudNumericField T="int"
                                             @bind-Value="_consequenceEndTurn"
                                             Label="@(L["To turn"])"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Min="1"
                                             Class="baron-influence-field" />
                        }
                    </div>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Class="baron-influence-save-btn" Variant="Variant.Filled" OnClick="Submit" Disabled="_busy || !CanSubmit">
            @SubmitLabel
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public BaronyHallEventDTO? Existing { get; set; }
    [Parameter] public IReadOnlyList<BaronyHallEventTemplateDTO> Templates { get; set; } = Array.Empty<BaronyHallEventTemplateDTO>();
    [Parameter] public int CurrentTurn { get; set; } = 1;

    private const string DefaultIcon = "icons/vertical-banner.svg";

    private bool _isEdit => Existing is not null && Existing.Id > 0;
    private string _title = "";
    private string _body = "";
    private string _triggerKind = BaronyHallEventTriggerKind.Manual;
    private string _iconPath = DefaultIcon;
    private bool _scheduleForNextTurn;
    private bool _busy;
    private int? _selectedTemplateId;
    private PpbVector _consequenceAdditive = new();
    private PpbVector _consequencePercent = new();
    private bool _consequenceOngoing = true;
    private int _consequenceEndTurn = 1;

    private string IconPath => PetitionerIconCatalog.PathFor(_iconPath);

    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(_title)
        && !string.IsNullOrWhiteSpace(_body);

    private string SubmitLabel =>
        _isEdit ? L["Save"] : _scheduleForNextTurn ? L["Schedule event"] : L["Publish event"];

    protected override void OnParametersSet()
    {
        if (Existing is null)
        {
            _consequenceEndTurn = Math.Max(1, CurrentTurn);
            return;
        }

        _title = Existing.Title;
        _body = Existing.Body;
        _triggerKind = BaronyHallEventTriggerKind.Normalize(Existing.TriggerKind);
        _iconPath = string.IsNullOrWhiteSpace(Existing.IconPath) ? DefaultIcon : Existing.IconPath;
        _consequenceAdditive = Existing.ConsequenceAdditive.Clone();
        _consequencePercent = Existing.ConsequencePercent.Clone();
        _consequenceOngoing = Existing.ConsequenceEndTurn is null;
        _consequenceEndTurn = Existing.ConsequenceEndTurn ?? Math.Max(1, CurrentTurn);
    }

    private void OnTemplateSelected(int? templateId)
    {
        _selectedTemplateId = templateId;
        if (templateId is not int id)
            return;

        var template = Templates.FirstOrDefault(t => t.Id == id);
        if (template is null)
            return;

        _title = template.Title;
        _body = template.Body;
        _triggerKind = BaronyHallEventTriggerKind.Normalize(template.TriggerKind);
        _iconPath = string.IsNullOrWhiteSpace(template.IconPath) ? DefaultIcon : template.IconPath;
        _consequenceAdditive = template.ConsequenceAdditive.Clone();
        _consequencePercent = template.ConsequencePercent.Clone();
        _consequenceOngoing = template.ConsequenceEndTurn is null;
        _consequenceEndTurn = template.ConsequenceEndTurn ?? Math.Max(1, CurrentTurn);
    }

    private async Task PickIconAsync()
    {
        var dialog = await _dialogService.ShowAsync<PetitionerIconPickerDialog>(
            L["Choose icon"],
            new DialogParameters<PetitionerIconPickerDialog> { { x => x.SelectedPath, _iconPath } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not string path || string.IsNullOrWhiteSpace(path))
            return;
        _iconPath = path;
    }

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (!CanSubmit)
            return;

        _busy = true;
        MudDialog.Close(DialogResult.Ok(new HallEventDialogResult(
            _title.Trim(),
            _body.Trim(),
            _triggerKind,
            IconPath,
            _scheduleForNextTurn,
            _consequenceAdditive.Clone(),
            _consequencePercent.Clone(),
            _consequenceOngoing ? null : _consequenceEndTurn)));
    }

    public sealed record HallEventDialogResult(
        string Title,
        string Body,
        string TriggerKind,
        string IconPath,
        bool ScheduleForNextTurn,
        PpbVector ConsequenceAdditive,
        PpbVector ConsequencePercent,
        int? ConsequenceEndTurn);
}
