@namespace DagoniteEmpire.Pages.Barony.Components

<BaronySection Title="@(L["Baron and Advisors"])">
    <Summary>
        <PpbSummaryChips Vector="@Glance" />
    </Summary>
    <ChildContent>
        @if (FocusSlotCount > 0 || CanEditFocus)
        {
            <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mb-2">
                @L["Baron PPB focus: {0}/{1} (full effect). Unchecked → ×½. Gold has no baron focus.", FocusedCount, FocusSlotCount]
            </MudText>
        }
        @if (AdvisorList.Count == 0)
        {
            <MudText Typo="Typo.body2" Style="color:var(--barony-muted);">@L["No baron or advisors assigned yet."]</MudText>
        }
        else
        {
            <div style="overflow-x:auto;">
                <table class="ppb-table ppb-table--advisors ppb-table--lined">
                    <colgroup>
                        <col class="advisor-col-role" />
                        <col class="advisor-col-name" />
                        @foreach (var _ in PpbCatalog.All)
                        {
                            <col class="ppb-pair-col" />
                            <col class="ppb-pair-col" />
                        }
                    </colgroup>
                    <thead>
                        <tr>
                            <th rowspan="2" class="ppb-row-label advisor-col-role">@L["Role"]</th>
                            <th rowspan="2" class="ppb-row-label advisor-col-name">@L["Name"]</th>
                            @foreach (var info in PpbCatalog.All)
                            {
                                <th colspan="2">
                                    <div class="baron-ppb-focus-head">
                                        @if (BaronFocusPpbs.IsFocusable(info.Key))
                                        {
                                            var focused = IsFocused(info.Key);
                                            <MudCheckBox T="bool"
                                                         Value="@focused"
                                                         ValueChanged="@(v => ToggleFocusAsync(info.Key, v))"
                                                         Disabled="@(!CanToggle(info.Key, focused))"
                                                         Dense="true"
                                                         Class="barony-checkbox baron-ppb-focus-check"
                                                         Color="Color.Default" />
                                        }
                                        <BaronyTooltip Text="@FocusHeaderTip(info)">
                                            <span class="@(IsFocused(info.Key) ? "baron-ppb-focus-label--on" : "")">@PpbShort(info.Key)</span>
                                        </BaronyTooltip>
                                    </div>
                                </th>
                            }
                        </tr>
                        <tr>
                            @foreach (var _ in PpbCatalog.All)
                            {
                                <th class="ppb-subcol ppb-subcol--add">+</th>
                                <th class="ppb-subcol ppb-subcol--pct">%</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var advisor in AdvisorList)
                        {
                            <tr class="@(advisor.IsBaron ? "advisor-row--baron" : "")">
                                <td class="ppb-row-label advisor-col-role">
                                    @if (advisor.IsBaron)
                                    {
                                        <BaronyTooltip Title="@(L["Baron"])" Text="@BaronSkillPpbFormulas.BaronAdvisorNameTooltip">
                                            <span>@BaronyCalc.AdvisorRoleLabel(advisor)</span>
                                        </BaronyTooltip>
                                    }
                                    else
                                    {
                                        var officeTip = OfficeTooltip(advisor);
                                        @if (!string.IsNullOrWhiteSpace(officeTip))
                                        {
                                            <BaronyTooltip Title="@BaronyCalc.AdvisorRoleLabel(advisor)" Text="@officeTip">
                                                <span>
                                                    @BaronyCalc.AdvisorRoleLabel(advisor)
                                                    @if (!string.IsNullOrWhiteSpace(advisor.FormulaText))
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Outlined.Functions" Size="Size.Small" Class="ml-1" Style="vertical-align:text-bottom;opacity:.6;" />
                                                    }
                                                </span>
                                            </BaronyTooltip>
                                        }
                                        else
                                        {
                                            <span>
                                                @BaronyCalc.AdvisorRoleLabel(advisor)
                                                @if (!string.IsNullOrWhiteSpace(advisor.FormulaText))
                                                {
                                                    <MudIcon Icon="@Icons.Material.Outlined.Functions" Size="Size.Small" Class="ml-1" Style="vertical-align:text-bottom;opacity:.6;" />
                                                }
                                            </span>
                                        }
                                    }
                                </td>
                                <td class="advisor-col-name">
                                    @if (advisor.IsBaron)
                                    {
                                        <BaronyTooltip Title="@(L["Baron"])" Text="@BaronSkillPpbFormulas.BaronAdvisorNameTooltip">
                                            <span>@DisplayName(advisor)</span>
                                        </BaronyTooltip>
                                    }
                                    else
                                    {
                                        var personTip = BaronyCalc.ResolvePersonDescription(advisor);
                                        @if (!string.IsNullOrWhiteSpace(personTip))
                                        {
                                            <BaronyTooltip Title="@DisplayName(advisor)" Text="@personTip">
                                                <span>@DisplayName(advisor)</span>
                                            </BaronyTooltip>
                                        }
                                        else
                                        {
                                            @DisplayName(advisor)
                                        }
                                    }
                                </td>
                                @foreach (var info in PpbCatalog.All)
                                {
                                    var add = advisor.Additive[info.Key];
                                    var pct = advisor.Percent[info.Key];
                                    var addTip = advisor.IsBaron
                                        ? BaronAddTip(info.Key)
                                        : BaronyCalc.ExplainOfficeAdvisorAdditive(advisor, info.Key, AdvisorList);
                                    var pctTip = advisor.IsBaron
                                        ? BaronPctTip(info.Key)
                                        : BaronyCalc.ExplainOfficeAdvisorPercent(advisor, info.Key, AdvisorList);
                                    <td class="@PpbCellStyle.ValueClass(info.Key, add)">
                                        @if (addTip is not null)
                                        {
                                            <BaronyTooltip Title="@info.Name" Text="@addTip">
                                                <span>@FmtAdd(add)</span>
                                            </BaronyTooltip>
                                        }
                                        else
                                        {
                                            @FmtAdd(add)
                                        }
                                    </td>
                                    <td class="@PpbCellStyle.ValueClass(info.Key, pct)">
                                        @if (pctTip is not null)
                                        {
                                            <BaronyTooltip Title="@info.Name" Text="@pctTip">
                                                <span>@FmtPct(pct)</span>
                                            </BaronyTooltip>
                                        }
                                        else
                                        {
                                            @FmtPct(pct)
                                        }
                                    </td>
                                }
                            </tr>
                        }
                        <tr class="ppb-summary-row">
                            <td class="ppb-row-label" colspan="2">@L["Σ section"]</td>
                            @foreach (var info in PpbCatalog.All)
                            {
                                <td class="@PpbCellStyle.ValueClass(info.Key, AdditiveSum[info.Key])"><b>@FmtAdd(AdditiveSum[info.Key])</b></td>
                                <td class="@PpbCellStyle.ValueClass(info.Key, PercentSum[info.Key])"><b>@FmtPct(PercentSum[info.Key])</b></td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    </ChildContent>
</BaronySection>

@code {
    [Parameter] public IEnumerable<AdvisorDTO>? Advisors { get; set; }
    [Parameter] public List<Ppb>? BaronFocus { get; set; }
    [Parameter] public int ManagementJc { get; set; } = BaronTimeRules.RequiredManagementJc;
    [Parameter] public bool CanEditFocus { get; set; }
    [Parameter] public EventCallback<List<Ppb>> BaronFocusChanged { get; set; }

    private List<Ppb> _focus = new();

    private List<AdvisorDTO> AdvisorList => BaronyCalc.OrderAdvisors(Advisors);
    private PpbVector AdditiveSum => BaronyCalc.SumAdvisorAdditive(AdvisorList);
    private PpbVector PercentSum => BaronyCalc.SumAdvisorPercent(AdvisorList);
    private PpbVector Glance => BaronyCalc.SectionGlance(BaronyCalc.AdvisorRows(AdvisorList));

    private int FocusSlotCount => BaronTimeRules.FocusSlotCount(ManagementJc);
    private int FocusedCount => _focus.Count;

    protected override void OnParametersSet()
    {
        _focus = BaronFocusPpbs.Effective(BaronFocus, ManagementJc).ToList();
    }

    private bool IsFocused(Ppb key)
        => BaronFocusPpbs.IsFocusable(key) && _focus.Contains(key);

    private bool CanToggle(Ppb key, bool currentlyFocused)
    {
        if (!CanEditFocus || !BaronFocusPpbs.IsFocusable(key))
            return false;
        if (currentlyFocused)
            return true;
        return _focus.Count < FocusSlotCount;
    }

    private async Task ToggleFocusAsync(Ppb key, bool wantFocused)
    {
        if (!CanEditFocus || !BaronFocusPpbs.IsFocusable(key))
            return;

        var next = _focus.ToList();
        if (wantFocused)
        {
            if (next.Contains(key) || next.Count >= FocusSlotCount)
                return;
            next.Add(key);
        }
        else
        {
            next.Remove(key);
        }

        _focus = next;
        await BaronFocusChanged.InvokeAsync(next.ToList());
    }

    private string FocusHeaderTip(PpbInfo info)
    {
        if (!BaronFocusPpbs.IsFocusable(info.Key))
            return info.Name;
        var share = BaronFocusPpbs.ShareFor(info.Key, _focus);
        return share >= 1m
            ? L["{0} — baron focus (full effect)", info.Name].Value
            : L["{0} — no baron focus (×½ effect)", info.Name].Value;
    }

    private string? BaronAddTip(Ppb key)
    {
        var tip = BaronSkillPpbFormulas.ExplainAdvisorAdditive(key);
        var focus = FocusShareTip(key);
        if (tip is null) return focus;
        return focus is null ? tip : $"{tip}\n{focus}";
    }

    private string? BaronPctTip(Ppb key)
    {
        var tip = BaronSkillPpbFormulas.ExplainAdvisorPercent(key);
        var focus = FocusShareTip(key);
        if (tip is null) return focus;
        return focus is null ? tip : $"{tip}\n{focus}";
    }

    private string? FocusShareTip(Ppb key)
    {
        if (!BaronFocusPpbs.IsFocusable(key))
            return null;
        var share = BaronFocusPpbs.ShareFor(key, _focus);
        return share >= 1m
            ? L["Baron focus: full effect."].Value
            : L["Baron focus: ×½ effect."].Value;
    }

    private static string DisplayName(AdvisorDTO advisor)
        => string.IsNullOrWhiteSpace(advisor.PersonName) ? "Unassigned" : advisor.PersonName;

    private static string OfficeTooltip(AdvisorDTO advisor)
    {
        var parts = new List<string>();
        var office = BaronyCalc.ResolveOfficeDescription(advisor);
        if (!string.IsNullOrWhiteSpace(office))
            parts.Add(office);
        if (!string.IsNullOrWhiteSpace(advisor.FormulaText))
            parts.Add(advisor.FormulaText);
        return parts.Count == 0 ? string.Empty : string.Join("\n\n", parts);
    }

    private static string PpbShort(Ppb p) => PpbCatalog.Short(p);

    private static string FmtAdd(decimal v) => PpbFormat.Additive(v);
    private static string FmtPct(decimal v) => PpbFormat.Percent(v);
}
