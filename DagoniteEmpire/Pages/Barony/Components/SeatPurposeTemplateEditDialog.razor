@namespace DagoniteEmpire.Pages.Barony.Components
@using DA_Common.Barony

<MudDialog Class="baron-influence-dialog"
           ContentClass="baron-influence-dialog-content"
           ActionsClass="baron-influence-dialog-actions">
    <DialogContent>
        <div class="barony-dialog-theme baron-influence-edit-dialog">
            <MudTextField @bind-Value="_template.Name"
                          Label="Nazwa"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Required="true"
                          Class="baron-influence-field" />
            <MudTextField @bind-Value="_template.Description"
                          Label="Opis"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="3"
                          Class="baron-influence-field" />
            <MudSelect T="string" @bind-Value="_template.MinSizeCategory" Label="Minimalny rozmiar komnaty" Variant="Variant.Outlined" Margin="Margin.Dense" Class="baron-influence-field">
                @foreach (var s in SeatRoomSizeCategory.All)
                {
                    <MudSelectItem Value="@s">@s</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_template.WhoOccupies"
                          Label="Kto zajmuje"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="baron-influence-field" />
            <MudNumericField T="int"
                             @bind-Value="_template.SleepCapacity"
                             Label="Pojemność noclegowa"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Min="0"
                             Class="baron-influence-field" />
            <MudNumericField T="decimal"
                             @bind-Value="_template.AdditivePrestige"
                             Label="Dodatkowy prestiż"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Step="0.1m"
                             Class="baron-influence-field" />
            <MudNumericField T="decimal"
                             @bind-Value="_template.AdditiveHonor"
                             Label="Dodatkowy honor"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Step="0.1m"
                             Class="baron-influence-field" />
            <MudNumericField T="decimal"
                             @bind-Value="_template.AdditiveFear"
                             Label="Dodatkowy postrach"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Step="0.1m"
                             Class="baron-influence-field" />
            <MudNumericField T="int"
                             @bind-Value="_template.SortOrder"
                             Label="Kolejność sortowania"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Class="baron-influence-field" />
            <MudSwitch @bind-Value="_template.IsUniversal" Label="Dostępne dla wszystkich baronii" Color="Color.Primary" />
            <PpbVectorEditor @bind-Value="_template.Additive" Title="PPB przeznaczenia (dodatkowe)" Compact="true" />
            <PpbVectorEditor @bind-Value="_template.Percent" Title="PPB przeznaczenia (%)" Percent="true" Compact="true" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Anuluj</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="baron-influence-save-btn" OnClick="Save">Zapisz</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public SeatPurposeTemplateDTO Template { get; set; } = new();
    [Parameter] public int BaronyId { get; set; }

    private SeatPurposeTemplateDTO _template = new();

    protected override void OnInitialized()
    {
        _template = new SeatPurposeTemplateDTO
        {
            Id = Template.Id,
            Name = Template.Name,
            Description = Template.Description,
            MinSizeCategory = Template.MinSizeCategory,
            WhoOccupies = Template.WhoOccupies,
            SleepCapacity = Template.SleepCapacity,
            AdditivePrestige = Template.AdditivePrestige,
            Additive = Template.Additive.Clone(),
            Percent = Template.Percent.Clone(),
            IsUniversal = Template.IsUniversal,
            BaronyId = Template.BaronyId ?? BaronyId,
            SortOrder = Template.SortOrder,
        };
    }

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        if (!_template.IsUniversal)
            _template.BaronyId = BaronyId;
        MudDialog.Close(DialogResult.Ok(_template));
    }
}
