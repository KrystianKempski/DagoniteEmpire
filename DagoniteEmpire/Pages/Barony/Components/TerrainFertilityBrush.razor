@namespace DagoniteEmpire.Pages.Barony.Components

<div class="terrain-brush">
    <MudText Typo="Typo.caption" Class="terrain-brush__hint">
        Click or drag on the map to paint. Unknown clears fertility. Mountains cannot receive fertility.
    </MudText>
    <div class="terrain-brush__body">
        <div class="terrain-brush__options">
            <button type="button"
                    class="terrain-fertility-swatch terrain-fertility-swatch--unknown @(Value == TerrainFertility.Unknown ? "terrain-fertility-swatch--selected" : "")"
                    style="background-color: @TerrainMapVisuals.UnknownFertilityColor"
                    title="Unknown fertility"
                    aria-label="Unknown fertility"
                    @onclick="() => SelectValue(TerrainFertility.Unknown)">
            </button>
            @for (var value = TerrainFertility.Min; value <= TerrainFertility.Max; value++)
            {
                var v = value;
                <button type="button"
                        class="terrain-fertility-swatch @(v == Value ? "terrain-fertility-swatch--selected" : "")"
                        style="background-color: @TerrainMapVisuals.FertilityColorForValue(v)"
                        title="@($"{v} — {TerrainFertility.DisplayName(v)}")"
                        aria-label="@($"{v} — {TerrainFertility.DisplayName(v)}")"
                        @onclick="() => SelectValue(v)">
                    @v
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int Value { get; set; } = 3;
    [Parameter] public EventCallback<int> ValueChanged { get; set; }

    private Task SelectValue(int value) => ValueChanged.InvokeAsync(value);
}
