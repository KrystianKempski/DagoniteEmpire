@namespace DagoniteEmpire.Pages.Barony.Components

<MudDialog Class="baron-influence-dialog"
           ContentClass="baron-influence-dialog-content"
           ActionsClass="baron-influence-dialog-actions">
    <TitleContent>
        <MudText Typo="Typo.h6">@L["Unit name"]</MudText>
    </TitleContent>
    <DialogContent>
        <div class="barony-dialog-theme baron-influence-edit-dialog">
            <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mb-2">
                @L["Set the display name for this unit."]
            </MudText>
            <MudTextField @bind-Value="_value"
                          Label="@(L["Name"])"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Class="baron-influence-field" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Class="baron-influence-save-btn"
                   Variant="Variant.Filled"
                   Disabled="@(string.IsNullOrWhiteSpace(_value))"
                   OnClick="Save">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string? Value { get; set; }

    private string _value = string.Empty;

    protected override void OnInitialized()
        => _value = Value?.Trim() ?? string.Empty;

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        var name = _value.Trim();
        if (string.IsNullOrWhiteSpace(name))
            return;
        MudDialog.Close(DialogResult.Ok(name));
    }
}
