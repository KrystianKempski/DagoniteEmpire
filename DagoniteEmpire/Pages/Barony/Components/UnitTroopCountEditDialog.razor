@namespace DagoniteEmpire.Pages.Barony.Components
@using DA_Common.Barony

<MudDialog Class="baron-influence-dialog"
           ContentClass="baron-influence-dialog-content"
           ActionsClass="baron-influence-dialog-actions">
    <TitleContent>
        <MudText Typo="Typo.h6">@L["Troop count"]</MudText>
    </TitleContent>
    <DialogContent>
        <div class="barony-dialog-theme baron-influence-edit-dialog">
            @if (!string.IsNullOrWhiteSpace(UnitName))
            {
                <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mb-2">
                    @UnitName
                </MudText>
            }
            <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mb-2">
                @L["Full strength is the unit's nominal ceiling. Each 10% lost → −1 Attack/Defense, −4 Max HP (floors: Atk/Def ≥ 1, Max HP ≥ 10). Understrength units regenerate +{0} troops per turn.", UnitRules.TroopRegenPerTurn]
            </MudText>
            <MudNumericField T="int"
                             @bind-Value="_max"
                             Label="@(L["Max troops"])"
                             HelperText="@($"1–{UnitRules.AbsoluteMaxTroopCount}")"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Min="1"
                             Max="@UnitRules.AbsoluteMaxTroopCount"
                             Immediate="true"
                             Class="baron-influence-field mb-2" />
            <MudNumericField T="int"
                             @bind-Value="_value"
                             Label="@(L["Troops"])"
                             HelperText="@Helper"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Min="0"
                             Max="@_max"
                             Class="baron-influence-field" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Class="baron-influence-save-btn" Variant="Variant.Filled" OnClick="Save">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string? UnitName { get; set; }
    [Parameter] public int Value { get; set; } = UnitRules.DefaultTroopCount;
    [Parameter] public int FullStrength { get; set; } = UnitRules.DefaultTroopCount;

    private int _value;
    private int _max;

    private string Helper
    {
        get
        {
            var max = Math.Max(1, _max);
            var preview = UnitCasualtyFormulas.Compute(_value, max);
            return preview.Steps == 0
                ? L["No casualty penalty at this strength."].Value
                : L["Preview: {0} steps → Atk {1}, Def {2}, HP {3}.", preview.Steps, preview.Attack, preview.Defense, preview.Hp].Value;
        }
    }

    protected override void OnInitialized()
    {
        _max = Math.Clamp(
            FullStrength > 0 ? FullStrength : UnitRules.DefaultTroopCount,
            1,
            UnitRules.AbsoluteMaxTroopCount);
        _value = Math.Clamp(Value, 0, _max);
    }

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        var max = Math.Clamp(_max, 1, UnitRules.AbsoluteMaxTroopCount);
        var troops = Math.Clamp(_value, 0, max);
        MudDialog.Close(DialogResult.Ok(new UnitTroopCountEditResult(troops, max)));
    }
}
