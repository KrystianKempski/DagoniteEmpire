@page "/barony/letters"
@layout BaronyLayout
@inherits BaronyPageBase
@implements IAsyncDisposable
@attribute [Authorize(Roles = SD.Role_Admin + "," + SD.Role_GameMaster + "," + SD.Role_DukePlayer)]
@inject IDialogService _dialogService

<PageTitle>Dagonite Empire | Letters</PageTitle>

@if (IsLoading)
{
    <MudProgressCircular Indeterminate="true" Size="Size.Small" /> <span>Loading letters...</span>
}
else if (LoadError is not null)
{
    <MudAlert Severity="Severity.Info" Class="my-2">@LoadError</MudAlert>
}
else if (Barony is not null)
{
    <BaronyPageHeader Title="Letters">
        <Summary>
            <span class="projects-summary">
                <span class="projects-summary__item">@_threads.Count thread@(_threads.Count == 1 ? "" : "s")</span>
                <span class="projects-summary__item">
                    Max @BaronLetterRules.MaxLettersFromSameCorrespondentPerTurn / correspondent / turn
                </span>
            </span>
        </Summary>
    </BaronyPageHeader>

    <div class="baron-mail">
        <aside class="baron-mail__sidebar">
            <div class="baron-mail__sidebar-actions">
                @if (CanWriteAsBaron)
                {
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="@(() => CreateThreadAsync(isInbound: false))"
                               Disabled="@_busy">
                        New thread
                    </MudButton>
                }
                @if (CanWriteAsGm)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Mail"
                               OnClick="@(() => CreateThreadAsync(isInbound: true))"
                               Disabled="@_busy">
                        New thread to baron
                    </MudButton>
                }
            </div>

            @if (_threads.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="baron-mail__empty">No letter threads yet.</MudText>
            }
            else
            {
                <div class="baron-mail__thread-list">
                    @foreach (var thread in _threads)
                    {
                        var selected = _selected?.Id == thread.Id;
                        <button type="button"
                                class="baron-mail__thread @(selected ? "baron-mail__thread--active" : "") @(thread.HasUnreadForBaron ? "baron-mail__thread--unread" : "")"
                                @onclick="@(() => SelectThreadAsync(thread.Id))">
                            <div class="baron-mail__thread-title">
                                @if (thread.HasUnreadForBaron)
                                {
                                    <span class="baron-mail__dot" title="Unread"></span>
                                }
                                <span>@(string.IsNullOrWhiteSpace(thread.Title) ? "(no title)" : thread.Title)</span>
                            </div>
                            <div class="baron-mail__thread-meta">
                                @thread.CorrespondentName
                                · @VisibleMessageCount(thread) letter@(VisibleMessageCount(thread) == 1 ? "" : "s")
                                @if (thread.LastTurnNumber is int lt)
                                {
                                    <text> · T@lt</text>
                                }
                            </div>
                        </button>
                    }
                </div>
            }
        </aside>

        <section class="baron-mail__main">
            @if (_selected is null)
            {
                <div class="baron-mail__placeholder">
                    <MudText Typo="Typo.h6">Select a thread</MudText>
                    <MudText Typo="Typo.body2" Style="color:var(--barony-muted);">
                        Or start a new one. Messages stay in the thread — no new tiles per letter.
                    </MudText>
                </div>
            }
            else
            {
                <div class="baron-mail__header">
                    <div class="baron-mail__header-main">
                        @if (_editingTitle)
                        {
                            <MudTextField @bind-Value="_titleEdit"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          Class="baron-mail__title-field"
                                          OnBlur="SaveTitleAsync"
                                          OnKeyDown="OnTitleKeyDown" />
                        }
                        else
                        {
                            <h2 class="baron-mail__title" @ondblclick="BeginEditTitle">
                                @(string.IsNullOrWhiteSpace(_selected.Title) ? "(no title)" : _selected.Title)
                            </h2>
                        }
                        <div class="baron-mail__header-meta">
                            @_selected.CorrespondentName
                            @if (!string.IsNullOrWhiteSpace(_selected.CorrespondentTitle))
                            {
                                <text> · @_selected.CorrespondentTitle</text>
                            }
                            · @_receivedThisTurn/@BaronLetterRules.MaxLettersFromSameCorrespondentPerTurn from this person this turn
                        </div>
                    </div>
                    <div class="baron-mail__header-actions">
                        @if (CanWriteAsGm || CanWriteAsBaron)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           title="Rename thread"
                                           OnClick="BeginEditTitle" />
                        }
                        @if (CanWriteAsGm)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           title="Delete thread"
                                           OnClick="DeleteThreadAsync" />
                        }
                    </div>
                </div>

                <div class="baron-mail__posts" @ref="_postsPane">
                    @foreach (var post in VisiblePosts(_selected))
                    {
                        <article class="baron-mail__post @(post.IsInbound ? "baron-mail__post--inbound" : "baron-mail__post--outbound") @(post.IsDraft ? "baron-mail__post--draft" : "")">
                            <header class="baron-mail__post-head">
                                <span class="baron-mail__post-dir">@(post.IsInbound ? "→ Baron" : "Baron →")</span>
                                <span class="baron-mail__post-when">
                                    @if (post.IsDraft)
                                    {
                                        <text>Draft</text>
                                    }
                                    else
                                    {
                                        <text>Turn @post.TurnNumber · @post.Season @post.Year · @MonthName(post.Month)</text>
                                    }
                                </span>
                                @if (CanWriteAsGm && post.IsDraft)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   title="Delete draft"
                                                   OnClick="@(() => DeleteMessageAsync(post))" />
                                }
                                else if (CanWriteAsBaron && post.IsDraft && !post.IsInbound)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   title="Delete draft"
                                                   OnClick="@(() => DeleteMessageAsync(post))" />
                                }
                            </header>
                            <div class="ql-snow baron-mail__post-body">
                                <div class="ql-editor">
                                    @((MarkupString)(string.IsNullOrWhiteSpace(post.BodyHtml) ? "<p></p>" : post.BodyHtml))
                                </div>
                            </div>
                        </article>
                    }

                    @if (!VisiblePosts(_selected).Any())
                    {
                        <MudText Typo="Typo.body2" Style="color:var(--barony-muted);">No messages in this thread yet.</MudText>
                    }
                </div>

                @if (_canCompose)
                {
                    <div class="baron-mail__composer">
                        <div class="baron-mail__composer-label">
                            @(_composeInbound ? "Write to the baron…" : "Write as the baron…")
                            @if (_saveHint is not null)
                            {
                                <span class="baron-mail__save-hint"> · @_saveHint</span>
                            }
                        </div>
                        <div class="baron-letter-editor baron-mail__editor">
                            <BlazoredTextEditor @ref="_editor" Placeholder="Write your letter…">
                                <ToolbarContent>@Toolbar()</ToolbarContent>
                                <EditorContent></EditorContent>
                            </BlazoredTextEditor>
                        </div>
                        <div class="baron-mail__composer-actions">
                            <MudButton Class="baron-influence-save-btn"
                                       Variant="Variant.Filled"
                                       OnClick="SendAsync"
                                       Disabled="@_busy">
                                Send
                            </MudButton>
                        </div>
                    </div>
                }
                else
                {
                    <div class="baron-mail__composer baron-mail__composer--readonly">
                        <MudText Typo="Typo.caption" Style="color:var(--barony-muted);">
                            You can read this thread, but composing is not available for your role here.
                        </MudText>
                    </div>
                }
            }
        </section>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "thread")] public int? ThreadQuery { get; set; }

    private List<BaronLetterThreadDTO> _threads = new();
    private List<BaronyRelationDTO> _relations = new();
    private BaronLetterThreadDTO? _selected;
    private BaronLetterMessageDTO? _draft;

    private bool CanWriteAsBaron => CanEdit && !CanManageAsMg;
    private bool CanWriteAsGm => CanManageAsMg;
    private bool _composeInbound => CanWriteAsGm;
    private bool _canCompose => _selected is not null && (CanWriteAsBaron || CanWriteAsGm);

    private BlazoredTextEditor? _editor;
    private bool _shouldLoadEditor;
    private int _loadAttempts;
    private const int MaxLoadAttempts = 12;
    private const int EditorJsTimeoutMs = 2000;

    private bool _busy;
    private bool _autoSaveInFlight;
    private string? _saveHint;
    private bool _editingTitle;
    private string _titleEdit = "";
    private int _receivedThisTurn;
    private ElementReference _postsPane;

    private CancellationTokenSource? _autoSaveCts;
    private PeriodicTimer? _autoSaveTimer;
    private Task? _autoSaveLoop;

    private RenderFragment Toolbar() => __builder =>
    {
        <select class="ql-header">
            <option selected=""></option>
            <option value="1"></option>
            <option value="2"></option>
        </select>
        <span class="ql-formats">
            <button class="ql-bold"></button>
            <button class="ql-italic"></button>
            <button class="ql-underline"></button>
            <button class="ql-strike"></button>
        </span>
        <span class="ql-formats">
            <select class="ql-color"></select>
            <select class="ql-background"></select>
        </span>
        <span class="ql-formats">
            <button class="ql-list" value="ordered"></button>
            <button class="ql-list" value="bullet"></button>
            <button class="ql-align" value=""></button>
            <button class="ql-align" value="center"></button>
            <button class="ql-align" value="right"></button>
        </span>
        <span class="ql-formats">
            <button class="ql-link"></button>
        </span>
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadBaronyAsync();
        if (Barony is null)
            return;

        await ReloadAsync(selectThreadId: ThreadQuery);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Barony is null || ThreadQuery is not int tid)
            return;
        if (_selected?.Id == tid)
            return;
        if (_threads.Any(t => t.Id == tid))
            await SelectThreadAsync(tid);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_shouldLoadEditor || _loadAttempts >= MaxLoadAttempts)
            return;

        _loadAttempts++;
        if (_editor is null)
        {
            await Task.Delay(50);
            StateHasChanged();
            return;
        }

        try
        {
            await _editor.LoadHTMLContent(_draft?.BodyHtml ?? "<p></p>");
            _shouldLoadEditor = false;
        }
        catch
        {
            await Task.Delay(50);
            StateHasChanged();
        }
    }

    private async Task ReloadAsync(int? selectThreadId = null)
    {
        if (Barony is null) return;

        _relations = await _baronyRepo.GetRelations(Barony.Id);
        var all = await _baronyRepo.GetLetterThreads(Barony.Id);
        _threads = FilterThreadsForViewer(all);

        var keepId = selectThreadId ?? _selected?.Id;
        if (keepId is int id && _threads.Any(t => t.Id == id))
            await SelectThreadAsync(id, reload: false);
        else
        {
            await StopAutoSaveAsync();
            _selected = null;
            _draft = null;
        }

        StateHasChanged();
    }

    private List<BaronLetterThreadDTO> FilterThreadsForViewer(List<BaronLetterThreadDTO> all)
    {
        if (CanWriteAsGm)
            return all;

        // Baron never sees MG drafts — strip inbound drafts from each thread.
        return all.Select(t =>
        {
            var clone = CloneThread(t);
            clone.Messages = t.Messages.Where(m => !(m.IsInbound && m.IsDraft)).ToList();
            return clone;
        }).Where(t => t.Messages.Count > 0).ToList();
    }

    private IEnumerable<BaronLetterMessageDTO> VisiblePosts(BaronLetterThreadDTO thread)
    {
        // Draft currently being edited stays in the composer, not duplicated in the feed.
        return thread.Messages
            .Where(m => _draft is null || m.Id != _draft.Id)
            .OrderBy(m => m.SortOrder)
            .ThenBy(m => m.Id);
    }

    private int VisibleMessageCount(BaronLetterThreadDTO thread) =>
        CanWriteAsGm
            ? thread.Messages.Count
            : thread.Messages.Count(m => !(m.IsInbound && m.IsDraft));

    private async Task SelectThreadAsync(int threadId, bool reload = true)
    {
        if (reload && Barony is not null)
        {
            var all = await _baronyRepo.GetLetterThreads(Barony.Id);
            _threads = FilterThreadsForViewer(all);
        }

        var thread = _threads.FirstOrDefault(t => t.Id == threadId);
        if (thread is null)
            return;

        await StopAutoSaveAsync();
        if (_draft is not null && _canCompose)
            await PersistDraftAsync(silent: true);

        _selected = thread;
        _editingTitle = false;
        _titleEdit = thread.Title;
        RefreshReceivedCount();

        _draft = FindOrNullDraft(thread);
        if (_draft is null && _canCompose)
        {
            _draft = await EnsureDraftAsync(thread);
            thread.Messages.Add(_draft);
        }

        _shouldLoadEditor = _canCompose;
        _loadAttempts = 0;
        _editor = null;
        _saveHint = null;

        if (CanWriteAsBaron && !CanWriteAsGm && thread.HasUnreadForBaron)
        {
            try
            {
                await _baronyRepo.MarkLetterThreadSeenByBaron(thread.Id);
                foreach (var m in thread.Messages.Where(m => m.HasUnreadForBaron))
                    m.SeenByBaron = true;
            }
            catch { /* ignore */ }
        }

        if (_canCompose)
            StartAutoSaveLoop();

        // Deep-link friendly URL without full navigation.
        var uri = _navigationManager.GetUriWithQueryParameter("thread", thread.Id);
        _navigationManager.NavigateTo(uri, replace: true);

        StateHasChanged();
    }

    private BaronLetterMessageDTO? FindOrNullDraft(BaronLetterThreadDTO thread) =>
        thread.Messages.FirstOrDefault(m => m.IsDraft && m.IsInbound == _composeInbound);

    private async Task<BaronLetterMessageDTO> EnsureDraftAsync(BaronLetterThreadDTO thread)
    {
        return await _baronyRepo.SaveLetterMessage(new BaronLetterMessageDTO
        {
            ThreadId = thread.Id,
            BodyHtml = "<p></p>",
            Status = BaronLetterStatus.Draft,
            IsInbound = _composeInbound,
            TurnNumber = Barony!.TurnNumber,
            Year = Barony.Year,
            Month = Barony.Month,
            Season = Barony.Season,
            SeenByBaron = true,
        });
    }

    private void RefreshReceivedCount()
    {
        if (_selected is null || Barony is null)
        {
            _receivedThisTurn = 0;
            return;
        }

        _receivedThisTurn = _threads
            .Where(t => BaronLetterRules.SameCorrespondent(
                _selected.RelationId, _selected.CorrespondentName,
                t.RelationId, t.CorrespondentName))
            .SelectMany(t => t.Messages)
            .Count(m => BaronLetterRules.CountsAsReceivedThisTurn(
                m.IsDraft, m.IsInbound, m.TurnNumber, Barony.TurnNumber));
    }

    private async Task CreateThreadAsync(bool isInbound)
    {
        if (Barony is null) return;

        var parameters = new DialogParameters<NewLetterThreadDialog>
        {
            { x => x.Barony, Barony },
            { x => x.Relations, _relations },
            { x => x.IsInbound, isInbound },
        };

        var dialog = await _dialogService.ShowAsync<NewLetterThreadDialog>(
            isInbound ? "New thread to baron" : "New thread",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not BaronLetterThreadDTO created)
            return;

        await ReloadAsync(selectThreadId: created.Id);
    }

    private void BeginEditTitle()
    {
        if (_selected is null) return;
        _titleEdit = _selected.Title;
        _editingTitle = true;
    }

    private async Task OnTitleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SaveTitleAsync();
        else if (e.Key == "Escape")
        {
            _editingTitle = false;
            StateHasChanged();
        }
    }

    private async Task SaveTitleAsync()
    {
        if (_selected is null || !_editingTitle) return;
        _editingTitle = false;
        var title = (_titleEdit ?? "").Trim();
        if (string.IsNullOrWhiteSpace(title) || title == _selected.Title)
            return;

        try
        {
            _selected.Title = title;
            await _baronyRepo.SaveLetterThread(_selected);
            var listed = _threads.FirstOrDefault(t => t.Id == _selected.Id);
            if (listed is not null) listed.Title = title;
            _snackBar.Add("Thread renamed.", Severity.Success);
        }
        catch (Exception ex)
        {
            _snackBar.Add("Rename failed: " + ex.Message, Severity.Error);
        }
    }

    private async Task DeleteThreadAsync()
    {
        if (_selected is null || !CanWriteAsGm) return;
        var ok = await _dialogService.ShowMessageBoxAsync(
            "Delete thread",
            $"Delete “{_selected.Title}” and all messages?",
            yesText: "Delete",
            cancelText: "Cancel");
        if (ok != true) return;

        try
        {
            await StopAutoSaveAsync();
            await _baronyRepo.DeleteLetterThread(_selected.Id);
            _selected = null;
            _draft = null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _snackBar.Add("Delete failed: " + ex.Message, Severity.Error);
        }
    }

    private async Task DeleteMessageAsync(BaronLetterMessageDTO message)
    {
        if (_selected is null) return;
        try
        {
            await _baronyRepo.DeleteLetterMessage(message.Id);
            _selected.Messages.RemoveAll(m => m.Id == message.Id);
            if (_draft?.Id == message.Id)
            {
                _draft = null;
                if (_canCompose)
                {
                    _draft = await EnsureDraftAsync(_selected);
                    _selected.Messages.Add(_draft);
                    _shouldLoadEditor = true;
                    _loadAttempts = 0;
                    _editor = null;
                }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _snackBar.Add("Delete failed: " + ex.Message, Severity.Error);
        }
    }

    private async Task SendAsync()
    {
        if (_selected is null || _draft is null || Barony is null || !_canCompose)
            return;

        if (_busy) return;

        if (_composeInbound)
        {
            RefreshReceivedCount();
            if (_receivedThisTurn >= BaronLetterRules.MaxLettersFromSameCorrespondentPerTurn)
            {
                _snackBar.Add(
                    $"This correspondent already sent {_receivedThisTurn}/{BaronLetterRules.MaxLettersFromSameCorrespondentPerTurn} letters this turn.",
                    Severity.Warning);
                return;
            }
        }

        await StopAutoSaveAsync();
        _busy = true;
        try
        {
            _draft.BodyHtml = await TryGetEditorHtmlAsync(_editor, _draft.BodyHtml) ?? _draft.BodyHtml;
            _draft.Status = BaronLetterStatus.Sent;
            _draft.SentAtUtc = DateTime.UtcNow;
            _draft.TurnNumber = Barony.TurnNumber;
            _draft.Year = Barony.Year;
            _draft.Month = Barony.Month;
            _draft.Season = Barony.Season;
            _draft.IsInbound = _composeInbound;
            if (_composeInbound)
                _draft.SeenByBaron = false;

            _draft = await _baronyRepo.SaveLetterMessage(_draft);

            // Replace in thread list
            var idx = _selected.Messages.FindIndex(m => m.Id == _draft.Id);
            if (idx >= 0) _selected.Messages[idx] = CloneMessage(_draft);
            else _selected.Messages.Add(CloneMessage(_draft));

            _snackBar.Add("Letter sent.", Severity.Success);

            // Fresh draft for the next message in this thread.
            _draft = await EnsureDraftAsync(_selected);
            _selected.Messages.Add(_draft);
            _shouldLoadEditor = true;
            _loadAttempts = 0;
            _editor = null;
            _saveHint = null;
            RefreshReceivedCount();
            StartAutoSaveLoop();
            await ReloadAsync(selectThreadId: _selected.Id);
        }
        catch (Exception ex)
        {
            _snackBar.Add("Send failed: " + ex.Message, Severity.Error);
            if (_canCompose) StartAutoSaveLoop();
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartAutoSaveLoop()
    {
        _autoSaveCts?.Cancel();
        _autoSaveCts?.Dispose();
        _autoSaveTimer?.Dispose();

        _autoSaveCts = new CancellationTokenSource();
        _autoSaveTimer = new PeriodicTimer(TimeSpan.FromSeconds(4));
        _autoSaveLoop = AutoSaveLoopAsync(_autoSaveCts.Token);
    }

    private async Task AutoSaveLoopAsync(CancellationToken ct)
    {
        try
        {
            while (await _autoSaveTimer!.WaitForNextTickAsync(ct))
            {
                if (_draft?.IsDraft == true)
                    await PersistDraftAsync(silent: true);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task PersistDraftAsync(bool silent)
    {
        if (_draft is null || !_draft.IsDraft || !_canCompose)
            return;

        if (silent)
        {
            if (_autoSaveInFlight || _busy) return;
            _autoSaveInFlight = true;
            try { await PersistDraftCoreAsync(silent: true); }
            finally { _autoSaveInFlight = false; }
            return;
        }

        if (_busy) return;
        _busy = true;
        try { await PersistDraftCoreAsync(silent: false); }
        finally { _busy = false; }
    }

    private async Task PersistDraftCoreAsync(bool silent)
    {
        if (_draft is null || !_draft.IsDraft) return;

        _draft.BodyHtml = await TryGetEditorHtmlAsync(_editor, _draft.BodyHtml) ?? _draft.BodyHtml;
        _draft.Status = BaronLetterStatus.Draft;
        _draft.IsInbound = _composeInbound;
        if (Barony is not null && _draft.TurnNumber <= 0)
        {
            _draft.TurnNumber = Barony.TurnNumber;
            _draft.Year = Barony.Year;
            _draft.Month = Barony.Month;
            _draft.Season = Barony.Season;
        }

        _draft = await _baronyRepo.SaveLetterMessage(_draft);
        if (_selected is not null)
        {
            var idx = _selected.Messages.FindIndex(m => m.Id == _draft.Id);
            if (idx >= 0) _selected.Messages[idx] = CloneMessage(_draft);
            else _selected.Messages.Add(CloneMessage(_draft));
        }

        _saveHint = silent ? $"auto-saved {DateTime.Now:HH:mm:ss}" : $"saved {DateTime.Now:HH:mm:ss}";
        await InvokeAsync(StateHasChanged);
    }

    private async Task StopAutoSaveAsync()
    {
        if (_autoSaveCts is not null)
        {
            await _autoSaveCts.CancelAsync();
            _autoSaveCts.Dispose();
            _autoSaveCts = null;
        }

        _autoSaveTimer?.Dispose();
        _autoSaveTimer = null;

        if (_autoSaveLoop is not null)
        {
            try { await _autoSaveLoop; }
            catch (OperationCanceledException) { }
            _autoSaveLoop = null;
        }
    }

    private async Task<string?> TryGetEditorHtmlAsync(BlazoredTextEditor? editor, string? fallback)
    {
        if (editor is null) return fallback;
        try
        {
            var htmlTask = editor.GetHTML();
            var winner = await Task.WhenAny(htmlTask, Task.Delay(EditorJsTimeoutMs));
            if (winner != htmlTask) return fallback;
            return await htmlTask ?? fallback;
        }
        catch { return fallback; }
    }

    private static string MonthName(int month) =>
        month is >= 1 and <= 12
            ? System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(month)
            : month.ToString();

    private static BaronLetterThreadDTO CloneThread(BaronLetterThreadDTO t) => new()
    {
        Id = t.Id,
        BaronyId = t.BaronyId,
        Title = t.Title,
        RelationId = t.RelationId,
        CorrespondentName = t.CorrespondentName,
        CorrespondentTitle = t.CorrespondentTitle,
        CorrespondentCategory = t.CorrespondentCategory,
        ReplyRegion = t.ReplyRegion,
        CreatedAtUtc = t.CreatedAtUtc,
        UpdatedAtUtc = t.UpdatedAtUtc,
        Messages = t.Messages.Select(CloneMessage).ToList(),
    };

    private static BaronLetterMessageDTO CloneMessage(BaronLetterMessageDTO m) => new()
    {
        Id = m.Id,
        ThreadId = m.ThreadId,
        BodyHtml = m.BodyHtml,
        Status = m.Status,
        IsInbound = m.IsInbound,
        TurnNumber = m.TurnNumber,
        Year = m.Year,
        Month = m.Month,
        Season = m.Season,
        SeenByBaron = m.SeenByBaron,
        SortOrder = m.SortOrder,
        CreatedAtUtc = m.CreatedAtUtc,
        UpdatedAtUtc = m.UpdatedAtUtc,
        SentAtUtc = m.SentAtUtc,
    };

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_draft?.IsDraft == true && _canCompose)
                await PersistDraftAsync(silent: true);
        }
        catch { /* ignore on dispose */ }

        await StopAutoSaveAsync();
    }
}
