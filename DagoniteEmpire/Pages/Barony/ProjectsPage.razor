@page "/barony/projects"
@layout BaronyLayout
@inherits BaronyPageBase
@attribute [Authorize(Roles = SD.Role_Admin + "," + SD.Role_GameMaster + "," + SD.Role_DukePlayer)]
@inject ICharacterRepository _characterRepo

<PageTitle>Dagonite Empire | @L["Projects"]</PageTitle>

@if (IsLoading)
{
    <MudProgressCircular Indeterminate="true" Size="Size.Small" /> <span>@L["Loading projects..."]</span>
}
else if (LoadError is not null)
{
    <MudAlert Severity="Severity.Info" Class="my-2">@LoadError</MudAlert>
}
else if (_overview is not null)
{
    <BaronyPageHeader Title="@(L["Projects"])" HelpKey="projects">
        <Summary>
            <span class="projects-summary">
                @if (_allocatingCount > 0)
                {
                    <span class="projects-summary__item">@_allocatingCount awaiting resources</span>
                }
                @if (_inProgressCount > 0)
                {
                    <span class="projects-summary__item projects-summary__item--active">@_inProgressCount in progress</span>
                }
                @if (_allocatingCount == 0 && _inProgressCount == 0)
                {
                    <span class="projects-summary__item">@_projects.Count project@(_projects.Count == 1 ? "" : "s")</span>
                }
            </span>
        </Summary>
    </BaronyPageHeader>

    <ProjectsBalanceSection Projects="@_projects"
                            Audiences="@(_overview.Audiences)"
                            Events="@(_overview.Events)"
                            CurrentTurn="@_overview.Barony.TurnNumber"
                            CanManage="@CanManageAsMg" />

    <ProjectsSection BaronyId="@BaronyId"
                     Projects="@_projects"
                     ResourceStocks="@_overview.Barony.ResourceStocks"
                     LoyaltyTotal="@_loyaltyTotal"
                     CanEdit="@CanEdit"
                     CanManage="@CanManageAsMg"
                     OnChanged="ReloadAsync" />
}

@code {
    private BaronyOverviewDTO? _overview;
    private List<BaronyProjectDTO> _projects = new();
    private decimal _loyaltyTotal;
    private int _inProgressCount => _projects.Count(p => p.Status == ProjectStatus.InProgress);
    private int _allocatingCount => _projects.Count(p => ProjectStatus.IsResourceAllocation(p.Status));

    protected override async Task OnInitializedAsync()
    {
        await LoadBaronyAsync();
        if (Barony is null)
            return;

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (Barony is null)
            return;

        _overview = await _baronyRepo.GetOverview(Barony.Id);
        _projects = _overview?.Projects ?? new List<BaronyProjectDTO>();
        if (_overview is not null && Barony is not null)
        {
            var character = await _characterRepo.GetById(Barony.CharacterId, fullIncludes: true);
            var baronModifiers = await _baronyRepo.GetBaronInfluenceModifiers(Barony.Id);
            var advisorModifiers = await _baronyRepo.GetAdvisorInfluenceModifiers(Barony.Id);
            await _baronyRepo.EnsureBaronTimeDefaults(Barony.Id);
            var managementJc = BaronyCalc.ManagementJcSpent(await _baronyRepo.GetBaronTimeActions(Barony.Id));
            var panel = BaronyCalc.BuildDomainPanelRows(
                _overview, character, baronModifiers, advisorModifiers, managementJc);
            _loyaltyTotal = panel.GrandTotal[Ppb.Loyalty];
        }
        NotifyResourceHud();
        await InvokeAsync(StateHasChanged);
    }
}
