    private Task HoverCellAsync((int? X, int? Y) cell)
    {
        _hoverX = cell.X;
        _hoverY = cell.Y;
        if (cell.X is int x && cell.Y is int y)
        {
            _hoverTileLines = TileDetailLines(x, y);
            _hoverTileInfo = string.Join("; ", _hoverTileLines);
        }
        else
        {
            _hoverTileLines = Array.Empty<string>();
            _hoverTileInfo = "Hover a tile for details.";
        }
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task PaintCellAsync((int X, int Y, bool ContinuingStroke) cell) => PaintMode switch
    {
        TerrainPaintMode.Fertility => PaintFertilityAsync((cell.X, cell.Y)),
        TerrainPaintMode.TerrainType => PaintTerrainTypeAsync((cell.X, cell.Y)),
        TerrainPaintMode.Domain => PaintDomainAsync((cell.X, cell.Y)),
        TerrainPaintMode.Fief => PaintFiefAsync((cell.X, cell.Y)),
        TerrainPaintMode.Resource => PaintResourceAsync((cell.X, cell.Y)),
        TerrainPaintMode.Improvement => PaintImprovementAsync((cell.X, cell.Y), cell.ContinuingStroke),
        _ => Task.CompletedTask,
    };

    private async Task PaintFertilityAsync((int X, int Y) cell)
    {
        if (Barony is null || !CanManageAsMg || PaintMode != TerrainPaintMode.Fertility)
            return;

        var key = (cell.X, cell.Y);
        var tile = GetOrCreateTile(cell.X, cell.Y);
        if (!TerrainBaseType.SupportsFertility(tile.BaseType))
            return;

        if (_brushFertility == TerrainFertility.Unknown)
        {
            if (tile.Fertility == TerrainFertility.Unknown)
                return;

            tile.Fertility = TerrainFertility.Unknown;
            await SaveTileAsync(key, tile);
            await RefreshSettlementPpbOnTileAsync(tile);
            RefreshHoverInfo(cell.X, cell.Y);
            StateHasChanged();
            return;
        }

        if (TerrainFertility.IsKnown(tile.Fertility) && tile.Fertility == _brushFertility)
            return;

        tile.Fertility = _brushFertility;
        await SaveTileAsync(key, tile);
        await RefreshSettlementPpbOnTileAsync(tile);
        RefreshHoverInfo(cell.X, cell.Y);
        StateHasChanged();
    }

    private async Task PaintTerrainTypeAsync((int X, int Y) cell)
    {
        if (Barony is null || !CanManageAsMg || PaintMode != TerrainPaintMode.TerrainType)
            return;

        var key = (cell.X, cell.Y);
        var tile = GetOrCreateTile(cell.X, cell.Y);

        if (_terrainTypeSubMode == TerrainTypeSubMode.Feature)
        {
            if (!TerrainFeature.Paintable.Contains(_brushFeature))
                return;

            var nextMask = TerrainFeature.ApplyPaintToggle(tile.FeaturesMask, _brushFeature);
            if (nextMask == tile.FeaturesMask)
                return;

            tile.FeaturesMask = nextMask;
            await SaveTileAsync(key, tile);
            RefreshHoverInfo(cell.X, cell.Y);
            StateHasChanged();
            return;
        }

        if (!TerrainBaseType.IsKnown(_brushBaseType))
            return;

        var changed = false;

        if (tile.BaseType != _brushBaseType)
        {
            tile.BaseType = _brushBaseType;
            changed = true;
        }

        if (!TerrainBaseType.SupportsFertility(tile.BaseType)
            && tile.Fertility != TerrainFertility.Unknown)
        {
            tile.Fertility = TerrainFertility.Unknown;
            changed = true;
        }

        if (!changed)
            return;

        await SaveTileAsync(key, tile);
        RefreshHoverInfo(cell.X, cell.Y);
        StateHasChanged();
    }

    private async Task PaintDomainAsync((int X, int Y) cell)
    {
        if (Barony is null || !CanManageAsMg || PaintMode != TerrainPaintMode.Domain || _selectedDomainId is not int domainId)
            return;

        var key = (cell.X, cell.Y);
        var tile = GetOrCreateTile(cell.X, cell.Y);
        if (tile.MapDomainId == domainId)
            return;

        tile.MapDomainId = domainId;
        await SaveTileAsync(key, tile);
        RefreshHoverInfo(cell.X, cell.Y);
        StateHasChanged();
    }

    private async Task PaintFiefAsync((int X, int Y) cell)
    {
        if (Barony is null || !CanManageAsMg || PaintMode != TerrainPaintMode.Fief || _selectedFiefId is not int fiefId)
            return;

        if (!_fiefIndex.TryGetValue(fiefId, out var fief) || fief.SeniorDomainId is not int seniorDomainId)
            return;

        var key = (cell.X, cell.Y);
        var tile = GetOrCreateTile(cell.X, cell.Y);
        if (tile.MapDomainId != seniorDomainId)
            return;

        if (tile.FiefId == fiefId)
            return;

        tile.FiefId = fiefId;
        await SaveTileAsync(key, tile);
        RefreshHoverInfo(cell.X, cell.Y);
        StateHasChanged();
    }

    private async Task PaintResourceAsync((int X, int Y) cell)
    {
        if (Barony is null || !CanManageAsMg || PaintMode != TerrainPaintMode.Resource)
            return;

        var key = (cell.X, cell.Y);
        var tile = GetOrCreateTile(cell.X, cell.Y);
        var next = string.IsNullOrWhiteSpace(_brushResource) ? null : _brushResource;
        if (tile.Resource == next)
            return;

        tile.Resource = next;
        await SaveTileAsync(key, tile);
        RefreshHoverInfo(cell.X, cell.Y);
        StateHasChanged();
    }

    private Task OnPaintStrokeEndAsync()
    {
        _improvementPlaceNameStroke = null;
        _customPlacementStroke = null;
        return Task.CompletedTask;
    }

    private Task OnBrushImprovementChanged(string? value)
    {
        _brushImprovement = value;
        _improvementPlaceNameStroke = null;
        _customPlacementStroke = null;
        return Task.CompletedTask;
    }

    private async Task PaintImprovementAsync((int X, int Y) cell, bool continuingStroke)
    {
        if (Barony is null || !CanManageAsMg || PaintMode != TerrainPaintMode.Improvement)
            return;

        if (_improvementNamingInProgress)
            return;

        // Fresh click (not drag continuation): always ask for name / custom details again.
        // Otherwise a mouseup during the previous dialog leaves the stroke set and the next
        // town becomes a silent clone of the last one.
        if (!continuingStroke)
        {
            _improvementPlaceNameStroke = null;
            _customPlacementStroke = null;
        }

        var key = (cell.X, cell.Y);
        var tile = GetOrCreateTile(cell.X, cell.Y);
        if (tile.Id <= 0)
            await SaveTileAsync(key, tile);

        if (tile.Id <= 0)
            return;

        if (TerrainImprovementCatalogMap.IsWaterTile(tile.BaseType))
        {
            _snackBar.Add(L["Cannot place improvements on water."], Severity.Warning);
            return;
        }

        _improvementByTileId.TryGetValue(tile.Id, out var existing);
        var nextName = string.IsNullOrWhiteSpace(_brushImprovement) ? null : _brushImprovement;

        if (nextName is null)
        {
            _improvementPlaceNameStroke = null;
            _customPlacementStroke = null;
            if (existing is null)
                return;

            try
            {
                await _baronyRepo.DeleteImprovement(existing.Id);
                _improvementByTileId.Remove(tile.Id);
            }
            catch (Exception ex)
            {
                _snackBar.Add(L["Failed to remove improvement: "] + ex.Message, Severity.Error);
                return;
            }

            RefreshHoverInfo(cell.X, cell.Y);
            StateHasChanged();
            return;
        }

        string? placeName = null;
        if (MapImprovement.RequiresPlaceName(nextName))
        {
            if (_improvementPlaceNameStroke is null
                && (existing is null
                    || existing.Name != nextName
                    || string.IsNullOrWhiteSpace(existing.Description)))
            {
                _improvementNamingInProgress = true;
                try
                {
                    var parameters = new DialogParameters
                    {
                        [nameof(NameImprovementDialog.ImprovementKind)] = nextName,
                        [nameof(NameImprovementDialog.InitialName)] = existing?.Name == nextName
                            ? existing.Description
                            : null,
                        [nameof(NameImprovementDialog.InitialPopulation)] = existing?.Population ?? 0,
                        [nameof(NameImprovementDialog.InitialHasPalisade)] = existing?.HasPalisade ?? false,
                    };
                    var options = new DialogOptions
                    {
                        CloseOnEscapeKey = true,
                        MaxWidth = MaxWidth.ExtraSmall,
                        FullWidth = true,
                    };
                    var dialog = await _dialogService.ShowAsync<NameImprovementDialog>(
                        string.Empty,
                        parameters,
                        options);
                    var result = await dialog.Result;
                    if (result is null || result.Canceled || result.Data is not NameImprovementDialog.PlaceNameDraft chosen)
                        return;

                    _improvementPlaceNameStroke = chosen;
                }
                finally
                {
                    _improvementNamingInProgress = false;
                }
            }

            placeName = _improvementPlaceNameStroke?.Name ?? existing?.Description;
        }
        else if (MapImprovement.IsCustom(nextName))
        {
            if (_customPlacementStroke is null)
            {
                _improvementNamingInProgress = true;
                try
                {
                    var prefill = existing is not null && MapImprovement.IsCustom(existing.Name)
                        ? existing
                        : null;
                    var parameters = new DialogParameters
                    {
                        [nameof(CustomImprovementDialog.InitialName)] = prefill?.Description,
                        [nameof(CustomImprovementDialog.InitialIconUrl)] = prefill?.IconUrl,
                        [nameof(CustomImprovementDialog.InitialAdditive)] = prefill?.Additive,
                        [nameof(CustomImprovementDialog.InitialPercent)] = prefill?.Percent,
                    };
                    var options = new DialogOptions
                    {
                        CloseOnEscapeKey = true,
                        MaxWidth = MaxWidth.Medium,
                        FullWidth = true,
                    };
                    var dialog = await _dialogService.ShowAsync<CustomImprovementDialog>(
                        string.Empty,
                        parameters,
                        options);
                    var result = await dialog.Result;
                    if (result is null
                        || result.Canceled
                        || result.Data is not CustomImprovementDialog.CustomImprovementDraft draft)
                        return;

                    _customPlacementStroke = draft;
                }
                finally
                {
                    _improvementNamingInProgress = false;
                }
            }
        }
        else
        {
            _improvementPlaceNameStroke = null;
            _customPlacementStroke = null;
            // Re-paint allowed: fertility/resource may have changed → refresh catalog PPB.
        }

        if (TerrainImprovementCatalogMap.IsCatalogBacked(nextName))
        {
            if (!TerrainImprovementCatalogMap.CanPlaceMapImprovement(
                    nextName, tile.Fertility, tile.Resource, tile.FeaturesMask, tile.BaseType))
            {
                var reason = TerrainImprovementCatalogMap.FailureReason(
                    nextName, tile.Fertility, tile.Resource, tile.FeaturesMask, tile.BaseType)
                    ?? "Cannot place this improvement on this tile.";
                _snackBar.Add(reason, Severity.Warning);
                return;
            }
        }

        try
        {
            var dto = existing ?? new TerrainImprovementDTO
            {
                BaronyId = Barony.Id,
                TileId = tile.Id,
            };
            dto.BaronyId = Barony.Id;
            dto.TileId = tile.Id;
            dto.Name = nextName;

            if (MapImprovement.IsCustom(nextName) && _customPlacementStroke is not null)
            {
                var draft = _customPlacementStroke;
                dto.TemplateId = null;
                dto.Description = draft.Name;
                dto.IconUrl = draft.IconUrl;
                dto.Additive = draft.Additive.Clone();
                dto.Percent = draft.Percent.Clone();
                dto.FormulaText = null;
            }
            else if (TerrainImprovementCatalogMap.IsCatalogBacked(nextName))
            {
                var population = nextName is MapImprovement.Village or MapImprovement.Town
                    ? (_improvementPlaceNameStroke?.Population ?? existing?.Population ?? 0)
                    : existing?.Population ?? 0;
                var hasPalisade = nextName == MapImprovement.Village
                    && (_improvementPlaceNameStroke?.HasPalisade ?? existing?.HasPalisade ?? false);
                if (!ApplyCatalogTemplate(dto, nextName, tile, placeName, population, hasPalisade))
                    return;
            }
            else
            {
                dto.Description = placeName;
                dto.TemplateId = null;
                dto.IconUrl = null;
                if (nextName == MapImprovement.Town)
                {
                    dto.Population = Math.Max(0, _improvementPlaceNameStroke?.Population ?? existing?.Population ?? 0);
                    dto.HasPalisade = false;
                    dto.Additive = TownPpbFormulas.Compute(dto.Population);
                    dto.Percent = new PpbVector();
                    dto.FormulaText = TownPpbFormulas.CatalogDescription;
                }
            }

            var saved = await _baronyRepo.SaveImprovement(dto);
            _improvementByTileId[tile.Id] = saved;
        }
        catch (Exception ex)
        {
            _snackBar.Add(L["Failed to save improvement: "] + ex.Message, Severity.Error);
            return;
        }

        RefreshHoverInfo(cell.X, cell.Y);
        StateHasChanged();
    }

    /// <summary>
    /// Copies PPB from the Buildings catalog. Keeps Name as the map kind (for icons).
    /// Village/Town place names stay in Description; other kinds store the catalog name there for Domain Panel.
    /// Villages use Population + fertility + optional palisade formulas instead of fixed catalog PPB.
    /// </summary>
    private bool ApplyCatalogTemplate(
        TerrainImprovementDTO dto,
        string mapKind,
        TerrainTileDTO tile,
        string? placeName,
        int population = 0,
        bool hasPalisade = false)
    {
        var templateName = TerrainImprovementCatalogMap.ResolveTemplateName(
            mapKind, tile.Fertility, tile.Resource, tile.FeaturesMask, tile.BaseType);
        if (templateName is null)
            return false;

        var template = _improvementTemplates.FirstOrDefault(t =>
            string.Equals(t.Name, templateName, StringComparison.OrdinalIgnoreCase));
        if (template is null)
        {
            _snackBar.Add(L["Catalog entry “{0}” not found. Restart the app to reseed Buildings.", templateName], Severity.Error);
            return false;
        }

        dto.TemplateId = template.Id;
        dto.FormulaText = template.Description;
        dto.Description = MapImprovement.RequiresPlaceName(mapKind)
            ? placeName
            : template.Name;
        dto.Percent = new PpbVector();

        if (mapKind == MapImprovement.Village)
        {
            dto.Population = Math.Max(0, population);
            dto.HasPalisade = hasPalisade;
            dto.Additive = VillagePpbFormulas.Compute(dto.Population, tile.Fertility, dto.HasPalisade);
            dto.FormulaText = VillagePpbFormulas.CatalogDescription;
        }
        else
        {
            dto.Additive = template.EffectAdditive.Clone();
            dto.Percent = template.EffectPercent.Clone();

            if (mapKind == MapImprovement.FishingHarbor
                && TerrainImprovementCatalogMap.HasFisheryBonus(tile.Resource))
            {
                dto.Additive[Ppb.Food] += TerrainImprovementCatalogMap.FishingHarborFisheryFoodBonus;
                dto.Additive[Ppb.Treasury] += TerrainImprovementCatalogMap.FishingHarborFisheryTreasuryBonus;
            }
        }

        if (!string.IsNullOrWhiteSpace(template.IconUrl))
            dto.IconUrl = template.IconUrl.Trim();

        // Vassal gold share is applied at Domain Panel / Budget calc time (Barony.VassalTributePercent),
        // not stored into Additive — keep full village/town yields on the map entity.
        return true;
    }

    private async Task RefreshSettlementPpbOnTileAsync(TerrainTileDTO tile)
    {
        if (!_improvementByTileId.TryGetValue(tile.Id, out var improvement))
            return;

        if (string.Equals(improvement.Name, MapImprovement.Village, StringComparison.OrdinalIgnoreCase))
        {
            improvement.Additive = VillagePpbFormulas.Compute(improvement.Population, tile.Fertility, improvement.HasPalisade);
            improvement.Percent = new PpbVector();
            improvement.FormulaText = VillagePpbFormulas.CatalogDescription;
        }
        else if (string.Equals(improvement.Name, MapImprovement.Town, StringComparison.OrdinalIgnoreCase))
        {
            improvement.HasPalisade = false;
            improvement.Additive = TownPpbFormulas.Compute(improvement.Population);
            improvement.Percent = new PpbVector();
            improvement.FormulaText = TownPpbFormulas.CatalogDescription;
        }
        else
        {
            return;
        }

        try
        {
            var saved = await _baronyRepo.SaveImprovement(improvement);
            _improvementByTileId[tile.Id] = saved;
        }
        catch (Exception ex)
        {
            _snackBar.Add(L["Failed to refresh settlement PPB: "] + ex.Message, Severity.Error);
        }
    }

    private async Task ClearDomainFromTilesAsync(int domainId)
    {
        foreach (var kvp in _tileIndex.ToList())
        {
            var tile = kvp.Value;
            if (tile.MapDomainId != domainId)
                continue;

            tile.MapDomainId = null;
            await SaveTileAsync(kvp.Key, tile);
        }
    }

    private async Task ClearFiefFromTilesAsync(int fiefId)
    {
        foreach (var kvp in _tileIndex.ToList())
        {
            var tile = kvp.Value;
            if (tile.FiefId != fiefId)
                continue;

            tile.FiefId = null;
            await SaveTileAsync(kvp.Key, tile);
        }
    }

    private async Task ClearCurrentLayerAsync()
    {
        if (Barony is null || !CanManageAsMg || PaintMode == TerrainPaintMode.None)
            return;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Are you sure? This will clear data on all tiles for the selected layer.");
        if (!confirmed)
            return;

        foreach (var kvp in _tileIndex.ToList())
        {
            var key = kvp.Key;
            var tile = kvp.Value;
            var changed = false;

            switch (PaintMode)
            {
                case TerrainPaintMode.Fertility:
                    if (TerrainBaseType.SupportsFertility(tile.BaseType) && tile.Fertility != TerrainFertility.Unknown)
                    {
                        tile.Fertility = TerrainFertility.Unknown;
                        changed = true;
                    }
                    break;
                case TerrainPaintMode.TerrainType:
                    if (tile.BaseType != TerrainBaseType.Plains)
                    {
                        tile.BaseType = TerrainBaseType.Plains;
                        changed = true;
                    }
                    if (tile.FeaturesMask != TerrainFeature.None)
                    {
                        tile.FeaturesMask = TerrainFeature.None;
                        changed = true;
                    }
                    break;
                case TerrainPaintMode.Domain:
                    if (tile.MapDomainId is not null)
                    {
                        tile.MapDomainId = null;
                        changed = true;
                    }
                    break;
                case TerrainPaintMode.Fief:
                    if (tile.FiefId is not null)
                    {
                        tile.FiefId = null;
                        changed = true;
                    }
                    break;
                case TerrainPaintMode.Resource:
                    if (!string.IsNullOrWhiteSpace(tile.Resource))
                    {
                        tile.Resource = null;
                        changed = true;
                    }
                    break;
            }

            if (changed)
                await SaveTileAsync(key, tile);
        }

        if (PaintMode == TerrainPaintMode.Improvement)
        {
            foreach (var improvement in _improvementByTileId.Values.ToList())
            {
                try
                {
                    await _baronyRepo.DeleteImprovement(improvement.Id);
                }
                catch (Exception ex)
                {
                    _snackBar.Add(L["Failed to clear improvement: "] + ex.Message, Severity.Error);
                }
            }

            _improvementByTileId.Clear();
        }

        if (_hoverX is int x && _hoverY is int y)
        {
            _hoverTileLines = TileDetailLines(x, y);
            _hoverTileInfo = string.Join("; ", _hoverTileLines);
        }
        StateHasChanged();
    }

    private TerrainTileDTO GetOrCreateTile(int x, int y)
    {
        var key = (x, y);
        if (_tileIndex.TryGetValue(key, out var tile))
            return tile;

        tile = new TerrainTileDTO
        {
            BaronyId = Barony!.Id,
            X = x,
            Y = y,
            BaseType = TerrainBaseType.Plains,
            Fertility = TerrainFertility.Unknown,
        };
        _tileIndex[key] = tile;
        return tile;
    }

    private async Task SaveTileAsync((int X, int Y) key, TerrainTileDTO tile)
    {
        tile.BaronyId = Barony!.Id;
        try
        {
            var saved = await _baronyRepo.SaveTile(tile);
            _tileIndex[key] = saved;
        }
        catch (Exception ex)
        {
            _snackBar.Add(L["Failed to save terrain tile: "] + ex.Message, Severity.Error);
        }
    }

    private void RefreshHoverInfo(int x, int y)
    {
        if (_hoverX == x && _hoverY == y)
        {
            _hoverTileLines = TileDetailLines(x, y);
            _hoverTileInfo = string.Join("; ", _hoverTileLines);
        }
    }

    private Task ToggleLayerAsync(TerrainMapLayer layer)
    {
        ToggleLayer(layer);
        return Task.CompletedTask;
    }

    private void ToggleLayer(TerrainMapLayer layer)
    {
        if (!_visibleLayers.Remove(layer))
            _visibleLayers.Add(layer);
    }

    private IReadOnlyList<string> TileDetailLines(int x, int y)
    {
        if (!_tileIndex.TryGetValue((x, y), out var tile))
        {
            return new[]
            {
                $"[{x}, {y}]",
                "Plains with unknown fertility",
            };
        }

        var title = $"[{x}, {y}]";
        TerrainImprovementDTO? improvement = null;
        if (tile.Id > 0)
            _improvementByTileId.TryGetValue(tile.Id, out improvement);

        if (improvement is not null)
        {
            var name = string.IsNullOrWhiteSpace(improvement.Description)
                ? MapImprovement.DisplayName(improvement.Name)
                : improvement.Description.Trim();
            title = $"[{x}, {y}] {name}";
        }
        else if (tile.Id > 0 && _constructionByTileId.TryGetValue(tile.Id, out var construction))
        {
            title = $"[{x}, {y}] Under construction: {construction.Name}";
        }

        return new[] { title, BuildTileProse(tile) };
    }

    private string BuildTileProse(TerrainTileDTO tile)
    {
        var chunks = new List<string>();

        var terrain = TerrainBaseType.DisplayName(tile.BaseType);
        var features = TerrainFeature.Paintable
            .Where(f => tile.HasFeature(f))
            .Select(f => TerrainFeature.DisplayName(f).ToLowerInvariant())
            .ToList();
        if (features.Count > 0)
            chunks.Add($"{terrain} with {JoinFeatureNames(features)}");
        else
            chunks.Add(terrain);

        if (TerrainBaseType.SupportsFertility(tile.BaseType))
            chunks.Add(TerrainFertility.Phrase(tile.Fertility));

        if (tile.MapDomainId is int domainId && _domainsById.TryGetValue(domainId, out var domain))
            chunks.Add($"{domain.Name} (lord {domain.LordName})");

        if (tile.FiefId is int fiefId && _fiefIndex.TryGetValue(fiefId, out var fief))
            chunks.Add($"fief of {TerrainMapVisuals.FiefChipTitle(fief)}");

        if (!string.IsNullOrWhiteSpace(tile.Resource))
            chunks.Add($"{TerrainResource.DisplayName(tile.Resource).ToLowerInvariant()} deposit");

        return string.Join(", ", chunks);
    }

    private static string JoinFeatureNames(IReadOnlyList<string> names)
    {
        if (names.Count == 1)
            return names[0];
        if (names.Count == 2)
            return $"{names[0]} and {names[1]}";
        return string.Join(", ", names.Take(names.Count - 1)) + " and " + names[^1];
    }

    private string TileDetailText(int x, int y) => string.Join("; ", TileDetailLines(x, y));
}
