@page "/barony/terrain"
@layout BaronyLayout
@inherits BaronyPageBase
@attribute [Authorize(Roles = SD.Role_Admin + "," + SD.Role_GameMaster + "," + SD.Role_DukePlayer)]
@inject IDialogService _dialogService
@inject IJSRuntime JS

<PageTitle>Dagonite Empire | @L["Terrain"]</PageTitle>

@if (IsLoading)
{
    <MudProgressCircular Indeterminate="true" Size="Size.Small" /> <span>@L["Loading terrain map..."]</span>
}
else if (LoadError is not null)
{
    <MudAlert Severity="Severity.Info" Class="my-2">@LoadError</MudAlert>
}
else
{
    <div class="terrain-page">
        <BaronyPageHeader Title="@(L["Terrain"])" HelpKey="terrain" ShowSectionToggle="false">
            <Summary>
                <span class="terrain-page__summary">@_tileIndex.Count / @TotalCells tiles defined</span>
            </Summary>
        </BaronyPageHeader>

        @if (CanManageAsMg)
        {
            <BaronySection Title="@(L["Brushes & layers"])" DefaultOpen="false">
                <ChildContent>
                    <div class="terrain-page__mg-editor">
                        <div class="terrain-page__brushes">
                            <MudTabs @bind-ActivePanelIndex="_brushTabIndex"
                                     Elevation="0"
                                     Rounded="false"
                                     Border="false"
                                     ApplyEffectsToContainer="false"
                                     Class="terrain-brush-tabs">
                                <MudTabPanel Text="@(L["Off"])">
                                    <div class="terrain-brush">
                                        <MudText Typo="Typo.caption" Class="terrain-brush__hint">
                                            @L["No brush selected. Hover tiles to inspect the map."]
                                        </MudText>
                                        <div class="terrain-brush__body"></div>
                                    </div>
                                </MudTabPanel>
                                <MudTabPanel Text="@(L["Fertility"])">
                                    <TerrainFertilityBrush Value="@_brushFertility"
                                                           ValueChanged="v => _brushFertility = v" />
                                </MudTabPanel>
                                <MudTabPanel Text="@(L["Terrain type"])">
                                    <TerrainTypeBrush SubMode="@_terrainTypeSubMode"
                                                      SubModeChanged="v => _terrainTypeSubMode = v"
                                                      BaseTypeValue="@_brushBaseType"
                                                      BaseTypeValueChanged="v => _brushBaseType = v"
                                                      FeatureValue="@_brushFeature"
                                                      FeatureValueChanged="v => _brushFeature = v" />
                                </MudTabPanel>
                                <MudTabPanel Text="@(L["Domain"])">
                                    <TerrainDomainBrush Domains="@_mapDomains"
                                                        TileCountsByDomainId="@DomainTileCounts"
                                                        SelectedDomainId="@_selectedDomainId"
                                                        SelectedDomainIdChanged="v => _selectedDomainId = v"
                                                        OnDomainColorChanged="OnDomainColorChangedAsync"
                                                        OnAddDomain="OpenAddDomainDialogAsync"
                                                        OnEditDomain="OpenEditDomainDialogAsync"
                                                        OnDeleteDomain="DeleteDomainAsync" />
                                </MudTabPanel>
                                <MudTabPanel Text="@(L["Fief"])">
                                    <TerrainFiefBrush Fiefs="@_fiefs"
                                                      DomainsById="@_domainsById"
                                                      TileCountsByFiefId="@FiefTileCounts"
                                                      SelectedFiefId="@_selectedFiefId"
                                                      SelectedFiefIdChanged="v => _selectedFiefId = v"
                                                      OnFiefColorChanged="OnFiefColorChangedAsync"
                                                      OnAddFief="OpenAddFiefDialogAsync"
                                                      OnEditFief="OpenEditFiefDialogAsync"
                                                      OnDeleteFief="DeleteFiefAsync" />
                                </MudTabPanel>
                                <MudTabPanel Text="@(L["Resources"])">
                                    <TerrainResourceBrush Value="@_brushResource"
                                                          ValueChanged="v => _brushResource = v" />
                                </MudTabPanel>
                                <MudTabPanel Text="@(L["Improvements"])">
                                    <TerrainImprovementBrush Value="@_brushImprovement"
                                                             ValueChanged="OnBrushImprovementChanged" />
                                </MudTabPanel>
                                <MudTabPanel Text="@(L["Map Size"])">
                                    <TerrainMapSizePanel Width="@GridWidth"
                                                         Height="@GridHeight"
                                                         OnResize="ResizeMapAsync" />
                                </MudTabPanel>
                            </MudTabs>
                        </div>
                        <TerrainMapLayersBar VisibleLayers="@_visibleLayers"
                                             ShowClearLayer="@(PaintMode != TerrainPaintMode.None)"
                                             OnToggleLayer="ToggleLayerAsync"
                                             OnClearLayer="ClearCurrentLayerAsync" />
                    </div>
                </ChildContent>
            </BaronySection>
        }
        else
        {
            <TerrainMapLayersBar VisibleLayers="@_visibleLayers"
                                  OnToggleLayer="ToggleLayerAsync" />
        }

        <TerrainMapGrid GridWidth="@GridWidth"
                        GridHeight="@GridHeight"
                        CellSizePx="@TerrainMapConstants.CellSizePx"
                        Tiles="@_tileIndex"
                        Fiefs="@_fiefIndex"
                        ImprovementsByTileId="@_improvementByTileId"
                        ConstructionsByTileId="@_constructionByTileId"
                        DomainsById="@_domainsById"
                        VisibleLayers="@_visibleLayers"
                        HoveredX="@_hoverX"
                        HoveredY="@_hoverY"
                        HoverLines="@_hoverTileLines"
                        PaintEnabled="@(CanManageAsMg && PaintMode != TerrainPaintMode.None)"
                        ClickEnabled="@CanProposeConstruction"
                        CanProposeBuildAt="CanProposeBuildAt"
                        OnCellHover="HoverCellAsync"
                        OnCellPaint="PaintCellAsync"
                        OnCellClick="OnTileClickAsync"
                        OnPaintStrokeEnd="OnPaintStrokeEndAsync" />
    </div>
}

@code {
    private int GridWidth => Barony is null
        ? DA_Common.Barony.TerrainMapGrid.DefaultSize
        : DA_Common.Barony.TerrainMapGrid.ClampDimension(
            Barony.TerrainMapWidth > 0 ? Barony.TerrainMapWidth : DA_Common.Barony.TerrainMapGrid.DefaultSize);
    private int GridHeight => Barony is null
        ? DA_Common.Barony.TerrainMapGrid.DefaultSize
        : DA_Common.Barony.TerrainMapGrid.ClampDimension(
            Barony.TerrainMapHeight > 0 ? Barony.TerrainMapHeight : DA_Common.Barony.TerrainMapGrid.DefaultSize);
    private static readonly TerrainMapLayer[] AllLayers = Enum.GetValues<TerrainMapLayer>();

    private int TotalCells => GridWidth * GridHeight;

    private Dictionary<int, int> DomainTileCounts => CountTilesBy(t => t.MapDomainId);
    private Dictionary<int, int> FiefTileCounts => CountTilesBy(t => t.FiefId);

    private Dictionary<int, int> CountTilesBy(Func<TerrainTileDTO, int?> idSelector)
    {
        var counts = new Dictionary<int, int>();
        foreach (var tile in _tileIndex.Values)
        {
            if (idSelector(tile) is not int id)
                continue;
            counts[id] = counts.GetValueOrDefault(id) + 1;
        }

        return counts;
    }

    private Dictionary<(int X, int Y), TerrainTileDTO> _tileIndex = new();
    private Dictionary<int, FiefDTO> _fiefIndex = new();
    private List<FiefDTO> _fiefs = new();
    private Dictionary<int, TerrainImprovementDTO> _improvementByTileId = new();
    private Dictionary<int, BaronyProjectDTO> _constructionByTileId = new();
    private Dictionary<int, TerrainMapDomainDTO> _domainsById = new();
    private List<TerrainMapDomainDTO> _mapDomains = new();
    private HashSet<TerrainMapLayer> _visibleLayers = new(
        AllLayers.Where(l => l is not TerrainMapLayer.Fertility and not TerrainMapLayer.Fief));

    private int? _hoverX;
    private int? _hoverY;
    private string _hoverTileInfo = "Hover a tile for details.";
    private IReadOnlyList<string> _hoverTileLines = Array.Empty<string>();
    private int _brushTabIndex;
    private int _brushFertility = 3;
    private string _brushBaseType = TerrainBaseType.Plains;
    private TerrainTypeSubMode _terrainTypeSubMode = TerrainTypeSubMode.Base;
    private int _brushFeature = TerrainFeature.Forest;
    private string? _brushResource = TerrainResource.Iron;
    private string? _brushImprovement = MapImprovement.Village;
    private NameImprovementDialog.PlaceNameDraft? _improvementPlaceNameStroke;
    private CustomImprovementDialog.CustomImprovementDraft? _customPlacementStroke;
    private bool _improvementNamingInProgress;
    private List<BuildingTemplateDTO> _improvementTemplates = new();
    private TradeGoodAvailabilitySnapshot _tradeGoodAvailability = new();
    private int? _selectedDomainId;
    private int? _selectedFiefId;
    private int? _playerPrimaryDomainId;

    /// <summary>Baron (or MG with brush off) may propose a construction project on domain tiles.</summary>
    private bool CanProposeConstruction =>
        CanEdit && !(CanManageAsMg && PaintMode != TerrainPaintMode.None);

    private TerrainPaintMode PaintMode => _brushTabIndex switch
    {
        1 => TerrainPaintMode.Fertility,
        2 => TerrainPaintMode.TerrainType,
        3 => TerrainPaintMode.Domain,
        4 => TerrainPaintMode.Fief,
        5 => TerrainPaintMode.Resource,
        6 => TerrainPaintMode.Improvement,
        _ => TerrainPaintMode.None,
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadBaronyAsync();
        if (Barony is null)
            return;

        await LoadMapDataAsync();
    }

    private async Task LoadMapDataAsync()
    {
        if (Barony is null)
            return;

        Barony = await _baronyRepo.GetById(Barony.Id) ?? Barony;
        var tiles = await _baronyRepo.EnsureTerrainGrid(Barony.Id);
        _tileIndex = tiles.ToDictionary(t => (t.X, t.Y));

        var improvements = await _baronyRepo.GetImprovements(Barony.Id);
        _improvementByTileId = improvements
            .Where(i => i.TileId is int tileId)
            .GroupBy(i => i.TileId!.Value)
            .ToDictionary(g => g.Key, g => g.First());

        var projects = await _baronyRepo.GetProjects(Barony.Id);
        _constructionByTileId = projects
            .Where(p => p.IsActiveMapConstruction && p.TileId is int)
            .GroupBy(p => p.TileId!.Value)
            .ToDictionary(g => g.Key, g => g.First());

        _improvementTemplates = (await _baronyRepo.GetBuildingTemplates())
            .Where(t => t.Kind == BuildingKind.Improvement)
            .ToList();

        _tradeGoodAvailability = await _baronyRepo.GetTradeGoodAvailability(Barony.Id);

        await EnsurePlayerDomainAsync();
        await EnsurePlayerFiefAsync();
    }

    private async Task ResizeMapAsync((int DeltaLeft, int DeltaRight, int DeltaTop, int DeltaBottom) deltas)
    {
        if (Barony is null || !CanManageAsMg)
            return;

        var (dL, dR, dT, dB) = deltas;
        if (dL == 0 && dR == 0 && dT == 0 && dB == 0)
            return;

        var shrinking = dL < 0 || dR < 0 || dT < 0 || dB < 0;
        if (shrinking)
        {
            var confirm = await _dialogService.ShowMessageBoxAsync(
                "Shrink map?",
                "Tiles removed from the edge (and any improvements on them) will be deleted permanently. Continue?",
                yesText: "Shrink",
                cancelText: "Cancel");
            if (confirm != true)
                return;
        }

        try
        {
            var (width, height) = await _baronyRepo.ResizeTerrainMap(Barony.Id, dL, dR, dT, dB);
            Barony.TerrainMapWidth = width;
            Barony.TerrainMapHeight = height;
            await LoadMapDataAsync();
            _snackBar.Add(L["Map resized to {0}×{1}.", width, height], Severity.Success);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _snackBar.Add(ex.Message, Severity.Error);
        }
    }

    private bool CanProposeBuildAt(int x, int y)
    {
        if (!CanProposeConstruction)
            return false;

        if (!_tileIndex.TryGetValue((x, y), out var tile) || tile.Id <= 0)
            return false;

        if (_playerPrimaryDomainId is not int primaryId || tile.MapDomainId != primaryId)
            return false;

        if (_improvementByTileId.ContainsKey(tile.Id))
            return false;

        if (_constructionByTileId.ContainsKey(tile.Id))
            return false;

        if (TerrainImprovementCatalogMap.IsWaterTile(tile.BaseType))
            return false;

        var allowedNames = TerrainImprovementCatalogMap.AllowedCatalogTemplateNames(
            tile.Fertility, tile.Resource, tile.FeaturesMask, tile.BaseType, CustomCatalogPins());

        return _improvementTemplates.Any(t =>
            allowedNames.Contains(t.Name)
            && HerdStockRequirements.HasAccess(t.Name, _tradeGoodAvailability));
    }

    private IEnumerable<TerrainImprovementCatalogMap.BuildingTemplatePin> CustomCatalogPins() =>
        _improvementTemplates
            .Where(t => !string.IsNullOrWhiteSpace(t.MapPinKind))
            .Select(t => new TerrainImprovementCatalogMap.BuildingTemplatePin(t.Name, t.MapPinKind, t.TerrainRequirement));

    private async Task OnTileClickAsync((int X, int Y) cell)
    {
        if (!CanProposeConstruction || Barony is null)
            return;

        if (!_tileIndex.TryGetValue((cell.X, cell.Y), out var tile) || tile.Id <= 0)
        {
            _snackBar.Add(L["This tile is not ready yet."], Severity.Warning);
            return;
        }

        if (_playerPrimaryDomainId is not int primaryId || tile.MapDomainId != primaryId)
        {
            _snackBar.Add(L["You can only start construction on tiles in your domain."], Severity.Info);
            return;
        }

        if (_improvementByTileId.ContainsKey(tile.Id))
        {
            _snackBar.Add(L["This tile already has an improvement."], Severity.Info);
            return;
        }

        if (_constructionByTileId.TryGetValue(tile.Id, out var existing))
        {
            _snackBar.Add(L["A construction project is already planned here: {0}.", existing.Name], Severity.Info);
            return;
        }

        if (TerrainImprovementCatalogMap.IsWaterTile(tile.BaseType))
        {
            _snackBar.Add(L["Cannot place improvements on water."], Severity.Warning);
            return;
        }

        var allowedNames = TerrainImprovementCatalogMap.AllowedCatalogTemplateNames(
            tile.Fertility, tile.Resource, tile.FeaturesMask, tile.BaseType, CustomCatalogPins());
        var availability = _tradeGoodAvailability;
        var lockedHerd = new List<string>();
        var placeable = new List<BuildingTemplateDTO>();
        foreach (var t in _improvementTemplates.Where(t => allowedNames.Contains(t.Name)))
        {
            if (HerdStockRequirements.HasAccess(t.Name, availability))
                placeable.Add(t);
            else if (HerdStockRequirements.TryGetRequiredGoodKey(t.Name, out _))
            {
                var good = HerdStockRequirements.RequiredGoodDisplayName(t.Name) ?? "stock";
                lockedHerd.Add($"{t.Name} (needs {good})");
            }
        }

        if (placeable.Count == 0)
        {
            if (lockedHerd.Count > 0)
            {
                _snackBar.Add(
                    L["Herd improvements need breeding stock from trade first: "] + string.Join("; ", lockedHerd),
                    Severity.Info);
            }
            else
            {
                _snackBar.Add(
                    L["Nothing from the improvement catalog can be built on this tile (check terrain, features, and resources)."],
                    Severity.Info);
            }
            return;
        }

        var parameters = new DialogParameters<CreateBuildingProjectDialog>
        {
            { x => x.BaronyId, Barony.Id },
            { x => x.Tile, tile },
            { x => x.Templates, placeable },
            { x => x.LockedHerdNotes, lockedHerd },
        };

        var dialog = await _dialogService.ShowAsync<CreateBuildingProjectDialog>(
            "New building project",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not BaronyProjectDTO project)
            return;

        try
        {
            var saved = await _baronyRepo.SaveProject(project);
            if (saved.TileId is int tid)
                _constructionByTileId[tid] = saved;
            _snackBar.Add(L["Building project added — see the Projects tab."], Severity.Success);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _snackBar.Add(L["Could not create project: "] + ex.Message, Severity.Error);
        }
    }

    private async Task EnsurePlayerDomainAsync()
    {
        if (Barony is null)
            return;

        _mapDomains = await _baronyRepo.GetMapDomains(Barony.Id);
        var playerDomain = _mapDomains.FirstOrDefault(d => d.IsPrimary);
        if (playerDomain is null)
        {
            var lordName = UserInfo?.SelectedCharacter?.NPCName ?? "Unknown Lord";
            playerDomain = await _baronyRepo.SaveMapDomain(new TerrainMapDomainDTO
            {
                BaronyId = Barony.Id,
                Name = Barony.Name,
                LordName = lordName,
                ColorHex = "#9c7a33",
                IsPrimary = true,
                SortOrder = 0,
            });
            _mapDomains = await _baronyRepo.GetMapDomains(Barony.Id);
        }

        _domainsById = _mapDomains.ToDictionary(d => d.Id);
        _playerPrimaryDomainId = playerDomain.Id;
        if (_selectedDomainId is null || !_domainsById.ContainsKey(_selectedDomainId.Value))
            _selectedDomainId = playerDomain.Id;
    }

    private async Task OpenAddDomainDialogAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await _dialogService.ShowAsync<AddTerrainDomainDialog>(string.Empty, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not TerrainMapDomainDTO dto)
            return;

        dto.BaronyId = Barony!.Id;
        var saved = await _baronyRepo.SaveMapDomain(dto);
        await ReloadDomainsAsync();
        await EnsureDefaultFiefForDomainAsync(saved);
        _selectedDomainId = saved.Id;
        StateHasChanged();
    }

    private async Task OpenEditDomainDialogAsync(int domainId)
    {
        var domain = _mapDomains.FirstOrDefault(d => d.Id == domainId);
        if (domain is null)
            return;

        var previousLordName = domain.LordName;
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var parameters = new DialogParameters<AddTerrainDomainDialog>
        {
            { x => x.EditDomain, domain }
        };
        var dialog = await _dialogService.ShowAsync<AddTerrainDomainDialog>(string.Empty, parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not TerrainMapDomainDTO dto)
            return;

        dto.BaronyId = Barony!.Id;
        await _baronyRepo.SaveMapDomain(dto);
        await ReloadDomainsAsync();
        await SyncDefaultFiefForDomainAsync(dto.Id, previousLordName);
        StateHasChanged();
    }

    private async Task DeleteDomainAsync(int domainId)
    {
        var domain = _mapDomains.FirstOrDefault(d => d.Id == domainId);
        if (domain is null || domain.IsPrimary)
            return;

        if (_fiefs.Any(f => f.SeniorDomainId == domainId && !TerrainMapVisuals.IsProtectedDefaultFief(f)))
        {
            _snackBar.Add(L["Cannot delete a domain that is a senior for other fiefs."], Severity.Warning);
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Are you sure you want to delete domain \"{domain.Name}\"?");
        if (!confirmed)
            return;

        var defaultFief = _fiefs.FirstOrDefault(f => f.IsDomainDefault && f.SeniorDomainId == domainId);
        if (defaultFief is not null)
        {
            await ClearFiefFromTilesAsync(defaultFief.Id);
            await _baronyRepo.DeleteFief(defaultFief.Id);
        }

        await ClearDomainFromTilesAsync(domainId);
        await _baronyRepo.DeleteMapDomain(domainId);
        await ReloadDomainsAsync();
        await ReloadFiefsAsync();
        StateHasChanged();
    }

    private async Task ReloadDomainsAsync()
    {
        if (Barony is null)
            return;

        _mapDomains = await _baronyRepo.GetMapDomains(Barony.Id);
        _domainsById = _mapDomains.ToDictionary(d => d.Id);
        var playerDomain = _mapDomains.FirstOrDefault(d => d.IsPrimary);
        if (playerDomain is not null)
            _playerPrimaryDomainId = playerDomain.Id;
        if (_selectedDomainId is not null && !_domainsById.ContainsKey(_selectedDomainId.Value))
            _selectedDomainId = playerDomain?.Id;
    }

    private async Task EnsurePlayerFiefAsync()
    {
        if (Barony is null)
            return;

        _fiefs = (await _baronyRepo.GetFiefs(Barony.Id))
            .OrderBy(f => f.IsBaronDemesne ? 0 : f.IsDomainDefault ? 1 : 2)
            .ThenBy(f => f.Name)
            .ToList();
        var baronFief = _fiefs.FirstOrDefault(f => f.IsBaronDemesne);
        var primaryDomain = _mapDomains.FirstOrDefault(d => d.IsPrimary);

        if (baronFief is null)
        {
            var baronName = UserInfo?.SelectedCharacter?.NPCName ?? "Baron";
            baronFief = await _baronyRepo.SaveFief(new FiefDTO
            {
                BaronyId = Barony.Id,
                Name = TerrainMapVisuals.DefaultLordFiefName(baronName),
                LiegeName = baronName,
                IsBaronDemesne = true,
                SeniorDomainId = primaryDomain?.Id,
                ColorHex = "#4d7ea8",
                BonusMultiplier = 1.0m,
            });
            await ReloadFiefsAsync();
        }
        else
        {
            var expectedName = TerrainMapVisuals.DefaultLordFiefName(baronFief.LiegeName);
            var changed = false;
            if (baronFief.Name != expectedName)
            {
                baronFief.Name = expectedName;
                changed = true;
            }
            if (baronFief.SeniorDomainId is null && primaryDomain is not null)
            {
                baronFief.SeniorDomainId = primaryDomain.Id;
                changed = true;
            }
            if (changed)
            {
                await _baronyRepo.SaveFief(baronFief);
                await ReloadFiefsAsync();
            }
        }

        await EnsureDefaultFiefsForDomainsAsync();

        baronFief = _fiefs.FirstOrDefault(f => f.IsBaronDemesne);
        _fiefIndex = _fiefs.ToDictionary(f => f.Id);
        if (baronFief is not null && (_selectedFiefId is null || !_fiefIndex.ContainsKey(_selectedFiefId.Value)))
            _selectedFiefId = baronFief.Id;
    }

    private async Task EnsureDefaultFiefsForDomainsAsync()
    {
        if (Barony is null)
            return;

        foreach (var domain in _mapDomains.Where(d => !d.IsPrimary))
            await EnsureDefaultFiefForDomainAsync(domain);
    }

    private async Task EnsureDefaultFiefForDomainAsync(TerrainMapDomainDTO domain)
    {
        if (Barony is null || domain.IsPrimary)
            return;

        var existing = _fiefs.FirstOrDefault(f => f.IsDomainDefault && f.SeniorDomainId == domain.Id)
            ?? _fiefs.FirstOrDefault(f =>
                !f.IsBaronDemesne
                && !f.IsDomainDefault
                && f.SeniorDomainId == domain.Id
                && f.LiegeName == domain.LordName);

        if (existing is not null)
        {
            var expectedName = TerrainMapVisuals.DefaultLordFiefName(domain.LordName);
            var changed = false;
            if (!existing.IsDomainDefault)
            {
                existing.IsDomainDefault = true;
                changed = true;
            }
            if (existing.Name != expectedName)
            {
                existing.Name = expectedName;
                changed = true;
            }
            if (existing.LiegeName != domain.LordName)
            {
                existing.LiegeName = domain.LordName;
                changed = true;
            }
            if (existing.ColorHex != domain.ColorHex)
            {
                existing.ColorHex = domain.ColorHex;
                changed = true;
            }
            if (changed)
            {
                await _baronyRepo.SaveFief(existing);
                await ReloadFiefsAsync();
            }
            return;
        }

        await _baronyRepo.SaveFief(new FiefDTO
        {
            BaronyId = Barony.Id,
            Name = TerrainMapVisuals.DefaultLordFiefName(domain.LordName),
            LiegeName = domain.LordName,
            IsDomainDefault = true,
            SeniorDomainId = domain.Id,
            ColorHex = domain.ColorHex,
            BonusMultiplier = 0.85m,
        });
        await ReloadFiefsAsync();
    }

    private async Task SyncDefaultFiefForDomainAsync(int domainId, string previousLordName)
    {
        if (Barony is null)
            return;

        var domain = _mapDomains.FirstOrDefault(d => d.Id == domainId);
        if (domain is null || domain.IsPrimary)
            return;

        var defaultFief = _fiefs.FirstOrDefault(f => f.IsDomainDefault && f.SeniorDomainId == domainId)
            ?? _fiefs.FirstOrDefault(f =>
                !f.IsBaronDemesne
                && f.SeniorDomainId == domainId
                && f.LiegeName == previousLordName);

        if (defaultFief is null)
        {
            await EnsureDefaultFiefForDomainAsync(domain);
            return;
        }

        defaultFief.IsDomainDefault = true;
        defaultFief.LiegeName = domain.LordName;
        defaultFief.Name = TerrainMapVisuals.DefaultLordFiefName(domain.LordName);
        defaultFief.ColorHex = domain.ColorHex;
        await _baronyRepo.SaveFief(defaultFief);
        await ReloadFiefsAsync();
    }

    private async Task OpenAddFiefDialogAsync()
    {
        if (Barony is null)
            return;

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var parameters = new DialogParameters<AddTerrainFiefDialog>
        {
            { x => x.Domains, _mapDomains }
        };
        var dialog = await _dialogService.ShowAsync<AddTerrainFiefDialog>(string.Empty, parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not FiefDTO dto)
            return;

        dto.BaronyId = Barony.Id;
        dto.IsBaronDemesne = false;
        dto.IsDomainDefault = false;
        var saved = await _baronyRepo.SaveFief(dto);
        await ReloadFiefsAsync();
        _selectedFiefId = saved.Id;
        StateHasChanged();
    }

    private async Task OpenEditFiefDialogAsync(int fiefId)
    {
        var fief = _fiefs.FirstOrDefault(f => f.Id == fiefId);
        if (fief is null || Barony is null)
            return;

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var parameters = new DialogParameters<AddTerrainFiefDialog>
        {
            { x => x.Domains, _mapDomains },
            { x => x.EditFief, fief }
        };
        var dialog = await _dialogService.ShowAsync<AddTerrainFiefDialog>(string.Empty, parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not FiefDTO dto)
            return;

        dto.BaronyId = Barony.Id;
        dto.IsBaronDemesne = fief.IsBaronDemesne;
        dto.IsDomainDefault = fief.IsDomainDefault;
        await _baronyRepo.SaveFief(dto);
        await ReloadFiefsAsync();
        StateHasChanged();
    }

    private async Task DeleteFiefAsync(int fiefId)
    {
        var fief = _fiefs.FirstOrDefault(f => f.Id == fiefId);
        if (fief is null || TerrainMapVisuals.IsProtectedDefaultFief(fief))
            return;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Are you sure you want to delete fief \"{fief.Name}\"?");
        if (!confirmed)
            return;

        await ClearFiefFromTilesAsync(fiefId);
        await _baronyRepo.DeleteFief(fiefId);
        await ReloadFiefsAsync();
        StateHasChanged();
    }

    private async Task ReloadFiefsAsync()
    {
        if (Barony is null)
            return;

        _fiefs = (await _baronyRepo.GetFiefs(Barony.Id))
            .OrderBy(f => f.IsBaronDemesne ? 0 : f.IsDomainDefault ? 1 : 2)
            .ThenBy(f => f.Name)
            .ToList();
        _fiefIndex = _fiefs.ToDictionary(f => f.Id);
        var baronFief = _fiefs.FirstOrDefault(f => f.IsBaronDemesne);
        if (_selectedFiefId is not null && !_fiefIndex.ContainsKey(_selectedFiefId.Value))
            _selectedFiefId = baronFief?.Id;
    }

