@namespace DagoniteEmpire.Pages.Barony
@inherits LayoutComponentBase
@layout DagoniteEmpire.Shared.MainLayout
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@implements IDisposable

<div class="barony-mobile-block @(IsMobileAllowedPage ? "barony-mobile-block--hidden" : "")">
    <div class="barony-mobile-block__card">
        <span class="barony-mobile-block__title">@L["Not available on mobile yet"]</span>
        <span class="barony-mobile-block__hint">@L["The Barony view needs a larger screen. Please open it on a desktop."]</span>
    </div>
</div>

<div class="barony-scope @(IsDomainPanel ? "barony-scope--domain-panel" : "") @(IsBuildingsCatalog ? "barony-scope--buildings-catalog" : "") @(IsMarchMap ? "barony-scope--march-map" : "") @(IsBattleMap ? "barony-scope--battle-map" : "") @(IsAudienceHall ? "barony-scope--audience-hall" : "") @(IsProjects ? "barony-scope--projects" : "") @(IsCharacterCard ? "barony-scope--character-card" : "") @(IsNotes ? "barony-scope--notes" : "") @(IsLetters ? "barony-scope--letters" : "") @(IsMobileAllowedPage ? "barony-scope--mobile-ok" : "")">
    <DemoModeBanner />
    <CascadingValue Value="@_viewOptions">
        @* Fill wrapper only for full-viewport map pages — plain pages stay unwrapped. *@
        @if (IsMarchMap || IsBattleMap)
        {
            <div class="barony-scope-body--fill">
                <BaronyResourceHud />
                @Body
                <AuthorizeView Roles="@(SD.Role_DukePlayer + "," + SD.Role_Admin + "," + SD.Role_GameMaster)">
                    <Authorized>
                        <BaronQaInboxFab />
                        <BaronLetterInboxFab />
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Roles="@SD.Role_DukePlayer">
                    <Authorized>
                        <BaronReminderFab />
                    </Authorized>
                </AuthorizeView>
            </div>
        }
        else
        {
            <BaronyResourceHud />
            @Body
            <AuthorizeView Roles="@(SD.Role_DukePlayer + "," + SD.Role_Admin + "," + SD.Role_GameMaster)">
                <Authorized>
                    <BaronQaInboxFab />
                    <BaronLetterInboxFab />
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="@SD.Role_DukePlayer">
                <Authorized>
                    <BaronReminderFab />
                </Authorized>
            </AuthorizeView>
        }
    </CascadingValue>

    <AuthorizeView Roles="@BaronRoles">
        <Authorized>
            <BaronyCardTabs />
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private const string BaronRoles = SD.Role_Admin + "," + SD.Role_GameMaster + "," + SD.Role_DukePlayer;

    private readonly BaronyViewOptions _viewOptions = new();

    private string CurrentPath
    {
        get
        {
            var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            var pathOnly = relative.Split('?', '#')[0].TrimEnd('/');
            return pathOnly.Length == 0 ? "/" : "/" + pathOnly;
        }
    }

    private bool IsDomainPanel => CurrentPath == "/barony";

    private bool IsBuildingsCatalog => CurrentPath == "/barony/buildings";

    private bool IsMarchMap => CurrentPath == "/barony/march-map";

    private bool IsBattleMap => CurrentPath == "/barony/battle-map";

    private bool IsAudienceHall => CurrentPath == "/barony/audience-hall";

    private bool IsProjects => CurrentPath == "/barony/projects";

    private bool IsCharacterCard => CurrentPath == "/barony/character-card";

    private bool IsNotes => CurrentPath == "/barony/notes";

    private bool IsLetters => CurrentPath == "/barony/letters";

    /// <summary>Pages with a working mobile layout — others stay behind the desktop-only gate.</summary>
    private bool IsMobileAllowedPage => BaronyMobile.IsAllowedPath(CurrentPath);

    /// <summary>Any Barony route (Domain Panel or a tab). Non-barony app pages must never be intercepted.</summary>
    private bool IsBaronyPath =>
        CurrentPath == "/barony"
        || CurrentPath.StartsWith("/barony/", StringComparison.OrdinalIgnoreCase);

    private bool _narrowRedirectSettled;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await TrySendMobileToAllowedPageAsync();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _narrowRedirectSettled = false;
        _ = InvokeAsync(TrySendMobileToAllowedPageAsync);
    }

    /// <summary>
    /// On phone/tablet, non-mobile Barony tabs are CSS-hidden. If the user opens one (or lands on
    /// <c>/barony</c>), send them to the mobile fallback (Audience Hall). Do not touch Character /
    /// Campaign / Wiki / etc. — <see cref="LocationChanged"/> also fires while leaving Barony,
    /// and must not yank them back.
    /// </summary>
    private async Task TrySendMobileToAllowedPageAsync()
    {
        if (!IsBaronyPath || IsMobileAllowedPage || _narrowRedirectSettled)
            return;

        try
        {
            var width = await JS.InvokeAsync<double>("GetWindowWidth");
            _narrowRedirectSettled = true;
            if (width < BaronyMobile.MaxWidthPx)
                NavigationManager.NavigateTo(BaronyMobile.FallbackHref, replace: true);
        }
        catch
        {
            // JS not ready yet — retry on the next render.
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
