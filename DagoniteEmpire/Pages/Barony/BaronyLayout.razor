@namespace DagoniteEmpire.Pages.Barony
@inherits LayoutComponentBase
@layout DagoniteEmpire.Shared.MainLayout
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@implements IDisposable

<div class="barony-mobile-block @(IsAudienceHall ? "barony-mobile-block--hidden" : "")">
    <div class="barony-mobile-block__card">
        <span class="barony-mobile-block__title">@L["Not available on mobile yet"]</span>
        <span class="barony-mobile-block__hint">@L["The Barony view needs a larger screen. Please open it on a desktop."]</span>
    </div>
</div>

<div class="barony-scope @(IsDomainPanel ? "barony-scope--domain-panel" : "") @(IsBuildingsCatalog ? "barony-scope--buildings-catalog" : "") @(IsMarchMap ? "barony-scope--march-map" : "") @(IsBattleMap ? "barony-scope--battle-map" : "") @(IsAudienceHall ? "barony-scope--audience-hall" : "")">
    <DemoModeBanner />
    <CascadingValue Value="@_viewOptions">
        @* Fill wrapper only for full-viewport map pages — plain pages stay unwrapped. *@
        @if (IsMarchMap || IsBattleMap)
        {
            <div class="barony-scope-body--fill">
                <BaronyResourceHud />
                @Body
                <AuthorizeView Roles="@(SD.Role_DukePlayer + "," + SD.Role_Admin + "," + SD.Role_GameMaster)">
                    <Authorized>
                        <BaronQaInboxFab />
                        <BaronLetterInboxFab />
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Roles="@SD.Role_DukePlayer">
                    <Authorized>
                        <BaronReminderFab />
                    </Authorized>
                </AuthorizeView>
            </div>
        }
        else
        {
            <BaronyResourceHud />
            @Body
            <AuthorizeView Roles="@(SD.Role_DukePlayer + "," + SD.Role_Admin + "," + SD.Role_GameMaster)">
                <Authorized>
                    <BaronQaInboxFab />
                    <BaronLetterInboxFab />
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="@SD.Role_DukePlayer">
                <Authorized>
                    <BaronReminderFab />
                </Authorized>
            </AuthorizeView>
        }
    </CascadingValue>

    <AuthorizeView Roles="@BaronRoles">
        <Authorized>
            <BaronyCardTabs />
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private const string BaronRoles = SD.Role_Admin + "," + SD.Role_GameMaster + "," + SD.Role_DukePlayer;

    private readonly BaronyViewOptions _viewOptions = new();

    private string CurrentPath
    {
        get
        {
            var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            var pathOnly = relative.Split('?', '#')[0].TrimEnd('/');
            return pathOnly.Length == 0 ? "/" : "/" + pathOnly;
        }
    }

    private bool IsDomainPanel => CurrentPath == "/barony";

    private bool IsBuildingsCatalog => CurrentPath == "/barony/buildings";

    private bool IsMarchMap => CurrentPath == "/barony/march-map";

    private bool IsBattleMap => CurrentPath == "/barony/battle-map";

    /// <summary>Only page allowed on mobile — hub is a single-column visual view, works on any screen size.</summary>
    private bool IsAudienceHall => CurrentPath == "/barony/audience-hall";

    /// <summary>Matches <c>.barony-mobile-block</c> in barony.css (<c>max-width: 1279.98px</c>).</summary>
    private const double MobileBaronyMaxWidth = 1280;
    private bool _narrowRedirectSettled;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await TrySendMobileToAudienceHallAsync();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _narrowRedirectSettled = false;
        _ = InvokeAsync(TrySendMobileToAudienceHallAsync);
    }

    /// <summary>
    /// Phone/tablet entry usually hits <c>/barony</c> (Domain Panel). That page is CSS-hidden
    /// on narrow screens, so send the user to Audience Hall instead of the "not available" card.
    /// </summary>
    private async Task TrySendMobileToAudienceHallAsync()
    {
        if (IsAudienceHall || _narrowRedirectSettled)
            return;

        try
        {
            var width = await JS.InvokeAsync<double>("GetWindowWidth");
            _narrowRedirectSettled = true;
            if (width < MobileBaronyMaxWidth)
                NavigationManager.NavigateTo("/barony/audience-hall", replace: true);
        }
        catch
        {
            // JS not ready yet — retry on the next render.
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
