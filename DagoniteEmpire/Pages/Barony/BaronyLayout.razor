@namespace DagoniteEmpire.Pages.Barony
@inherits LayoutComponentBase
@layout DagoniteEmpire.Shared.MainLayout
@inject NavigationManager NavigationManager

<div class="barony-scope @(IsDomainPanel ? "barony-scope--domain-panel" : "") @(IsBuildingsCatalog ? "barony-scope--buildings-catalog" : "")">
    <AuthorizeView Roles="@BaronRoles">
        <Authorized Context="baronyAuth">
            @if (baronyAuth.User.IsInRole(SD.Role_Admin) || baronyAuth.User.IsInRole(SD.Role_GameMaster))
            {
                <BaronySwitcher />
            }
        </Authorized>
    </AuthorizeView>

    <CascadingValue Value="@_viewOptions">
        <BaronyResourceHud />
        @Body
        <AuthorizeView Roles="@(SD.Role_DukePlayer + "," + SD.Role_Admin + "," + SD.Role_GameMaster)">
            <Authorized>
                <BaronLetterInboxFab />
            </Authorized>
        </AuthorizeView>
    </CascadingValue>

    <AuthorizeView Roles="@BaronRoles">
        <Authorized>
            <BaronyCardTabs />
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private const string BaronRoles = SD.Role_Admin + "," + SD.Role_GameMaster + "," + SD.Role_DukePlayer;

    private readonly BaronyViewOptions _viewOptions = new();
    private bool IsDomainPanel => "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri).TrimEnd('/') == "/barony";

    private bool IsBuildingsCatalog
    {
        get
        {
            var path = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri).TrimEnd('/');
            return path == "/barony/buildings";
        }
    }
}
