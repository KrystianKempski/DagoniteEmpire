@namespace DagoniteEmpire.Pages.Barony
@inherits LayoutComponentBase
@layout DagoniteEmpire.Shared.MainLayout
@inject NavigationManager NavigationManager

<div class="barony-scope @(IsDomainPanel ? "barony-scope--domain-panel" : "")">
    <CascadingValue Value="@_viewOptions">
        @Body
    </CascadingValue>

    <AuthorizeView Roles="@BaronRoles">
        <Authorized>
            <BaronyCardTabs />
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private const string BaronRoles = SD.Role_Admin + "," + SD.Role_GameMaster + "," + SD.Role_DukePlayer;

    private readonly BaronyViewOptions _viewOptions = new();
    private bool IsDomainPanel => "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri).TrimEnd('/') == "/barony";
}
