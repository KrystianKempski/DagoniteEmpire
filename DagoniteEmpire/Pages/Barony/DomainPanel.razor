@page "/barony"
@layout BaronyLayout
@inherits BaronyPageBase
@attribute [Authorize(Roles = SD.Role_Admin + "," + SD.Role_GameMaster + "," + SD.Role_DukePlayer)]
@inject ICharacterRepository _characterRepo

<PageTitle>Dagonite Empire | Domain Panel</PageTitle>

@if (IsLoading)
{
    <MudProgressCircular Indeterminate="true" Size="Size.Small" /> <span>Loading barony...</span>
}
else if (LoadError is not null)
{
    <MudAlert Severity="Severity.Info" Class="my-2">@LoadError</MudAlert>
}
else if (_overview is not null)
{
    <div class="barony-meta-bar" aria-label="Barony status">
        <BaronyHudTip Title="Barony" Text="@BaronyUiTooltips.MetaBaronyName">
            <div class="barony-meta-bar__name">@_overview.Barony.Name</div>
        </BaronyHudTip>
        <div class="barony-meta-bar__stats">
            <BaronyHudTip Title="Year" Text="@BaronyUiTooltips.MetaYear">
                <span class="barony-meta-bar__stat">
                    <span class="barony-meta-bar__label">Year</span>
                    <span class="barony-meta-bar__value">@_overview.Barony.Year</span>
                </span>
            </BaronyHudTip>
            <BaronyHudTip Title="Month" Text="@BaronyUiTooltips.MetaMonth">
                <span class="barony-meta-bar__stat">
                    <span class="barony-meta-bar__label">Month</span>
                    <span class="barony-meta-bar__value">@MonthEn(_overview.Barony.Month)</span>
                </span>
            </BaronyHudTip>
            <BaronyHudTip Title="Season" Text="@BaronyUiTooltips.MetaSeason">
                <span class="barony-meta-bar__stat">
                    <span class="barony-meta-bar__label">Season</span>
                    <span class="barony-meta-bar__value">@SeasonEn(_overview.Barony.Season)</span>
                </span>
            </BaronyHudTip>
            <BaronyHudTip Title="Turn" Text="@BaronyUiTooltips.MetaTurn">
                <span class="barony-meta-bar__stat barony-meta-bar__stat--centered">
                    <span class="barony-meta-bar__label">Turn</span>
                    <span class="barony-meta-bar__value">@_overview.Barony.TurnNumber</span>
                </span>
            </BaronyHudTip>
            <BaronyHudTip Title="Size" Text="@BaronyUiTooltips.MetaSize">
                <span class="barony-meta-bar__stat barony-meta-bar__stat--centered">
                    <span class="barony-meta-bar__label">Size</span>
                    <span class="barony-meta-bar__value">@_overview.Barony.Size</span>
                </span>
            </BaronyHudTip>
            <BaronyHudTip Title="Loyalty" Text="@BaronyUiTooltips.MetaPpbTurnTotal(Ppb.Loyalty, _grandTotal[Ppb.Loyalty])">
                <span class="barony-meta-bar__stat barony-meta-bar__stat--centered">
                    <span class="barony-meta-bar__label">Loyalty</span>
                    <span class="barony-meta-bar__value @SignedClass(_grandTotal[Ppb.Loyalty])">@FmtAdd(_grandTotal[Ppb.Loyalty])</span>
                </span>
            </BaronyHudTip>
            <BaronyHudTip Title="Stability" Text="@BaronyUiTooltips.MetaPpbTurnTotal(Ppb.Stability, _grandTotal[Ppb.Stability])">
                <span class="barony-meta-bar__stat barony-meta-bar__stat--centered">
                    <span class="barony-meta-bar__label">Stability</span>
                    <span class="barony-meta-bar__value @SignedClass(_grandTotal[Ppb.Stability])">@FmtAdd(_grandTotal[Ppb.Stability])</span>
                </span>
            </BaronyHudTip>
            <BaronyHudTip Title="Economy" Text="@BaronyUiTooltips.MetaPpbTurnTotal(Ppb.Economy, _grandTotal[Ppb.Economy])">
                <span class="barony-meta-bar__stat barony-meta-bar__stat--centered">
                    <span class="barony-meta-bar__label">Economy</span>
                    <span class="barony-meta-bar__value @SignedClass(_grandTotal[Ppb.Economy])">@FmtAdd(_grandTotal[Ppb.Economy])</span>
                </span>
            </BaronyHudTip>
            <BaronyHudTip Title="Unrest" Text="@BaronyUiTooltips.MetaUnrest">
                <span class="barony-meta-bar__stat barony-meta-bar__stat--centered">
                    <span class="barony-meta-bar__label">Unrest</span>
                    <span class="barony-meta-bar__value @(_overview.Barony.Unrest > 0 ? "barony-meta-bar__value--neg" : "")">@_overview.Barony.Unrest</span>
                </span>
            </BaronyHudTip>
        </div>
    </div>

    <BaronyPageHeader Title="Domain Panel" />

    @* --- Modifier sections (PPB tables) --- *@
    <AdvisorSection Advisors="@_advisorsForSection" />
    <CityBuildingsSection BaronyId="@BaronyId"
                          SavedBuildings="@_savedBuildings"
                          Improvements="@_overview.Improvements"
                          Seat="@_overview.Seat"
                          PurposeTemplates="@_overview.SeatPurposeTemplates"
                          Catalog="@_buildingCatalog"
                          CanManage="@CanManageAsMg"
                          OnChanged="ReloadOverviewAsync" />
    <SocialGroupRelationsSection BaronyId="@BaronyId"
                                 Relations="@_overview.SocialRelations"
                                 CanManage="@CanManageAsMg"
                                 OnChanged="ReloadOverviewAsync" />
    <TerrainImprovementsSection Improvements="@_overview.Improvements"
                                Tiles="@_overview.Tiles"
                                Fiefs="@_overview.Fiefs"
                                CanManage="@CanManageAsMg"
                                OnChanged="ReloadOverviewAsync" />
    <DecreesSection BaronyId="@BaronyId"
                    Decrees="@_overview.Decrees"
                    CanManage="@CanManageAsMg"
                    CanToggleActive="@CanEdit"
                    OnChanged="ReloadOverviewAsync" />
    <EventsSection BaronyId="@BaronyId"
                   CurrentTurn="@_overview.Barony.TurnNumber"
                   Events="@_overview.Events"
                   CanManage="@CanManageAsMg"
                   OnChanged="ReloadOverviewAsync" />
    <CommunityPenaltiesSection Rows="@_communityRows" />

    <BaronySection Title="Barony Summary">
        <Summary>
            <PpbSummaryChips Vector="@_grandTotal" />
        </Summary>
        <ChildContent>
            <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mb-2">
                final = Σ additive + scalable_additive × (Σ percent / 100). Percent scales positive additives (negative for Corruption).
            </MudText>
            <div style="overflow-x:auto;">
                <table class="ppb-table ppb-table--summary ppb-table--lined">
                    <colgroup>
                        <col class="summary-col-component" />
                        @foreach (var _ in PpbCatalog.All)
                        {
                            <col class="summary-col-ppb" />
                        }
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="ppb-row-label summary-col-component">Component</th>
                            @foreach (var info in PpbCatalog.All)
                            {
                                <th title="@info.NameEn">@PpbShort(info.Key)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _totalBreakdown)
                        {
                            <tr>
                                <td class="ppb-row-label summary-col-component">@row.Label</td>
                                @foreach (var info in PpbCatalog.All)
                                {
                                    <td class="@SummaryCellClass(row, info.Key)">@SummaryCellText(row, info.Key)</td>
                                }
                            </tr>
                        }
                        <tr class="ppb-summary-row">
                            <td class="ppb-row-label summary-col-component">Final Value</td>
                            @foreach (var info in PpbCatalog.All)
                            {
                                <td class="@PpbCellStyle.ValueClass(info.Key, _grandTotal[info.Key])"><b>@FmtAdd(_grandTotal[info.Key])</b></td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
        </ChildContent>
    </BaronySection>
}

@code {
    private BaronyOverviewDTO? _overview;
    private List<AdvisorDTO> _advisorsForSection = new();

    private List<PpbModifierRow> _advisorRows = new();
    private List<PpbModifierRow> _buildingRows = new();
    private List<BaronyBuildingDTO> _savedBuildings = new();
    private List<BuildingTemplateDTO> _buildingCatalog = new();
    private List<PpbModifierRow> _socialRows = new();
    private List<PpbModifierRow> _improvementRows = new();
    private List<PpbModifierRow> _decreeRows = new();
    private List<PpbModifierRow> _eventRows = new();
    private List<PpbModifierRow> _communityRows = new();

    private List<PpbModifierRow> _totalBreakdown = new();
    private PpbVector _grandTotal = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadBaronyAsync();
        if (Barony is null)
            return;

        _overview = await _baronyRepo.GetOverview(Barony.Id);
        if (_overview is null)
            return;

        var character = await _characterRepo.GetById(Barony.CharacterId, fullIncludes: true);
        var baronModifiers = await _baronyRepo.GetBaronInfluenceModifiers(Barony.Id);
        var advisorModifiers = await _baronyRepo.GetAdvisorInfluenceModifiers(Barony.Id);
        var panel = BaronyCalc.BuildDomainPanelRows(
            _overview, character, baronModifiers, advisorModifiers);

        _advisorsForSection = panel.Advisors;
        _advisorRows = panel.AdvisorRows;
        _savedBuildings = _overview.Buildings;
        _buildingCatalog = (await _baronyRepo.GetBuildingTemplates())
            .Where(t => t.Kind == BuildingKind.Building)
            .OrderBy(t => t.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
        _buildingRows = panel.BuildingRows;
        _socialRows = panel.SocialRows;
        _improvementRows = panel.ImprovementRows;
        _decreeRows = panel.DecreeRows;
        _eventRows = panel.EventRows;
        _communityRows = panel.CommunityRows;
        ApplyPanelTotals(panel);
        NotifyResourceHud();
    }

    private async Task ReloadOverviewAsync()
    {
        if (Barony is null)
            return;

        _overview = await _baronyRepo.GetOverview(Barony.Id);
        if (_overview is null)
            return;

        var character = await _characterRepo.GetById(Barony.CharacterId, fullIncludes: true);
        var baronModifiers = await _baronyRepo.GetBaronInfluenceModifiers(Barony.Id);
        var advisorModifiers = await _baronyRepo.GetAdvisorInfluenceModifiers(Barony.Id);
        var panel = BaronyCalc.BuildDomainPanelRows(
            _overview, character, baronModifiers, advisorModifiers);

        _advisorsForSection = panel.Advisors;
        _advisorRows = panel.AdvisorRows;
        _savedBuildings = _overview.Buildings;
        _buildingRows = panel.BuildingRows;
        _socialRows = panel.SocialRows;
        _improvementRows = panel.ImprovementRows;
        _decreeRows = panel.DecreeRows;
        _eventRows = panel.EventRows;
        _communityRows = panel.CommunityRows;
        ApplyPanelTotals(panel);
        NotifyResourceHud();
        StateHasChanged();
    }

    private void ApplyPanelTotals(BaronyCalc.DomainPanelRowSet panel)
    {
        var additive = BaronyCalc.SumAdditive(panel.AllRows);
        var percent = BaronyCalc.SumPercent(panel.AllRows);

        _totalBreakdown = new List<PpbModifierRow>
        {
            new() { Label = "Σ additive (all sections)", Additive = additive },
            new() { Label = "Σ percent (all sections)", Percent = percent },
        };

        _grandTotal = panel.GrandTotal;
    }

    private static string FmtAdd(decimal v) => PpbFormat.Additive(v);
    private static string SignedClass(decimal v)
        => v > 0m ? "barony-meta-bar__value--pos"
            : v < 0m ? "barony-meta-bar__value--neg"
            : "";
    private static string FmtPct(decimal v) => PpbFormat.Percent(v);

    private static string SummaryCellText(PpbModifierRow row, Ppb p)
    {
        var add = row.Additive[p];
        var pct = row.Percent[p];
        if (add != 0m)
            return FmtAdd(add);
        if (pct != 0m)
            return FmtPct(pct);
        return "·";
    }

    private static string SummaryCellClass(PpbModifierRow row, Ppb p)
    {
        var add = row.Additive[p];
        var pct = row.Percent[p];
        return PpbCellStyle.ValueClass(p, add != 0m ? add : pct);
    }

    private static string PpbShort(Ppb p) => p switch
    {
        Ppb.Food => "Food",
        Ppb.Economy => "Econ",
        Ppb.Production => "Prod",
        Ppb.Loyalty => "Loy",
        Ppb.Stability => "Stab",
        Ppb.Law => "Law",
        Ppb.Corruption => "Corr",
        Ppb.Science => "Sci",
        Ppb.Magic => "Mag",
        Ppb.Culture => "Cult",
        Ppb.Intelligence => "Intel",
        Ppb.Defense => "Def",
        Ppb.Treasury => "Gold",
        _ => p.ToString(),
    };

    private static string SeasonEn(string season) => season switch
    {
        "Winter" => "Winter",
        "Spring" => "Spring",
        "Summer" => "Summer",
        "Fall" => "Autumn",
        _ => season,
    };

    private static readonly string[] MonthNames =
    {
        "January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December"
    };

    private static string MonthEn(int month)
        => month >= 1 && month <= MonthNames.Length ? MonthNames[month - 1] : month.ToString();
}
