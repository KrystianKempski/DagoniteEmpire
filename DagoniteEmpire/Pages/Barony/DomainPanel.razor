@page "/barony"
@layout BaronyLayout
@inherits BaronyPageBase
@attribute [Authorize(Roles = SD.Role_Admin + "," + SD.Role_GameMaster + "," + SD.Role_DukePlayer)]
@inject ICharacterRepository _characterRepo

<PageTitle>Dagonite Empire | Domain Panel</PageTitle>

@if (IsLoading)
{
    <MudProgressCircular Indeterminate="true" Size="Size.Small" /> <span>Loading barony...</span>
}
else if (LoadError is not null)
{
    <MudAlert Severity="Severity.Info" Class="my-2">@LoadError</MudAlert>
}
else if (_overview is not null)
{
    <div class="barony-resource-bar">
        <div class="barony-resource-bar__name">
            @_overview.Barony.Name
        </div>
        <div class="barony-resource-bar__items">
            <span>Year <b>@_overview.Barony.Year</b></span>
            <span>Month <b>@MonthEn(_overview.Barony.Month)</b></span>
            <span>Season <b>@SeasonEn(_overview.Barony.Season)</b></span>
            <span>Turn <b>@_overview.Barony.TurnNumber</b></span>
            <span>Size <b>@_overview.Barony.Size</b></span>
            <span>Treasury <b>@Num(_overview.Barony.TreasuryGold)</b></span>
            <span>Food <b>@Num(_overview.Barony.FoodInGranaries)</b></span>
            <span>Production <b>@Num(_grandTotal[Ppb.Production])</b></span>
            <span>Loyalty <b>@Num(_grandTotal[Ppb.Loyalty])</b></span>
            <span>Stability <b>@Num(_grandTotal[Ppb.Stability])</b></span>
            <span>Economy <b>@Num(_grandTotal[Ppb.Economy])</b></span>
            <span>Unrest <b>@_overview.Barony.Unrest</b></span>
        </div>
    </div>

    <BaronyPageHeader Title="Domain Panel" />

    @* --- Modifier sections (PPB tables) --- *@
    <AdvisorSection Advisors="@_advisorsForSection" />
    <CityBuildingsSection BaronyId="@BaronyId"
                          SavedBuildings="@_savedBuildings"
                          Catalog="@_buildingCatalog"
                          CanManage="@CanManageAsMg"
                          OnChanged="ReloadOverviewAsync" />
    <SocialGroupRelationsSection BaronyId="@BaronyId"
                                 Relations="@_overview.SocialRelations"
                                 CanManage="@CanManageAsMg"
                                 OnChanged="ReloadOverviewAsync" />
    <SectionTable Title="Terrain Improvements" Rows="@_improvementRows" />
    <SectionTable Title="Decrees and Technologies" Rows="@_decreeRows" />
    <SectionTable Title="Events" Rows="@_eventRows" />
    <SectionTable Title="Community Penalties and Bonuses" Rows="@_communityRows" />

    @* --- Summary section --- *@
    <div class="barony-card mt-3">
        <div class="barony-card__title">Barony PPB Summary</div>
        <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mb-2">
            Draft formula: (base + Σ additive) × (1 + Σ percent). Detailed formulas will be provided later.
        </MudText>
        <div style="overflow-x:auto;">
            <PpbTable Rows="@_totalBreakdown" Summary="@_grandTotal" SummaryLabel="Final Value" RowHeader="Component" TableClass="ppb-table--lined" />
        </div>
    </div>
}

@code {
    private BaronyOverviewDTO? _overview;
    private List<AdvisorDTO> _advisorsForSection = new();

    private List<PpbModifierRow> _advisorRows = new();
    private List<PpbModifierRow> _buildingRows = new();
    private List<BaronyBuildingDTO> _savedBuildings = new();
    private List<BuildingTemplateDTO> _buildingCatalog = new();
    private List<PpbModifierRow> _socialRows = new();
    private List<PpbModifierRow> _improvementRows = new();
    private List<PpbModifierRow> _decreeRows = new();
    private List<PpbModifierRow> _eventRows = new();
    private List<PpbModifierRow> _communityRows = new();

    private List<PpbModifierRow> _totalBreakdown = new();
    private PpbVector _grandTotal = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadBaronyAsync();
        if (Barony is null)
            return;

        _overview = await _baronyRepo.GetOverview(Barony.Id);
        if (_overview is null)
            return;

        var character = await _characterRepo.GetById(Barony.CharacterId, fullIncludes: true);
        var baronModifiers = await _baronyRepo.GetBaronInfluenceModifiers(Barony.Id);
        _advisorsForSection = BaronyCalc.AdvisorsForDomainPanel(
            _overview.Advisors, _overview.Barony, character, baronModifiers);

        _advisorRows = BaronyCalc.AdvisorRows(_advisorsForSection);
        _savedBuildings = _overview.Buildings;
        _buildingCatalog = (await _baronyRepo.GetBuildingTemplates())
            .Where(t => t.Kind == BuildingKind.Building)
            .OrderBy(t => t.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
        _buildingRows = BaronyCalc.CityBuildingSectionRows(Barony!.Id, _savedBuildings);
        _socialRows = BaronyCalc.SocialRows(Barony!.Id, _overview.SocialRelations);
        _improvementRows = BaronyCalc.ImprovementRows(_overview.Improvements);
        _decreeRows = BaronyCalc.DecreeRows(_overview.Decrees);
        _eventRows = BaronyCalc.EventRows(_overview.Events);
        _communityRows = BaronyCalc.CommunityRows(_overview.CommunityModifiers);

        BuildTotals();
    }

    private async Task ReloadOverviewAsync()
    {
        if (Barony is null)
            return;

        _overview = await _baronyRepo.GetOverview(Barony.Id);
        if (_overview is null)
            return;

        _savedBuildings = _overview.Buildings;
        _buildingRows = BaronyCalc.CityBuildingSectionRows(Barony.Id, _savedBuildings);
        _socialRows = BaronyCalc.SocialRows(Barony!.Id, _overview.SocialRelations);
        BuildTotals();
        StateHasChanged();
    }

    private void BuildTotals()
    {
        if (_overview is null)
            return;

        var allRows = new List<PpbModifierRow>();
        allRows.AddRange(_advisorRows);
        allRows.AddRange(_buildingRows);
        allRows.AddRange(_socialRows);
        allRows.AddRange(_improvementRows);
        allRows.AddRange(_decreeRows);
        allRows.AddRange(_eventRows);
        allRows.AddRange(_communityRows);

        var additive = BaronyCalc.SumAdditive(allRows);
        var percent = BaronyCalc.SumPercent(allRows);

        _totalBreakdown = new List<PpbModifierRow>
        {
            new() { Label = "PPB Base", Additive = _overview.Barony.BaseParameters },
            new() { Label = "Σ additive (all sections)", Additive = additive },
            new() { Label = "Σ percent (all sections)", Percent = percent },
        };

        _grandTotal = PpbMath.Summarize(_overview.Barony.BaseParameters, additive, percent);
    }

    private static string Num(decimal v)
    {
        var r = decimal.Round(v, 2);
        return r == decimal.Truncate(r) ? ((long)r).ToString() : r.ToString("0.##");
    }

    private static string SeasonEn(string season) => season switch
    {
        "Winter" => "Winter",
        "Spring" => "Spring",
        "Summer" => "Summer",
        "Fall" => "Autumn",
        _ => season,
    };

    private static readonly string[] MonthNames =
    {
        "January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December"
    };

    private static string MonthEn(int month)
        => month >= 1 && month <= MonthNames.Length ? MonthNames[month - 1] : month.ToString();
}
