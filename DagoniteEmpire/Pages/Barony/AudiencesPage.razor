@page "/barony/audiences"
@layout BaronyLayout
@inherits BaronyPageBase
@attribute [Authorize(Roles = SD.Role_Admin + "," + SD.Role_GameMaster + "," + SD.Role_DukePlayer)]
@inject IDialogService _dialogService
@inject ICampaignRepository _campaignRepository
@inject IChapterRepository _chapterRepository
@using DA_DataAccess.Chat
@using DA_Models.CharacterModels

<PageTitle>Dagonite Empire | @L["Audiences"]</PageTitle>

@if (IsLoading)
{
    <MudProgressCircular Indeterminate="true" Size="Size.Small" /> <span>@L["Loading audiences..."]</span>
}
else if (LoadError is not null)
{
    <MudAlert Severity="Severity.Info" Class="my-2">@LoadError</MudAlert>
}
else if (Barony is not null)
{
    <BaronyPageHeader Title="@(L["Audiences"])" HelpKey="audiences">
        <Summary>
            <span class="projects-summary">
                <span class="projects-summary__item">@CurrentTurnActive.Count this turn</span>
                <span class="projects-summary__item">@DeferredWaiting.Count deferred</span>
                <span class="projects-summary__item">Archive: @_audiences.Count(IsArchiveEntry)</span>
            </span>
        </Summary>
    </BaronyPageHeader>

    <BaronySection Title="@(L["Audience summary"])">
            <Summary>
                <div class="baron-audience__summary-chips">
                    <PpbSummaryChips Vector="@SummaryAdditive" />
                    @if (SummaryPhp.Prestige != 0 || SummaryPhp.Honor != 0 || SummaryPhp.Fear != 0)
                    {
                        <div class="baron-php-summary">
                            @if (SummaryPhp.Prestige != 0)
                            {
                                <PhpMetricChip Metric="PhpMetric.Prestige" Value="@SummaryPhp.Prestige" />
                            }
                            @if (SummaryPhp.Honor != 0)
                            {
                                <PhpMetricChip Metric="PhpMetric.Honor" Value="@SummaryPhp.Honor" />
                            }
                            @if (SummaryPhp.Fear != 0)
                            {
                                <PhpMetricChip Metric="PhpMetric.Fear" Value="@SummaryPhp.Fear" />
                            }
                        </div>
                    }
                </div>
            </Summary>
            <ChildContent>
                <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mb-2">
                    @L["Additive PPB → Domain Panel Events · cumulative resources → Resource Balance (stocks immediately) · PHP → Baron Card (From Adventures)."]
                </MudText>
                @if (AudienceSummaryRows.Count == 0 && CouncilSummary is null)
                {
                    <MudText Typo="Typo.body2" Style="color:var(--barony-muted);">@L["No audience grants this turn yet."]</MudText>
                }
                else
                {
                    <div style="overflow-x:auto;">
                        <table class="ppb-table ppb-table--advisors ppb-table--events ppb-table--lined baron-audience-summary-table">
                            <colgroup>
                                <col class="city-building-col-name" />
                                @foreach (var _ in PpbCatalog.All)
                                {
                                    <col class="ppb-pair-col" />
                                }
                                <col class="php-col" />
                                <col class="php-col" />
                                <col class="php-col" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th class="ppb-row-label city-building-col-name">@L["Audience"]</th>
                                    @foreach (var info in PpbCatalog.All)
                                    {
                                        <th>
                                            <BaronyTooltip Text="@info.Name">
                                                <span>@PpbShort(info.Key)</span>
                                            </BaronyTooltip>
                                        </th>
                                    }
                                    <th class="php-col php-col--prestige">
                                        <BaronyTooltip Text="@(L["Prestige"])">
                                            <PhpMetricIcon Metric="PhpMetric.Prestige" Title="" />
                                        </BaronyTooltip>
                                    </th>
                                    <th class="php-col php-col--honor">
                                        <BaronyTooltip Text="@(L["Honor"])">
                                            <PhpMetricIcon Metric="PhpMetric.Honor" Title="" />
                                        </BaronyTooltip>
                                    </th>
                                    <th class="php-col php-col--fear">
                                        <BaronyTooltip Text="@(L["Fear"])">
                                            <PhpMetricIcon Metric="PhpMetric.Fear" Title="" />
                                        </BaronyTooltip>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in AudienceSummaryRows)
                                {
                                    <tr>
                                        <td class="ppb-row-label city-building-col-name">
                                            <strong>@a.Title</strong>
                                            <span class="baron-audience__petitioner"> · @AudiencePetitionerLabel(a)</span>
                                        </td>
                                        @foreach (var info in PpbCatalog.All)
                                        {
                                            <td class="@PpbCellStyle.ValueClass(info.Key, a.Additive[info.Key])">@FmtAdd(a.Additive[info.Key])</td>
                                        }
                                        <td class="@PhpScoreClass(PhpMetric.Prestige, a.Prestige)">@FmtPhp(a.Prestige)</td>
                                        <td class="@PhpScoreClass(PhpMetric.Honor, a.Honor)">@FmtPhp(a.Honor)</td>
                                        <td class="@PhpScoreClass(PhpMetric.Fear, a.Fear)">@FmtPhp(a.Fear)</td>
                                    </tr>
                                }
                                @if (CouncilSummary is not null)
                                {
                                    <tr>
                                        <td class="ppb-row-label city-building-col-name">
                                            <strong>@BaronCouncilSession.SummaryRowName</strong>
                                        </td>
                                        @foreach (var info in PpbCatalog.All)
                                        {
                                            <td class="@PpbCellStyle.ValueClass(info.Key, CouncilSummary.Additive[info.Key])">@FmtAdd(CouncilSummary.Additive[info.Key])</td>
                                        }
                                        <td class="@PhpScoreClass(PhpMetric.Prestige, CouncilSummary.Prestige)">@FmtPhp(CouncilSummary.Prestige)</td>
                                        <td class="@PhpScoreClass(PhpMetric.Honor, CouncilSummary.Honor)">@FmtPhp(CouncilSummary.Honor)</td>
                                        <td class="@PhpScoreClass(PhpMetric.Fear, CouncilSummary.Fear)">@FmtPhp(CouncilSummary.Fear)</td>
                                    </tr>
                                }
                                <tr class="ppb-summary-row">
                                    <td class="ppb-row-label city-building-col-name">@L["Σ audiences"]</td>
                                    @foreach (var info in PpbCatalog.All)
                                    {
                                        <td class="@PpbCellStyle.ValueClass(info.Key, SummaryAdditive[info.Key])"><b>@FmtAdd(SummaryAdditive[info.Key])</b></td>
                                    }
                                    <td class="@PhpScoreClass(PhpMetric.Prestige, SummaryPhp.Prestige)"><b>@FmtPhp(SummaryPhp.Prestige)</b></td>
                                    <td class="@PhpScoreClass(PhpMetric.Honor, SummaryPhp.Honor)"><b>@FmtPhp(SummaryPhp.Honor)</b></td>
                                    <td class="@PhpScoreClass(PhpMetric.Fear, SummaryPhp.Fear)"><b>@FmtPhp(SummaryPhp.Fear)</b></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                }
            </ChildContent>
        </BaronySection>

        <BaronySection Title="@(L["Council"])">
            <Summary>
                <span class="projects-summary">
                    <span class="projects-summary__item">@CurrentCouncilTopics.Count open</span>
                    <span class="projects-summary__item">Archive: @CouncilArchive.Count</span>
                </span>
            </Summary>
            <ChildContent>
                <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mb-3">
                    @L["Council topics for this turn. At Resolve Turn, open topics move to archive."]
                    @L["MG Speak as lists all courtiers from Court."]
                </MudText>

                @if (CanWriteAsGm)
                {
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <MudButton Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="CreateCouncilTopicAsync"
                                   Disabled="_busy || _councilAdvisorOptions.Count == 0">
                            @L["New council topic"]
                        </MudButton>
                        @if (_councilAdvisorOptions.Count == 0)
                        {
                            <MudText Typo="Typo.caption" Style="color:var(--barony-muted); align-self:center;">
                                @L["Assign advisors on the Court tab first."]
                            </MudText>
                        }
                    </div>
                }

                @if (CurrentCouncilTopics.Count == 0)
                {
                    <MudText Typo="Typo.body2" Style="color:var(--barony-muted);">
                        @L["No open Council topics this turn."]
                    </MudText>
                }
                else
                {
                    <div class="project-card-grid">
                        @foreach (var topic in CurrentCouncilTopics)
                        {
                            <AudiencePanel Audience="topic"
                                           CanWriteAsGm="CanWriteAsGm"
                                           CanWriteAsBaron="CanWriteAsBaron"
                                           BaronCharacterName="@BaronCharacterName"
                                           Busy="_busy"
                                           CourtSpeakers="_courtSpeakers"
                                           OnSpeak="req => SendReplyAsync(topic, req)"
                                           OnAddResources="() => AddResourcesAsync(topic)"
                                           OnCreateProject="() => CreateProjectAsync(topic)"
                                           OnMakeChapter="() => MakeChapterAsync(topic)"
                                           OnResolve="() => ResolveAsync(topic)"
                                           OnDismiss="() => DismissAsync(topic)" />
                        }
                    </div>
                }


            </ChildContent>
        </BaronySection>

        <BaronySection Title="@(L["Audiences"])">
            <Summary>
                <span class="projects-summary">
                    <span class="projects-summary__item">@CurrentTurnActive.Count open</span>
                    @if (DeferredWaiting.Count > 0)
                    {
                        <span class="projects-summary__item">@DeferredWaiting.Count deferred</span>
                    }
                    <span class="projects-summary__item">T@(Barony.TurnNumber)</span>
                </span>
            </Summary>
            <ChildContent>
                <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mb-3">
                    @L["Click an audience card header to expand or collapse the dialogue."]
                </MudText>

                @if (CanWriteAsGm)
                {
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <MudButton Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="CreateAudienceAsync"
                                   Disabled="_busy">
                            @L["New audience"]
                        </MudButton>
                    </div>
                }

                @if (CurrentTurnActive.Count == 0)
                {
                    <MudText Typo="Typo.body2" Style="color:var(--barony-muted);">
                        No open audiences this turn.
                        @if (CanWriteAsGm)
                        {
                            <text> @L["Add one above."]</text>
                        }
                    </MudText>
                }
                else
                {
                    <div class="project-card-grid">
                        @foreach (var a in CurrentTurnActive)
                        {
                            <AudiencePanel Audience="a"
                                           CanWriteAsGm="CanWriteAsGm"
                                           CanWriteAsBaron="CanWriteAsBaron"
                                           BaronCharacterName="@BaronCharacterName"
                                           Busy="_busy"
                                           OnSpeak="req => SendReplyAsync(a, req)"
                                           OnAddResources="() => AddResourcesAsync(a)"
                                           OnCreateProject="() => CreateProjectAsync(a)"
                                           OnMakeChapter="() => MakeChapterAsync(a)"
                                           OnResolve="() => ResolveAsync(a)"
                                           OnDefer="() => DeferAsync(a)"
                                           OnDismiss="() => DismissAsync(a)" />
                        }
                    </div>
                }

                @if (DeferredWaiting.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">@L["Deferred — continue next turn"]</MudText>
                    <div class="project-card-grid">
                        @foreach (var a in DeferredWaiting)
                        {
                            <AudiencePanel Audience="a"
                                           ReadOnly="true"
                                           CanWriteAsGm="CanWriteAsGm"
                                           CanWriteAsBaron="CanWriteAsBaron"
                                           BaronCharacterName="@BaronCharacterName"
                                           Busy="_busy"
                                           OnMakeChapter="() => MakeChapterAsync(a)" />
                        }
                    </div>
                }
            </ChildContent>
        </BaronySection>

        @if (CanManageAsMg)
        {
            <BaronySection Title="@(L["Hall events"])" DefaultOpen="true">
                <Summary>
                    <span class="projects-summary">
                        <span class="projects-summary__item">@PendingHallEvents.Count @L["pending"]</span>
                        <span class="projects-summary__item">@ScheduledHallEvents.Count @L["scheduled"]</span>
                        <span class="projects-summary__item">@ActiveHallEvents.Count @L["active"]</span>
                        @if (_showArchivedHallEvents)
                        {
                            <span class="projects-summary__item">@ArchivedHallEvents.Count @L["Archived"]</span>
                        }
                    </span>
                </Summary>
                <ChildContent>
                    <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                        <MudButton Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="CreateHallEventAsync"
                                   Disabled="_busy">
                            @L["New hall event"]
                        </MudButton>
                        <MudSwitch @bind-Value="_showArchivedHallEvents"
                                   Label="@(L["Show archived"])"
                                   Color="Color.Primary" />
                    </div>

                    @if (_hallEventTemplates.Count > 0)
                    {
                        <div class="hall-event-templates mb-3">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Hall event templates"]</MudText>
                            <div class="hall-event-templates__list">
                                @foreach (var template in _hallEventTemplates)
                                {
                                    <div class="hall-event-templates__item">
                                        <span class="hall-event-templates__name">@template.Name</span>
                                        <span class="hall-event-templates__title">@template.Title</span>
                                        <span class="hall-event-templates__actions">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Size="Size.Small"
                                                           OnClick="() => EditHallEventTemplateAsync(template)" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Size="Size.Small"
                                                           Color="Color.Error"
                                                           OnClick="() => DeleteHallEventTemplateAsync(template)" />
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <MudButton Variant="Variant.Text"
                               StartIcon="@Icons.Material.Filled.BookmarkAdd"
                               OnClick="CreateHallEventTemplateAsync"
                               Disabled="_busy"
                               Class="mb-3">
                        @L["New hall event template"]
                    </MudButton>

                    @if (HallEventFolders.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Style="color:var(--barony-muted);">@L["No hall events right now."]</MudText>
                    }
                    else
                    {
                        @foreach (var folder in HallEventFolders)
                        {
                            var open = _expandedHallEventTurns.Contains(folder.Turn);
                            <div class="baron-audience__folder @(open ? "baron-audience__folder--open" : "")">
                                <button type="button"
                                        class="baron-audience__folder-summary"
                                        @onclick="@(() => ToggleHallEventFolder(folder.Turn))">
                                    <span>@(open ? "▾" : "▸")</span>
                                    <span>@L["Turn {0}", folder.Turn]</span>
                                    <span class="baron-audience__folder-count">@folder.Items.Count</span>
                                </button>
                                @if (open)
                                {
                                    <div class="hall-event-mgmt-grid">
                                        @foreach (var ev in folder.Items)
                                        {
                                            <div class="hall-event-mgmt-card">
                                                <HallEventPanel Event="ev"
                                                                ReadOnly="true"
                                                                CanManage="true"
                                                                Busy="_busy"
                                                                OnEdit="() => EditHallEventAsync(ev)"
                                                                OnMakeChapter="() => MakeChapterFromHallEventAsync(ev)"
                                                                OnArchive="() => ArchiveHallEventAsync(ev)" />
                                                @if (ev.IsArchived)
                                                {
                                                    <div class="hall-event-mgmt-card__footer">
                                                        <MudButton Variant="Variant.Text"
                                                                   Size="Size.Small"
                                                                   Color="Color.Error"
                                                                   Disabled="_busy"
                                                                   OnClick="() => DeleteHallEventAsync(ev)">
                                                            @L["Delete"]
                                                        </MudButton>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </ChildContent>
            </BaronySection>
        }

        <BaronySection Title="@(L["Archive"])" DefaultOpen="false">
            <Summary>
                <span class="projects-summary">
                    <span class="projects-summary__item">@_audiences.Count(IsArchiveEntry) archived</span>
                </span>
            </Summary>
            <ChildContent>
                @if (ArchiveFolders.Count == 0)
                {
                    <MudText Typo="Typo.body2" Style="color:var(--barony-muted);">@L["No archived audiences yet."]</MudText>
                }
                else
                {
                    @foreach (var folder in ArchiveFolders)
                    {
                        var open = _expandedArchiveTurns.Contains(folder.Turn);
                        <div class="baron-audience__folder @(open ? "baron-audience__folder--open" : "")">
                            <button type="button"
                                    class="baron-audience__folder-summary"
                                    @onclick="@(() => ToggleArchiveFolder(folder.Turn))">
                                <span>@(open ? "▾" : "▸")</span>
                                <span>@L["Turn {0}", folder.Turn]</span>
                                <span class="baron-audience__folder-count">@folder.Items.Count</span>
                            </button>
                            @if (open)
                            {
                                <div class="project-card-grid">
                                    @foreach (var a in folder.Items)
                                    {
                                        <AudiencePanel Audience="a"
                                                       ReadOnly="true"
                                                       ShowSummary="true"
                                                       CanWriteAsGm="CanWriteAsGm"
                                                       CanWriteAsBaron="CanWriteAsBaron"
                                                       BaronCharacterName="@BaronCharacterName"
                                                       Busy="_busy"
                                                       OnMakeChapter="() => MakeChapterAsync(a)" />
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </ChildContent>
    </BaronySection>
}

@code {
    private List<BaronAudienceDTO> _audiences = new();
    private List<BaronyHallEventDTO> _hallEvents = new();
    private List<BaronyHallEventTemplateDTO> _hallEventTemplates = new();
    private List<string> _courtSpeakers = new();
    private List<string> _councilAdvisorOptions = new();
    private readonly HashSet<int> _expandedArchiveTurns = new();
    private readonly HashSet<int> _expandedHallEventTurns = new();
    private bool _showArchivedHallEvents;
    private bool _busy;

    private bool CanWriteAsGm => CanManageAsMg;
    private bool CanWriteAsBaron => CanEdit && !CanManageAsMg;
    private string? BaronCharacterName => UserInfo?.SelectedCharacter?.NPCName;

    private string AudiencePetitionerLabel(BaronAudienceDTO a) =>
        BaronHallEventAudience.IsHallEventPetitioner(a.PetitionerName)
            ? L["Hall event"]
            : a.PetitionerName;

    private IEnumerable<BaronAudienceDTO> AudienceOnly =>
        _audiences.Where(a => BaronAudienceKind.IsAudience(a.Kind));

    private IEnumerable<BaronAudienceDTO> CouncilOnly =>
        _audiences.Where(a => BaronAudienceKind.IsCouncil(a.Kind));

    private IReadOnlyList<BaronAudienceDTO> AudienceSummaryRows =>
        AudienceOnly
            .Where(a => a.ContributesToTurn(Barony?.TurnNumber ?? 0) && a.HasGrants)
            .OrderBy(a => a.Id)
            .ToList();

    private BaronAudienceDTO? CouncilSummary
    {
        get
        {
            var rows = CouncilOnly
                .Where(a => a.ContributesToTurn(Barony?.TurnNumber ?? 0) && a.HasGrants)
                .ToList();
            if (rows.Count == 0)
                return null;

            var additive = PpbVector.Sum(rows.Select(a => a.Additive));
            var percent = PpbVector.Sum(rows.Select(a => a.Percent));
            return new BaronAudienceDTO
            {
                Title = BaronCouncilSession.SummaryRowName,
                PetitionerName = BaronCouncilSession.PetitionerLabel,
                Kind = BaronAudienceKind.Council,
                Additive = additive,
                Percent = percent,
                Prestige = rows.Sum(a => a.Prestige),
                Honor = rows.Sum(a => a.Honor),
                Fear = rows.Sum(a => a.Fear),
                Status = BaronAudienceStatus.InProgress,
                TurnNumber = Barony?.TurnNumber ?? 0,
            };
        }
    }

    private PpbVector SummaryAdditive
    {
        get
        {
            var v = PpbVector.Sum(AudienceSummaryRows.Select(a => a.Additive));
            if (CouncilSummary is not null)
                v.AddInPlace(CouncilSummary.Additive);
            return v;
        }
    }

    private PhpTotals SummaryPhp
    {
        get
        {
            var prestige = AudienceSummaryRows.Sum(a => a.Prestige);
            var honor = AudienceSummaryRows.Sum(a => a.Honor);
            var fear = AudienceSummaryRows.Sum(a => a.Fear);
            if (CouncilSummary is not null)
            {
                prestige += CouncilSummary.Prestige;
                honor += CouncilSummary.Honor;
                fear += CouncilSummary.Fear;
            }
            return new(prestige, honor, fear);
        }
    }

    private IReadOnlyList<BaronAudienceDTO> CurrentCouncilTopics =>
        CouncilOnly
            .Where(a => a.TurnNumber == (Barony?.TurnNumber ?? 0)
                        && (string.Equals(a.Status, BaronAudienceStatus.Scheduled, StringComparison.OrdinalIgnoreCase)
                            || string.Equals(a.Status, BaronAudienceStatus.InProgress, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(a => a.Id)
            .ToList();

    private IReadOnlyList<BaronAudienceDTO> CouncilArchive =>
        CouncilOnly
            .Where(a => !CurrentCouncilTopics.Any(c => c.Id == a.Id))
            .OrderByDescending(a => a.TurnNumber)
            .ThenByDescending(a => a.UpdatedAtUtc)
            .ToList();

    private IReadOnlyList<BaronAudienceDTO> CurrentTurnActive =>
        AudienceOnly
            .Where(a => a.TurnNumber == (Barony?.TurnNumber ?? 0)
                        && (string.Equals(a.Status, BaronAudienceStatus.Scheduled, StringComparison.OrdinalIgnoreCase)
                            || string.Equals(a.Status, BaronAudienceStatus.InProgress, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(a => a.Id)
            .ToList();

    private IReadOnlyList<BaronAudienceDTO> DeferredWaiting =>
        AudienceOnly
            .Where(a => string.Equals(a.Status, BaronAudienceStatus.Deferred, StringComparison.OrdinalIgnoreCase)
                        && !_audiences.Any(c => c.ContinuedFromAudienceId == a.Id))
            .OrderBy(a => a.Id)
            .ToList();

    private IReadOnlyList<(int Turn, List<BaronAudienceDTO> Items)> ArchiveFolders =>
        _audiences
            .Where(IsArchiveEntry)
            .GroupBy(a => a.TurnNumber)
            .OrderByDescending(g => g.Key)
            .Select(g => (g.Key, g.OrderByDescending(a => a.UpdatedAtUtc).ToList()))
            .ToList();

    private bool IsArchiveEntry(BaronAudienceDTO a)
    {
        if (BaronAudienceStatus.IsClosed(a.Status))
            return true;
        if (!string.Equals(a.Status, BaronAudienceStatus.Deferred, StringComparison.OrdinalIgnoreCase))
            return false;
        return _audiences.Any(c => c.ContinuedFromAudienceId == a.Id);
    }

    private IReadOnlyList<BaronyHallEventDTO> ActiveHallEvents =>
        _hallEvents.Where(e => !e.IsArchived && !e.IsConverted).ToList();

    private IReadOnlyList<BaronyHallEventDTO> ArchivedHallEvents =>
        _hallEvents.Where(e => e.IsArchived).ToList();

    private IReadOnlyList<BaronyHallEventDTO> PendingHallEvents =>
        ActiveHallEvents.Where(e => e.IsPending).ToList();

    private IReadOnlyList<BaronyHallEventDTO> ScheduledHallEvents =>
        _hallEvents.Where(e => e.IsScheduled).ToList();

    private IReadOnlyList<BaronyHallEventDTO> VisibleHallEventsForMgmt =>
        _showArchivedHallEvents ? _hallEvents : _hallEvents.Where(e => !e.IsArchived).ToList();

    private IReadOnlyList<(int Turn, List<BaronyHallEventDTO> Items)> HallEventFolders =>
        VisibleHallEventsForMgmt
            .GroupBy(e => e.TurnNumber)
            .OrderByDescending(g => g.Key)
            .Select(g => (g.Key, g.OrderByDescending(e => e.UpdatedAtUtc).ThenByDescending(e => e.Id).ToList()))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadBaronyAsync();
        if (Barony is not null)
            await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (Barony is not null)
        {
            var advisors = await _baronyRepo.GetAvailableAdvisors(Barony.Id);
            _courtSpeakers = advisors
                .Select(a => a.Name)
                .Where(n => !string.IsNullOrWhiteSpace(n))
                .Select(n => n.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
                .ToList();

            var officeAdvisors = await _baronyRepo.GetAdvisors(Barony.Id);
            _councilAdvisorOptions = officeAdvisors
                .Where(a => !a.IsBaron && !string.IsNullOrWhiteSpace(a.PersonName))
                .Select(a => $"{BaronyCalc.AdvisorRoleLabel(a)} \u2014 {a.PersonName.Trim()}")
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }

        _audiences = await _baronyRepo.GetAudiences(BaronyId);
        _hallEvents = await _baronyRepo.GetHallEvents(BaronyId, includeArchived: true, includeScheduled: true, includeConverted: true);
        _hallEventTemplates = await _baronyRepo.GetHallEventTemplates(BaronyId);
        StateHasChanged();
    }

