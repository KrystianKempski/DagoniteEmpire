@page "/barony/known-lords"
@layout BaronyLayout
@inherits BaronyPageBase
@attribute [Authorize(Roles = SD.Role_Admin + "," + SD.Role_GameMaster + "," + SD.Role_DukePlayer)]

<PageTitle>Dagonitowe Imperium | Lordowie</PageTitle>

@if (IsLoading)
{
    <MudProgressCircular Indeterminate="true" Size="Size.Small" /> <span>Ładowanie znanych lordów...</span>
}
else if (LoadError is not null)
{
    <MudAlert Severity="Severity.Info" Class="my-2">@LoadError</MudAlert>
}
else
{
    <BaronyPageHeader Title="Lordowie" HelpKey="known-lords">
        <Summary>
            <span class="projects-summary">
                <span class="projects-summary__item">@_lords.Count lord@(_lords.Count == 1 ? "" : "owie")</span>
            </span>
        </Summary>
    </BaronyPageHeader>

    <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mb-2">
        Wspólna lista dla każdej baronii — lordowie Wschodniej Marchii, ich posiadłości i towary handlowe.
    </MudText>

    <KnownLordsSection BaronyId="@Barony!.Id"
                       Region="@KnownLordsCatalog.RegionEasternMarch"
                       Lords="@_lords"
                       LordNotes="@_lordNotes"
                       LordMarks="@_lordMarks"
                       CanEdit="CanEdit"
                       OnChanged="ReloadLordDataAsync" />
}

@code {
    private IReadOnlyList<KnownLordEntry> _lords = Array.Empty<KnownLordEntry>();
    private IReadOnlyDictionary<string, string> _lordNotes =
        new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyDictionary<string, IReadOnlyList<BaronyCharacterMarkDTO>> _lordMarks =
        new Dictionary<string, IReadOnlyList<BaronyCharacterMarkDTO>>(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        await LoadBaronyAsync();
        if (Barony is null)
            return;

        _lords = KnownLordsCatalog.EasternMarch;
        await ReloadLordDataAsync();
    }

    private async Task ReloadLordDataAsync()
    {
        if (Barony is null)
            return;

        _lordNotes = await _baronyRepo.GetKnownLordNotes(Barony.Id);
        _lordMarks = await _baronyRepo.GetKnownLordMarks(Barony.Id);
        StateHasChanged();
    }
}
