            Y = y,
            Label = _enemyDraft.Label.Trim(),
            IconKey = _enemyDraft.IconKey,
            IsEnemy = true,
            Size = 1,
            Attack = _enemyDraft.Attack,
            Defense = _enemyDraft.Defense,
            Damage = _enemyDraft.Damage,
            Hp = hp,
            MaxHp = hp,
            Discipline = Math.Max(0, _enemyDraft.Discipline),
            TroopCount = Math.Max(1, _enemyDraft.TroopCount),
            Armor = _enemyDraft.Armor,
            Move = Math.Max(0, _enemyDraft.Move),
            RemainingMove = Math.Max(0, _enemyDraft.Move),
