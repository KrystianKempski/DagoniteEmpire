    private sealed class EnemyDraft
    {
        public string Label { get; set; } = "Raiders";
        public string IconKey { get; set; } = "skull";
        public int Attack { get; set; } = 10;
        public int Defense { get; set; } = 12;
        public int Damage { get; set; } = 5;
        public int Hp { get; set; } = 48;
        public int Armor { get; set; } = 3;
        public int Discipline { get; set; } = 9;
        public int TroopCount { get; set; } = 50;
        public int Move { get; set; } = 4;

        public static EnemyDraft Default() => new();

        public static EnemyDraft FromToken(BaronyBattleTokenDTO token) => new()
        {
            Label = token.Label,
            IconKey = string.IsNullOrWhiteSpace(token.IconKey) ? "skull" : token.IconKey,
            Attack = token.Attack,
            Defense = token.Defense,
            Damage = token.Damage,
            Hp = token.Hp,
            Armor = token.Armor,
            Discipline = token.Discipline,
            TroopCount = token.TroopCount,
            Move = token.Move,
        };
    }
