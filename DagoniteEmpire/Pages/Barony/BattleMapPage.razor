    private static void AddUnitLogEntry(
        BaronyUnitDTO unit,
        string kind,
        string text,
        int? xpDelta = null,
        string? note = null)
    {
        unit.Log ??= new();
        unit.Log.Add(new BaronyUnitLogEntryDTO
        {
            Id = Guid.NewGuid().ToString("N"),
            UtcAt = DateTime.UtcNow,
            Kind = kind,
            Text = text,
            XpDelta = xpDelta,
            Note = note,
        });
        if (unit.Log.Count > 200)
            unit.Log = unit.Log[^200..];
    }

    private async Task ApplyXpSummaryAsync(BaronyBattleXpSummaryDTO summary, int round)
    {
        if (summary.Entries.Count == 0)
            return;

        var units = await _baronyRepo.GetUnits(BaronyId);
        foreach (var entry in summary.Entries)
        {
            var unit = units.FirstOrDefault(u => u.Id == entry.UnitId);
            if (unit is null)
                continue;

            var delta = entry.XpNetFinal;
            var beforePd = unit.RemainingPd;
            unit.RemainingPd = Math.Max(0, unit.RemainingPd + delta);

            var battleText = $"Battle round {Math.Max(1, round)} summary: dealt {entry.DamageDealt}, took {entry.DamageTaken}, engaged rounds {entry.EngagedRounds}, kills {entry.Kills}, fled {(entry.Fled ? "yes" : "no")} -> XP {entry.XpNetBase:+#;-#;0}.";
            AddUnitLogEntry(unit, "battle", battleText, xpDelta: entry.XpNetBase);
            if (entry.MgBonusXp != 0 || !string.IsNullOrWhiteSpace(entry.MgNote))
            {
                AddUnitLogEntry(
                    unit,
                    "xp",
                    $"MG adjustment: {entry.MgBonusXp:+#;-#;0} XP.",
                    xpDelta: entry.MgBonusXp,
                    note: entry.MgNote);
            }
            AddUnitLogEntry(
                unit,
                "xp",
                $"XP pool update: {beforePd} -> {unit.RemainingPd}.",
                xpDelta: delta);

            await _baronyRepo.SaveUnit(unit);
        }

        await AwardCaptainCxAsync(summary);
    }

    private async Task AwardCaptainCxAsync(BaronyBattleXpSummaryDTO summary)
    {
        if (summary.Entries.Count == 0)
            return;

        var units = await _baronyRepo.GetUnits(BaronyId);
        var courtiers = await _baronyRepo.GetAvailableAdvisors(BaronyId);
        _courtiers = courtiers;

        foreach (var entry in summary.Entries)
        {
            var unit = units.FirstOrDefault(u => u.Id == entry.UnitId);
            if (unit?.CaptainAvailableAdvisorId is not int captainId)
                continue;
            var captain = courtiers.FirstOrDefault(c => c.Id == captainId);
            if (captain is null)
                continue;

            var sheet = captain.Sheet ?? CourtCharacterSheet.CreateDefault();
            var gained = CourtCommanderFormulas.ComputeBattleCx(
                sheet,
                entry.DamageDealt,
                entry.EngagedRounds,
                entry.Kills,
                entry.DamageTaken,
                entry.MgBonusXp);
            if (gained <= 0)
                continue;

            sheet.CommanderXp += gained;
            sheet.Normalize();
            captain.Sheet = sheet;
            captain.Skills = CourtPpbFormulas.ComputeTotal(sheet);
            await _baronyRepo.SaveAvailableAdvisor(captain);
            AddUnitLogEntry(
                unit,
                "xp",
                $"Captain {captain.Name} gained {gained} CX (pool {sheet.CommanderXp}).",
                xpDelta: null);
            await _baronyRepo.SaveUnit(unit);
        }
    }

    private void ApplyCommanderBattleFlags(BaronyBattleTokenDTO token, BaronyUnitDTO unit)
    {
        ResetCommanderFlags(token);
        token.Discipline = Math.Max(0, unit.Discipline);
        token.Mounted = !string.IsNullOrWhiteSpace(unit.MountKey);
        token.HasCaptain = unit.CaptainAvailableAdvisorId is not null;
        var baseRange = Math.Max(0, UnitWeaponCatalog.Find(unit.Weapon1Key)?.Range ?? 0);
        token.Range = baseRange;
        if (unit.CaptainAvailableAdvisorId is not int captainId)
            return;
        var captain = _courtiers.FirstOrDefault(c => c.Id == captainId);
        if (captain is null)
            return;
        var bonuses = CourtCommanderFormulas.ComputeBonuses(
            captain.Sheet,
            unitHasMount: !string.IsNullOrWhiteSpace(unit.MountKey),
            unitHasShield: !string.IsNullOrWhiteSpace(unit.ShieldKey));
        token.ThunderCharge = bonuses.ThunderCharge;
        token.FlyingStart = bonuses.FlyingStart;
        token.ChargeDamageExtra = bonuses.ShockLance ? 1 : 0;
        token.Discipline = Math.Max(0, unit.Discipline + bonuses.OtherDiscipline);
        token.CommanderInitiative = bonuses.OtherInitiative;
        token.CmdDrillShot = bonuses.DrillShot;
        token.CmdMountedSuperiority = bonuses.MountedSuperiority;
        token.CmdCounterCharge = bonuses.CounterCharge;
        token.CmdPikeHedge = bonuses.PikeHedge;
        token.CmdReturnStroke = bonuses.ReturnStroke;
        token.CmdKillTheCaptain = bonuses.KillTheCaptain;
        token.CmdPierceIgnore = bonuses.PierceIgnore;
        token.CmdWedge = bonuses.Wedge;
        token.CmdUnbrokenMomentum = bonuses.UnbrokenMomentum;
        token.CmdBlindFury = bonuses.BlindFury;
        token.CmdOverrun = bonuses.Overrun;
        token.CmdLongShot = bonuses.LongShot;
        token.CmdSnapShot = bonuses.SnapShot;
        token.CmdSkirmishScreen = bonuses.SkirmishScreen;
        token.CmdEnfilade = bonuses.Enfilade;
        token.CmdHarassingFire = bonuses.HarassingFire;
        token.CmdKnifeInTheDark = bonuses.KnifeInTheDark;
        token.CmdKeepFacing = bonuses.KeepFacing;
        token.CmdLookAway = bonuses.LookAway;
        token.CmdColumnMarch = bonuses.ColumnMarch;
        token.CmdLooseFiles = bonuses.LooseFiles;
        token.CmdIronclad = bonuses.Ironclad;
        if (bonuses.ExtendedRange && baseRange > 0)
            token.Range = baseRange + 1;

        // Passive abilities have no per-token flag (they bake into stats), so capture the
        // active ones here for badge display. Shield Wall Basics only applies with a shield.
        var hasShield = !string.IsNullOrWhiteSpace(unit.ShieldKey);
        var unlocked = captain.Sheet?.UnlockedCommanderAbilities ?? new List<string>();
        token.AllyCommanderAbilities = unlocked
            .Where(k => AllyPassiveBadgeKeys.Contains(k)
                && (!string.Equals(k, "shield-wall-basics", StringComparison.OrdinalIgnoreCase) || hasShield))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static int ChargeAttackBonus(BaronyBattleTokenDTO token) =>
        token.ThunderCharge ? 3 : 2;

    private static int ChargeDamageBonus(BaronyBattleTokenDTO token) =>
        (token.ThunderCharge ? 2 : 1) + Math.Max(0, token.ChargeDamageExtra);

    private async Task MaybeShowBaronXpSummaryAsync()
    {
        if (Map is null || CanManageAsMg)
            return;
        var summary = Map.XpSummary;
        if (summary is null || summary.AcknowledgedByBaron || summary.Entries.Count == 0)
            return;
        if (string.IsNullOrWhiteSpace(summary.Id))
            summary.Id = Guid.NewGuid().ToString("N");
        if (string.Equals(_shownXpSummaryId, summary.Id, StringComparison.Ordinal))
            return;
        _shownXpSummaryId = summary.Id;

        var parameters = new DialogParameters
        {
            [nameof(BattleXpSummaryDialog.Summary)] = summary,
            [nameof(BattleXpSummaryDialog.CanAdjust)] = false,
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.False,
            FullWidth = true,
        };
        var dialog = await _dialogService.ShowAsync<BattleXpSummaryDialog>(
            "Battle XP summary", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not true)
            return;
        if (Map.XpSummary is null || !string.Equals(Map.XpSummary.Id, summary.Id, StringComparison.Ordinal))
            return;
        Map.XpSummary.AcknowledgedByBaron = true;
        await SaveAsync(systemMessage: "Baron acknowledged battle XP summary.");
    }

    private async Task EndBattle()
    {
        if (Map is null || !CanManageAsMg || !IsBattlePhase)
            return;
        if (_isResolvingMovement || _isResolvingCombat)
            return;

        var confirm = await _dialogService.ShowMessageBoxAsync(
            "End battle?",
            "This ends the battle immediately, writes a summary to the log, and syncs baron unit HP to the Army tab — regardless of who is left on the field.",
            yesText: "End battle",
            cancelText: "Cancel");
        if (confirm != true)
            return;

        CancelFacingEdit();
        _isResolvingMovement = false;
        _isResolvingCombat = false;
        _combatAnimActive = false;
        _combatFocusAttackerId = null;
        _combatFx = null;
        _animFrames = new();
        _animTransitionsOn = false;
        _plannedRoutes = new();

        // Capture survivors still on the map.
        foreach (var token in Map.Tokens)
            RecordAllyOutcome(token);

        // If the page was reloaded mid-battle, rebuild a minimal snapshot from survivors.
        if (_allyStartHp.Count == 0 && Map.Tokens.Any(t => !t.IsEnemy && t.UnitId is int))
        {
            try
            {
                var units = await _baronyRepo.GetUnits(BaronyId);
                foreach (var token in Map.Tokens.Where(t => !t.IsEnemy && t.UnitId is int))
                {
                    var uid = token.UnitId!.Value;
                    var armyHp = units.FirstOrDefault(u => u.Id == uid)?.CurrentHp ?? token.MaxHp;
                    _allyStartHp[uid] = armyHp;
                    _allyOutcomeHp[uid] = Math.Max(0, token.Hp);
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not rebuild ally HP snapshot for barony {BaronyId}", BaronyId);
            }
        }

        var summaryLines = await SyncAllyHpToArmyAsync();
        var round = Math.Max(1, Map.TurnState.Round);
        var xpPreview = BuildXpSummaryFromTallies();
        var editedXpSummary = await ShowMgXpSummaryDialogAsync(xpPreview);
        if (editedXpSummary is null)
            return;
        if (string.IsNullOrWhiteSpace(editedXpSummary.Id))
            editedXpSummary.Id = Guid.NewGuid().ToString("N");
        editedXpSummary.Utc = DateTime.UtcNow;
        editedXpSummary.AcknowledgedByBaron = false;
        await ApplyXpSummaryAsync(editedXpSummary, round);
        Map.XpSummary = editedXpSummary;
        _shownXpSummaryId = null;
        Map.Tallies.Clear();

        foreach (var token in Map.Tokens)
        {
            token.AttackTargetId = null;
            ClearCharge(token);
            token.RemainingMove = token.Move;
            token.ClearPath();
        }

        Map.Phase = BaronyBattlePhases.Setup;
        Map.TurnState = new();

        AppendLocalLog(string.Empty, "phase", PhaseBanner($"End of Battle (round {round})"));
        foreach (var line in summaryLines)
            AppendLocalLog(string.Empty, "system", line);
        foreach (var entry in editedXpSummary.Entries.OrderBy(e => e.UnitName))
        {
            AppendLocalLog(
                string.Empty,
                "system",
                $"XP — {entry.UnitName}: base {entry.XpNetBase:+#;-#;0}, MG {entry.MgBonusXp:+#;-#;0}, final {entry.XpNetFinal:+#;-#;0}.");
        }

        await SaveAsync(systemMessage: "Battle ended. Ally HP and XP synced to Army.");
        _selectedTokenId = null;
        RefreshRange();
        _snackBar.Add("Battle ended — Army HP and XP updated.", Severity.Success);
    }

    /// <summary>Writes CurrentHp for every ally that entered the battle; returns summary lines.</summary>
    private async Task<List<string>> SyncAllyHpToArmyAsync()
    {
        var lines = new List<string> { "Battle summary — Army HP:" };
        if (_allyStartHp.Count == 0)
        {
            lines.Add("No baron units were deployed.");
            return lines;
        }

        try
        {
            var units = await _baronyRepo.GetUnits(BaronyId);
            foreach (var uid in _allyStartHp.Keys.OrderBy(id => id))
            {
                var unit = units.FirstOrDefault(u => u.Id == uid);
                if (unit is null)
                    continue;

                var startHp = _allyStartHp[uid];
                var endHp = _allyOutcomeHp.TryGetValue(uid, out var outcome)
                    ? outcome
                    : 0; // started battle but gone from map without a record → treated as fled
                endHp = Math.Max(0, endHp);

                var combat = UnitStatHelper.Compute(unit);
                if (combat.MaxHp > 0)
                    endHp = Math.Min(endHp, combat.MaxHp);

                var before = unit.CurrentHp;
                unit.CurrentHp = endHp;
                await _baronyRepo.SaveUnit(unit);

                var local = _activeUnits.FirstOrDefault(u => u.Id == uid);
                if (local is not null)
                    local.CurrentHp = endHp;

                var delta = endHp - startHp;
                var deltaText = delta == 0 ? "±0" : delta > 0 ? $"+{delta}" : $"{delta}";
                var fledNote = endHp <= 0 ? " — fled / broken" : "";
                lines.Add($"{unit.Name}: {startHp} → {endHp} HP ({deltaText}, was {before} in Army){fledNote}.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to sync battle HP to Army for barony {BaronyId}", BaronyId);
            lines.Add("ERROR: failed to sync some HP values to Army — check server logs.");
            _snackBar.Add("Failed to sync some HP values to Army.", Severity.Error);
        }

        _allyStartHp.Clear();
        _allyOutcomeHp.Clear();
        return lines;
    }

    private async Task ReturnToSetup()
    {
        if (Map is null || !CanManageAsMg)
            return;
        // Prefer End battle while fighting so HP is never discarded by accident.
        if (IsBattlePhase)
        {
            await EndBattle();
            return;
        }

        Map.Phase = BaronyBattlePhases.Setup;
        Map.TurnState = new();
        foreach (var t in Map.Tokens)
        {
            t.RemainingMove = t.Move;
            t.ClearPath();
        }
        await SaveAsync(systemMessage: "Returned to setup.");
        RefreshRange();
    }

    private async Task FinishMove()
    {
        if (Map is null || !IsMovementPhase || Map.TurnState.InitiativeOrder.Count == 0)
            return;

        var active = ActiveToken;
        if (active is null)
            return;

        if (!CanControlToken(active))
        {
            _snackBar.Add("Not your order.", Severity.Warning);
            return;
        }

        CancelFacingEdit();

        // Auto-lock provisional tip so Finish move always commits the visible path.
        var provisional = active.ProvisionalWaypoint;
        if (provisional is not null)
        {
            provisional.Locked = true;
            active.RemainingMove = provisional.RemainingMoveAfter;
        }
        ApplyTravelFacings(active);

        var end = active.PlannedEnd();
        var msg = active.HasPath
            ? $"{active.Label} finished move → {FormatCell(end.X, end.Y)}."
            : $"{active.Label} finished move (staying put).";

        var next = Map.TurnState.CurrentIndex + 1;
        if (next >= Map.TurnState.InitiativeOrder.Count)
        {
            // Past the last unit: orders are complete. Only MG may resolve movement —
            // Baron finishing the last slot must wait (never auto-start the next phase).
            Map.TurnState.CurrentIndex = Map.TurnState.InitiativeOrder.Count;
            if (CanManageAsMg)
            {
                AppendLocalLog(string.Empty, "system", msg);
                await ResolveMovementPhase();
                return;
            }

            await SaveAsync(systemMessage: $"{msg} All movement orders set — waiting for the Game Master to resolve.");
            _selectedTokenId = null;
            RefreshRange();
            return;
        }

        Map.TurnState.CurrentIndex = next;
        var nextTok = ActiveToken;
        await SaveAsync(systemMessage: nextTok is null
            ? msg
            : $"{msg} Next: {nextTok.Label}.");
        _selectedTokenId = ActiveTokenId;
        RefreshRange();
    }

    private async Task UndoMoveStep()
    {
        if (Map is null || !IsMovementPhase || _isResolvingMovement)
            return;

        var active = ActiveToken;
        if (active is null || !CanControlToken(active))
            return;

        if (_facingEditTokenId == active.Id)
        {
            CancelFacingEdit();
            return;
        }

        if (_chargeEditTokenId == active.Id)
        {
            CancelChargeEdit();
            return;
        }

        if (!active.HasPath)
        {
            _snackBar.Add("Nothing to undo.", Severity.Info);
            return;
        }

        // Full reset: clear every planned waypoint/ghost (including multi-tile charges).
        active.ClearPath();
        active.RemainingMove = active.Move;
        ClearCharge(active);

        _selectedTokenId = active.Id;
        await SaveAsync(systemMessage: $"{active.Label} cleared movement plan.");
        RefreshRange();
    }

    private async Task ResolveMovementPhase()
    {
        if (Map is null || !IsMovementPhase || _isResolvingMovement)
            return;
        if (!CanManageAsMg)
        {
            // Only allowed via FinishMove on the last unit.
            var last = Map.TurnState.CurrentIndex >= Map.TurnState.InitiativeOrder.Count - 1;
            if (!last)
            {
                _snackBar.Add("Only the Game Master can resolve all movement early.", Severity.Warning);
                return;
            }
        }

        _isResolvingMovement = true;
        CancelFacingEdit();
        _selectedTokenId = null;
        _rangeCells = new();
        _animTransitionsOn = false;
        _animFrames = new();

        try
        {
            foreach (var token in Map.Tokens)
            {
                if (!token.HasPath)
                {
                    token.RemainingMove = token.Move;
                    continue;
                }

                while (token.Path.Count > 0 && !token.Path[^1].Locked)
                    token.Path.RemoveAt(token.Path.Count - 1);

                if (!token.HasPath)
                {
                    token.RemainingMove = token.Move;
                    continue;
                }

                ApplyTravelFacings(token);

                var end = token.PlannedEnd();
                if (end.X == token.X && end.Y == token.Y)
                {
                    // Stay put (optional facing change already paid on the tip).
                    token.Facing = token.PlannedFacing();
                    token.RemainingMove = token.LastWaypoint?.RemainingMoveAfter ?? token.RemainingMove;
                    token.ClearPath();
                }
            }

            // Arrows show the full plan even where the simulation cuts a unit short.
            var arrowRoutes = new Dictionary<string, List<(int X, int Y)>>(StringComparer.Ordinal);
            foreach (var token in Map.Tokens.Where(t => t.HasPath))
            {
                var planned = BuildCellRoute(token, ignoreUnits: true);
                if (planned.Count > 1)
                    arrowRoutes[token.Id] = planned;
            }

            // Units that only paid for a facing change already had their plan collapsed above,
            // so their move points must survive the outcome pass untouched.
            var movingTokenIds = Map.Tokens
                .Where(t => t.HasPath)
                .Select(t => t.Id)
                .ToHashSet(StringComparer.Ordinal);

            ReconcileEngagements();

            // Snapshot start-of-phase pose so leave-engagement hits use the facing/position
            // from before anyone moved.
            var poseSnap = Map.Tokens.ToDictionary(
                t => t.Id,
                t => (t.X, t.Y, Facing: BaronyBattleFacing.Clamp(t.Facing), Size: TokenSize(t), Hp: t.Hp),
                StringComparer.Ordinal);

            var engagementHits = PreRollEngagementHits(poseSnap);
            var stopCaps = new Dictionary<string, int>(StringComparer.Ordinal);
            BattleMovementResult simulation = BattleMovementSimulator.Simulate(BuildMovementRequest(stopCaps));
            var workingHp = poseSnap.ToDictionary(e => e.Key, e => e.Value.Hp, StringComparer.Ordinal);
            var appliedEngagementHits = new List<(BattleMovementEvent Ev, EngagementHitPlan Hit)>();

            for (var attempt = 0; attempt <= Map.Tokens.Count; attempt++)
            {
                simulation = BattleMovementSimulator.Simulate(BuildMovementRequest(stopCaps));
                workingHp = poseSnap.ToDictionary(e => e.Key, e => e.Value.Hp, StringComparer.Ordinal);
                appliedEngagementHits.Clear();
                var newDeath = false;

                foreach (var ev in simulation.Events
                             .Where(e => e.Kind == BattleMovementEventKind.MovedWhileEngaged)
                             .OrderBy(e => e.AtMs)
                             .ThenBy(e => e.MoverId, StringComparer.Ordinal))
                {
                    if (ev.OtherMoverId is null)
                        continue;
                    if (!engagementHits.TryGetValue((ev.OtherMoverId, ev.MoverId), out var hit))
                        continue;
                    if (!workingHp.TryGetValue(hit.DefenderId, out var hp) || hp <= 0)
                        continue;
                    // A unit already cut down this phase swings at nobody.
                    if (!workingHp.TryGetValue(hit.AttackerId, out var atkHp) || atkHp <= 0)
                        continue;

                    hp = Math.Max(0, hp - hit.Dealt);
                    workingHp[hit.DefenderId] = hp;
                    appliedEngagementHits.Add((ev, hit));

                    if (hp <= 0 && !stopCaps.ContainsKey(hit.DefenderId))
                    {
                        stopCaps[hit.DefenderId] = ev.AtMs;
                        newDeath = true;
                    }
                }

                if (!newDeath)
                    break;
            }

            if (simulation.Legs.Count > 0 || appliedEngagementHits.Count > 0)
            {
                _plannedRoutes = arrowRoutes;
                await ReplayMovementAsync(simulation, appliedEngagementHits);
            }

            _animFrames = new();
            _animTransitionsOn = false;
            _plannedRoutes = new();

            var moved = ApplyMovementOutcomes(simulation, movingTokenIds);

            foreach (var (_, hit) in appliedEngagementHits)
            {
                var hitAttacker = Map.Tokens.FirstOrDefault(t => t.Id == hit.AttackerId);
                var hitDefender = Map.Tokens.FirstOrDefault(t => t.Id == hit.DefenderId);
                if (hitAttacker is not null && hitDefender is not null)
                    TrackDamage(hitAttacker, hitDefender, hit.Dealt);
            }

            // Apply disengage-hit HP after positions settle; dead units stay as blockers until now.
            foreach (var (tokenId, hp) in workingHp)
            {
                var token = Map.Tokens.FirstOrDefault(t => t.Id == tokenId);
                if (token is null)
                    continue;
                token.Hp = hp;
                RecordAllyOutcome(token);
            }

            // Pairs that stayed in contact remain engaged; ReconcileEngagements drops the rest below.
            foreach (var (_, hit) in appliedEngagementHits)
                foreach (var note in hit.Notes)
                    AppendLocalLog(string.Empty, "engagement", note);

            var fledFromLeave = Map.Tokens.Where(t => workingHp.TryGetValue(t.Id, out var hp) && hp <= 0).ToList();
            if (fledFromLeave.Count > 0)
            {
                var finalHitByDefender = appliedEngagementHits
                    .GroupBy(x => x.Hit.DefenderId, StringComparer.Ordinal)
                    .ToDictionary(g => g.Key, g => g.Last().Hit, StringComparer.Ordinal);
                var fledIds = fledFromLeave.Select(t => t.Id).ToHashSet(StringComparer.Ordinal);
                foreach (var fled in fledFromLeave)
                {
                    if (finalHitByDefender.TryGetValue(fled.Id, out var hit))
                    {
                        var killer = Map.Tokens.FirstOrDefault(t => t.Id == hit.AttackerId);
                        if (killer is not null)
                            TrackKill(killer, fled);
                    }
                    ClearEngagementsWith(fled.Id);
                    AppendLocalLog(string.Empty, "engagement",
                        $"{fled.Label} is destroyed disengaging and flees the battlefield.");
                    await MarkAllyFledAsync(fled);
                    Map.Tokens.Remove(fled);
                }

                foreach (var token in Map.Tokens)
                {
                    if (token.AttackTargetId is not null && fledIds.Contains(token.AttackTargetId))
                        token.AttackTargetId = null;
                    if (token.ChargeTargetId is not null && fledIds.Contains(token.ChargeTargetId))
                        ClearCharge(token);
                }

                Map.TurnState.InitiativeOrder = Map.TurnState.InitiativeOrder
                    .Where(id => !fledIds.Contains(id))
                    .ToList();
            }

            foreach (var note in DescribeMovementEvents(simulation))
                AppendLocalLog(string.Empty, "collision", note);

            var chargeSteps = simulation.Outcomes.ToDictionary(
                entry => entry.Key,
                entry => entry.Value.ChargeTilesTravelled,
                StringComparer.Ordinal);

            foreach (var note in LockChargeContacts(simulation))
                AppendLocalLog(string.Empty, "charge", note);

            foreach (var note in ValidateChargesAfterMovement(chargeSteps))
                AppendLocalLog(string.Empty, "charge", note);

            ReconcileEngagements();
            TrackEngagedRound(Math.Max(1, Map.TurnState.Round));

            Map.TurnState.SubPhase = BaronyBattleSubPhases.AttackPlanning;
            Map.TurnState.CurrentIndex = 0;
            Map.TurnState.BaronPhaseReady = false;

            var round = Math.Max(1, Map.TurnState.Round);
            AppendLocalLog(string.Empty, "phase",
                PhaseBanner($"End of Movement Phase {round}"));
            AppendLocalLog(string.Empty, "phase",
                PhaseBanner($"Start of Attack Planning Phase {round}"));

            var summary = moved > 0
                ? $"Movement resolved — {moved} unit(s) moved. Attack planning phase."
                : "Movement resolved — no units moved. Attack planning phase.";
            await SaveAsync(systemMessage: summary);
            _selectedTokenId = null;
            RefreshRange();
        }
        finally
        {
            _animFrames = new();
            _animTransitionsOn = false;
            _isResolvingMovement = false;
        }
    }

    private sealed record EngagementHitPlan(
        string AttackerId,
        string DefenderId,
        int Dealt,
        IReadOnlyList<string> Notes);

    /// <summary>
    /// Pre-rolls the free half-strength hits for every engaged pair, using start-of-phase pose.
    /// Key is (attackerId, defenderId) — attacker is the one holding contact, defender the one who budges.
    /// </summary>
    private Dictionary<(string AttackerId, string DefenderId), EngagementHitPlan> PreRollEngagementHits(
        IReadOnlyDictionary<string, (int X, int Y, int Facing, int Size, int Hp)> poseSnap)
    {
        var result = new Dictionary<(string, string), EngagementHitPlan>();
        if (Map is null)
            return result;

        var rng = Random.Shared;
        var seen = new HashSet<(string, string)>();

        foreach (var defender in Map.Tokens)
        {
            foreach (var attackerId in defender.EngagedEnemyIds)
            {
                var key = (attackerId, defender.Id);
                if (!seen.Add(key))
                    continue;
                if (!poseSnap.TryGetValue(attackerId, out var atkPose)
                    || !poseSnap.TryGetValue(defender.Id, out var defPose))
                    continue;

                var attacker = Map.Tokens.FirstOrDefault(t => t.Id == attackerId);
                if (attacker is null || attacker.IsEnemy == defender.IsEnemy)
                    continue;

                var hit = RollEngagementHit(attacker, defender, atkPose, defPose, rng);
                result[key] = hit;
            }
        }

        return result;
    }

    private EngagementHitPlan RollEngagementHit(
        BaronyBattleTokenDTO attacker,
        BaronyBattleTokenDTO defender,
        (int X, int Y, int Facing, int Size, int Hp) atkPose,
        (int X, int Y, int Facing, int Size, int Hp) defPose,
        Random rng)
    {
        // Temporary pose override so front math uses the start-of-phase facing/position.
        var ax = attacker.X; var ay = attacker.Y; var af = attacker.Facing;
        var dx = defender.X; var dy = defender.Y; var df = defender.Facing;
        attacker.X = atkPose.X; attacker.Y = atkPose.Y; attacker.Facing = atkPose.Facing;
        defender.X = defPose.X; defender.Y = defPose.Y; defender.Facing = defPose.Facing;

        try
        {
            var damageDie = rng.Next(1, 5);
            var attackDie = rng.Next(1, 7);
            var defenseDie = rng.Next(1, 7);
            var attackRoll = attacker.Attack + attackDie - (attacker.FullDefense ? BattleMovementRules.FullDefenseAttackPenalty : 0);
            var defenseRoll = defender.Defense + defenseDie + (defender.FullDefense ? BattleMovementRules.FullDefenseDefenseBonus : 0);
            var ratio = attackRoll / (double)Math.Max(1, defenseRoll);
            var front = GetFrontBreakdown(attacker, defender);
            var defenderArmor = UnitCombatFormulas.EffectiveArmor(defender.Armor, attacker.Pierce);
            var baseDamage = attacker.Damage + damageDie - defenderArmor;
            var rawDamage = baseDamage * ratio * front.Multiplier;
            var full = Math.Max(1, (int)Math.Round(rawDamage, MidpointRounding.AwayFromZero));
            var dealt = Math.Max(1, (int)Math.Round(full / 2.0, MidpointRounding.AwayFromZero));

            var notes = new List<string>
            {
                $"{attacker.Label} free hit as {defender.Label} moves while engaged: " +
                $"(Dmg+k4−Arm={attacker.Damage}+{damageDie}−{defenderArmor}={baseDamage}) " +
                $"× ({attacker.Attack - (attacker.FullDefense ? BattleMovementRules.FullDefenseAttackPenalty : 0)}+k6={attackRoll})/({defender.Defense + (defender.FullDefense ? BattleMovementRules.FullDefenseDefenseBonus : 0)}+k6={defenseRoll}) " +
                $"×{FormatFrontMultiplier(front.Multiplier)} ({front.AimLabel} Vs {front.ExposureLabel}) " +
                $"= {full}, half => {dealt} dmg (no defensive return)." +
                (attacker.FullDefense ? $" [full def −{BattleMovementRules.FullDefenseAttackPenalty} att]" : "") +
                (defender.FullDefense ? $" [full def +{BattleMovementRules.FullDefenseDefenseBonus}]" : "") +
                (defender.Armor > defenderArmor ? $" [pierce −{defender.Armor - defenderArmor} arm]" : ""),
                $"{defender.Label} takes {dealt} disengage damage.",
            };

            return new EngagementHitPlan(attacker.Id, defender.Id, dealt, notes);
        }
        finally
        {
            attacker.X = ax; attacker.Y = ay; attacker.Facing = af;
            defender.X = dx; defender.Y = dy; defender.Facing = df;
        }
    }

    /// <summary>
    /// Translates the map and every planned path into the input the movement simulation runs on.
    /// </summary>
    private BattleMovementRequest BuildMovementRequest(IReadOnlyDictionary<string, int>? stopAtMs = null)
    {
        var impassable = new List<BattleGridPoint>();
        var difficult = new List<BattleGridPoint>();
        foreach (var cell in Map!.Cells)
        {
            if (cell.Terrain == BaronyBattleTerrain.Impassable)
                impassable.Add(new BattleGridPoint(cell.X, cell.Y));
            else if (cell.Terrain == BaronyBattleTerrain.Difficult)
                difficult.Add(new BattleGridPoint(cell.X, cell.Y));
        }

        var movers = new List<BattleMovementMover>();
        foreach (var token in Map.Tokens)
        {
            var route = token.HasPath
                ? BuildCellRoute(token, ignoreUnits: true)
                : new List<(int X, int Y)>();
            if (route.Count == 0)
                route.Add((token.X, token.Y));

            var chargeOrigin = GetChargeOriginCell(token);
            movers.Add(new BattleMovementMover
            {
                Id = token.Id,
                IsEnemy = token.IsEnemy,
                Size = TokenSize(token),
                MovePoints = Math.Max(0, token.Move),
                InitiativeTotal = token.InitiativeTotal,
                InitiativeDie = token.InitiativeDie,
                StartFacing = BaronyBattleFacing.Clamp(token.Facing),
                PlannedFacing = token.HasPath
                    ? token.PlannedFacing()
                    : BaronyBattleFacing.Clamp(token.Facing),
                IsCharging = token.ChargeBonus,
                ChargeStartStep = token.ChargeBonus && chargeOrigin is (int cx, int cy)
                    ? StepsToCell(route, (cx, cy))
                    : 0,
                EngagedEnemyIds = token.EngagedEnemyIds.ToList(),
                IsPinned = IsPinned(token),
                ColumnMarch = token.CmdColumnMarch,
                LooseFiles = token.CmdLooseFiles,
                StopAtMs = stopAtMs is not null && stopAtMs.TryGetValue(token.Id, out var cap)
                    ? cap
                    : null,
                Route = route.Select(p => new BattleGridPoint(p.X, p.Y)).ToList(),
            });
        }

        return new BattleMovementRequest
        {
            Terrain = new BattleMovementTerrain(Map.Width, Map.Height, impassable, difficult),
            Movers = movers,
        };
    }

    /// <summary>
    /// Plays the simulated run back on screen: everyone turns toward their first step, then each
    /// leg is applied on the simulation's own clock. Disengage hits flash at their event times.
    /// </summary>
    private async Task ReplayMovementAsync(
        BattleMovementResult simulation,
        IReadOnlyList<(BattleMovementEvent Ev, EngagementHitPlan Hit)> engagementHits)
    {
        var firstLegByToken = simulation.Legs
            .GroupBy(l => l.MoverId, StringComparer.Ordinal)
            .ToDictionary(g => g.Key, g => g.OrderBy(l => l.StartMs).First(), StringComparer.Ordinal);

        _animFrames = Map!.Tokens
            .Where(t => firstLegByToken.ContainsKey(t.Id))
            .Select(t => new BattleMoveAnimFrame
            {
                TokenId = t.Id,
                LeftPx = t.X * AnimCellPx,
                TopPx = t.Y * AnimCellPx,
                Size = TokenSize(t),
                FacingDeg = BaronyBattleFacing.ToDegrees(t.Facing),
                TransitionMs = 0,
            })
            .ToList();

        StateHasChanged();
        await Task.Delay(40);
        _animTransitionsOn = true;
        StateHasChanged();
        await Task.Delay(40);

        foreach (var frame in _animFrames)
        {
            var leg = firstLegByToken[frame.TokenId];
            frame.FacingDeg = BaronyBattleFacing.ShortestTurnTarget(
                frame.FacingDeg, BaronyBattleFacing.ToDegrees(leg.Facing));
            frame.TransitionMs = 0;
        }
        StateHasChanged();
        await Task.Delay(AnimTurnMs);

        var legsAt = simulation.Legs
            .GroupBy(l => l.StartMs)
            .ToDictionary(g => g.Key, g => g.ToList());
        var hitsAt = engagementHits
            .GroupBy(h => h.Ev.AtMs)
            .ToDictionary(g => g.Key, g => g.Select(h => h.Hit).ToList());
        var stamps = legsAt.Keys.Concat(hitsAt.Keys).Distinct().OrderBy(t => t).ToList();

        var elapsedMs = 0;
        foreach (var atMs in stamps)
        {
            var wait = atMs - elapsedMs;
            if (wait > 0)
                await Task.Delay(wait);
            elapsedMs = atMs;

            // Free hits play before this tick's legs start: every sprite has just landed, so the
            // field is frozen while the swing reads, and one hit at a time so two attackers on the
            // same victim show two separate damage numbers.
            if (hitsAt.TryGetValue(atMs, out var hits))
            {
                foreach (var hit in hits)
                {
                    // Same beats as a Combat exchange: clash lands first, damage floats after.
                    _combatAnimActive = true;
                    _combatFocusAttackerId = hit.AttackerId;
                    _combatFx = new BattleCombatFx
                    {
                        AttackerId = hit.AttackerId,
                        DefenderId = hit.DefenderId,
                        DealtToDefender = hit.Dealt,
                        DealtToAttacker = 0,
                        ShowClash = true,
                        ShowDamage = false,
                    };
                    StateHasChanged();
                    await Task.Delay(CombatClashLeadMs);

                    _combatFx.ShowDamage = true;
                    StateHasChanged();
                    await Task.Delay(CombatDamageMs);

                    _combatFx = null;
                    _combatFocusAttackerId = null;
                    _combatAnimActive = false;
                    StateHasChanged();
                    await Task.Delay(DisengageHitHoldMs);
                }
            }

            if (legsAt.TryGetValue(atMs, out var legs))
            {
                foreach (var leg in legs)
                {
                    var frame = _animFrames.FirstOrDefault(f => f.TokenId == leg.MoverId);
                    if (frame is null)
                        continue;
                    frame.FacingDeg = BaronyBattleFacing.ShortestTurnTarget(
                        frame.FacingDeg, BaronyBattleFacing.ToDegrees(leg.Facing));
                    frame.TransitionMs = leg.DurationMs;
                    frame.LeftPx = leg.ToX * AnimCellPx;
                    frame.TopPx = leg.ToY * AnimCellPx;
                }
                StateHasChanged();
            }
        }

        await Task.Delay(Math.Max(0, simulation.DurationMs - elapsedMs) + 80);

        _combatFx = null;
        _combatFocusAttackerId = null;
        _combatAnimActive = false;

        // Settle on the facing the simulation ended with: the planned heading, or the enemy
        // that brought the unit to a halt.
        var needsFinalTurn = false;
        foreach (var frame in _animFrames)
        {
            if (!simulation.Outcomes.TryGetValue(frame.TokenId, out var outcome))
                continue;
            var target = BaronyBattleFacing.ShortestTurnTarget(
                frame.FacingDeg, BaronyBattleFacing.ToDegrees(outcome.Facing));
            if (Math.Abs(target - frame.FacingDeg) > 0.5)
            {
                frame.FacingDeg = target;
                needsFinalTurn = true;
            }
        }

        if (needsFinalTurn)
        {
            StateHasChanged();
            await Task.Delay(AnimTurnMs);
        }
        else
        {
            await Task.Delay(80);
        }
    }

    /// <summary>Writes the simulated end state onto the tokens. Returns how many actually moved.</summary>
    private int ApplyMovementOutcomes(BattleMovementResult simulation, ISet<string> movingTokenIds)
    {
        var moved = 0;

        foreach (var token in Map!.Tokens)
        {
            if (!movingTokenIds.Contains(token.Id)
                || !simulation.Outcomes.TryGetValue(token.Id, out var outcome))
                continue;

            if (outcome.TilesTravelled > 0)
                moved++;

            token.X = outcome.X;
            token.Y = outcome.Y;
            token.Facing = BaronyBattleFacing.Clamp(outcome.Facing);
            token.RemainingMove = outcome.RemainingMove;
            token.ClearPath();

            if (outcome.EngagedWithMoverId is string foeId)
            {
                var foe = Map.Tokens.FirstOrDefault(t => t.Id == foeId);
                if (foe is not null)
                    BindEngagement(token, foe);
            }
        }

        return moved;
    }

    /// <summary>Turns the simulation's events into battle-log lines.</summary>
    private List<string> DescribeMovementEvents(BattleMovementResult simulation)
    {
        var notes = new List<string>();
        foreach (var ev in simulation.Events.OrderBy(e => e.AtMs))
        {
            if (ev.Kind == BattleMovementEventKind.MovedWhileEngaged)
                continue; // Logged separately with damage numbers.

            var mover = Map?.Tokens.FirstOrDefault(t => t.Id == ev.MoverId);
            if (mover is null)
                continue;

            var other = ev.OtherMoverId is null
                ? null
                : Map?.Tokens.FirstOrDefault(t => t.Id == ev.OtherMoverId);
            var where = FormatCell(ev.X, ev.Y);

            notes.Add(ev.Kind switch
            {
                BattleMovementEventKind.EnemyContact when other is not null =>
                    $"Collision: {mover.Label} ran into {other.Label} and stopped at {where}.",
                BattleMovementEventKind.AllyDeadlock when other is not null =>
                    $"{mover.Label} held up at {where} — {other.Label} never cleared the way.",
                BattleMovementEventKind.OutOfMovePoints =>
                    $"{mover.Label} ran out of movement at {where}.",
                BattleMovementEventKind.BlockedByTerrain =>
                    $"{mover.Label} stopped at {where} — the ground ahead is impassable.",
                _ => $"{mover.Label} stopped at {where}.",
            });
        }
        return notes;
    }

    /// <summary>
    /// Locks the charge target for a charger that ended its run in contact with an enemy.
    /// Charges that fell short are left alone here — <see cref="ValidateChargesAfterMovement"/>
    /// clears them once the tokens have settled.
    /// </summary>
    private List<string> LockChargeContacts(BattleMovementResult simulation)
    {
        var notes = new List<string>();
        if (Map is null)
            return notes;

        foreach (var charger in Map.Tokens.Where(t => t.ChargeBonus))
        {
            if (!simulation.Outcomes.TryGetValue(charger.Id, out var outcome))
                continue;
            if (outcome.EngagedWithMoverId is not string foeId)
                continue;

            var foe = Map.Tokens.FirstOrDefault(t => t.Id == foeId);
            if (foe is null || foe.Hp <= 0 || foe.IsEnemy == charger.IsEnemy)
                continue;

            var steps = outcome.ChargeTilesTravelled;
            if (steps < ChargeInterruptSteps(charger))
                continue;

            if (string.IsNullOrWhiteSpace(charger.ChargeTargetId) || charger.ChargeBlind)
            {
                charger.ChargeTargetId = foe.Id;
                charger.AttackTargetId = foe.Id;
                notes.Add($"{charger.Label} locks charge target on contact: {foe.Label} ({steps} tiles).");
            }
            else if (string.Equals(charger.ChargeTargetId, foe.Id, StringComparison.Ordinal))
            {
                charger.AttackTargetId = foe.Id;
                notes.Add($"{charger.Label} keeps charge contact with {foe.Label} ({steps} tiles).");
            }
            else if (IsValidChargeContact(charger, foe))
            {
                // Someone else stepped into the lance. A body in the forward arc is a body worth
                // hitting, so the charge switches to whoever actually stopped it.
                var intended = Map.Tokens.FirstOrDefault(t => t.Id == charger.ChargeTargetId);
                charger.ChargeTargetId = foe.Id;
                charger.AttackTargetId = foe.Id;
                notes.Add(
                    $"{charger.Label} charge intercepted by {foe.Label} " +
                    $"— hits the interceptor instead of {intended?.Label ?? "its target"} ({steps} tiles).");
            }
        }

        return notes;
    }

    private static int StepsToCell(IReadOnlyList<(int X, int Y)> route, (int X, int Y) cell)
    {
        for (var i = 0; i < route.Count; i++)
        {
            if (route[i].X == cell.X && route[i].Y == cell.Y)
                return i;
        }
        return 0;
    }

    private List<(int X, int Y)> BuildCellRoute(BaronyBattleTokenDTO token, bool ignoreUnits = false)
    {
        var anchors = new List<(int X, int Y)> { (token.X, token.Y) };
        foreach (var wp in token.Path)
            anchors.Add((wp.X, wp.Y));

        var cells = new List<(int X, int Y)> { anchors[0] };
        for (var i = 0; i < anchors.Count - 1; i++)
        {
            var from = anchors[i];
            var to = anchors[i + 1];
            if (from.X == to.X && from.Y == to.Y)
                continue;

            var budget = Math.Max(token.Move * 2, Math.Abs(to.X - from.X) + Math.Abs(to.Y - from.Y) + 8);
            var segment = FindAnchorPath(token, from.X, from.Y, to.X, to.Y, budget, ignoreUnits);
            if (segment is null || segment.Count == 0)
            {
                cells.Add(to);
                continue;
            }

            for (var s = 1; s < segment.Count; s++)
                cells.Add(segment[s]);
        }

        return cells;
    }

    private static void ClearCharge(BaronyBattleTokenDTO token)
    {
        if (string.Equals(token.AttackTargetId, token.ChargeTargetId, StringComparison.Ordinal))
            token.AttackTargetId = null;
        token.ChargeBonus = false;
        token.ChargeBlind = false;
        token.ChargeTargetId = null;
        token.ChargeOriginX = null;
        token.ChargeOriginY = null;
    }

    private static (int X, int Y)? GetChargeOriginCell(BaronyBattleTokenDTO token)
    {
        if (token.ChargeOriginX is int ox && token.ChargeOriginY is int oy)
            return (ox, oy);
        if (!token.Path.Any(w => w.IsCharge))
            return null;
        var prior = token.Path.LastOrDefault(w => !w.IsCharge);
        return prior is not null ? (prior.X, prior.Y) : (token.X, token.Y);
    }

    /// <summary>
    /// After movement settles: charge needs minimum travel and contact with the charge target.
    /// Blind charges succeed from 2 tiles; targeted charges keep the facing start minimum.
    /// </summary>
    private List<string> ValidateChargesAfterMovement(IReadOnlyDictionary<string, int> chargeSteps)
    {
        var notes = new List<string>();
        if (Map is null)
            return notes;

        foreach (var token in Map.Tokens)
        {
            if (!token.ChargeBonus)
                continue;

            chargeSteps.TryGetValue(token.Id, out var steps);
            var minSteps = ChargeInterruptSteps(token);
            var target = string.IsNullOrWhiteSpace(token.ChargeTargetId)
                ? null
                : Map.Tokens.FirstOrDefault(t => t.Id == token.ChargeTargetId);

            // Recover / lock end-of-path contact for a blind charge (forward arc only).
            if (target is null && token.ChargeBlind && steps >= minSteps)
            {
                target = FindChargeEndArcEnemy(token, token.Facing, token.X, token.Y, TokenSize(token));
                if (target is not null)
                {
                    token.ChargeTargetId = target.Id;
                    token.AttackTargetId = target.Id;
                    notes.Add($"{token.Label} locks charge target at path end: {target.Label}.");
                }
            }

            var contactOk = target is not null && IsValidChargeContact(token, target);

            if (steps < minSteps)
            {
                notes.Add(
                    $"{token.Label} charge interrupted — another unit cut across the path " +
                    $"before the charge could build up speed ({steps}/{minSteps} tiles).");
                if (string.Equals(token.AttackTargetId, token.ChargeTargetId, StringComparison.Ordinal))
                    token.AttackTargetId = null;
                ClearCharge(token);
                continue;
            }

            if (!contactOk)
            {
                var reason = target is null || !AreAdjacent(token, target)
                    ? "lost contact"
                    : "target not in front arc (side/rear contact cannot keep the charge)";
                notes.Add($"{token.Label} charge failed ({reason}).");
                if (string.Equals(token.AttackTargetId, token.ChargeTargetId, StringComparison.Ordinal))
                    token.AttackTargetId = null;
                ClearCharge(token);
            }
        }

        return notes;
    }

    /// <summary>
    /// Unpaid waypoints face the next path segment; the tip faces along its incoming segment.
    /// </summary>
    private static void ApplyTravelFacings(BaronyBattleTokenDTO token)
    {
        if (token.Path.Count == 0)
            return;

        var points = new List<(int X, int Y)> { (token.X, token.Y) };
        foreach (var wp in token.Path)
            points.Add((wp.X, wp.Y));

        for (var i = 0; i < token.Path.Count; i++)
        {
            var wp = token.Path[i];
            if (wp.FacingCostPaid > 0)
                continue;

            var here = points[i + 1];
            if (i + 1 < token.Path.Count)
            {
                var next = points[i + 2];
                wp.Facing = BaronyBattleFacing.FromGridStep(here.X, here.Y, next.X, next.Y);
            }
            else
            {
                var prev = points[i];
                if (prev.X == here.X && prev.Y == here.Y)
                    continue; // in-place tip — keep Facing as set by the player
                wp.Facing = BaronyBattleFacing.FromGridStep(prev.X, prev.Y, here.X, here.Y);
            }
        }
    }

    private async Task MarkBaronPhaseReady()
    {
        if (Map is null || !IsAttackPlanningPhase || !CanEdit || CanManageAsMg || _isResolvingCombat)
            return;
        if (Map.TurnState.BaronPhaseReady)
            return;

        Map.TurnState.BaronPhaseReady = true;
        await SaveAsync(systemMessage: "Baron is ready for combat.");
        RefreshRange();
    }

    private async Task AdvanceToCombat()
    {
        if (Map is null || !IsAttackPlanningPhase || !CanManageAsMg || _isResolvingCombat)
            return;

        var missingOrders = Map.Tokens
            .Where(t => t.Hp > 0)
            .Where(CanIssueAttackOrder)
            .Where(t => string.IsNullOrWhiteSpace(t.AttackTargetId))
            .Where(HasAttackTargetOpportunity)
            .ToList();

        if (missingOrders.Count > 0)
        {
            var sample = string.Join(", ", missingOrders.Take(6).Select(t => t.Label));
            var suffix = missingOrders.Count > 6 ? " ..." : string.Empty;
            var proceed = await _dialogService.ShowMessageBoxAsync(
                "Unassigned attacks",
                $"Not every unit with an attack opportunity has a target: {sample}{suffix}. End attack planning anyway?",
                yesText: "Yes, begin combat",
                cancelText: "Go back");
            if (proceed != true)
                return;
        }
        else if (!Map.TurnState.BaronPhaseReady)
        {
            var proceed = await _dialogService.ShowMessageBoxAsync(
                "Baron not ready",
                "The baron has not pressed I'm ready yet. Begin combat anyway?",
                yesText: "Yes, begin combat",
                cancelText: "Go back");
            if (proceed != true)
                return;
        }

        var round = Math.Max(1, Map.TurnState.Round);
        Map.TurnState.SubPhase = BaronyBattleSubPhases.Combat;
        Map.TurnState.BaronPhaseReady = false;
        AppendLocalLog(string.Empty, "phase",
            PhaseBanner($"End of Attack Planning Phase {round}"));
        AppendLocalLog(string.Empty, "phase",
            PhaseBanner($"Start of Combat Phase {round}"));

        var plans = PlanCombatExchanges(Random.Shared);
        await PlayCombatExchangesAsync(plans);
        TrackEngagedRound(round);

        await SaveAsync(systemMessage: $"Attack planning done — round {round} combat begins and attacks are resolved.");
        _selectedTokenId = null;
        RefreshRange();
    }

    private async Task EndCombatPhase()
    {
        if (Map is null || !IsCombatPhase || !CanManageAsMg)
            return;

        foreach (var token in Map.Tokens)
        {
            token.AttackTargetId = null;
            ClearCharge(token);
            token.RemainingMove = token.HarassedNextTurn ? Math.Max(0, token.Move - 1) : token.Move;
            token.FreeFacingUsed = false;
            token.IroncladActive = false;
            token.FullDefense = false;
            if (token.HarassedNextTurn)
            {
                AppendLocalLog(string.Empty, "phase",
                    $"{token.Label} is harassed: Move reduced by 1 this turn ({token.RemainingMove}).");
                token.HarassedNextTurn = false;
            }
            token.ClearPath();
        }

        var endedCombatRound = Math.Max(1, Map.TurnState.Round);
        AppendLocalLog(string.Empty, "phase",
            PhaseBanner($"End of Combat Phase {endedCombatRound}"));

        Map.TurnState.SubPhase = BaronyBattleSubPhases.Movement;
        Map.TurnState.CurrentIndex = 0;
        Map.TurnState.Round = endedCombatRound + 1;
        Map.TurnState.BaronPhaseReady = false;
        ReconcileEngagements();
        AppendLocalLog(string.Empty, "phase",
            PhaseBanner($"Start of Movement Phase {Map.TurnState.Round}"));
        await SaveAsync(systemMessage: $"Round {Map.TurnState.Round} — movement phase (low → high initiative).");
        _selectedTokenId = ActiveTokenId;
        RefreshRange();
    }

    private async Task ClearMap()
    {
        if (Map is null || !CanManageAsMg)
            return;

        var confirm = await _dialogService.ShowMessageBoxAsync(
            "Clear map?",
            "This will remove all painted terrain, text, and tokens, and return the battle to setup. This cannot be undone.",
            yesText: "Clear map",
            cancelText: "Cancel");

        if (confirm != true)
            return;

        Map.Cells.Clear();
        Map.Tokens.Clear();
        Map.Phase = BaronyBattlePhases.Setup;
        Map.TurnState = new();
        _selectedTokenId = null;
        await SaveAsync(systemMessage: "Map cleared.");
        RefreshRange();
    }

    private async Task SendChat()
    {
        if (Map is null || string.IsNullOrWhiteSpace(_chatDraft))
            return;
        var author = CanManageAsMg ? "MG" : "Baron";
        AppendLocalLog(author, "chat", _chatDraft.Trim());
        _chatDraft = string.Empty;
        await SaveAsync();
    }

    private async Task OnChatKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SendChat();
    }

    private static string PhaseBanner(string text) => $"=== {text} ===";

    private void RememberUnitNames()
    {
        if (Map is null)
            return;
        foreach (var token in Map.Tokens)
        {
            if (!string.IsNullOrWhiteSpace(token.Label))
                _unitNameIsEnemy[token.Label] = token.IsEnemy;
        }
        foreach (var unit in _activeUnits)
        {
            if (!string.IsNullOrWhiteSpace(unit.Name))
                _unitNameIsEnemy[unit.Name] = false;
        }
    }

    private MarkupString FormatLogText(string? text)
    {
        if (string.IsNullOrEmpty(text))
            return new MarkupString(string.Empty);

        var html = System.Net.WebUtility.HtmlEncode(text);
        foreach (var (label, isEnemy) in _unitNameIsEnemy
                     .OrderByDescending(kv => kv.Key.Length))
        {
            if (string.IsNullOrWhiteSpace(label))
                continue;
            var enc = System.Net.WebUtility.HtmlEncode(label);
            var cls = isEnemy ? "bbm-name--enemy" : "bbm-name--ally";
            html = html.Replace(enc, $"<span class=\"{cls}\">{enc}</span>", StringComparison.Ordinal);
        }

        return new MarkupString(html);
    }

    private void AppendLocalLog(string author, string kind, string text)
    {
        RememberUnitNames();
        if (Map is null)
            return;
        Map.Log.Add(new BaronyBattleLogEntryDTO
        {
            Id = Guid.NewGuid().ToString("N"),
            Utc = DateTime.UtcNow,
            Author = author,
            Kind = kind,
            Text = text,
        });
        if (Map.Log.Count > 200)
            Map.Log.RemoveRange(0, Map.Log.Count - 200);
    }

    private async Task SaveAsync(string? systemMessage = null)
    {
        if (Map is null)
            return;
        if (!string.IsNullOrWhiteSpace(systemMessage))
            AppendLocalLog(string.Empty, "system", systemMessage);
        try
        {
            Map = await _battleMapRepo.Update(Map);
            if (_hubConnection is not null && _hubConnection.State == HubConnectionState.Connected)
                await _hubConnection.SendAsync("NotifyBaronyBattleMapUpdated", BaronyId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save barony battle map");
            _snackBar.Add("Failed to save battle map.", Severity.Error);
        }
    }

    private void RefreshRange()
    {
        RememberUnitNames();
        RebuildPlannedRoutes();
        _rangeCells = new();
        if (Map is null || _selectedTokenId is null)
            return;
        var token = Map.Tokens.FirstOrDefault(t => t.Id == _selectedTokenId);
        if (token is null)
            return;

        if (IsMovementPhase)
        {
            if (ActiveTokenId != token.Id)
                return;
            // A declared charge accepts no further orders, so there is no range left to offer.
            if (token.ChargeBonus)
                return;

            var (fx, fy, budget) = _chargeEditTokenId == token.Id
                ? GetTipPlanOrigin(token)
                : GetPlanOrigin(token);
            if (budget <= 0)
                return;
            if (_chargeEditTokenId == token.Id)
            {
                _rangeCells = ComputeChargeRangeFrom(token, fx, fy, budget);
                return;
            }
            _rangeCells = ComputeReachableFrom(token, fx, fy, budget);
        }
        else if (IsAttackPlanningPhase)
        {
            // Highlight cells occupied by opposing tokens this unit can attack or shoot
            var attacker = Map.Tokens.FirstOrDefault(t => t.Id == _selectedTokenId);
            if (attacker is null) return;
            foreach (var opponent in Map.Tokens.Where(t => t.IsEnemy != attacker.IsEnemy && t.Hp > 0))
            {
                if (!CanTarget(attacker, opponent)) continue;
                int s = TokenSize(opponent);
                for (int dx = 0; dx < s; dx++)
                    for (int dy = 0; dy < s; dy++)
                        _rangeCells.Add((opponent.X + dx, opponent.Y + dy));
            }
        }
        else if (IsSetupPhase && !token.IsEnemy)
        {
            // Setup: show deploy cells as soft hint when selected
            foreach (var c in Map.Cells.Where(c => c.Terrain == BaronyBattleTerrain.Deploy))
                _rangeCells.Add((c.X, c.Y));
        }
    }

    private HashSet<(int X, int Y)> ComputeChargeRangeFrom(BaronyBattleTokenDTO token, int fromX, int fromY, int budget)
    {
        var cells = new HashSet<(int X, int Y)>();
        if (Map is null || budget < 3)
            return cells;

        var size = TokenSize(token);
        for (var facing = 0; facing < 8; facing++)
        {
            var (dx, dy) = BaronyBattleFacing.StepDelta(facing);
            var diagonal = dx != 0 && dy != 0;
            var cx = fromX;
            var cy = fromY;
            var remainingHalf = MoveHalfBudget(budget);
            var steps = 0;
            var wedgeLeft = token.CmdWedge ? 1 : 0;

            while (remainingHalf > 0)
            {
                var nx = cx + dx;
                var ny = cy + dy;
                var stepHalf = diagonal ? 3 : 2;
                var wedgeThisStep = false;
                if (FootprintEntersDifficult(cx, cy, nx, ny, size))
                {
                    if (wedgeLeft > 0)
                        wedgeThisStep = true;
                    else
                        stepHalf *= 2;
                }
                if (remainingHalf < stepHalf)
                    break;

                if (nx < 0 || ny < 0 || nx + size > Map.Width || ny + size > Map.Height
                    || IsFootprintBlocked(token, nx, ny, size, ignoreUnits: true))
                    break;

                var occupant = FindFootprintOccupant(token, nx, ny, size);
                if (occupant is not null)
                {
                    // Baron fog: enemies on the charge line must not truncate the preview range.
                    if (!(FogEnemyMovementPlans && occupant.IsEnemy != token.IsEnemy))
                        break;
                }

                remainingHalf -= stepHalf;
                if (wedgeThisStep)
                    wedgeLeft--;
                cx = nx;
                cy = ny;
                steps++;
                if (steps >= MinChargeStepsForFacing(facing, token))
                    cells.Add((cx, cy));
            }
        }

        return cells;
    }

    private static int MinChargeStepsForFacing(int facing, BaronyBattleTokenDTO? token = null)
    {
        var normalized = BaronyBattleFacing.Clamp(facing);
        // Cardinal directions need 3 tiles; diagonal directions need 2 tiles.
        var min = normalized % 2 == 0 ? 3 : 2;
        if (token?.FlyingStart == true)
            min = Math.Max(1, min - 1);
        return min;
    }

    /// <summary>Tiles a charge must build before contact counts; Unbroken Momentum lowers it to 1.</summary>
    private static int ChargeInterruptSteps(BaronyBattleTokenDTO? token) =>
        token?.CmdUnbrokenMomentum == true ? 1 : ChargeSuccessSteps;

    /// <summary>
    /// Half-move budget used by pathfinding / charge. Shared with the movement simulation so
    /// planning and resolution can never disagree on what a unit can afford.
    /// </summary>
    private static int MoveHalfBudget(int movePoints) => BattleMovementRules.MoveHalfBudget(movePoints);

    /// <summary>Recomputes the exact tile routes for every token that has a planned path.</summary>
    private void RebuildPlannedRoutes()
    {
        var routes = new Dictionary<string, List<(int X, int Y)>>();
        if (Map is not null)
        {
            foreach (var t in Map.Tokens.Where(t => t.HasPath))
            {
                if (FogEnemyMovementPlans && t.IsEnemy)
                {
                    // Still being planned by MG — reveal nothing until Finish move.
                    if (!IsEnemyPlanRevealedToBaron(t))
                        continue;
                    // Facing-only: no arrow; grid shows a rotation badge instead.
                    if (IsFacingOnlyPlan(t))
                        continue;
                }

                var route = BuildCellRoute(t, ignoreUnits: true);
                if (route.Count <= 1)
                    continue;

                if (FogEnemyMovementPlans && t.IsEnemy)
                    route = TruncateEnemyPlanHint(route);

                if (route.Count > 1)
                    routes[t.Id] = route;
            }
        }
        _plannedRoutes = routes;
    }

    /// <summary>
    /// Enemy order is visible to the Baron only after MG finishes that unit's turn
    /// (initiative advanced past it) and every waypoint is locked.
    /// </summary>
    private bool IsEnemyPlanRevealedToBaron(BaronyBattleTokenDTO token)
    {
        if (!token.IsEnemy || !token.HasPath)
            return false;
        if (ActiveTokenId == token.Id)
            return false;
        if (token.Path.Any(w => !w.Locked))
            return false;
        return true;
    }

    /// <summary>True when the plan never leaves the start cell (rotate in place).</summary>
    private static bool IsFacingOnlyPlan(BaronyBattleTokenDTO token)
    {
        if (!token.HasPath)
            return false;
        if (token.Path.Any(w => w.X != token.X || w.Y != token.Y))
            return false;
        var tip = token.LastWaypoint;
        if (tip is null)
            return false;
        return tip.FacingCostPaid > 0
               || BaronyBattleFacing.Clamp(tip.Facing) != BaronyBattleFacing.Clamp(token.Facing);
    }

    /// <summary>
    /// Baron fog hint: 1 arrow cell when the unit travels 1–2 tiles, 2 cells for longer moves.
    /// <paramref name="route"/> includes the start cell.
    /// </summary>
    private static List<(int X, int Y)> TruncateEnemyPlanHint(List<(int X, int Y)> route)
    {
        if (route.Count <= 1)
            return route;
        var travelSteps = route.Count - 1;
        var revealSteps = travelSteps <= 2 ? 1 : 2;
        return route.Take(revealSteps + 1).ToList();
    }

    // --- Grid helpers (forked pathfinding) ---

    private BaronyBattleCellDTO? GetCell(int x, int y) =>
        Map?.Cells.FirstOrDefault(c => c.X == x && c.Y == y);

    private string GetCellText(int x, int y) => GetCell(x, y)?.Text ?? string.Empty;

    private BaronyBattleCellDTO GetOrAddCell(int x, int y)
    {
        var cell = GetCell(x, y);
        if (cell is null)
        {
            cell = new BaronyBattleCellDTO { X = x, Y = y };
            Map!.Cells.Add(cell);
        }
        return cell;
    }

    private void CleanupCell(BaronyBattleCellDTO cell)
    {
        if (string.IsNullOrWhiteSpace(cell.Color)
            && string.IsNullOrWhiteSpace(cell.Text)
            && string.IsNullOrWhiteSpace(cell.TextColor)
            && string.IsNullOrWhiteSpace(cell.Terrain))
            Map!.Cells.Remove(cell);
    }

    private static int TokenSize(BaronyBattleTokenDTO token) => Math.Clamp(token.Size <= 0 ? 1 : token.Size, 1, 3);

    private BaronyBattleTokenDTO? GetTokenAt(int x, int y) =>
        Map?.Tokens.FirstOrDefault(t =>
        {
            int s = TokenSize(t);
            return x >= t.X && x < t.X + s && y >= t.Y && y < t.Y + s;
        });

    private bool IsDeployCell(int x, int y) =>
        GetCell(x, y)?.Terrain == BaronyBattleTerrain.Deploy;

    private bool IsDeployFootprint(int ax, int ay, int size)
    {
        for (int dx = 0; dx < size; dx++)
            for (int dy = 0; dy < size; dy++)
                if (!IsDeployCell(ax + dx, ay + dy))
                    return false;
        return true;
    }

    private bool CanPlace(int x, int y, int size, string? ignoreTokenId = null)
    {
        if (Map is null || x < 0 || y < 0 || x + size > Map.Width || y + size > Map.Height)
            return false;
        foreach (var other in Map.Tokens)
        {
            if (other.Id == ignoreTokenId)
                continue;
            int os = TokenSize(other);
            bool overlaps = x < other.X + os && x + size > other.X
                         && y < other.Y + os && y + size > other.Y;
            if (overlaps)
                return false;
        }
        return true;
    }

    /// <summary>
    /// Waypoint may not overlap another unit's current footprint or another unit's planned end.
    /// Under Baron fog, enemy bodies and enemy planned ends do not block — the unit may aim
    /// through/onto them and will stop on contact when movement resolves.
    /// </summary>
    private bool CanPlaceWaypoint(BaronyBattleTokenDTO mover, int x, int y)
    {
        if (Map is null)
            return false;
        int size = TokenSize(mover);
        if (x < 0 || y < 0 || x + size > Map.Width || y + size > Map.Height)
            return false;

        for (int dx = 0; dx < size; dx++)
            for (int dy = 0; dy < size; dy++)
                if (GetCell(x + dx, y + dy)?.Terrain == BaronyBattleTerrain.Impassable)
                    return false;

        foreach (var other in Map.Tokens)
        {
            if (other.Id == mover.Id)
                continue;

            // Fog: enemy occupancy / planned destinations must not punch holes in the Baron's range.
            if (FogEnemyMovementPlans && other.IsEnemy != mover.IsEnemy)
                continue;

            int os = TokenSize(other);
            bool overlapsCurrent = x < other.X + os && x + size > other.X
                                && y < other.Y + os && y + size > other.Y;
            if (overlapsCurrent)
                return false;

            if (other.HasPath)
            {
                var end = other.PlannedEnd();
                bool overlapsDest = x < end.X + os && x + size > end.X
                                 && y < end.Y + os && y + size > end.Y;
                if (overlapsDest)
                    return false;
            }
        }

        return true;
    }

    /// <summary>
    /// Tiles a route may not cross: impassable ground, hostile bodies, and comrades pinned in
    /// melee. A comrade standing free is crossable — see <see cref="IsFootprintSlowedByAlly"/>.
    /// Under Baron fog, hostiles are ignored during planning (contact resolves later).
    /// </summary>
    private bool IsBlockedFor(BaronyBattleTokenDTO mover, int x, int y)
    {
        if (GetCell(x, y)?.Terrain == BaronyBattleTerrain.Impassable)
            return true;
        var occupant = GetTokenAt(x, y);
        if (occupant is null || occupant.Id == mover.Id)
            return false;
        if (FogEnemyMovementPlans && occupant.IsEnemy != mover.IsEnemy)
            return false;
        return occupant.IsEnemy != mover.IsEnemy || IsPinned(occupant);
    }

    /// <summary>
    /// True when the footprint would come down on a comrade standing free. Working through one
    /// costs the same as difficult ground.
    /// </summary>
    private bool IsFootprintSlowedByAlly(BaronyBattleTokenDTO mover, int ax, int ay, int size)
    {
        for (int dx = 0; dx < size; dx++)
        {
            for (int dy = 0; dy < size; dy++)
            {
                var occupant = GetTokenAt(ax + dx, ay + dy);
                if (occupant is not null && occupant.Id != mover.Id && occupant.IsEnemy == mover.IsEnemy)
                    return true;
            }
        }
        return false;
    }

    private bool IsFootprintBlocked(BaronyBattleTokenDTO mover, int ax, int ay, int size, bool ignoreUnits = false)
    {
        if (Map is null || ax < 0 || ay < 0 || ax + size > Map.Width || ay + size > Map.Height)
            return true;
        for (int dx = 0; dx < size; dx++)
        {
            for (int dy = 0; dy < size; dy++)
            {
                if (ignoreUnits)
                {
                    if (GetCell(ax + dx, ay + dy)?.Terrain == BaronyBattleTerrain.Impassable)
                        return true;
                }
                else if (IsBlockedFor(mover, ax + dx, ay + dy))
                {
                    return true;
                }
            }
        }
        return false;
    }

    private bool FootprintEntersDifficult(int oldX, int oldY, int newX, int newY, int size)
    {
        for (int dx = 0; dx < size; dx++)
        {
            for (int dy = 0; dy < size; dy++)
            {
                int cx = newX + dx;
                int cy = newY + dy;
                bool wasInside = cx >= oldX && cx < oldX + size && cy >= oldY && cy < oldY + size;
                if (!wasInside && GetCell(cx, cy)?.Terrain == BaronyBattleTerrain.Difficult)
                    return true;
            }
        }
        return false;
    }

    /// <summary>
    /// Half-points one planned step costs: difficult-ground rates when it drags the footprint onto
    /// rough terrain or onto a comrade the unit would have to work through.
    /// </summary>
    private int PlannedStepHalfCost(
        BaronyBattleTokenDTO mover, int fromX, int fromY, int toX, int toY, int size,
        bool ignoreUnits = false) =>
        BattleMovementRules.StepHalfCost(
            fromX, fromY, toX, toY,
            FootprintEntersDifficult(fromX, fromY, toX, toY, size)
            || (!ignoreUnits && !mover.CmdColumnMarch && IsFootprintSlowedByAlly(mover, toX, toY, size)));

    private HashSet<(int X, int Y)> ComputeReachableAnchorsFrom(
        BaronyBattleTokenDTO mover, int fromX, int fromY, int range)
    {
        var anchors = new HashSet<(int, int)>();
        if (Map is null || range <= 0)
            return anchors;

        int size = TokenSize(mover);
        int budget = range * 2 + 1;
        int w = Map.Width;
        int h = Map.Height;
        var dist = new int[w, h];
        for (int i = 0; i < w; i++)
            for (int j = 0; j < h; j++)
                dist[i, j] = int.MaxValue;

        dist[fromX, fromY] = 0;
        var queue = new PriorityQueue<(int X, int Y), int>();
        queue.Enqueue((fromX, fromY), 0);

        while (queue.Count > 0)
        {
            var (cx, cy) = queue.Dequeue();
            int baseCost = dist[cx, cy];
            for (int dx = -1; dx <= 1; dx++)
            {
                for (int dy = -1; dy <= 1; dy++)
                {
                    if (dx == 0 && dy == 0) continue;
                    int nx = cx + dx;
                    int ny = cy + dy;
                    if (IsFootprintBlocked(mover, nx, ny, size))
                        continue;
                    int newCost = baseCost + PlannedStepHalfCost(mover, cx, cy, nx, ny, size);
                    if (newCost > budget) continue;
                    if (newCost < dist[nx, ny])
                    {
                        dist[nx, ny] = newCost;
                        queue.Enqueue((nx, ny), newCost);
                    }
                }
            }
        }

        for (int i = 0; i < w; i++)
        {
            for (int j = 0; j < h; j++)
            {
                if (dist[i, j] == int.MaxValue) continue;
                if (dist[i, j] / 2 > range) continue;
                if (IsMovementPhase)
                {
                    if (!CanPlaceWaypoint(mover, i, j) && !(i == fromX && j == fromY))
                        continue;
                }
                else if (!CanPlace(i, j, size, mover.Id))
                {
                    continue;
                }
                anchors.Add((i, j));
            }
        }
        return anchors;
    }

    private HashSet<(int X, int Y)> ComputeReachableFrom(
        BaronyBattleTokenDTO mover, int fromX, int fromY, int range)
    {
        var result = new HashSet<(int, int)>();
        int size = TokenSize(mover);
        foreach (var (ax, ay) in ComputeReachableAnchorsFrom(mover, fromX, fromY, range))
        {
            for (int dx = 0; dx < size; dx++)
                for (int dy = 0; dy < size; dy++)
                    result.Add((ax + dx, ay + dy));
        }
        return result;
    }

    private List<(int X, int Y)>? FindAnchorPath(
        BaronyBattleTokenDTO mover, int fromX, int fromY, int targetX, int targetY, int range,
        bool ignoreUnits = false)
    {
        if (fromX == targetX && fromY == targetY)
            return new List<(int X, int Y)> { (fromX, fromY) };
        if (Map is null || range <= 0)
            return null;

        int size = TokenSize(mover);
        int budget = range * 2 + 1;
        int w = Map.Width;
        int h = Map.Height;
        var dist = new int[w, h];
        var prevX = new int[w, h];
        var prevY = new int[w, h];
        for (int i = 0; i < w; i++)
        for (int j = 0; j < h; j++)
        {
            dist[i, j] = int.MaxValue;
            prevX[i, j] = -1;
            prevY[i, j] = -1;
        }

        dist[fromX, fromY] = 0;
        var queue = new PriorityQueue<(int X, int Y), int>();
        queue.Enqueue((fromX, fromY), 0);
        while (queue.Count > 0)
        {
            var (cx, cy) = queue.Dequeue();
            if (cx == targetX && cy == targetY)
                break;
            int baseCost = dist[cx, cy];
            if (baseCost == int.MaxValue)
                continue;
            for (int dx = -1; dx <= 1; dx++)
            for (int dy = -1; dy <= 1; dy++)
            {
                if (dx == 0 && dy == 0) continue;
                int nx = cx + dx, ny = cy + dy;
                if (IsFootprintBlocked(mover, nx, ny, size, ignoreUnits)) continue;
                int newCost = baseCost + PlannedStepHalfCost(mover, cx, cy, nx, ny, size, ignoreUnits);
                if (newCost > budget) continue;
                if (newCost < dist[nx, ny])
                {
                    dist[nx, ny] = newCost;
                    prevX[nx, ny] = cx;
                    prevY[nx, ny] = cy;
                    queue.Enqueue((nx, ny), newCost);
                }
            }
        }

        if (dist[targetX, targetY] == int.MaxValue)
            return null;

        var path = new List<(int X, int Y)>();
        int x = targetX, y = targetY;
        while (!(x == fromX && y == fromY))
        {
            path.Add((x, y));
            var px = prevX[x, y];
            var py = prevY[x, y];
            if (px < 0 || py < 0)
                return null;
            x = px;
            y = py;
        }
        path.Add((fromX, fromY));
        path.Reverse();
        return path;
    }

    private int EstimateMoveCostFrom(
        BaronyBattleTokenDTO mover, int fromX, int fromY, int targetX, int targetY, int range)
    {
        if (fromX == targetX && fromY == targetY)
            return 0;
        if (Map is null || range <= 0)
            return -1;

        int size = TokenSize(mover);
        int budget = range * 2 + 1;
        int w = Map.Width;
        int h = Map.Height;
        var dist = new int[w, h];
        for (int i = 0; i < w; i++)
            for (int j = 0; j < h; j++)
                dist[i, j] = int.MaxValue;
        dist[fromX, fromY] = 0;
        var queue = new PriorityQueue<(int X, int Y), int>();
        queue.Enqueue((fromX, fromY), 0);
        while (queue.Count > 0)
        {
            var (cx, cy) = queue.Dequeue();
            if (cx == targetX && cy == targetY)
                break;
            int baseCost = dist[cx, cy];
            for (int dx = -1; dx <= 1; dx++)
            for (int dy = -1; dy <= 1; dy++)
            {
                if (dx == 0 && dy == 0) continue;
                int nx = cx + dx, ny = cy + dy;
                if (IsFootprintBlocked(mover, nx, ny, size)) continue;
                int newCost = baseCost + PlannedStepHalfCost(mover, cx, cy, nx, ny, size);
                if (newCost > budget) continue;
                if (newCost < dist[nx, ny])
                {
                    dist[nx, ny] = newCost;
                    queue.Enqueue((nx, ny), newCost);
                }
            }
        }
        if (dist[targetX, targetY] == int.MaxValue)
            return -1;
        return dist[targetX, targetY] / 2;
    }

    private static char ColumnLetter(int x) => (char)('A' + x);
    private static string FormatCell(int x, int y) => $"{ColumnLetter(x)}{y + 1}";

    private RenderFragment ForceStatusBadges(BaronyBattleTokenDTO token) => __builder =>
    {
        if (!token.FullDefense && !token.IroncladActive)
            return;

        <div class="bbm-force-status">
            @if (token.FullDefense)
            {
                <span class="bbm-force-status__badge bbm-force-status__badge--full-def"
                      title="@($"Full Defense: Atk {token.Attack - BattleMovementRules.FullDefenseAttackPenalty} (−{BattleMovementRules.FullDefenseAttackPenalty}), Def {token.Defense + BattleMovementRules.FullDefenseDefenseBonus} (+{BattleMovementRules.FullDefenseDefenseBonus}), Move 0")">
                    <img src="/icons/full-defence.svg" alt="" aria-hidden="true" />
                    <em>Atk @($"{token.Attack}−{BattleMovementRules.FullDefenseAttackPenalty}") · Def @($"{token.Defense}+{BattleMovementRules.FullDefenseDefenseBonus}")</em>
                </span>
            }
            @if (token.IroncladActive)
            {
                <span class="bbm-force-status__badge bbm-force-status__badge--ironclad"
                      title="@($"Ironclad: Armor {token.Armor + 2} (+2) this combat round")">
                    <img src="/icons/breastplate.svg" alt="" aria-hidden="true" />
                    <em>Arm @token.Armor+2</em>
                </span>
            }
        </div>
    };

    /// <summary>Commander abilities carried by a token: enemies from their selected keys, allies derived from active flags.</summary>
    private static IReadOnlyList<string> TokenCommanderAbilityKeys(BaronyBattleTokenDTO token)
    {
        if (token.IsEnemy)
            return token.EnemyCommanderAbilities ?? (IReadOnlyList<string>)Array.Empty<string>();

        var keys = new List<string>();
        void Add(bool on, string key)
        {
            if (on)
                keys.Add(key);
        }

        Add(token.CmdDrillShot, "drill-shot");
        Add(token.CmdMountedSuperiority, "mounted-superiority");
        Add(token.CmdCounterCharge, "counter-charge");
        Add(token.CmdPikeHedge, "pike-hedge");
        Add(token.CmdReturnStroke, "return-stroke");
        Add(token.CmdKillTheCaptain, "kill-the-captain");
        Add(token.CmdPierceIgnore > 0, "riveted-plate");
        Add(token.ChargeDamageExtra > 0, "shock-lance");
        Add(token.ThunderCharge, "thunder-charge");
        Add(token.FlyingStart, "flying-start");
        Add(token.CmdWedge, "wedge");
        Add(token.CmdUnbrokenMomentum, "unbroken-momentum");
        Add(token.CmdBlindFury, "blind-fury");
        Add(token.CmdOverrun, "overrun");
        Add(token.CmdLongShot, "long-shot");
        Add(token.CmdSnapShot, "snap-shot");
        Add(token.CmdSkirmishScreen, "skirmish-screen");
        Add(token.CmdEnfilade, "enfilade");
        Add(token.CmdHarassingFire, "harassing-fire");
        Add(token.CmdKnifeInTheDark, "knife-in-the-dark");
        Add(token.CmdKeepFacing, "keep-facing");
        Add(token.CmdLookAway, "look-away");
        Add(token.CmdColumnMarch, "column-march");
        Add(token.CmdLooseFiles, "loose-files");
        Add(token.CmdIronclad, "ironclad");
        // Passive abilities have no per-token flag, so they are captured separately at deploy.
        foreach (var key in token.AllyCommanderAbilities ?? Enumerable.Empty<string>())
        {
            if (!keys.Contains(key))
                keys.Add(key);
        }
        return keys;
    }

    private RenderFragment CommanderAbilityBadges(BaronyBattleTokenDTO token) => __builder =>
    {
        var keys = TokenCommanderAbilityKeys(token);
        if (keys.Count == 0)
            return;

        <div class="bbm-force-abilities">
            <span class="bbm-force-abilities__label">@L["Abilities:"]</span>
            @foreach (var key in keys)
            {
                var ab = CourtCommanderCatalog.Find(key);
                <span class="bbm-force-ability-chip"
                      title="@($"[T{ab?.Tier}] {ab?.Branch} · {(ab is null ? null : L[ab.DescriptionEn].Value)}")">
                    @(L[ab?.NameEn ?? key])
                </span>
            }
        </div>
    };

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            try { await _hubConnection.DisposeAsync(); }
            catch { /* ignore */ }
        }
    }

    private sealed class EnemyDraft
    {
        public string Label { get; set; } = "Raiders";
        public string IconKey { get; set; } = "skull";
        public int Attack { get; set; } = 10;
        public int Defense { get; set; } = 12;
        public int Damage { get; set; } = 5;
        public int Hp { get; set; } = 48;
        public int Armor { get; set; } = 3;
        public int Discipline { get; set; } = 9;
        public int TroopCount { get; set; } = 50;
        public int Move { get; set; } = 4;
        /// <summary>0 = melee only; &gt;0 = ranged unit (shot reach in move-points).</summary>
        public int Range { get; set; }

        /// <summary>Armor cut through by this unit's attacks; 0 = stopped by armor as usual.</summary>
        public int Pierce { get; set; }

        /// <summary>Mount state used by horse-dependent commander abilities.</summary>
        public bool Mounted { get; set; }

        /// <summary>Selected commander abilities (skill-tree keys) for this enemy unit.</summary>
        public List<string> CommanderAbilities { get; set; } = new();

        public static EnemyDraft Default() => new();

        public static EnemyDraft FromToken(BaronyBattleTokenDTO token) => new()
        {
            Label = token.Label,
            IconKey = string.IsNullOrWhiteSpace(token.IconKey) ? "skull" : token.IconKey,
            Attack = token.Attack,
            Defense = token.EnemyBaseCaptured ? token.EnemyBaseDefense : token.Defense,
            Damage = token.EnemyBaseCaptured ? token.EnemyBaseDamage : token.Damage,
            Hp = token.EnemyBaseCaptured ? token.EnemyBaseHp : token.Hp,
            Armor = token.Armor,
            Discipline = token.EnemyBaseCaptured ? token.EnemyBaseDiscipline : token.Discipline,
            TroopCount = token.TroopCount,
            Move = token.EnemyBaseCaptured ? token.EnemyBaseMove : token.Move,
            Range = token.EnemyBaseRange > 0 ? token.EnemyBaseRange : token.Range,
            Pierce = token.Pierce,
            Mounted = token.Mounted,
            CommanderAbilities = token.EnemyCommanderAbilities
                .Where(k => !string.IsNullOrWhiteSpace(k))
                .Select(k => k.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList(),
        };
    }
}
