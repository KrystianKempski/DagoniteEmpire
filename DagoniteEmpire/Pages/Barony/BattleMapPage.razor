    private void SelectToken(string id)
    {
        _selectedTokenId = _selectedTokenId == id ? null : id;
        RefreshRange();
    }

    private async Task HandleCellClick((int X, int Y) pos)
    {
        if (Map is null)
            return;
        var (x, y) = pos;

        if (_deployUnitId is int deployId && IsSetupPhase && CanEdit)
        {
            await DeployAllyAt(deployId, x, y);
            return;
        }

        if (_placingEnemy && CanManageAsMg && IsSetupPhase)
        {
            await PlacePendingEnemy(x, y);
            return;
        }

        if (CanManageAsMg && _mapEditMode && _tool == "tiles")
        {
            await PaintTile(x, y);
            return;
        }

        if (CanManageAsMg && _mapEditMode && _tool == "text")
        {
            _selectedCell = (x, y);
            var cell = GetOrAddCell(x, y);
            cell.TextColor = _currentColor;
            await SaveAsync();
            return;
        }

        if (CanManageAsMg && _mapEditMode && _tool == "erase")
        {
            var cell = GetCell(x, y);
            if (cell is not null)
                Map.Cells.Remove(cell);
            var tok = GetTokenAt(x, y);
            if (tok is not null)
                Map.Tokens.Remove(tok);
            await SaveAsync();
            RefreshRange();
            return;
        }

        // Movement / selection
        var clicked = GetTokenAt(x, y);
        if (_selectedTokenId is not null)
        {
            var selected = Map.Tokens.FirstOrDefault(t => t.Id == _selectedTokenId);
            if (selected is not null && await TryMoveToken(selected, x, y))
                return;
        }

        if (clicked is not null && CanSelectToken(clicked))
        {
            if (IsMovementPhase)
            {
                // Keep focus on the unit whose order it is (range + move badge).
                if (clicked.Id == ActiveTokenId)
                    _selectedTokenId = ActiveTokenId;
            }
            else
            {
                _selectedTokenId = clicked.Id == _selectedTokenId ? null : clicked.Id;
            }
            RefreshRange();
        }
    }

    private async Task DeployAllyAt(int unitId, int x, int y)
    {
        if (Map is null)
            return;
        var unit = _activeUnits.FirstOrDefault(u => u.Id == unitId);
        if (unit is null)
            return;
        if (Map.Tokens.Any(t => t.UnitId == unitId))
        {
            _snackBar.Add("Unit already on the map.", Severity.Warning);
            return;
        }
        if (!IsDeployCell(x, y))
        {
            _snackBar.Add("Deploy only inside the deployment zone.", Severity.Warning);
            return;
        }
        if (!CanPlace(x, y, 1))
        {
            _snackBar.Add("Cell occupied.", Severity.Warning);
            return;
        }

        var stats = UnitStatHelper.Compute(unit);
        var token = new BaronyBattleTokenDTO
        {
            Id = Guid.NewGuid().ToString("N"),
            X = x,
            Y = y,
            Label = unit.Name,
            IconKey = GetAllyIconKey(unitId),
            IsEnemy = false,
            UnitId = unitId,
            Size = 1,
            Attack = stats.Attack,
            Defense = stats.Defense,
            Damage = stats.Damage,
            Hp = unit.CurrentHp > 0 ? unit.CurrentHp : stats.MaxHp,
            MaxHp = stats.MaxHp,
            Discipline = unit.Discipline,
            TroopCount = unit.TroopCount,
            Armor = stats.Armor,
            Move = Math.Max(0, stats.Move),
            RemainingMove = Math.Max(0, stats.Move),
        };
        Map.Tokens.Add(token);
        _deployUnitId = null;
        _selectedTokenId = token.Id;
        await SaveAsync(systemMessage: $"{token.Label} deployed at {FormatCell(x, y)}.");
        RefreshRange();
    }

    private async Task RecallUnit(int unitId)
    {
        if (Map is null || !IsSetupPhase)
            return;
        var token = Map.Tokens.FirstOrDefault(t => t.UnitId == unitId);
        if (token is null)
            return;
        Map.Tokens.Remove(token);
        await SaveAsync(systemMessage: $"{token.Label} recalled.");
        RefreshRange();
    }

