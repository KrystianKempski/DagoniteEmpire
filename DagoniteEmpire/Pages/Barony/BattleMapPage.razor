    private async Task PaintTile(int x, int y)
    {
        if (Map is null)
            return;
        var cell = GetOrAddCell(x, y);
        switch (_tileBrush)
        {
            case "deploy":
                cell.Terrain = BaronyBattleTerrain.Deploy;
                break;
            case "difficult":
                cell.Terrain = BaronyBattleTerrain.Difficult;
                break;
            case "impassable":
                cell.Terrain = BaronyBattleTerrain.Impassable;
                break;
            case "normal":
                cell.Terrain = null;
                CleanupCell(cell);
                break;
            default:
                cell.Color = _currentColor;
                break;
        }
        await SaveAsync();
    }

    private async Task OnCellTextChanged(ChangeEventArgs e)
    {
        if (Map is null || _selectedCell is null)
            return;
        var cell = GetOrAddCell(_selectedCell.Value.X, _selectedCell.Value.Y);
        cell.Text = e.Value?.ToString();
        cell.TextColor = _currentColor;
        CleanupCell(cell);
        await SaveAsync();
    }

    private async Task<bool> TryMoveToken(BaronyBattleTokenDTO token, int x, int y)
    {
        if (Map is null)
            return false;

        if (!CanControlToken(token))
        {
            _snackBar.Add("You cannot move this token.", Severity.Warning);
            return false;
        }

        int size = TokenSize(token);
        int nx = Math.Clamp(x, 0, Map.Width - size);
        int ny = Math.Clamp(y, 0, Map.Height - size);

        if (IsSetupPhase)
        {
            if (!token.IsEnemy && !IsDeployFootprint(nx, ny, size))
            {
                _snackBar.Add("Allies stay in the deployment zone during setup.", Severity.Warning);
                return false;
            }
            if (!CanPlace(nx, ny, size, token.Id))
                return false;
            token.X = nx;
            token.Y = ny;
            _selectedTokenId = null;
            await SaveAsync(systemMessage: $"{token.Label} moved to {FormatCell(nx, ny)}.");
            RefreshRange();
            return true;
        }

        // Movement phase: waypoint path planning (ghost → lock → next segment).
        if (!IsMovementPhase)
        {
            if (IsCombatPhase)
                _snackBar.Add("Movement is locked during the combat phase.", Severity.Info);
            return false;
        }

        if (ActiveTokenId != token.Id)
        {
            _snackBar.Add("Wait for this unit's movement order.", Severity.Warning);
            return false;
        }

        // Click current cell → clear planned path.
        if (nx == token.X && ny == token.Y)
        {
            CancelFacingEdit();
            token.ClearPath();
            token.RemainingMove = token.Move;
            _selectedTokenId = token.Id;
            await SaveAsync(systemMessage: $"{token.Label} cleared movement path.");
            RefreshRange();
            return true;
        }

        // Click provisional ghost → lock it.
        var provisional = token.ProvisionalWaypoint;
        if (provisional is not null && provisional.X == nx && provisional.Y == ny)
        {
            provisional.Locked = true;
            token.RemainingMove = provisional.RemainingMoveAfter;
            ApplyTravelFacings(token);
            _selectedTokenId = token.Id;
            await SaveAsync(systemMessage: $"{token.Label} locked waypoint at {FormatCell(nx, ny)} ({provisional.RemainingMoveAfter} move left).");
            RefreshRange();
            return true;
        }

        var (fromX, fromY, budget) = GetPlanOrigin(token);

        // Click plan origin or an already-locked waypoint — no new tip.
        if ((nx == fromX && ny == fromY)
            || token.Path.Any(w => w.Locked && w.X == nx && w.Y == ny))
        {
            _selectedTokenId = token.Id;
            RefreshRange();
            return true;
        }

        if (budget <= 0)
        {
            _snackBar.Add("No movement left — Finish move or clear path.", Severity.Warning);
            return false;
        }

        var reachable = ComputeReachableAnchorsFrom(token, fromX, fromY, budget);
        if (!reachable.Contains((nx, ny)))
        {
            _snackBar.Add("Out of movement range.", Severity.Warning);
            return false;
        }

        if (!CanPlaceWaypoint(token, nx, ny))
        {
            _snackBar.Add("Destination blocked (unit or another order).", Severity.Warning);
            return false;
        }

        var cost = EstimateMoveCostFrom(token, fromX, fromY, nx, ny, budget);
        if (cost < 0 || cost > budget)
        {
            _snackBar.Add("Not enough movement.", Severity.Warning);
            return false;
        }

        var remaining = Math.Max(0, budget - cost - (provisional?.FacingCostPaid ?? 0));
        if (provisional is not null)
        {
            provisional.X = nx;
            provisional.Y = ny;
            provisional.RemainingMoveAfter = remaining;
        }
        else
        {
            token.Path.Add(new BaronyBattleWaypointDTO
            {
                X = nx,
                Y = ny,
                Locked = false,
                RemainingMoveAfter = remaining,
                Facing = BaronyBattleFacing.FromGridStep(fromX, fromY, nx, ny),
                FacingCostPaid = 0,
            });
        }

        ApplyTravelFacings(token);

        token.RemainingMove = remaining;
        _selectedTokenId = token.Id;
        await SaveAsync(systemMessage: $"{token.Label} destination {FormatCell(nx, ny)} (cost {cost}, {remaining} left).");
        RefreshRange();
        return true;
    }

    private void CancelFacingEdit()
    {
        _facingEditTokenId = null;
        _facingPreviewDeg = null;
    }

    private Task StartFacingEdit(string tokenId)
    {
        if (Map is null || _isResolvingMovement)
            return Task.CompletedTask;
        var token = Map.Tokens.FirstOrDefault(t => t.Id == tokenId);
        if (token is null || !CanSelectToken(token) || !CanControlToken(token))
            return Task.CompletedTask;

        // Setup / deploy: free facing change on the selected token (no move cost).
        if (IsSetupPhase)
        {
            _selectedTokenId = token.Id;
            _facingEditTokenId = tokenId;
            _facingEditStartFacing = BaronyBattleFacing.Clamp(token.Facing);
            _facingPreviewDeg = BaronyBattleFacing.ToDegrees(token.Facing);
            return Task.CompletedTask;
        }

        if (!IsMovementPhase || ActiveTokenId != token.Id)
            return Task.CompletedTask;

        var tip = token.LastWaypoint;
        // Stay-put facing: create a same-cell tip to hold facing + move cost.
        if (tip is null)
        {
            if (token.RemainingMove < 1)
            {
                _snackBar.Add("Need at least 1 move point to change facing.", Severity.Warning);
                return Task.CompletedTask;
            }

            tip = new BaronyBattleWaypointDTO
            {
                X = token.X,
                Y = token.Y,
                Locked = true,
                Facing = BaronyBattleFacing.Clamp(token.Facing),
                RemainingMoveAfter = token.RemainingMove,
                FacingCostPaid = 0,
            };
            token.Path.Add(tip);
        }

        if (tip.RemainingMoveAfter < 1 && tip.FacingCostPaid <= 0)
        {
            _snackBar.Add("Need at least 1 move point to change facing.", Severity.Warning);
            return Task.CompletedTask;
        }

        _facingEditTokenId = tokenId;
        _facingEditStartFacing = BaronyBattleFacing.Clamp(tip.Facing);
        _facingPreviewDeg = BaronyBattleFacing.ToDegrees(tip.Facing);
        return Task.CompletedTask;
    }

    private void OnFacingPreview(double degrees)
    {
        if (_facingEditTokenId is null)
            return;
        _facingPreviewDeg = degrees;
    }

    private async Task ConfirmFacingEdit()
    {
        if (Map is null || _facingEditTokenId is null)
            return;
        var token = Map.Tokens.FirstOrDefault(t => t.Id == _facingEditTokenId);
        if (token is null)
        {
            CancelFacingEdit();
            return;
        }

        if (IsSetupPhase)
        {
            var setupSnapped = BaronyBattleFacing.SnapFromDegrees(
                _facingPreviewDeg ?? BaronyBattleFacing.ToDegrees(token.Facing));
            var setupChanged = setupSnapped != _facingEditStartFacing;
            token.Facing = setupSnapped;
            CancelFacingEdit();
            await SaveAsync(systemMessage: setupChanged
                ? $"{token.Label} facing set ({setupSnapped * 45}°)."
                : $"{token.Label} facing unchanged.");
            RefreshRange();
            return;
        }

        var tip = token.LastWaypoint;
        if (tip is null)
        {
            CancelFacingEdit();
            return;
        }

        var snapped = BaronyBattleFacing.SnapFromDegrees(_facingPreviewDeg ?? BaronyBattleFacing.ToDegrees(tip.Facing));
        var changed = snapped != _facingEditStartFacing;
        if (changed && tip.FacingCostPaid <= 0)
        {
            if (tip.RemainingMoveAfter < 1)
            {
                _snackBar.Add("Need 1 move point to change facing.", Severity.Warning);
                CancelFacingEdit();
                return;
            }
            tip.FacingCostPaid = 1;
            tip.RemainingMoveAfter = Math.Max(0, tip.RemainingMoveAfter - 1);
            token.RemainingMove = tip.RemainingMoveAfter;
        }

        tip.Facing = snapped;
        CancelFacingEdit();
        await SaveAsync(systemMessage: changed
            ? $"{token.Label} facing set ({snapped * 45}°){(tip.FacingCostPaid > 0 ? ", −1 move" : "")}."
            : $"{token.Label} facing unchanged.");
        RefreshRange();
    }

    private bool CanControlToken(BaronyBattleTokenDTO token)
    {
        if (CanManageAsMg)
            return true;
        // While the battle map is still in development, Baron may also control enemy orders.
        return CanEdit;
    }

    private bool CanSelectToken(BaronyBattleTokenDTO token)
    {
        if (CanManageAsMg)
            return true;
        // Setup: Baron only deploys allies. Battle: may select either side while testing.
        if (IsSetupPhase)
            return !token.IsEnemy;
        return CanEdit;
    }

    /// <summary>Origin and remaining budget for the next path segment.</summary>
    private static (int X, int Y, int Budget) GetPlanOrigin(BaronyBattleTokenDTO token)
    {
        var locked = token.Path.Where(w => w.Locked).ToList();
        if (locked.Count == 0)
            return (token.X, token.Y, token.Move);
        var last = locked[^1];
        return (last.X, last.Y, last.RemainingMoveAfter);
    }

    private static int GetPlanBudget(BaronyBattleTokenDTO token) => GetPlanOrigin(token).Budget;

    /// <summary>Two tokens are adjacent (footprints touch, Chebyshev gap = 0).</summary>
    private static bool AreAdjacent(BaronyBattleTokenDTO a, BaronyBattleTokenDTO b)
    {
        int sa = TokenSize(a), sb = TokenSize(b);
        int gx = Math.Max(0, Math.Max(a.X, b.X) - Math.Min(a.X + sa, b.X + sb));
        int gy = Math.Max(0, Math.Max(a.Y, b.Y) - Math.Min(a.Y + sa, b.Y + sb));
        return Math.Max(gx, gy) == 0;
    }

    private bool CanIssueAttackOrder(BaronyBattleTokenDTO token) =>
        CanManageAsMg || (CanEdit && !token.IsEnemy);

    private bool HasAdjacentEnemyTargetOpportunity(BaronyBattleTokenDTO token)
    {
        if (Map is null)
            return false;
        foreach (var other in Map.Tokens)
        {
            if (other.Id == token.Id)
                continue;
            if (other.IsEnemy == token.IsEnemy)
                continue;
            if (other.Hp <= 0)
                continue;
            if (AreAdjacent(token, other))
                return true;
        }
        return false;
    }

    private IEnumerable<BaronyBattleTokenDTO> AdjacentEnemyCandidates(BaronyBattleTokenDTO attacker)
    {
        if (Map is null)
            return Enumerable.Empty<BaronyBattleTokenDTO>();

        return Map.Tokens
            .Where(t => t.Id != attacker.Id)
            .Where(t => t.IsEnemy != attacker.IsEnemy)
            .Where(t => t.Hp > 0)
            .Where(t => AreAdjacent(attacker, t));
    }

    private async Task AutoAssignAttackTargets()
    {
        if (Map is null || !IsAttackPlanningPhase || (!CanEdit && !CanManageAsMg))
            return;

        var assigned = 0;
        var cleared = 0;

        var attackers = Map.Tokens
            .Where(t => t.Hp > 0)
            .Where(CanIssueAttackOrder)
            .OrderByDescending(t => t.InitiativeTotal)
            .ThenBy(t => t.Label)
            .ToList();

        foreach (var attacker in attackers)
        {
            var currentTarget = attacker.AttackTargetId is null
                ? null
                : Map.Tokens.FirstOrDefault(t => t.Id == attacker.AttackTargetId);

            var isCurrentValid = currentTarget is not null
                && currentTarget.Hp > 0
                && currentTarget.IsEnemy != attacker.IsEnemy
                && AreAdjacent(attacker, currentTarget);

            if (isCurrentValid)
                continue;

            if (attacker.AttackTargetId is not null)
            {
                attacker.AttackTargetId = null;
                cleared++;
            }

            var bestTarget = AdjacentEnemyCandidates(attacker)
                .OrderBy(t => t.Hp)
                .ThenByDescending(t => t.InitiativeTotal)
                .ThenBy(t => t.Label)
                .FirstOrDefault();

            if (bestTarget is not null)
            {
                attacker.AttackTargetId = bestTarget.Id;
                assigned++;
            }
        }

        if (assigned == 0 && cleared == 0)
        {
            _snackBar.Add("No attack targets could be auto-assigned.", Severity.Info);
            return;
        }

        await SaveAsync(systemMessage: $"Auto-assign attacks: {assigned} assigned, {cleared} cleared.");
        RefreshRange();
    }

    /// <summary>
    /// Front multiplier = AimBase + ExposureBonus.
    /// Aim: attacker facing toward defender (front 3 / corner 2 / else 1).
    /// Exposure: attacker position vs defender facing (front +0 / corner +1 / side|rear-corner +2 / rear +3).
    /// </summary>
    private readonly record struct FrontBreakdown(int Multiplier, string AimLabel, string ExposureLabel);

    private static FrontBreakdown GetFrontBreakdown(BaronyBattleTokenDTO attacker, BaronyBattleTokenDTO defender)
    {
        var attackerCenterX = attacker.X + TokenSize(attacker) * 0.5;
        var attackerCenterY = attacker.Y + TokenSize(attacker) * 0.5;
        var defenderCenterX = defender.X + TokenSize(defender) * 0.5;
        var defenderCenterY = defender.Y + TokenSize(defender) * 0.5;

        // Exposure: where the attacker stands relative to the defender's front.
        var fromDefenderToAttacker = BaronyBattleFacing.FromScreenVector(
            attackerCenterX - defenderCenterX,
            attackerCenterY - defenderCenterY);
        var exposureDiff = BaronyBattleFacing.CircularDiff(fromDefenderToAttacker, defender.Facing);
        var exposureBonus = exposureDiff switch
        {
            0 => 0, // front
            1 => 1, // corner
            2 => 2, // side
            3 => 2, // rear-corner
            _ => 3, // rear
        };

        // Aim: how the attacker faces toward the defender.
        var fromAttackerToDefender = BaronyBattleFacing.FromScreenVector(
            defenderCenterX - attackerCenterX,
            defenderCenterY - attackerCenterY);
        var aimDiff = BaronyBattleFacing.CircularDiff(fromAttackerToDefender, attacker.Facing);
        var aimBase = aimDiff switch
        {
            0 => 3, // front
            1 => 2, // corner
            _ => 1, // side / rear-corner / rear
        };

        return new FrontBreakdown(
            aimBase + exposureBonus,
            FacingBandLabel(aimDiff),
            FacingBandLabel(exposureDiff));
    }

    private static string FacingBandLabel(int circularDiff) => circularDiff switch
    {
        0 => "Front",
        1 => "Corner",
        2 => "Side",
        3 => "Rear Corner",
        _ => "Rear",
    };

    private sealed record CombatExchangePlan(
        string AttackerId,
        string DefenderId,
        int Dealt,
        int DefDealt,
        bool AttackerFlees,
        bool DefenderFlees,
        IReadOnlyList<string> Notes);

    private List<CombatExchangePlan> PlanCombatExchanges(Random rng)
    {
        var plans = new List<CombatExchangePlan>();
        if (Map is null)
            return plans;

        var orderedIds = Map.TurnState.InitiativeOrder
            .Reverse<string>()
            .Concat(Map.Tokens
                .Where(t => !Map.TurnState.InitiativeOrder.Contains(t.Id))
                .OrderByDescending(t => t.InitiativeTotal)
                .Select(t => t.Id))
            .ToList();

        // Working HP so later exchanges see earlier results without mutating tokens yet.
        var hp = Map.Tokens.ToDictionary(t => t.Id, t => t.Hp, StringComparer.Ordinal);
        var fledIds = new HashSet<string>(StringComparer.Ordinal);

        foreach (var attackerId in orderedIds)
        {
            if (fledIds.Contains(attackerId))
                continue;
            var attacker = Map.Tokens.FirstOrDefault(t => t.Id == attackerId);
            if (attacker is null)
                continue;
            if (!hp.TryGetValue(attacker.Id, out var atkHp) || atkHp <= 0)
                continue;
            if (string.IsNullOrWhiteSpace(attacker.AttackTargetId))
                continue;

            var defender = Map.Tokens.FirstOrDefault(t => t.Id == attacker.AttackTargetId);
            if (defender is null || fledIds.Contains(defender.Id))
                continue;
            if (!hp.TryGetValue(defender.Id, out var defHp) || defHp <= 0)
                continue;
            if (!AreAdjacent(attacker, defender))
                continue;

            var notes = new List<string>();
            var damageDie = rng.Next(1, 5);
            var attackDie = rng.Next(1, 7);
            var defenseDie = rng.Next(1, 7);
            var attackRoll = attacker.Attack + attackDie;
            var defenseRoll = defender.Defense + defenseDie;
            var ratio = attackRoll / (double)Math.Max(1, defenseRoll);
            var front = GetFrontBreakdown(attacker, defender);
            var baseDamage = attacker.Damage + damageDie - defender.Armor;
            var rawDamage = baseDamage * ratio * front.Multiplier;
            var dealt = Math.Max(1, (int)Math.Round(rawDamage, MidpointRounding.AwayFromZero));
            defHp = Math.Max(0, defHp - dealt);
            notes.Add(
                $"{attacker.Label} -> {defender.Label}: " +
                $"(Dmg+k4−Arm={attacker.Damage}+{damageDie}−{defender.Armor}={baseDamage}) " +
                $"× ({attacker.Attack}+k6={attackRoll})/({defender.Defense}+k6={defenseRoll}) " +
                $"×{front.Multiplier} ({front.AimLabel} Vs {front.ExposureLabel}) => {dealt} dmg.");
            notes.Add($"{defender.Label} takes {dealt} damage (HP: {defHp}/{defender.MaxHp}).");

            var defDamageDie = rng.Next(1, 5);
            var defDefDie = rng.Next(1, 7);
            var atkDefDie = rng.Next(1, 7);
            var defDefenseRoll = defender.Defense + defDefDie;
            var atkDefenseRoll = attacker.Defense + atkDefDie;
            var defRatio = defDefenseRoll / (double)Math.Max(1, atkDefenseRoll);
            var defFront = GetFrontBreakdown(defender, attacker);
            var defBaseDamage = defender.Damage + defDamageDie - attacker.Armor;
            var defRaw = defBaseDamage * defRatio * defFront.Multiplier;
            var defDealt = Math.Max(1, (int)Math.Round(defRaw, MidpointRounding.AwayFromZero));
            atkHp = Math.Max(0, atkHp - defDealt);
            notes.Add(
                $"{defender.Label} -> {attacker.Label} (defensive): " +
                $"(Dmg+k4−Arm={defender.Damage}+{defDamageDie}−{attacker.Armor}={defBaseDamage}) " +
                $"× ({defender.Defense}+k6={defDefenseRoll})/({attacker.Defense}+k6={atkDefenseRoll}) " +
                $"×{defFront.Multiplier} ({defFront.AimLabel} Vs {defFront.ExposureLabel}) => {defDealt} dmg.");
            notes.Add($"{attacker.Label} takes {defDealt} defensive damage (HP: {atkHp}/{attacker.MaxHp}).");

            hp[defender.Id] = defHp;
            hp[attacker.Id] = atkHp;
            var defenderFlees = defHp <= 0;
            var attackerFlees = atkHp <= 0;
            if (defenderFlees)
                fledIds.Add(defender.Id);
            if (attackerFlees)
                fledIds.Add(attacker.Id);

            plans.Add(new CombatExchangePlan(
                attacker.Id,
                defender.Id,
                dealt,
                defDealt,
                attackerFlees,
                defenderFlees,
                notes));
        }

        return plans;
    }

    private async Task PlayCombatExchangesAsync(IReadOnlyList<CombatExchangePlan> plans)
    {
        if (Map is null)
            return;

        _isResolvingCombat = true;
        _combatAnimActive = true;
        _combatFocusAttackerId = null;
        _combatFx = null;
        _attackTargetIds = new HashSet<string>();
        StateHasChanged();
        await Task.Delay(120);

        try
        {
            if (plans.Count == 0)
            {
                AppendLocalLog(string.Empty, "combat", "No resolved attacks this round.");
                return;
            }

            foreach (var plan in plans)
            {
                var attacker = Map.Tokens.FirstOrDefault(t => t.Id == plan.AttackerId);
                var defender = Map.Tokens.FirstOrDefault(t => t.Id == plan.DefenderId);
                if (attacker is null || defender is null)
                    continue;

                // 1) Attack arrow + clash icon together
                _combatFocusAttackerId = plan.AttackerId;
                _attackTargetIds = new HashSet<string>(StringComparer.Ordinal) { plan.DefenderId };
                _combatFx = new BattleCombatFx
                {
                    AttackerId = plan.AttackerId,
                    DefenderId = plan.DefenderId,
                    DealtToDefender = plan.Dealt,
                    DealtToAttacker = plan.DefDealt,
                    ShowClash = true,
                    ShowDamage = false,
                };
                StateHasChanged();
                await Task.Delay(CombatClashLeadMs);

                // 2) Floating damage numbers + apply HP (bars update)
                defender.Hp = Math.Max(0, defender.Hp - plan.Dealt);
                attacker.Hp = Math.Max(0, attacker.Hp - plan.DefDealt);
                RecordAllyOutcome(defender, defender.Hp);
                RecordAllyOutcome(attacker, attacker.Hp);

                foreach (var note in plan.Notes)
                    AppendLocalLog(string.Empty, "combat", note);

                _combatFx.ShowDamage = true;
                StateHasChanged();
                await Task.Delay(CombatDamageMs);

                var fledThisExchange = new List<BaronyBattleTokenDTO>();
                if (plan.DefenderFlees && Map.Tokens.Any(t => t.Id == plan.DefenderId))
                {
                    fledThisExchange.Add(defender);
                    AppendLocalLog(string.Empty, "combat", $"{defender.Label} flees the battlefield.");
                }
                if (plan.AttackerFlees && Map.Tokens.Any(t => t.Id == plan.AttackerId))
                {
                    fledThisExchange.Add(attacker);
                    AppendLocalLog(string.Empty, "combat", $"{attacker.Label} flees the battlefield.");
                }

                if (fledThisExchange.Count > 0)
                {
                    var fledIds = fledThisExchange.Select(t => t.Id).ToHashSet(StringComparer.Ordinal);
                    foreach (var fled in fledThisExchange)
                    {
                        RecordAllyOutcome(fled, fledHp: 0);
                        Map.Tokens.Remove(fled);
                    }

                    foreach (var token in Map.Tokens)
                    {
                        if (token.AttackTargetId is not null && fledIds.Contains(token.AttackTargetId))
                            token.AttackTargetId = null;
                    }

                    Map.TurnState.InitiativeOrder = Map.TurnState.InitiativeOrder
                        .Where(id => !fledIds.Contains(id))
                        .ToList();
                }

                _combatFx = null;
                _combatFocusAttackerId = null;
                _attackTargetIds = new HashSet<string>();
                StateHasChanged();
                await Task.Delay(80);
            }
        }
        finally
        {
            _combatFx = null;
            _combatFocusAttackerId = null;
            _combatAnimActive = false;
            _isResolvingCombat = false;
            RebuildPlannedRoutes();
        }
    }

    private void EnsureBattleSubPhase()
    {
        if (Map is null || !IsBattlePhase)
            return;
        if (string.IsNullOrWhiteSpace(Map.TurnState.SubPhase))
            Map.TurnState.SubPhase = BaronyBattleSubPhases.Movement;
        if (Map.TurnState.Round < 1)
            Map.TurnState.Round = 1;
    }

    private async Task BeginBattle()
    {
        if (Map is null || !CanManageAsMg)
            return;
        if (Map.Tokens.Count == 0)
        {
            _snackBar.Add("Place at least one token before beginning.", Severity.Warning);
            return;
        }

        var rng = Random.Shared;
        foreach (var token in Map.Tokens)
        {
            token.InitiativeDie = rng.Next(1, 11);
            token.InitiativeTotal = token.Discipline + token.InitiativeDie;
            token.RemainingMove = token.Move;
            token.ClearPath();
        }

        // Movement orders: lowest initiative first; ties broken randomly.
        var ordered = Map.Tokens
            .OrderBy(t => t.InitiativeTotal)
            .ThenBy(_ => rng.Next())
            .Select(t => t.Id)
            .ToList();

        Map.Phase = BaronyBattlePhases.Battle;
        Map.TurnState = new BaronyBattleTurnStateDTO
        {
            InitiativeOrder = ordered,
            CurrentIndex = 0,
            SubPhase = BaronyBattleSubPhases.Movement,
            Round = 1,
        };
        _tool = "token";
        SnapshotAllyStartHp();

        var lines = Map.Tokens
            .OrderBy(t => t.InitiativeTotal)
            .Select(t => $"{t.Label}: {t.Discipline}+{t.InitiativeDie}={t.InitiativeTotal}");
        AppendLocalLog(string.Empty, "phase",
            PhaseBanner($"Start of Movement Phase {Map.TurnState.Round}"));
        await SaveAsync(systemMessage: "Battle begins — movement phase (low → high initiative). " + string.Join("; ", lines));
        _selectedTokenId = ActiveTokenId;
        RefreshRange();
    }

    private void SnapshotAllyStartHp()
    {
        _allyStartHp.Clear();
        _allyOutcomeHp.Clear();
        if (Map is null)
            return;
        foreach (var token in Map.Tokens)
        {
            if (token.IsEnemy || token.UnitId is not int uid)
                continue;
            _allyStartHp[uid] = token.Hp;
        }
    }

    private void RecordAllyOutcome(BaronyBattleTokenDTO token, int? fledHp = null)
    {
        if (token.IsEnemy || token.UnitId is not int uid)
            return;
        _allyOutcomeHp[uid] = fledHp ?? Math.Max(0, token.Hp);
    }

    private async Task EndBattle()
    {
        if (Map is null || !CanManageAsMg || !IsBattlePhase)
            return;
        if (_isResolvingMovement || _isResolvingCombat)
            return;

        var confirm = await _dialogService.ShowMessageBoxAsync(
            "End battle?",
            "This ends the battle immediately, writes a summary to the log, and syncs baron unit HP to the Army tab — regardless of who is left on the field.",
            yesText: "End battle",
            cancelText: "Cancel");
        if (confirm != true)
            return;

        CancelFacingEdit();
        _isResolvingMovement = false;
        _isResolvingCombat = false;
        _combatAnimActive = false;
        _combatFocusAttackerId = null;
        _combatFx = null;
        _animFrames = new();
        _animTransitionsOn = false;
        _engagedTokenIds = new();
        _attackTargetIds = new();
        _plannedRoutes = new();

        // Capture survivors still on the map.
        foreach (var token in Map.Tokens)
            RecordAllyOutcome(token);

        // If the page was reloaded mid-battle, rebuild a minimal snapshot from survivors.
        if (_allyStartHp.Count == 0 && Map.Tokens.Any(t => !t.IsEnemy && t.UnitId is int))
        {
            try
            {
                var units = await _baronyRepo.GetUnits(BaronyId);
                foreach (var token in Map.Tokens.Where(t => !t.IsEnemy && t.UnitId is int))
                {
                    var uid = token.UnitId!.Value;
                    var armyHp = units.FirstOrDefault(u => u.Id == uid)?.CurrentHp ?? token.MaxHp;
                    _allyStartHp[uid] = armyHp;
                    _allyOutcomeHp[uid] = Math.Max(0, token.Hp);
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not rebuild ally HP snapshot for barony {BaronyId}", BaronyId);
            }
        }

        var summaryLines = await SyncAllyHpToArmyAsync();
        var round = Math.Max(1, Map.TurnState.Round);

        foreach (var token in Map.Tokens)
        {
            token.AttackTargetId = null;
            token.RemainingMove = token.Move;
            token.ClearPath();
        }

        Map.Phase = BaronyBattlePhases.Setup;
        Map.TurnState = new();

        AppendLocalLog(string.Empty, "phase", PhaseBanner($"End of Battle (round {round})"));
        foreach (var line in summaryLines)
            AppendLocalLog(string.Empty, "system", line);

        await SaveAsync(systemMessage: "Battle ended. Ally HP synced to Army.");
        _selectedTokenId = null;
        RefreshRange();
        _snackBar.Add("Battle ended — Army HP updated.", Severity.Success);
    }

    /// <summary>Writes CurrentHp for every ally that entered the battle; returns summary lines.</summary>
    private async Task<List<string>> SyncAllyHpToArmyAsync()
    {
        var lines = new List<string> { "Battle summary — Army HP:" };
        if (_allyStartHp.Count == 0)
        {
            lines.Add("No baron units were deployed.");
            return lines;
        }

        try
        {
            var units = await _baronyRepo.GetUnits(BaronyId);
            foreach (var uid in _allyStartHp.Keys.OrderBy(id => id))
            {
                var unit = units.FirstOrDefault(u => u.Id == uid);
                if (unit is null)
                    continue;

                var startHp = _allyStartHp[uid];
                var endHp = _allyOutcomeHp.TryGetValue(uid, out var outcome)
                    ? outcome
                    : 0; // started battle but gone from map without a record → treated as fled
                endHp = Math.Max(0, endHp);

                var combat = UnitStatHelper.Compute(unit);
                if (combat.MaxHp > 0)
                    endHp = Math.Min(endHp, combat.MaxHp);

                var before = unit.CurrentHp;
                unit.CurrentHp = endHp;
                await _baronyRepo.SaveUnit(unit);

                var local = _activeUnits.FirstOrDefault(u => u.Id == uid);
                if (local is not null)
                    local.CurrentHp = endHp;

                var delta = endHp - startHp;
                var deltaText = delta == 0 ? "±0" : delta > 0 ? $"+{delta}" : $"{delta}";
                var fledNote = endHp <= 0 ? " — fled / broken" : "";
                lines.Add($"{unit.Name}: {startHp} → {endHp} HP ({deltaText}, was {before} in Army){fledNote}.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to sync battle HP to Army for barony {BaronyId}", BaronyId);
            lines.Add("ERROR: failed to sync some HP values to Army — check server logs.");
            _snackBar.Add("Failed to sync some HP values to Army.", Severity.Error);
        }

        _allyStartHp.Clear();
        _allyOutcomeHp.Clear();
        return lines;
    }

    private async Task ReturnToSetup()
    {
        if (Map is null || !CanManageAsMg)
            return;
        // Prefer End battle while fighting so HP is never discarded by accident.
        if (IsBattlePhase)
        {
            await EndBattle();
            return;
        }

        Map.Phase = BaronyBattlePhases.Setup;
        Map.TurnState = new();
        foreach (var t in Map.Tokens)
        {
            t.RemainingMove = t.Move;
            t.ClearPath();
        }
        await SaveAsync(systemMessage: "Returned to setup.");
        RefreshRange();
    }

    private async Task FinishMove()
    {
        if (Map is null || !IsMovementPhase || Map.TurnState.InitiativeOrder.Count == 0)
            return;

        var active = ActiveToken;
        if (active is null)
            return;

        if (!CanControlToken(active))
        {
            _snackBar.Add("Not your order.", Severity.Warning);
            return;
        }

        CancelFacingEdit();

        // Auto-lock provisional tip so Finish move always commits the visible path.
        var provisional = active.ProvisionalWaypoint;
        if (provisional is not null)
            provisional.Locked = true;
        ApplyTravelFacings(active);

        var end = active.PlannedEnd();
        var msg = active.HasPath
            ? $"{active.Label} finished move → {FormatCell(end.X, end.Y)}."
            : $"{active.Label} finished move (staying put).";

        var next = Map.TurnState.CurrentIndex + 1;
        if (next >= Map.TurnState.InitiativeOrder.Count)
        {
            AppendLocalLog(string.Empty, "system", msg);
            await ResolveMovementPhase();
            return;
        }

        Map.TurnState.CurrentIndex = next;
        var nextTok = ActiveToken;
        await SaveAsync(systemMessage: nextTok is null
            ? msg
            : $"{msg} Next: {nextTok.Label}.");
        _selectedTokenId = ActiveTokenId;
        RefreshRange();
    }

    private async Task UndoMoveStep()
    {
        if (Map is null || !IsMovementPhase || _isResolvingMovement)
            return;

        var active = ActiveToken;
        if (active is null || !CanControlToken(active))
            return;

        if (_facingEditTokenId == active.Id)
        {
            CancelFacingEdit();
            return;
        }

        if (!active.HasPath)
        {
            _snackBar.Add("Nothing to undo.", Severity.Info);
            return;
        }

        var removed = active.Path[^1];
        active.Path.RemoveAt(active.Path.Count - 1);
        ApplyTravelFacings(active);

        if (active.HasPath)
        {
            var tip = active.Path[^1];
            active.RemainingMove = tip.RemainingMoveAfter;
        }
        else
        {
            active.RemainingMove = active.Move;
        }

        _selectedTokenId = active.Id;
        await SaveAsync(systemMessage: $"{active.Label} undid step at {FormatCell(removed.X, removed.Y)}.");
        RefreshRange();
    }

    private async Task ResolveMovementPhase()
    {
        if (Map is null || !IsMovementPhase || _isResolvingMovement)
            return;
        if (!CanManageAsMg)
        {
            // Only allowed via FinishMove on the last unit.
            var last = Map.TurnState.CurrentIndex >= Map.TurnState.InitiativeOrder.Count - 1;
            if (!last)
            {
                _snackBar.Add("Only the Game Master can resolve all movement early.", Severity.Warning);
                return;
            }
        }

        _isResolvingMovement = true;
        CancelFacingEdit();
        _selectedTokenId = null;
        _rangeCells = new();
        _animTransitionsOn = false;
        _animFrames = new();

        try
        {
            foreach (var token in Map.Tokens)
            {
                if (!token.HasPath)
                {
                    token.RemainingMove = token.Move;
                    continue;
                }

                while (token.Path.Count > 0 && !token.Path[^1].Locked)
                    token.Path.RemoveAt(token.Path.Count - 1);

                if (!token.HasPath)
                {
                    token.RemainingMove = token.Move;
                    continue;
                }

                ApplyTravelFacings(token);

                var end = token.PlannedEnd();
                if (end.X == token.X && end.Y == token.Y)
                {
                    // Stay put (optional facing change already paid on the tip).
                    token.Facing = token.PlannedFacing();
                    token.RemainingMove = token.LastWaypoint?.RemainingMoveAfter ?? token.RemainingMove;
                    token.ClearPath();
                }
            }

            var collisionNotes = ResolveHostilePathCollisions();

            var movers = new List<(BaronyBattleTokenDTO Token, List<(int X, int Y)> Route, int FinalFacing)>();
            foreach (var token in Map.Tokens.Where(t => t.HasPath))
            {
                var route = BuildCellRoute(token, ignoreUnits: true);
                if (route.Count < 2)
                {
                    // Same-cell / degenerate path — apply planned facing and keep spent move.
                    token.Facing = token.PlannedFacing();
                    token.RemainingMove = token.LastWaypoint?.RemainingMoveAfter ?? token.RemainingMove;
                    token.ClearPath();
                    continue;
                }

                movers.Add((token, route, token.PlannedFacing()));
            }

            if (movers.Count > 0)
            {
                // Publish the exact (post-collision) tile routes so the arrows keep
                // pointing along the real path for the full duration of the animation.
                _plannedRoutes = movers.ToDictionary(m => m.Token.Id, m => m.Route);

                _animFrames = movers.Select(m => new BattleMoveAnimFrame
                {
                    TokenId = m.Token.Id,
                    LeftPx = m.Route[0].X * AnimCellPx,
                    TopPx = m.Route[0].Y * AnimCellPx,
                    Size = TokenSize(m.Token),
                    FacingDeg = BaronyBattleFacing.ToDegrees(m.Token.Facing),
                    TransitionMs = 0,
                }).ToList();
                StateHasChanged();
                await Task.Delay(40);

                _animTransitionsOn = true;
                StateHasChanged();
                await Task.Delay(40);

                // Phase 1: turn each mover to face its first travelled tile step.
                foreach (var frame in _animFrames)
                {
                    var mover = movers.First(m => m.Token.Id == frame.TokenId);
                    if (mover.Route.Count < 2) continue;
                    var travelFacing = BaronyBattleFacing.FromGridStep(
                        mover.Route[0].X, mover.Route[0].Y, mover.Route[1].X, mover.Route[1].Y);
                    frame.FacingDeg = BaronyBattleFacing.ShortestTurnTarget(
                        frame.FacingDeg, BaronyBattleFacing.ToDegrees(travelFacing));
                    frame.TransitionMs = 0;
                }
                StateHasChanged();
                await Task.Delay(AnimTurnMs);

                // Phase 2: cell-by-cell ("rynnowy") march. Each hop advances one tile
                // (orthogonal or diagonal); faster units spend less time per tile.
                var moveEvents = new List<(int AtMs, string TokenId, int Hop)>();
                var maxCellMs = 0;
                foreach (var mover in movers)
                {
                    var cellMs = AnimCellMsFor(mover.Token.Move);
                    if (cellMs > maxCellMs) maxCellMs = cellMs;
                    for (var hop = 1; hop < mover.Route.Count; hop++)
                        moveEvents.Add((hop * cellMs, mover.Token.Id, hop));
                }
                moveEvents.Sort((a, b) =>
                {
                    var c = a.AtMs.CompareTo(b.AtMs);
                    return c != 0 ? c : string.CompareOrdinal(a.TokenId, b.TokenId);
                });

                var elapsedMs = 0;
                foreach (var ev in moveEvents)
                {
                    var wait = ev.AtMs - elapsedMs;
                    if (wait > 0)
                        await Task.Delay(wait);
                    elapsedMs = ev.AtMs;

                    var frame = _animFrames.FirstOrDefault(f => f.TokenId == ev.TokenId);
                    var mover = movers.First(m => m.Token.Id == ev.TokenId);
                    if (frame is null || ev.Hop >= mover.Route.Count)
                        continue;

                    var prev = mover.Route[ev.Hop - 1];
                    var next = mover.Route[ev.Hop];
                    var travelFacing = BaronyBattleFacing.FromGridStep(prev.X, prev.Y, next.X, next.Y);
                    frame.FacingDeg = BaronyBattleFacing.ShortestTurnTarget(
                        frame.FacingDeg, BaronyBattleFacing.ToDegrees(travelFacing));
                    frame.TransitionMs = AnimCellMsFor(mover.Token.Move);
                    frame.LeftPx = next.X * AnimCellPx;
                    frame.TopPx = next.Y * AnimCellPx;
                    StateHasChanged();
                }
                // Wait for the last CSS transition (slowest unit) to fully complete.
                await Task.Delay(maxCellMs + 80);

                var skipFinalTurnAfterCollision = _engagedTokenIds.Count > 0;
                var animatedFacingByToken = _animFrames.ToDictionary(
                    f => f.TokenId,
                    f => BaronyBattleFacing.SnapFromDegrees(f.FacingDeg));

                // Phase 3: settle on planned end facing (manual facing / combat face),
                // unless a collision happened (then no one rotates after impact).
                if (!skipFinalTurnAfterCollision)
                {
                    var needsFinalTurn = false;
                    foreach (var frame in _animFrames)
                    {
                        var mover = movers.First(m => m.Token.Id == frame.TokenId);
                        var target = BaronyBattleFacing.ToDegrees(mover.FinalFacing);
                        var nextDeg = BaronyBattleFacing.ShortestTurnTarget(frame.FacingDeg, target);
                        if (Math.Abs(nextDeg - frame.FacingDeg) > 0.5)
                        {
                            frame.FacingDeg = nextDeg;
                            needsFinalTurn = true;
                        }
                    }
                    if (needsFinalTurn)
                    {
                        StateHasChanged();
                        await Task.Delay(AnimTurnMs);
                    }
                    else
                    {
                        await Task.Delay(80);
                    }
                }
                else
                {
                    await Task.Delay(80);
                }

                foreach (var (token, _, finalFacing) in movers)
                {
                    if (skipFinalTurnAfterCollision && animatedFacingByToken.TryGetValue(token.Id, out var facingFromAnim))
                        token.Facing = facingFromAnim;
                    else
                        token.Facing = finalFacing;
                }
            }

            _animFrames = new();
            _animTransitionsOn = false;
            _plannedRoutes = new();

            var moved = 0;
            foreach (var (token, _, _) in movers)
            {
                var end = token.PlannedEnd();
                token.X = end.X;
                token.Y = end.Y;
                token.RemainingMove = token.Path.Count > 0 ? token.Path[^1].RemainingMoveAfter : 0;
                token.ClearPath();
                moved++;
            }

            Map.TurnState.SubPhase = BaronyBattleSubPhases.AttackPlanning;
            Map.TurnState.CurrentIndex = 0;

            var round = Math.Max(1, Map.TurnState.Round);
            foreach (var note in collisionNotes)
                AppendLocalLog(string.Empty, "collision", note);

            AppendLocalLog(string.Empty, "phase",
                PhaseBanner($"End of Movement Phase {round}"));
            AppendLocalLog(string.Empty, "phase",
                PhaseBanner($"Start of Attack Planning Phase {round}"));

            var summary = moved > 0
                ? $"Movement resolved — {moved} unit(s) moved. Attack planning phase."
                : "Movement resolved — no units moved. Attack planning phase.";
            await SaveAsync(systemMessage: summary);
            _selectedTokenId = null;
            RefreshRange();
        }
        finally
        {
            _animFrames = new();
            _animTransitionsOn = false;
            _isResolvingMovement = false;
        }
    }

    /// <summary>
    /// Hostile units whose footprints overlap in wall-clock time (same scale as march animation) stop and drop the rest of the route.
    /// </summary>
    private List<string> ResolveHostilePathCollisions()
    {
        var notes = new List<string>();
        if (Map is null)
        {
            _engagedTokenIds = new();
            return notes;
        }

        var engagedTokenIds = new HashSet<string>();

        // Each hostile pair is resolved at most once to prevent re-detection of the rest position.
        var resolvedPairs = new HashSet<(string, string)>();

        for (var guard = 0; guard < 32; guard++)
        {
            var timelines = Map.Tokens.Select(t =>
            {
                var cells = t.HasPath
                    ? BuildCellRoute(t, ignoreUnits: true)
                    : new List<(int X, int Y)> { (t.X, t.Y) };
                if (cells.Count == 0)
                    cells.Add((t.X, t.Y));
                return (
                    Token: t,
                    Cells: cells,
                    CellMs: AnimCellMsFor(t.Move),
                    Moving: t.HasPath && cells.Count > 1);
            }).ToList();

            static void OccupyWindow(bool moving, int idx, int cellCount, int cellMs, out long t0, out long t1)
            {
                const long hold = long.MaxValue / 4;
                if (!moving)
                {
                    t0 = 0;
                    t1 = hold;
                    return;
                }

                t0 = (long)idx * cellMs;
                t1 = idx + 1 < cellCount ? t0 + cellMs : hold;
            }

            bool SweptThreatOverlap(
                (int X, int Y) aFrom, (int X, int Y) aTo, int aSize,
                (int X, int Y) bFrom, (int X, int Y) bTo, int bSize,
                long aT0, int aCellMs, long bT0, int bCellMs,
                out int hitMs)
            {
                hitMs = 0;
                var start = Math.Max(aT0, bT0);
                var end = Math.Min(aT0 + aCellMs, bT0 + bCellMs);
                if (end <= start)
                    return false;

                var a0x = aFrom.X + aSize * 0.5;
                var a0y = aFrom.Y + aSize * 0.5;
                var a1x = aTo.X + aSize * 0.5;
                var a1y = aTo.Y + aSize * 0.5;

                var b0x = bFrom.X + bSize * 0.5;
                var b0y = bFrom.Y + bSize * 0.5;
                var b1x = bTo.X + bSize * 0.5;
                var b1y = bTo.Y + bSize * 0.5;

                var avx = (a1x - a0x) / aCellMs;
                var avy = (a1y - a0y) / aCellMs;
                var bvx = (b1x - b0x) / bCellMs;
                var bvy = (b1y - b0y) / bCellMs;

                var dtA = start - aT0;
                var dtB = start - bT0;
                var axS = a0x + avx * dtA;
                var ayS = a0y + avy * dtA;
                var bxS = b0x + bvx * dtB;
                var byS = b0y + bvy * dtB;

                var rx = axS - bxS;
                var ry = ayS - byS;
                var rvx = avx - bvx;
                var rvy = avy - bvy;

                var span = (double)(end - start);
                var rv2 = rvx * rvx + rvy * rvy;
                var tau = 0.0;
                if (rv2 > 1e-12)
                {
                    tau = -(rx * rvx + ry * rvy) / rv2;
                    tau = Math.Clamp(tau, 0.0, span);
                }

                var dx = rx + rvx * tau;
                var dy = ry + rvy * tau;
                var combined = TokenThreatFactor * (aSize + bSize) * 0.5;
                if (dx * dx + dy * dy >= combined * combined)
                    return false;

                hitMs = (int)Math.Round(start + tau);
                return true;
            }

            (int HitMs, int IdxA, int IdxB, BaronyBattleTokenDTO A, BaronyBattleTokenDTO B)? hit = null;

            for (var i = 0; i < timelines.Count; i++)
            for (var j = i + 1; j < timelines.Count; j++)
            {
                var a = timelines[i];
                var b = timelines[j];
                if (a.Token.IsEnemy == b.Token.IsEnemy)
                    continue;
                if (!a.Moving && !b.Moving)
                    continue;
                var pairKey = string.CompareOrdinal(a.Token.Id, b.Token.Id) < 0
                    ? (a.Token.Id, b.Token.Id) : (b.Token.Id, a.Token.Id);
                if (resolvedPairs.Contains(pairKey))
                    continue;

                int aSize = TokenSize(a.Token);
                int bSize = TokenSize(b.Token);
                for (var ia = 0; ia < a.Cells.Count; ia++)
                for (var ib = 0; ib < b.Cells.Count; ib++)
                {
                    var pa = a.Cells[ia];
                    var pb = b.Cells[ib];

                    // Landing/occupation overlap (skip both-at-start to avoid false positives).
                    if (!(ia == 0 && ib == 0) && ThreatOverlap(pa.X, pa.Y, aSize, pb.X, pb.Y, bSize))
                    {
                        OccupyWindow(a.Moving, ia, a.Cells.Count, a.CellMs, out var a0, out var a1);
                        OccupyWindow(b.Moving, ib, b.Cells.Count, b.CellMs, out var b0, out var b1);
                        if (a0 < b1 && b0 < a1)
                        {
                            var tHit = (int)Math.Max(a0, b0);
                            if (hit is null || tHit < hit.Value.HitMs)
                                hit = (tHit, ia, ib, a.Token, b.Token);
                        }
                    }

                    // Crossing / pass-through on the segment itself (includes diagonal cross).
                    if (ia + 1 < a.Cells.Count && ib + 1 < b.Cells.Count)
                    {
                        var aNext = a.Cells[ia + 1];
                        var bNext = b.Cells[ib + 1];
                        if (SweptThreatOverlap(
                            pa, aNext, aSize,
                            pb, bNext, bSize,
                            (long)ia * a.CellMs, a.CellMs,
                            (long)ib * b.CellMs, b.CellMs,
                            out var tHit))
                        {
                            if (hit is null || tHit < hit.Value.HitMs)
                                hit = (tHit, ia, ib, a.Token, b.Token);
                        }
                    }
                }
            }

            if (hit is null)
                break;

            var (_, idxA, idxB, tokA, tokB) = hit.Value;
            var entryA = timelines.First(x => x.Token.Id == tokA.Id);
            var entryB = timelines.First(x => x.Token.Id == tokB.Id);
            var cellsA = entryA.Cells;
            var cellsB = entryB.Cells;
            var meetA = cellsA[idxA];
            var meetB = cellsB[idxB];
            var prevA = idxA > 0 ? cellsA[idxA - 1] : cellsA[0];
            var prevB = idxB > 0 ? cellsB[idxB - 1] : cellsB[0];

            var aHigher = tokA.InitiativeTotal > tokB.InitiativeTotal
                || (tokA.InitiativeTotal == tokB.InitiativeTotal && tokA.InitiativeDie >= tokB.InitiativeDie);

            (int X, int Y) stopA = meetA;
            (int X, int Y) stopB = meetB;

            // Same meeting tile: higher initiative stays on the previous tile.
            if (meetA.X == meetB.X && meetA.Y == meetB.Y && entryA.Moving && entryB.Moving)
            {
                if (aHigher)
                {
                    stopA = prevA;
                    stopB = meetB;
                }
                else
                {
                    stopB = prevB;
                    stopA = meetA;
                }

                // If the higher unit has no prior tile, push the lower one back instead.
                if (stopA.X == stopB.X && stopA.Y == stopB.Y)
                {
                    if (aHigher && (prevB.X != meetB.X || prevB.Y != meetB.Y))
                        stopB = prevB;
                    else if (!aHigher && (prevA.X != meetA.X || prevA.Y != meetA.Y))
                        stopA = prevA;
                }
            }
            else if (FootprintsOverlap(meetA.X, meetA.Y, TokenSize(tokA), meetB.X, meetB.Y, TokenSize(tokB))
                     && entryA.Moving && entryB.Moving)
            {
                // Large footprints overlapping on adjacent anchors — pull higher init back one step.
                if (aHigher)
                    stopA = prevA;
                else
                    stopB = prevB;
            }

            if (entryA.Moving)
                TruncatePathForCollision(tokA, stopA);
            if (entryB.Moving)
                TruncatePathForCollision(tokB, stopB);

            engagedTokenIds.Add(tokA.Id);
            engagedTokenIds.Add(tokB.Id);

            var resolvedKey = string.CompareOrdinal(tokA.Id, tokB.Id) < 0
                ? (tokA.Id, tokB.Id) : (tokB.Id, tokA.Id);
            resolvedPairs.Add(resolvedKey);
            var meetDesc = (meetA.X == meetB.X && meetA.Y == meetB.Y)
                ? FormatCell(meetA.X, meetA.Y)
                : $"{FormatCell(meetA.X, meetA.Y)}/{FormatCell(meetB.X, meetB.Y)}";
            notes.Add($"Collision: {tokA.Label} ↔ {tokB.Label} at {meetDesc}.");
        }

        _engagedTokenIds = engagedTokenIds;
        return notes;
    }

    private static void TruncatePathForCollision(
        BaronyBattleTokenDTO token, (int X, int Y) stop)
    {
        var face = BaronyBattleFacing.Clamp(token.Facing);

        token.ClearPath();
        token.RemainingMove = 0;
        if (stop.X == token.X && stop.Y == token.Y)
        {
            token.Facing = face;
            return;
        }

        token.Path.Add(new BaronyBattleWaypointDTO
        {
            X = stop.X,
            Y = stop.Y,
            Locked = true,
            Facing = face,
            RemainingMoveAfter = 0,
            FacingCostPaid = 0,
        });
    }

    private List<(int X, int Y)> BuildCellRoute(BaronyBattleTokenDTO token, bool ignoreUnits = false)
    {
        var anchors = new List<(int X, int Y)> { (token.X, token.Y) };
        foreach (var wp in token.Path)
            anchors.Add((wp.X, wp.Y));

        var cells = new List<(int X, int Y)> { anchors[0] };
        for (var i = 0; i < anchors.Count - 1; i++)
        {
            var from = anchors[i];
            var to = anchors[i + 1];
            if (from.X == to.X && from.Y == to.Y)
                continue;

            var budget = Math.Max(token.Move * 2, Math.Abs(to.X - from.X) + Math.Abs(to.Y - from.Y) + 8);
            var segment = FindAnchorPath(token, from.X, from.Y, to.X, to.Y, budget, ignoreUnits);
            if (segment is null || segment.Count == 0)
            {
                cells.Add(to);
                continue;
            }

            for (var s = 1; s < segment.Count; s++)
                cells.Add(segment[s]);
        }

        return cells;
    }

    private static bool FootprintsOverlap(int ax, int ay, int aSize, int bx, int by, int bSize) =>
        ax < bx + bSize && ax + aSize > bx && ay < by + bSize && ay + aSize > by;

    private static bool ThreatOverlap(int ax, int ay, int aSize, int bx, int by, int bSize)
    {
        var dx = (ax + aSize * 0.5) - (bx + bSize * 0.5);
        var dy = (ay + aSize * 0.5) - (by + bSize * 0.5);
        var combined = TokenThreatFactor * (aSize + bSize) * 0.5;
        return dx * dx + dy * dy < combined * combined;
    }

    /// <summary>
    /// Unpaid waypoints face the next path segment; the tip faces along its incoming segment.
    /// </summary>
    private static void ApplyTravelFacings(BaronyBattleTokenDTO token)
    {
        if (token.Path.Count == 0)
            return;

        var points = new List<(int X, int Y)> { (token.X, token.Y) };
        foreach (var wp in token.Path)
            points.Add((wp.X, wp.Y));

        for (var i = 0; i < token.Path.Count; i++)
        {
            var wp = token.Path[i];
            if (wp.FacingCostPaid > 0)
                continue;

            var here = points[i + 1];
            if (i + 1 < token.Path.Count)
            {
                var next = points[i + 2];
                wp.Facing = BaronyBattleFacing.FromGridStep(here.X, here.Y, next.X, next.Y);
            }
            else
            {
                var prev = points[i];
                if (prev.X == here.X && prev.Y == here.Y)
                    continue; // in-place tip — keep Facing as set by the player
                wp.Facing = BaronyBattleFacing.FromGridStep(prev.X, prev.Y, here.X, here.Y);
            }
        }
    }

    private async Task AdvanceToCombat()
    {
        if (Map is null || !IsAttackPlanningPhase || (!CanEdit && !CanManageAsMg) || _isResolvingCombat)
            return;

        var missingOrders = Map.Tokens
            .Where(t => t.Hp > 0)
            .Where(CanIssueAttackOrder)
            .Where(t => string.IsNullOrWhiteSpace(t.AttackTargetId))
            .Where(HasAdjacentEnemyTargetOpportunity)
            .ToList();

        if (missingOrders.Count > 0)
        {
            var sample = string.Join(", ", missingOrders.Take(6).Select(t => t.Label));
            var suffix = missingOrders.Count > 6 ? " ..." : string.Empty;
            var proceed = await _dialogService.ShowMessageBoxAsync(
                "Unassigned attacks",
                $"Not every unit with an attack opportunity has a target: {sample}{suffix}. End attack planning anyway?",
                yesText: "Yes, begin combat",
                cancelText: "Go back");
            if (proceed != true)
                return;
        }

        var round = Math.Max(1, Map.TurnState.Round);
        Map.TurnState.SubPhase = BaronyBattleSubPhases.Combat;
        AppendLocalLog(string.Empty, "phase",
            PhaseBanner($"End of Attack Planning Phase {round}"));
        AppendLocalLog(string.Empty, "phase",
            PhaseBanner($"Start of Combat Phase {round}"));

        var plans = PlanCombatExchanges(Random.Shared);
        await PlayCombatExchangesAsync(plans);

        await SaveAsync(systemMessage: $"Attack planning done — round {round} combat begins and attacks are resolved.");
        _selectedTokenId = null;
        RefreshRange();
    }

    private async Task EndCombatPhase()
    {
        if (Map is null || !IsCombatPhase || !CanManageAsMg)
            return;

        foreach (var token in Map.Tokens)
        {
            token.AttackTargetId = null;
            token.RemainingMove = token.Move;
            token.ClearPath();
        }

        var endedCombatRound = Math.Max(1, Map.TurnState.Round);
        AppendLocalLog(string.Empty, "phase",
            PhaseBanner($"End of Combat Phase {endedCombatRound}"));

        Map.TurnState.SubPhase = BaronyBattleSubPhases.Movement;
        Map.TurnState.CurrentIndex = 0;
        Map.TurnState.Round = endedCombatRound + 1;
        AppendLocalLog(string.Empty, "phase",
            PhaseBanner($"Start of Movement Phase {Map.TurnState.Round}"));
        await SaveAsync(systemMessage: $"Round {Map.TurnState.Round} — movement phase (low → high initiative).");
        _selectedTokenId = ActiveTokenId;
        RefreshRange();
    }

    private async Task ClearMap()
    {
        if (Map is null || !CanManageAsMg)
            return;

        var confirm = await _dialogService.ShowMessageBoxAsync(
            "Clear map?",
            "This will remove all painted terrain, text, and tokens, and return the battle to setup. This cannot be undone.",
            yesText: "Clear map",
            cancelText: "Cancel");

        if (confirm != true)
            return;

        Map.Cells.Clear();
        Map.Tokens.Clear();
        Map.Phase = BaronyBattlePhases.Setup;
        Map.TurnState = new();
        _selectedTokenId = null;
        await SaveAsync(systemMessage: "Map cleared.");
        RefreshRange();
    }

    private async Task SendChat()
    {
        if (Map is null || string.IsNullOrWhiteSpace(_chatDraft))
            return;
        var author = CanManageAsMg ? "MG" : "Baron";
        AppendLocalLog(author, "chat", _chatDraft.Trim());
        _chatDraft = string.Empty;
        await SaveAsync();
    }

    private async Task OnChatKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SendChat();
    }

    private static string PhaseBanner(string text) => $"=== {text} ===";

    private void RememberUnitNames()
    {
        if (Map is null)
            return;
        foreach (var token in Map.Tokens)
        {
            if (!string.IsNullOrWhiteSpace(token.Label))
                _unitNameIsEnemy[token.Label] = token.IsEnemy;
        }
        foreach (var unit in _activeUnits)
        {
            if (!string.IsNullOrWhiteSpace(unit.Name))
                _unitNameIsEnemy[unit.Name] = false;
        }
    }

    private MarkupString FormatLogText(string? text)
    {
        if (string.IsNullOrEmpty(text))
            return new MarkupString(string.Empty);

        var html = System.Net.WebUtility.HtmlEncode(text);
        foreach (var (label, isEnemy) in _unitNameIsEnemy
                     .OrderByDescending(kv => kv.Key.Length))
        {
            if (string.IsNullOrWhiteSpace(label))
                continue;
            var enc = System.Net.WebUtility.HtmlEncode(label);
            var cls = isEnemy ? "bbm-name--enemy" : "bbm-name--ally";
            html = html.Replace(enc, $"<span class=\"{cls}\">{enc}</span>", StringComparison.Ordinal);
        }

        return new MarkupString(html);
    }

    private void AppendLocalLog(string author, string kind, string text)
    {
        RememberUnitNames();
        if (Map is null)
            return;
        Map.Log.Add(new BaronyBattleLogEntryDTO
        {
            Id = Guid.NewGuid().ToString("N"),
            Utc = DateTime.UtcNow,
            Author = author,
            Kind = kind,
            Text = text,
        });
        if (Map.Log.Count > 200)
            Map.Log.RemoveRange(0, Map.Log.Count - 200);
    }

    private async Task SaveAsync(string? systemMessage = null)
    {
        if (Map is null)
            return;
        if (!string.IsNullOrWhiteSpace(systemMessage))
            AppendLocalLog(string.Empty, "system", systemMessage);
        try
        {
            Map = await _battleMapRepo.Update(Map);
            if (_hubConnection is not null && _hubConnection.State == HubConnectionState.Connected)
                await _hubConnection.SendAsync("NotifyBaronyBattleMapUpdated", BaronyId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save barony battle map");
            _snackBar.Add("Failed to save battle map.", Severity.Error);
        }
    }

    private void RefreshRange()
    {
        RememberUnitNames();
        RebuildPlannedRoutes();
        _rangeCells = new();
        if (Map is null || _selectedTokenId is null)
            return;
        var token = Map.Tokens.FirstOrDefault(t => t.Id == _selectedTokenId);
        if (token is null)
            return;

        if (IsMovementPhase)
        {
            if (ActiveTokenId != token.Id)
                return;
            var (fx, fy, budget) = GetPlanOrigin(token);
            if (budget <= 0)
                return;
            _rangeCells = ComputeReachableFrom(token, fx, fy, budget);
        }
        else if (IsAttackPlanningPhase)
        {
            // Highlight all cells occupied by adjacent opposing tokens
            var attacker = Map.Tokens.FirstOrDefault(t => t.Id == _selectedTokenId);
            if (attacker is null) return;
            foreach (var opponent in Map.Tokens.Where(t => t.IsEnemy != attacker.IsEnemy))
            {
                if (!AreAdjacent(attacker, opponent)) continue;
                int s = TokenSize(opponent);
                for (int dx = 0; dx < s; dx++)
                    for (int dy = 0; dy < s; dy++)
                        _rangeCells.Add((opponent.X + dx, opponent.Y + dy));
            }
        }
        else if (IsSetupPhase && !token.IsEnemy)
        {
            // Setup: show deploy cells as soft hint when selected
            foreach (var c in Map.Cells.Where(c => c.Terrain == BaronyBattleTerrain.Deploy))
                _rangeCells.Add((c.X, c.Y));
        }
    }

    /// <summary>Recomputes the exact tile routes for every token that has a planned path.</summary>
    private void RebuildPlannedRoutes()
    {
        _attackTargetIds = Map?.Tokens
            .Where(t => t.AttackTargetId is not null)
            .Select(t => t.AttackTargetId!)
            .ToHashSet() ?? new();

        var routes = new Dictionary<string, List<(int X, int Y)>>();
        if (Map is not null)
        {
            foreach (var t in Map.Tokens.Where(t => t.HasPath))
            {
                var route = BuildCellRoute(t, ignoreUnits: true);
                if (route.Count > 1)
                    routes[t.Id] = route;
            }
        }
        _plannedRoutes = routes;
    }

    // --- Grid helpers (forked pathfinding) ---

    private BaronyBattleCellDTO? GetCell(int x, int y) =>
        Map?.Cells.FirstOrDefault(c => c.X == x && c.Y == y);

    private string GetCellText(int x, int y) => GetCell(x, y)?.Text ?? string.Empty;

    private BaronyBattleCellDTO GetOrAddCell(int x, int y)
    {
        var cell = GetCell(x, y);
        if (cell is null)
        {
            cell = new BaronyBattleCellDTO { X = x, Y = y };
            Map!.Cells.Add(cell);
        }
        return cell;
    }

    private void CleanupCell(BaronyBattleCellDTO cell)
    {
        if (string.IsNullOrWhiteSpace(cell.Color)
            && string.IsNullOrWhiteSpace(cell.Text)
            && string.IsNullOrWhiteSpace(cell.TextColor)
            && string.IsNullOrWhiteSpace(cell.Terrain))
            Map!.Cells.Remove(cell);
    }

    private static int TokenSize(BaronyBattleTokenDTO token) => Math.Clamp(token.Size <= 0 ? 1 : token.Size, 1, 3);

    private BaronyBattleTokenDTO? GetTokenAt(int x, int y) =>
        Map?.Tokens.FirstOrDefault(t =>
        {
            int s = TokenSize(t);
            return x >= t.X && x < t.X + s && y >= t.Y && y < t.Y + s;
        });

    private bool IsDeployCell(int x, int y) =>
        GetCell(x, y)?.Terrain == BaronyBattleTerrain.Deploy;

    private bool IsDeployFootprint(int ax, int ay, int size)
    {
        for (int dx = 0; dx < size; dx++)
            for (int dy = 0; dy < size; dy++)
                if (!IsDeployCell(ax + dx, ay + dy))
                    return false;
        return true;
    }

    private bool CanPlace(int x, int y, int size, string? ignoreTokenId = null)
    {
        if (Map is null || x < 0 || y < 0 || x + size > Map.Width || y + size > Map.Height)
            return false;
        foreach (var other in Map.Tokens)
        {
            if (other.Id == ignoreTokenId)
                continue;
            int os = TokenSize(other);
            bool overlaps = x < other.X + os && x + size > other.X
                         && y < other.Y + os && y + size > other.Y;
            if (overlaps)
                return false;
        }
        return true;
    }

    /// <summary>
    /// Waypoint may not overlap another unit's current footprint or another unit's planned end.
    /// </summary>
    private bool CanPlaceWaypoint(BaronyBattleTokenDTO mover, int x, int y)
    {
        if (Map is null)
            return false;
        int size = TokenSize(mover);
        if (x < 0 || y < 0 || x + size > Map.Width || y + size > Map.Height)
            return false;

        for (int dx = 0; dx < size; dx++)
            for (int dy = 0; dy < size; dy++)
                if (GetCell(x + dx, y + dy)?.Terrain == BaronyBattleTerrain.Impassable)
                    return false;

        foreach (var other in Map.Tokens)
        {
            if (other.Id == mover.Id)
                continue;
            int os = TokenSize(other);
            bool overlapsCurrent = x < other.X + os && x + size > other.X
                                && y < other.Y + os && y + size > other.Y;
            if (overlapsCurrent)
                return false;

            if (other.HasPath)
            {
                var end = other.PlannedEnd();
                bool overlapsDest = x < end.X + os && x + size > end.X
                                 && y < end.Y + os && y + size > end.Y;
                if (overlapsDest)
                    return false;
            }
        }

        return true;
    }

    private bool IsBlockedFor(BaronyBattleTokenDTO mover, int x, int y)
    {
        if (GetCell(x, y)?.Terrain == BaronyBattleTerrain.Impassable)
            return true;
        var occupant = GetTokenAt(x, y);
        if (occupant is not null && occupant.Id != mover.Id && occupant.IsEnemy != mover.IsEnemy)
            return true;
        return false;
    }

    private bool IsFootprintBlocked(BaronyBattleTokenDTO mover, int ax, int ay, int size, bool ignoreUnits = false)
    {
        if (Map is null || ax < 0 || ay < 0 || ax + size > Map.Width || ay + size > Map.Height)
            return true;
        for (int dx = 0; dx < size; dx++)
        {
            for (int dy = 0; dy < size; dy++)
            {
                if (ignoreUnits)
                {
                    if (GetCell(ax + dx, ay + dy)?.Terrain == BaronyBattleTerrain.Impassable)
                        return true;
                }
                else if (IsBlockedFor(mover, ax + dx, ay + dy))
                {
                    return true;
                }
            }
        }
        return false;
    }

    private bool FootprintEntersDifficult(int oldX, int oldY, int newX, int newY, int size)
    {
        for (int dx = 0; dx < size; dx++)
        {
            for (int dy = 0; dy < size; dy++)
            {
                int cx = newX + dx;
                int cy = newY + dy;
                bool wasInside = cx >= oldX && cx < oldX + size && cy >= oldY && cy < oldY + size;
                if (!wasInside && GetCell(cx, cy)?.Terrain == BaronyBattleTerrain.Difficult)
                    return true;
            }
        }
        return false;
    }

    private HashSet<(int X, int Y)> ComputeReachableAnchorsFrom(
        BaronyBattleTokenDTO mover, int fromX, int fromY, int range)
    {
        var anchors = new HashSet<(int, int)>();
        if (Map is null || range <= 0)
            return anchors;

        int size = TokenSize(mover);
        int budget = range * 2 + 1;
        int w = Map.Width;
        int h = Map.Height;
        var dist = new int[w, h];
        for (int i = 0; i < w; i++)
            for (int j = 0; j < h; j++)
                dist[i, j] = int.MaxValue;

        dist[fromX, fromY] = 0;
        var queue = new PriorityQueue<(int X, int Y), int>();
        queue.Enqueue((fromX, fromY), 0);

        while (queue.Count > 0)
        {
            var (cx, cy) = queue.Dequeue();
            int baseCost = dist[cx, cy];
            for (int dx = -1; dx <= 1; dx++)
            {
                for (int dy = -1; dy <= 1; dy++)
                {
                    if (dx == 0 && dy == 0) continue;
                    int nx = cx + dx;
                    int ny = cy + dy;
                    if (IsFootprintBlocked(mover, nx, ny, size))
                        continue;
                    int stepCost = (dx != 0 && dy != 0) ? 3 : 2;
                    if (FootprintEntersDifficult(cx, cy, nx, ny, size))
                        stepCost *= 2;
                    int newCost = baseCost + stepCost;
                    if (newCost > budget) continue;
                    if (newCost < dist[nx, ny])
                    {
                        dist[nx, ny] = newCost;
                        queue.Enqueue((nx, ny), newCost);
                    }
                }
            }
        }

        for (int i = 0; i < w; i++)
        {
            for (int j = 0; j < h; j++)
            {
                if (dist[i, j] == int.MaxValue) continue;
                if (dist[i, j] / 2 > range) continue;
                if (IsMovementPhase)
                {
                    if (!CanPlaceWaypoint(mover, i, j) && !(i == fromX && j == fromY))
                        continue;
                }
                else if (!CanPlace(i, j, size, mover.Id))
                {
                    continue;
                }
                anchors.Add((i, j));
            }
        }
        return anchors;
    }

    private HashSet<(int X, int Y)> ComputeReachableFrom(
        BaronyBattleTokenDTO mover, int fromX, int fromY, int range)
    {
        var result = new HashSet<(int, int)>();
        int size = TokenSize(mover);
        foreach (var (ax, ay) in ComputeReachableAnchorsFrom(mover, fromX, fromY, range))
        {
            for (int dx = 0; dx < size; dx++)
                for (int dy = 0; dy < size; dy++)
                    result.Add((ax + dx, ay + dy));
        }
        return result;
    }

    private List<(int X, int Y)>? FindAnchorPath(
        BaronyBattleTokenDTO mover, int fromX, int fromY, int targetX, int targetY, int range,
        bool ignoreUnits = false)
    {
        if (fromX == targetX && fromY == targetY)
            return new List<(int X, int Y)> { (fromX, fromY) };
        if (Map is null || range <= 0)
            return null;

        int size = TokenSize(mover);
        int budget = range * 2 + 1;
        int w = Map.Width;
        int h = Map.Height;
        var dist = new int[w, h];
        var prevX = new int[w, h];
        var prevY = new int[w, h];
        for (int i = 0; i < w; i++)
        for (int j = 0; j < h; j++)
        {
            dist[i, j] = int.MaxValue;
            prevX[i, j] = -1;
            prevY[i, j] = -1;
        }

        dist[fromX, fromY] = 0;
        var queue = new PriorityQueue<(int X, int Y), int>();
        queue.Enqueue((fromX, fromY), 0);
        while (queue.Count > 0)
        {
            var (cx, cy) = queue.Dequeue();
            if (cx == targetX && cy == targetY)
                break;
            int baseCost = dist[cx, cy];
            if (baseCost == int.MaxValue)
                continue;
            for (int dx = -1; dx <= 1; dx++)
            for (int dy = -1; dy <= 1; dy++)
            {
                if (dx == 0 && dy == 0) continue;
                int nx = cx + dx, ny = cy + dy;
                if (IsFootprintBlocked(mover, nx, ny, size, ignoreUnits)) continue;
                int stepCost = (dx != 0 && dy != 0) ? 3 : 2;
                if (FootprintEntersDifficult(cx, cy, nx, ny, size)) stepCost *= 2;
                int newCost = baseCost + stepCost;
                if (newCost > budget) continue;
                if (newCost < dist[nx, ny])
                {
                    dist[nx, ny] = newCost;
                    prevX[nx, ny] = cx;
                    prevY[nx, ny] = cy;
                    queue.Enqueue((nx, ny), newCost);
                }
            }
        }

        if (dist[targetX, targetY] == int.MaxValue)
            return null;

        var path = new List<(int X, int Y)>();
        int x = targetX, y = targetY;
        while (!(x == fromX && y == fromY))
        {
            path.Add((x, y));
            var px = prevX[x, y];
            var py = prevY[x, y];
            if (px < 0 || py < 0)
                return null;
            x = px;
            y = py;
        }
        path.Add((fromX, fromY));
        path.Reverse();
        return path;
    }

    private int EstimateMoveCostFrom(
        BaronyBattleTokenDTO mover, int fromX, int fromY, int targetX, int targetY, int range)
    {
        if (fromX == targetX && fromY == targetY)
            return 0;
        if (Map is null || range <= 0)
            return -1;

        int size = TokenSize(mover);
        int budget = range * 2 + 1;
        int w = Map.Width;
        int h = Map.Height;
        var dist = new int[w, h];
        for (int i = 0; i < w; i++)
            for (int j = 0; j < h; j++)
                dist[i, j] = int.MaxValue;
        dist[fromX, fromY] = 0;
        var queue = new PriorityQueue<(int X, int Y), int>();
        queue.Enqueue((fromX, fromY), 0);
        while (queue.Count > 0)
        {
            var (cx, cy) = queue.Dequeue();
            if (cx == targetX && cy == targetY)
                break;
            int baseCost = dist[cx, cy];
            for (int dx = -1; dx <= 1; dx++)
            for (int dy = -1; dy <= 1; dy++)
            {
                if (dx == 0 && dy == 0) continue;
                int nx = cx + dx, ny = cy + dy;
                if (IsFootprintBlocked(mover, nx, ny, size)) continue;
                int stepCost = (dx != 0 && dy != 0) ? 3 : 2;
                if (FootprintEntersDifficult(cx, cy, nx, ny, size)) stepCost *= 2;
                int newCost = baseCost + stepCost;
                if (newCost > budget) continue;
                if (newCost < dist[nx, ny])
                {
                    dist[nx, ny] = newCost;
                    queue.Enqueue((nx, ny), newCost);
                }
            }
        }
        if (dist[targetX, targetY] == int.MaxValue)
            return -1;
        return dist[targetX, targetY] / 2;
    }

    private static char ColumnLetter(int x) => (char)('A' + x);
    private static string FormatCell(int x, int y) => $"{ColumnLetter(x)}{y + 1}";

