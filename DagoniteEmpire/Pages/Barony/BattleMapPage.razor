    private string? ValidateEnemyDraftAbility(string abilityKey)
    {
        if (_enemyDraft.CommanderAbilities.Any(a => string.Equals(a, abilityKey, StringComparison.OrdinalIgnoreCase)))
            return "Ta zdolnosc jest juz dodana.";
        if (EnemyMountedAbilityKeys.Contains(abilityKey) && !_enemyDraft.Mounted)
            return "Ta zdolnosc wymaga wierzchowca (Mounted).";
        if (EnemyRangedAbilityKeys.Contains(abilityKey) && _enemyDraft.Range <= 0)
            return "Ta zdolnosc wymaga ataku dystansowego (Range > 0).";
        return null;
    }

    private async Task OpenEnemyAbilityDialogAsync()
    {
        if (!CanManageAsMg)
            return;

        var parameters = new DialogParameters
        {
            [nameof(EnemyCommanderAbilityDialog.Selectable)] = EnemySelectableAbilities,
            [nameof(EnemyCommanderAbilityDialog.ValidateAbility)] = (Func<string, string?>)ValidateEnemyDraftAbility,
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
        };

        var dialog = await _dialogService.ShowAsync<EnemyCommanderAbilityDialog>(
            "Dodaj zdolnosc kapitana", parameters, options);
        var result = await dialog.Result;
        if (result.Canceled || result.Data is not string key)
            return;

        var error = ValidateEnemyDraftAbility(key);
        if (!string.IsNullOrWhiteSpace(error))
        {
            _snackBar.Add(error, Severity.Warning);
            return;
        }

        _enemyDraft.CommanderAbilities.Add(key);
        StateHasChanged();
    }

    private void RemoveEnemyAbility(string key)
    {
        _enemyDraft.CommanderAbilities.RemoveAll(a => string.Equals(a, key, StringComparison.OrdinalIgnoreCase));
    }

    private string? ValidateEnemyDraftAbilitiesSet()
    {
        foreach (var key in _enemyDraft.CommanderAbilities)
        {
            var error = ValidateEnemyDraftAbility(key);
            if (string.IsNullOrWhiteSpace(error)
                || error.Contains("juz dodana", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            var name = L[CourtCommanderCatalog.Find(key)?.NameEn ?? key];
            return $"{name}: {error}";
        }

        return null;
    }

    /// <summary>Clears every commander battle flag on a token. Shared by the ally and enemy apply paths.</summary>
    private static void ResetCommanderFlags(BaronyBattleTokenDTO token)
    {
        token.ThunderCharge = false;
        token.FlyingStart = false;
        token.ChargeDamageExtra = 0;
        token.CommanderInitiative = 0;
        token.CmdDrillShot = false;
        token.CmdMountedSuperiority = false;
        token.CmdCounterCharge = false;
        token.CmdPikeHedge = false;
        token.CmdReturnStroke = false;
        token.CmdKillTheCaptain = false;
        token.CmdPierceIgnore = 0;
        token.CmdWedge = false;
        token.CmdUnbrokenMomentum = false;
        token.CmdBlindFury = false;
        token.CmdOverrun = false;
        token.CmdLongShot = false;
        token.CmdSnapShot = false;
        token.CmdSkirmishScreen = false;
        token.CmdEnfilade = false;
        token.CmdHarassingFire = false;
        token.CmdKnifeInTheDark = false;
        token.CmdKeepFacing = false;
        token.CmdLookAway = false;
        token.CmdColumnMarch = false;
        token.CmdLooseFiles = false;
        token.CmdIronclad = false;
        token.AllyCommanderAbilities.Clear();
    }

    private static void ApplyEnemyCommanderAbilities(BaronyBattleTokenDTO token)
    {
        // Capture the game master's raw stats once so passive bonuses apply idempotently
        // (this method also runs at BeginBattle and on every edit).
        if (!token.EnemyBaseCaptured)
        {
            token.EnemyBaseHp = token.MaxHp > 0 ? token.MaxHp : token.Hp;
            token.EnemyBaseMove = token.Move;
            token.EnemyBaseDamage = token.Damage;
            token.EnemyBaseDefense = token.Defense;
            token.EnemyBaseDiscipline = token.Discipline;
            if (token.EnemyBaseRange <= 0)
                token.EnemyBaseRange = token.Range;
            token.EnemyBaseCaptured = true;
        }

        ResetCommanderFlags(token);

        token.HasCaptain = token.EnemyCommanderAbilities.Count > 0;
        var baseRange = Math.Max(0, token.EnemyBaseRange > 0 ? token.EnemyBaseRange : token.Range);
        token.Range = baseRange;

        // Reuse the same tested formula the ally captains use. Enemies have no shield model,
        // so an MG-selected Shield Wall implies a shield (unitHasShield: true).
        var bonuses = CourtCommanderFormulas.ComputeBonuses(
            new CourtCharacterSheet { UnlockedCommanderAbilities = token.EnemyCommanderAbilities.ToList() },
            unitHasMount: token.Mounted,
            unitHasShield: true);

        token.CmdDrillShot = bonuses.DrillShot;
        token.CmdMountedSuperiority = bonuses.MountedSuperiority;
        token.CmdCounterCharge = bonuses.CounterCharge;
        token.CmdPikeHedge = bonuses.PikeHedge;
        token.CmdReturnStroke = bonuses.ReturnStroke;
        token.CmdKillTheCaptain = bonuses.KillTheCaptain;
        token.CmdPierceIgnore = bonuses.PierceIgnore;
        token.ChargeDamageExtra = bonuses.ShockLance ? 1 : 0;
        token.ThunderCharge = bonuses.ThunderCharge;
        token.FlyingStart = bonuses.FlyingStart;
        token.CmdWedge = bonuses.Wedge;
        token.CmdUnbrokenMomentum = bonuses.UnbrokenMomentum;
        token.CmdBlindFury = bonuses.BlindFury;
        token.CmdOverrun = bonuses.Overrun;
        token.CmdLongShot = bonuses.LongShot;
        token.CmdSnapShot = bonuses.SnapShot;
        token.CmdSkirmishScreen = bonuses.SkirmishScreen;
        token.CmdEnfilade = bonuses.Enfilade;
        token.CmdHarassingFire = bonuses.HarassingFire;
        token.CmdKnifeInTheDark = bonuses.KnifeInTheDark;
        token.CmdKeepFacing = bonuses.KeepFacing;
        token.CmdLookAway = bonuses.LookAway;
        token.CmdColumnMarch = bonuses.ColumnMarch;
        token.CmdLooseFiles = bonuses.LooseFiles;
        token.CmdIronclad = bonuses.Ironclad;

        // Re-derive effective stats from the captured base so repeated calls never stack.
        token.MaxHp = token.EnemyBaseHp + bonuses.OtherHp;
        token.Hp = Math.Min(token.Hp <= 0 ? token.MaxHp : token.Hp, token.MaxHp);
        token.Move = token.EnemyBaseMove + bonuses.OtherMove;
        token.Damage = token.EnemyBaseDamage + bonuses.OtherDamageMelee;
        token.Defense = token.EnemyBaseDefense + bonuses.CommanderDefense;
        token.Discipline = Math.Max(0, token.EnemyBaseDiscipline + bonuses.OtherDiscipline);
        token.CommanderInitiative = bonuses.OtherInitiative;

        if (bonuses.ExtendedRange && baseRange > 0)
            token.Range = baseRange + 1;
    }

    private bool CanControlToken(BaronyBattleTokenDTO token)
    {
        if (CanManageAsMg)
            return true;
        // Baron gives orders only to their own units — enemy orders belong to the Game Master.
        return CanEdit && !token.IsEnemy;
    }

    private async Task ActivateCommanderAbility((string TokenId, string AbilityKey) request)
    {
        var token = Map?.Tokens.FirstOrDefault(t => t.Id == request.TokenId);
        if (token is null || !CanControlToken(token))
            return;

        switch (request.AbilityKey)
        {
            case "full-defense":
                if (!IsMovementPhase)
                    return;
                token.FullDefense = !token.FullDefense;
                if (token.FullDefense)
                {
                    CancelFacingEdit();
                    CancelChargeEdit();
                    token.ClearPath();
                    ClearCharge(token);
                    token.RemainingMove = 0;
                    AppendLocalLog(string.Empty, "phase",
                        $"{token.Label} uses Full Defense: +{BattleMovementRules.FullDefenseDefenseBonus} Defence, −{BattleMovementRules.FullDefenseAttackPenalty} Attack, movement set to 0.");
                    await SaveAsync(systemMessage:
                        $"{token.Label} takes Full Defense: +{BattleMovementRules.FullDefenseDefenseBonus} Defence, −{BattleMovementRules.FullDefenseAttackPenalty} Attack, no movement this round.");
                }
                else
                {
                    AppendLocalLog(string.Empty, "phase", $"{token.Label} drops Full Defense.");
                    token.RemainingMove = token.Move;
                    await SaveAsync(systemMessage: $"{token.Label} drops Full Defense.");
                }
                RefreshRange();
                break;

            case "ironclad":
                if (token.IsEnemy)
                    return;
                if (!(IsAttackPlanningPhase || IsCombatPhase))
                    return;
                if (!token.CmdIronclad || token.IroncladUsed || token.IroncladActive)
                    return;
                token.IroncladUsed = true;
                token.IroncladActive = true;
                AppendLocalLog(string.Empty, "phase", $"{token.Label} activates Ironclad (+2 Armor this combat round).");
                await SaveAsync(systemMessage:
                    $"{token.Label} braces — Ironclad: +2 Armor for this combat round.");
                break;

            default:
                return;
        }

        StateHasChanged();
    }
    private bool CanSelectToken(BaronyBattleTokenDTO token)
    {
        if (CanManageAsMg)
            return true;
        // Setup: Baron only deploys allies. Battle: enemies may be selected read-only for inspection.
        if (IsSetupPhase)
            return !token.IsEnemy;
        return CanEdit;
    }

    /// <summary>
    /// Origin and remaining budget for the next movement segment.
    /// Ignores provisional (unlocked) ghosts — move is spent only on lock.
    /// </summary>
    private static (int X, int Y, int Budget) GetPlanOrigin(BaronyBattleTokenDTO token)
    {
        // Full Defense forfeits movement — no budget to plan any step.
        if (token.FullDefense)
            return (token.X, token.Y, 0);
        var locked = token.Path.LastOrDefault(w => w.Locked);
        if (locked is not null)
            return (locked.X, locked.Y, locked.RemainingMoveAfter);
        return (token.X, token.Y, token.RemainingMove > 0 ? token.RemainingMove : token.Move);
    }

    /// <summary>Current tip including provisional ghost (charge / facing from tip).</summary>
    private static (int X, int Y, int Budget) GetTipPlanOrigin(BaronyBattleTokenDTO token)
    {
        var tip = token.LastWaypoint;
        if (tip is not null)
            return (tip.X, tip.Y, tip.RemainingMoveAfter);
        return GetPlanOrigin(token);
    }

    private static int GetPlanBudget(BaronyBattleTokenDTO token) => GetPlanOrigin(token).Budget;

    /// <summary>True when two tokens touch along an edge or a corner — melee contact range.</summary>
    private static bool AreAdjacent(BaronyBattleTokenDTO a, BaronyBattleTokenDTO b) =>
        BattleMovementRules.FootprintsAdjacent(
            a.X, a.Y, TokenSize(a),
            b.X, b.Y, TokenSize(b));

    /// <summary>True when the unit has at least one living engaged enemy still in contact.</summary>
    private bool IsPinned(BaronyBattleTokenDTO token)
    {
        if (Map is null || token.EngagedEnemyIds.Count == 0)
            return false;
        return token.EngagedEnemyIds.Any(enemyId =>
        {
            var enemy = Map.Tokens.FirstOrDefault(t => t.Id == enemyId);
            return enemy is not null && enemy.Hp > 0 && AreAdjacent(token, enemy);
        });
    }

    /// <summary>Ranged unit that is not locked in melee — free to shoot.</summary>
    private bool CanShoot(BaronyBattleTokenDTO token) =>
        token.Range > 0 && (!IsPinned(token) || token.CmdSkirmishScreen);

    /// <summary>
    /// True when the attacker will resolve this order as a shot (no defensive return, no engagement).
    /// Point-blank shots count: adjacency alone does not force melee when the unit can shoot.
    /// </summary>
    private bool IsShotAt(BaronyBattleTokenDTO attacker, BaronyBattleTokenDTO target) =>
        CanShoot(attacker)
        && BattleMovementRules.IsInShotRange(
            attacker.X, attacker.Y, TokenSize(attacker),
            target.X, target.Y, TokenSize(target),
            attacker.Range);

    /// <summary>Melee contact, or a free shot that reaches the target.</summary>
    private bool CanTarget(BaronyBattleTokenDTO attacker, BaronyBattleTokenDTO target) =>
        AreAdjacent(attacker, target) || IsShotAt(attacker, target);

    /// <summary>Distance penalty of a planned shot, as a suffix for order messages. Empty at point-blank.</summary>
    private static string ShotPenaltyLabel(BaronyBattleTokenDTO attacker, BaronyBattleTokenDTO target)
    {
        var penalty = BattleMovementRules.ShotAttackPenalty(
            BattleMovementRules.FootprintShotHalfCost(
                attacker.X, attacker.Y, TokenSize(attacker),
                target.X, target.Y, TokenSize(target)));
        return penalty > 0 ? $" (−{penalty} attack at range)" : "";
    }

    private static void BindEngagement(BaronyBattleTokenDTO a, BaronyBattleTokenDTO b)
    {
        if (ReferenceEquals(a, b) || a.IsEnemy == b.IsEnemy)
            return;
        if (!a.EngagedEnemyIds.Contains(b.Id, StringComparer.Ordinal))
            a.EngagedEnemyIds.Add(b.Id);
        if (!b.EngagedEnemyIds.Contains(a.Id, StringComparer.Ordinal))
            b.EngagedEnemyIds.Add(a.Id);
    }

    private static void UnbindEngagement(BaronyBattleTokenDTO a, BaronyBattleTokenDTO b)
    {
        a.EngagedEnemyIds.RemoveAll(id => string.Equals(id, b.Id, StringComparison.Ordinal));
        b.EngagedEnemyIds.RemoveAll(id => string.Equals(id, a.Id, StringComparison.Ordinal));
    }

    private void ClearEngagementsWith(string tokenId)
    {
        if (Map is null)
            return;
        foreach (var other in Map.Tokens)
            other.EngagedEnemyIds.RemoveAll(id => string.Equals(id, tokenId, StringComparison.Ordinal));
        var token = Map.Tokens.FirstOrDefault(t => t.Id == tokenId);
        token?.EngagedEnemyIds.Clear();
    }

    /// <summary>
    /// Drops ghost engagements (missing partners, same side, or no longer adjacent) without a leave penalty.
    /// Keeps the lists symmetric.
    /// </summary>
    private void ReconcileEngagements()
    {
        if (Map is null)
            return;

        var byId = Map.Tokens.ToDictionary(t => t.Id, StringComparer.Ordinal);
        foreach (var token in Map.Tokens)
        {
            token.EngagedEnemyIds = token.EngagedEnemyIds
                .Where(id => byId.TryGetValue(id, out var other)
                             && other.IsEnemy != token.IsEnemy
                             && other.Hp > 0
                             && AreAdjacent(token, other))
                .Distinct(StringComparer.Ordinal)
                .ToList();
        }

        // Ensure symmetry: if A lists B, B must list A.
        foreach (var token in Map.Tokens)
        {
            foreach (var otherId in token.EngagedEnemyIds.ToList())
            {
                if (!byId.TryGetValue(otherId, out var other))
                    continue;
                if (!other.EngagedEnemyIds.Contains(token.Id, StringComparer.Ordinal))
                    other.EngagedEnemyIds.Add(token.Id);
            }
        }
    }

    /// <summary>
    /// Free hits the unit will take for budging at all: one per live engaged enemy, wherever it goes.
    /// </summary>
    private int CountEngagementPenalties(BaronyBattleTokenDTO token)
    {
        if (Map is null || token.EngagedEnemyIds.Count == 0)
            return 0;

        return token.EngagedEnemyIds.Count(enemyId =>
        {
            var enemy = Map.Tokens.FirstOrDefault(t => t.Id == enemyId);
            return enemy is not null && enemy.Hp > 0 && AreAdjacent(token, enemy);
        });
    }

    private bool CanIssueAttackOrder(BaronyBattleTokenDTO token) =>
        CanManageAsMg || (CanEdit && !token.IsEnemy);


    /// <summary>
    /// After movement resolve, a successful charge attack cannot be cleared or retargeted.
    /// </summary>
    private static bool IsLockedChargeAttack(BaronyBattleTokenDTO token) =>
        token.ChargeBonus
        && !string.IsNullOrWhiteSpace(token.ChargeTargetId)
        && string.Equals(token.AttackTargetId, token.ChargeTargetId, StringComparison.Ordinal);

    private bool HasAttackTargetOpportunity(BaronyBattleTokenDTO token)
    {
        if (Map is null)
            return false;
        foreach (var other in Map.Tokens)
        {
            if (other.Id == token.Id)
                continue;
            if (other.IsEnemy == token.IsEnemy)
                continue;
            if (other.Hp <= 0)
                continue;
            if (CanTarget(token, other))
                return true;
        }
        return false;
    }

    private IEnumerable<BaronyBattleTokenDTO> AttackCandidates(BaronyBattleTokenDTO attacker)
    {
        if (Map is null)
            return Enumerable.Empty<BaronyBattleTokenDTO>();

        return Map.Tokens
            .Where(t => t.Id != attacker.Id)
            .Where(t => t.IsEnemy != attacker.IsEnemy)
            .Where(t => t.Hp > 0)
            .Where(t => CanTarget(attacker, t));
    }

    private async Task AutoAssignAttackTargets()
    {
        if (Map is null || !IsAttackPlanningPhase || (!CanEdit && !CanManageAsMg))
            return;

        var assigned = 0;
        var cleared = 0;

        var attackers = Map.Tokens
            .Where(t => t.Hp > 0)
            .Where(CanIssueAttackOrder)
            .OrderByDescending(t => t.InitiativeTotal)
            .ThenBy(t => t.Label)
            .ToList();

        foreach (var attacker in attackers)
        {
            // Successful charge attacks stay locked through attack planning.
            if (IsLockedChargeAttack(attacker))
                continue;

            var currentTarget = attacker.AttackTargetId is null
                ? null
                : Map.Tokens.FirstOrDefault(t => t.Id == attacker.AttackTargetId);

            var isCurrentValid = currentTarget is not null
                && currentTarget.Hp > 0
                && currentTarget.IsEnemy != attacker.IsEnemy
                && CanTarget(attacker, currentTarget);

            if (isCurrentValid)
                continue;

            if (attacker.AttackTargetId is not null)
            {
                attacker.AttackTargetId = null;
                cleared++;
            }

            var bestTarget = AttackCandidates(attacker)
                .OrderBy(t => t.Hp)
                .ThenByDescending(t => t.InitiativeTotal)
                .ThenBy(t => t.Label)
                .FirstOrDefault();

            if (bestTarget is not null)
            {
                attacker.AttackTargetId = bestTarget.Id;
                assigned++;
            }
        }

        if (assigned == 0 && cleared == 0)
        {
            _snackBar.Add("No attack targets could be auto-assigned.", Severity.Info);
            return;
        }

        ClearBaronPhaseReadyIfPlayer();
        await SaveAsync(systemMessage: $"Auto-assign attacks: {assigned} assigned, {cleared} cleared.");
        RefreshRange();
    }

    private void ClearBaronPhaseReadyIfPlayer()
    {
        if (Map is null || CanManageAsMg || !Map.TurnState.BaronPhaseReady)
            return;
        Map.TurnState.BaronPhaseReady = false;
    }

    /// <summary>
    /// Front multiplier = AimBase + ExposureBonus.
    /// Aim: attacker facing toward defender (front 2.5 / corner 1.5 / else 1).
    /// Exposure: attacker position vs defender facing (front +0 / corner +0.5 / side|rear-corner +1.5 / rear +2).
    /// When <paramref name="forceFrontAim"/> is true (ranged shot), Aim is locked to front —
    /// the shooter always aims well; only the target's exposure still matters.
    /// </summary>
    private readonly record struct FrontBreakdown(double Multiplier, string AimLabel, string ExposureLabel, int ExposureBand);

    private static FrontBreakdown GetFrontBreakdown(
        BaronyBattleTokenDTO attacker,
        BaronyBattleTokenDTO defender,
        bool forceFrontAim = false,
        bool enfiladeExposure = false)
    {
        var attackerCenterX = attacker.X + TokenSize(attacker) * 0.5;
        var attackerCenterY = attacker.Y + TokenSize(attacker) * 0.5;
        var defenderCenterX = defender.X + TokenSize(defender) * 0.5;
        var defenderCenterY = defender.Y + TokenSize(defender) * 0.5;

        // Exposure: where the attacker stands relative to the defender's front.
        var fromDefenderToAttacker = BaronyBattleFacing.FromScreenVector(
            attackerCenterX - defenderCenterX,
            attackerCenterY - defenderCenterY);
        var exposureDiff = BaronyBattleFacing.CircularDiff(fromDefenderToAttacker, defender.Facing);
        var exposureBonus = exposureDiff switch
        {
            0 => 0.0, // front
            1 => 0.5, // corner
            2 => 1.5, // side
            3 => 1.5, // rear-corner
            _ => 2.0, // rear
        };

        // Enfilade: flank / rear shots escalate the Exposure bonus by one half-step.
        if (enfiladeExposure && exposureDiff >= 2)
            exposureBonus += 0.5;

        // Aim: how the attacker faces toward the defender (shots always aim front).
        int aimDiff;
        double aimBase;
        if (forceFrontAim)
        {
            aimDiff = 0;
            aimBase = 2.5;
        }
        else
        {
            var fromAttackerToDefender = BaronyBattleFacing.FromScreenVector(
                defenderCenterX - attackerCenterX,
                defenderCenterY - attackerCenterY);
            aimDiff = BaronyBattleFacing.CircularDiff(fromAttackerToDefender, attacker.Facing);
            aimBase = aimDiff switch
            {
                0 => 2.5, // front
                1 => 1.5, // corner
                _ => 1.0, // side / rear-corner / rear
            };
        }

        return new FrontBreakdown(
            aimBase + exposureBonus,
            FacingBandLabel(aimDiff),
            FacingBandLabel(exposureDiff),
            exposureDiff);
    }

    private static string FormatFrontMultiplier(double value) =>
        value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static string FacingBandLabel(int circularDiff) => circularDiff switch
    {
        0 => "Front",
        1 => "Corner",
        2 => "Side",
        3 => "Rear Corner",
        _ => "Rear",
    };

    private sealed record CombatExchangePlan(
        string AttackerId,
        string DefenderId,
        int Dealt,
        int DefDealt,
        bool AttackerFlees,
        bool DefenderFlees,
        bool IsShot,
        int AttackerHeal,
        bool HarassDefender,
        IReadOnlyList<string> Notes);

    private List<CombatExchangePlan> PlanCombatExchanges(Random rng)
    {
        var plans = new List<CombatExchangePlan>();
        if (Map is null)
            return plans;

        var baseOrderedIds = Map.TurnState.InitiativeOrder
            .Reverse<string>()
            .Concat(Map.Tokens
                .Where(t => !Map.TurnState.InitiativeOrder.Contains(t.Id))
                .OrderByDescending(t => t.InitiativeTotal)
                .Select(t => t.Id))
            .ToList();

        bool IsChargeAttackReady(string attackerId)
        {
            var attacker = Map.Tokens.FirstOrDefault(t => t.Id == attackerId);
            if (attacker is null || !attacker.ChargeBonus || string.IsNullOrWhiteSpace(attacker.AttackTargetId))
                return false;
            if (!string.Equals(attacker.ChargeTargetId, attacker.AttackTargetId, StringComparison.Ordinal))
                return false;
            var target = Map.Tokens.FirstOrDefault(t => t.Id == attacker.ChargeTargetId);
            return target is not null && IsValidChargeContact(attacker, target);
        }

        // Commander (Phase 2) context-sensitive attack/defense modifiers.
        static int CommanderAttackMod(BaronyBattleTokenDTO atk, BaronyBattleTokenDTO def, bool isShot)
        {
            var m = 0;
            if (isShot && atk.CmdDrillShot)
                m += 1;
            if (!isShot && atk.CmdMountedSuperiority && atk.Mounted && !def.Mounted)
                m += 1;
            if (atk.CmdKillTheCaptain && def.HasCaptain)
                m += 2;
            return m;
        }

        static int CommanderDefenseMod(BaronyBattleTokenDTO def, BaronyBattleTokenDTO atk, bool defenderIsCharged)
        {
            var m = 0;
            if (defenderIsCharged && def.CmdCounterCharge)
                m += 2;
            if (defenderIsCharged && def.CmdPikeHedge)
                m += 3;
            if (def.CmdMountedSuperiority && def.Mounted && !atk.Mounted)
                m += 1;
            return m;
        }

        // Charge attacks resolve first, ignoring global initiative order.
        var orderedIds = baseOrderedIds
            .OrderByDescending(IsChargeAttackReady)
            .ToList();

        // Working HP so later exchanges see earlier results without mutating tokens yet.
        var hp = Map.Tokens.ToDictionary(t => t.Id, t => t.Hp, StringComparer.Ordinal);
        var fledIds = new HashSet<string>(StringComparer.Ordinal);

        foreach (var attackerId in orderedIds)
        {
            if (fledIds.Contains(attackerId))
                continue;
            var attacker = Map.Tokens.FirstOrDefault(t => t.Id == attackerId);
            if (attacker is null)
                continue;
            if (!hp.TryGetValue(attacker.Id, out var atkHp) || atkHp <= 0)
                continue;
            if (string.IsNullOrWhiteSpace(attacker.AttackTargetId))
                continue;

            var defender = Map.Tokens.FirstOrDefault(t => t.Id == attacker.AttackTargetId);
            if (defender is null || fledIds.Contains(defender.Id))
                continue;
            if (!hp.TryGetValue(defender.Id, out var defHp) || defHp <= 0)
                continue;
            if (!CanTarget(attacker, defender))
                continue;

            var isShot = IsShotAt(attacker, defender);
            var notes = new List<string>();
            var damageDie = rng.Next(1, 5);
            var attackDie = rng.Next(1, 7);
            var defenseDie = rng.Next(1, 7);
            var chargeBonus = !isShot
                && attacker.ChargeBonus
                && string.Equals(attacker.ChargeTargetId, defender.Id, StringComparison.Ordinal)
                && string.Equals(attacker.AttackTargetId, defender.Id, StringComparison.Ordinal)
                && IsValidChargeContact(attacker, defender);
            var shotHalf = isShot
                ? BattleMovementRules.FootprintShotHalfCost(
                    attacker.X, attacker.Y, TokenSize(attacker),
                    defender.X, defender.Y, TokenSize(defender))
                : 0;
            var rangePenalty = isShot ? BattleMovementRules.ShotAttackPenalty(shotHalf) : 0;
            if (isShot && attacker.CmdLongShot)
                rangePenalty /= 2; // Long Shot: −1 per tile instead of −2 (penalty is always even).
            var chargeAtk = chargeBonus ? ChargeAttackBonus(attacker) : 0;
            var chargeDmg = chargeBonus ? ChargeDamageBonus(attacker) : 0;
            var cmdAtk = CommanderAttackMod(attacker, defender, isShot);
            var cmdDef = CommanderDefenseMod(defender, attacker, chargeBonus);
            var usedDrillShot = isShot && attacker.CmdDrillShot;
            var usedMountedAtk = !isShot && attacker.CmdMountedSuperiority && attacker.Mounted && !defender.Mounted;
            var usedKillCaptain = attacker.CmdKillTheCaptain && defender.HasCaptain;
            var usedCounterCharge = chargeBonus && defender.CmdCounterCharge;
            var usedPikeHedge = chargeBonus && defender.CmdPikeHedge;
            var usedMountedDef = defender.CmdMountedSuperiority && defender.Mounted && !attacker.Mounted;
            var snapShotDmg = isShot && attacker.CmdSnapShot && AreAdjacent(attacker, defender) ? 1 : 0;
            var front = GetFrontBreakdown(
                attacker, defender, forceFrontAim: isShot, enfiladeExposure: isShot && attacker.CmdEnfilade);
            var knifeDmg = attacker.CmdKnifeInTheDark && front.ExposureBand >= 4 ? 1 : 0;
            var fullDefAtk = attacker.FullDefense ? BattleMovementRules.FullDefenseAttackPenalty : 0;
            var attackStat = attacker.Attack + chargeAtk - rangePenalty + cmdAtk - fullDefAtk;
            var damageStat = attacker.Damage + chargeDmg + snapShotDmg + knifeDmg;
            var attackRoll = attackStat + attackDie;
            var defenseStat = defender.Defense + cmdDef + (defender.FullDefense ? BattleMovementRules.FullDefenseDefenseBonus : 0);
            var defenseRoll = defenseStat + defenseDie;
            var ratio = Math.Max(1, attackRoll) / (double)Math.Max(1, defenseRoll);
            var defArmorBase = defender.Armor + (defender.IroncladActive ? 2 : 0);
            var defenderArmor = UnitCombatFormulas.EffectiveArmor(
                defArmorBase, Math.Max(0, attacker.Pierce - defender.CmdPierceIgnore));
            var baseDamage = damageStat + damageDie - defenderArmor;
            var rawDamage = baseDamage * ratio * front.Multiplier;
            var dealt = Math.Max(1, (int)Math.Round(rawDamage, MidpointRounding.AwayFromZero));
            defHp = Math.Max(0, defHp - dealt);

            if (chargeBonus && attacker.ThunderCharge)
                notes.Add($"{attacker.Label} uses Thunder Charge.");
            else if (chargeBonus && attacker.ChargeDamageExtra > 0)
                notes.Add($"{attacker.Label} uses Shock Lance.");
            if (usedDrillShot)
                notes.Add($"{attacker.Label} uses Drill Shot.");
            if (usedMountedAtk)
                notes.Add($"{attacker.Label} uses Mounted Superiority (attack).");
            if (usedKillCaptain)
                notes.Add($"{attacker.Label} uses Kill the Captain.");
            if (usedCounterCharge)
                notes.Add($"{defender.Label} uses Counter-Charge.");
            if (usedPikeHedge)
                notes.Add($"{defender.Label} uses Pike Hedge.");
            if (usedMountedDef)
                notes.Add($"{defender.Label} uses Mounted Superiority (defense).");
            if (attacker.CmdLongShot && rangePenalty > 0)
                notes.Add($"{attacker.Label} uses Long Shot.");
            if (snapShotDmg > 0)
                notes.Add($"{attacker.Label} uses Snap Shot.");
            if (knifeDmg > 0)
                notes.Add($"{attacker.Label} uses Knife in the Dark.");
            if (isShot && attacker.CmdEnfilade && front.ExposureBand >= 2)
                notes.Add($"{attacker.Label} uses Enfilade.");

            var modifierNote = chargeBonus ? $" [charge +{chargeAtk}/+{chargeDmg}]" : "";
            if (cmdAtk != 0)
                modifierNote += $" [cmd +{cmdAtk} att]";
            if (cmdDef != 0)
                modifierNote += $" [cmd +{cmdDef} def]";
            if (fullDefAtk > 0)
                modifierNote += $" [full def −{fullDefAtk} att]";
            if (defender.FullDefense)
                modifierNote += $" [full def +{BattleMovementRules.FullDefenseDefenseBonus}]";
            if (snapShotDmg > 0)
                modifierNote += $" [snap +{snapShotDmg} dmg]";
            if (knifeDmg > 0)
                modifierNote += $" [rear +{knifeDmg} dmg]";
            if (rangePenalty > 0)
                modifierNote += attacker.CmdLongShot ? $" [long range −{rangePenalty} att]" : $" [range −{rangePenalty} att]";
            if (defender.IroncladActive)
                modifierNote += " [ironclad +2 arm]";
            if (defArmorBase > defenderArmor)
                modifierNote += $" [pierce −{defArmorBase - defenderArmor} arm]";
            var verb = isShot ? "shoots" : "->";
            notes.Add(
                $"{attacker.Label} {verb} {defender.Label}" +
                (isShot ? $" at {BattleMovementRules.SpentMovePoints(shotHalf)} tiles" : "") +
                $": (Dmg+k4−Arm={damageStat}+{damageDie}−{defenderArmor}={baseDamage}) " +
                $"× ({attackStat}+k6={attackRoll})/({defenseStat}+k6={defenseRoll}) " +
                $"×{FormatFrontMultiplier(front.Multiplier)} ({front.AimLabel} Vs {front.ExposureLabel}) => {dealt} dmg.{modifierNote}" +
                (isShot ? " (no defensive return)" : ""));
            notes.Add($"{defender.Label} takes {dealt} damage (HP: {defHp}/{defender.MaxHp}).");

            var defDealt = 0;
            if (!isShot)
            {
                var defDamageDie = rng.Next(1, 5);
                var defDefDie = rng.Next(1, 7);
                var atkDefDie = rng.Next(1, 7);
                var defReturnMod = (defender.CmdReturnStroke ? 2 : 0)
                    + (defender.CmdMountedSuperiority && defender.Mounted && !attacker.Mounted ? 1 : 0);
                var atkReturnMod = attacker.CmdMountedSuperiority && attacker.Mounted && !defender.Mounted ? 1 : 0;
                if (defender.CmdReturnStroke)
                    notes.Add($"{defender.Label} uses Return Stroke.");
                if (defender.CmdMountedSuperiority && defender.Mounted && !attacker.Mounted)
                    notes.Add($"{defender.Label} uses Mounted Superiority (defensive return).");
                if (attacker.CmdMountedSuperiority && attacker.Mounted && !defender.Mounted)
                    notes.Add($"{attacker.Label} uses Mounted Superiority (resisting return).");
                var defDefenseRoll = defender.Defense + defDefDie + defReturnMod;
                var atkDefenseRoll = attacker.Defense + atkDefDie + atkReturnMod + (attacker.FullDefense ? BattleMovementRules.FullDefenseDefenseBonus : 0);
                var defRatio = defDefenseRoll / (double)Math.Max(1, atkDefenseRoll);
                var defFront = GetFrontBreakdown(defender, attacker);
                var atkArmorBase = attacker.Armor + (attacker.IroncladActive ? 2 : 0);
                var attackerArmor = UnitCombatFormulas.EffectiveArmor(
                    atkArmorBase, Math.Max(0, defender.Pierce - attacker.CmdPierceIgnore));
                var defBaseDamage = defender.Damage + defDamageDie - attackerArmor;
                var defRaw = defBaseDamage * defRatio * defFront.Multiplier;
                defDealt = Math.Max(1, (int)Math.Round(defRaw, MidpointRounding.AwayFromZero));
                atkHp = Math.Max(0, atkHp - defDealt);
                notes.Add(
                    $"{defender.Label} -> {attacker.Label} (defensive): " +
                    $"(Dmg+k4−Arm={defender.Damage}+{defDamageDie}−{attackerArmor}={defBaseDamage}) " +
                    $"× ({defender.Defense + defReturnMod}+k6={defDefenseRoll})/({attacker.Defense + atkReturnMod + (attacker.FullDefense ? BattleMovementRules.FullDefenseDefenseBonus : 0)}+k6={atkDefenseRoll}) " +
                    $"×{FormatFrontMultiplier(defFront.Multiplier)} ({defFront.AimLabel} Vs {defFront.ExposureLabel}) => {defDealt} dmg." +
                    (defReturnMod != 0 ? $" [cmd +{defReturnMod} def]" : "") +
                    (attacker.FullDefense ? $" [full def +{BattleMovementRules.FullDefenseDefenseBonus}]" : "") +
                    (attacker.IroncladActive ? " [ironclad +2 arm]" : "") +
                    (atkArmorBase > attackerArmor ? $" [pierce −{atkArmorBase - attackerArmor} arm]" : ""));
                notes.Add($"{attacker.Label} takes {defDealt} defensive damage (HP: {atkHp}/{attacker.MaxHp}).");
            }

            hp[defender.Id] = defHp;
            hp[attacker.Id] = atkHp;
            var defenderFlees = defHp <= 0;
            var attackerFlees = atkHp <= 0;

            // Overrun: charging attacker heals when the charge target flees.
            var attackerHeal = 0;
            if (chargeBonus && defenderFlees && !attackerFlees && attacker.CmdOverrun)
            {
                attackerHeal = Math.Min(12, Math.Max(0, attacker.MaxHp - atkHp));
                if (attackerHeal > 0)
                {
                    hp[attacker.Id] = atkHp + attackerHeal;
                    notes.Add($"{attacker.Label} overruns {defender.Label} and recovers {attackerHeal} HP.");
                }
            }

            if (defenderFlees)
                fledIds.Add(defender.Id);
            if (attackerFlees)
                fledIds.Add(attacker.Id);

            // Harassing Fire: a damaging shot slows the surviving target's next Movement phase.
            var harassDefender = isShot && attacker.CmdHarassingFire && dealt > 0 && !defenderFlees;
            if (harassDefender)
                notes.Add($"{attacker.Label}'s harassing fire will slow {defender.Label} next turn (−1 Move).");

            plans.Add(new CombatExchangePlan(
                attacker.Id,
                defender.Id,
                dealt,
                defDealt,
                attackerFlees,
                defenderFlees,
                isShot,
                attackerHeal,
                harassDefender,
                notes));
        }

        return plans;
    }

    private async Task PlayCombatExchangesAsync(IReadOnlyList<CombatExchangePlan> plans)
    {
        if (Map is null)
            return;

        _isResolvingCombat = true;
        _combatAnimActive = true;
        _combatFocusAttackerId = null;
        _combatFx = null;
        StateHasChanged();
        await Task.Delay(120);

        try
        {
            if (plans.Count == 0)
            {
                AppendLocalLog(string.Empty, "combat", "No resolved attacks this round.");
                return;
            }

            foreach (var plan in plans)
            {
                var attacker = Map.Tokens.FirstOrDefault(t => t.Id == plan.AttackerId);
                var defender = Map.Tokens.FirstOrDefault(t => t.Id == plan.DefenderId);
                if (attacker is null || defender is null)
                    continue;

                // 1) Attack arrow + clash icon together
                _combatFocusAttackerId = plan.AttackerId;
                _combatFx = new BattleCombatFx
                {
                    AttackerId = plan.AttackerId,
                    DefenderId = plan.DefenderId,
                    DealtToDefender = plan.Dealt,
                    DealtToAttacker = plan.DefDealt,
                    ShowClash = true,
                    ShowDamage = false,
                    IsShot = plan.IsShot,
                };
                StateHasChanged();
                await Task.Delay(CombatClashLeadMs);

                // 2) Floating damage numbers + apply HP (bars update)
                defender.Hp = Math.Max(0, defender.Hp - plan.Dealt);
                attacker.Hp = Math.Max(0, attacker.Hp - plan.DefDealt);
                if (plan.AttackerHeal > 0 && attacker.Hp > 0)
                    attacker.Hp = Math.Min(attacker.MaxHp, attacker.Hp + plan.AttackerHeal);
                if (plan.HarassDefender && defender.Hp > 0)
                    defender.HarassedNextTurn = true;
                TrackDamage(attacker, defender, plan.Dealt);
                if (plan.DefDealt > 0)
                    TrackDamage(defender, attacker, plan.DefDealt);
                RecordAllyOutcome(defender, defender.Hp);
                RecordAllyOutcome(attacker, attacker.Hp);

                foreach (var note in plan.Notes)
                    AppendLocalLog(string.Empty, "combat", note);

                // Surviving melee exchanges lock both sides; shots never bind engagement.
                if (!plan.IsShot
                    && !plan.AttackerFlees && !plan.DefenderFlees
                    && Map.Tokens.Any(t => t.Id == plan.AttackerId)
                    && Map.Tokens.Any(t => t.Id == plan.DefenderId))
                {
                    BindEngagement(attacker, defender);
                }

                _combatFx.ShowDamage = true;
                StateHasChanged();
                await Task.Delay(CombatDamageMs);

                var fledThisExchange = new List<BaronyBattleTokenDTO>();
                if (plan.DefenderFlees && Map.Tokens.Any(t => t.Id == plan.DefenderId))
                {
                    TrackKill(attacker, defender);
                    fledThisExchange.Add(defender);
                    AppendLocalLog(string.Empty, "combat", $"{defender.Label} flees the battlefield.");
                }
                if (plan.AttackerFlees && Map.Tokens.Any(t => t.Id == plan.AttackerId))
                {
                    TrackKill(defender, attacker);
                    fledThisExchange.Add(attacker);
                    AppendLocalLog(string.Empty, "combat", $"{attacker.Label} flees the battlefield.");
                }

                if (fledThisExchange.Count > 0)
                {
                    var fledIds = fledThisExchange.Select(t => t.Id).ToHashSet(StringComparer.Ordinal);
                    foreach (var fled in fledThisExchange)
                    {
                        ClearEngagementsWith(fled.Id);
                        await MarkAllyFledAsync(fled);
                        Map.Tokens.Remove(fled);
                    }

                    foreach (var token in Map.Tokens)
                    {
                        if (token.AttackTargetId is not null && fledIds.Contains(token.AttackTargetId))
                            token.AttackTargetId = null;
                    }

                    Map.TurnState.InitiativeOrder = Map.TurnState.InitiativeOrder
                        .Where(id => !fledIds.Contains(id))
                        .ToList();
                }

                _combatFx = null;
                _combatFocusAttackerId = null;
                        StateHasChanged();
                await Task.Delay(80);
            }
        }
        finally
        {
            _combatFx = null;
            _combatFocusAttackerId = null;
            _combatAnimActive = false;
            _isResolvingCombat = false;
            RebuildPlannedRoutes();
        }
    }

    private void EnsureBattleSubPhase()
    {
        if (Map is null || !IsBattlePhase)
            return;
        if (string.IsNullOrWhiteSpace(Map.TurnState.SubPhase))
            Map.TurnState.SubPhase = BaronyBattleSubPhases.Movement;
        if (Map.TurnState.Round < 1)
            Map.TurnState.Round = 1;
    }

    private async Task BeginBattle()
    {
        if (Map is null || !CanManageAsMg)
            return;
        if (Map.Tokens.Count == 0)
        {
            _snackBar.Add("Place at least one token before beginning.", Severity.Warning);
            return;
        }

        var rng = Random.Shared;
        foreach (var token in Map.Tokens)
        {
            if (token.UnitId is int uid)
            {
                var unit = _activeUnits.FirstOrDefault(u => u.Id == uid);
                if (unit is not null)
                    ApplyCommanderBattleFlags(token, unit);
            }
            else if (token.IsEnemy)
            {
                ApplyEnemyCommanderAbilities(token);
            }
            token.InitiativeDie = rng.Next(1, 11);
            token.InitiativeTotal = token.Discipline + token.InitiativeDie + token.CommanderInitiative;
            token.RemainingMove = token.Move;
            token.IroncladUsed = false;
            token.IroncladActive = false;
            token.FullDefense = false;
            token.ClearPath();
        }

        // Movement orders: lowest initiative first; ties broken randomly.
        var ordered = Map.Tokens
            .OrderBy(t => t.InitiativeTotal)
            .ThenBy(_ => rng.Next())
            .Select(t => t.Id)
            .ToList();

        Map.Phase = BaronyBattlePhases.Battle;
        Map.TurnState = new BaronyBattleTurnStateDTO
        {
            InitiativeOrder = ordered,
            CurrentIndex = 0,
            SubPhase = BaronyBattleSubPhases.Movement,
            Round = 1,
        };
        foreach (var token in Map.Tokens)
            token.EngagedEnemyIds.Clear();
        _tool = "token";
        SnapshotAllyStartHp();
        ResetBattleTallies();

        var lines = Map.Tokens
            .OrderBy(t => t.InitiativeTotal)
            .Select(t => $"{t.Label}: {t.Discipline}+{t.InitiativeDie}{(t.CommanderInitiative != 0 ? $"+{t.CommanderInitiative}" : "")}={t.InitiativeTotal}");
        AppendLocalLog(string.Empty, "phase",
            PhaseBanner($"Start of Movement Phase {Map.TurnState.Round}"));
        await SaveAsync(systemMessage: "Battle begins — movement phase (low → high initiative). " + string.Join("; ", lines));
        _selectedTokenId = ActiveTokenId;
        RefreshRange();
    }

    private void SnapshotAllyStartHp()
    {
        _allyStartHp.Clear();
        _allyOutcomeHp.Clear();
        if (Map is null)
            return;
        foreach (var token in Map.Tokens)
        {
            if (token.IsEnemy || token.UnitId is not int uid)
                continue;
            _allyStartHp[uid] = token.Hp;
        }
    }

    private void ResetBattleTallies()
    {
        if (Map is null)
            return;
        Map.Tallies.Clear();
        Map.XpSummary = null;
        foreach (var token in Map.Tokens.Where(t => !t.IsEnemy && t.UnitId is int))
        {
            Map.Tallies.Add(new BaronyBattleXpTallyDTO
            {
                UnitId = token.UnitId!.Value,
                UnitName = token.Label,
            });
        }
    }

    private BaronyBattleXpTallyDTO? GetOrAddTally(BaronyBattleTokenDTO token)
    {
        if (Map is null || token.IsEnemy || token.UnitId is not int uid)
            return null;
        var tally = Map.Tallies.FirstOrDefault(t => t.UnitId == uid);
        if (tally is null)
        {
            tally = new BaronyBattleXpTallyDTO
            {
                UnitId = uid,
                UnitName = token.Label,
            };
            Map.Tallies.Add(tally);
        }
        if (!string.IsNullOrWhiteSpace(token.Label))
            tally.UnitName = token.Label;
        return tally;
    }

    private void TrackDamage(BaronyBattleTokenDTO attacker, BaronyBattleTokenDTO defender, int dealt)
    {
        if (dealt <= 0)
            return;
        var attackerTally = GetOrAddTally(attacker);
        if (attackerTally is not null)
            attackerTally.DamageDealt += dealt;
        var defenderTally = GetOrAddTally(defender);
        if (defenderTally is not null)
            defenderTally.DamageTaken += dealt;
    }

    private void TrackKill(BaronyBattleTokenDTO killer, BaronyBattleTokenDTO victim)
    {
        if (victim.Hp > 0)
            return;
        var killerTally = GetOrAddTally(killer);
        if (killerTally is not null)
            killerTally.Kills += 1;
    }

    private void TrackFled(BaronyBattleTokenDTO token)
    {
        var tally = GetOrAddTally(token);
        if (tally is not null)
            tally.Fled = true;
    }

    private void TrackEngagedRound(int round)
    {
        if (Map is null || round <= 0)
            return;
        foreach (var token in Map.Tokens.Where(t => !t.IsEnemy && t.UnitId is int))
        {
            if (token.EngagedEnemyIds.Count == 0)
                continue;
            var tally = GetOrAddTally(token);
            if (tally is null)
                continue;
            if (!tally.RoundsEngaged.Contains(round))
                tally.RoundsEngaged.Add(round);
        }
    }

    private void RecordAllyOutcome(BaronyBattleTokenDTO token, int? fledHp = null)
    {
        if (token.IsEnemy || token.UnitId is not int uid)
            return;
        _allyOutcomeHp[uid] = fledHp ?? Math.Max(0, token.Hp);
    }

    /// <summary>
    /// Ally flees the map: set Army CurrentHp to 0 immediately (panel + DB) and record battle outcome.
    /// </summary>
    private async Task MarkAllyFledAsync(BaronyBattleTokenDTO fled)
    {
        RecordAllyOutcome(fled, fledHp: 0);
        TrackFled(fled);
        if (fled.IsEnemy || fled.UnitId is not int uid)
            return;

        var local = _activeUnits.FirstOrDefault(u => u.Id == uid);
        if (local is not null)
            local.CurrentHp = 0;

        if (_deployUnitId == uid)
            _deployUnitId = null;

        try
        {
            if (local is not null)
            {
                await _baronyRepo.SaveUnit(local);
            }
            else
            {
                var units = await _baronyRepo.GetUnits(BaronyId);
                var unit = units.FirstOrDefault(u => u.Id == uid);
                if (unit is not null)
                {
                    unit.CurrentHp = 0;
                    await _baronyRepo.SaveUnit(unit);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to mark fled unit {UnitId} as 0 HP for barony {BaronyId}", uid, BaronyId);
            _snackBar.Add($"Failed to update Army HP for {fled.Label}.", Severity.Error);
        }
    }

    private BaronyBattleXpSummaryDTO BuildXpSummaryFromTallies()
    {
        var summary = new BaronyBattleXpSummaryDTO
        {
            Id = Guid.NewGuid().ToString("N"),
            Utc = DateTime.UtcNow,
            AcknowledgedByBaron = false,
            Entries = new(),
        };

        if (Map is null)
            return summary;

        foreach (var tally in Map.Tallies
                     .Where(t => t.UnitId > 0)
                     .OrderBy(t => t.UnitName))
        {
            var xp = UnitExperienceRules.ComputeBattleXp(
                damageDealt: tally.DamageDealt,
                engagedRounds: tally.RoundsEngaged.Count,
                kills: tally.Kills,
                damageTaken: tally.DamageTaken,
                fled: tally.Fled);

            summary.Entries.Add(new BaronyBattleXpSummaryEntryDTO
            {
                UnitId = tally.UnitId,
                UnitName = tally.UnitName,
                DamageDealt = tally.DamageDealt,
                DamageTaken = tally.DamageTaken,
                EngagedRounds = tally.RoundsEngaged.Count,
                Kills = tally.Kills,
                Fled = tally.Fled,
                XpFromDamageDealt = xp.FromDamageDealt,
                XpFromEngagedRounds = xp.FromEngagedRounds,
                XpFromKills = xp.FromKills,
                XpLossFromDamageTaken = xp.FromDamageTakenLoss,
                XpLossFromFlee = xp.FromFleeLoss,
                XpNetBase = xp.Net,
            });
        }

        return summary;
    }

    private async Task<BaronyBattleXpSummaryDTO?> ShowMgXpSummaryDialogAsync(BaronyBattleXpSummaryDTO summary)
    {
        var parameters = new DialogParameters
        {
            [nameof(BattleXpSummaryDialog.Summary)] = summary,
            [nameof(BattleXpSummaryDialog.CanAdjust)] = true,
