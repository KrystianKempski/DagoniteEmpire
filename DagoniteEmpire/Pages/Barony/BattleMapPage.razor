@page "/barony/battle-map"
@layout BaronyLayout
@inherits BaronyPageBase
@attribute [Authorize(Roles = SD.Role_Admin + "," + SD.Role_GameMaster + "," + SD.Role_DukePlayer)]
@using DA_Business.Repository.BaronyRepos
@using DA_Common.Barony
@using DA_Common.Barony.Battle
@using DA_Models.BaronyModels
@using DA_Models.ChatModels
@using DagoniteEmpire.Pages.Barony.Components
@using Microsoft.AspNetCore.SignalR.Client
@inject IBaronyBattleMapRepository _battleMapRepo
@inject IDialogService _dialogService
@inject ILogger<BattleMapPage> Logger
@implements IAsyncDisposable

<PageTitle>Dagonite Empire | Battle</PageTitle>

@if (IsLoading)
{
    <MudProgressCircular Indeterminate="true" Size="Size.Small" /> <span>@L["Loading battle map..."]</span>
}
else if (LoadError is not null)
{
    <MudAlert Severity="Severity.Info" Class="my-2">@LoadError</MudAlert>
}
else if (Map is null)
{
    <MudAlert Severity="Severity.Warning" Class="my-2">@L["Could not load battle map."]</MudAlert>
}
else if (!CanManageAsMg && !Map.IsActive)
{
    <MudAlert Severity="Severity.Info" Class="my-2">
        @L["Battle Map is not visible yet. Wait for the Game Master to show the map so you can deploy your units."]
    </MudAlert>
}
else
{
    <div class="bbm-page">
        <BaronyPageHeader Title="@(L["Battle"])" HelpKey="battle-map" ShowSectionToggle="false">
            <Summary>
                <span class="bbm-phase-chip">@PhaseLabel</span>
                @if (IsMovementPhase && ActiveToken is not null)
                {
                    <span class="bbm-turn-chip bbm-turn-chip--@(ActiveToken.IsEnemy ? "enemy" : "ally")">
                        @(ActiveToken.IsEnemy ? "Enemy order" : "Baron's order")
                        · @ActiveToken.Label
                        · @GetPlanBudget(ActiveToken) move left
                        @if (ActiveToken.HasPath)
                        {
                            var end = ActiveToken.PlannedEnd();
                            <text> → @FormatCell(end.X, end.Y)</text>
                        }
                    </span>
                }
                else if (IsAttackPlanningPhase)
                {
                    <span class="bbm-turn-chip">Round @Map.TurnState.Round — attack planning</span>
                }
                else if (IsCombatPhase)
                {
                    <span class="bbm-turn-chip">Round @Map.TurnState.Round — combat</span>
                }
            </Summary>
        </BaronyPageHeader>

        <div class="bbm-layout">
            <section class="bbm-map-pane">
                @if (CanManageAsMg)
                {
                    <aside class="march-map-edit-panel march-map-toolbar--barony bbm-edit-panel @(_mapEditMode ? "march-map-edit-panel--expanded" : "")">
                        <div class="march-map-edit-panel__actions">
                            <MudButton Variant="@(_mapEditMode ? Variant.Filled : Variant.Outlined)"
                                       Size="Size.Small"
                                       Class="@(_mapEditMode ? "baron-influence-save-btn" : "march-map-toolbar__btn")"
                                       OnClick="ToggleMapEdit">
                                @(_mapEditMode ? "Editing" : "Map edit")
                            </MudButton>
                        </div>
                        @if (_mapEditMode)
                        {
                            <div class="march-map-edit-panel__body march-map-edit-panel__tools">
                                <MudToggleGroup T="string"
                                                Value="_tool"
                                                ValueChanged="OnPaintToolChanged"
                                                Size="Size.Small"
                                                Class="march-map-tool-toggle"
                                                SelectionMode="SelectionMode.SingleSelection"
                                                CheckMark="false">
                                    <MudToggleItem Value="@("tiles")" Text="@(L["Tiles"])" />
                                    <MudToggleItem Value="@("text")" Text="@(L["Text"])" />
                                    <MudToggleItem Value="@("erase")" Text="@(L["Eraser"])" />
                                </MudToggleGroup>

                                @if (_tool == "tiles")
                                {
                                    <MudToggleGroup T="string"
                                                    Value="_tileBrush"
                                                    ValueChanged="OnBrushChanged"
                                                    Size="Size.Small"
                                                    Class="march-map-tool-toggle"
                                                    SelectionMode="SelectionMode.SingleSelection"
                                                    CheckMark="false">
                                        <MudToggleItem Value="@("color")" Text="@(L["Color"])" />
                                        <MudToggleItem Value="@("deploy")" Text="@(L["Deploy"])" />
                                        <MudToggleItem Value="@("difficult")" Text="@(L["Difficult"])" />
                                        <MudToggleItem Value="@("impassable")">
                                            <span class="bbm-toggle-twoline">@L["Impass"]<br />able</span>
                                        </MudToggleItem>
                                        <MudToggleItem Value="@("normal")" Text="@(L["Clear cell"])" />
                                    </MudToggleGroup>
                                    @if (_tileBrush == "color")
                                    {
                                        <div class="bbm-swatches">
                                            @foreach (var swatch in Swatches)
                                            {
                                                <button type="button"
                                                        class="bbm-swatch @(_currentColor == swatch ? "selected" : null)"
                                                        style="background:@swatch"
                                                        title="@swatch"
                                                        @onclick="() => _currentColor = swatch"></button>
                                            }
                                        </div>
                                    }
                                }
                                @if (_tool == "text" && _selectedCell is not null)
                                {
                                    <MudTextField T="string"
                                                  Label="@($"Text ({FormatCell(_selectedCell.Value.X, _selectedCell.Value.Y)})")"
                                                  Value="@GetCellText(_selectedCell.Value.X, _selectedCell.Value.Y)"
                                                  ValueChanged="OnCellTextMudChanged"
                                                  Immediate="false"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                }
                                <MudButton Variant="Variant.Outlined"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           Class="march-map-toolbar__btn"
                                           OnClick="ClearMap">
                                    @L["Clear map"]
                                </MudButton>
                            </div>
                        }
                    </aside>
                }

                <BaronyBattleMapGrid Width="Map.Width"
                                     Height="Map.Height"
                                     Cells="Map.Cells"
                                     Tokens="Map.Tokens"
                                     SelectedTokenId="@_selectedTokenId"
                                     ActiveTokenId="@ActiveTokenId"
                                     RangeCells="@_rangeCells"
                                     Interactive="@(!_isResolvingMovement && !_isResolvingCombat && _facingEditTokenId is null && _chargeEditTokenId is null)"
                                     ShowActiveMoveBadge="@(IsMovementPhase && !_isResolvingMovement)"
                                     AnimatingTokens="@_animFrames"
                                     AnimTransitions="@_animTransitionsOn"
                                     PlannedRoutes="@_plannedRoutes"
                                     FogEnemyPlans="@FogEnemyMovementPlans"
                                     CombatAnimActive="@_combatAnimActive"
                                     CombatFocusAttackerId="@_combatFocusAttackerId"
                                     CombatFx="@_combatFx"
                                     ShowDeployZone="@IsSetupPhase"
                                     AllowSetupFacing="@IsSetupPhase"
                                     AllowActiveOrders="@(ActiveToken is null || CanControlToken(ActiveToken))"
                                     ShowThreatRadius="@_showThreatRadius"
                                     ThreatFactor="@TokenThreatFactor"
                                     FacingEditTokenId="@_facingEditTokenId"
                                     FacingPreviewDegrees="@_facingPreviewDeg"
                                     ChargeEditTokenId="@_chargeEditTokenId"
                                     ChargePreviewCells="@_chargePreviewCells"
                                     OnCellClick="HandleCellClick"
                                     OnFacingButton="StartFacingEdit"
                                     OnChargeButton="StartChargeEdit"
                                     AllowFullDefense="@(IsMovementPhase && !_isResolvingCombat && !_isResolvingMovement && (CanEdit || CanManageAsMg))"
                                     AllowCommanderActives="@((IsAttackPlanningPhase || IsCombatPhase) && !_isResolvingCombat && !_isResolvingMovement && (CanEdit || CanManageAsMg))"
                                     OnActivateAbility="ActivateCommanderAbility"
                                     OnFacingPreview="OnFacingPreview"
                                     OnFacingConfirm="ConfirmFacingEdit"
                                     OnChargeConfirm="ConfirmChargeEdit" />

                @if (WaitingForOpponentOrder
                     || WaitingForMovementResolve
                     || (IsAttackPlanningPhase && !_isResolvingCombat && CanManageAsMg)
                     || (IsAttackPlanningPhase && !_isResolvingCombat && CanEdit && Map.TurnState.BaronPhaseReady))
                {
                    <div class="bbm-map-overlay-status">
                        @if (WaitingForOpponentOrder)
                        {
                            <span class="bbm-map-wait">
                                Enemy order: @ActiveToken!.Label — waiting for the Game Master.
                            </span>
                        }
                        else if (WaitingForMovementResolve)
                        {
                            <span class="bbm-map-wait">
                                @L["All movement orders set — waiting for the Game Master to resolve."]
                            </span>
                        }
                        else if (IsAttackPlanningPhase && CanManageAsMg)
                        {
                            @if (Map.TurnState.BaronPhaseReady)
                            {
                                <span class="bbm-map-ready">@L["Baron is ready"]</span>
                            }
                            else
                            {
                                <span class="bbm-map-wait">@L["Waiting for baron ready"]</span>
                            }
                        }
                        else if (IsAttackPlanningPhase && CanEdit && Map.TurnState.BaronPhaseReady)
                        {
                            <span class="bbm-map-ready">
                                @L["Ready — waiting for the Game Master to begin combat."]
                            </span>
                        }
                    </div>
                }

                @if (ShowMovementControls
                     || (CanManageAsMg && IsSetupPhase)
                     || (CanManageAsMg && IsMovementPhase && !_isResolvingMovement && !_isResolvingCombat)
                     || (CanManageAsMg && IsCombatPhase)
                     || (IsAttackPlanningPhase && (CanEdit || CanManageAsMg) && !_isResolvingCombat))
                {
                    <div class="bbm-map-overlay-actions">
                        @if (CanManageAsMg && IsSetupPhase)
                        {
                            <button type="button"
                                    class="bbm-map-btn bbm-map-btn--solid"
                                    @onclick="BeginBattle">
                                @L["Begin battle"]
                            </button>
                        }
                        @if (ShowMovementControls)
                        {
                            <button type="button"
                                    class="bbm-map-btn bbm-map-btn--solid"
                                    @onclick="FinishMove"
                                    disabled="@(_isResolvingMovement || _isResolvingCombat)">
                                @L["Finish move"]
                            </button>
                            @if (CanUndoMove)
                            {
                                <button type="button"
                                        class="bbm-map-btn bbm-map-btn--ghost"
                                        @onclick="UndoMoveStep">
                                    @L["Undo"]
                                </button>
                            }
                        }
                        @if (CanManageAsMg && IsMovementPhase)
                        {
                            <button type="button"
                                    class="bbm-map-btn @(AllMovementOrdersFinished ? "bbm-map-btn--solid" : "bbm-map-btn--ghost")"
                                    @onclick="ResolveMovementPhase"
                                    disabled="@(_isResolvingMovement || _isResolvingCombat)">
                                @L["Resolve all movement"]
                            </button>
                        }
                        @if (CanManageAsMg && IsCombatPhase)
                        {
                            <button type="button"
                                    class="bbm-map-btn bbm-map-btn--solid"
                                    @onclick="EndCombatPhase"
                                    disabled="@(_isResolvingMovement || _isResolvingCombat)">
                                @L["End combat / next round"]
                            </button>
                        }
                        @if (CanManageAsMg && IsBattlePhase)
                        {
                            <button type="button"
                                    class="bbm-map-btn bbm-map-btn--end-battle bbm-map-btn--compact"
                                    @onclick="EndBattle"
                                    disabled="@(_isResolvingMovement || _isResolvingCombat)">
                                @L["End battle"]
                            </button>
                        }
                        @if (IsAttackPlanningPhase && !_isResolvingCombat)
                        {
                            @if (CanEdit || CanManageAsMg)
                            {
                                <button type="button"
                                        class="bbm-map-btn bbm-map-btn--ghost bbm-map-btn--compact"
                                        @onclick="AutoAssignAttackTargets">
                                    @L["Auto-assign attacks"]
                                </button>
                            }
                            @if (CanManageAsMg)
                            {
                                <button type="button"
                                        class="bbm-map-btn bbm-map-btn--solid bbm-map-btn--compact"
                                        @onclick="AdvanceToCombat">
                                    @L["Begin combat"]
                                </button>
                            }
                            else if (CanEdit && !Map.TurnState.BaronPhaseReady)
                            {
                                <button type="button"
                                        class="bbm-map-btn bbm-map-btn--solid bbm-map-btn--compact"
                                        @onclick="MarkBaronPhaseReady">
                                    @L["I'm ready"]
                                </button>
                            }
                        }
                    </div>
                }

                @if (_battleLogCollapsed)
                {
                    <button type="button"
                            class="bbm-map-log-toggle"
                            title="Show battle log"
                            @onclick="() => _battleLogCollapsed = false">
                        <span class="bbm-map-log-toggle__icon" aria-hidden="true"></span>
                        <span class="bbm-map-log-toggle__label">@L["Log"]</span>
                    </button>
                }
                else
                {
                    <div class="bbm-map-log">
                        <div class="bbm-map-log__head">
                            <span class="bbm-map-log__title">@L["Battle log"]</span>
                            <button type="button"
                                    class="bbm-map-log__hide"
                                    title="Hide battle log"
                                    @onclick="() => _battleLogCollapsed = true">
                                ▾
                            </button>
                        </div>
                        <div class="bbm-map-log__entries">
                            @foreach (var entry in Map.Log.OrderByDescending(e => e.Utc).Take(40))
                            {
                                var isChat = string.Equals(entry.Kind, "chat", StringComparison.OrdinalIgnoreCase);
                                <div class="bbm-map-log__entry bbm-map-log__entry--@(isChat ? "chat" : "auto") bbm-map-log__entry--@entry.Kind">
                                    @if (isChat && !string.IsNullOrWhiteSpace(entry.Author))
                                    {
                                        <span class="bbm-map-log__author">@entry.Author</span>
                                    }
                                    <span class="bbm-map-log__text">@FormatLogText(entry.Text)</span>
                                </div>
                            }
                            @if (Map.Log.Count == 0)
                            {
                                <div class="bbm-map-log__empty">@L["No entries yet."]</div>
                            }
                        </div>
                        <div class="bbm-map-log__chat">
                            <input class="bbm-input bbm-map-log__input" placeholder="Message…" @bind="_chatDraft" @onkeydown="OnChatKey" />
                            <button type="button" class="bbm-map-btn bbm-map-btn--ghost bbm-map-log__send" @onclick="SendChat">@L["Send"]</button>
                        </div>
                    </div>
                }
            </section>

            <aside class="bbm-side-pane">
                <BaronySection Title="@(L["Your forces"])">
                    <div class="bbm-force-list">
                        @foreach (var unit in _activeUnits)
                        {
                            var onMap = Map.Tokens.FirstOrDefault(t => t.UnitId == unit.Id);
                            var stats = UnitStatHelper.Compute(unit);
                            var iconKey = GetAllyIconKey(unit.Id);
                            var iconPath = BattleTokenIconCatalog.PathFor(iconKey);
                            var isBroken = unit.CurrentHp <= 0;
                            var hpNow = onMap?.Hp ?? Math.Max(0, unit.CurrentHp);
                            var hpMax = onMap?.MaxHp > 0 ? onMap.MaxHp : stats.MaxHp;
                            <div class="bbm-force-card @(onMap is not null ? "on-map" : null) @(isBroken ? "broken" : null) @(_deployUnitId == unit.Id ? "picked" : null)">
                                <div class="bbm-force-card__top">
                                    <button type="button"
                                            class="bbm-force-icon-btn"
                                            title="Change icon"
                                            @onclick="() => OpenAllyIconPicker(unit.Id)"
                                            @onclick:stopPropagation="true">
                                        @if (!string.IsNullOrEmpty(iconPath))
                                        {
                                            <img src="/@iconPath" alt="" />
                                        }
                                        else
                                        {
                                            <span>?</span>
                                        }
                                    </button>
                                    <div class="bbm-force-card__identity">
                                        <strong class="bbm-force-card__name bbm-name--ally">@unit.Name</strong>
                                        <span class="bbm-force-card__hp">HP @hpNow/@hpMax@(isBroken ? " — fled" : "")</span>
                                        @if (onMap is not null)
                                        {
                                            @ForceStatusBadges(onMap)
                                        }
                                    </div>
                                    <div class="bbm-force-card__actions">
                                        @if (onMap is null && IsSetupPhase && CanEdit && !isBroken)
                                        {
                                            <button type="button"
                                                    class="barony-turn-btn--ghost bbm-mini-btn"
                                                    @onclick="() => PickDeployUnit(unit.Id)">
                                                @(_deployUnitId == unit.Id ? "Click deploy…" : "Deploy")
                                            </button>
                                        }
                                        else if (onMap is not null && IsSetupPhase && CanEdit)
                                        {
                                            <button type="button"
                                                    class="barony-turn-btn--ghost bbm-mini-btn"
                                                    @onclick="() => RecallUnit(unit.Id)">
                                                @L["Recall"]
                                            </button>
                                        }
                                    </div>
                                </div>
                                <div class="bbm-force-card__stats">
                                    @{
                                        var unitPierce = UnitWeaponCatalog.Find(unit.Weapon1Key)?.Pierce ?? 0;
                                        var allyAtk = onMap?.Attack ?? stats.Attack;
                                        var allyDef = onMap?.Defense ?? stats.Defense;
                                        var allyArm = onMap?.Armor ?? stats.Armor;
                                        var allyMv = onMap?.Move ?? stats.Move;
                                        var allyFullDef = onMap?.FullDefense == true;
                                        var allyIronclad = onMap?.IroncladActive == true;
                                        var allyAtkEff = allyAtk - (allyFullDef ? BattleMovementRules.FullDefenseAttackPenalty : 0);
                                        var allyDefEff = allyDef + (allyFullDef ? BattleMovementRules.FullDefenseDefenseBonus : 0);
                                        var allyArmEff = allyArm + (allyIronclad ? 2 : 0);
                                        var allyMvEff = allyFullDef ? 0 : allyMv;
                                    }
                                    <span class="@(allyFullDef ? "bbm-force-stat--down" : null)">Atk @(allyFullDef ? $"{allyAtkEff} (−{BattleMovementRules.FullDefenseAttackPenalty})" : allyAtk.ToString())</span> ·
                                    <span class="@(allyFullDef ? "bbm-force-stat--boost" : null)">Def @(allyFullDef ? $"{allyDefEff} (+{BattleMovementRules.FullDefenseDefenseBonus})" : allyDefEff.ToString())</span> ·
                                    Dmg @(onMap?.Damage ?? stats.Damage) ·
                                    <span class="@(allyIronclad ? "bbm-force-stat--boost" : null)">Arm @(allyIronclad ? $"{allyArmEff} (+2)" : allyArmEff.ToString())</span>@(unitPierce > 0 ? $" · Prc {unitPierce}" : "") ·
                                    Disc @(onMap?.Discipline ?? unit.Discipline) ·
                                    <span class="@(allyFullDef ? "bbm-force-stat--down" : null)">Mv @allyMvEff</span> ·
                                    @(onMap?.TroopCount ?? unit.TroopCount) men
                                </div>
                                @if (onMap is not null)
                                {
                                    @CommanderAbilityBadges(onMap)
                                }
                            </div>
                        }
                        @if (_activeUnits.Count == 0)
                        {
                            <p class="bbm-empty">@L["No Active units in Army."]</p>
                        }
                    </div>
                </BaronySection>

                <BaronySection Title="@(L["Enemy forces"])">
                    <div class="bbm-force-list">
                        @foreach (var enemy in Map.Tokens.Where(t => t.IsEnemy))
                        {
                            var iconPath = BattleTokenIconCatalog.PathFor(enemy.IconKey);
                            <div class="bbm-force-card enemy @(_selectedTokenId == enemy.Id ? "picked" : null) @(_editingEnemyTokenId == enemy.Id ? "editing" : null)"
                                 @onclick="() => SelectToken(enemy.Id)">
                                <div class="bbm-force-card__top">
                                    <button type="button"
                                            class="bbm-force-icon-btn"
                                            title="@(CanManageAsMg ? "Change icon" : enemy.Label)"
                                            disabled="@(!CanManageAsMg)"
                                            @onclick="() => OpenEnemyIconPicker(enemy.Id)"
                                            @onclick:stopPropagation="true">
                                        @if (!string.IsNullOrEmpty(iconPath))
                                        {
                                            <img src="/@iconPath" alt="" />
                                        }
                                        else
                                        {
                                            <span>?</span>
                                        }
                                    </button>
                                    <div class="bbm-force-card__identity">
                                        <strong class="bbm-force-card__name bbm-name--enemy">@enemy.Label</strong>
                                        <span class="bbm-force-card__hp">HP @enemy.Hp/@enemy.MaxHp</span>
                                        @ForceStatusBadges(enemy)
                                    </div>
                                    @if (CanManageAsMg)
                                    {
                                        <span @onclick:stopPropagation="true">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Size="Size.Small"
                                                           Color="Color.Default"
                                                           title="Edit enemy"
                                                           OnClick="@(() => BeginEditEnemy(enemy.Id))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Size="Size.Small"
                                                           Color="Color.Error"
                                                           title="Remove enemy"
                                                           OnClick="@(() => RemoveEnemyTokenAsync(enemy.Id))" />
                                        </span>
                                    }
                                </div>
                                <div class="bbm-force-card__stats">
                                    @{
                                        var enemyDefEff = enemy.Defense + (enemy.FullDefense ? BattleMovementRules.FullDefenseDefenseBonus : 0);
                                        var enemyAtkEff = enemy.Attack - (enemy.FullDefense ? BattleMovementRules.FullDefenseAttackPenalty : 0);
                                        var enemyArmEff = enemy.Armor + (enemy.IroncladActive ? 2 : 0);
                                        var enemyMvEff = enemy.FullDefense ? 0 : enemy.Move;
                                    }
                                    <span class="@(enemy.FullDefense ? "bbm-force-stat--down" : null)">Atk @(enemy.FullDefense ? $"{enemyAtkEff} (−{BattleMovementRules.FullDefenseAttackPenalty})" : enemy.Attack.ToString())</span> ·
                                    <span class="@(enemy.FullDefense ? "bbm-force-stat--boost" : null)">Def @(enemy.FullDefense ? $"{enemyDefEff} (+{BattleMovementRules.FullDefenseDefenseBonus})" : enemyDefEff.ToString())</span> ·
                                    Dmg @enemy.Damage ·
                                    <span class="@(enemy.IroncladActive ? "bbm-force-stat--boost" : null)">Arm @(enemy.IroncladActive ? $"{enemyArmEff} (+2)" : enemyArmEff.ToString())</span>@(enemy.Pierce > 0 ? $" · Prc {enemy.Pierce}" : "") ·
                                    Disc @enemy.Discipline ·
                                    <span class="@(enemy.FullDefense ? "bbm-force-stat--down" : null)">Mv @enemyMvEff</span> ·
                                    @enemy.TroopCount men
                                </div>
                                @CommanderAbilityBadges(enemy)
                            </div>
                        }
                        @if (CanManageAsMg)
                        {
                            <div class="bbm-enemy-form @(_editingEnemyTokenId is not null ? "bbm-enemy-form--editing" : null)">
                                <div class="bbm-force-card__top bbm-enemy-form__top">
                                    <button type="button"
                                            class="bbm-force-icon-btn"
                                            title="Choose icon"
                                            @onclick="OpenDraftIconPicker">
                                        @{
                                            var draftPath = BattleTokenIconCatalog.PathFor(_enemyDraft.IconKey);
                                        }
                                        @if (!string.IsNullOrEmpty(draftPath))
                                        {
                                            <img src="/@draftPath" alt="" />
                                        }
                                        else
                                        {
                                            <span>?</span>
                                        }
                                    </button>
                                    <input class="bbm-input bbm-enemy-name" placeholder="Name" @bind="_enemyDraft.Label" />
                                    <button type="button"
                                            class="bbm-map-btn bbm-map-btn--ghost bbm-enemy-add-btn"
                                            @onclick="OpenEnemyAbilityDialogAsync">
                                        @L["Dodaj zdolnosc"]
                                    </button>
                                    @if (_editingEnemyTokenId is not null)
                                    {
                                        <button type="button"
                                                class="bbm-map-btn bbm-map-btn--ghost bbm-enemy-add-btn"
                                                @onclick="CancelEditEnemy">
                                            @L["Cancel"]
                                        </button>
                                        <button type="button"
                                                class="bbm-map-btn bbm-map-btn--solid bbm-enemy-add-btn"
                                                @onclick="SaveEditedEnemyAsync">
                                            @L["Edit"]
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="bbm-map-btn bbm-map-btn--solid bbm-enemy-add-btn" @onclick="AddEnemyToken">
                                            @L["Add"]
                                        </button>
                                    }
                                </div>
                                <div class="bbm-enemy-stats">
                                    <label>@L["Attack"] <input type="number" @bind="_enemyDraft.Attack" /></label>
                                    <label>@L["Defence"] <input type="number" @bind="_enemyDraft.Defense" /></label>
                                    <label>@L["Damage"] <input type="number" @bind="_enemyDraft.Damage" /></label>
                                    <label>HP <input type="number" @bind="_enemyDraft.Hp" /></label>
                                    <label>@L["Armor"] <input type="number" @bind="_enemyDraft.Armor" /></label>
                                    <label>@L["Discipline"] <input type="number" @bind="_enemyDraft.Discipline" /></label>
                                    <label>@L["Men"] <input type="number" @bind="_enemyDraft.TroopCount" /></label>
                                    <label>@L["Move"] <input type="number" @bind="_enemyDraft.Move" /></label>
                                    <label>@L["Range"] <input type="number" @bind="_enemyDraft.Range" title="0 = melee only; >0 = ranged unit" /></label>
                                    <label>@L["Pierce"] <input type="number" @bind="_enemyDraft.Pierce" title="Armor cut through by this unit's attacks; 0 = none" /></label>
                                    <label>
                                        @L["Mounted"]
                                        <input type="checkbox" @bind="_enemyDraft.Mounted" title="Needed for mount-based abilities" />
                                    </label>
                                </div>
                                @if (_enemyDraft.CommanderAbilities.Count > 0)
                                {
                                    <div class="bbm-enemy-abilities">
                                        @foreach (var key in _enemyDraft.CommanderAbilities)
                                        {
                                            var ab = CourtCommanderCatalog.Find(key);
                                            <span class="bbm-enemy-ability-chip" title="@(ab is null ? null : L[ab.DescriptionEn].Value)">
                                                @(L[ab?.NameEn ?? key])
                                                <button type="button"
                                                        title="Remove"
                                                        @onclick:stopPropagation="true"
                                                        @onclick="() => RemoveEnemyAbility(key)">
                                                    ×
                                                </button>
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else if (!Map.Tokens.Any(t => t.IsEnemy))
                        {
                            <p class="bbm-empty">@L["No enemies on the map yet."]</p>
                        }
                    </div>
                </BaronySection>

                <BaronySection Title="@(L["Actions"])">
                    @if (CanManageAsMg)
                    {
                        <div class="bbm-actions">
                            <div class="bbm-tool-row">
                                @if (Map.IsActive)
                                {
                                    <button type="button"
                                            class="bbm-map-btn bbm-map-btn--ghost"
                                            @onclick="() => OnActiveChanged(false)">
                                        @L["Hide map"]
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="bbm-map-btn bbm-map-btn--solid"
                                            @onclick="() => OnActiveChanged(true)">
                                        @L["Show map"]
                                    </button>
                                }
                            </div>
                            <p class="bbm-hint" style="margin-top:0.35rem;">
                                @(Map.IsActive
                                    ? "The baron can see this map and deploy units into the green zone."
                                    : "Show the map to the baron so they can deploy units before battle starts.")
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="bbm-actions">
                            <p class="bbm-hint">@BaronHint</p>
                        </div>
                    }

                    @if (IsBattlePhase && Map.TurnState.InitiativeOrder.Count > 0)
                    {
                        <p class="bbm-hint" style="margin-top:0.5rem;">
                            @(IsMovementPhase
                                ? "Plan a path: place destination, lock, optional facing turn (1 move). Or rotate in place with the facing icon. Use the bar below to undo or finish."
                                : IsAttackPlanningPhase
                                    ? "Select a unit, then click a highlighted enemy to assign an attack. Ranged units shoot at distance (no return fire) unless engaged in melee."
                                    : "Combat phase — damage is resolving; wait for the Game Master to advance.")
                        </p>
                        <ol class="bbm-initiative">
                            @for (var i = 0; i < Map.TurnState.InitiativeOrder.Count; i++)
                            {
                                var id = Map.TurnState.InitiativeOrder[i];
                                var tok = Map.Tokens.FirstOrDefault(t => t.Id == id);
                                if (tok is null) continue;
                                <li class="@(IsMovementPhase && i == Map.TurnState.CurrentIndex ? "current" : null)">
                                    <span class="bbm-init-side @(tok.IsEnemy ? "enemy" : "ally")">@(tok.IsEnemy ? "E" : "B")</span>
                                    <span class="@(tok.IsEnemy ? "bbm-name--enemy" : "bbm-name--ally")">@tok.Label</span>
                                    <span class="bbm-force-meta">(@tok.InitiativeTotal)</span>
                                    @if (IsMovementPhase && tok.HasPath)
                                    {
                                        if (!FogEnemyMovementPlans || !tok.IsEnemy)
                                        {
                                            var end = tok.PlannedEnd();
                                            <span class="bbm-force-meta"> → @FormatCell(end.X, end.Y) (@tok.Path.Count step@(tok.Path.Count == 1 ? "" : "s"))</span>
                                        }
                                        else if (IsEnemyPlanRevealedToBaron(tok))
                                        {
                                            <span class="bbm-force-meta">@(IsFacingOnlyPlan(tok) ? " ↻ turning" : " → orders given")</span>
                                        }
                                    }
                                </li>
                            }
                        </ol>

                        var recentCombat = Map.Log
                            .Where(e => string.Equals(e.Kind, "combat", StringComparison.OrdinalIgnoreCase))
                            .OrderByDescending(e => e.Utc)
                            .Take(8)
                            .ToList();
                        @if (recentCombat.Count > 0)
                        {
                            <p class="bbm-hint" style="margin-top:0.6rem;">@L["Recent combat summary:"]</p>
                            <ul class="bbm-initiative" style="margin-top:0.2rem;">
                                @foreach (var entry in recentCombat)
                                {
                                    <li><span class="bbm-force-meta">@entry.Utc.ToLocalTime().ToString("HH:mm:ss")</span> @FormatLogText(entry.Text)</li>
                                }
                            </ul>
                        }
                    }
                </BaronySection>
            </aside>
        </div>
    </div>
}

@code {
    private BaronyBattleMapDTO? Map;
    private HubConnection? _hubConnection;
    private List<BaronyUnitDTO> _activeUnits = new();
    private List<AvailableAdvisorDTO> _courtiers = new();
    private readonly Dictionary<int, string> _allyIconKeys = new();

    private string _tool = "token";
    private string _tileBrush = "deploy";
    private string _currentColor = "#c4b896";
    private string? _selectedTokenId;
    private (int X, int Y)? _selectedCell;
    private int? _deployUnitId;
    private bool _placingEnemy;
    private bool _mapEditMode;
    private string _chatDraft = string.Empty;
    private HashSet<(int X, int Y)> _rangeCells = new();
    private EnemyDraft _enemyDraft = EnemyDraft.Default();
    private string? _editingEnemyTokenId;
    private bool _isResolvingMovement;
    private bool _isResolvingCombat;
    private bool _combatAnimActive;
    private string? _combatFocusAttackerId;
    private BattleCombatFx? _combatFx;
    private bool _animTransitionsOn;
    private List<BattleMoveAnimFrame> _animFrames = new();
    /// <summary>Full cell-by-cell routes (per token id) for drawing planned-path arrows.</summary>
    private Dictionary<string, List<(int X, int Y)>> _plannedRoutes = new();
    /// <summary>Cells of engaged enemies' threat zones, shown while planning a move out of contact.</summary>
    private string? _facingEditTokenId;
    private double? _facingPreviewDeg;
    private int _facingEditStartFacing;
    private string? _chargeEditTokenId;
    private HashSet<(int X, int Y)> _chargePreviewCells = new();
    private bool _battleLogCollapsed;
    private bool _showThreatRadius;
    private string? _shownXpSummaryId;
    /// <summary>Ally unitId → HP at Begin battle.</summary>
    private readonly Dictionary<int, int> _allyStartHp = new();
    /// <summary>Ally unitId → final HP (0 if fled).</summary>
    private readonly Dictionary<int, int> _allyOutcomeHp = new();
    /// <summary>Label → isEnemy, retained after flee so battle log can keep coloring names.</summary>
    private readonly Dictionary<string, bool> _unitNameIsEnemy = new(StringComparer.Ordinal);

    // Cell pitch in px for the animation layer = grid cell (64) + 1px grid gap, so
    // animated tokens stay aligned with the underlying grid columns/rows.
    private const int AnimCellPx = 65;
    private const int AnimTurnMs = 1000;
    /// <summary>Arrow + clash icon beat before floating damage.</summary>
    private const int CombatClashLeadMs = 500;
    /// <summary>Floating −HP numbers duration.</summary>
    private const int CombatDamageMs = 3000;
    /// <summary>Beat after a disengage hit clears, so the victim does not bolt the instant it lands.</summary>
    private const int DisengageHitHoldMs = 500;
    /// <summary>Threat circle radius = ThreatFactor × size × 0.5 cells (1.0 = exact footprint edge).</summary>
    private const double TokenThreatFactor = 0.82;

    /// <summary>
    /// Tiles a declared charge must actually cover to earn its bonus. Declaring one still needs
    /// the per-direction minimum (<see cref="MinChargeStepsForFacing"/>); this is the shorter
    /// distance that decides whether the run counted once it has happened.
    /// </summary>
    private const int ChargeSuccessSteps = 2;

    private static readonly string[] Swatches =
    {
        "#c4b896", "#8fbc8f", "#6b8cae", "#b87a5a",
        "#9c7a33", "#5c6b4a", "#8b3a3a", "#2f2a24",
        "#fbf8f1", "#78909c",
    };

    private bool IsSetupPhase =>
        string.Equals(Map?.Phase, BaronyBattlePhases.Setup, StringComparison.OrdinalIgnoreCase);

    private bool IsBattlePhase =>
        string.Equals(Map?.Phase, BaronyBattlePhases.Battle, StringComparison.OrdinalIgnoreCase);

    private bool IsMovementPhase =>
        IsBattlePhase
        && string.Equals(Map?.TurnState.SubPhase, BaronyBattleSubPhases.Movement, StringComparison.OrdinalIgnoreCase);

    private bool IsAttackPlanningPhase =>
        IsBattlePhase
        && string.Equals(Map?.TurnState.SubPhase, BaronyBattleSubPhases.AttackPlanning, StringComparison.OrdinalIgnoreCase);

    private bool IsCombatPhase =>
        IsBattlePhase
        && string.Equals(Map?.TurnState.SubPhase, BaronyBattleSubPhases.Combat, StringComparison.OrdinalIgnoreCase);

    private string PhaseLabel =>
        IsSetupPhase ? "Setup"
        : IsMovementPhase ? $"Battle — Movement (R{Map!.TurnState.Round})"
        : IsAttackPlanningPhase ? $"Battle — Attack Planning (R{Map!.TurnState.Round})"
        : IsCombatPhase ? $"Battle — Combat (R{Map!.TurnState.Round})"
        : "Battle";

    private string BaronHint =>
        IsSetupPhase
            ? "Deploy Active units into the green deployment zone, then wait for the Game Master to begin battle."
            : IsMovementPhase
                ? WaitingForMovementResolve
                    ? "All movement orders are set — wait for the Game Master to resolve movement."
                    : WaitingForOpponentOrder
                        ? $"Enemy order ({ActiveToken!.Label}) — wait for the Game Master to move it. After they finish, you will only see a short direction hint."
                        : "Your unit's order — plan its path and use Undo / Finish move at the bottom of the map."
                : IsAttackPlanningPhase
                    ? Map!.TurnState.BaronPhaseReady
                        ? "You are ready — wait for the Game Master to begin combat."
                        : "Assign attack targets for your units, then press I'm ready. Only the Game Master starts combat."
                    : "Combat phase — wait for the Game Master to end combat and start the next round.";

    private string? ActiveTokenId =>
        IsMovementPhase
        && Map is not null
        && Map.TurnState.InitiativeOrder.Count > 0
        && Map.TurnState.CurrentIndex >= 0
        && Map.TurnState.CurrentIndex < Map.TurnState.InitiativeOrder.Count
            ? Map.TurnState.InitiativeOrder[Map.TurnState.CurrentIndex]
            : null;

    private BaronyBattleTokenDTO? ActiveToken =>
        ActiveTokenId is null || Map is null
            ? null
            : Map.Tokens.FirstOrDefault(t => t.Id == ActiveTokenId);

    private bool ShowMovementControls =>
        IsMovementPhase
        && !_isResolvingMovement
        && ActiveToken is not null
        && CanControlToken(ActiveToken);

    /// <summary>Movement phase, but the unit on the clock is not ours to order.</summary>
    private bool WaitingForOpponentOrder =>
        IsMovementPhase
        && !_isResolvingMovement
        && !_isResolvingCombat
        && ActiveToken is not null
        && !CanControlToken(ActiveToken);

    /// <summary>Every unit has Finish move'd; Baron waits for MG to resolve.</summary>
    private bool AllMovementOrdersFinished =>
        IsMovementPhase
        && Map is not null
        && Map.TurnState.InitiativeOrder.Count > 0
        && Map.TurnState.CurrentIndex >= Map.TurnState.InitiativeOrder.Count;

    private bool WaitingForMovementResolve =>
        AllMovementOrdersFinished
        && !CanManageAsMg
        && !_isResolvingMovement
        && !_isResolvingCombat;

    /// <summary>
    /// Baron fog-of-war for enemy orders: hide unfinished plans, and after Finish move
    /// reveal only a short direction hint (or a facing-only badge) instead of the full ghost.
    /// </summary>
    private bool FogEnemyMovementPlans =>
        !CanManageAsMg
        && IsMovementPhase
        && !_isResolvingMovement;

    private bool CanUndoMove =>
        ShowMovementControls
        && ActiveToken is not null
        && (ActiveToken.HasPath
            || _facingEditTokenId == ActiveToken.Id
            || _chargeEditTokenId == ActiveToken.Id);

    protected override async Task OnInitializedAsync()
    {
        await LoadBaronyAsync();
        if (Barony is null)
            return;

        try
        {
            Map = await _battleMapRepo.GetOrCreate(BaronyId);
            EnsureBattleSubPhase();
            if (IsMovementPhase)
                _selectedTokenId = ActiveTokenId;
            var units = await _baronyRepo.GetUnits(BaronyId);
            _activeUnits = units.Where(u => u.IsActive).OrderBy(u => u.Name).ToList();
            _courtiers = await _baronyRepo.GetAvailableAdvisors(BaronyId);
            foreach (var u in _activeUnits)
            {
                if (!_allyIconKeys.ContainsKey(u.Id))
                    _allyIconKeys[u.Id] = "shield";
            }
            foreach (var t in Map.Tokens.Where(t => t.UnitId is int))
            {
                if (t.UnitId is int uid && !string.IsNullOrWhiteSpace(t.IconKey))
                    _allyIconKeys[uid] = t.IconKey!;
            }
            RefreshRange();
            await MaybeShowBaronXpSummaryAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load barony battle map");
            LoadError = "Battle map loading error: " + ex.Message;
        }

        await InitializeSignalR();
    }

    private async Task InitializeSignalR()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(_navigationManager.ToAbsoluteUri(ChatHub.HubUrl))
                .WithAutomaticReconnect()
                .Build();
            _hubConnection.On<int>("BaronyBattleMapUpdated", OnRemoteUpdate);
            if (_hubConnection.State == HubConnectionState.Disconnected)
                await _hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "SignalR init failed for barony battle map");
        }
    }

    private async Task OnRemoteUpdate(int baronyId)
    {
        if (baronyId != BaronyId)
            return;
        await InvokeAsync(async () =>
        {
            try
            {
                Map = await _battleMapRepo.GetOrCreate(BaronyId);
                EnsureBattleSubPhase();
                if (IsMovementPhase)
                    _selectedTokenId = ActiveTokenId;
                else if (_selectedTokenId is not null && Map.Tokens.All(t => t.Id != _selectedTokenId))
                    _selectedTokenId = null;
                RefreshRange();
                await MaybeShowBaronXpSummaryAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to refresh barony battle map");
            }
        });
    }

    private async Task OnActiveChanged(bool value)
    {
        if (Map is null || !CanManageAsMg)
            return;
        Map.IsActive = value;
        await SaveAsync(systemMessage: value
            ? "Battle Map shown to the baron — deployment is open."
            : "Battle Map hidden from the baron (state kept).");
    }

    private void SetTool(string tool)
    {
        _tool = tool;
        _deployUnitId = null;
        _placingEnemy = false;
    }

    private Task OnPaintToolChanged(string tool)
    {
        SetTool(tool);
        return Task.CompletedTask;
    }

    private Task OnBrushChanged(string brush)
    {
        _tileBrush = brush;
        return Task.CompletedTask;
    }

    private void ToggleMapEdit()
    {
        _mapEditMode = !_mapEditMode;
        if (_mapEditMode)
        {
            _tool = "tiles";
            _deployUnitId = null;
            _placingEnemy = false;
        }
        else
        {
            _tool = "token";
            _selectedCell = null;
        }
    }

    private void SetBrush(string brush) => _tileBrush = brush;

    private string ToolBtn(string tool) =>
        $"bbm-mini-btn {( _tool == tool ? "barony-turn-btn--solid" : "barony-turn-btn--ghost")}";

    private string BrushBtn(string brush) =>
        $"bbm-mini-btn {( _tileBrush == brush ? "barony-turn-btn--solid" : "barony-turn-btn--ghost")}";

    private async Task OnCellTextMudChanged(string value)
    {
        if (Map is null || _selectedCell is null)
            return;
        var cell = GetOrAddCell(_selectedCell.Value.X, _selectedCell.Value.Y);
        cell.Text = value;
        cell.TextColor = _currentColor;
        CleanupCell(cell);
        await SaveAsync();
    }

    private void PickDeployUnit(int unitId)
    {
        var unit = _activeUnits.FirstOrDefault(u => u.Id == unitId);
        if (unit is null)
            return;
        if (unit.CurrentHp <= 0)
        {
            _snackBar.Add("Broken units (0 HP) cannot be deployed.", Severity.Warning);
            return;
        }
        _deployUnitId = unitId;
        _placingEnemy = false;
        _selectedTokenId = null;
        _tool = "token";
    }

    private string GetAllyIconKey(int unitId) =>
        _allyIconKeys.TryGetValue(unitId, out var key) ? key : "shield";

    private async Task OpenIconPickerAsync(string? currentKey, Func<string, Task> onPicked)
    {
        var parameters = new DialogParameters
        {
            [nameof(BattleTokenIconPickerDialog.SelectedKey)] = currentKey ?? "shield",
        };
        var dialog = await _dialogService.ShowAsync<BattleTokenIconPickerDialog>(
            "Choose icon",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not string key || string.IsNullOrWhiteSpace(key))
            return;
        await onPicked(key);
    }

    private Task OpenAllyIconPicker(int unitId) =>
        OpenIconPickerAsync(GetAllyIconKey(unitId), key => ApplyAllyIconAsync(unitId, key));

    private Task OpenEnemyIconPicker(string tokenId) =>
        OpenIconPickerAsync(
            Map?.Tokens.FirstOrDefault(t => t.Id == tokenId)?.IconKey,
            key => ApplyEnemyIconAsync(tokenId, key));

    private Task OpenDraftIconPicker() =>
        OpenIconPickerAsync(_enemyDraft.IconKey, key =>
        {
            _enemyDraft.IconKey = key;
            return Task.CompletedTask;
        });

    private async Task ApplyAllyIconAsync(int unitId, string key)
    {
        _allyIconKeys[unitId] = key;
        if (Map is null)
            return;
        var token = Map.Tokens.FirstOrDefault(t => t.UnitId == unitId);
        if (token is not null)
        {
            token.IconKey = key;
            await SaveAsync();
        }
    }

    private async Task ApplyEnemyIconAsync(string tokenId, string key)
    {
        if (Map is null || !CanManageAsMg)
            return;
        var token = Map.Tokens.FirstOrDefault(t => t.Id == tokenId);
        if (token is null)
            return;
        token.IconKey = key;
        await SaveAsync();
    }

    private void SelectToken(string id)
    {
        _selectedTokenId = _selectedTokenId == id ? null : id;
        RefreshRange();
    }

    private async Task HandleCellClick((int X, int Y) pos)
    {
        if (Map is null)
            return;
        var (x, y) = pos;

        if (_deployUnitId is int deployId && IsSetupPhase && CanEdit)
        {
            await DeployAllyAt(deployId, x, y);
            return;
        }

        if (_placingEnemy && CanManageAsMg && IsSetupPhase)
        {
            await PlacePendingEnemy(x, y);
            return;
        }

        if (CanManageAsMg && _mapEditMode && _tool == "tiles")
        {
            await PaintTile(x, y);
            return;
        }

        if (CanManageAsMg && _mapEditMode && _tool == "text")
        {
            _selectedCell = (x, y);
            var cell = GetOrAddCell(x, y);
            cell.TextColor = _currentColor;
            await SaveAsync();
            return;
        }

        if (CanManageAsMg && _mapEditMode && _tool == "erase")
        {
            var cell = GetCell(x, y);
            if (cell is not null)
                Map.Cells.Remove(cell);
            var tok = GetTokenAt(x, y);
            if (tok is not null)
                Map.Tokens.Remove(tok);
            await SaveAsync();
            RefreshRange();
            return;
        }

        // Attack planning: select token, then click a valid opponent to assign target
        if (IsAttackPlanningPhase)
        {
            var planClicked = GetTokenAt(x, y);

            // If an attacker is already selected and we clicked an opposing token
            if (_selectedTokenId is not null && planClicked is not null)
            {
                var attacker = Map.Tokens.FirstOrDefault(t => t.Id == _selectedTokenId);
                if (attacker is not null && attacker.IsEnemy != planClicked.IsEnemy && CanControlToken(attacker))
                {
                    if (!CanTarget(attacker, planClicked))
                    {
                        if (attacker.Range > 0 && IsPinned(attacker) && !AreAdjacent(attacker, planClicked))
                            _snackBar.Add($"{attacker.Label} is engaged — can only fight adjacent enemies.", Severity.Warning);
                        else if (attacker.Range > 0)
                            _snackBar.Add("Target is out of range.", Severity.Warning);
                        else
                            _snackBar.Add("Unit is not adjacent to the selected target.", Severity.Warning);
                    }
                    else
                    {
                        // Charge attacks are locked after movement resolve — no clear/retarget.
                        if (IsLockedChargeAttack(attacker))
                        {
                            _snackBar.Add(
                                $"{attacker.Label}'s charge attack is locked and cannot be changed.",
                                Severity.Warning);
                            RefreshRange();
                            return;
                        }

                        // Toggle: click same target again to clear
                        var nextTarget = attacker.AttackTargetId == planClicked.Id ? null : planClicked.Id;
                        attacker.AttackTargetId = nextTarget;
                        if (nextTarget is null
                            || !string.Equals(nextTarget, attacker.ChargeTargetId, StringComparison.Ordinal))
                        {
                            attacker.ChargeBonus = false;
                            attacker.ChargeBlind = false;
                            attacker.ChargeTargetId = null;
                        }
                        ClearBaronPhaseReadyIfPlayer();
                        var msg = attacker.AttackTargetId is null
                            ? $"{attacker.Label} cleared attack order."
                            : IsShotAt(attacker, planClicked)
                                ? $"{attacker.Label} shoot target: {planClicked.Label}{ShotPenaltyLabel(attacker, planClicked)}"
                                : $"{attacker.Label} attack target: {planClicked.Label}";
                        await SaveAsync(systemMessage: msg);
                    }
                    RefreshRange();
                    return;
                }
            }

            // Otherwise: select / deselect the clicked token
            if (planClicked is not null)
            {
                if (CanSelectToken(planClicked))
                    _selectedTokenId = planClicked.Id == _selectedTokenId ? null : planClicked.Id;
            }
            else
            {
                _selectedTokenId = null;
            }
            RefreshRange();
            return;
        }

        // Movement / selection
        var clicked = GetTokenAt(x, y);
        if (_selectedTokenId is not null)
        {
            var selected = Map.Tokens.FirstOrDefault(t => t.Id == _selectedTokenId);
            if (selected is not null && await TryMoveToken(selected, x, y))
                return;
        }

        if (clicked is not null && CanSelectToken(clicked))
        {
            if (IsMovementPhase)
            {
                // Keep focus on the unit whose order it is (range + move badge).
                if (clicked.Id == ActiveTokenId)
                    _selectedTokenId = ActiveTokenId;
            }
            else
            {
                _selectedTokenId = clicked.Id == _selectedTokenId ? null : clicked.Id;
            }
            RefreshRange();
        }
    }

    private async Task DeployAllyAt(int unitId, int x, int y)
    {
        if (Map is null)
            return;
        var unit = _activeUnits.FirstOrDefault(u => u.Id == unitId);
        if (unit is null)
            return;
        if (unit.CurrentHp <= 0)
        {
            _snackBar.Add("Broken units (0 HP) cannot be deployed.", Severity.Warning);
            _deployUnitId = null;
            return;
        }
        if (Map.Tokens.Any(t => t.UnitId == unitId))
        {
            _snackBar.Add("Unit already on the map.", Severity.Warning);
            return;
        }
        if (!IsDeployCell(x, y))
        {
            _snackBar.Add("Deploy only inside the deployment zone.", Severity.Warning);
            return;
        }
        if (!CanPlace(x, y, 1))
        {
            _snackBar.Add("Cell occupied.", Severity.Warning);
            return;
        }

        var stats = UnitStatHelper.Compute(unit);
        var token = new BaronyBattleTokenDTO
        {
            Id = Guid.NewGuid().ToString("N"),
            X = x,
            Y = y,
            Label = unit.Name,
            IconKey = GetAllyIconKey(unitId),
            IsEnemy = false,
            UnitId = unitId,
            Size = 1,
            Attack = stats.Attack,
            Defense = stats.Defense,
            Damage = stats.Damage,
            Hp = unit.CurrentHp > 0 ? unit.CurrentHp : stats.MaxHp,
            MaxHp = stats.MaxHp,
            Discipline = unit.Discipline,
            TroopCount = unit.TroopCount,
            Armor = stats.Armor,
            Move = Math.Max(0, stats.Move),
            RemainingMove = Math.Max(0, stats.Move),
            Range = Math.Max(0, UnitWeaponCatalog.Find(unit.Weapon1Key)?.Range ?? 0),
            Pierce = Math.Max(0, UnitWeaponCatalog.Find(unit.Weapon1Key)?.Pierce ?? 0),
        };
        ApplyCommanderBattleFlags(token, unit);
        Map.Tokens.Add(token);
        _deployUnitId = null;
        _selectedTokenId = token.Id;
        await SaveAsync(systemMessage: $"{token.Label} deployed at {FormatCell(x, y)}.");
        RefreshRange();
    }

    private async Task RecallUnit(int unitId)
    {
        if (Map is null || !IsSetupPhase)
            return;
        var token = Map.Tokens.FirstOrDefault(t => t.UnitId == unitId);
        if (token is null)
            return;
        Map.Tokens.Remove(token);
        await SaveAsync(systemMessage: $"{token.Label} recalled.");
        RefreshRange();
    }

    private async Task RemoveEnemyTokenAsync(string tokenId)
    {
        if (Map is null || !CanManageAsMg || string.IsNullOrWhiteSpace(tokenId))
            return;

        var token = Map.Tokens.FirstOrDefault(t => t.Id == tokenId && t.IsEnemy);
        if (token is null)
            return;

        var confirm = await _dialogService.ShowMessageBoxAsync(
            "Remove enemy?",
            $"Remove “{token.Label}” from the battle map?",
            yesText: "Remove",
            cancelText: "Cancel");
        if (confirm != true)
            return;

        if (_facingEditTokenId == token.Id)
            CancelFacingEdit();
        if (_selectedTokenId == token.Id)
            _selectedTokenId = null;
        if (string.Equals(_editingEnemyTokenId, token.Id, StringComparison.Ordinal))
            CancelEditEnemy();

        Map.Tokens.Remove(token);

        foreach (var other in Map.Tokens)
        {
            if (string.Equals(other.AttackTargetId, token.Id, StringComparison.Ordinal))
                other.AttackTargetId = null;
            if (string.Equals(other.ChargeTargetId, token.Id, StringComparison.Ordinal))
                ClearCharge(other);
            other.EngagedEnemyIds.Remove(token.Id);
        }

        if (Map.TurnState.InitiativeOrder.Count > 0)
        {
            Map.TurnState.InitiativeOrder = Map.TurnState.InitiativeOrder
                .Where(id => !string.Equals(id, token.Id, StringComparison.Ordinal))
                .ToList();
            if (Map.TurnState.CurrentIndex >= Map.TurnState.InitiativeOrder.Count)
                Map.TurnState.CurrentIndex = Math.Max(0, Map.TurnState.InitiativeOrder.Count - 1);
        }

        _plannedRoutes.Remove(token.Id);

        await SaveAsync(systemMessage: $"Enemy {token.Label} removed.");
        RefreshRange();
    }

    private void AddEnemyToken()
    {
        if (!CanManageAsMg || Map is null)
            return;
        if (_editingEnemyTokenId is not null)
            CancelEditEnemy();
        if (string.IsNullOrWhiteSpace(_enemyDraft.Label))
        {
            _snackBar.Add("Enemy name required.", Severity.Warning);
            return;
        }
        var abilityError = ValidateEnemyDraftAbilitiesSet();
        if (!string.IsNullOrWhiteSpace(abilityError))
        {
            _snackBar.Add(abilityError, Severity.Warning);
            return;
        }
        _placingEnemy = true;
        _deployUnitId = null;
        _tool = "token";
        _snackBar.Add("Click a cell to place the enemy token.", Severity.Info);
    }

    private void BeginEditEnemy(string tokenId)
    {
        if (!CanManageAsMg || Map is null || string.IsNullOrWhiteSpace(tokenId))
            return;

        var token = Map.Tokens.FirstOrDefault(t => t.Id == tokenId && t.IsEnemy);
        if (token is null)
