@page "/barony/battle-map"
@layout BaronyLayout
@inherits BaronyPageBase
@attribute [Authorize(Roles = SD.Role_Admin + "," + SD.Role_GameMaster + "," + SD.Role_DukePlayer)]
@using DA_Business.Repository.BaronyRepos
@using DA_Common.Barony
@using DA_Models.BaronyModels
@using DA_Models.ChatModels
@using Microsoft.AspNetCore.SignalR.Client
@inject IBaronyBattleMapRepository _battleMapRepo
@inject IDialogService _dialogService
@inject ILogger<BattleMapPage> Logger
@implements IAsyncDisposable

<PageTitle>Dagonite Empire | Battle Map</PageTitle>

@if (IsLoading)
{
    <MudProgressCircular Indeterminate="true" Size="Size.Small" /> <span>Loading battle map...</span>
}
else if (LoadError is not null)
{
    <MudAlert Severity="Severity.Info" Class="my-2">@LoadError</MudAlert>
}
else if (Map is null)
{
    <MudAlert Severity="Severity.Warning" Class="my-2">Could not load battle map.</MudAlert>
}
else if (!CanManageAsMg && !Map.IsActive)
{
    <MudAlert Severity="Severity.Info" Class="my-2">
        Battle Map is not active. The Game Master must enable it.
    </MudAlert>
}
else
{
    <div class="bbm-page">
        <BaronyPageHeader Title="Battle Map" ShowSectionToggle="false">
            <Summary>
                <span class="bbm-phase-chip">@PhaseLabel</span>
                @if (IsMovementPhase && ActiveToken is not null)
                {
                    <span class="bbm-turn-chip bbm-turn-chip--@(ActiveToken.IsEnemy ? "enemy" : "ally")">
                        @(ActiveToken.IsEnemy ? "Enemy order" : "Baron's order")
                        · @ActiveToken.Label
                        · @GetPlanBudget(ActiveToken) move left
                        @if (ActiveToken.HasPath)
                        {
                            var end = ActiveToken.PlannedEnd();
                            <text> → @FormatCell(end.X, end.Y)</text>
                        }
                    </span>
                }
                else if (IsCombatPhase)
                {
                    <span class="bbm-turn-chip">Round @Map.TurnState.Round — combat</span>
                }
            </Summary>
            <Actions>
                @if (CanManageAsMg)
                {
                    <MudSwitch T="bool"
                               Value="Map.IsActive"
                               ValueChanged="OnActiveChanged"
                               Color="Color.Default"
                               Label="Active"
                               Class="barony-page-header__sections-switch" />
                }
            </Actions>
        </BaronyPageHeader>

        <div class="bbm-layout">
            <section class="bbm-map-pane">
                @if (CanManageAsMg)
                {
                    <aside class="march-map-edit-panel march-map-toolbar--barony bbm-edit-panel @(_mapEditMode ? "march-map-edit-panel--expanded" : "")">
                        <div class="march-map-edit-panel__actions">
                            <MudButton Variant="@(_mapEditMode ? Variant.Filled : Variant.Outlined)"
                                       Size="Size.Small"
                                       Class="@(_mapEditMode ? "baron-influence-save-btn" : "march-map-toolbar__btn")"
                                       OnClick="ToggleMapEdit">
                                @(_mapEditMode ? "Editing" : "Map edit")
                            </MudButton>
                        </div>
                        @if (_mapEditMode)
                        {
                            <div class="march-map-edit-panel__body march-map-edit-panel__tools">
                                <MudToggleGroup T="string"
                                                Value="_tool"
                                                ValueChanged="OnPaintToolChanged"
                                                Size="Size.Small"
                                                Class="march-map-tool-toggle"
                                                SelectionMode="SelectionMode.SingleSelection"
                                                CheckMark="false">
                                    <MudToggleItem Value="@("tiles")" Text="Tiles" />
                                    <MudToggleItem Value="@("text")" Text="Text" />
                                    <MudToggleItem Value="@("erase")" Text="Eraser" />
                                </MudToggleGroup>

                                @if (_tool == "tiles")
                                {
                                    <MudToggleGroup T="string"
                                                    Value="_tileBrush"
                                                    ValueChanged="OnBrushChanged"
                                                    Size="Size.Small"
                                                    Class="march-map-tool-toggle"
                                                    SelectionMode="SelectionMode.SingleSelection"
                                                    CheckMark="false">
                                        <MudToggleItem Value="@("color")" Text="Color" />
                                        <MudToggleItem Value="@("deploy")" Text="Deploy" />
                                        <MudToggleItem Value="@("difficult")" Text="Difficult" />
                                        <MudToggleItem Value="@("impassable")">
                                            <span class="bbm-toggle-twoline">Impass<br />able</span>
                                        </MudToggleItem>
                                        <MudToggleItem Value="@("normal")" Text="Clear cell" />
                                    </MudToggleGroup>
                                    @if (_tileBrush == "color")
                                    {
                                        <div class="bbm-swatches">
                                            @foreach (var swatch in Swatches)
                                            {
                                                <button type="button"
                                                        class="bbm-swatch @(_currentColor == swatch ? "selected" : null)"
                                                        style="background:@swatch"
                                                        title="@swatch"
                                                        @onclick="() => _currentColor = swatch"></button>
                                            }
                                        </div>
                                    }
                                }
                                @if (_tool == "text" && _selectedCell is not null)
                                {
                                    <MudTextField T="string"
                                                  Label="@($"Text ({FormatCell(_selectedCell.Value.X, _selectedCell.Value.Y)})")"
                                                  Value="@GetCellText(_selectedCell.Value.X, _selectedCell.Value.Y)"
                                                  ValueChanged="OnCellTextMudChanged"
                                                  Immediate="false"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                }
                                <MudButton Variant="Variant.Outlined"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           Class="march-map-toolbar__btn"
                                           OnClick="ClearMap">
                                    Clear map
                                </MudButton>
                            </div>
                        }
                    </aside>
                }

                <BaronyBattleMapGrid Width="Map.Width"
                                     Height="Map.Height"
                                     Cells="Map.Cells"
                                     Tokens="Map.Tokens"
                                     SelectedTokenId="@_selectedTokenId"
                                     ActiveTokenId="@ActiveTokenId"
                                     RangeCells="@_rangeCells"
                                     Interactive="@(!_isResolvingMovement && _facingEditTokenId is null)"
                                     ShowActiveMoveBadge="@(IsMovementPhase && !_isResolvingMovement)"
                                     AnimatingTokens="@_animFrames"
                                     AnimTransitions="@_animTransitionsOn"
                                     FacingEditTokenId="@_facingEditTokenId"
                                     FacingPreviewDegrees="@_facingPreviewDeg"
                                     OnCellClick="HandleCellClick"
                                     OnFacingButton="StartFacingEdit"
                                     OnFacingPreview="OnFacingPreview"
                                     OnFacingConfirm="ConfirmFacingEdit" />

                @if (ShowMovementControls)
                {
                    <div class="bbm-map-overlay-actions">
                        <button type="button"
                                class="bbm-map-btn bbm-map-btn--solid"
                                @onclick="FinishMove"
                                disabled="@_isResolvingMovement">
                            Finish move
                        </button>
                        @if (CanUndoMove)
                        {
                            <button type="button"
                                    class="bbm-map-btn bbm-map-btn--ghost"
                                    @onclick="UndoMoveStep">
                                Undo
                            </button>
                        }
                    </div>
                }

                @if (_battleLogCollapsed)
                {
                    <button type="button"
                            class="bbm-map-log-toggle"
                            title="Show battle log"
                            @onclick="() => _battleLogCollapsed = false">
                        <span class="bbm-map-log-toggle__icon" aria-hidden="true"></span>
                        <span class="bbm-map-log-toggle__label">Log</span>
                    </button>
                }
                else
                {
                    <div class="bbm-map-log">
                        <div class="bbm-map-log__head">
                            <span class="bbm-map-log__title">Battle log</span>
                            <button type="button"
                                    class="bbm-map-log__hide"
                                    title="Hide battle log"
                                    @onclick="() => _battleLogCollapsed = true">
                                ▾
                            </button>
                        </div>
                        <div class="bbm-map-log__entries">
                            @foreach (var entry in Map.Log.OrderByDescending(e => e.Utc).Take(40))
                            {
                                <div class="bbm-map-log__entry bbm-map-log__entry--@entry.Kind">
                                    <span class="bbm-map-log__author">@entry.Author</span>
                                    <span class="bbm-map-log__text">@entry.Text</span>
                                </div>
                            }
                            @if (Map.Log.Count == 0)
                            {
                                <div class="bbm-map-log__empty">No entries yet.</div>
                            }
                        </div>
                        <div class="bbm-map-log__chat">
                            <input class="bbm-input bbm-map-log__input" placeholder="Message…" @bind="_chatDraft" @onkeydown="OnChatKey" />
                            <button type="button" class="bbm-map-btn bbm-map-btn--ghost bbm-map-log__send" @onclick="SendChat">Send</button>
                        </div>
                    </div>
                }
            </section>

            <aside class="bbm-side-pane">
                <BaronySection Title="Your forces">
                    <div class="bbm-force-list">
                        @foreach (var unit in _activeUnits)
                        {
                            var onMap = Map.Tokens.FirstOrDefault(t => t.UnitId == unit.Id);
                            var stats = UnitStatHelper.Compute(unit);
                            var iconKey = GetAllyIconKey(unit.Id);
                            var iconPath = BattleTokenIconCatalog.PathFor(iconKey);
                            var hpNow = onMap?.Hp ?? (unit.CurrentHp > 0 ? unit.CurrentHp : stats.MaxHp);
                            var hpMax = onMap?.MaxHp > 0 ? onMap.MaxHp : stats.MaxHp;
                            <div class="bbm-force-card @(onMap is not null ? "on-map" : null) @(_deployUnitId == unit.Id ? "picked" : null)">
                                <div class="bbm-force-card__top">
                                    <button type="button"
                                            class="bbm-force-icon-btn"
                                            title="Change icon"
                                            @onclick="() => OpenAllyIconPicker(unit.Id)"
                                            @onclick:stopPropagation="true">
                                        @if (!string.IsNullOrEmpty(iconPath))
                                        {
                                            <img src="/@iconPath" alt="" />
                                        }
                                        else
                                        {
                                            <span>?</span>
                                        }
                                    </button>
                                    <div class="bbm-force-card__identity">
                                        <strong class="bbm-force-card__name">@unit.Name</strong>
                                        <span class="bbm-force-card__hp">HP @hpNow/@hpMax</span>
                                    </div>
                                    <div class="bbm-force-card__actions">
                                        @if (onMap is null && IsSetupPhase && CanEdit)
                                        {
                                            <button type="button"
                                                    class="barony-turn-btn--ghost bbm-mini-btn"
                                                    @onclick="() => PickDeployUnit(unit.Id)">
                                                @(_deployUnitId == unit.Id ? "Click deploy…" : "Deploy")
                                            </button>
                                        }
                                        else if (onMap is not null && IsSetupPhase && CanEdit)
                                        {
                                            <button type="button"
                                                    class="barony-turn-btn--ghost bbm-mini-btn"
                                                    @onclick="() => RecallUnit(unit.Id)">
                                                Recall
                                            </button>
                                        }
                                    </div>
                                </div>
                                <div class="bbm-force-card__stats">
                                    Atk @stats.Attack · Def @stats.Defense · Dmg @stats.Damage · Arm @stats.Armor · Disc @unit.Discipline · Mv @stats.Move · @unit.TroopCount men
                                </div>
                            </div>
                        }
                        @if (_activeUnits.Count == 0)
                        {
                            <p class="bbm-empty">No Active units in Army.</p>
                        }
                    </div>
                </BaronySection>

                <BaronySection Title="Enemy forces">
                    <div class="bbm-force-list">
                        @foreach (var enemy in Map.Tokens.Where(t => t.IsEnemy))
                        {
                            var iconPath = BattleTokenIconCatalog.PathFor(enemy.IconKey);
                            <div class="bbm-force-card enemy @(_selectedTokenId == enemy.Id ? "picked" : null)"
                                 @onclick="() => SelectToken(enemy.Id)">
                                <div class="bbm-force-card__top">
                                    <button type="button"
                                            class="bbm-force-icon-btn"
                                            title="@(CanManageAsMg ? "Change icon" : enemy.Label)"
                                            disabled="@(!CanManageAsMg)"
                                            @onclick="() => OpenEnemyIconPicker(enemy.Id)"
                                            @onclick:stopPropagation="true">
                                        @if (!string.IsNullOrEmpty(iconPath))
                                        {
                                            <img src="/@iconPath" alt="" />
                                        }
                                        else
                                        {
                                            <span>?</span>
                                        }
                                    </button>
                                    <div class="bbm-force-card__identity">
                                        <strong class="bbm-force-card__name">@enemy.Label</strong>
                                        <span class="bbm-force-card__hp">HP @enemy.Hp/@enemy.MaxHp</span>
                                    </div>
                                </div>
                                <div class="bbm-force-card__stats">
                                    Atk @enemy.Attack · Def @enemy.Defense · Dmg @enemy.Damage · Arm @enemy.Armor · Disc @enemy.Discipline · Mv @enemy.Move · @enemy.TroopCount men
                                </div>
                            </div>
                        }
                        @if (CanManageAsMg)
                        {
                            <div class="bbm-enemy-form">
                                <div class="bbm-force-card__top">
                                    <button type="button"
                                            class="bbm-force-icon-btn"
                                            title="Choose icon"
                                            @onclick="OpenDraftIconPicker">
                                        @{
                                            var draftPath = BattleTokenIconCatalog.PathFor(_enemyDraft.IconKey);
                                        }
                                        @if (!string.IsNullOrEmpty(draftPath))
                                        {
                                            <img src="/@draftPath" alt="" />
                                        }
                                        else
                                        {
                                            <span>?</span>
                                        }
                                    </button>
                                    <input class="bbm-input bbm-enemy-name" placeholder="Name" @bind="_enemyDraft.Label" />
                                </div>
                                <div class="bbm-enemy-stats">
                                    <label>Atk <input type="number" @bind="_enemyDraft.Attack" /></label>
                                    <label>Def <input type="number" @bind="_enemyDraft.Defense" /></label>
                                    <label>Dmg <input type="number" @bind="_enemyDraft.Damage" /></label>
                                    <label>HP <input type="number" @bind="_enemyDraft.Hp" /></label>
                                    <label>Arm <input type="number" @bind="_enemyDraft.Armor" /></label>
                                    <label>Disc <input type="number" @bind="_enemyDraft.Discipline" /></label>
                                    <label>Men <input type="number" @bind="_enemyDraft.TroopCount" /></label>
                                    <label>Mv <input type="number" @bind="_enemyDraft.Move" /></label>
                                </div>
                                <button type="button" class="barony-turn-btn--solid bbm-mini-btn" @onclick="AddEnemyToken">
                                    Add enemy (click map to place)
                                </button>
                            </div>
                        }
                        else if (!Map.Tokens.Any(t => t.IsEnemy))
                        {
                            <p class="bbm-empty">No enemies on the map yet.</p>
                        }
                    </div>
                </BaronySection>

                <BaronySection Title="Actions">
                    @if (CanManageAsMg)
                    {
                        <div class="bbm-actions">
                            <div class="bbm-tool-row">
                                @if (IsSetupPhase)
                                {
                                    <button type="button" class="barony-turn-btn--solid bbm-mini-btn" @onclick="BeginBattle">Begin battle</button>
                                }
                                else
                                {
                                    <button type="button" class="barony-turn-btn--ghost bbm-mini-btn" @onclick="ReturnToSetup">Return to setup</button>
                                    @if (IsMovementPhase)
                                    {
                                        <button type="button" class="barony-turn-btn--ghost bbm-mini-btn" @onclick="ResolveMovementPhase" disabled="@_isResolvingMovement">Resolve all movement</button>
                                    }
                                    else if (IsCombatPhase)
                                    {
                                        <button type="button" class="barony-turn-btn--solid bbm-mini-btn" @onclick="EndCombatPhase">End combat / next round</button>
                                    }
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="bbm-actions">
                            <p class="bbm-hint">@BaronHint</p>
                        </div>
                    }

                    @if (IsBattlePhase && Map.TurnState.InitiativeOrder.Count > 0)
                    {
                        <p class="bbm-hint" style="margin-top:0.5rem;">
                            @(IsMovementPhase
                                ? "Plan a path: place destination, lock, optional facing turn (1 move). Use the bar below to undo or finish."
                                : "Combat phase (attacks coming later).")
                        </p>
                        <ol class="bbm-initiative">
                            @for (var i = 0; i < Map.TurnState.InitiativeOrder.Count; i++)
                            {
                                var id = Map.TurnState.InitiativeOrder[i];
                                var tok = Map.Tokens.FirstOrDefault(t => t.Id == id);
                                if (tok is null) continue;
                                <li class="@(IsMovementPhase && i == Map.TurnState.CurrentIndex ? "current" : null)">
                                    <span class="bbm-init-side @(tok.IsEnemy ? "enemy" : "ally")">@(tok.IsEnemy ? "E" : "B")</span>
                                    @tok.Label
                                    <span class="bbm-force-meta">(@tok.InitiativeTotal)</span>
                                    @if (IsMovementPhase && tok.HasPath)
                                    {
                                        var end = tok.PlannedEnd();
                                        <span class="bbm-force-meta"> → @FormatCell(end.X, end.Y) (@tok.Path.Count step@(tok.Path.Count == 1 ? "" : "s"))</span>
                                    }
                                </li>
                            }
                        </ol>
                    }
                </BaronySection>
            </aside>
        </div>
    </div>
}

@code {
    private BaronyBattleMapDTO? Map;
    private HubConnection? _hubConnection;
    private List<BaronyUnitDTO> _activeUnits = new();
    private readonly Dictionary<int, string> _allyIconKeys = new();

    private string _tool = "token";
    private string _tileBrush = "deploy";
    private string _currentColor = "#c4b896";
    private string? _selectedTokenId;
    private (int X, int Y)? _selectedCell;
    private int? _deployUnitId;
    private bool _placingEnemy;
    private bool _mapEditMode;
    private string _chatDraft = string.Empty;
    private HashSet<(int X, int Y)> _rangeCells = new();
    private EnemyDraft _enemyDraft = EnemyDraft.Default();
    private bool _isResolvingMovement;
    private bool _animTransitionsOn;
    private List<BattleMoveAnimFrame> _animFrames = new();
    private string? _facingEditTokenId;
    private double? _facingPreviewDeg;
    private int _facingEditStartFacing;
    private bool _battleLogCollapsed;

    private const int AnimCellPx = 50;
    private const int AnimHopMs = 1000;
    private const int AnimTurnMs = 1000;

    /// <summary>Milliseconds per tile; scales inversely with Move (Move 4 ≈ 700ms).</summary>
    private static int AnimCellMsFor(int move) =>
        Math.Clamp(2800 / Math.Max(1, move), 350, 1200);

    private static readonly string[] Swatches =
    {
        "#c4b896", "#8fbc8f", "#6b8cae", "#b87a5a",
        "#9c7a33", "#5c6b4a", "#8b3a3a", "#2f2a24",
        "#fbf8f1", "#78909c",
    };

    private bool IsSetupPhase =>
        string.Equals(Map?.Phase, BaronyBattlePhases.Setup, StringComparison.OrdinalIgnoreCase);

    private bool IsBattlePhase =>
        string.Equals(Map?.Phase, BaronyBattlePhases.Battle, StringComparison.OrdinalIgnoreCase);

    private bool IsMovementPhase =>
        IsBattlePhase
        && string.Equals(Map?.TurnState.SubPhase, BaronyBattleSubPhases.Movement, StringComparison.OrdinalIgnoreCase);

    private bool IsCombatPhase =>
        IsBattlePhase
        && string.Equals(Map?.TurnState.SubPhase, BaronyBattleSubPhases.Combat, StringComparison.OrdinalIgnoreCase);

    private string PhaseLabel =>
        IsSetupPhase ? "Setup"
        : IsMovementPhase ? $"Battle — Movement (R{Map!.TurnState.Round})"
        : IsCombatPhase ? $"Battle — Combat (R{Map!.TurnState.Round})"
        : "Battle";

    private string BaronHint =>
        IsSetupPhase
            ? "Deploy Active units into the green deployment zone, then wait for the Game Master to begin battle."
            : IsMovementPhase
                ? "Use Undo / Finish move at the bottom of the map. While testing, you may also move enemy units on their order."
                : "Combat phase — wait for the Game Master. Attacks will come in a later update.";

    private string? ActiveTokenId =>
        IsMovementPhase && Map is not null && Map.TurnState.InitiativeOrder.Count > 0
            ? Map.TurnState.InitiativeOrder[Math.Clamp(Map.TurnState.CurrentIndex, 0, Map.TurnState.InitiativeOrder.Count - 1)]
            : null;

    private BaronyBattleTokenDTO? ActiveToken =>
        ActiveTokenId is null || Map is null
            ? null
            : Map.Tokens.FirstOrDefault(t => t.Id == ActiveTokenId);

    private bool ShowMovementControls =>
        IsMovementPhase
        && !_isResolvingMovement
        && ActiveToken is not null
        && CanControlToken(ActiveToken);

    private bool CanUndoMove =>
        ShowMovementControls
        && ActiveToken is not null
        && ActiveToken.Path.Any(w => w.Locked);

    protected override async Task OnInitializedAsync()
    {
        await LoadBaronyAsync();
        if (Barony is null)
            return;

        try
        {
            Map = await _battleMapRepo.GetOrCreate(BaronyId);
            EnsureBattleSubPhase();
            if (IsMovementPhase)
                _selectedTokenId = ActiveTokenId;
            var units = await _baronyRepo.GetUnits(BaronyId);
            _activeUnits = units.Where(u => u.IsActive).OrderBy(u => u.Name).ToList();
            foreach (var u in _activeUnits)
            {
                if (!_allyIconKeys.ContainsKey(u.Id))
                    _allyIconKeys[u.Id] = "shield";
            }
            foreach (var t in Map.Tokens.Where(t => t.UnitId is int))
            {
                if (t.UnitId is int uid && !string.IsNullOrWhiteSpace(t.IconKey))
                    _allyIconKeys[uid] = t.IconKey!;
            }
            RefreshRange();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load barony battle map");
            LoadError = "Battle map loading error: " + ex.Message;
        }

        await InitializeSignalR();
    }

    private async Task InitializeSignalR()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(_navigationManager.ToAbsoluteUri(ChatHub.HubUrl))
                .WithAutomaticReconnect()
                .Build();
            _hubConnection.On<int>("BaronyBattleMapUpdated", OnRemoteUpdate);
            if (_hubConnection.State == HubConnectionState.Disconnected)
                await _hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "SignalR init failed for barony battle map");
        }
    }

    private async Task OnRemoteUpdate(int baronyId)
    {
        if (baronyId != BaronyId)
            return;
        await InvokeAsync(async () =>
        {
            try
            {
                Map = await _battleMapRepo.GetOrCreate(BaronyId);
                EnsureBattleSubPhase();
                if (IsMovementPhase)
                    _selectedTokenId = ActiveTokenId;
                else if (_selectedTokenId is not null && Map.Tokens.All(t => t.Id != _selectedTokenId))
                    _selectedTokenId = null;
                RefreshRange();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to refresh barony battle map");
            }
        });
    }

    private async Task OnActiveChanged(bool value)
    {
        if (Map is null || !CanManageAsMg)
            return;
        Map.IsActive = value;
        await SaveAsync(systemMessage: value ? "Battle Map activated." : "Battle Map deactivated (state kept).");
    }

    private void SetTool(string tool)
    {
        _tool = tool;
        _deployUnitId = null;
        _placingEnemy = false;
    }

    private Task OnPaintToolChanged(string tool)
    {
        SetTool(tool);
        return Task.CompletedTask;
    }

    private Task OnBrushChanged(string brush)
    {
        _tileBrush = brush;
        return Task.CompletedTask;
    }

    private void ToggleMapEdit()
    {
        _mapEditMode = !_mapEditMode;
        if (_mapEditMode)
        {
            _tool = "tiles";
            _deployUnitId = null;
            _placingEnemy = false;
        }
        else
        {
            _tool = "token";
            _selectedCell = null;
        }
    }

    private void SetBrush(string brush) => _tileBrush = brush;

    private string ToolBtn(string tool) =>
        $"bbm-mini-btn {( _tool == tool ? "barony-turn-btn--solid" : "barony-turn-btn--ghost")}";

    private string BrushBtn(string brush) =>
        $"bbm-mini-btn {( _tileBrush == brush ? "barony-turn-btn--solid" : "barony-turn-btn--ghost")}";

    private async Task OnCellTextMudChanged(string value)
    {
        if (Map is null || _selectedCell is null)
            return;
        var cell = GetOrAddCell(_selectedCell.Value.X, _selectedCell.Value.Y);
        cell.Text = value;
        cell.TextColor = _currentColor;
        CleanupCell(cell);
        await SaveAsync();
    }

    private void PickDeployUnit(int unitId)
    {
        _deployUnitId = unitId;
        _placingEnemy = false;
        _selectedTokenId = null;
        _tool = "token";
    }

