@page "/barony/battle-map"
@layout BaronyLayout
@inherits BaronyPageBase
@attribute [Authorize(Roles = SD.Role_Admin + "," + SD.Role_GameMaster + "," + SD.Role_DukePlayer)]
@using DA_Business.Repository.BaronyRepos
@using DA_Common.Barony
@using DA_Models.BaronyModels
@using DA_Models.ChatModels
@using Microsoft.AspNetCore.SignalR.Client
@inject IBaronyBattleMapRepository _battleMapRepo
@inject IDialogService _dialogService
@inject ILogger<BattleMapPage> Logger
@implements IAsyncDisposable

<PageTitle>Dagonite Empire | Battle Map</PageTitle>

@if (IsLoading)
{
    <MudProgressCircular Indeterminate="true" Size="Size.Small" /> <span>Loading battle map...</span>
}
else if (LoadError is not null)
{
    <MudAlert Severity="Severity.Info" Class="my-2">@LoadError</MudAlert>
}
else if (Map is null)
{
    <MudAlert Severity="Severity.Warning" Class="my-2">Could not load battle map.</MudAlert>
}
else if (!CanManageAsMg && !Map.IsActive)
{
    <MudAlert Severity="Severity.Info" Class="my-2">
        Battle Map is not active. The Game Master must enable it.
    </MudAlert>
}
else
{
    <div class="bbm-page">
        <BaronyPageHeader Title="Battle Map" ShowSectionToggle="false">
            <Summary>
                <span class="bbm-phase-chip">@PhaseLabel</span>
                @if (IsBattlePhase && ActiveToken is not null)
                {
                    <span class="bbm-turn-chip">Turn: @ActiveToken.Label (@ActiveToken.RemainingMove move left)</span>
                }
            </Summary>
            <Actions>
                @if (CanManageAsMg)
                {
                    <MudSwitch T="bool"
                               Value="Map.IsActive"
                               ValueChanged="OnActiveChanged"
                               Color="Color.Default"
                               Label="Active"
                               Class="barony-page-header__sections-switch" />
                }
            </Actions>
        </BaronyPageHeader>

        <div class="bbm-layout">
            <section class="bbm-map-pane">
                @if (CanManageAsMg)
                {
                    <aside class="march-map-edit-panel march-map-toolbar--barony bbm-edit-panel @(_mapEditMode ? "march-map-edit-panel--expanded" : "")">
                        <div class="march-map-edit-panel__actions">
                            <MudButton Variant="@(_mapEditMode ? Variant.Filled : Variant.Outlined)"
                                       Size="Size.Small"
                                       Class="@(_mapEditMode ? "baron-influence-save-btn" : "march-map-toolbar__btn")"
                                       OnClick="ToggleMapEdit">
                                @(_mapEditMode ? "Editing" : "Map edit")
                            </MudButton>
                        </div>
                        @if (_mapEditMode)
                        {
                            <div class="march-map-edit-panel__body march-map-edit-panel__tools">
                                <MudToggleGroup T="string"
                                                Value="_tool"
                                                ValueChanged="OnPaintToolChanged"
                                                Size="Size.Small"
                                                Class="march-map-tool-toggle"
                                                SelectionMode="SelectionMode.SingleSelection"
                                                CheckMark="false">
                                    <MudToggleItem Value="@("tiles")" Text="Tiles" />
                                    <MudToggleItem Value="@("text")" Text="Text" />
                                    <MudToggleItem Value="@("erase")" Text="Eraser" />
                                </MudToggleGroup>

                                @if (_tool == "tiles")
                                {
                                    <MudToggleGroup T="string"
                                                    Value="_tileBrush"
                                                    ValueChanged="OnBrushChanged"
                                                    Size="Size.Small"
                                                    Class="march-map-tool-toggle"
                                                    SelectionMode="SelectionMode.SingleSelection"
                                                    CheckMark="false">
                                        <MudToggleItem Value="@("color")" Text="Color" />
                                        <MudToggleItem Value="@("deploy")" Text="Deploy" />
                                        <MudToggleItem Value="@("difficult")" Text="Difficult" />
                                        <MudToggleItem Value="@("impassable")">
                                            <span class="bbm-toggle-twoline">Impass<br />able</span>
                                        </MudToggleItem>
                                        <MudToggleItem Value="@("normal")" Text="Clear cell" />
                                    </MudToggleGroup>
                                    @if (_tileBrush == "color")
                                    {
                                        <div class="bbm-swatches">
                                            @foreach (var swatch in Swatches)
                                            {
                                                <button type="button"
                                                        class="bbm-swatch @(_currentColor == swatch ? "selected" : null)"
                                                        style="background:@swatch"
                                                        title="@swatch"
                                                        @onclick="() => _currentColor = swatch"></button>
                                            }
                                        </div>
                                    }
                                }
                                @if (_tool == "text" && _selectedCell is not null)
                                {
                                    <MudTextField T="string"
                                                  Label="@($"Text ({FormatCell(_selectedCell.Value.X, _selectedCell.Value.Y)})")"
                                                  Value="@GetCellText(_selectedCell.Value.X, _selectedCell.Value.Y)"
                                                  ValueChanged="OnCellTextMudChanged"
                                                  Immediate="false"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                }
                                <MudButton Variant="Variant.Outlined"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           Class="march-map-toolbar__btn"
                                           OnClick="ClearMap">
                                    Clear map
                                </MudButton>
                            </div>
                        }
                    </aside>
                }

                <BaronyBattleMapGrid Width="Map.Width"
                                     Height="Map.Height"
                                     Cells="Map.Cells"
                                     Tokens="Map.Tokens"
                                     SelectedTokenId="_selectedTokenId"
                                     ActiveTokenId="ActiveTokenId"
                                     RangeCells="_rangeCells"
                                     Interactive="true"
                                     OnCellClick="HandleCellClick" />
            </section>

            <aside class="bbm-side-pane">
                <BaronySection Title="Your forces">
                    <div class="bbm-force-list">
                        @foreach (var unit in _activeUnits)
                        {
                            var onMap = Map.Tokens.FirstOrDefault(t => t.UnitId == unit.Id);
                            var stats = UnitStatHelper.Compute(unit);
                            var iconKey = GetAllyIconKey(unit.Id);
                            var iconPath = BattleTokenIconCatalog.PathFor(iconKey);
                            var hpNow = onMap?.Hp ?? (unit.CurrentHp > 0 ? unit.CurrentHp : stats.MaxHp);
                            var hpMax = onMap?.MaxHp > 0 ? onMap.MaxHp : stats.MaxHp;
                            <div class="bbm-force-card @(onMap is not null ? "on-map" : null) @(_deployUnitId == unit.Id ? "picked" : null)">
                                <div class="bbm-force-card__top">
                                    <button type="button"
                                            class="bbm-force-icon-btn"
                                            title="Change icon"
                                            @onclick="() => OpenAllyIconPicker(unit.Id)"
                                            @onclick:stopPropagation="true">
                                        @if (!string.IsNullOrEmpty(iconPath))
                                        {
                                            <img src="/@iconPath" alt="" />
                                        }
                                        else
                                        {
                                            <span>?</span>
                                        }
                                    </button>
                                    <div class="bbm-force-card__identity">
                                        <strong class="bbm-force-card__name">@unit.Name</strong>
                                        <span class="bbm-force-card__hp">HP @hpNow/@hpMax</span>
                                    </div>
                                    <div class="bbm-force-card__actions">
                                        @if (onMap is null && IsSetupPhase && CanEdit)
                                        {
                                            <button type="button"
                                                    class="barony-turn-btn--ghost bbm-mini-btn"
                                                    @onclick="() => PickDeployUnit(unit.Id)">
                                                @(_deployUnitId == unit.Id ? "Click deploy…" : "Deploy")
                                            </button>
                                        }
                                        else if (onMap is not null && IsSetupPhase && CanEdit)
                                        {
                                            <button type="button"
                                                    class="barony-turn-btn--ghost bbm-mini-btn"
                                                    @onclick="() => RecallUnit(unit.Id)">
                                                Recall
                                            </button>
                                        }
                                    </div>
                                </div>
                                <div class="bbm-force-card__stats">
                                    Atk @stats.Attack · Def @stats.Defense · Dmg @stats.Damage · Arm @stats.Armor · Disc @unit.Discipline · Mv @stats.Move · @unit.TroopCount men
                                </div>
                            </div>
                        }
                        @if (_activeUnits.Count == 0)
                        {
                            <p class="bbm-empty">No Active units in Army.</p>
                        }
                    </div>
                </BaronySection>

                <BaronySection Title="Enemy forces">
                    <div class="bbm-force-list">
                        @foreach (var enemy in Map.Tokens.Where(t => t.IsEnemy))
                        {
                            var iconPath = BattleTokenIconCatalog.PathFor(enemy.IconKey);
                            <div class="bbm-force-card enemy @(_selectedTokenId == enemy.Id ? "picked" : null)"
                                 @onclick="() => SelectToken(enemy.Id)">
                                <div class="bbm-force-card__top">
                                    <button type="button"
                                            class="bbm-force-icon-btn"
                                            title="@(CanManageAsMg ? "Change icon" : enemy.Label)"
                                            disabled="@(!CanManageAsMg)"
                                            @onclick="() => OpenEnemyIconPicker(enemy.Id)"
                                            @onclick:stopPropagation="true">
                                        @if (!string.IsNullOrEmpty(iconPath))
                                        {
                                            <img src="/@iconPath" alt="" />
                                        }
                                        else
                                        {
                                            <span>?</span>
                                        }
                                    </button>
                                    <div class="bbm-force-card__identity">
                                        <strong class="bbm-force-card__name">@enemy.Label</strong>
                                        <span class="bbm-force-card__hp">HP @enemy.Hp/@enemy.MaxHp</span>
                                    </div>
                                </div>
                                <div class="bbm-force-card__stats">
                                    Atk @enemy.Attack · Def @enemy.Defense · Dmg @enemy.Damage · Arm @enemy.Armor · Disc @enemy.Discipline · Mv @enemy.Move · @enemy.TroopCount men
                                </div>
                            </div>
                        }
                        @if (CanManageAsMg)
                        {
                            <div class="bbm-enemy-form">
                                <div class="bbm-force-card__top">
                                    <button type="button"
                                            class="bbm-force-icon-btn"
                                            title="Choose icon"
                                            @onclick="OpenDraftIconPicker">
                                        @{
                                            var draftPath = BattleTokenIconCatalog.PathFor(_enemyDraft.IconKey);
                                        }
                                        @if (!string.IsNullOrEmpty(draftPath))
                                        {
                                            <img src="/@draftPath" alt="" />
                                        }
                                        else
                                        {
                                            <span>?</span>
                                        }
                                    </button>
                                    <input class="bbm-input bbm-enemy-name" placeholder="Name" @bind="_enemyDraft.Label" />
                                </div>
                                <div class="bbm-enemy-stats">
                                    <label>Atk <input type="number" @bind="_enemyDraft.Attack" /></label>
                                    <label>Def <input type="number" @bind="_enemyDraft.Defense" /></label>
                                    <label>Dmg <input type="number" @bind="_enemyDraft.Damage" /></label>
                                    <label>HP <input type="number" @bind="_enemyDraft.Hp" /></label>
                                    <label>Arm <input type="number" @bind="_enemyDraft.Armor" /></label>
                                    <label>Disc <input type="number" @bind="_enemyDraft.Discipline" /></label>
                                    <label>Men <input type="number" @bind="_enemyDraft.TroopCount" /></label>
                                    <label>Mv <input type="number" @bind="_enemyDraft.Move" /></label>
                                </div>
                                <button type="button" class="barony-turn-btn--solid bbm-mini-btn" @onclick="AddEnemyToken">
                                    Add enemy (click map to place)
                                </button>
                            </div>
                        }
                        else if (!Map.Tokens.Any(t => t.IsEnemy))
                        {
                            <p class="bbm-empty">No enemies on the map yet.</p>
                        }
                    </div>
                </BaronySection>

                <BaronySection Title="Battle log">
                    <div class="bbm-log">
                        @foreach (var entry in Map.Log.OrderByDescending(e => e.Utc).Take(40))
                        {
                            <div class="bbm-log-entry bbm-log-entry--@entry.Kind">
                                <span class="bbm-log-author">@entry.Author</span>
                                <span class="bbm-log-text">@entry.Text</span>
                            </div>
                        }
                    </div>
                    <div class="bbm-chat-row">
                        <input class="bbm-input" placeholder="Message…" @bind="_chatDraft" @onkeydown="OnChatKey" />
                        <button type="button" class="barony-turn-btn--ghost bbm-mini-btn" @onclick="SendChat">Send</button>
                    </div>
                </BaronySection>

                <BaronySection Title="Actions">
                    @if (CanManageAsMg)
                    {
                        <div class="bbm-actions">
                            <div class="bbm-tool-row">
                                @if (IsSetupPhase)
                                {
                                    <button type="button" class="barony-turn-btn--solid bbm-mini-btn" @onclick="BeginBattle">Begin battle</button>
                                }
                                else
                                {
                                    <button type="button" class="barony-turn-btn--ghost bbm-mini-btn" @onclick="ReturnToSetup">Return to setup</button>
                                    <button type="button" class="barony-turn-btn--solid bbm-mini-btn" @onclick="AdvanceTurn">Next turn</button>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="bbm-actions">
                            <p class="bbm-hint">
                                @(IsSetupPhase
                                    ? "Deploy Active units into the green deployment zone, then wait for the Game Master to begin battle."
                                    : "On your unit's turn, select it and click a highlighted cell to move.")
                            </p>
                            @if (IsBattlePhase && ActiveToken is not null && !ActiveToken.IsEnemy && CanEdit)
                            {
                                <button type="button" class="barony-turn-btn--solid bbm-mini-btn" @onclick="AdvanceTurn">End turn</button>
                            }
                        </div>
                    }

                    @if (IsBattlePhase && Map.TurnState.InitiativeOrder.Count > 0)
                    {
                        <ol class="bbm-initiative">
                            @for (var i = 0; i < Map.TurnState.InitiativeOrder.Count; i++)
                            {
                                var id = Map.TurnState.InitiativeOrder[i];
                                var tok = Map.Tokens.FirstOrDefault(t => t.Id == id);
                                if (tok is null) continue;
                                <li class="@(i == Map.TurnState.CurrentIndex ? "current" : null)">
                                    @tok.Label <span class="bbm-force-meta">(@tok.InitiativeTotal)</span>
                                </li>
                            }
                        </ol>
                    }
                </BaronySection>
            </aside>
        </div>
    </div>
}

@code {
    private BaronyBattleMapDTO? Map;
    private HubConnection? _hubConnection;
    private List<BaronyUnitDTO> _activeUnits = new();
    private readonly Dictionary<int, string> _allyIconKeys = new();

    private string _tool = "token";
    private string _tileBrush = "deploy";
    private string _currentColor = "#c4b896";
    private string? _selectedTokenId;
    private (int X, int Y)? _selectedCell;
    private int? _deployUnitId;
    private bool _placingEnemy;
    private bool _mapEditMode;
    private string _chatDraft = string.Empty;
    private HashSet<(int X, int Y)> _rangeCells = new();
    private EnemyDraft _enemyDraft = EnemyDraft.Default();

    private static readonly string[] Swatches =
    {
        "#c4b896", "#8fbc8f", "#6b8cae", "#b87a5a",
        "#9c7a33", "#5c6b4a", "#8b3a3a", "#2f2a24",
        "#fbf8f1", "#78909c",
    };

    private bool IsSetupPhase =>
        string.Equals(Map?.Phase, BaronyBattlePhases.Setup, StringComparison.OrdinalIgnoreCase);

    private bool IsBattlePhase =>
        string.Equals(Map?.Phase, BaronyBattlePhases.Battle, StringComparison.OrdinalIgnoreCase);

    private string PhaseLabel => IsBattlePhase ? "Battle" : "Setup";

    private string? ActiveTokenId =>
        IsBattlePhase && Map is not null && Map.TurnState.InitiativeOrder.Count > 0
            ? Map.TurnState.InitiativeOrder[Math.Clamp(Map.TurnState.CurrentIndex, 0, Map.TurnState.InitiativeOrder.Count - 1)]
            : null;

    private BaronyBattleTokenDTO? ActiveToken =>
        ActiveTokenId is null || Map is null
            ? null
            : Map.Tokens.FirstOrDefault(t => t.Id == ActiveTokenId);

    protected override async Task OnInitializedAsync()
    {
        await LoadBaronyAsync();
        if (Barony is null)
            return;

        try
        {
            Map = await _battleMapRepo.GetOrCreate(BaronyId);
            var units = await _baronyRepo.GetUnits(BaronyId);
            _activeUnits = units.Where(u => u.IsActive).OrderBy(u => u.Name).ToList();
            foreach (var u in _activeUnits)
            {
                if (!_allyIconKeys.ContainsKey(u.Id))
                    _allyIconKeys[u.Id] = "shield";
            }
            foreach (var t in Map.Tokens.Where(t => t.UnitId is int))
            {
                if (t.UnitId is int uid && !string.IsNullOrWhiteSpace(t.IconKey))
                    _allyIconKeys[uid] = t.IconKey!;
            }
            RefreshRange();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load barony battle map");
            LoadError = "Battle map loading error: " + ex.Message;
        }

        await InitializeSignalR();
    }

    private async Task InitializeSignalR()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(_navigationManager.ToAbsoluteUri(ChatHub.HubUrl))
                .WithAutomaticReconnect()
                .Build();
            _hubConnection.On<int>("BaronyBattleMapUpdated", OnRemoteUpdate);
            if (_hubConnection.State == HubConnectionState.Disconnected)
                await _hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "SignalR init failed for barony battle map");
        }
    }

    private async Task OnRemoteUpdate(int baronyId)
    {
        if (baronyId != BaronyId)
            return;
        await InvokeAsync(async () =>
        {
            try
            {
                Map = await _battleMapRepo.GetOrCreate(BaronyId);
                if (_selectedTokenId is not null && Map.Tokens.All(t => t.Id != _selectedTokenId))
                    _selectedTokenId = null;
                RefreshRange();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to refresh barony battle map");
            }
        });
    }

    private async Task OnActiveChanged(bool value)
    {
        if (Map is null || !CanManageAsMg)
            return;
        Map.IsActive = value;
        await SaveAsync(systemMessage: value ? "Battle Map activated." : "Battle Map deactivated (state kept).");
    }

    private void SetTool(string tool)
    {
        _tool = tool;
        _deployUnitId = null;
        _placingEnemy = false;
    }

    private Task OnPaintToolChanged(string tool)
    {
        SetTool(tool);
        return Task.CompletedTask;
    }

    private Task OnBrushChanged(string brush)
    {
        _tileBrush = brush;
        return Task.CompletedTask;
    }

    private void ToggleMapEdit()
    {
        _mapEditMode = !_mapEditMode;
        if (_mapEditMode)
        {
            _tool = "tiles";
            _deployUnitId = null;
            _placingEnemy = false;
        }
        else
        {
            _tool = "token";
            _selectedCell = null;
        }
    }

    private void SetBrush(string brush) => _tileBrush = brush;

    private string ToolBtn(string tool) =>
        $"bbm-mini-btn {( _tool == tool ? "barony-turn-btn--solid" : "barony-turn-btn--ghost")}";

    private string BrushBtn(string brush) =>
        $"bbm-mini-btn {( _tileBrush == brush ? "barony-turn-btn--solid" : "barony-turn-btn--ghost")}";

    private async Task OnCellTextMudChanged(string value)
    {
        if (Map is null || _selectedCell is null)
            return;
        var cell = GetOrAddCell(_selectedCell.Value.X, _selectedCell.Value.Y);
        cell.Text = value;
        cell.TextColor = _currentColor;
        CleanupCell(cell);
        await SaveAsync();
    }

    private void PickDeployUnit(int unitId)
    {
        _deployUnitId = unitId;
        _placingEnemy = false;
        _selectedTokenId = null;
        _tool = "token";
    }

    private string GetAllyIconKey(int unitId) =>
        _allyIconKeys.TryGetValue(unitId, out var key) ? key : "shield";

    private async Task OpenIconPickerAsync(string? currentKey, Func<string, Task> onPicked)
    {
        var parameters = new DialogParameters
        {
            [nameof(BattleTokenIconPickerDialog.SelectedKey)] = currentKey ?? "shield",
        };
        var dialog = await _dialogService.ShowAsync<BattleTokenIconPickerDialog>(
            "Choose icon",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not string key || string.IsNullOrWhiteSpace(key))
            return;
        await onPicked(key);
    }

    private Task OpenAllyIconPicker(int unitId) =>
        OpenIconPickerAsync(GetAllyIconKey(unitId), key => ApplyAllyIconAsync(unitId, key));

    private Task OpenEnemyIconPicker(string tokenId) =>
        OpenIconPickerAsync(
            Map?.Tokens.FirstOrDefault(t => t.Id == tokenId)?.IconKey,
            key => ApplyEnemyIconAsync(tokenId, key));

    private Task OpenDraftIconPicker() =>
        OpenIconPickerAsync(_enemyDraft.IconKey, key =>
        {
            _enemyDraft.IconKey = key;
            return Task.CompletedTask;
        });

    private async Task ApplyAllyIconAsync(int unitId, string key)
    {
        _allyIconKeys[unitId] = key;
        if (Map is null)
            return;
        var token = Map.Tokens.FirstOrDefault(t => t.UnitId == unitId);
        if (token is not null)
        {
            token.IconKey = key;
            await SaveAsync();
        }
    }

    private async Task ApplyEnemyIconAsync(string tokenId, string key)
    {
        if (Map is null || !CanManageAsMg)
            return;
        var token = Map.Tokens.FirstOrDefault(t => t.Id == tokenId);
        if (token is null)
            return;
        token.IconKey = key;
        await SaveAsync();
    }

    private void SelectToken(string id)
    {
        _selectedTokenId = _selectedTokenId == id ? null : id;
        RefreshRange();
    }

    private async Task HandleCellClick((int X, int Y) pos)
    {
        if (Map is null)
            return;
        var (x, y) = pos;

        if (_deployUnitId is int deployId && IsSetupPhase && CanEdit)
        {
            await DeployAllyAt(deployId, x, y);
            return;
        }

        if (_placingEnemy && CanManageAsMg && IsSetupPhase)
        {
            await PlacePendingEnemy(x, y);
            return;
        }

        if (CanManageAsMg && _mapEditMode && _tool == "tiles")
        {
            await PaintTile(x, y);
            return;
        }

        if (CanManageAsMg && _mapEditMode && _tool == "text")
        {
            _selectedCell = (x, y);
            var cell = GetOrAddCell(x, y);
            cell.TextColor = _currentColor;
            await SaveAsync();
            return;
        }

        if (CanManageAsMg && _mapEditMode && _tool == "erase")
        {
            var cell = GetCell(x, y);
            if (cell is not null)
                Map.Cells.Remove(cell);
            var tok = GetTokenAt(x, y);
            if (tok is not null)
                Map.Tokens.Remove(tok);
            await SaveAsync();
            RefreshRange();
            return;
        }

        // Movement / selection
        var clicked = GetTokenAt(x, y);
        if (_selectedTokenId is not null)
        {
            var selected = Map.Tokens.FirstOrDefault(t => t.Id == _selectedTokenId);
            if (selected is not null && await TryMoveToken(selected, x, y))
                return;
        }

        if (clicked is not null && CanSelectToken(clicked))
        {
            _selectedTokenId = clicked.Id == _selectedTokenId ? null : clicked.Id;
            RefreshRange();
        }
    }

    private bool CanSelectToken(BaronyBattleTokenDTO token)
    {
        if (CanManageAsMg)
            return true;
        return !token.IsEnemy;
    }

    private async Task DeployAllyAt(int unitId, int x, int y)
    {
        if (Map is null)
            return;
        var unit = _activeUnits.FirstOrDefault(u => u.Id == unitId);
        if (unit is null)
            return;
        if (Map.Tokens.Any(t => t.UnitId == unitId))
        {
            _snackBar.Add("Unit already on the map.", Severity.Warning);
            return;
        }
        if (!IsDeployCell(x, y))
        {
            _snackBar.Add("Deploy only inside the deployment zone.", Severity.Warning);
            return;
        }
        if (!CanPlace(x, y, 1))
        {
            _snackBar.Add("Cell occupied.", Severity.Warning);
            return;
        }

        var stats = UnitStatHelper.Compute(unit);
        var token = new BaronyBattleTokenDTO
        {
            Id = Guid.NewGuid().ToString("N"),
            X = x,
            Y = y,
            Label = unit.Name,
            IconKey = GetAllyIconKey(unitId),
            IsEnemy = false,
            UnitId = unitId,
            Size = 1,
            Attack = stats.Attack,
            Defense = stats.Defense,
            Damage = stats.Damage,
            Hp = unit.CurrentHp > 0 ? unit.CurrentHp : stats.MaxHp,
            MaxHp = stats.MaxHp,
            Discipline = unit.Discipline,
            TroopCount = unit.TroopCount,
            Armor = stats.Armor,
            Move = Math.Max(0, stats.Move),
            RemainingMove = Math.Max(0, stats.Move),
        };
        Map.Tokens.Add(token);
        _deployUnitId = null;
        _selectedTokenId = token.Id;
        await SaveAsync(systemMessage: $"{token.Label} deployed at {FormatCell(x, y)}.");
        RefreshRange();
    }

    private async Task RecallUnit(int unitId)
    {
        if (Map is null || !IsSetupPhase)
            return;
        var token = Map.Tokens.FirstOrDefault(t => t.UnitId == unitId);
        if (token is null)
            return;
        Map.Tokens.Remove(token);
        await SaveAsync(systemMessage: $"{token.Label} recalled.");
        RefreshRange();
    }

    private void AddEnemyToken()
    {
        if (!CanManageAsMg || Map is null)
            return;
        if (string.IsNullOrWhiteSpace(_enemyDraft.Label))
        {
            _snackBar.Add("Enemy name required.", Severity.Warning);
            return;
        }
        _placingEnemy = true;
        _deployUnitId = null;
        _tool = "token";
        _snackBar.Add("Click a cell to place the enemy token.", Severity.Info);
    }

    private async Task PlacePendingEnemy(int x, int y)
    {
        if (Map is null || !CanPlace(x, y, 1))
        {
            _snackBar.Add("Cannot place here.", Severity.Warning);
            return;
        }
        var hp = Math.Max(1, _enemyDraft.Hp);
        var token = new BaronyBattleTokenDTO
        {
            Id = Guid.NewGuid().ToString("N"),
            X = x,
            Y = y,
            Label = _enemyDraft.Label.Trim(),
            IconKey = _enemyDraft.IconKey,
            IsEnemy = true,
            Size = 1,
            Attack = _enemyDraft.Attack,
            Defense = _enemyDraft.Defense,
            Damage = _enemyDraft.Damage,
            Hp = hp,
            MaxHp = hp,
            Discipline = Math.Max(0, _enemyDraft.Discipline),
            TroopCount = Math.Max(1, _enemyDraft.TroopCount),
            Armor = _enemyDraft.Armor,
            Move = Math.Max(0, _enemyDraft.Move),
            RemainingMove = Math.Max(0, _enemyDraft.Move),
        };
        Map.Tokens.Add(token);
        _placingEnemy = false;
        _selectedTokenId = token.Id;
        _enemyDraft = EnemyDraft.Default();
        await SaveAsync(systemMessage: $"Enemy {token.Label} placed at {FormatCell(x, y)}.");
        RefreshRange();
    }

    private async Task PaintTile(int x, int y)
    {
        if (Map is null)
            return;
        var cell = GetOrAddCell(x, y);
        switch (_tileBrush)
        {
            case "deploy":
                cell.Terrain = BaronyBattleTerrain.Deploy;
                break;
            case "difficult":
                cell.Terrain = BaronyBattleTerrain.Difficult;
                break;
            case "impassable":
                cell.Terrain = BaronyBattleTerrain.Impassable;
                break;
            case "normal":
                cell.Terrain = null;
                CleanupCell(cell);
                break;
            default:
                cell.Color = _currentColor;
                break;
        }
        await SaveAsync();
    }

    private async Task OnCellTextChanged(ChangeEventArgs e)
    {
        if (Map is null || _selectedCell is null)
            return;
        var cell = GetOrAddCell(_selectedCell.Value.X, _selectedCell.Value.Y);
        cell.Text = e.Value?.ToString();
        cell.TextColor = _currentColor;
        CleanupCell(cell);
        await SaveAsync();
    }

    private async Task<bool> TryMoveToken(BaronyBattleTokenDTO token, int x, int y)
    {
        if (Map is null)
            return false;

        if (!CanControlToken(token))
        {
            _snackBar.Add("You cannot move this token.", Severity.Warning);
            return false;
        }

        int size = TokenSize(token);
        int nx = Math.Clamp(x, 0, Map.Width - size);
        int ny = Math.Clamp(y, 0, Map.Height - size);

        if (IsSetupPhase)
        {
            if (!token.IsEnemy && !IsDeployFootprint(nx, ny, size))
            {
                _snackBar.Add("Allies stay in the deployment zone during setup.", Severity.Warning);
                return false;
            }
            if (!CanPlace(nx, ny, size, token.Id))
                return false;
            token.X = nx;
            token.Y = ny;
            _selectedTokenId = null;
            await SaveAsync(systemMessage: $"{token.Label} moved to {FormatCell(nx, ny)}.");
            RefreshRange();
            return true;
        }

        // Battle phase: only active token, within remaining move
        if (ActiveTokenId != token.Id)
        {
            _snackBar.Add("Wait for this unit's turn.", Severity.Warning);
            return false;
        }

        var reachable = ComputeReachableAnchors(token);
        if (!reachable.Contains((nx, ny)) && !(nx == token.X && ny == token.Y))
        {
            _snackBar.Add("Out of movement range.", Severity.Warning);
            return false;
        }

        var cost = EstimateMoveCost(token, nx, ny);
        if (cost < 0 || cost > token.RemainingMove)
        {
            _snackBar.Add("Not enough movement.", Severity.Warning);
            return false;
        }

        token.X = nx;
        token.Y = ny;
        token.RemainingMove = Math.Max(0, token.RemainingMove - cost);
        _selectedTokenId = token.Id;
        await SaveAsync(systemMessage: $"{token.Label} moved to {FormatCell(nx, ny)} ({token.RemainingMove} move left).");
        RefreshRange();
        return true;
    }

    private bool CanControlToken(BaronyBattleTokenDTO token)
    {
        if (CanManageAsMg)
            return true;
        return !token.IsEnemy && CanEdit;
    }

    private async Task BeginBattle()
    {
        if (Map is null || !CanManageAsMg)
            return;
        if (Map.Tokens.Count == 0)
        {
            _snackBar.Add("Place at least one token before beginning.", Severity.Warning);
            return;
        }

        var rng = Random.Shared;
        foreach (var token in Map.Tokens)
        {
            token.InitiativeDie = rng.Next(1, 11);
            token.InitiativeTotal = token.Discipline + token.InitiativeDie;
            token.RemainingMove = token.Move;
        }

        // Sort by initiative desc; ties broken randomly
        var ordered = Map.Tokens
            .OrderByDescending(t => t.InitiativeTotal)
            .ThenBy(_ => rng.Next())
            .Select(t => t.Id)
            .ToList();

        Map.Phase = BaronyBattlePhases.Battle;
        Map.TurnState = new BaronyBattleTurnStateDTO
        {
            InitiativeOrder = ordered,
            CurrentIndex = 0,
        };
        _tool = "token";

        var lines = Map.Tokens
            .OrderByDescending(t => t.InitiativeTotal)
            .Select(t => $"{t.Label}: {t.Discipline}+{t.InitiativeDie}={t.InitiativeTotal}");
        await SaveAsync(systemMessage: "Battle begins. Initiative — " + string.Join("; ", lines));
        _selectedTokenId = ActiveTokenId;
        RefreshRange();
    }

    private async Task ReturnToSetup()
    {
        if (Map is null || !CanManageAsMg)
            return;
        Map.Phase = BaronyBattlePhases.Setup;
        Map.TurnState = new();
        foreach (var t in Map.Tokens)
            t.RemainingMove = t.Move;
        await SaveAsync(systemMessage: "Returned to setup.");
        RefreshRange();
    }

    private async Task AdvanceTurn()
    {
        if (Map is null || !IsBattlePhase || Map.TurnState.InitiativeOrder.Count == 0)
            return;

        if (!CanManageAsMg)
        {
            var active = ActiveToken;
            if (active is null || active.IsEnemy || !CanEdit)
            {
                _snackBar.Add("Not your turn.", Severity.Warning);
                return;
            }
        }

        var next = Map.TurnState.CurrentIndex + 1;
        if (next >= Map.TurnState.InitiativeOrder.Count)
        {
            next = 0;
            foreach (var t in Map.Tokens)
                t.RemainingMove = t.Move;
            AppendLocalLog("System", "system", "New round — movement refreshed.");
        }

        Map.TurnState.CurrentIndex = next;
        var nextTok = ActiveToken;
        await SaveAsync(systemMessage: nextTok is null ? "Turn advanced." : $"{nextTok.Label}'s turn.");
        _selectedTokenId = ActiveTokenId;
        RefreshRange();
    }

    private async Task ClearMap()
    {
        if (Map is null || !CanManageAsMg)
            return;

        var confirm = await _dialogService.ShowMessageBoxAsync(
            "Clear map?",
            "This will remove all painted terrain, text, and tokens, and return the battle to setup. This cannot be undone.",
            yesText: "Clear map",
            cancelText: "Cancel");

        if (confirm != true)
            return;

        Map.Cells.Clear();
        Map.Tokens.Clear();
        Map.Phase = BaronyBattlePhases.Setup;
        Map.TurnState = new();
        _selectedTokenId = null;
        await SaveAsync(systemMessage: "Map cleared.");
        RefreshRange();
    }

    private async Task SendChat()
    {
        if (Map is null || string.IsNullOrWhiteSpace(_chatDraft))
            return;
        var author = CanManageAsMg ? "MG" : "Baron";
        AppendLocalLog(author, "chat", _chatDraft.Trim());
        _chatDraft = string.Empty;
        await SaveAsync();
    }

    private async Task OnChatKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SendChat();
    }

    private void AppendLocalLog(string author, string kind, string text)
    {
        if (Map is null)
            return;
        Map.Log.Add(new BaronyBattleLogEntryDTO
        {
            Id = Guid.NewGuid().ToString("N"),
            Utc = DateTime.UtcNow,
            Author = author,
            Kind = kind,
            Text = text,
        });
        if (Map.Log.Count > 200)
            Map.Log.RemoveRange(0, Map.Log.Count - 200);
    }

    private async Task SaveAsync(string? systemMessage = null)
    {
        if (Map is null)
            return;
        if (!string.IsNullOrWhiteSpace(systemMessage))
            AppendLocalLog("System", "system", systemMessage);
        try
        {
            Map = await _battleMapRepo.Update(Map);
            if (_hubConnection is not null && _hubConnection.State == HubConnectionState.Connected)
                await _hubConnection.SendAsync("NotifyBaronyBattleMapUpdated", BaronyId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save barony battle map");
            _snackBar.Add("Failed to save battle map.", Severity.Error);
        }
    }

    private void RefreshRange()
    {
        _rangeCells = new();
        if (Map is null || _selectedTokenId is null)
            return;
        var token = Map.Tokens.FirstOrDefault(t => t.Id == _selectedTokenId);
        if (token is null)
            return;

        if (IsBattlePhase)
        {
            if (ActiveTokenId != token.Id)
                return;
            _rangeCells = ComputeReachable(token);
        }
        else if (!token.IsEnemy)
        {
            // Setup: show deploy cells as soft hint when selected
            foreach (var c in Map.Cells.Where(c => c.Terrain == BaronyBattleTerrain.Deploy))
                _rangeCells.Add((c.X, c.Y));
        }
    }

    // --- Grid helpers (forked pathfinding) ---

    private BaronyBattleCellDTO? GetCell(int x, int y) =>
        Map?.Cells.FirstOrDefault(c => c.X == x && c.Y == y);

    private string GetCellText(int x, int y) => GetCell(x, y)?.Text ?? string.Empty;

    private BaronyBattleCellDTO GetOrAddCell(int x, int y)
    {
        var cell = GetCell(x, y);
        if (cell is null)
        {
            cell = new BaronyBattleCellDTO { X = x, Y = y };
            Map!.Cells.Add(cell);
        }
        return cell;
    }

    private void CleanupCell(BaronyBattleCellDTO cell)
    {
        if (string.IsNullOrWhiteSpace(cell.Color)
            && string.IsNullOrWhiteSpace(cell.Text)
            && string.IsNullOrWhiteSpace(cell.TextColor)
            && string.IsNullOrWhiteSpace(cell.Terrain))
            Map!.Cells.Remove(cell);
    }

    private static int TokenSize(BaronyBattleTokenDTO token) => Math.Clamp(token.Size <= 0 ? 1 : token.Size, 1, 3);

    private BaronyBattleTokenDTO? GetTokenAt(int x, int y) =>
        Map?.Tokens.FirstOrDefault(t =>
        {
            int s = TokenSize(t);
            return x >= t.X && x < t.X + s && y >= t.Y && y < t.Y + s;
        });

    private bool IsDeployCell(int x, int y) =>
        GetCell(x, y)?.Terrain == BaronyBattleTerrain.Deploy;

    private bool IsDeployFootprint(int ax, int ay, int size)
    {
        for (int dx = 0; dx < size; dx++)
            for (int dy = 0; dy < size; dy++)
                if (!IsDeployCell(ax + dx, ay + dy))
                    return false;
        return true;
    }

    private bool CanPlace(int x, int y, int size, string? ignoreTokenId = null)
    {
        if (Map is null || x < 0 || y < 0 || x + size > Map.Width || y + size > Map.Height)
            return false;
        foreach (var other in Map.Tokens)
        {
            if (other.Id == ignoreTokenId)
                continue;
            int os = TokenSize(other);
            bool overlaps = x < other.X + os && x + size > other.X
                         && y < other.Y + os && y + size > other.Y;
            if (overlaps)
                return false;
        }
        return true;
    }

    private bool IsBlockedFor(BaronyBattleTokenDTO mover, int x, int y)
    {
        if (GetCell(x, y)?.Terrain == BaronyBattleTerrain.Impassable)
            return true;
        var occupant = GetTokenAt(x, y);
        if (occupant is not null && occupant.Id != mover.Id && occupant.IsEnemy != mover.IsEnemy)
            return true;
        return false;
    }

    private bool IsFootprintBlocked(BaronyBattleTokenDTO mover, int ax, int ay, int size)
    {
        if (Map is null || ax < 0 || ay < 0 || ax + size > Map.Width || ay + size > Map.Height)
            return true;
        for (int dx = 0; dx < size; dx++)
            for (int dy = 0; dy < size; dy++)
                if (IsBlockedFor(mover, ax + dx, ay + dy))
                    return true;
        return false;
    }

    private bool FootprintEntersDifficult(int oldX, int oldY, int newX, int newY, int size)
    {
        for (int dx = 0; dx < size; dx++)
        {
            for (int dy = 0; dy < size; dy++)
            {
                int cx = newX + dx;
                int cy = newY + dy;
                bool wasInside = cx >= oldX && cx < oldX + size && cy >= oldY && cy < oldY + size;
                if (!wasInside && GetCell(cx, cy)?.Terrain == BaronyBattleTerrain.Difficult)
                    return true;
            }
        }
        return false;
    }

    private HashSet<(int X, int Y)> ComputeReachableAnchors(BaronyBattleTokenDTO mover)
    {
        var anchors = new HashSet<(int, int)>();
        if (Map is null)
            return anchors;

        int size = TokenSize(mover);
        int range = IsBattlePhase ? mover.RemainingMove : mover.Move;
        if (range <= 0)
            return anchors;

        int budget = range * 2 + 1;
        int w = Map.Width;
        int h = Map.Height;
        var dist = new int[w, h];
        for (int i = 0; i < w; i++)
            for (int j = 0; j < h; j++)
                dist[i, j] = int.MaxValue;

        dist[mover.X, mover.Y] = 0;
        var queue = new PriorityQueue<(int X, int Y), int>();
        queue.Enqueue((mover.X, mover.Y), 0);

        while (queue.Count > 0)
        {
            var (cx, cy) = queue.Dequeue();
            int baseCost = dist[cx, cy];
            for (int dx = -1; dx <= 1; dx++)
            {
                for (int dy = -1; dy <= 1; dy++)
                {
                    if (dx == 0 && dy == 0) continue;
                    int nx = cx + dx;
                    int ny = cy + dy;
                    if (IsFootprintBlocked(mover, nx, ny, size))
                        continue;
                    int stepCost = (dx != 0 && dy != 0) ? 3 : 2;
                    if (FootprintEntersDifficult(cx, cy, nx, ny, size))
                        stepCost *= 2;
                    int newCost = baseCost + stepCost;
                    if (newCost > budget) continue;
                    if (newCost < dist[nx, ny])
                    {
                        dist[nx, ny] = newCost;
                        queue.Enqueue((nx, ny), newCost);
                    }
                }
            }
        }

        for (int i = 0; i < w; i++)
        {
            for (int j = 0; j < h; j++)
            {
                if (dist[i, j] == int.MaxValue) continue;
                if (dist[i, j] / 2 > range) continue;
                if (!CanPlace(i, j, size, mover.Id)) continue;
                anchors.Add((i, j));
            }
        }
        return anchors;
    }

    private HashSet<(int X, int Y)> ComputeReachable(BaronyBattleTokenDTO mover)
    {
        var result = new HashSet<(int, int)>();
        int size = TokenSize(mover);
        foreach (var (ax, ay) in ComputeReachableAnchors(mover))
        {
            for (int dx = 0; dx < size; dx++)
                for (int dy = 0; dy < size; dy++)
                    result.Add((ax + dx, ay + dy));
        }
        return result;
    }

    private int EstimateMoveCost(BaronyBattleTokenDTO mover, int targetX, int targetY)
    {
        if (mover.X == targetX && mover.Y == targetY)
            return 0;
        // Recompute distances and read cost at target
        if (Map is null)
            return -1;

        int size = TokenSize(mover);
        int range = mover.RemainingMove;
        int budget = range * 2 + 1;
        int w = Map.Width;
        int h = Map.Height;
        var dist = new int[w, h];
        for (int i = 0; i < w; i++)
            for (int j = 0; j < h; j++)
                dist[i, j] = int.MaxValue;
        dist[mover.X, mover.Y] = 0;
        var queue = new PriorityQueue<(int X, int Y), int>();
        queue.Enqueue((mover.X, mover.Y), 0);
        while (queue.Count > 0)
        {
            var (cx, cy) = queue.Dequeue();
            if (cx == targetX && cy == targetY)
                break;
            int baseCost = dist[cx, cy];
            for (int dx = -1; dx <= 1; dx++)
            for (int dy = -1; dy <= 1; dy++)
            {
                if (dx == 0 && dy == 0) continue;
                int nx = cx + dx, ny = cy + dy;
                if (IsFootprintBlocked(mover, nx, ny, size)) continue;
                int stepCost = (dx != 0 && dy != 0) ? 3 : 2;
                if (FootprintEntersDifficult(cx, cy, nx, ny, size)) stepCost *= 2;
                int newCost = baseCost + stepCost;
                if (newCost > budget) continue;
                if (newCost < dist[nx, ny])
                {
                    dist[nx, ny] = newCost;
                    queue.Enqueue((nx, ny), newCost);
                }
            }
        }
        if (dist[targetX, targetY] == int.MaxValue)
            return -1;
        return dist[targetX, targetY] / 2;
    }

    private static char ColumnLetter(int x) => (char)('A' + x);
    private static string FormatCell(int x, int y) => $"{ColumnLetter(x)}{y + 1}";

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            try { await _hubConnection.DisposeAsync(); }
            catch { /* ignore */ }
        }
    }

    private sealed class EnemyDraft
    {
        public string Label { get; set; } = "Raiders";
        public string IconKey { get; set; } = "skull";
        public int Attack { get; set; } = 3;
        public int Defense { get; set; } = 3;
        public int Damage { get; set; } = 2;
        public int Hp { get; set; } = 20;
        public int Armor { get; set; } = 1;
        public int Discipline { get; set; } = 2;
        public int TroopCount { get; set; } = 50;
        public int Move { get; set; } = 4;

        public static EnemyDraft Default() => new();
    }
