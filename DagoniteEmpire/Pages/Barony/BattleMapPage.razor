    }

    private async Task SaveEditedEnemyAsync()
    {
        if (!CanManageAsMg || Map is null || string.IsNullOrWhiteSpace(_editingEnemyTokenId))
            return;

        if (string.IsNullOrWhiteSpace(_enemyDraft.Label))
        {
            _snackBar.Add("Enemy name required.", Severity.Warning);
            return;
        }
        var abilityError = ValidateEnemyDraftAbilitiesSet();
        if (!string.IsNullOrWhiteSpace(abilityError))
        {
            _snackBar.Add(abilityError, Severity.Warning);
            return;
        }

        var token = Map.Tokens.FirstOrDefault(t => t.Id == _editingEnemyTokenId && t.IsEnemy);
        if (token is null)
        {
            CancelEditEnemy();
            return;
        }

        var hp = Math.Max(1, _enemyDraft.Hp);
        var move = Math.Max(0, _enemyDraft.Move);
        token.Label = _enemyDraft.Label.Trim();
        token.IconKey = _enemyDraft.IconKey;
        token.Attack = _enemyDraft.Attack;
        token.Defense = _enemyDraft.Defense;
        token.Damage = _enemyDraft.Damage;
        token.Hp = hp;
        token.MaxHp = hp;
        token.Discipline = Math.Max(0, _enemyDraft.Discipline);
        token.TroopCount = Math.Max(1, _enemyDraft.TroopCount);
        token.Armor = _enemyDraft.Armor;
        token.Move = move;
        token.RemainingMove = Math.Clamp(token.RemainingMove, 0, move);
        token.Range = Math.Max(0, _enemyDraft.Range);
        token.Pierce = Math.Max(0, _enemyDraft.Pierce);
        token.Mounted = _enemyDraft.Mounted;
        token.EnemyBaseRange = Math.Max(0, _enemyDraft.Range);
        // Refresh the captured base so passive bonuses re-derive from the game master's new numbers.
        token.EnemyBaseCaptured = true;
        token.EnemyBaseHp = hp;
        token.EnemyBaseMove = move;
        token.EnemyBaseDamage = _enemyDraft.Damage;
        token.EnemyBaseDefense = _enemyDraft.Defense;
        token.EnemyBaseDiscipline = Math.Max(0, _enemyDraft.Discipline);
        token.EnemyCommanderAbilities = _enemyDraft.CommanderAbilities
            .Where(k => !string.IsNullOrWhiteSpace(k))
            .Select(k => k.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        ApplyEnemyCommanderAbilities(token);
        // Configuring an enemy starts it at full effective HP (including Hold the Line).
        token.Hp = token.MaxHp;

        var label = token.Label;
        CancelEditEnemy();
        _selectedTokenId = token.Id;
        await SaveAsync(systemMessage: $"Enemy {label} updated.");
        RefreshRange();
    }

