    private async Task<bool> TryMoveToken(BaronyBattleTokenDTO token, int x, int y)
    {
        if (Map is null)
            return false;

        if (!CanControlToken(token))
        {
            _snackBar.Add(token.IsEnemy
                ? "Enemy units are moved by the Game Master."
                : "You cannot move this token.", Severity.Warning);
            return false;
        }

        int size = TokenSize(token);
        int nx = Math.Clamp(x, 0, Map.Width - size);
        int ny = Math.Clamp(y, 0, Map.Height - size);

        if (IsSetupPhase)
        {
            if (!token.IsEnemy && !IsDeployFootprint(nx, ny, size))
            {
                _snackBar.Add("Allies stay in the deployment zone during setup.", Severity.Warning);
                return false;
            }
            if (!CanPlace(nx, ny, size, token.Id))
                return false;
            token.X = nx;
            token.Y = ny;
            _selectedTokenId = null;
            await SaveAsync(systemMessage: $"{token.Label} moved to {FormatCell(nx, ny)}.");
            RefreshRange();
            return true;
        }

        // Movement phase: waypoint path planning (ghost → lock → next segment).
        if (!IsMovementPhase)
        {
            if (IsCombatPhase)
                _snackBar.Add("Movement is locked during the combat phase.", Severity.Info);
            return false;
        }

        if (ActiveTokenId != token.Id)
        {
            _snackBar.Add("Wait for this unit's movement order.", Severity.Warning);
            return false;
        }

        // Click current cell → clear planned path.
        if (nx == token.X && ny == token.Y)
        {
            CancelFacingEdit();
            CancelChargeEdit();
            token.ClearPath();
            token.RemainingMove = token.Move;
            ClearCharge(token);
            _selectedTokenId = token.Id;
            await SaveAsync(systemMessage: $"{token.Label} cleared movement path.");
            RefreshRange();
            return true;
        }

        // Click provisional ghost → lock it.
        var provisional = token.ProvisionalWaypoint;
        if (provisional is not null && provisional.X == nx && provisional.Y == ny)
        {
            provisional.Locked = true;
            token.RemainingMove = provisional.RemainingMoveAfter;
            ApplyTravelFacings(token);
            _selectedTokenId = token.Id;
            await SaveAsync(systemMessage: $"{token.Label} locked waypoint at {FormatCell(nx, ny)} ({provisional.RemainingMoveAfter} move left).");
            RefreshRange();
            return true;
        }

        var (fromX, fromY, budget) = GetPlanOrigin(token);

        // Click plan origin or an already-locked waypoint — no new tip.
        if ((nx == fromX && ny == fromY)
            || token.Path.Any(w => w.Locked && w.X == nx && w.Y == ny))
        {
            _selectedTokenId = token.Id;
            RefreshRange();
            return true;
        }

        // A charge is committed: it runs as far as it can and stops only on contact, so there
        // are no orders left to give afterwards.
        if (token.ChargeBonus)
        {
            _snackBar.Add(
                "A charging unit takes no further orders — undo to replan.", Severity.Warning);
            return false;
        }

        if (budget <= 0)
        {
            _snackBar.Add("No movement left — Finish move or clear path.", Severity.Warning);
            return false;
        }

        var reachable = ComputeReachableAnchorsFrom(token, fromX, fromY, budget);
        if (!reachable.Contains((nx, ny)))
        {
            _snackBar.Add("Out of movement range.", Severity.Warning);
            return false;
        }

        if (!CanPlaceWaypoint(token, nx, ny))
        {
            _snackBar.Add("Destination blocked (unit or another order).", Severity.Warning);
            return false;
        }

        var cost = EstimateMoveCostFrom(token, fromX, fromY, nx, ny, budget);
        if (cost < 0 || cost > budget)
        {
            _snackBar.Add("Not enough movement.", Severity.Warning);
            return false;
        }

        var remaining = Math.Max(0, budget - cost - (provisional?.FacingCostPaid ?? 0));
        var wasStationary = !token.Path.Any(w => w.X != token.X || w.Y != token.Y);
        if (provisional is not null)
        {
            provisional.X = nx;
            provisional.Y = ny;
            provisional.RemainingMoveAfter = remaining;
        }
        else
        {
            token.Path.Add(new BaronyBattleWaypointDTO
            {
                X = nx,
                Y = ny,
                Locked = false,
                RemainingMoveAfter = remaining,
                Facing = BaronyBattleFacing.FromGridStep(fromX, fromY, nx, ny),
                FacingCostPaid = 0,
            });
        }

        ApplyTravelFacings(token);

        if (wasStationary && (nx != token.X || ny != token.Y))
        {
            var freeHits = CountEngagementPenalties(token);
            if (freeHits > 0)
            {
                _snackBar.Add(
                    freeHits == 1
                        ? $"{token.Label} is engaged — moving at all costs a free half-strength hit."
                        : $"{token.Label} is engaged — moving at all costs {freeHits} free half-strength hits.",
                    Severity.Warning);
            }
        }

        // RemainingMove is spent only when the ghost is locked (or charge/finish commits).
        _selectedTokenId = token.Id;
        await SaveAsync(systemMessage: $"{token.Label} destination {FormatCell(nx, ny)} (cost {cost}, {remaining} left if locked).");
        RefreshRange();
        return true;
    }

    private void CancelFacingEdit()
    {
        _facingEditTokenId = null;
        _facingPreviewDeg = null;
    }

    private void CancelChargeEdit()
    {
        _chargeEditTokenId = null;
        _chargePreviewCells = new();
        if (_facingEditTokenId is null)
            _facingPreviewDeg = null;
        RefreshRange();
    }

    private Task StartChargeEdit(string tokenId)
    {
        if (Map is null || _isResolvingMovement || !IsMovementPhase)
            return Task.CompletedTask;
        var token = Map.Tokens.FirstOrDefault(t => t.Id == tokenId);
        if (token is null || !CanSelectToken(token) || !CanControlToken(token))
            return Task.CompletedTask;
        if (ActiveTokenId != token.Id)
            return Task.CompletedTask;

        if (token.ChargeBonus)
        {
            _snackBar.Add("This unit is already charging — undo to replan.", Severity.Warning);
            return Task.CompletedTask;
        }

        var (_, _, budget) = GetTipPlanOrigin(token);
        if (budget < 3)
        {
            _snackBar.Add("Need at least 3 move points to charge.", Severity.Warning);
            return Task.CompletedTask;
        }

        CancelFacingEdit();
        _chargeEditTokenId = tokenId;
        _facingPreviewDeg = BaronyBattleFacing.ToDegrees(token.PlannedFacing());
        RefreshChargePreview(token, BaronyBattleFacing.SnapFromDegrees(_facingPreviewDeg.Value));
        RefreshRange();
        return Task.CompletedTask;
    }

    private void OnFacingPreview(double degrees)
    {
        if (_facingEditTokenId is null && _chargeEditTokenId is null)
            return;
        _facingPreviewDeg = degrees;
        if (_chargeEditTokenId is not null && Map is not null)
        {
            var token = Map.Tokens.FirstOrDefault(t => t.Id == _chargeEditTokenId);
            if (token is not null)
                RefreshChargePreview(token, BaronyBattleFacing.SnapFromDegrees(degrees));
        }
    }

    private void RefreshChargePreview(BaronyBattleTokenDTO token, int facing)
    {
        var preview = new HashSet<(int X, int Y)>();
        if (TryBuildChargePath(token, facing, previewOnly: true, out var result) && result is not null)
        {
            foreach (var cell in result.PathCells)
                preview.Add(cell);
        }
        _chargePreviewCells = preview;
    }

    private async Task ConfirmChargeEdit()
    {
        if (Map is null || _chargeEditTokenId is null)
            return;
        var token = Map.Tokens.FirstOrDefault(t => t.Id == _chargeEditTokenId);
        if (token is null)
        {
            CancelChargeEdit();
            return;
        }

        var facing = BaronyBattleFacing.SnapFromDegrees(
            _facingPreviewDeg ?? BaronyBattleFacing.ToDegrees(token.PlannedFacing()));

        if (!TryBuildChargePath(token, facing, previewOnly: false, out var built) || built is null)
        {
            _snackBar.Add(built?.FailReason ?? "Charge failed — path blocked before 2 tiles.", Severity.Warning);
            CancelChargeEdit();
            return;
        }

        // Keep already-planned movement up to the current plan origin, then append locked charge.
        var (chargeOx, chargeOy, _) = GetTipPlanOrigin(token);
        var preserved = token.Path.ToList();
        token.ClearPath();
        foreach (var wp in preserved)
        {
            wp.Locked = true;
            token.Path.Add(wp);
        }
        // Do not change token.Facing here — the unit keeps its current stance until
        // resolve, then turns into the charge as movement begins.
        foreach (var (wx, wy, rem) in built.Waypoints)
        {
            token.Path.Add(new BaronyBattleWaypointDTO
            {
                X = wx,
                Y = wy,
                Locked = true,
                Facing = facing,
                RemainingMoveAfter = rem,
                FacingCostPaid = 0,
                IsCharge = true,
            });
        }
        token.RemainingMove = built.RemainingAfter;
        // Mark charge intent even for a blind charge; target/bonus can lock later on collision.
        token.ChargeBonus = true;
        token.ChargeBlind = built.Target is null;
        token.ChargeTargetId = built.Target?.Id;
        token.AttackTargetId = built.Target?.Id;
        token.ChargeOriginX = chargeOx;
        token.ChargeOriginY = chargeOy;

        CancelChargeEdit();
        var atkB = ChargeAttackBonus(token);
        var dmgB = ChargeDamageBonus(token);
        var chargeMsg = built.Target is not null
            ? $"{token.Label} charges ({facing * 45}°) at {built.Target.Label} — +{atkB} Atk/+{dmgB} Dmg if contact holds."
            : $"{token.Label} charges ({facing * 45}°) in a straight line.";
        await SaveAsync(systemMessage: chargeMsg);
        RefreshRange();
    }

    private sealed class ChargeBuildResult
    {
        public BaronyBattleTokenDTO? Target { get; init; }
        public required List<(int X, int Y)> PathCells { get; init; }
        public required List<(int X, int Y, int Remaining)> Waypoints { get; init; }
        public int RemainingAfter { get; init; }
        public string? FailReason { get; init; }
    }

    /// <summary>
    /// Straight-line charge: min 3 on cardinal directions, min 2 on diagonals.
    /// Enemy before minimum steps = fail; enemy on/after minimum = stop before them.
    /// </summary>
    private bool TryBuildChargePath(
        BaronyBattleTokenDTO token,
        int facing,
        bool previewOnly,
        out ChargeBuildResult? result)
    {
        _ = previewOnly;
        result = null;
        if (Map is null)
            return false;

        facing = BaronyBattleFacing.Clamp(facing);
        var minSteps = MinChargeStepsForFacing(facing, token);
        var (dx, dy) = BaronyBattleFacing.StepDelta(facing);
        var diagonal = dx != 0 && dy != 0;
        var (ox, oy, budget) = GetTipPlanOrigin(token);
        // Match pathfinding half-move scale (ortho 2, diagonal 3, budget = move*2+1):
        // 3 MP → 2 diag, 4→3, 5→3, 6→4, …
        var minHalf = minSteps * (diagonal ? 3 : 2);
        var halfBudget = MoveHalfBudget(budget);

        if (halfBudget < minHalf)
        {
            result = new ChargeBuildResult
            {
                PathCells = new(),
                Waypoints = new(),
                RemainingAfter = budget,
                FailReason = minSteps == 3
                    ? "Charge in this direction needs at least 3 tiles (3 move)."
                    : "Charge in this direction needs at least 2 diagonal tiles (3 move).",
            };
            return false;
        }

        var size = TokenSize(token);
        var pathCells = new List<(int X, int Y)>();
        var waypoints = new List<(int X, int Y, int Remaining)>();
        var cx = ox;
        var cy = oy;
        var remainingHalf = halfBudget;
        var steps = 0;
        var wedgeLeft = token.CmdWedge ? 1 : 0;

        BaronyBattleTokenDTO? hitEnemy = null;
        var blockedEarly = false;
        string? fail = null;

        while (remainingHalf > 0)
        {
            var nx = cx + dx;
            var ny = cy + dy;
            var stepHalf = diagonal ? 3 : 2;
            var wedgeThisStep = false;
            if (FootprintEntersDifficult(cx, cy, nx, ny, size))
            {
                if (wedgeLeft > 0)
                    wedgeThisStep = true;
                else
                    stepHalf *= 2;
            }
            if (remainingHalf < stepHalf)
                break;

            // Map / impassable
            if (nx < 0 || ny < 0 || nx + size > Map.Width || ny + size > Map.Height
                || IsFootprintBlocked(token, nx, ny, size, ignoreUnits: true))
            {
                if (steps < minSteps)
                {
                    blockedEarly = true;
                    fail = "Charge path blocked before minimum distance.";
                }
                break;
            }

            var occupant = FindFootprintOccupant(token, nx, ny, size);
            if (occupant is not null)
            {
                if (occupant.IsEnemy == token.IsEnemy)
                {
                    // Ally in the way
                    if (steps < minSteps)
                    {
                        blockedEarly = true;
                        fail = L["Another unit stands in the charge path, preventing the charge."];
                    }
                    break;
                }

                // Enemy collision
                if (steps < minSteps)
                {
                    blockedEarly = true;
                    fail = L["Another unit stands in the charge path, preventing the charge."];
                    break;
                }

                hitEnemy = occupant;
                break;
            }

            // Empty cell — step onto it
            remainingHalf -= stepHalf;
            if (wedgeThisStep)
                wedgeLeft--;
            cx = nx;
            cy = ny;
            steps++;
            pathCells.Add((cx, cy));
            waypoints.Add((cx, cy, remainingHalf / 2));
        }

        var remaining = remainingHalf / 2;

        if (blockedEarly || steps < minSteps)
        {
            result = new ChargeBuildResult
            {
                PathCells = pathCells,
                Waypoints = waypoints,
                RemainingAfter = remaining,
                FailReason = fail ?? (minSteps == 3
                    ? "Charge needs at least 3 clear straight tiles."
                    : "Charge needs at least 2 clear diagonal tiles (3 move)."),
            };
            return false;
        }

        if (hitEnemy is not null)
        {
            result = new ChargeBuildResult
            {
                Target = hitEnemy,
                PathCells = pathCells,
                Waypoints = waypoints,
                RemainingAfter = remaining,
            };
            return true;
        }

        // Full run: enemy in the forward arc (straight + both forward diagonals).
        var endTarget = FindChargeEndArcEnemy(token, facing, cx, cy, size);
        if (endTarget is not null)
        {
            result = new ChargeBuildResult
            {
                Target = endTarget,
                PathCells = pathCells,
                Waypoints = waypoints,
                RemainingAfter = remaining,
            };
            return true;
        }

        result = new ChargeBuildResult
        {
            PathCells = pathCells,
            Waypoints = waypoints,
            RemainingAfter = remaining,
        };
        return true;
    }

    /// <summary>
    /// Enemy adjacent at charge end in the forward arc: facing, facing−45°, facing+45°.
    /// Prefers straight ahead, then the two forward diagonals.
    /// </summary>
    private BaronyBattleTokenDTO? FindChargeEndArcEnemy(
        BaronyBattleTokenDTO mover, int facing, int endX, int endY, int size)
    {
        facing = BaronyBattleFacing.Clamp(facing);
        // Blind Fury widens the forward arc to the side-front corners (facing ±90°).
        var offsets = mover.CmdBlindFury ? new[] { 0, -1, 1, -2, 2 } : new[] { 0, -1, 1 };
        foreach (var offset in offsets)
        {
            var look = BaronyBattleFacing.Clamp(facing + offset);
            var (dx, dy) = BaronyBattleFacing.StepDelta(look);
            var occ = FindFootprintOccupant(mover, endX + dx, endY + dy, size);
            if (occ is not null && occ.IsEnemy != mover.IsEnemy && occ.Hp > 0)
                return occ;
        }
        return null;
    }

    /// <summary>
    /// Charge contact is only valid when the target sits in the charger's forward arc
    /// (straight ahead or either forward diagonal) — not side / rear / rear-corner.
    /// </summary>
    private bool IsValidChargeContact(BaronyBattleTokenDTO charger, BaronyBattleTokenDTO target)
    {
        if (target.Hp <= 0 || charger.IsEnemy == target.IsEnemy)
            return false;
        if (!AreAdjacent(charger, target))
            return false;

        var size = TokenSize(charger);
        var facing = BaronyBattleFacing.Clamp(charger.Facing);
        // Blind Fury also accepts the side-front corners it can now lock onto.
        var offsets = charger.CmdBlindFury ? new[] { 0, -1, 1, -2, 2 } : new[] { 0, -1, 1 };
        foreach (var offset in offsets)
        {
            var look = BaronyBattleFacing.Clamp(facing + offset);
            var (dx, dy) = BaronyBattleFacing.StepDelta(look);
            var occ = FindFootprintOccupant(charger, charger.X + dx, charger.Y + dy, size);
            if (occ is not null && occ.Id == target.Id)
                return true;
        }
        return false;
    }

    private BaronyBattleTokenDTO? FindFootprintOccupant(
        BaronyBattleTokenDTO mover, int ax, int ay, int size)
    {
        if (Map is null)
            return null;
        for (var dx = 0; dx < size; dx++)
        {
            for (var dy = 0; dy < size; dy++)
            {
                var occ = GetTokenAt(ax + dx, ay + dy);
                if (occ is not null && occ.Id != mover.Id && occ.Hp > 0)
                    return occ;
            }
        }
        return null;
    }

    private Task StartFacingEdit(string tokenId)
    {
        if (Map is null || _isResolvingMovement)
            return Task.CompletedTask;
        var token = Map.Tokens.FirstOrDefault(t => t.Id == tokenId);
        if (token is null || !CanSelectToken(token) || !CanControlToken(token))
            return Task.CompletedTask;

        // Setup / deploy: free facing change on the selected token (no move cost).
        if (IsSetupPhase)
        {
            CancelChargeEdit();
            _selectedTokenId = token.Id;
            _facingEditTokenId = tokenId;
            _facingEditStartFacing = BaronyBattleFacing.Clamp(token.Facing);
            _facingPreviewDeg = BaronyBattleFacing.ToDegrees(token.Facing);
            return Task.CompletedTask;
        }

        if (!IsMovementPhase || ActiveTokenId != token.Id)
            return Task.CompletedTask;

        // The charge sets the unit's heading; turning afterwards would break the straight run.
        if (token.ChargeBonus)
        {
            _snackBar.Add(
                "A charging unit takes no further orders — undo to replan.", Severity.Warning);
            return Task.CompletedTask;
        }

        CancelChargeEdit();
        var tip = token.LastWaypoint;
        // Stay-put facing: create a same-cell tip to hold facing + move cost.
        if (tip is null)
        {
            if (token.RemainingMove < 1 && !CommanderFreeFacingAvailable(token, inPlace: true))
            {
                _snackBar.Add("Need at least 1 move point to change facing.", Severity.Warning);
                return Task.CompletedTask;
            }

            tip = new BaronyBattleWaypointDTO
            {
                X = token.X,
                Y = token.Y,
                Locked = true,
                Facing = BaronyBattleFacing.Clamp(token.Facing),
                RemainingMoveAfter = token.RemainingMove,
                FacingCostPaid = 0,
            };
            token.Path.Add(tip);
        }

        var tipInPlace = tip.X == token.X && tip.Y == token.Y;
        if (tip.RemainingMoveAfter < 1 && tip.FacingCostPaid <= 0
            && !CommanderFreeFacingAvailable(token, tipInPlace))
        {
            _snackBar.Add("Need at least 1 move point to change facing.", Severity.Warning);
            return Task.CompletedTask;
        }

        _facingEditTokenId = tokenId;
        _facingEditStartFacing = BaronyBattleFacing.Clamp(tip.Facing);
        _facingPreviewDeg = BaronyBattleFacing.ToDegrees(tip.Facing);
        return Task.CompletedTask;
    }

    private async Task ConfirmFacingEdit()
    {
        if (Map is null || _facingEditTokenId is null)
            return;
        var token = Map.Tokens.FirstOrDefault(t => t.Id == _facingEditTokenId);
        if (token is null)
        {
            CancelFacingEdit();
            return;
        }

        if (IsSetupPhase)
        {
            var setupSnapped = BaronyBattleFacing.SnapFromDegrees(
                _facingPreviewDeg ?? BaronyBattleFacing.ToDegrees(token.Facing));
            var setupChanged = setupSnapped != _facingEditStartFacing;
            token.Facing = setupSnapped;
            CancelFacingEdit();
            await SaveAsync(systemMessage: setupChanged
                ? $"{token.Label} facing set ({setupSnapped * 45}°)."
                : $"{token.Label} facing unchanged.");
            RefreshRange();
            return;
        }

        var tip = token.LastWaypoint;
        if (tip is null)
        {
            CancelFacingEdit();
            return;
        }

        var snapped = BaronyBattleFacing.SnapFromDegrees(_facingPreviewDeg ?? BaronyBattleFacing.ToDegrees(tip.Facing));
        var changed = snapped != _facingEditStartFacing;
        var freeTurn = false;
        string? freeTurnAbility = null;
        if (changed && tip.FacingCostPaid <= 0)
        {
            var inPlace = tip.X == token.X && tip.Y == token.Y;
            if (CommanderFreeFacingAvailable(token, inPlace))
            {
                // Keep Facing / Look Away: one free turn per Movement phase spends no Move.
                token.FreeFacingUsed = true;
                tip.FacingCostPaid = 1;
                freeTurn = true;
                freeTurnAbility = inPlace ? "Keep Facing" : "Look Away";
            }
            else
            {
                if (tip.RemainingMoveAfter < 1)
                {
                    _snackBar.Add("Need 1 move point to change facing.", Severity.Warning);
                    CancelFacingEdit();
                    return;
                }
                tip.FacingCostPaid = 1;
                tip.RemainingMoveAfter = Math.Max(0, tip.RemainingMoveAfter - 1);
                // Spend RemainingMove only for a locked tip; provisional pays on lock.
                if (tip.Locked)
                    token.RemainingMove = tip.RemainingMoveAfter;
            }
        }

        tip.Facing = snapped;
        CancelFacingEdit();
        var facingCostNote = freeTurn ? ", free turn" : tip.FacingCostPaid > 0 ? ", −1 move" : "";
        if (freeTurn && !string.IsNullOrWhiteSpace(freeTurnAbility))
            AppendLocalLog(string.Empty, "phase", $"{token.Label} uses {freeTurnAbility} (free facing change).");
        await SaveAsync(systemMessage: changed
            ? $"{token.Label} facing set ({snapped * 45}°){facingCostNote}."
            : $"{token.Label} facing unchanged.");
        RefreshRange();
    }

    /// <summary>Keep Facing (in-place) / Look Away (after a move): one free commander turn per Movement phase.</summary>
    private static bool CommanderFreeFacingAvailable(BaronyBattleTokenDTO token, bool inPlace) =>
        !token.FreeFacingUsed
        && ((inPlace && token.CmdKeepFacing) || (!inPlace && token.CmdLookAway));

