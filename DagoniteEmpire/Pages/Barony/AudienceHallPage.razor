@page "/barony/audience-hall"
@layout BaronyLayout
@inherits BaronyPageBase
@attribute [Authorize(Roles = SD.Role_Admin + "," + SD.Role_GameMaster + "," + SD.Role_DukePlayer)]
@inject IDialogService _dialogService
@inject ICampaignRepository _campaignRepository
@inject IChapterRepository _chapterRepository

<PageTitle>Dagonite Empire | @L["Audience Hall"]</PageTitle>

<div class="audience-hall">
    @if (IsLoading)
    {
        <MudProgressCircular Indeterminate="true" Size="Size.Small" /> <span>@L["Loading..."]</span>
    }
    else if (LoadError is not null)
    {
        <MudAlert Severity="Severity.Info" Class="my-2">@LoadError</MudAlert>
    }
    else if (Barony is not null)
    {
        @if (CanManageAsMg)
        {
            <div class="audience-hall__mg-bar d-flex flex-wrap gap-2 mb-3">
                @if (_mode == HallMode.Audiences)
                {
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="CreateAudienceAsync"
                               Disabled="_busy">
                        @L["New audience"]
                    </MudButton>
                }
                else if (_mode == HallMode.Council)
                {
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="CreateCouncilTopicAsync"
                               Disabled="_busy || _councilAdvisorOptions.Count == 0">
                        @L["New council topic"]
                    </MudButton>
                }
                else if (_mode == HallMode.Adventures)
                {
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="CreateAdventureAsync"
                               Disabled="_busy">
                        @L["Add adventure"]
                    </MudButton>
                }
            </div>
        }

        <div class="audience-hall__hub">
            <div class="audience-hall__stage">
                @if (_mode == HallMode.Council)
                {
                    <div class="audience-hall__ring">
                        <div class="audience-hall__satellites audience-hall__satellites--left">
                            @foreach (var seat in LeftCouncilSeats)
                            {
                                <button type="button"
                                        class="audience-hall__advisor @(_selectedSeatKey == seat.Key ? "is-on" : "")"
                                        title="@seat.Label"
                                        @onclick="() => SelectSeat(seat)">
                                    @if (seat.Topics.Count > 0)
                                    {
                                        <span class="audience-hall__badge">@seat.Topics.Count</span>
                                    }
                                    <img src="@("/" + seat.Icon)" alt="" />
                                    <span>@seat.ShortLabel</span>
                                </button>
                            }
                        </div>
                        <div class="audience-hall__ring-core audience-hall__ring-core--static"
                             title="@L["General Council"]">
                            <img src="@("/" + MyIcon.CouncilTable)" class="audience-hall__throne" alt="" />
                            @if (UnassignedCouncilTopics.Count > 0)
                            {
                                <span class="audience-hall__badge">@UnassignedCouncilTopics.Count</span>
                            }
                        </div>
                        <div class="audience-hall__satellites audience-hall__satellites--right">
                            @foreach (var seat in RightCouncilSeats)
                            {
                                <button type="button"
                                        class="audience-hall__advisor @(_selectedSeatKey == seat.Key ? "is-on" : "")"
                                        title="@seat.Label"
                                        @onclick="() => SelectSeat(seat)">
                                    @if (seat.Topics.Count > 0)
                                    {
                                        <span class="audience-hall__badge">@seat.Topics.Count</span>
                                    }
                                    <img src="@("/" + seat.Icon)" alt="" />
                                    <span>@seat.ShortLabel</span>
                                </button>
                            }
                        </div>
                    </div>
                }
                else if (_mode == HallMode.Audiences)
                {
                    <div class="audience-hall__ring">
                        <div class="audience-hall__satellites audience-hall__satellites--left">
                            @foreach (var p in LeftPetitionerSatellites)
                            {
                                <button type="button"
                                        class="audience-hall__advisor @(CurrentAudience?.Id == p.Id ? "is-on" : "")"
                                        title="@p.Label"
                                        @onclick="() => SelectAudience(p.Id)">
                                    @if (p.NeedsAttention)
                                    {
                                        <span class="audience-hall__badge audience-hall__badge--flag">!</span>
                                    }
                                    <img src="@("/" + p.Icon)" alt="" />
                                    <span>@p.Label</span>
                                </button>
                            }
                        </div>
                        <img src="@("/" + MyIcon.Throne)" class="audience-hall__throne" alt="" />
                        <div class="audience-hall__satellites audience-hall__satellites--right">
                            @foreach (var p in RightPetitionerSatellites)
                            {
                                <button type="button"
                                        class="audience-hall__advisor @(CurrentAudience?.Id == p.Id ? "is-on" : "")"
                                        title="@p.Label"
                                        @onclick="() => SelectAudience(p.Id)">
                                    @if (p.NeedsAttention)
                                    {
                                        <span class="audience-hall__badge audience-hall__badge--flag">!</span>
                                    }
                                    <img src="@("/" + p.Icon)" alt="" />
                                    <span>@p.Label</span>
                                </button>
                            }
                            @if (OverflowPetitionerSatellites.Count > 0)
                            {
                                <MudMenu @bind-Open="_showMorePetitioners"
                                         CloseOnClick="false"
                                         Dense="true"
                                         AnchorOrigin="Origin.BottomCenter"
                                         TransformOrigin="Origin.TopCenter"
                                         Class="audience-hall__more-menu">
                                    <ActivatorContent>
                                        <button type="button"
                                                class="audience-hall__advisor"
                                                title="@L["More petitioners"]"
                                                @onclick="() => _showMorePetitioners = true">
                                            <span class="audience-hall__badge">@OverflowPetitionerSatellites.Count</span>
                                            <MudIcon Icon="@Icons.Material.Filled.MoreHoriz" Style="width:3rem;height:3rem;" />
                                            <span>@L["More"]</span>
                                        </button>
                                    </ActivatorContent>
                                    <ChildContent>
                                        @foreach (var p in OverflowPetitionerSatellites)
                                        {
                                            <MudMenuItem OnClick="() => SelectAudience(p.Id)">
                                                <div class="audience-hall__more-item">
                                                    <img src="@("/" + p.Icon)" alt="" />
                                                    <span>@p.Label</span>
                                                    @if (p.NeedsAttention)
                                                    {
                                                        <span class="audience-hall__badge audience-hall__badge--flag audience-hall__badge--inline">!</span>
                                                    }
                                                </div>
                                            </MudMenuItem>
                                        }
                                    </ChildContent>
                                </MudMenu>
                            }
                        </div>
                    </div>
                }
                else if (_mode == HallMode.Adventures)
                {
                    <div class="audience-hall__ring">
                        <div class="audience-hall__satellites audience-hall__satellites--left">
                            @foreach (var a in LeftAdventureSatellites)
                            {
                                <button type="button"
                                        class="audience-hall__advisor"
                                        title="@a.Label"
                                        @onclick="() => OpenAdventure(a)">
                                    <img src="@("/" + a.Icon)" alt="" />
                                    <span>@a.Label</span>
                                </button>
                            }
                        </div>
                        <img src="@("/" + MyIcon.AdventureCamp)" class="audience-hall__throne audience-hall__throne--zoom" alt="" />
                        <div class="audience-hall__satellites audience-hall__satellites--right">
                            @foreach (var a in RightAdventureSatellites)
                            {
                                <button type="button"
                                        class="audience-hall__advisor"
                                        title="@a.Label"
                                        @onclick="() => OpenAdventure(a)">
                                    <img src="@("/" + a.Icon)" alt="" />
                                    <span>@a.Label</span>
                                </button>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="audience-hall__ring">
                        <img src="@("/" + MyIcon.Throne)" class="audience-hall__throne" alt="" />
                    </div>
                }


                <div class="audience-hall__tiles">
                    <button type="button"
                            class="audience-hall__tile @(_mode == HallMode.Audiences ? "is-on" : "")"
                            disabled="@(_mode == HallMode.Audiences)"
                            @onclick="ToggleAudiences">
                        @if (PendingAudiences.Count > 0)
                        {
                            <span class="audience-hall__badge">@PendingAudiences.Count</span>
                        }
                        <img src="@("/" + MyIcon.TiedScroll)" alt="" />
                        <span>@L["Audiences"]</span>
                    </button>
                    <button type="button"
                            class="audience-hall__tile @(_mode == HallMode.Council ? "is-on" : "")"
                            disabled="@(_mode == HallMode.Council)"
                            @onclick="ToggleCouncil">
                        @if (OpenCouncilTopics.Count > 0)
                        {
                            <span class="audience-hall__badge">@OpenCouncilTopics.Count</span>
                        }
                        <img src="@("/" + MyIcon.People)" alt="" />
                        <span>@L["Council"]</span>
                    </button>
                    <button type="button"
                            class="audience-hall__tile @(_mode == HallMode.Adventures ? "is-on" : "")"
                            disabled="@(_mode == HallMode.Adventures)"
                            @onclick="ToggleAdventures">
                        @if (_hallAdventures.Count > 0)
                        {
                            <span class="audience-hall__badge">@_hallAdventures.Count</span>
                        }
                        <img src="@("/" + MyIcon.Bookmark)" alt="" />
                        <span>@L["Adventures"]</span>
                    </button>
                </div>
            </div>

            @if (_mode != HallMode.Adventures)
            {
                <div class="audience-hall__petition">
                    @if (_mode == HallMode.Audiences)
                    {
                        @if (ActiveAudiences.Count == 0)
                        {
                            <div class="audience-scroll">
                                <div class="audience-scroll__sheet audience-scroll__sheet--empty">
                                    <p>@L["No audiences right now. Well governed!"]</p>
                                </div>
                            </div>
                        }
                        else if (CurrentAudience is not null)
                        {
                            <AudiencePanel @key="CurrentAudience.Id"
                                           Audience="CurrentAudience"
                                           HallLayout="true"
                                           CanWriteAsGm="CanWriteAsGm"
                                           CanWriteAsBaron="CanWriteAsBaron"
                                           BaronCharacterName="BaronCharacterName"
                                           Busy="_busy"
                                           OnSpeak="req => SendReplyAsync(CurrentAudience, req)"
                                           OnAddResources="() => AddResourcesAsync(CurrentAudience)"
                                           OnCreateProject="() => CreateProjectAsync(CurrentAudience)"
                                           OnMakeChapter="() => MakeChapterAsync(CurrentAudience)"
                                           OnResolve="() => ResolveAsync(CurrentAudience)"
                                           OnDefer="() => DeferAsync(CurrentAudience)"
                                           OnDismiss="() => DismissAsync(CurrentAudience)" />
                            @if (ActiveAudiences.Count > 1)
                            {
                                <div class="audience-hall__pager">
                                    <button type="button" class="audience-hall__ink-btn" disabled="@(_audienceIndex <= 0)" @onclick="() => StepTopic(-1)">‹</button>
                                    <span>@(_audienceIndex + 1) / @ActiveAudiences.Count</span>
                                    <button type="button" class="audience-hall__ink-btn" disabled="@(_audienceIndex >= ActiveAudiences.Count - 1)" @onclick="() => StepTopic(1)">›</button>
                                </div>
                            }
                        }
                    }
                    else if (_mode == HallMode.Council && _selectedSeatKey is not null)
                    {
                        @if (CurrentCouncilTopic is null)
                        {
                            <div class="audience-scroll">
                                <div class="audience-scroll__sheet audience-scroll__sheet--empty">
                                    <p>@L["No council topics right now."]</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <AudiencePanel @key="CurrentCouncilTopic.Id"
                                           Audience="CurrentCouncilTopic"
                                           HallLayout="true"
                                           AdvisorIcon="@CurrentCouncilAdvisorIcon"
                                           CanWriteAsGm="CanWriteAsGm"
                                           CanWriteAsBaron="CanWriteAsBaron"
                                           BaronCharacterName="BaronCharacterName"
                                           Busy="_busy"
                                           CourtSpeakers="_courtSpeakers"
                                           OnSpeak="req => SendReplyAsync(CurrentCouncilTopic, req)"
                                           OnAddResources="() => AddResourcesAsync(CurrentCouncilTopic)"
                                           OnCreateProject="() => CreateProjectAsync(CurrentCouncilTopic)"
                                           OnMakeChapter="() => MakeChapterAsync(CurrentCouncilTopic)"
                                           OnResolve="() => ResolveAsync(CurrentCouncilTopic)"
                                           OnDismiss="() => DismissAsync(CurrentCouncilTopic)" />
                            @if (SelectedCouncilTopics.Count > 1)
                            {
                                <div class="audience-hall__pager">
                                    <button type="button" class="audience-hall__ink-btn" disabled="@(_councilIndex <= 0)" @onclick="() => StepTopic(-1)">‹</button>
                                    <span>@(_councilIndex + 1) / @SelectedCouncilTopics.Count</span>
                                    <button type="button" class="audience-hall__ink-btn" disabled="@(_councilIndex >= SelectedCouncilTopics.Count - 1)" @onclick="() => StepTopic(1)">›</button>
                                </div>
                            }
                        }
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private enum HallMode { Idle, Audiences, Council, Adventures }

    private const string GeneralSeatKey = "";

    private sealed record CouncilSeat(string Key, string Label, string ShortLabel, string Icon, List<BaronAudienceDTO> Topics);

    private sealed record PetitionerSatellite(int Id, string Icon, string Label, bool NeedsAttention);
    private sealed record AdventureSatellite(int Id, string Icon, string Label, string LinkUrl);

    private HallMode _mode = HallMode.Audiences;
    private List<BaronAudienceDTO> _audiences = new();
    private List<BaronyHallAdventureDTO> _hallAdventures = new();
    private List<AdvisorDTO> _advisors = new();
    private List<string> _courtSpeakers = new();
    private List<string> _councilAdvisorOptions = new();
    // -1 = no audience picked yet (petitioner ring shows on load, but the parchment stays empty
    // until an icon is clicked); ClampIndexes/StepTopic already treat this as "unselected".
    private int _audienceIndex = -1;
    private int _councilIndex;
    private string? _selectedSeatKey;
    private bool _busy;
    private bool _showMorePetitioners;

    private bool CanWriteAsGm => CanManageAsMg;
    private bool CanWriteAsBaron => CanEdit && !CanManageAsMg;
    private string? BaronCharacterName => UserInfo?.SelectedCharacter?.NPCName;

    // All open audiences (baron may have already replied) — shown as icons around the throne.
    private IReadOnlyList<BaronAudienceDTO> ActiveAudiences =>
        _audiences
            .Where(a => BaronAudienceKind.IsAudience(a.Kind) && a.IsActive)
            .OrderBy(a => a.TurnNumber)
            .ThenBy(a => a.Id)
            .ToList();

    // Subset still waiting on a reply — badge on throne icons.
    private IReadOnlyList<BaronAudienceDTO> PendingAudiences =>
        ActiveAudiences
            .Where(AudienceNeedsAttention)
            .ToList();

    private bool AudienceNeedsAttention(BaronAudienceDTO a) =>
        CanManageAsMg
            ? a.LastExchange is null || !a.LastExchange.IsFromPetitioner
            : a.LastExchange is null || a.LastExchange.IsFromPetitioner;

    private IReadOnlyList<BaronAudienceDTO> OpenCouncilTopics =>
        _audiences
            .Where(a => BaronAudienceKind.IsCouncil(a.Kind) && a.IsActive)
            .OrderBy(a => a.TurnNumber)
            .ThenBy(a => a.Id)
            .ToList();

    private IReadOnlyList<BaronAudienceDTO> UnassignedCouncilTopics =>
        OpenCouncilTopics.Where(t => CouncilSeats.All(s => !TopicsForAdvisor(s, t))).ToList();

    private List<CouncilSeat> CouncilSeats
    {
        get
        {
            var topics = OpenCouncilTopics;
            var seats = new List<CouncilSeat>();
            foreach (var advisor in BaronyCalc.OrderAdvisors(_advisors.Where(a => !a.IsBaron && !string.IsNullOrWhiteSpace(a.PersonName))))
            {
                var role = BaronyCalc.AdvisorRoleLabel(advisor);
                var name = advisor.PersonName.Trim();
                var label = $"{role} \u2014 {name}";
                var matched = topics.Where(t => TopicBelongsTo(t, label, name)).ToList();
                seats.Add(new CouncilSeat(label, label, role, AdvisorIconCatalog.IconFor(advisor.OfficeType, advisor.Id), matched));
            }

            return seats;
        }
    }

    private List<CouncilSeat> LeftCouncilSeats => SplitSides(CouncilSeats).Left;

    private List<CouncilSeat> RightCouncilSeats => SplitSides(CouncilSeats).Right;

    private List<PetitionerSatellite> PetitionerSatellites =>
        ActiveAudiences
            .Select(a => new PetitionerSatellite(
                a.Id,
                PetitionerIconCatalog.PathFor(a.PetitionerIcon),
                a.PetitionerName,
                AudienceNeedsAttention(a)))
            // Needs-attention (yellow badge) topics stay visible; already-answered ones sink
            // toward the "More" overflow first when there isn't room for every icon.
            .OrderByDescending(p => p.NeedsAttention)
            .ToList();

    /// <summary>Only this many icons fit comfortably around the throne. The "More" tile itself
    /// counts as one of them, so when there's overflow only 5 petitioners show alongside it.</summary>
    private const int MaxVisiblePetitioners = 6;

    private bool HasPetitionerOverflow => PetitionerSatellites.Count > MaxVisiblePetitioners;

    private List<PetitionerSatellite> VisiblePetitionerSatellites =>
        PetitionerSatellites.Take(HasPetitionerOverflow ? MaxVisiblePetitioners - 1 : MaxVisiblePetitioners).ToList();

    private List<PetitionerSatellite> OverflowPetitionerSatellites =>
        PetitionerSatellites.Skip(HasPetitionerOverflow ? MaxVisiblePetitioners - 1 : MaxVisiblePetitioners).ToList();

    /// <summary>"More" always renders on the right, so when it's present the right side gets one
    /// fewer petitioner icon to keep both flanks at 3 total (petitioners + "More").</summary>
    private List<PetitionerSatellite> LeftPetitionerSatellites =>
        HasPetitionerOverflow ? SplitSides(VisiblePetitionerSatellites).Right : SplitSides(VisiblePetitionerSatellites).Left;

    private List<PetitionerSatellite> RightPetitionerSatellites =>
        HasPetitionerOverflow ? SplitSides(VisiblePetitionerSatellites).Left : SplitSides(VisiblePetitionerSatellites).Right;

    private List<AdventureSatellite> AdventureSatellites =>
        _hallAdventures
            .OrderBy(a => a.SortOrder)
            .ThenBy(a => a.Id)
            .Select(a => new AdventureSatellite(
                a.Id,
                PetitionerIconCatalog.PathFor(a.IconPath),
                a.Name,
                a.LinkUrl))
            .ToList();

    private List<AdventureSatellite> LeftAdventureSatellites => SplitSides(AdventureSatellites).Left;

    private List<AdventureSatellite> RightAdventureSatellites => SplitSides(AdventureSatellites).Right;

    /// <summary>Alternates items left/right so both flanks of the throne stay balanced as the list grows.</summary>
    private static (List<T> Left, List<T> Right) SplitSides<T>(IReadOnlyList<T> items)
    {
        var left = new List<T>();
        var right = new List<T>();
        for (var i = 0; i < items.Count; i++)
        {
            if (i % 2 == 0)
                right.Add(items[i]);
            else
                left.Add(items[i]);
        }
        return (left, right);
    }

    private static bool TopicBelongsTo(BaronAudienceDTO topic, string label, string personName)
    {
        if (MatchesAdvisorText(topic.AssignedAdvisorName, label, personName))
            return true;
        if (string.IsNullOrWhiteSpace(topic.AssignedAdvisorName)
            && MatchesAdvisorText(topic.PetitionerName, label, personName))
            return true;
        return false;
    }

    private static bool MatchesAdvisorText(string? text, string label, string personName)
    {
        if (string.IsNullOrWhiteSpace(text))
            return false;
        if (string.Equals(text.Trim(), label, StringComparison.OrdinalIgnoreCase))
            return true;
        return !string.IsNullOrWhiteSpace(personName)
               && text.Contains(personName, StringComparison.OrdinalIgnoreCase);
    }

    private static bool TopicsForAdvisor(CouncilSeat seat, BaronAudienceDTO topic)
    {
        var dash = seat.Label.LastIndexOf('\u2014');
        var person = dash >= 0 ? seat.Label[(dash + 1)..].Trim() : seat.Label;
        return TopicBelongsTo(topic, seat.Label, person);
    }

    private IReadOnlyList<BaronAudienceDTO> SelectedCouncilTopics
    {
        get
        {
            if (_selectedSeatKey is null)
                return Array.Empty<BaronAudienceDTO>();
            if (_selectedSeatKey == GeneralSeatKey)
                return UnassignedCouncilTopics;
            return CouncilSeats.FirstOrDefault(s => s.Key == _selectedSeatKey)?.Topics
                   ?? (IReadOnlyList<BaronAudienceDTO>)Array.Empty<BaronAudienceDTO>();
        }
    }

    private BaronAudienceDTO? CurrentAudience =>
        _audienceIndex >= 0 && _audienceIndex < ActiveAudiences.Count ? ActiveAudiences[_audienceIndex] : null;

    private BaronAudienceDTO? CurrentCouncilTopic =>
        _councilIndex >= 0 && _councilIndex < SelectedCouncilTopics.Count ? SelectedCouncilTopics[_councilIndex] : null;

    // Icon of the advisor whose seat is selected — null for the General Council bucket.
    private string? CurrentCouncilAdvisorIcon =>
        _selectedSeatKey is not null && _selectedSeatKey != GeneralSeatKey
            ? CouncilSeats.FirstOrDefault(s => s.Key == _selectedSeatKey)?.Icon
            : null;

    protected override async Task OnInitializedAsync()
    {
        await LoadBaronyAsync();
        if (Barony is not null)
            await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (Barony is null)
            return;

        if (CanManageAsMg)
        {
            var advisors = await _baronyRepo.GetAvailableAdvisors(Barony.Id);
            _courtSpeakers = advisors
                .Select(a => a.Name)
                .Where(n => !string.IsNullOrWhiteSpace(n))
                .Select(n => n.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
                .ToList();

            var officeAdvisors = await _baronyRepo.GetAdvisors(Barony.Id);
            _councilAdvisorOptions = officeAdvisors
                .Where(a => !a.IsBaron && !string.IsNullOrWhiteSpace(a.PersonName))
                .Select(a => $"{BaronyCalc.AdvisorRoleLabel(a)} \u2014 {a.PersonName.Trim()}")
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }

        _audiences = await _baronyRepo.GetAudiences(BaronyId);
        _advisors = await _baronyRepo.GetAdvisors(Barony.Id);
        _hallAdventures = await _baronyRepo.GetHallAdventures(BaronyId);
        ClampIndexes();
    }

    private void ClampIndexes()
    {
        if (_audienceIndex >= ActiveAudiences.Count)
            _audienceIndex = Math.Max(0, ActiveAudiences.Count - 1);
        if (_councilIndex >= SelectedCouncilTopics.Count)
            _councilIndex = Math.Max(0, SelectedCouncilTopics.Count - 1);
        if (_selectedSeatKey is not null
            && _selectedSeatKey != GeneralSeatKey
            && CouncilSeats.All(s => s.Key != _selectedSeatKey))
            _selectedSeatKey = null;
    }

    // These only ENTER their mode now (buttons are disabled while already active, see markup)
    // so a stray double-click can never fall back to Idle/throne mid-animation.
    private void ToggleAudiences()
    {
        if (_mode == HallMode.Audiences)
            return;
        _selectedSeatKey = null;
        _mode = HallMode.Audiences;
    }

    private void ToggleCouncil()
    {
        if (_mode == HallMode.Council)
            return;
        _mode = HallMode.Council;
        _selectedSeatKey = null;
        _councilIndex = 0;
    }

    private void ToggleAdventures()
    {
        if (_mode == HallMode.Adventures)
            return;
        _selectedSeatKey = null;
        _mode = HallMode.Adventures;
    }

    private void SelectSeat(CouncilSeat seat)
    {
        _selectedSeatKey = seat.Key;
        _councilIndex = 0;
    }

    private void SelectAudience(int audienceId)
    {
        _showMorePetitioners = false;
        var list = ActiveAudiences;
        for (var i = 0; i < list.Count; i++)
        {
            if (list[i].Id == audienceId)
            {
                _audienceIndex = i;
                return;
            }
        }
    }

    private void OpenAdventure(AdventureSatellite adventure)
    {
        var url = ResolveAdventureLink(adventure.LinkUrl);
        if (url is null)
        {
            _snackBar.Add(L["Adventure link is invalid."], Severity.Warning);
            return;
        }

        var forceLoad = url.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
                        || url.StartsWith("https://", StringComparison.OrdinalIgnoreCase);
        _navigationManager.NavigateTo(url, forceLoad);
    }

    private static string? ResolveAdventureLink(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return null;

        var t = raw.Trim();
        if (Uri.TryCreate(t, UriKind.Absolute, out var abs)
            && (abs.Scheme == Uri.UriSchemeHttp || abs.Scheme == Uri.UriSchemeHttps))
            return abs.ToString();

        if (int.TryParse(t, out var chapterId) && chapterId > 0)
            return $"/chapter/{chapterId}";

        if (t.StartsWith('/'))
            return t;

        if (t.StartsWith("chapter/", StringComparison.OrdinalIgnoreCase))
            return "/" + t;

        return "/" + t.TrimStart('/');
    }

    private void StepTopic(int delta)
    {
        if (_mode == HallMode.Audiences)
            _audienceIndex = Math.Clamp(_audienceIndex + delta, 0, Math.Max(0, ActiveAudiences.Count - 1));
        else if (_mode == HallMode.Council)
            _councilIndex = Math.Clamp(_councilIndex + delta, 0, Math.Max(0, SelectedCouncilTopics.Count - 1));
    }

