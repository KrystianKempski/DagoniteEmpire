    private async Task AddResourcesAsync(BaronAudienceDTO? a)
    {
        if (a is null)
            return;

        var parameters = new DialogParameters<AudienceResourcesDialog>
        {
            { x => x.Audience, a },
        };
        var dialog = await _dialogService.ShowAsync<AudienceResourcesDialog>("Add resources", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not AudienceResourcesDialog.AudienceResourcesResult data)
            return;

        _busy = true;
        try
        {
            var additive = a.Additive?.Clone() ?? new PpbVector();
            additive.AddInPlace(data.Delta);
            a.Additive = additive;
            a.Prestige += data.Prestige;
            a.Honor += data.Honor;
            a.Fear += data.Fear;
            await _baronyRepo.SaveAudience(a);

            var stockDelta = ResourceCatalog.Slice(data.Delta);
            if (!stockDelta.IsEmpty && Barony is not null)
            {
                var stocks = ResourceCatalog.Slice(Barony.ResourceStocks);
                stocks.AddInPlace(stockDelta);
                Barony.ResourceStocks = stocks;
                Barony.FoodInGranaries = stocks[Ppb.Food];
                Barony.TreasuryGold = stocks[Ppb.Treasury];
                await _baronyRepo.UpdateBarony(Barony);
            }

            await _baronyRepo.SaveAudienceExchange(new BaronAudienceExchangeDTO
            {
                AudienceId = a.Id,
                Body = data.Note,
                IsFromPetitioner = false,
                IsResourceChange = true,
                Additive = data.Delta.Clone(),
                Prestige = data.Prestige,
                Honor = data.Honor,
                Fear = data.Fear,
                TurnNumber = Barony!.TurnNumber,
            });

            await ReloadAsync();
            NotifyResourceHud();
            _snackBar.Add(L["Resources added."], Severity.Success);
        }
        catch (Exception ex)
        {
            _snackBar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

