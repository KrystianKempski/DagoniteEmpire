@page "/barony/buildings"
@layout BaronyLayout
@inherits BaronyPageBase
@attribute [Authorize(Roles = SD.Role_Admin + "," + SD.Role_GameMaster + "," + SD.Role_DukePlayer)]
@inject IDialogService _dialogService
@inject IJSRuntime JS

<PageTitle>Dagonitowe Imperium | Budynki</PageTitle>

@if (IsLoading)
{
    <MudProgressCircular Indeterminate="true" Size="Size.Small" /> <span>Ładowanie katalogu budynków...</span>
}
else if (LoadError is not null)
{
    <MudAlert Severity="Severity.Info" Class="my-2">@LoadError</MudAlert>
}
else
{
    <div class="buildings-page">
        <BaronyPageHeader Title="Budynki" HelpKey="buildings" ShowSectionToggle="false">
            <Summary>
                <span class="buildings-catalog-count">@FilteredCount z @_templates.Count pozycji</span>
            </Summary>
        </BaronyPageHeader>

        <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="buildings-page__intro">
            Katalog budynków i ulepszeń terenu. Kolumny PPB używają osobnych podkolumn addytywnych (+) i procentowych (%). Kliknij nagłówki, aby sortować.
            @if (CanEdit)
            {
                <text> Użyj młotka na budynku miejskim, aby rozpocząć projekt budowy (dodaje do Panelu Domeny po ukończeniu).</text>
            }
        </MudText>

        @if (_templates.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                Katalog budynków jest pusty.
                @if (CanManageAsMg)
                {
                    <text> Użyj <strong>Dodaj budynek</strong> poniżej, aby utworzyć pierwszy szablon.</text>
                }
            </MudAlert>
        }

        <div class="buildings-catalog-filters">
                <MudTextField @bind-Value="_nameFilter"
                              Placeholder="Filtruj po nazwie…"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Class="buildings-catalog-filters__name"
                              Disabled="@(_templates.Count == 0)" />
                <MudSelect T="string"
                           Label="Typ"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true"
                           Dense="true"
                           Class="buildings-catalog-filters__kind"
                           @bind-Value="_kindFilter"
                           Disabled="@(_templates.Count == 0)">
                    <MudSelectItem Value="@BuildingKind.Building">Budynek</MudSelectItem>
                    <MudSelectItem Value="@BuildingKind.Improvement">Ulepszenie</MudSelectItem>
                </MudSelect>
                @if (CanManageAsMg)
                {
                    <MudButton Variant="Variant.Filled"
                               Class="barony-turn-btn barony-turn-btn--solid buildings-catalog-filters__add"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenCreateTemplateDialogAsync">
                        Dodaj budynek
                    </MudButton>
                }
        </div>

        @if (_templates.Count > 0)
        {
            @if (FilteredCount == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                    Żaden budynek nie pasuje do bieżących filtrów.
                </MudAlert>
            }
            else
            {
                <div class="buildings-page__table-area">
                    <div class="buildings-catalog-scroll">
                        <BuildingCatalogTable Items="@FilteredTemplates"
                                              CanProposeBuild="@CanEdit"
                                              CanManageCatalog="@CanManageAsMg"
                                              OnEditTemplate="OpenEditTemplateDialogAsync"
                                              OnDeleteTemplate="DeleteTemplateAsync"
                                              OnProposeBuild="OnProposeBuildAsync" />
                    </div>
                </div>
            }
        }
    </div>
}

@code {
    private List<BuildingTemplateDTO> _templates = new();
    private string _nameFilter = "";
    private string? _kindFilter;

    private int FilteredCount => FilteredTemplates.Count();

    private IEnumerable<BuildingTemplateDTO> FilteredTemplates =>
        _templates
            .Where(MatchesNameFilter)
            .Where(MatchesKindFilter);

    private bool MatchesNameFilter(BuildingTemplateDTO item)
        => string.IsNullOrWhiteSpace(_nameFilter)
           || item.Name.Contains(_nameFilter, StringComparison.OrdinalIgnoreCase);

    private bool MatchesKindFilter(BuildingTemplateDTO item)
        => string.IsNullOrEmpty(_kindFilter) || item.Kind == _kindFilter;

    protected override async Task OnInitializedAsync()
    {
        await LoadBaronyAsync();
        if (Barony is null)
            return;

        await ReloadTemplatesAsync();
    }

    private async Task OpenCreateTemplateDialogAsync()
    {
        if (!CanManageAsMg)
            return;

        var existingNames = _templates
            .Select(t => t.Name)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        var parameters = new DialogParameters<CreateBuildingTemplateDialog>
        {
            { x => x.DefaultKind, _kindFilter },
            { x => x.ExistingNames, existingNames },
        };

        var dialog = await _dialogService.ShowAsync<CreateBuildingTemplateDialog>(
            "Nowa pozycja katalogu",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not BuildingTemplateDTO template)
            return;

        try
        {
            var saved = await _baronyRepo.SaveBuildingTemplate(template);
            await ReloadTemplatesAsync();
            _snackBar.Add($"Utworzono pozycję katalogu “{saved.Name}”.", Severity.Success);
        }
        catch (Exception ex)
        {
            _snackBar.Add("Nie udało się zapisać pozycji katalogu: " + ex.Message, Severity.Error);
        }
    }

    private async Task OnProposeBuildAsync(BuildingTemplateDTO template)
    {
        if (!CanEdit || Barony is null)
            return;

        if (!string.Equals(template.Kind, BuildingKind.Building, StringComparison.OrdinalIgnoreCase))
        {
            _snackBar.Add("Ulepszenia terenu buduje się z Mapy terenu.", Severity.Info);
            return;
        }

        var parameters = new DialogParameters<CreateCityBuildingProjectDialog>
        {
            { x => x.BaronyId, Barony.Id },
            { x => x.Template, template },
        };

        var dialog = await _dialogService.ShowAsync<CreateCityBuildingProjectDialog>(
            "Nowy projekt budowy",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not BaronyProjectDTO project)
            return;

        try
        {
            await _baronyRepo.SaveProject(project);
            _snackBar.Add("Dodano projekt budowy — zobacz zakładkę Projekty.", Severity.Success);
        }
        catch (Exception ex)
        {
            _snackBar.Add("Nie udało się utworzyć projektu: " + ex.Message, Severity.Error);
        }
    }

    private async Task OpenEditTemplateDialogAsync(BuildingTemplateDTO template)
    {
        if (!CanManageAsMg)
            return;

        var existingNames = _templates
            .Where(t => t.Id != template.Id)
            .Select(t => t.Name)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        var parameters = new DialogParameters<CreateBuildingTemplateDialog>
        {
            { x => x.ExistingNames, existingNames },
            { x => x.InitialTemplate, template },
        };

        var dialog = await _dialogService.ShowAsync<CreateBuildingTemplateDialog>(
            "Edytuj pozycję katalogu",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not BuildingTemplateDTO edited)
            return;

        try
        {
            var saved = await _baronyRepo.SaveBuildingTemplate(edited);
            await ReloadTemplatesAsync();
            _snackBar.Add($"Zaktualizowano pozycję katalogu “{saved.Name}”.", Severity.Success);
        }
        catch (Exception ex)
        {
            _snackBar.Add("Nie udało się zaktualizować pozycji katalogu: " + ex.Message, Severity.Error);
        }
    }

    private async Task DeleteTemplateAsync(BuildingTemplateDTO template)
    {
        if (!CanManageAsMg || template.Id <= 0)
            return;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Usunąć pozycję katalogu \"{template.Name}\"? Tej operacji nie można cofnąć.");

        if (!confirmed)
            return;

        try
        {
            await _baronyRepo.DeleteBuildingTemplate(template.Id);
            await ReloadTemplatesAsync();
            _snackBar.Add($"Usunięto pozycję katalogu “{template.Name}”.", Severity.Success);
        }
        catch (Exception ex)
        {
            _snackBar.Add("Nie udało się usunąć pozycji katalogu: " + ex.Message, Severity.Error);
        }
    }

    private async Task ReloadTemplatesAsync()
    {
        _templates = (await _baronyRepo.GetBuildingTemplates())
            .OrderBy(t => t.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }
}
