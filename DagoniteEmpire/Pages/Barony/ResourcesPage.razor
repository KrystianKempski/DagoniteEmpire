@page "/barony/resources"
@layout BaronyLayout
@inherits BaronyPageBase
@attribute [Authorize(Roles = SD.Role_Admin + "," + SD.Role_GameMaster + "," + SD.Role_DukePlayer)]

<PageTitle>Dagonite Empire | Barony Resources</PageTitle>

@if (IsLoading)
{
    <MudProgressCircular Indeterminate="true" Size="Size.Small" /> <span>Loading...</span>
}
else if (LoadError is not null)
{
    <MudAlert Severity="Severity.Info" Class="my-2">@LoadError</MudAlert>
}
else if (_overview is not null)
{
    <BaronyPageHeader Title="Resources" />
    <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mb-3">
        PPB income and expenses with current resource state. Detailed formulas - [TO BE COMPLETED].
    </MudText>

    <div class="barony-card mb-3">
        <div class="barony-card__title">Accumulator State</div>
        <div class="barony-info-grid">
            <div class="barony-stat"><span class="barony-stat__label">Food in Granaries</span><span class="barony-stat__value">@Num(_overview.Barony.FoodInGranaries)</span></div>
            <div class="barony-stat"><span class="barony-stat__label">Treasury Gold</span><span class="barony-stat__value">@Num(_overview.Barony.TreasuryGold)</span></div>
            <div class="barony-stat"><span class="barony-stat__label">Baron Purse</span><span class="barony-stat__value">@Num(_overview.Barony.BaronPurseGold)</span></div>
        </div>
    </div>

    <SectionTable Title="Turn Income (PPB)" Rows="@_incomeRows" TableClass="ppb-table--lined" />
    <SectionTable Title="Turn Expenses (PPB)" Rows="@_expenseRows" TableClass="ppb-table--lined" />

    <div class="barony-card mt-3">
        <div class="barony-card__title">PPB Resource Balance (Draft)</div>
        <div style="overflow-x:auto;">
            <PpbTable Rows="@_balanceRows" Summary="@_netBalance" SummaryLabel="Net State" TableClass="ppb-table--zebra" />
        </div>
    </div>
}

@code {
    private BaronyOverviewDTO? _overview;
    private List<PpbModifierRow> _incomeRows = new();
    private List<PpbModifierRow> _expenseRows = new();
    private List<PpbModifierRow> _balanceRows = new();
    private PpbVector _netBalance = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadBaronyAsync();
        if (Barony is null)
            return;

        _overview = await _baronyRepo.GetOverview(Barony.Id);
        if (_overview is null)
            return;

        var total = BaronyCalc.GrandTotal(_overview);

        _incomeRows = new List<PpbModifierRow>
        {
            BaronyCalc.Row("Production This Turn", Vec(Ppb.Production, total[Ppb.Production]), new(), "Σ modifiers -> Production"),
            BaronyCalc.Row("Food This Turn", Vec(Ppb.Food, total[Ppb.Food]), new(), "Σ modifiers -> Food"),
            BaronyCalc.Row("Economy This Turn", Vec(Ppb.Economy, total[Ppb.Economy]), new(), "Σ modifiers -> Economy"),
            BaronyCalc.Row("Projects (results)", SumProjectResults(), new(), "Sum of completed / in-progress results"),
            BaronyCalc.Row("Events (income)", SumEventIncome(), new()),
            BaronyCalc.Row("Other Income", new(), new(), "[TO BE COMPLETED]"),
        };

        _expenseRows = new List<PpbModifierRow>
        {
            BaronyCalc.Row("Advisor Upkeep", Vec(Ppb.Treasury, -SumAdvisorUpkeep()), new()),
            BaronyCalc.Row("Buildings (upkeep)", SumBuildingCosts(), new()),
            BaronyCalc.Row("Projects (costs)", SumProjectCosts(), new()),
            BaronyCalc.Row("Other Expenses", new(), new(), "[TO BE COMPLETED]"),
        };

        var incomeSum = BaronyCalc.SumAdditive(_incomeRows);
        var expenseSum = BaronyCalc.SumAdditive(_expenseRows);

        _balanceRows = new List<PpbModifierRow>
        {
            new() { Label = "Previous Stores", Additive = PreviousStores() },
            new() { Label = "Σ turn income", Additive = incomeSum },
            new() { Label = "Σ turn expenses", Additive = expenseSum },
        };

        _netBalance = PreviousStores();
        _netBalance.AddInPlace(incomeSum);
        _netBalance.AddInPlace(expenseSum);
    }

    private PpbVector PreviousStores()
    {
        var v = new PpbVector();
        v[Ppb.Food] = _overview!.Barony.FoodInGranaries;
        v[Ppb.Treasury] = _overview.Barony.TreasuryGold;
        return v;
    }

    private PpbVector SumProjectResults()
    {
        var v = new PpbVector();
        foreach (var p in _overview!.Projects.Where(x => x.Status != ProjectStatus.Cancelled))
            v.AddInPlace(p.Result);
        return v;
    }

    private PpbVector SumProjectCosts()
    {
        var v = new PpbVector();
        foreach (var p in _overview!.Projects.Where(x => x.Status == ProjectStatus.InProgress))
            v.AddInPlace(p.Cost);
        return v;
    }

    private PpbVector SumEventIncome()
    {
        var v = new PpbVector();
        foreach (var e in _overview!.Events.Where(x => x.IsActiveOnTurn(_overview.Barony.TurnNumber)))
            v.AddInPlace(e.Additive);
        return v;
    }

    private PpbVector SumBuildingCosts()
    {
        var v = new PpbVector();
        foreach (var b in _overview!.Buildings)
            if (b.Additive[Ppb.Treasury] < 0)
                v.AddInPlace(Vec(Ppb.Treasury, b.Additive[Ppb.Treasury]));
        return v;
    }

    private decimal SumAdvisorUpkeep() => _overview!.Advisors.Sum(a => a.UpkeepGold);

    private static PpbVector Vec(Ppb p, decimal val)
    {
        var v = new PpbVector();
        v[p] = val;
        return v;
    }

    private static string Num(decimal v)
    {
        var r = decimal.Round(v, 2);
        return r == decimal.Truncate(r) ? ((long)r).ToString() : r.ToString("0.##");
    }
}
