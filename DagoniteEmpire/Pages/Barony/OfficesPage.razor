@page "/barony/offices"
@layout BaronyLayout
@inherits BaronyPageBase
@attribute [Authorize(Roles = SD.Role_Admin + "," + SD.Role_GameMaster + "," + SD.Role_DukePlayer)]
@inject IDialogService _dialogService

<PageTitle>Dagonite Empire | Offices</PageTitle>

@if (IsLoading)
{
    <MudProgressCircular Indeterminate="true" Size="Size.Small" /> <span>Loading offices...</span>
}
else if (LoadError is not null)
{
    <MudAlert Severity="Severity.Info" Class="my-2">@LoadError</MudAlert>
}
else if (Barony is not null)
{
    <BaronyPageHeader Title="Offices">
        <Summary>
            <div class="offices-cost-total" title="Combined upkeep of all offices per turn">
                <span class="offices-cost-total__label">Σ advisor upkeep</span>
                <span class="offices-cost-total__value">@FmtUpkeep(_totalUpkeep)</span>
            </div>
        </Summary>
    </BaronyPageHeader>

    @foreach (var advisor in _offices)
    {
        <AdvisorOfficeSection Advisor="@advisor"
                            CustomModifiers="@ModifiersFor(advisor.Id)"
                            AvailableAdvisors="@_availableAdvisors"
                            AllAdvisors="@_offices"
                            CanEdit="@CanEdit"
                            OnChanged="ReloadAsync" />
    }

    <BaronySection Title="Available advisors">
        <ChildContent>
            <div style="overflow-x:auto;">
                <table class="ppb-table ppb-table--lined">
                    <thead>
                        <tr>
                            <th class="ppb-row-label">Name</th>
                            <th>Description</th>
                            <th>Skills</th>
                            @if (CanEdit)
                            {
                                <th>Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var person in _availableAdvisors)
                        {
                            <tr>
                                <td class="ppb-row-label">@person.Name</td>
                                <td>@person.Description</td>
                                <td><PpbSummaryChips Vector="@person.Skills" /></td>
                                @if (CanEdit)
                                {
                                    <td>
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAvailableAdvisorAsync(person))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAvailableAdvisorAsync(person))" />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (CanEdit)
            {
                <MudButton Variant="Variant.Outlined" Class="mt-2" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAvailableAdvisorAsync">
                    Add available advisor
                </MudButton>
            }
        </ChildContent>
    </BaronySection>

    @if (CanEdit)
    {
        <MudButton Variant="Variant.Outlined"
                   Class="mt-2"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddOfficeAsync">
            Add Office
        </MudButton>
    }
}

@code {
    private List<AdvisorDTO> _offices = new();
    private List<AvailableAdvisorDTO> _availableAdvisors = new();
    private List<AdvisorInfluenceModifierDTO> _modifiers = new();
    private decimal _totalUpkeep;

    private static string FmtUpkeep(decimal value)
    {
        if (value == 0m)
            return "0";
        var rounded = decimal.Round(value, 2);
        return rounded == decimal.Truncate(rounded)
            ? ((long)rounded).ToString()
            : rounded.ToString("0.##");
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadBaronyAsync();
        if (Barony is null)
            return;

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (Barony is null)
            return;

        var advisors = await _baronyRepo.GetAdvisors(Barony.Id);
        _availableAdvisors = await _baronyRepo.GetAvailableAdvisors(Barony.Id);
        _offices = BaronyCalc.OrderOffices(advisors);
        _totalUpkeep = BaronyCalc.SumOfficeUpkeep(advisors, _modifiers);
        _modifiers = await _baronyRepo.GetAdvisorInfluenceModifiers(Barony.Id);
        StateHasChanged();
    }

    private List<AdvisorInfluenceModifierDTO> ModifiersFor(int advisorId)
        => _modifiers.Where(m => m.AdvisorId == advisorId).ToList();

    private async Task AddOfficeAsync()
    {
        if (Barony is null)
            return;

        var parameters = new DialogParameters<AddOfficeDialog>
        {
            { x => x.BaronyId, Barony.Id },
        };

        var dialog = await _dialogService.ShowAsync<AddOfficeDialog>(
            "Add Office",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not AdvisorDTO draft)
            return;

        await _baronyRepo.SaveAdvisor(draft);
        _snackBar.Add("Office created.", Severity.Success);
        await ReloadAsync();
    }

    private async Task AddAvailableAdvisorAsync()
    {
        if (Barony is null) return;
        await OpenAvailableAdvisorDialog(new AvailableAdvisorDTO { BaronyId = Barony.Id });
    }

    private async Task EditAvailableAdvisorAsync(AvailableAdvisorDTO person)
        => await OpenAvailableAdvisorDialog(new AvailableAdvisorDTO
        {
            Id = person.Id,
            BaronyId = person.BaronyId,
            Name = person.Name,
            Description = person.Description,
            Skills = person.Skills.Clone(),
        });

    private async Task OpenAvailableAdvisorDialog(AvailableAdvisorDTO draft)
    {
        var dialog = await _dialogService.ShowAsync<AvailableAdvisorEditDialog>(
            draft.Id > 0 ? "Edit Available Advisor" : "Add Available Advisor",
            new DialogParameters<AvailableAdvisorEditDialog> { { x => x.Advisor, draft } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not AvailableAdvisorDTO saved)
            return;

        saved.BaronyId = Barony!.Id;
        await _baronyRepo.SaveAvailableAdvisor(saved);
        _snackBar.Add("Available advisor saved.", Severity.Success);
        await ReloadAsync();
    }

    private async Task DeleteAvailableAdvisorAsync(AvailableAdvisorDTO person)
    {
        if (person.Id <= 0) return;
        await _baronyRepo.DeleteAvailableAdvisor(person.Id);
        _snackBar.Add("Available advisor removed.", Severity.Success);
        await ReloadAsync();
    }
}
