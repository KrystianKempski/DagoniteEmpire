@page "/barony/offices"
@layout BaronyLayout
@inherits BaronyPageBase
@attribute [Authorize(Roles = SD.Role_Admin + "," + SD.Role_GameMaster + "," + SD.Role_DukePlayer)]
@inject IDialogService _dialogService

<PageTitle>Dagonitowe Imperium | Dwór</PageTitle>

@if (IsLoading)
{
    <MudProgressCircular Indeterminate="true" Size="Size.Small" /> <span>Ładowanie urzędów...</span>
}
else if (LoadError is not null)
{
    <MudAlert Severity="Severity.Info" Class="my-2">@LoadError</MudAlert>
}
else if (Barony is not null)
{
    <BaronyPageHeader Title="Dwór" HelpKey="offices">
        <Summary>
            <BaronyTooltip Text="Łączne utrzymanie wszystkich urzędów na turę">
                <div class="offices-cost-total">
                    <span class="offices-cost-total__label">Σ utrzymanie doradców</span>
                    <span class="offices-cost-total__value">@FmtUpkeep(_totalUpkeep)</span>
                </div>
            </BaronyTooltip>
        </Summary>
    </BaronyPageHeader>

    @foreach (var advisor in _offices)
    {
        <AdvisorOfficeSection Advisor="@advisor"
                            CustomModifiers="@ModifiersFor(advisor.Id)"
                            AvailableAdvisors="@_availableAdvisors"
                            AllAdvisors="@_offices"
                            CanEdit="@CanEdit"
                            CanManage="@CanManageAsMg"
                            OnChanged="ReloadAsync" />
    }

    <AvailableAdvisorsSection Advisors="@_availableAdvisors"
                              CanManage="@CanManageAsMg"
                              CanEdit="@CanEdit"
                              OnEdit="EditAvailableAdvisorAsync"
                              OnDelete="DeleteAvailableAdvisorAsync"
                              OnAdd="AddAvailableAdvisorAsync"
                              OnSheetChanged="SaveCourtSheetAsync" />

    @if (CanManageAsMg)
    {
        <MudButton Variant="Variant.Outlined"
                   Class="mt-2"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddOfficeAsync">
            Dodaj urząd
        </MudButton>
    }
}

@code {
    private List<AdvisorDTO> _offices = new();
    private List<AvailableAdvisorDTO> _availableAdvisors = new();
    private List<AdvisorInfluenceModifierDTO> _modifiers = new();
    private decimal _totalUpkeep;

    private static string FmtUpkeep(decimal value) => PpbFormat.Number(value);

    protected override async Task OnInitializedAsync()
    {
        await LoadBaronyAsync();
        if (Barony is null)
            return;

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (Barony is null)
            return;

        var advisors = await _baronyRepo.GetAdvisors(Barony.Id);
        _availableAdvisors = await _baronyRepo.GetAvailableAdvisors(Barony.Id);
        _offices = BaronyCalc.OrderOffices(advisors);
        _totalUpkeep = BaronyCalc.SumOfficeUpkeep(advisors, _modifiers);
        _modifiers = await _baronyRepo.GetAdvisorInfluenceModifiers(Barony.Id);
        StateHasChanged();
    }

    private List<AdvisorInfluenceModifierDTO> ModifiersFor(int advisorId)
        => _modifiers.Where(m => m.AdvisorId == advisorId).ToList();

    private async Task AddOfficeAsync()
    {
        if (Barony is null || !CanManageAsMg)
            return;

        var parameters = new DialogParameters<AddOfficeDialog>
        {
            { x => x.BaronyId, Barony.Id },
        };

        var dialog = await _dialogService.ShowAsync<AddOfficeDialog>(
            "Dodaj urząd",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not AdvisorDTO draft)
            return;

        await _baronyRepo.SaveAdvisor(draft);
        _snackBar.Add("Utworzono urząd.", Severity.Success);
        await ReloadAsync();
    }

    private async Task AddAvailableAdvisorAsync()
    {
        if (Barony is null || !CanManageAsMg) return;
        await OpenAvailableAdvisorDialog(new AvailableAdvisorDTO
        {
            BaronyId = Barony.Id,
            Sheet = CourtCharacterSheet.CreateDefault(),
        });
    }

    private async Task EditAvailableAdvisorAsync(AvailableAdvisorDTO person)
    {
        if (!CanManageAsMg) return;
        await OpenAvailableAdvisorDialog(new AvailableAdvisorDTO
        {
            Id = person.Id,
            BaronyId = person.BaronyId,
            Name = person.Name,
            Description = person.Description,
            Sheet = person.Sheet ?? CourtCharacterSheet.CreateDefault(),
            Skills = person.Skills.Clone(),
        });
    }

    private async Task OpenAvailableAdvisorDialog(AvailableAdvisorDTO draft)
    {
        if (!CanManageAsMg) return;
        var dialog = await _dialogService.ShowAsync<AvailableAdvisorEditDialog>(
            draft.Id > 0 ? "Edytuj osobę dworu" : "Dodaj osobę dworu",
            new DialogParameters<AvailableAdvisorEditDialog> { { x => x.Advisor, draft } },
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not AvailableAdvisorDTO saved)
            return;

        saved.BaronyId = Barony!.Id;
        await _baronyRepo.SaveAvailableAdvisor(saved);
        _snackBar.Add("Zapisano osobę dworu.", Severity.Success);
        await ReloadAsync();
    }

    private async Task DeleteAvailableAdvisorAsync(AvailableAdvisorDTO person)
    {
        if (!CanManageAsMg || person.Id <= 0) return;
        await _baronyRepo.DeleteAvailableAdvisor(person.Id);
        _snackBar.Add("Usunięto osobę dworu.", Severity.Success);
        await ReloadAsync();
    }

    private async Task SaveCourtSheetAsync(AvailableAdvisorDTO person)
    {
        if (!CanEdit || person.Id <= 0)
            return;

        person.BaronyId = Barony!.Id;
        await _baronyRepo.SaveAvailableAdvisor(person);
        _snackBar.Add("Zapisano źródła dworu.", Severity.Success);
        await ReloadAsync();
    }
}
