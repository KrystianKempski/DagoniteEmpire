@page "/barony/budget"
@layout BaronyLayout
@inherits BaronyPageBase
@attribute [Authorize(Roles = SD.Role_Admin + "," + SD.Role_GameMaster + "," + SD.Role_DukePlayer)]
@inject ICharacterRepository _characterRepo
@inject IDialogService _dialogService

<PageTitle>Dagonite Empire | Barony Budget</PageTitle>

@if (IsLoading)
{
    <MudProgressCircular Indeterminate="true" Size="Size.Small" /> <span>@L["Loading..."]</span>
}
else if (LoadError is not null)
{
    <MudAlert Severity="Severity.Info" Class="my-2">@LoadError</MudAlert>
}
else if (_overview is not null)
{
    <BaronyPageHeader Title="@(L["Budget"])" HelpKey="budget" />

    <BaronySection Title="@(L["Gold Overview"])">
        <Summary>
            <span class="budget-overview-chips">
                <span>@L["Treasury"] <b>@Num(_overview.Barony.TreasuryGold)</b></span>
                <span>@L["Purse"] <b>@Num(_overview.Barony.BaronPurseGold)</b></span>
                <span>@L["Turn"] <b style="color:@(_turnBalance >= 0 ? "var(--barony-pos)" : "var(--barony-neg)")">@Num(_turnBalance)</b></span>
            </span>
        </Summary>
        <ChildContent>
            <MudGrid>
                <MudItem xs="12" md="4">
                    <div class="barony-stat"><span class="barony-stat__label">@L["Barony Treasury"]</span><span class="barony-stat__value">@Num(_overview.Barony.TreasuryGold)</span></div>
                </MudItem>
                <MudItem xs="12" md="4">
                    <div class="barony-stat"><span class="barony-stat__label">@L["Baron Purse"]</span><span class="barony-stat__value">@Num(_overview.Barony.BaronPurseGold)</span></div>
                </MudItem>
                <MudItem xs="12" md="4">
                    <div class="barony-stat">
                        <span class="barony-stat__label">@L["Treasury Turn Balance"]</span>
                        <span class="barony-stat__value" style="color:@(_turnBalance >= 0 ? "var(--barony-pos)" : "var(--barony-neg)")">@Num(_turnBalance)</span>
                    </div>
                    <MudText Typo="Typo.caption" Style="color:var(--barony-muted);">
                        Domain Panel Gold (@Num(_domainPanelGold)) − liege tribute (@Num(_liegeTribute))
                    </MudText>
                </MudItem>
            </MudGrid>
            @if (CanManageAsMg)
            {
                <div class="d-flex flex-wrap align-center gap-3 mt-3">
                    <MudNumericField T="decimal"
                                     @bind-Value="_liegeTributePercent"
                                     Label="@(L["Liege tribute % (pay senior)"])"
                                     HelperText="@(L["Share of gross gold income paid to the senior before expenses. Default 15%."])"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0"
                                     Max="100"
                                     Style="max-width:14rem;" />
                    <MudNumericField T="decimal"
                                     @bind-Value="_vassalTributePercent"
                                     Label="@(L["Vassal fief % (keep from villages)"])"
                                     HelperText="@(L["Share of village gold on vassal fiefs kept by the baron. Default 15%."])"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0"
                                     Max="100"
                                     Style="max-width:16rem;" />
                    <MudButton Variant="Variant.Filled"
                               Class="baron-influence-save-btn"
                               Disabled="@(!_tributeRatesDirty)"
                               OnClick="SaveTributeRatesAsync">
                        @L["Save rates"]
                    </MudButton>
                </div>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="mt-2" Style="color:var(--barony-muted);">
                    Liege tribute: @_liegeTributePercent.ToString("0.#")% of gross income (@Num(_grossGoldIncome) → @Num(_liegeTribute) gold).
                    Vassal fief share: @_vassalTributePercent.ToString("0.#")% of village gold on vassal lands.
                </MudText>
            }
        </ChildContent>
    </BaronySection>

    <BaronySection Title="@(L["Barony Treasury"])">
        <Summary>
            <span class="budget-overview-chips">
                <span>@L["Income"] <b class="ppb-cell-pos">@Fmt(_totalIncome)</b></span>
                <span>@L["Expenses"] <b class="ppb-cell-neg">@Fmt(_totalExpense)</b></span>
            </span>
        </Summary>
        <ChildContent>
            <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mb-2">
                Gold income/expenses from Domain Panel section totals (Final Gold already includes %).
                Fief income is village gold (moved out of Improvements); Fief expense is liege tribute.
                Turn balance = Domain Panel Final Gold − liege tribute.
            </MudText>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <div class="barony-card">
                        <div class="barony-card__title">@L["Income"]</div>
                        <table class="ppb-table ppb-table--lined">
                            <thead><tr><th class="ppb-row-label">@L["Source"]</th><th>@L["Gold"]</th></tr></thead>
                            <tbody>
                                @foreach (var line in _incomeLines)
                                {
                                    <tr>
                                        <td class="ppb-row-label">
                                            <BaronyTooltip Title="@line.Source" Text="@line.Formula">
                                                <span>@line.Source</span>
                                            </BaronyTooltip>
                                        </td>
                                        <td class="@ValueClass(line.Gold)"><b>@Fmt(line.Gold)</b></td>
                                    </tr>
                                }
                                <tr class="ppb-summary-row">
                                    <td class="ppb-row-label">@L["Σ income"]</td>
                                    <td class="ppb-cell-pos"><b>@Fmt(_totalIncome)</b></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </MudItem>
                <MudItem xs="12" md="6">
                    <div class="barony-card">
                        <div class="barony-card__title">@L["Expenses"]</div>
                        <table class="ppb-table ppb-table--lined">
                            <thead><tr><th class="ppb-row-label">@L["Source"]</th><th>@L["Gold"]</th></tr></thead>
                            <tbody>
                                @foreach (var line in _expenseLines)
                                {
                                    <tr>
                                        <td class="ppb-row-label">
                                            <BaronyTooltip Title="@line.Source" Text="@line.Formula">
                                                <span>@line.Source</span>
                                            </BaronyTooltip>
                                        </td>
                                        <td class="@ExpenseValueClass(line.Gold)"><b>@Fmt(line.Gold)</b></td>
                                    </tr>
                                }
                                <tr class="ppb-summary-row">
                                    <td class="ppb-row-label">@L["Σ expenses"]</td>
                                    <td class="ppb-cell-neg"><b>@Fmt(_totalExpense)</b></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </MudItem>
            </MudGrid>
        </ChildContent>
    </BaronySection>

    <BaronySection Title="@(L["Baron Purse"])">
        <Summary>
            <span class="budget-overview-chips">
                <span>@L["Purse"] <b>@Num(_overview.Barony.BaronPurseGold)</b></span>
                <span>@L["Ledger"] <b class="@ValueClass(_purseBalance)">@Fmt(_purseBalance)</b></span>
            </span>
        </Summary>
        <ChildContent>
            @if (CanEdit)
            {
                <div class="barony-card mb-3">
                    <div class="barony-card__title">@L["Transfer Between Treasury and Purse"]</div>
                    <MudText Typo="Typo.caption" Style="color:var(--barony-muted);" Class="mb-2">
                        @L["Transfers update balances and are logged in the purse ledger and Resources → Resource Balance."]
                    </MudText>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End" Wrap="Wrap.Wrap">
                        <MudNumericField T="decimal" @bind-Value="_transferAmount" Label="@(L["Amount"])" Min="0" HideSpinButtons="true" Style="max-width:140px;" />
                        <MudButton Variant="Variant.Outlined" OnClick="TransferToPurseAsync">@L["Treasury → Purse"]</MudButton>
                        <MudButton Variant="Variant.Outlined" OnClick="TransferToTreasuryAsync">@L["Purse → Treasury"]</MudButton>
                    </MudStack>
                </div>
            }

            <div class="barony-card mb-2">
                <div class="barony-card__title">@L["Purse Income &amp; Expenses"]</div>
                <table class="ppb-table ppb-table--lined">
                    <thead><tr><th class="ppb-row-label">@L["Source"]</th><th>@L["Gold"]</th></tr></thead>
                    <tbody>
                        @foreach (var src in _purseSources)
                        {
                            <tr>
                                <td class="ppb-row-label">
                                    <div class="city-building-name-cell">
                                        <BaronyTooltip Title="@src.Name" Text="@PurseTooltip(src)">
                                            <span class="city-building-name-text">@src.Name</span>
                                        </BaronyTooltip>
                                        @if (CanManageAsMg)
                                        {
                                            <span class="city-building-name-actions">
                                                <BaronyTooltip Text="@(L["Edit"])">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditPurseSourceAsync(src))" />
                                                </BaronyTooltip>
                                                <BaronyTooltip Text="@(L["Remove"])">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeletePurseSourceAsync(src))" />
                                                </BaronyTooltip>
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="@ValueClass(src.Amount)"><b>@Fmt(src.Amount)</b></td>
                            </tr>
                        }
                        @if (_purseSources.Count == 0)
                        {
                            <tr><td class="ppb-row-label" colspan="2" style="color:var(--barony-muted);font-weight:400;">@L["No purse sources yet."]</td></tr>
                        }
                        <tr class="ppb-summary-row">
                            <td class="ppb-row-label">@L["Σ purse ledger"]</td>
                            <td class="@ValueClass(_purseBalance)"><b>@Fmt(_purseBalance)</b></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            @if (CanManageAsMg)
            {
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AddPurseSourceAsync">
                        @L["Add Purse Source"]
                    </MudButton>
                </div>
            }
        </ChildContent>
    </BaronySection>
}

@code {
    private const string TransferToPurseName = "Transfer from treasury";
    private const string TransferToTreasuryName = "Transfer to treasury";
    private const string TransferToPurseResourceName = "Transfer to baron purse";
    private const string TransferFromPurseResourceName = "Transfer from baron purse";

    private BaronyOverviewDTO? _overview;
    private CharacterDTO? _character;
    private List<BaronInfluenceModifierDTO> _baronModifiers = new();
    private List<AdvisorInfluenceModifierDTO> _advisorModifiers = new();
    private int _managementJc = BaronTimeRules.RequiredManagementJc;
    private List<BudgetLine> _incomeLines = new();
    private List<BudgetLine> _expenseLines = new();
    private List<BaronPurseSourceDTO> _purseSources = new();
    private decimal _totalIncome;
    private decimal _totalExpense;
    private decimal _domainPanelGold;
    private decimal _grossGoldIncome;
    private decimal _liegeTribute;
    private decimal _liegeTributePercent = FiefTributeFormulas.DefaultPercent;
    private decimal _liegeTributePercentSaved = FiefTributeFormulas.DefaultPercent;
    private decimal _vassalTributePercent = FiefTributeFormulas.DefaultPercent;
    private decimal _vassalTributePercentSaved = FiefTributeFormulas.DefaultPercent;
    private decimal _turnBalance;
    private decimal _purseBalance;
    private decimal _transferAmount;

    private bool _tributeRatesDirty =>
        PpbFormat.Round(_liegeTributePercent) != PpbFormat.Round(_liegeTributePercentSaved)
        || PpbFormat.Round(_vassalTributePercent) != PpbFormat.Round(_vassalTributePercentSaved);

    private sealed record BudgetLine(string Source, decimal Gold, string? Formula);

    protected override async Task OnInitializedAsync()
    {
        await LoadBaronyAsync();
        if (Barony is null)
            return;

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (Barony is null)
            return;

        _overview = await _baronyRepo.GetOverview(Barony.Id);
        if (_overview is null)
            return;

        _character = await _characterRepo.GetById(Barony.CharacterId, fullIncludes: true);
        _baronModifiers = await _baronyRepo.GetBaronInfluenceModifiers(Barony.Id);
        _advisorModifiers = await _baronyRepo.GetAdvisorInfluenceModifiers(Barony.Id);
        await _baronyRepo.EnsureBaronTimeDefaults(Barony.Id);
        _managementJc = BaronyCalc.ManagementJcSpent(await _baronyRepo.GetBaronTimeActions(Barony.Id));

        BuildBudget();
        NotifyResourceHud();
        StateHasChanged();
    }

    private void BuildBudget()
    {
        var panel = BaronyCalc.BuildDomainPanelRows(
            _overview!, _character, _baronModifiers, _advisorModifiers, _managementJc);
        var goldFinal = panel.GrandTotal[Ppb.Treasury];

        static (decimal income, decimal expense) Split(IEnumerable<PpbModifierRow> rows)
            => (SumGoldIncome(rows), SumGoldExpense(rows));

        var (advIn, advEx) = Split(panel.AdvisorRows);
        var (bldIn, bldEx) = Split(panel.BuildingRows);
        var (socIn, socEx) = Split(panel.SocialRows);
        var (impInAll, impEx) = Split(panel.ImprovementRows);
        var (decIn, decEx) = Split(panel.DecreeRows);
        var (evtIn, evtEx) = Split(panel.EventRows);
        var (armyIn, armyEx) = Split(panel.ArmyRows);
        var (comIn, comEx) = Split(panel.CommunityRows);

        _liegeTributePercent = FiefTributeFormulas.ClampPercent(_overview!.Barony.LiegeTributePercent);
        _liegeTributePercentSaved = _liegeTributePercent;
        _vassalTributePercent = FiefTributeFormulas.ClampPercent(_overview.Barony.VassalTributePercent);
        _vassalTributePercentSaved = _vassalTributePercent;

        // Village gold is shown under Fief income, not Improvements (totals unchanged).
        var fiefIn = BaronyCalc.VillageGoldIncome(
            _overview.Improvements, _overview.Tiles, _overview.Fiefs, _vassalTributePercent);
        var impIn = PpbFormat.Round(impInAll - fiefIn);

        // Exact remainder so Σ income − Σ expenses (before Fief tribute) == Domain Panel Final Gold.
        var additiveIncome = advIn + fiefIn + bldIn + socIn + impIn + decIn + evtIn + armyIn + comIn;
        var additiveExpense = advEx + bldEx + socEx + impEx + decEx + evtEx + armyEx + comEx;
        var goldScaling = goldFinal - (additiveIncome - additiveExpense);
        var scalingIncome = Math.Max(0m, goldScaling);
        var scalingExpense = Math.Max(0m, -goldScaling);

        _grossGoldIncome = BaronyCalc.GrossGoldIncome(panel);
        _liegeTribute = FiefTributeFormulas.ComputeTribute(_grossGoldIncome, _liegeTributePercent);
        _domainPanelGold = goldFinal;

        _incomeLines = new List<BudgetLine>
        {
            Line(BudgetSource.Advisors, advIn,
                "Sum of positive Gold (+) from Domain Panel → Advisors."),
            Line(BudgetSource.Fief, fiefIn,
                "Gold from villages on the Domain Panel (Terrain Improvements), after vassal fief share "
                + $"({_vassalTributePercent:0.#}% on vassal lands; full gold on demesne). "
                + FiefTributeFormulas.VassalCatalogDescription),
            Line(BudgetSource.Buildings, bldIn,
                "Sum of positive Gold (+) from Domain Panel → City and Buildings."),
            Line(BudgetSource.SocialGroups, socIn,
                "Sum of positive Gold (+) from Domain Panel → Social Groups."),
            Line(BudgetSource.Improvements, impIn,
                "Sum of positive Gold (+) from Domain Panel → Terrain Improvements, excluding villages "
                + "(village gold is under Fief)."),
            Line(BudgetSource.Decrees, decIn,
                "Sum of positive Gold (+) from Domain Panel → Decrees and Technologies."),
            Line(BudgetSource.Events, evtIn,
                "Sum of positive Gold (+) from Domain Panel → Events active this turn."),
            Line(BudgetSource.Army, armyIn,
                "Sum of positive Gold (+) from Domain Panel → Army (normally none; wages are expenses)."),
            Line(BudgetSource.Community, comIn,
                "Sum of positive Gold (+) from Domain Panel → Community (includes net Economy profit)."),
            Line(BudgetSource.PercentModifiers, scalingIncome,
                "Remainder so Income − Expenses (before Fief tribute) equals Domain Panel Final Gold."),
            Line(BudgetSource.Other, 0,
                "Miscellaneous treasury income. Placeholder for later custom sources."),
        };

        _expenseLines = new List<BudgetLine>
        {
            Line(BudgetSource.Advisors, advEx,
                "Negative Gold from Advisors (including each office’s upkeep)."),
            Line(BudgetSource.Fief, _liegeTribute,
                FiefTributeFormulas.ExplainLiege(_grossGoldIncome, _liegeTributePercent, _liegeTribute)
                + "\n\n" + FiefTributeFormulas.LiegeCatalogDescription),
            Line(BudgetSource.Buildings, bldEx,
                "Sum of negative Gold (−) from Domain Panel → City and Buildings."),
            Line(BudgetSource.SocialGroups, socEx,
                "Sum of negative Gold (−) from Domain Panel → Social Groups."),
            Line(BudgetSource.Improvements, impEx,
                "Sum of negative Gold (−) from Domain Panel → Terrain Improvements."),
            Line(BudgetSource.Decrees, decEx,
                "Sum of negative Gold (−) from Domain Panel → Decrees and Technologies."),
            Line(BudgetSource.Events, evtEx,
                "Sum of negative Gold (−) from Domain Panel → Events active this turn."),
            Line(BudgetSource.Army, armyEx,
                "Wages of Active units from Domain Panel → Army (Training units excluded)."),
            Line(BudgetSource.Community, comEx,
                "Sum of negative Gold (−) from Domain Panel → Community."),
            Line(BudgetSource.PercentModifiers, scalingExpense,
                "Remainder so Income − Expenses (before Fief tribute) equals Domain Panel Final Gold."),
            Line(BudgetSource.Other, 0,
                "Miscellaneous treasury expenses. Placeholder for later custom sources."),
        };

        _totalIncome = _incomeLines.Sum(l => l.Gold);
        _totalExpense = _expenseLines.Sum(l => l.Gold);
        // Domain Panel Final Gold minus liege tribute (Budget Fief expense).
        _turnBalance = PpbFormat.Round(goldFinal - _liegeTribute);

        _purseSources = _overview!.PurseSources
            .OrderByDescending(s => s.Id)
            .ThenBy(s => s.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
        _purseBalance = _purseSources.Sum(s => s.Amount);
    }

    private async Task SaveTributeRatesAsync()
    {
        if (_overview is null || !CanManageAsMg)
            return;

        try
        {
            _overview.Barony.LiegeTributePercent = FiefTributeFormulas.ClampPercent(_liegeTributePercent);
            _overview.Barony.VassalTributePercent = FiefTributeFormulas.ClampPercent(_vassalTributePercent);
            await _baronyRepo.UpdateBarony(_overview.Barony);
            if (Barony is not null)
            {
                Barony.LiegeTributePercent = _overview.Barony.LiegeTributePercent;
                Barony.VassalTributePercent = _overview.Barony.VassalTributePercent;
            }
            _snackBar.Add(L["Fief tribute rates saved."], Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _snackBar.Add(L["Could not save tribute rates: "] + ex.Message, Severity.Error);
        }
    }

    private static BudgetLine Line(string source, decimal gold, string? formula)
        => new(source, gold, formula);

    private static string? PurseTooltip(BaronPurseSourceDTO src)
    {
        var kind = src.Amount >= 0 ? "Income" : "Expense";
        var amount = PpbFormat.Additive(src.Amount);
        if (string.IsNullOrWhiteSpace(src.Description))
            return $"{kind} to the Baron’s purse: {amount} gold.";
        return $"{kind}: {amount} gold.\n\n{src.Description.Trim()}";
    }

    /// <summary>Per-row positive Gold from a Domain Panel section.</summary>
    private static decimal SumGoldIncome(IEnumerable<PpbModifierRow> rows)
        => rows.Sum(r => Math.Max(0m, r.Additive[Ppb.Treasury]));

    /// <summary>Per-row negative Gold from a Domain Panel section (as a positive expense amount).</summary>
    private static decimal SumGoldExpense(IEnumerable<PpbModifierRow> rows)
        => rows.Sum(r => Math.Max(0m, -r.Additive[Ppb.Treasury]));

    private async Task TransferToPurseAsync()
    {
        if (_overview is null || _transferAmount <= 0)
            return;

        var amount = PpbFormat.Round(Math.Min(_transferAmount, _overview.Barony.TreasuryGold));
        if (amount <= 0)
        {
            _snackBar.Add(L["Not enough funds in treasury."], Severity.Warning);
            return;
        }

        try
        {
            _overview.Barony.TreasuryGold -= amount;
            _overview.Barony.BaronPurseGold += amount;
            SyncStocksFromScalars();
            await _baronyRepo.UpdateBarony(_overview.Barony);

            await _baronyRepo.SavePurseSource(new BaronPurseSourceDTO
            {
                BaronyId = _overview.Barony.Id,
                Name = TransferToPurseName,
                Description = $"Moved {PpbFormat.Number(amount)} gold from the barony treasury into the Baron’s purse.",
                Amount = amount,
            });

            var goldOut = new PpbVector();
            goldOut[Ppb.Treasury] = -amount;
            await _baronyRepo.SaveResourceSource(new BaronyResourceSourceDTO
            {
                BaronyId = _overview.Barony.Id,
                Name = TransferToPurseResourceName,
                Description = $"Treasury → purse transfer of {PpbFormat.Number(amount)} gold (Resources balance / Budget).",
                Additive = goldOut,
            });

            _transferAmount = 0;
            _snackBar.Add(L["Transferred {0} to baron purse.", Num(amount)], Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _snackBar.Add(L["Transfer failed: "] + ex.Message, Severity.Error);
            await ReloadAsync();
        }
    }

    private async Task TransferToTreasuryAsync()
    {
        if (_overview is null || _transferAmount <= 0)
            return;

        var amount = PpbFormat.Round(Math.Min(_transferAmount, _overview.Barony.BaronPurseGold));
        if (amount <= 0)
        {
            _snackBar.Add(L["Not enough funds in purse."], Severity.Warning);
            return;
        }

        try
        {
            _overview.Barony.BaronPurseGold -= amount;
            _overview.Barony.TreasuryGold += amount;
            SyncStocksFromScalars();
            await _baronyRepo.UpdateBarony(_overview.Barony);

            await _baronyRepo.SavePurseSource(new BaronPurseSourceDTO
            {
                BaronyId = _overview.Barony.Id,
                Name = TransferToTreasuryName,
                Description = $"Moved {PpbFormat.Number(amount)} gold from the Baron’s purse back into the barony treasury.",
                Amount = -amount,
            });

            var goldIn = new PpbVector();
            goldIn[Ppb.Treasury] = amount;
            await _baronyRepo.SaveResourceSource(new BaronyResourceSourceDTO
            {
                BaronyId = _overview.Barony.Id,
                Name = TransferFromPurseResourceName,
                Description = $"Purse → treasury transfer of {PpbFormat.Number(amount)} gold (Resources balance / Budget).",
                Additive = goldIn,
            });

            _transferAmount = 0;
            _snackBar.Add(L["Transferred {0} to treasury.", Num(amount)], Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _snackBar.Add(L["Transfer failed: "] + ex.Message, Severity.Error);
            await ReloadAsync();
        }
    }

    private void SyncStocksFromScalars()
    {
        if (_overview is null)
            return;
        _overview.Barony.ResourceStocks[Ppb.Food] = _overview.Barony.FoodInGranaries;
        _overview.Barony.ResourceStocks[Ppb.Treasury] = _overview.Barony.TreasuryGold;
    }

    private async Task AddPurseSourceAsync()
    {
        if (_overview is null || !CanManageAsMg)
            return;
        await OpenPurseDialogAsync(new BaronPurseSourceDTO { BaronyId = _overview.Barony.Id }, isNew: true);
    }

    private async Task EditPurseSourceAsync(BaronPurseSourceDTO src)
        => await OpenPurseDialogAsync(ClonePurse(src), isNew: false);

    private async Task OpenPurseDialogAsync(BaronPurseSourceDTO draft, bool isNew)
    {
        var parameters = new DialogParameters<BaronPurseSourceEditDialog>
        {
            { x => x.Source, draft },
        };

        var dialog = await _dialogService.ShowAsync<BaronPurseSourceEditDialog>(
            isNew ? "Add Purse Source" : "Edit Purse Source",
            parameters,
            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not BaronPurseSourceDTO saved)
            return;

        try
        {
            await _baronyRepo.SavePurseSource(saved);
            _snackBar.Add(isNew ? "Purse source added." : "Purse source updated.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _snackBar.Add(L["Could not save purse source: "] + ex.Message, Severity.Error);
        }
    }

    private async Task DeletePurseSourceAsync(BaronPurseSourceDTO src)
    {
        if (!CanManageAsMg)
            return;

        var confirm = await _dialogService.ShowMessageBoxAsync(
            "Remove purse source",
            $"Remove “{src.Name}”?",
            yesText: "Remove",
            cancelText: "Cancel");
        if (confirm != true)
            return;

        try
        {
            await _baronyRepo.DeletePurseSource(src.Id);
            _snackBar.Add(L["Purse source removed."], Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _snackBar.Add(L["Could not remove purse source: "] + ex.Message, Severity.Error);
        }
    }

    private static BaronPurseSourceDTO ClonePurse(BaronPurseSourceDTO s) => new()
    {
        Id = s.Id,
        BaronyId = s.BaronyId,
        Name = s.Name,
        Description = s.Description,
        Amount = s.Amount,
    };

    private static string Num(decimal v) => PpbFormat.Number(v);
    private static string Fmt(decimal v) => PpbFormat.Additive(v);
    private static string ValueClass(decimal v) => v > 0 ? "ppb-cell-pos" : v < 0 ? "ppb-cell-neg" : "ppb-cell-zero";
    /// <summary>Expense amounts are stored as positive magnitudes — always show non-zero in red.</summary>
    private static string ExpenseValueClass(decimal v) => v != 0m ? "ppb-cell-neg" : "ppb-cell-zero";
}
