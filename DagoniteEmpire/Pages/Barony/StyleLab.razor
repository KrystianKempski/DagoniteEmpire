@page "/barony/style-lab"
@attribute [Authorize(Roles = SD.Role_Admin + "," + SD.Role_GameMaster + "," + SD.Role_DukePlayer)]

<PageTitle>Dagonitowe Imperium | Laboratorium Stylów Baronii</PageTitle>

<div class="barony-scope">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="px-0">
        <h1 class="barony-page-title">Laboratorium Stylów Baronii</h1>
        <MudText Class="mb-4" Style="color:var(--barony-muted);">
            Warianty tabeli PPB i ogólna Karta Baronii. Po wyborze jeden wariant można ustawić jako domyślny.
        </MudText>

        <MudGrid>
            <MudItem xs="12">
                <div class="barony-card mb-4">
                    <div class="barony-card__title">Wariant A - zebra</div>
                    <PpbTable Rows="@_rows" Summary="@_summary" TableClass="ppb-table--zebra" />
                </div>
            </MudItem>

            <MudItem xs="12">
                <div class="barony-card mb-4">
                    <div class="barony-card__title">Wariant B - linie + najechanie</div>
                    <PpbTable Rows="@_rows" Summary="@_summary" TableClass="ppb-table--lined" />
                </div>
            </MudItem>

            <MudItem xs="12">
                <div class="barony-card mb-4">
                    <div class="barony-card__title">Wariant C - kompaktowy</div>
                    <PpbTable Rows="@_rows" Summary="@_summary" TableClass="ppb-table--compact" />
                </div>
            </MudItem>

            <MudItem xs="12" md="6">
                <div class="barony-card mb-4">
                    <div class="barony-card__title">Sekcja zwijana (podgląd)</div>
                    <CascadingValue Value="@_viewOptions">
                        <MudSwitch T="bool" @bind-Value="_defaultExpanded" Color="Color.Default" Label="Rozwinięte domyślnie" Class="mb-2" />
                        <BaronySection Title="Miasto i budynki">
                            <Summary>
                                <PpbSummaryChips Vector="@_summary" />
                            </Summary>
                            <ChildContent>
                                <PpbTable Rows="@_rows" Summary="@_summary" TableClass="ppb-table--zebra" />
                            </ChildContent>
                        </BaronySection>
                    </CascadingValue>
                </div>
            </MudItem>

            <MudItem xs="12" md="6">
                <div class="barony-card mb-4">
                    <div class="barony-card__title">Karta Baronii - przykład</div>
                    <div class="barony-stat"><span class="barony-stat__label">Rok / Pora roku</span><span class="barony-stat__value">627 / Lato</span></div>
                    <div class="barony-stat"><span class="barony-stat__label">Tura</span><span class="barony-stat__value">7</span></div>
                    <div class="barony-stat"><span class="barony-stat__label">Złoto skarbca</span><span class="barony-stat__value">1 240</span></div>
                    <div class="barony-stat"><span class="barony-stat__label">Niepokój</span><span class="barony-stat__value">3</span></div>
                    <div class="barony-stat"><span class="barony-stat__label">Rozmiar baronii</span><span class="barony-stat__value">18 pól</span></div>
                    <div class="barony-stat"><span class="barony-stat__label">Przyrost żywności</span><span class="barony-stat__value">+12</span></div>
                </div>
            </MudItem>
        </MudGrid>
    </MudContainer>
</div>

@code {
    private readonly BaronyViewOptions _viewOptions = new();
    private bool _defaultExpanded = true;

    private List<PpbModifierRow> _rows = new();
    private PpbVector _summary = new();

    protected override void OnParametersSet()
    {
        _viewOptions.DefaultExpanded = _defaultExpanded;
    }

    protected override void OnInitialized()
    {
        var townHall = new PpbModifierRow { Label = "Ratusz", Formula = "Główny budynek administracyjny" };
        townHall.Additive[Ppb.Loyalty] = 2;
        townHall.Additive[Ppb.Law] = 1;
        townHall.Additive[Ppb.Treasury] = -5;

        var market = new PpbModifierRow { Label = "Targ" };
        market.Additive[Ppb.Economy] = 3;
        market.Percent[Ppb.Treasury] = 10;
        market.Additive[Ppb.Culture] = -1;

        var temple = new PpbModifierRow { Label = "Świątynia" };
        temple.Additive[Ppb.Stability] = 2;
        temple.Additive[Ppb.Culture] = 2;
        temple.Additive[Ppb.Corruption] = -1;

        _rows = new List<PpbModifierRow> { townHall, market, temple };

        _summary = PpbVector.Sum(_rows.Select(r => r.Additive));
        _summary.AddInPlace(PpbVector.Sum(_rows.Select(r => r.Percent)));
    }
}
