@page "/barony/army"
@layout BaronyLayout
@inherits BaronyPageBase
@attribute [Authorize(Roles = SD.Role_Admin + "," + SD.Role_GameMaster + "," + SD.Role_DukePlayer)]
@inject ISnackbar _snackBar

<PageTitle>Dagonite Empire | Army</PageTitle>

@if (IsLoading)
{
    <MudProgressCircular Indeterminate="true" Size="Size.Small" /> <span>Loading army...</span>
}
else if (LoadError is not null)
{
    <MudAlert Severity="Severity.Info" Class="my-2">@LoadError</MudAlert>
}
else if (Barony is not null)
{
    <BaronyPageHeader Title="Army">
        <Summary>
            <span class="projects-summary">
                <span class="projects-summary__item">@_units.Count unit@(_units.Count == 1 ? "" : "s")</span>
                <span class="projects-summary__item">@_units.Count(u => u.IsTraining) in training</span>
                <span class="projects-summary__item">@_units.Count(u => u.IsActive) active</span>
            </span>
        </Summary>
    </BaronyPageHeader>

    <UnitGeneratorSection BaronyId="@Barony.Id"
                          CanEdit="@CanEdit"
                          CanManageAsMg="@CanManageAsMg"
                          OnStarted="OnTrainingStarted" />

    <BaronySection Title="Units">
        <Summary>
            <span class="projects-summary__item">Two cards per row · same layout as the generator preview</span>
        </Summary>
        <ChildContent>
            @if (_units.Count == 0)
            {
                <MudText Typo="Typo.body2" Style="color:var(--barony-muted);">No units yet. Use the generator above.</MudText>
            }
            else
            {
                <div class="unit-roster">
                    @foreach (var unit in _units)
                    {
                        <UnitCardSection @key="unit.Id"
                                         Unit="@unit"
                                         CanEdit="@CanEdit"
                                         CanManageAsMg="@CanManageAsMg"
                                         OnChanged="ReloadAsync" />
                    }
                </div>
            }
        </ChildContent>
    </BaronySection>
}

@code {
    private List<BaronyUnitDTO> _units = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadBaronyAsync();
        if (Barony is null)
            return;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (Barony is null)
            return;
        _units = await _baronyRepo.GetUnits(Barony.Id);
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnTrainingStarted(StartUnitTrainingResult result)
    {
        await ReloadAsync();
        var recruit = UnitRecruitSelectionCatalog.Find(result.Unit.RecruitSelectionKey);
        var msg = result.Unit.IsActive
            ? $"Unit “{result.Unit.Name}” ready."
            : $"Training project “{result.Project.Name}” created — fund it on Projects.";
        if (recruit?.EventEffect is not null)
            msg += $" Event “{recruit.EventEffect.Name}” started.";
        _snackBar.Add(msg, Severity.Success);
    }
}
