@page "/barony/army"
@layout BaronyLayout
@inherits BaronyPageBase
@attribute [Authorize(Roles = SD.Role_Admin + "," + SD.Role_GameMaster + "," + SD.Role_DukePlayer)]
@inject ISnackbar _snackBar
@inject IBaronyBattleMapRepository _battleMapRepo

<PageTitle>Dagonitowe Imperium | Armia</PageTitle>

@if (IsLoading)
{
    <MudProgressCircular Indeterminate="true" Size="Size.Small" /> <span>Ładowanie armii...</span>
}
else if (LoadError is not null)
{
    <MudAlert Severity="Severity.Info" Class="my-2">@LoadError</MudAlert>
}
else if (Barony is not null)
{
    <BaronyPageHeader Title="Armia" HelpKey="army">
        <Summary>
            <span class="projects-summary">
                <span class="projects-summary__item">@_units.Count oddział@(_units.Count == 1 ? "" : "y")</span>
                <span class="projects-summary__item">@_units.Count(u => u.IsTraining) w szkoleniu</span>
                <span class="projects-summary__item">@_units.Count(u => u.IsActive) aktywne</span>
            </span>
        </Summary>
    </BaronyPageHeader>

    @if (_battleInProgress)
    {
        <MudAlert Severity="Severity.Warning" Class="my-2" Dense="true">
            Trwa bitwa. Karty oddziałów są zablokowane — aktualizacje HP i składu zastosują się, gdy Mistrz Gry naciśnie <b>Zakończ bitwę</b> na Mapie Bitwy.
        </MudAlert>
    }

    <BaronySection Title="Oddziały">
        <Summary>
            <span class="projects-summary__item">Dwie karty w rzędzie · ten sam układ co podgląd generatora</span>
        </Summary>
        <ChildContent>
            <div class="army-roster-summary">
                <div class="army-roster-summary__title">Sumy armii</div>
                <div class="army-roster-summary__grid">
                    <BaronyTooltip Title="Oddziały"
                                   Text="Liczba oddziałów w składzie (szkolone + aktywne).">
                        <div class="army-roster-summary__item">
                            <span class="army-roster-summary__label">Oddziały</span>
                            <span class="army-roster-summary__value">@_rosterUnits</span>
                        </div>
                    </BaronyTooltip>
                    <BaronyTooltip Title="Liczebność"
                                   Text="Suma liczebności wszystkich oddziałów.">
                        <div class="army-roster-summary__item">
                            <span class="army-roster-summary__label">Liczebność</span>
                            <span class="army-roster-summary__value">@_rosterTroops</span>
                        </div>
                    </BaronyTooltip>
                    <BaronyTooltip Title="Żołd / tura"
                                   Text="Suma żołdu aktywnych oddziałów (wypłacany co turę po ukończeniu szkolenia). Oddziały w szkoleniu są wyłączone do czasu aktywacji.">
                        <div class="army-roster-summary__item">
                            <span class="army-roster-summary__label">Złoto / tura</span>
                            <span class="army-roster-summary__value army-roster-summary__value--gold">
                                @_rosterWage
                                <BaronyResourceIcon Resource="Ppb.Treasury" Size="xs" />
                            </span>
                        </div>
                    </BaronyTooltip>
                    <BaronyTooltip Title="Utrzymanie żywności / tura"
                                   Text="Suma utrzymania żywności aktywnych oddziałów co turę.">
                        <div class="army-roster-summary__item">
                            <span class="army-roster-summary__label">Żywność / tura</span>
                            <span class="army-roster-summary__value army-roster-summary__value--food">
                                @_rosterFood.ToString("0.#")
                                <BaronyResourceIcon Resource="Ppb.Food" Size="xs" />
                            </span>
                        </div>
                    </BaronyTooltip>
                    <BaronyTooltip Title="Utrzymanie obrony / tura"
                                   Text="Suma utrzymania obrony aktywnych oddziałów co turę.">
                        <div class="army-roster-summary__item">
                            <span class="army-roster-summary__label">Obrona / tura</span>
                            <span class="army-roster-summary__value army-roster-summary__value--defense">
                                @_rosterDefense
                                <BaronyResourceIcon Resource="Ppb.Defense" Size="xs" />
                            </span>
                        </div>
                    </BaronyTooltip>
                </div>
                @if (_units.Any(u => u.IsTraining))
                {
                    <MudText Typo="Typo.caption" Class="army-roster-summary__note">
                        Sumy utrzymania liczą tylko aktywne oddziały
                        (@_units.Count(u => u.IsActive) aktywne · @_units.Count(u => u.IsTraining) wciąż w szkoleniu).
                    </MudText>
                }
            </div>

            @if (_units.Count == 0)
            {
                <MudText Typo="Typo.body2" Style="color:var(--barony-muted);">Brak oddziałów. Użyj generatora poniżej.</MudText>
            }
            else
            {
                <div class="unit-roster">
                    @foreach (var unit in _units)
                    {
                        <UnitCardSection @key="unit.Id"
                                         Unit="@unit"
                                         CanEdit="@RosterCanEdit"
                                         CanManageAsMg="@RosterCanManage"
                                         AvailableCaptains="@_courtiers"
                                         OccupiedCaptainIds="@_occupiedCaptainIds"
                                         OnChanged="ReloadAsync" />
                    }
                </div>
            }
        </ChildContent>
    </BaronySection>

    <UnitGeneratorSection BaronyId="@Barony.Id"
                          CanEdit="@RosterCanEdit"
                          CanManageAsMg="@RosterCanManage"
                          OnStarted="OnTrainingStarted" />
}

@code {
    private List<BaronyUnitDTO> _units = new();
    private List<AvailableAdvisorDTO> _courtiers = new();
    private HashSet<int> _occupiedCaptainIds = new();
    private bool _battleInProgress;

    private bool RosterCanEdit => CanEdit && !_battleInProgress;
    private bool RosterCanManage => CanManageAsMg && !_battleInProgress;

    private int _rosterUnits => _units.Count;
    private int _rosterTroops => _units.Sum(u => u.TroopCount);
    private int _rosterWage => _units.Where(u => u.IsActive).Sum(u => UnitStatHelper.ComputeUpkeep(u).Gold);
    private decimal _rosterFood => _units.Where(u => u.IsActive).Sum(u => UnitStatHelper.ComputeUpkeep(u).Food);
    private int _rosterDefense => _units.Where(u => u.IsActive).Sum(u => UnitStatHelper.ComputeUpkeep(u).Defense);

    protected override async Task OnInitializedAsync()
    {
        await LoadBaronyAsync();
        if (Barony is null)
            return;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (Barony is null)
            return;
        _units = await _baronyRepo.GetUnits(Barony.Id);
        _courtiers = await _baronyRepo.GetAvailableAdvisors(Barony.Id);
        _occupiedCaptainIds = _units
            .Where(u => u.CaptainAvailableAdvisorId is int)
            .Select(u => u.CaptainAvailableAdvisorId!.Value)
            .ToHashSet();
        try
        {
            var map = await _battleMapRepo.GetOrCreate(Barony.Id);
            _battleInProgress = string.Equals(map.Phase, BaronyBattlePhases.Battle, StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            _battleInProgress = false;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnTrainingStarted(StartUnitTrainingResult result)
    {
        await ReloadAsync();
        var recruit = UnitRecruitSelectionCatalog.Find(result.Unit.RecruitSelectionKey);
        var msg = result.Unit.IsActive
            ? $"Oddział “{result.Unit.Name}” gotowy."
            : $"Utworzono projekt szkolenia “{result.Project.Name}” — sfinansuj go w Projektach.";
        if (recruit?.EventEffect is not null)
            msg += $" Rozpoczęto wydarzenie “{recruit.EventEffect.Name}”.";
        _snackBar.Add(msg, Severity.Success);
    }
}
