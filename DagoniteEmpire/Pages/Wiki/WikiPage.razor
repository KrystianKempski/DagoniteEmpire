@page "/wiki"
@using DA_Business.Services.Interfaces
@using DA_Common
@using System.Security.Claims
@inject IWebHostEnvironment HostEnvironment
@inject ISnackbar Snackbar
@inject IJSRuntime Js
@inject CallbackService CallbackService
@inject IWikiAccessService WikiAccess
@inject AuthenticationStateProvider AuthState
@implements IAsyncDisposable
@attribute [AllowAnonymous]

<PageTitle>Dagonite Empire | Wiki</PageTitle>

<div class="wiki-shell">
    @if (_wikiAvailable)
    {
        <iframe id="wiki-content-iframe"
                @key="_iframeRenderKey"
                src="@_iframeSrc"
                title="DagoniteEmpire Wiki"
                class="wiki-iframe"
                referrerpolicy="same-origin" />
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Class="ma-4">
            Wiki nie jest jeszcze wdrożona na tym serwerze. Uruchom
            <code>tools/Scripts/build_wiki_for_empire.sh</code> (lub pełny pipeline
            <code>sync_wiki_pipeline.sh</code>).
        </MudAlert>
    }
</div>

<style>
    .wiki-shell {
        width: 100%;
        height: calc(100vh - 64px);
        margin: 0;
        padding: 0;
        overflow: hidden;
        background: #1a1109;
        display: flex;
        flex-direction: column;
    }

    .wiki-iframe {
        display: block;
        width: 100%;
        flex: 1;
        border: none;
        min-height: 0;
    }
</style>

@code {
    private const string AccessDeniedMessage = "Nie masz dostępu do tej części wiki.";
    private bool _wikiAvailable;
    private string _iframeSrc = "/wiki/świat-i-zasady/";
    private string _lastGoodIframeSrc = "/wiki/świat-i-zasady/";
    private int _iframeRenderKey;
    private DotNetObjectReference<WikiPage>? _dotNetRef;
    private bool _iframeJsInitialized;
    private bool _bypassWikiAccessChecks;
    private Action? _onCharacterChanged;

    protected override async Task OnInitializedAsync()
    {
        var wikiRoot = Path.Combine(HostEnvironment.WebRootPath ?? "", "wiki");
        _wikiAvailable = File.Exists(Path.Combine(wikiRoot, "index.html"));
        await ApplyDefaultWikiPathAsync();

        _onCharacterChanged = OnSelectedCharacterChanged;
        CallbackService.OnChange += _onCharacterChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_wikiAvailable || _iframeJsInitialized)
        {
            return;
        }

        _dotNetRef ??= DotNetObjectReference.Create(this);
        await Js.InvokeVoidAsync("dagoniteWikiIframe.init", _dotNetRef, "wiki-content-iframe", _bypassWikiAccessChecks);
        _iframeJsInitialized = true;
    }

    private async void OnSelectedCharacterChanged()
    {
        await ApplyDefaultWikiPathAsync();
        _iframeRenderKey++;
        await InvokeAsync(StateHasChanged);
        if (_iframeJsInitialized)
        {
            try
            {
                await Js.InvokeVoidAsync("dagoniteWikiIframe.setBypassAccessChecks", _bypassWikiAccessChecks);
                await Js.InvokeVoidAsync("dagoniteWikiIframe.reloadAllowedIndex");
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    [JSInvokable]
    public void OnWikiIframeNavigated(string path)
    {
        _lastGoodIframeSrc = path;
    }

    [JSInvokable]
    public async Task OnWikiBlocked(string? lastGoodPath)
    {
        var (userName, isAdminOrMg) = await GetWikiAuthAsync();
        if (await WikiAccess.ShouldBypassAccessChecksAsync(userName, isAdminOrMg))
        {
            return;
        }

        Snackbar.Add(AccessDeniedMessage, Severity.Warning);
        var fallback = await WikiAccess.GetDefaultWikiIframePathAsync(userName, isAdminOrMg);

        if (!string.IsNullOrWhiteSpace(lastGoodPath)
            && lastGoodPath.StartsWith("/wiki", StringComparison.OrdinalIgnoreCase)
            && await WikiAccess.CanAccessSlug(userName, isAdminOrMg, SlugFromWikiPath(lastGoodPath)))
        {
            _lastGoodIframeSrc = lastGoodPath;
        }
        else
        {
            _lastGoodIframeSrc = fallback;
        }

        _iframeSrc = AppendCacheBuster(_lastGoodIframeSrc);
        _iframeRenderKey++;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ApplyDefaultWikiPathAsync()
    {
        var (userName, isAdminOrMg) = await GetWikiAuthAsync();
        _bypassWikiAccessChecks = await WikiAccess.ShouldBypassAccessChecksAsync(userName, isAdminOrMg);
        var path = await WikiAccess.GetDefaultWikiIframePathAsync(userName, isAdminOrMg);
        _iframeSrc = path;
        _lastGoodIframeSrc = path;
    }

    private async Task<(string? UserName, bool IsAdminOrMg)> GetWikiAuthAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var user = state.User;
        return (
            user.Identity?.Name,
            user.IsInRole(SD.Role_Admin) || user.IsInRole(SD.Role_GameMaster));
    }

    private static string SlugFromWikiPath(string wikiPath)
    {
        var path = wikiPath;
        if (path.StartsWith("/wiki/", StringComparison.OrdinalIgnoreCase))
        {
            path = path[6..];
        }
        else if (path.StartsWith("/wiki", StringComparison.OrdinalIgnoreCase))
        {
            path = path[5..];
        }

        path = path.Trim('/');
        if (path.EndsWith(".html", StringComparison.OrdinalIgnoreCase))
        {
            path = path[..^5];
        }

        if (path.EndsWith("/index", StringComparison.OrdinalIgnoreCase))
        {
            path = path[..^6].TrimEnd('/');
        }

        if (string.IsNullOrEmpty(path) || path.Equals("index", StringComparison.OrdinalIgnoreCase))
        {
            return "index";
        }

        return path;
    }

    private static string AppendCacheBuster(string path)
    {
        var tick = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        return path.Contains('?', StringComparison.Ordinal)
            ? $"{path}&_r={tick}"
            : $"{path}?_r={tick}";
    }

    public async ValueTask DisposeAsync()
    {
        if (_onCharacterChanged is not null)
        {
            CallbackService.OnChange -= _onCharacterChanged;
        }

        if (_iframeJsInitialized)
        {
            try
            {
                await Js.InvokeVoidAsync("dagoniteWikiIframe.dispose");
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _dotNetRef?.Dispose();
    }
}
