@page "/wiki"
@using DA_Business.Services.Interfaces
@using DA_Common
@using System.Security.Claims
@using Microsoft.JSInterop
@implements IDisposable
@implements IAsyncDisposable
@inject IWebHostEnvironment HostEnvironment
@inject CallbackService CallbackService
@inject IWikiAccessService WikiAccess
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@attribute [AllowAnonymous]

<PageTitle>Dagonite Empire | Wiki</PageTitle>

@* Quartz is a standalone static SPA — embedding it in Blazor requires an iframe (same-origin /wiki/*).
   ACL runs in WikiStaticFileMiddleware on every iframe sub-request, not in client JS. *@
<div class="wiki-shell">
    @if (_wikiAvailable)
    {
        <iframe id="wiki-content"
                @key="_contentRenderKey"
                src="@_contentSrc"
                title="DagoniteEmpire Wiki"
                class="wiki-content"
                referrerpolicy="same-origin" />
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Class="ma-4">
            Wiki nie jest jeszcze wdrożona na tym serwerze. Uruchom
            <code>tools/Scripts/build_wiki_for_empire.sh</code> (lub pełny pipeline
            <code>sync_wiki_pipeline.sh</code>).
        </MudAlert>
    }
</div>

<style>
    .wiki-shell {
        width: 100%;
        height: calc(100vh - 64px);
        margin: 0;
        padding: 0;
        overflow: hidden;
        background: #1a1109;
        display: flex;
        flex-direction: column;
    }

    .wiki-content {
        display: block;
        width: 100%;
        flex: 1;
        border: none;
        min-height: 0;
    }
</style>

@code {
    private const string LoreFallbackPath = "/wiki/świat-i-zasady/";

    private bool _wikiAvailable;
    private string _contentSrc = LoreFallbackPath;
    private int _contentRenderKey;
    private Action? _onCharacterChanged;
    private DotNetObjectReference<WikiPage>? _dotNetRef;
    private IJSObjectReference? _wikiJsModule;

    protected override async Task OnInitializedAsync()
    {
        var wikiRoot = Path.Combine(HostEnvironment.WebRootPath ?? "", "wiki");
        _wikiAvailable = File.Exists(Path.Combine(wikiRoot, "index.html"));
        await ApplyDefaultWikiPathAsync();

        _onCharacterChanged = OnSelectedCharacterChanged;
        CallbackService.OnChange += _onCharacterChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_wikiAvailable || _wikiJsModule is not null)
        {
            return;
        }

        _dotNetRef = DotNetObjectReference.Create(this);
        _wikiJsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/wiki-shell.js");
        await _wikiJsModule.InvokeVoidAsync("registerDeniedListener", _dotNetRef);
    }

    private void OnSelectedCharacterChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await ApplyDefaultWikiPathAsync();
            _contentRenderKey++;
            StateHasChanged();
        });
    }

    [JSInvokable]
    public Task OnWikiAccessDenied()
    {
        _contentSrc = AppendCacheBuster(LoreFallbackPath);
        _contentRenderKey++;
        return InvokeAsync(StateHasChanged);
    }

    private async Task ApplyDefaultWikiPathAsync()
    {
        var (userName, isAdminOrMg) = await GetWikiAuthAsync();
        var path = await WikiAccess.GetDefaultWikiEntryPathAsync(userName, isAdminOrMg);
        _contentSrc = AppendCacheBuster(path);
    }

    private async Task<(string? UserName, bool IsAdminOrMg)> GetWikiAuthAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var user = state.User;
        return (
            user.Identity?.Name,
            user.IsInRole(SD.Role_Admin) || user.IsInRole(SD.Role_GameMaster));
    }

    private static string AppendCacheBuster(string path)
    {
        var tick = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        return path.Contains('?', StringComparison.Ordinal)
            ? $"{path}&_r={tick}"
            : $"{path}?_r={tick}";
    }

    public void Dispose()
    {
        if (_onCharacterChanged is not null)
        {
            CallbackService.OnChange -= _onCharacterChanged;
        }

        _dotNetRef?.Dispose();
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();

        if (_wikiJsModule is not null)
        {
            try
            {
                await _wikiJsModule.InvokeVoidAsync("unregisterDeniedListener");
                await _wikiJsModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already torn down.
            }
        }
    }
}
