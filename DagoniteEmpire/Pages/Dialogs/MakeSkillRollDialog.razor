@using DA_DataAccess.CharacterClasses
@using DA_Models
@using DA_Models.CharacterModels
@using MudBlazor
@inject ISnackbar Snackbar
@inject IMobRepository _mobRepository
@inject ICampaignRepository _campaignRepository
@inject IChapterRepository _chapterRepository
@inject ITraitRepository<TraitCharacterDTO> _traitCharacterRepository
@inject IWoundRepository _woundsRepository

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <img src="@MyIcon.Dice" width="40" height="40" />
            Skill roll
        </MudText>
    </TitleContent>
    <DialogContent>

        <MudGrid>
            <MudItem xs="12">
                <MudSwitch @bind-Value="IsOppositeRoll" Color="Color.Primary">Is opposite roll</MudSwitch>
            </MudItem>
            <MudItem xs="6">
                @* ATTACKER *@
                <MudPaper Elevation="1" Class="pa-2 h-100">

                    <MudSelect Value="@Roller" T="string" Required="true" ValueChanged="SelectCharacterRolling" Label="Select Rolling character">
                        <MudSelectItem Value="@string.Empty">@string.Empty</MudSelectItem>
                        @foreach(var attacker in CharacterAllParams) {
                            @if (attacker is not null )
                            {                            
                                <MudSelectItem Value="@attacker.Character.NPCName">@attacker.Character.NPCName</MudSelectItem>
                            }
                        }
                        @foreach (var attacker in Mobs)
                        {
                            @if (attacker is not null)
                            {
                                <MudSelectItem Value="@attacker.Name">@attacker.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>

                    @if (SelectedMobRolling is not null)
                    {
                        <MudSelect T="string" Required="true" @bind-Value="@MobRollSkillKey" Label="Select skill">
                            @foreach (var skill in RollerMobSkills)
                            {
                                <MudSelectItem Value="@skill.Key">@skill.Label (@skill.Value)</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else
                    {
                        <MudSelect ReadOnly="SelectedCharacterRolling is null" T="string" Required="true" @bind-Value="@BaseSkillRollName" Label="Select base skill">
                            @foreach (var baseSkill in SD.BaseSkills.All)
                            {
                                <MudSelectItem Value="@baseSkill">@baseSkill</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect ReadOnly="BaseSkillRollName == string.Empty || SelectedCharacterRolling is null" T="SpecialSkillDTO" Required="true" @bind-Value="@SpecialSkillRoll" Label="Select special skill">
                            @if(BaseSkillRollName != string.Empty && SelectedCharacterRolling is not null)
                            {
                                @foreach (var baseSkill in SelectedCharacterRolling.SpecialSkills.GetAllSection(BaseSkillRollName))
                                {
                                    <MudSelectItem Value="@baseSkill">@baseSkill.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    }

                    <MudStack Class="pt-1" Row AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.body2">Add bonus</MudText>
                        <MudFab Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAttackerBonus"/>
                        <MudFab Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Remove" OnClick="RemoveAttackerBonus" />
                    </MudStack>
                    @foreach(var item in AdditionalAttackerBonuses)
                    {
                        <MudStack Row>
                            <MudTextField @bind-Value="item.First" />
                            <div style="width:40px;">
                                <MudNumericField @bind-Value="item.Second" />
                            </div>
                        </MudStack>
                    }

                </MudPaper>
            </MudItem>
            <MudItem xs="6">
                @if (IsOppositeRoll == false)
                {
                    <MudPaper Elevation="1" Class="pa-2 h-100">
                        <MudSelect T="int" Required="true" @bind-Value="DifficultyValue" Label="Select difficulty">
                            @foreach (var defender in SD.DifficultyLevel.ToList())
                            {
                                <MudSelectItem Value="@defender.Value">@defender.Key</MudSelectItem>
                            }     
                        </MudSelect>
                        <MudNumericField Margin="0" Class="dense-numeric-field" Min="2" @bind-Value="DifficultyValue" ></MudNumericField>
                    </MudPaper> 
                }
                else
                {                
                    @* DEFENDER *@                
                    <MudPaper Elevation="1" Class="pa-2 h-100">
                        <MudSelect Value="@Defender" T="string" Required="true" ValueChanged="SelectDefender" Label="Select Defender">
                            <MudSelectItem Value="@string.Empty">@string.Empty</MudSelectItem>
                            @foreach (var defender in CharacterAllParams)
                            {
                                @if (defender is not null && defender.Character.NPCName != Roller)
                                {
                                    <MudSelectItem Value="@defender.Character.NPCName">@defender.Character.NPCName</MudSelectItem>
                                }
                            }                            
                            @foreach (var defender in Mobs)
                            {
                                @if (defender.Name != Roller)
                                {
                                    <MudSelectItem Value="@defender.Name">@defender.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>

                        @if (SelectedMobDefending is not null)
                        {
                            <MudSelect T="string" Required="true" @bind-Value="@MobDefenceSkillKey" Label="Select skill">
                                @foreach (var skill in DefenderMobSkills)
                                {
                                    <MudSelectItem Value="@skill.Key">@skill.Label (@skill.Value)</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else
                        {
                            <MudSelect ReadOnly="SelectedCharacterDefending is null" T="string" Required="true" @bind-Value="@BaseSkillDefenceName" Label="Select base skill">
                                @foreach (var baseSkill in SD.BaseSkills.All)
                                {
                                    <MudSelectItem Value="@baseSkill">@baseSkill</MudSelectItem>
                                }
                            </MudSelect> 

                            <MudSelect ReadOnly="BaseSkillDefenceName == string.Empty || SelectedCharacterDefending is null" T="SpecialSkillDTO" Required="true" @bind-Value="@SpecialSkillDefence" Label="Select special skill">
                                @if (BaseSkillDefenceName != string.Empty && SelectedCharacterDefending is not null)
                                {
                                    @foreach (var baseSkill in SelectedCharacterDefending.SpecialSkills.GetAllSection(BaseSkillDefenceName))
                                    {
                                        <MudSelectItem Value="@baseSkill">@baseSkill.Name</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        }

                        <MudStack Class="pt-1" Row AlignItems="AlignItems.Center" Spacing="1">
                            <MudText Typo="Typo.body2">Add bonus</MudText>
                            <MudFab Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="AddDefenderBonus" />
                            <MudFab Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Remove" OnClick="RemoveDefenderBonus" />
                        </MudStack>
                        @foreach (var item in AdditionalDefenderBonuses)
                        {
                            <MudStack Row>
                                <MudTextField @bind-Value="item.First" />
                                <MudNumericField @bind-Value="item.Second" />
                            </MudStack>
                        }
                    </MudPaper>                
                }
            </MudItem>
            <MudItem xs="12">
                <MudButton Class="p-2 m-2 w-100 justify-content-center"  Variant="Variant.Filled" Color="Color.Primary" OnClick="MakeRoll">Roll!</MudButton>
            </MudItem>

            <MudItem xs="12">
                <MudPaper Class="pa-2" Style="min-height: 200px;">
                <BlazoredTextEditor @ref="@RollEditor">
                    <ToolbarContent>
                        <span class="ql-formats">
                            <button class="ql-bold"></button>
                            <button class="ql-italic"></button>
                            <button class="ql-underline"></button>
                            <button class="ql-strike"></button>
                        </span>
                        <span class="ql-formats">
                            <select class="ql-color"></select>
                            <select class="ql-background"></select>
                        </span>
                        <span class="ql-formats">
                            <button class="ql-list" value="ordered"></button>
                            <button class="ql-align" value=""></button>
                            <button class="ql-align" value="center"></button>
                            <button class="ql-align" value="right"></button>
                        </span>
                    </ToolbarContent>
                    <EditorContent></EditorContent>
                </BlazoredTextEditor>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Exit</MudButton>
        <MudButton Color="Color.Error" OnClick="SaveSequenceBtn">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    public sealed record SkillRollDialogResult(string RichHtml, bool WrapForThread);

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    [Parameter] public ICollection<AllParamsModel?> CharacterAllParams { get; set; } = new List<AllParamsModel?>();
    [Parameter] public IEnumerable<MobDTO> Mobs { get; set; } = new List<MobDTO>();

    private readonly record struct MobSkillEntry(string Key, string Label, int Value);

    private string RollResultString = string.Empty;
    private AllParamsModel? SelectedCharacterRolling = null;
    private AllParamsModel? SelectedCharacterDefending = null;
    private MobDTO? SelectedMobRolling = null;
    private MobDTO? SelectedMobDefending = null;
    private string MobRollSkillKey = string.Empty;
    private string MobDefenceSkillKey = string.Empty;
    private IReadOnlyList<MobSkillEntry> RollerMobSkills = Array.Empty<MobSkillEntry>();
    private IReadOnlyList<MobSkillEntry> DefenderMobSkills = Array.Empty<MobSkillEntry>();
    private string Roller = string.Empty;
    private string Defender = string.Empty;
    private string BaseSkillRollName = string.Empty;
    private string BaseSkillDefenceName = string.Empty;
    private SpecialSkillDTO? SpecialSkillRoll = null;
    private SpecialSkillDTO? SpecialSkillDefence = null;

    private List<Pair<string, int>> AdditionalAttackerBonuses = new List<Pair<string, int>>();
    private List<Pair<string, int>> AdditionalDefenderBonuses = new List<Pair<string, int>>();

    private bool _isOppositeRoll = false;
    public bool IsOppositeRoll 
    {
        get => _isOppositeRoll;
        set
        {
            _isOppositeRoll = value;
            StateHasChanged();
        }
    }
    private int DifficultyValue = 5;
    private BlazoredTextEditor? RollEditor;
    private bool _shouldLoadRollContent;

    private static bool IsEmptyEditorHtml(string? html) =>
        string.IsNullOrWhiteSpace(html)
        || html.Trim() is "<p><br></p>" or "<p></p>";

    private string RollerName =>
        SelectedCharacterRolling?.Character?.NPCName ?? SelectedMobRolling?.Name ?? string.Empty;

    private string DefenderName =>
        SelectedCharacterDefending?.Character?.NPCName ?? SelectedMobDefending?.Name ?? string.Empty;

    private static IReadOnlyList<MobSkillEntry> BuildMobSkills(MobDTO mob) =>
    [
        new("attack", "Attack", mob.AttackSkillValue),
        new("dodge", "Dodge", mob.DodgeSkillValue),
        new("shield", "Shield", mob.ShieldSkillValue),
        new("armor", "Armor", mob.ArmorSkillValue),
        new("parry", "Parry", mob.ParrySkillValue),
        new("pain-resistance", "Pain resistance", mob.PainResSkillValue),
        new("lifting", "Lifting", mob.LiftingSkillValue),
        new("wrestling", "Wrestling", mob.WrestlingSkillValue),
        new("perception", "Perception", mob.PerceptionSkillValue),
        new("willpower", "Willpower", mob.WillpowerSkillValue),
        new("charisma", "Charisma", mob.CharismaSkillValue),
    ];

    private static bool TryGetMobSkill(IReadOnlyList<MobSkillEntry> skills, string key, out MobSkillEntry entry)
    {
        foreach (var skill in skills)
        {
            if (skill.Key == key)
            {
                entry = skill;
                return true;
            }
        }

        entry = default;
        return false;
    }

    private bool IsRollerReady() =>
        (SelectedCharacterRolling is not null && SpecialSkillRoll is not null && !string.IsNullOrEmpty(SpecialSkillRoll.Name))
        || (SelectedMobRolling is not null && !string.IsNullOrEmpty(MobRollSkillKey));

    private bool IsDefenderReady() =>
        (SelectedCharacterDefending is not null && SpecialSkillDefence is not null && !string.IsNullOrEmpty(SpecialSkillDefence.Name))
        || (SelectedMobDefending is not null && !string.IsNullOrEmpty(MobDefenceSkillKey));

    private (string Name, int Value) GetRollerSkill()
    {
        if (SelectedMobRolling is not null && TryGetMobSkill(RollerMobSkills, MobRollSkillKey, out var skill))
            return (skill.Label, skill.Value);

        return (SpecialSkillRoll?.Name ?? string.Empty, SpecialSkillRoll?.SumBonus ?? 0);
    }

    private (string Name, int Value) GetDefenderSkill()
    {
        if (SelectedMobDefending is not null && TryGetMobSkill(DefenderMobSkills, MobDefenceSkillKey, out var skill))
            return (skill.Label, skill.Value);

        return (SpecialSkillDefence?.Name ?? string.Empty, SpecialSkillDefence?.SumBonus ?? 0);
    }

    // Exit always cancels without inserting anything (matches CreateFightSequenceDialog).
    private void Cancel() => MudDialog.Cancel();

    private void AddAttackerBonus() => AdditionalAttackerBonuses.Add(new Pair<string, int>("", 0));

    private void RemoveAttackerBonus()
    {
        if (AdditionalAttackerBonuses.Count > 0)
            AdditionalAttackerBonuses.RemoveAt(AdditionalAttackerBonuses.Count - 1);
    }

    private void AddDefenderBonus() => AdditionalDefenderBonuses.Add(new Pair<string, int>("", 0));

    private void RemoveDefenderBonus()
    {
        if (AdditionalDefenderBonuses.Count > 0)
            AdditionalDefenderBonuses.RemoveAt(AdditionalDefenderBonuses.Count - 1);
    }

    private void ClearRollerSelection()
    {
        SelectedCharacterRolling = null;
        SelectedMobRolling = null;
        BaseSkillRollName = string.Empty;
        SpecialSkillRoll = null;
        MobRollSkillKey = string.Empty;
        RollerMobSkills = Array.Empty<MobSkillEntry>();
    }

    private void ClearDefenderSelection()
    {
        SelectedCharacterDefending = null;
        SelectedMobDefending = null;
        BaseSkillDefenceName = string.Empty;
        SpecialSkillDefence = null;
        MobDefenceSkillKey = string.Empty;
        DefenderMobSkills = Array.Empty<MobSkillEntry>();
    }

    private void SelectCharacterRolling(string attackerName)
    {
        try
        {
            ClearRollerSelection();
            if (string.IsNullOrEmpty(attackerName))
            {
                Roller = string.Empty;
                return;
            }

            var characterParams = CharacterAllParams.FirstOrDefault(p => p?.Character?.NPCName == attackerName);
            if (characterParams is not null)
            {
                SelectedCharacterRolling = characterParams;
                Roller = RollerName;
                return;
            }

            var mob = Mobs.FirstOrDefault(m => m.Name == attackerName);
            if (mob is not null)
            {
                SelectedMobRolling = mob;
                RollerMobSkills = BuildMobSkills(mob);
                Roller = mob.Name;
            }
        }
        catch(Exception ex)
        {
            Snackbar.Add("Error while selecting Attacker: " + ex.Message);
        }
    }

    private void SelectDefender(string defenderName)
    {
        try
        {
            ClearDefenderSelection();
            if (string.IsNullOrEmpty(defenderName))
            {
                Defender = string.Empty;
                return;
            }

            var characterParams = CharacterAllParams.FirstOrDefault(p => p?.Character?.NPCName == defenderName);
            if (characterParams is not null)
            {
                SelectedCharacterDefending = characterParams;
                Defender = DefenderName;
                return;
            }

            var mob = Mobs.FirstOrDefault(m => m.Name == defenderName);
            if (mob is not null)
            {
                SelectedMobDefending = mob;
                DefenderMobSkills = BuildMobSkills(mob);
                Defender = mob.Name;
            }
        }
        catch(Exception ex)
        {
            Snackbar.Add("Error while selecting Defender: " + ex.Message);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldLoadRollContent && RollEditor is not null && !string.IsNullOrEmpty(RollResultString))
        {
            var loaded = await TryLoadRollResultIntoEditorAsync();
            if (!loaded)
            {
                await Task.Delay(50);
                StateHasChanged();
            }
        }
    }

    private async Task<bool> TryLoadRollResultIntoEditorAsync()
    {
        if (string.IsNullOrEmpty(RollResultString))
            return true;

        if (RollEditor is null)
        {
            _shouldLoadRollContent = true;
            return false;
        }

        try
        {
            var editorHtml = RichText.ToPlainEditorHtml(RollResultString);
            if (string.IsNullOrEmpty(editorHtml))
            {
                _shouldLoadRollContent = true;
                return false;
            }

            await RollEditor.LoadHTMLContent(editorHtml);
            var loadedHtml = await RollEditor.GetHTML();
            if (IsEmptyEditorHtml(loadedHtml))
            {
                _shouldLoadRollContent = true;
                return false;
            }

            _shouldLoadRollContent = false;
            return true;
        }
        catch
        {
            _shouldLoadRollContent = true;
            return false;
        }
    }

    private async Task MakeRoll()
    {
        try
        {
        if (!IsRollerReady() || string.IsNullOrEmpty(RollerName)
            || (IsOppositeRoll && (!IsDefenderReady() || string.IsNullOrEmpty(DefenderName))))
        {
            Snackbar.Add("Some component is missing", Severity.Warning);
            return;
        }

        RichText ResultStringMG = new();
        var rollerSkill = GetRollerSkill();
        int sumOfAll = rollerSkill.Value;

        if (!IsOppositeRoll)
        {
            ResultStringMG += $"{RichText.BoldText(RollerName)} is making an {SD.GetDifficultyName(DifficultyValue)} {RichText.BoldText(rollerSkill.Name)} skill check";
            ResultStringMG.NewLine();
            ResultStringMG += $"{RollerName} skill value: {sumOfAll}";
            ResultStringMG.NewLine();
            foreach (var item in AdditionalAttackerBonuses)
            {
                sumOfAll += item.Second;
                ResultStringMG += $"Bonus from {item.First}: {item.Second}";
                ResultStringMG.NewLine();
            }
            ResultStringMG += $"Difficulty level: {DifficultyValue}";
            ResultStringMG.NewLine();
        }

        Tuple<bool, string> result;
        if (IsOppositeRoll)
        {
            var defenderSkill = GetDefenderSkill();
            ResultStringMG += $"{RichText.BoldText(RollerName)} is making an opposite {rollerSkill.Name} skill check vs. {RichText.BoldText(DefenderName)} {defenderSkill.Name} skill";
            ResultStringMG.NewLine();
            ResultStringMG += $"{RollerName} skill value: {rollerSkill.Value}";
            ResultStringMG.NewLine();
            foreach (var item in AdditionalAttackerBonuses)
            {
                ResultStringMG += $"Bonus from {item.First}: {item.Second}";
                ResultStringMG.NewLine();
            }
            ResultStringMG += $"{DefenderName} skill value: {defenderSkill.Value}";
            ResultStringMG.NewLine();
            foreach (var item in AdditionalDefenderBonuses)
            {
                ResultStringMG += $"Bonus from {item.First}: {item.Second}";
                ResultStringMG.NewLine();
            }

            var bonusesAttacker = new List<Pair<string, int>>
            {
                new("skill", rollerSkill.Value)
            };
            bonusesAttacker.AddRange(AdditionalAttackerBonuses);

            var bonusesDefender = new List<Pair<string, int>>
            {
                new("skill", defenderSkill.Value)
            };
            bonusesDefender.AddRange(AdditionalDefenderBonuses);

            result = SD.MakeOppositeRollTest(RollerName, bonusesAttacker, DefenderName, bonusesDefender);
        }
        else
        {
            result = SD.MakeRollTest(DifficultyValue, sumOfAll);
        }        

        ResultStringMG += result.Item2;
        ResultStringMG.EndText();
        RollResultString = ResultStringMG.AllText;

        _shouldLoadRollContent = true;
        await TryLoadRollResultIntoEditorAsync();
        StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error while rolling: " + ex.Message, Severity.Error);
        }
    }

    private void SaveSequenceBtn()
    {
        try
        {
            if (string.IsNullOrEmpty(RollResultString))
            {
                Snackbar.Add("Make a roll first", Severity.Warning);
                return;
            }

            MudDialog.Close(DialogResult.Ok(new SkillRollDialogResult(RollResultString, WrapForThread: true)));
            Snackbar.Add("Roll added", Severity.Success);
        }
        catch(Exception ex)
        {
            Snackbar.Add("Error while saving: " + ex.Message, Severity.Error);
        }
    }    
}
