<MudDialog Class="battle-map-dialog" ContentClass="battle-map-dialog-content" Gutters="false">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.GridOn" Class="mr-2" />
            Tactical Map
        </MudText>
    </TitleContent>
    <DialogContent>
        <BattleMapComponent ChapterId="ChapterId"
                            CampaignId="CampaignId"
                            CanEdit="CanEdit"
                            Participants="Participants" />
    </DialogContent>
</MudDialog>

@code {
    [Parameter] public int ChapterId { get; set; }
    [Parameter] public int CampaignId { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public IEnumerable<BattleMapParticipantDTO> Participants { get; set; } = Array.Empty<BattleMapParticipantDTO>();
}
