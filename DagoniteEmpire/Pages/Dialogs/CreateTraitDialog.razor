@using DA_DataAccess.CharacterClasses
@inject ISnackbar Snackbar
@inject IUserService _userService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <img src="@IconSource" width="40px" height="40px" class="pr-2" />
            @HeaderName
        </MudText>
    </TitleContent>
    <DialogContent>
            <div class="main-table">

            @if(IsWeaponQualityMode == false)
            {
                <div class="d-flex ">
                    <div class="d-flex flex-column flex-grow-1">
                        <label class="fw-bold py-1">@NewTrait.TraitLabel name</label>
                        @if (IsInfoMode)
                        {
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" Value="@NewTrait.DisplayName(L)"></MudTextField>
                        }
                        else
                        {
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="IsInfoMode" Placeholder="@(L["Insert trait name"])" @bind-Value="@NewTrait.Name"></MudTextField>
                        }
                    </div>
                    @if (NewTrait.TraitType == SD.TraitType_Character || NewTrait.TraitType == SD.TraitType_Temporary)
                    {
                        <div class="d-flex flex-column px-1">
                            @if (NewTrait.TraitType == SD.TraitType_Temporary)
                            {
                                <label class="fw-bold py-1">@L["Duration"]</label>
                            }else{
                                <label class="fw-bold py-1">@L["Trait value"]</label>
                            }
                            <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="IsInfoMode" Style="width:100px" T="int" @bind-Value="@NewTrait.TraitValue"></MudNumericField>
                        </div>
                      @*   <div class="d-flex flex-column px-1">
                            <label class="fw-bold py-1">Unique</label>
                            <div class="justify-content-center mx-auto my-auto">
                                <MudCheckBox T="bool" Disabled="IsInfoMode" @bind-Value="NewTrait.IsUnique "></MudCheckBox>
                            </div>
                </div>*@
                    } 
                   @*      @if (UserInfo?.IsAdminOrMG == true)
                        {
                        <div class="d-flex flex-column px-1">
                            <label class="fw-bold py-1">@L["Approve"]</label>
                            <div class="justify-content-center mx-auto my-auto">
                                    <MudCheckBox T="bool" @bind-Value="NewTrait.TraitApproved"></MudCheckBox>
                            </div>
                        </div>
                        } *@
                </div>
                <div class="align-items-start bonus-name py-0">
                    <label class="fw-bold  py-1">@NewTrait.TraitLabel description</label>
                </div>
                <div class="align-items-start">
                    <div class="col-12 bonus-name py-0">
                        @if (IsInfoMode)
                        {
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" Lines="3" Value="@NewTrait.DisplayDescription(L)"></MudTextField>
                        }
                        else
                        {
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="IsInfoMode" Lines="3" Placeholder="@(L["Insert general description"])" @bind-Value="@NewTrait.Descr"></MudTextField>
                        }
                    </div>
                </div>
                        
            }
            <label class="fw-bold pt-4">@L["Bonuses and penalties"]</label>
            @if (NewTrait.Bonuses != null)
            {
                @foreach (var obj in NewTrait.Bonuses)
                {
                    <label class="bonus-cell">Bonus @obj.Index</label>
                    <div class="bonuses-columns @(IsWeaponQualityMode ? "weapon-quality-mode" : "")">
                        @if (IsWeaponQualityMode == false)
                        {
                            <div class="bonus-cell">
                                <MudSelect ReadOnly="IsInfoMode" T="string" Style="width:100%" Placeholder="@(L["Select a feature type"])" @bind-Value="@obj.FeatureType" Variant="Variant.Outlined" Margin="Margin.Dense" PopoverClass="trait-dialog-select-popover">
                                    @foreach (var __ft in FeatureData) { <MudSelectItem Value="@__ft">@LocCatalog.Name(__ft, L)</MudSelectItem> }
                                </MudSelect>
                            </div>
                        }
                        @if (obj.FeatureType == SD.FeatureAttribute)
                        {
                            <div class="bonus-cell">
                                <MudSelect ReadOnly="IsInfoMode" T="string" Style="width:100%" Placeholder="Select an Attribute " @bind-Value="@obj.FeatureName" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (var __a in SD.Attributes.All) { <MudSelectItem Value="@__a">@LocCatalog.Name(__a, L)</MudSelectItem> }
                                </MudSelect>
                            </div>
                        }
                        else if (obj.FeatureType == SD.FeatureBaseSkill)
                        {
                            <div class="bonus-cell">
                                <MudSelect ReadOnly="IsInfoMode" T="string" Style="width:100%" Placeholder="Select base skill " @bind-Value="@obj.FeatureName" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (var __b in SD.BaseSkills.All) { <MudSelectItem Value="@__b">@LocCatalog.Name(__b, L)</MudSelectItem> }
                                </MudSelect>
                            </div>
                        }
                        else if (obj.FeatureType == SD.FeatureSpecialSkill)
                        {
                            <div class="bonus-cell">
                                <MudSelect ReadOnly="IsInfoMode" T="string" Style="width:100%" Placeholder="Select special skill " @bind-Value="@obj.FeatureName" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (var __s in AllParams.SpecialSkills.GetAllArray()) { <MudSelectItem Value="@__s.Name">@__s.DisplayName(L)</MudSelectItem> }
                                </MudSelect>
                            </div>
                        }
                        else if (obj.FeatureType == SD.FeatureWeaponQuality)
                        {
                            <div class="bonus-cell">
                                <MudSelect ReadOnly="IsInfoMode" T="string" Style="width:100%" Placeholder="@(L["Select weapon quality"])" Value="obj.FeatureName" ValueChanged="@(v => OnWeaponQualityChanged(obj, v))" Variant="Variant.Outlined" Margin="Margin.Dense" PopoverClass="trait-dialog-select-popover">
                                    @foreach (var __w in WeaponQualityList) { <MudSelectItem Value="@__w">@LocCatalog.Name(__w, L)</MudSelectItem> }
                                </MudSelect>
                            </div>
                            @if (!IsBinaryWeaponQuality(obj.FeatureName))
                            {
                                <div class="bonus-cell">
                                    <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="IsInfoMode" Style="width:100%" T="int" @bind-Value="@obj.BonusValue"></MudNumericField>
                                </div>
                            }
                        }
                        else if(obj.FeatureType == SD.FeatureOther)
                        {
                            <div class="bonus-double-cell">
                                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="IsInfoMode" Lines="3" Placeholder="@(L["Insert bonus description"])" @bind-Value="@obj.Description"></MudTextField>

                            </div>
                        }
                        @if (@obj.FeatureName != null && @obj.FeatureType != SD.FeatureOther && obj.FeatureType != SD.FeatureWeaponQuality)
                        {
                            <div class="bonus-cell">
                                <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="IsInfoMode" Style="width:100%" T="int" @bind-Value="@obj.BonusValue"></MudNumericField>
                            </div>
                        }
                    </div>
                }
            }
            @if(IsInfoMode==false)
            {
                <div class="d-flex">
                    <button class="add-bonus-button" @onclick="OnAddBonusBtnClick"><i class="fa-solid fa-plus"></i></button>
                    <button class="add-bonus-button" @onclick="OnDeleteBonusBtnClick"><i class="fa-solid fa-minus"></i></button>
                </div>
            }
        <label class="warnign-message">@ErrorMessage</label>
                    
        </div> 
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnCancelBtnClick">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Error" OnClick="OnSaveTraitBtnClick">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    [Parameter] public TraitDTO NewTrait { get; set; }
    [Parameter] public bool IsEditMode { get; set; } = false;
    [Parameter] public bool IsInfoMode { get; set; } = false;
    [Parameter] public bool IsWeaponQualityMode { get; set; } = false;
    [Parameter] public AllParamsModel AllParams { get; set; }

    public string HeaderName { get; set; } = "";
    private string IconSource = "";
    public UserInfo? UserInfo { get; set; }


    private List<string> WeaponQualityList = new List<string>();

    private string ErrorMessage { get; set; } = string.Empty;

    private List<string> FeatureData = new List<string>
    {
        SD.FeatureAttribute,
        SD.FeatureBaseSkill,
        SD.FeatureSpecialSkill,
        SD.FeatureWeaponQuality,
        SD.FeatureOther
    };

    private void OnSaveTraitBtnClick()
    {

        if (IsWeaponQualityMode)
        {
            NewTrait.Name = SD.WeaponParametersDescr;
            NewTrait.Descr = "";
        }
        else
        {

            if (string.IsNullOrEmpty(NewTrait.Name) || string.IsNullOrEmpty(NewTrait.Descr))
            {
                ErrorMessage = $"Create name and description of trait";
                return;
            }
            if (IsEditMode == false && NewTrait.TraitType == SD.TraitType_Character && AllParams.TraitsCharacter.Where(t => t.Name == NewTrait.Name).Count() > 0)
            {
                ErrorMessage = $"That trait name already exists";
                return;
            }
        }
        foreach (var bonus in NewTrait.Bonuses)
        {
            NormalizeBinaryWeaponQualityValue(bonus);
            if (bonus.BonusValue == 0 && bonus.Description == string.Empty)
            {
                ErrorMessage = $"Please fill all input fiels in bonus";
                return;
            }
        }
        if (!NewTrait.Bonuses.GroupBy(x => x.FeatureName).All(g => g.Count() == 1))
        {
            ErrorMessage = $"Bonuses cannot relate to the same feature more than once";
            return;
        }
        ErrorMessage = string.Empty;

        NewTrait.TraitType = NewTrait.TraitType;
        MudDialog.Close(DialogResult.Ok(NewTrait));
        string message = NewTrait.TraitLabel;
        message  += IsEditMode ?  "edited" : "added";
        Snackbar.Add(message, Severity.Success);
    }
    private void OnCancelBtnClick()
    {
        MudDialog.Cancel();
    }

    private void OnAddBonusBtnClick()
    {
        ErrorMessage = string.Empty;
        if (NewTrait.Bonuses == null)
            NewTrait.Bonuses = new List<BonusDTO>();
        var bonus = new BonusDTO();
        bonus.Index = NewTrait.Bonuses.Count() + 1;
        if(IsWeaponQualityMode == true)
        {
            bonus.FeatureType = SD.FeatureWeaponQuality;
        }
        NewTrait.Bonuses.Add(bonus);
        StateHasChanged();
    }

    private void OnDeleteBonusBtnClick()
    {
        ErrorMessage = string.Empty;
        if (NewTrait.Bonuses is not null && NewTrait.Bonuses.Count() > 0)
        {
            NewTrait.Bonuses.Remove(NewTrait.Bonuses.Last());
            StateHasChanged();
        }
    }

    private static bool IsBinaryWeaponQuality(string? featureName)
        => featureName == SD.WeaponQuality.Light;

    private static void NormalizeBinaryWeaponQualityValue(BonusDTO bonus)
    {
        if (IsBinaryWeaponQuality(bonus.FeatureName))
            bonus.BonusValue = 1;
    }

    private void OnWeaponQualityChanged(BonusDTO bonus, string? featureName)
    {
        bonus.FeatureName = featureName;
        NormalizeBinaryWeaponQualityValue(bonus);
    }

    protected override async Task OnInitializedAsync()
    {
        UserInfo = await _userService.GetUserInfo();
        ErrorMessage = string.Empty;
        foreach(var quality in SD.WeaponQuality.All)
        {
            WeaponQualityList.Add(quality);
        }
        if (IsWeaponQualityMode)
        {
            HeaderName = IsEditMode ? "Edit weapon properties" : "Add weapon properties";

            FeatureData = new List<string>
            {
                SD.FeatureWeaponQuality
            };
            IconSource = MyIcon.Attack;
        }
        else
        {
            FeatureData = new List<string>
            {
                SD.FeatureAttribute,
                SD.FeatureBaseSkill,
                SD.FeatureSpecialSkill,
                SD.FeatureWeaponQuality,
                SD.FeatureOther
            };

            HeaderName = IsEditMode ? "Edit " : "Add " + NewTrait.TraitLabel;

            switch (NewTrait.TraitType)
            {
                case SD.TraitType_Gear: IconSource = MyIcon.Anvil; break;
                case SD.TraitType_Profession:
                case SD.TraitType_Race:
                case SD.TraitType_Character: IconSource = MyIcon.Ability; break;
                case SD.TraitType_Temporary: IconSource = MyIcon.Stunned; break;

            }
        }
        foreach (var bonus in NewTrait.Bonuses ?? [])
        {
            NormalizeBinaryWeaponQualityValue(bonus);
        }
        MudDialog.StateHasChanged();
    }
}
