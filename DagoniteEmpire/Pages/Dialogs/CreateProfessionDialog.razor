@using DA_DataAccess.CharacterClasses
@inject IJSRuntime _jsruntime
@inject IUserService _userService
<MudDialog>
    <TitleContent>Określ klasę</TitleContent>
        <DialogContent>
                 <div class="main-table">                    
                        <label class="warnign-message">@ErrorMessage</label>
                        <div class="wide-screen-table">
                            <div class="d-flex ">
                                <div class="d-flex flex-column px-1 flex-grow-1">
                                    <label class="class-section py-1">Nazwa klasy</label>
                                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Wpisz nazwę klasy" @bind-Value="@ProfessionDTO.Name"></MudTextField>
                                </div>
                                <div class="d-flex flex-column px-1">
                                    <label class="class-section py-1">Powiązany atrybut</label>
                                    <InputSelect style="width: 150px;height: 32px;border: 1px solid RGB(206 212 218); border-radius: 4px; padding: 0px 4px 0px 4px;"
                                                 ValueExpression="@(()=>ProfessionDTO.RelatedAttributeName)"
                                                 Value="@ProfessionDTO.RelatedAttributeName"
                                                 ValueChanged="@((string value) => ChangeRelatedAttribute(value))">
                                        <option value="0" selected disabled>--Wybierz--</option>
                                        @foreach(var attr in SD.Attributes.All)
                                        {
                                            <option value="@attr"> @attr</option>
                                        }
                                    </InputSelect>
                                </div>
                                @if (UserInfo?.IsAdminOrMG == true)
                                {
                                    <div class="d-flex flex-column px-1">
                                        <label class="column-section py-1">Poziom klasy</label>
                                        <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:100px"  HideSpinButtons="true" @bind-Value="@ProfessionDTO.ClassLevel" @bind-Value:after="ChangeProfLevel"></MudNumericField>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex flex-column px-1">
                                        <label class="column-section py-1">Poziom klasy</label>
                                        <label class="prof-variables">@ProfessionDTO.ClassLevel</label>
                                    </div>
                                }

                                <div class="d-flex flex-column px-1">
                                    <label class="column-section py-1">Rzut na umiejętność</label>
                                    <label class="prof-variables">@ProfessionDTO.ProfessionSkillRoll</label>
                                </div>
                                <div class="d-flex flex-column px-1">
                                    <label class="column-section py-1">Punkty skupienia</label>
                                     <label class="prof-variables">@ProfessionDTO.MaxFocusPoints</label>
                                </div>
                                @if (UserInfo?.IsAdminOrMG == true)
                                {
                                    <div class="d-flex flex-column px-1">
                                        <label class="class-section py-1">Zatwierdź</label>
                                        <div class="justify-content-center mx-auto my-auto">
                                            <MudCheckBox T="bool" @bind-Value="ProfessionDTO.IsApproved"></MudCheckBox>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="short-screen-table">
                            <div class="d-flex flex-column ">
                                <div class="d-flex" >
                                    <div class="d-flex flex-column px-1 flex-grow-1">
                                        <label class="class-section py-1">Nazwa klasy</label>
                                        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Wpisz nazwę klasy" @bind-Value="@ProfessionDTO.Name"></MudTextField>
                                    </div>
                                    @if (UserInfo?.IsAdminOrMG == true)
                                    {
                                        <div class="d-flex flex-column px-1">
                                            <label class="class-section py-1">Zatwierdź</label>
                                            <div class="justify-content-center mx-auto my-auto">
                                                <MudCheckBox T="bool" @bind-Value="ProfessionDTO.IsApproved"></MudCheckBox>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="d-flex flex-column px-1">
                                    <label class="class-section py-1">Powiązany atrybut</label>
                                    <InputSelect style="height: 32px;border: 1px solid RGB(206 212 218); border-radius: 4px; padding: 0px 4px 0px 4px;"
                                                 ValueExpression="@(()=>ProfessionDTO.RelatedAttributeName)"
                                                 Value="@ProfessionDTO.RelatedAttributeName"
                                                 ValueChanged="@((string value) => ChangeRelatedAttribute(value))">
                                        
                                        <option value="0" selected disabled>--Wybierz--</option>
                                        @foreach (var attr in SD.Attributes.All)
                                        {
                                            <option value="@attr"> @attr</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="d-flex">
                                    @if (UserInfo?.IsAdminOrMG == true)
                                    {
                                        <div class="d-flex flex-column px-1 variables">
                                            <label class="column-section py-1">Poziom klasy</label>
                                            <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense"  HideSpinButtons="true" @bind-Value="@ProfessionDTO.ClassLevel" @bind-Value:after="ChangeProfLevel"></MudNumericField>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-column px-1 variables">
                                            <label class="column-section py-1">Poziom klasy</label>
                                            <label class="prof-variables">@ProfessionDTO.ClassLevel</label>
                                        </div>
                                    }

                                    <div class="d-flex flex-column px-1 variables">
                                        <label class="column-section py-1">Rzut na umiejętność</label>
                                        <label class="prof-variables">@ProfessionDTO.ProfessionSkillRoll</label>
                                    </div>
                                    <div class="d-flex flex-column px-1 variables">
                                        <label class="column-section py-1">Punkty skupienia</label>
                                        <label class="prof-variables">@ProfessionDTO.MaxFocusPoints</label>
                                    </div>
                                 </div>
                                
                            </div>

                        </div>
                        <div class="d-flex flex-column flex-grow-1">
                            <label class="class-section">Opis klasy</label>
                            <MudTextField T="string" Variant="Variant.Outlined" Lines="5" @bind-Value="@ProfessionDTO.Description" Placeholder="Wpisz opis klasy"></MudTextField>
                        </div>
                        @*  ACTIVE SKILLS  *@
                        <label class="class-section">Aktywne umiejętności klasy</label>

                        <div class="wide-screen-table">

                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th scope="col" class="level-row text-center">Poziom</th>
                                        <th scope="col" class="name-row text-center">Nazwa</th>
                                        <th scope="col" class="descr-row text-center">Opis</th>
                                        <th scope="col" class="number-row text-center">DC</th>
                                        <th scope="col" class="number-row text-center">Koszt</th>
                                        <th scope="col" class="number-row text-center"> Zasięg</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var skill in (ProfessionDTO.Traits ?? []).Where(t=>t.IsActiveSkill==true))
                                {
                                    <tr>
                                        @if (skill.Index%2==0){
                                            <td rowspan="2"> <label class="short-row">@skill.Level</label> </td>
                                        }
                                        <td> <div class="name-cell"> <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Wpisz nazwę umiejętności" @bind-Value="@skill.Name"></MudTextField> </div> </td>
                                        <td>
                                            <div class="bonus-double-cell">
                                                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" id="@skill.Index.ToString()" @bind-Value:after="@(()=>ChangeDescription(skill.Index))" Lines="3" Placeholder="Wpisz opis umiejętności" @bind-Value="@skill.Descr">
                                                </MudTextField>
                                            </div>
                                        </td>
                                        <td><div class="short-row"><MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" @bind-Value="@skill.DC"></MudNumericField></div></td>
                                        <td><div class="short-row"><MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" @bind-Value="@skill.Cost"></MudNumericField></div></td>
                                        <td><div class="short-row"><MudTextField Variant="Variant.Outlined" Margin="Margin.Dense"  @bind-Value="@skill.Range"></MudTextField></div></td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        <div class="short-screen-table">

                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th scope="col" class="level-row text-center">Poziom</th>
                                        <th scope="col" class="name-row-short text-center">Nazwa</th>
                                        <th scope="col" class="number-row text-center">DC</th>
                                        <th scope="col" class="number-row text-center">Koszt</th>
                                        <th scope="col" class="number-row text-center"> Zasięg</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var skill in (ProfessionDTO.Traits ?? []).Where(t => t.IsActiveSkill == true))
                                    {
                                        <tr>
                                            @if (skill.Index % 2 == 0)
                                            {
                                                <td rowspan="4"> <label class="short-row">@skill.Level</label> </td>
                                            }
                                            <td> <div class="name-cell"> <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Wpisz nazwę umiejętności" @bind-Value="@skill.Name"></MudTextField> </div> </td>
                                           
                                            <td><div class="short-row"><MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" @bind-Value="@skill.DC"></MudNumericField></div></td>
                                            <td><div class="short-row"><MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" @bind-Value="@skill.Cost"></MudNumericField></div></td>
                                            <td><div class="short-row"><MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="@skill.Range"></MudTextField></div></td>
                                        </tr>
                                        <tr>
                                            <td colspan="4">
                                                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" id="@skill.Index.ToString()" @bind-Value:after="@(()=>ChangeDescription(skill.Index))" Lines="3" Placeholder="Wpisz opis umiejętności" @bind-Value="@skill.Descr">
                                                </MudTextField>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                       @*  PASSIVE SKILLS  *@
                        <label class="class-section">Pasywne umiejętności klasy</label>

                        <div class="wide-screen-table">

                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th scope="col" class="level-row text-center">Poziom</th>
                                        <th scope="col" class="name-row text-center">Nazwa</th>
                                        <th scope="col" class="descr-row text-center">Opis</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var skill in (ProfessionDTO.Traits ?? []).Where(t=>t.IsActiveSkill==false))
                                    {
                                        <tr>
                                            <td> <label class="short-row">@skill.Level</label> </td>
                                            <td> <div class="name-cell"> <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Wpisz nazwę umiejętności" @bind-Value="@skill.Name"></MudTextField> </div> </td>
                                            <td>
                                                <div class="bonus-double-cell">
                                                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" id="@skill.Index.ToString()" @bind-Value:after="@(()=>ChangeDescription(skill.Index))" Lines="3" Placeholder="Wpisz opis umiejętności" @bind-Value="@skill.Descr">
                                                    </MudTextField>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="short-screen-table">

                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th scope="col" class="number-row text-center">Poziom</th>
                                        <th scope="col" class="name-row-short text-center">Nazwa</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var skill in (ProfessionDTO.Traits ?? []).Where(t => t.IsActiveSkill == false))
                                    {
                                        <tr>
                                            <td rowspan="2"> <label class="short-row">@skill.Level</label> </td>
                                            <td> <div class="name-cell"> <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Wpisz nazwę umiejętności" @bind-Value="@skill.Name"></MudTextField> </div> </td>
                                        </tr>
                                        <tr>
                                            <td colspan="2">
                                                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" id="@skill.Index.ToString()" @bind-Value:after="@(()=>ChangeDescription(skill.Index))" Lines="3" Placeholder="Wpisz opis umiejętności" @bind-Value="@skill.Descr">
                                                </MudTextField>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <label class="warnign-message">@ErrorMessage</label>
                </div>  
                
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="OnCancelBtnClick">Anuluj</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OnSaveProfBtnClick">Zapisz</MudButton>
        </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public AllParamsModel AllParams { get; set; }

    [Parameter] public ProfessionDTO ProfessionDTO { get; set; } = new();

    public UserInfo? UserInfo { get; set; }

    private string ErrorMessage { get; set; } = string.Empty;

    public void ChangeDescription(int args)
    {
        _jsruntime.InvokeVoidAsync("ResizeTextArea", $"{args}");
    }

    private async Task OnSaveProfBtnClick()
    {
        try
        {
            if (string.IsNullOrEmpty(ProfessionDTO.Name) || string.IsNullOrEmpty(ProfessionDTO.Description))
            {
                ErrorMessage = "Utwórz nazwę i opis klasy";
                return;
            }
            if (string.IsNullOrEmpty(ProfessionDTO.RelatedAttributeName))
            {
                ErrorMessage = "Wybierz atrybut powiązany z klasą";
                return;
            }
            ProfessionDTO.CurrentFocusPoints = ProfessionDTO.MaxFocusPoints;
            ErrorMessage = string.Empty;
            MudDialog.Close(DialogResult.Ok(ProfessionDTO));
        }
        catch (Exception ex)
        {
            ErrorMessage = "Błąd zapisu: " + ex.Message;
            await _jsruntime.ToastrError("Zapis nie powiódł się: " + ex.Message + " | " + ex.GetType().Name);
        }
    }

    private void OnCancelBtnClick()
    {
        MudDialog.Cancel();
    }

    private void ChangeProfLevel()
    {
        ProfessionDTO.CalculateClassParams(AllParams.Attributes.GetAll());
        StateHasChanged();
    }

    private async Task ChangeRelatedAttribute(string attrName)
    {
        try
        {
            if (attrName != null && attrName != "0")
            {
                ProfessionDTO.RelatedAttributeName = attrName;
                var attr = AllParams.Attributes.Get(attrName);
                if (attr == null) return;
                ProfessionDTO.AddPropertyListener(attr);
                ProfessionDTO.CalculateClassParams(AllParams.Attributes.GetAll());
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            await _jsruntime.ToastrError("Błąd podczas zmiany atrybutu powiązanego z profesją: " + ex.Message);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        UserInfo = await _userService.GetUserInfo();
        if (ProfessionDTO is not null && AllParams is not null)
        {
            ProfessionDTO.CalculateClassParams(AllParams.Attributes.GetAll());
        }
    }

}
