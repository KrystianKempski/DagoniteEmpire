@using DA_DataAccess.CharacterClasses
@inject ISnackbar Snackbar
@inject IUserService _userService
@inject IDialogService DialogService
@inject IBrowserViewportService _vieportService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <img src="@MyIcon.Scroll" width="40x" height="40px" class="helm-icon" />
            @HeaderName
        </MudText>
    </TitleContent>
    <DialogContent>
        <div class="main-table">
            <div class="d-flex ">
                <div class="d-flex flex-column flex-grow-1">
                <label class="fw-bold py-1">Nazwa umiejętności profesji</label>
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="IsInfoMode" Placeholder="Nazwa talentu" @bind-Value="@NewTrait.Name"></MudTextField>
                </div>

                @if (UserInfo?.IsAdminOrMG == true)
                {
                <div class="d-flex flex-column px-1">
                    <label class="fw-bold py-1">Zatwierdź</label>
                    <div class="justify-content-center mx-auto my-auto">
                    <MudCheckBox T="bool"  @bind-Value="NewTrait.TraitApproved"></MudCheckBox>
                    </div>
                </div>
                }
            </div>
            <div class="align-items-start bonus-name py-0">
                <label class="fw-bold  py-1">Opis umiejętności profesji</label>
            </div>
            <div class="align-items-start">
                <div class="col-12 bonus-name py-0">
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="IsInfoMode" Lines="3" Placeholder="Wpisz ogólny opis cechy" @bind-Value="@NewTrait.Descr"></MudTextField>
                </div>
            </div>
           
                        
            <label class="fw-bold pt-4">Premie i kary</label>

            @if (NewTrait.Bonuses != null)
            {
                @foreach (var obj in NewTrait.Bonuses)
                {
                    <label class="bonus-cell">Premia @obj.Index</label>
                    <div class="bonuses-columns">
                            <div class="bonus-cell">
                            <MudSelect ReadOnly="IsInfoMode" T="string" Style="width:100%" Placeholder="Wybierz typ właściwości" @bind-Value="@obj.FeatureType" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var __ft in FeatureData) { <MudSelectItem Value="@__ft">@__ft</MudSelectItem> }
                            </MudSelect>
                            </div>
                        @if (obj.FeatureType == SD.FeatureAttribute)
                        {
                            <div class="bonus-cell">
                                <MudSelect ReadOnly="IsInfoMode" T="string" Style="width:100%" Placeholder="Wybierz atrybut " @bind-Value="@obj.FeatureName" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (var __a in AllParams.Attributes.GetAllArray()) { <MudSelectItem Value="@__a.Name">@__a.Name</MudSelectItem> }
                                </MudSelect>
                            </div>
                        }
                        else if (obj.FeatureType == SD.FeatureBaseSkill)
                        {
                            <div class="bonus-cell">
                                <MudSelect ReadOnly="IsInfoMode" T="string" Style="width:100%" Placeholder="Wybierz umiejętność bazową " @bind-Value="@obj.FeatureName" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (var __b in AllParams.BaseSkills) { <MudSelectItem Value="@__b.Name">@__b.Name</MudSelectItem> }
                                </MudSelect>
                            </div>
                        }
                        else if (obj.FeatureType == SD.FeatureSpecialSkill)
                        {
                            <div class="bonus-cell">
                                <MudSelect ReadOnly="IsInfoMode" T="string" Style="width:100%" Placeholder="Wybierz umiejętność specjalną " @bind-Value="@obj.FeatureName" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (var __s in AllParams.SpecialSkills.GetAllArray()) { <MudSelectItem Value="@__s.Name">@__s.Name</MudSelectItem> }
                                </MudSelect>
                            </div>
                        }
                        else if (obj.FeatureType == SD.FeatureWeaponQuality)
                        {
                            <div class="bonus-cell">
                                <MudSelect ReadOnly="IsInfoMode" T="string" Style="width:100%" Placeholder="Wybierz cechę broni" @bind-Value="@obj.FeatureName" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (var __w in WeaponQualityList) { <MudSelectItem Value="@__w">@__w</MudSelectItem> }
                                </MudSelect>
                            </div>
                        }
                        else if(obj.FeatureType == SD.FeatureOther)
                        {
                            <div class="bonus-double-cell">
                                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="IsInfoMode" Lines="3" Placeholder="Wpisz opis premii" @bind-Value="@obj.Description"></MudTextField>

                            </div>
                        }
                        @if (@obj.FeatureName != null && @obj.FeatureType != SD.FeatureOther)
                        {
                            if (obj.FeatureType == SD.FeatureWeaponQuality)
                            {
                                <div class="bonus-cell">
                                    <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="IsInfoMode"  Style="width:100%" T="int" @bind-Value="@obj.BonusValue"></MudNumericField>
                                </div>
                            }
                            else
                            {

                                <div class="bonus-cell">
                                    <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="IsInfoMode" Style="width:100%" T="int" @bind-Value="@obj.BonusValue"></MudNumericField>
                                </div>
                            }
                        }

                    </div>
                }

                <div class="d-flex">
                    <button class="add-bonus-button" @onclick="OnAddBonusBtnClick"><i class="fa-solid fa-plus"></i></button>
                    <button class="add-bonus-button" @onclick="OnDeleteBonusBtnClick"><i class="fa-solid fa-minus"></i></button>
                    </div>

            <label class="warnign-message">@ErrorMessage</label>
            } 
        </div>

        <MudDivider Class="mt-4 mb-2" />

        @if (IsActiveSkill)
        {
            <div class="d-flex py-2">
                <div class="d-flex flex-column me-4">
                    <label class="fw-bold py-1">DC</label>
                    <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="IsInfoMode" Placeholder="DC" @bind-Value="@NewTrait.DC"></MudNumericField>
                </div>
                <div class="d-flex flex-column me-4">
                    <label class="fw-bold py-1">Koszt</label>
                    <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="IsInfoMode" Placeholder="Koszt" @bind-Value="@NewTrait.Cost"></MudNumericField>
                </div>
                <div class="d-flex flex-column me-4">
                    <label class="fw-bold py-1">Zasięg</label>
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="IsInfoMode" Placeholder="Zasięg" @bind-Value="@NewTrait.Range"></MudTextField>
                </div>
            </div>
        }
        else
        {           
            <div class="d-flex py-2">
                <MudButton Class="me-4" Variant="Variant.Filled" OnClick="SelectExistingSkill">Wybierz istniejący talent</MudButton>
                <MudButton Variant="Variant.Filled" OnClick="ClearSkill">Wyczyść umiejętność</MudButton>
            </div>
        }

    </DialogContent>
    <DialogActions>

        <MudButton OnClick="OnCancelBtnClick">Anuluj</MudButton>
        <MudButton Color="Color.Error" OnClick="OnSaveTraitBtnClick">Zapisz</MudButton>

    </DialogActions>
</MudDialog>

<style>
    @@media (max-width: 400px) {
        .e-dialog.e-popup {
            width: 100% !important;
            height: 100% !important;
        }
    }
</style>

@code {
    [CascadingParameter] 
    IMudDialogInstance MudDialog { get; set; }
    [Parameter] public AllParamsModel AllParams { get; set; }
    [Parameter] public TraitProfessionDTO NewTrait { get; set; }
    [Parameter] public bool IsEditMode { get; set; } = false;
    [Parameter] public bool IsInfoMode { get; set; } = false;
    [Parameter] public bool IsActiveSkill { get; set; } = false;

    public UserInfo? UserInfo { get; set; }
    public string TraitType { get; set; } = SD.TraitType_Profession;
    private string HeaderName = "Modyfikuj talent";

    List<string> WeaponQualityList = new List<string> {
        SD.WeaponQuality.Fast,
        SD.WeaponQuality.Slow,
        SD.WeaponQuality.Parrying ,
        SD.WeaponQuality.ShieldDestructive ,
        SD.WeaponQuality.ArmorPiercing,
        SD.WeaponQuality.Long,
        SD.WeaponQuality.Heavy,
        SD.WeaponQuality.Devastating,
        SD.WeaponQuality.Weak ,
        SD.WeaponQuality.Stunning,
        SD.WeaponQuality.Snatching,
        SD.WeaponQuality.Disarming,
        SD.WeaponQuality.Armor,
        SD.WeaponQuality.ArmorDefenceBonus,
        SD.WeaponQuality.ArmorPenalty,
        SD.WeaponQuality.Durability,
        SD.WeaponQuality.ShieldDefenceBonus,
        SD.WeaponQuality.Bulky,
        SD.WeaponQuality.Precise,
        SD.WeaponQuality.Range,
        SD.WeaponQuality.Light,
      };

    private string ErrorMessage { get; set; } = string.Empty;

    private List<string> FeatureData = new List<string>
    {
        SD.FeatureAttribute,
        SD.FeatureBaseSkill,
        SD.FeatureSpecialSkill,
        SD.FeatureWeaponQuality,
        SD.FeatureOther
    };

    private void OnSaveTraitBtnClick()
    {
        if (string.IsNullOrEmpty(NewTrait.Name) || string.IsNullOrEmpty(NewTrait.Descr))
        {
            ErrorMessage = $"Utwórz nazwę i opis cechy";
            return;
        }
        if (IsEditMode == false && AllParams.TraitsProfession.Where(t => t.Name == NewTrait.Name).Count() > 0)
        {
            ErrorMessage = $"Cecha o tej nazwie już istnieje";
            return;
        }

        foreach (var bonus in NewTrait.Bonuses)
        {
            if (bonus.BonusValue == 0 && bonus.Description == string.Empty)
            {
                ErrorMessage = $"Wypełnij wszystkie pola w premii";
                return;
            }
        }
        if (!NewTrait.Bonuses.GroupBy(x => x.FeatureName).All(g => g.Count() == 1))
        {
            ErrorMessage = $"Premie nie mogą dotyczyć tej samej właściwości więcej niż raz";
            return;
        }

        ErrorMessage = string.Empty;       
        NewTrait.TraitType = TraitType;
        MudDialog.Close(DialogResult.Ok(NewTrait));
        string text = "";
        if (NewTrait.IsActiveSkill)
            text = "Aktywna umiejętność zmodyfikowana";
        else
            text = "Pasywna umiejętność zmodyfikowana";
        Snackbar.Add(text, Severity.Success);
    }
    private void OnCancelBtnClick()
    {
        MudDialog.Close(DialogResult.Cancel());
    }
    protected override async Task OnInitializedAsync()
    {
        ErrorMessage = string.Empty;
        UserInfo = await _userService.GetUserInfo();

        FeatureData = new List<string>
        {
            SD.FeatureAttribute,
            SD.FeatureBaseSkill,
            SD.FeatureSpecialSkill,
            SD.FeatureWeaponQuality,
            SD.FeatureOther
        };

        if (TraitType == SD.TraitType_Profession)
        {
            HeaderName = "Edytuj umiejętność profesji";
        }
        else
        {
            if (IsEditMode)
                HeaderName = "Edytuj cechę";
            else
                HeaderName = "Utwórz nową cechę";
        }
    }

    private void OnAddBonusBtnClick()
    {
        ErrorMessage = string.Empty;
        if (NewTrait.Bonuses == null)
            NewTrait.Bonuses = new List<BonusDTO>();
        var bonus = new BonusDTO();
        bonus.Index = NewTrait.Bonuses.Count() + 1;

        NewTrait.Bonuses.Add(bonus);
    }

    private void OnDeleteBonusBtnClick()
    {
        ErrorMessage = string.Empty;
        if (NewTrait.Bonuses is not null && NewTrait.Bonuses.Count() > 0)
        {
            NewTrait.Bonuses.Remove(NewTrait.Bonuses.Last());
        }
    }
    private async Task SelectExistingSkill()
    {

        List<TraitDTO> ChosenTraits = new List<TraitDTO>();
        var parameters = new DialogParameters<ExistingTraitDialog> { { x => x.ChosenTraits, ChosenTraits },
                                                                   { x => x.TraitType, TraitType },
                                                                   { x => x.MinLevel, NewTrait.Level },
                                                                   { x => x.MultiRowSelection, false },
                                                                   { x => x.AllParams, AllParams }};

        var dialog = await DialogService.ShowAsync<ExistingTraitDialog>("Wybierz " + NewTrait.TraitLabel, parameters, await SetDialogOptions());
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            ChosenTraits = (List<TraitDTO>)result.Data;
            if (ChosenTraits is null)
                throw new Exception("error in trait selection dialog");

            if (ChosenTraits.Any())
            {
                //copy properties of selected generic triait to current trait
                var selectedTrait = (TraitProfessionDTO)ChosenTraits.First();

                foreach (var prop in selectedTrait.GetType().GetProperties())
                {
                    if (prop.Name != "ProfessionId" && prop.Name != "Id" && prop.Name != "Level" && NewTrait.GetType().GetProperty(prop.Name).CanWrite ){
                        var val  = prop.GetValue(selectedTrait, null);
                        NewTrait.GetType().GetProperty(prop.Name).SetValue(NewTrait, val, null);
                    }
                }
            }
        }
        IsInfoMode = true;
        StateHasChanged();
    }
    private void ClearSkill()
    {
        NewTrait.Descr= string.Empty;
        NewTrait.Name = string.Empty;
        NewTrait.TraitValue = 0;
        NewTrait.Bonuses = new List<BonusDTO>();
        IsInfoMode = false;
        StateHasChanged();
    }

    private async Task<DialogOptions> SetDialogOptions(MaxWidth maxWidth = MaxWidth.Large)
    {
        var __isFs = await _vieportService.GetCurrentBreakpointAsync() <= Breakpoint.Md;
        return new DialogOptions { MaxWidth = maxWidth, FullScreen = __isFs };
    }

}
