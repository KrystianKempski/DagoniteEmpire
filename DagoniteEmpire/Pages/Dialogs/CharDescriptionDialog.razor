@inject IUserService _userService
@inject IDialogService DialogService
<div class="description-frame">

    <div class="sheet-img">
        @* <img src="../images/old_paper2.png" class="stretch" /> *@
    </div>
    <h3 class="my-3 ml-3 text-center">OPIS</h3>
    <div class="descr-container">
        <div class="ql-snow ql-content description-richtext" style="border-width:0">
            <div class="ql-editor description-preview-editor">
                @((MarkupString)(SavedDescription ?? "<p>Tutaj wpisz opis swojej postaci</p>"))
            </div>
        </div>
        <button class="add-trait" @onclick="OnStartDescriptionDialog">Opis</button>
    </div>

    <MudDialog @bind-Visible="@IsDescrDialVisible" Options="@(new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Large })">
        <TitleContent>Napisz opis postaci</TitleContent>
        <DialogContent>
            <div class="character-description-editor">
            <BlazoredTextEditor @ref="@DescrEditor">
                <ToolbarContent>
                    <select class="ql-header">
                        <option selected=""></option>
                        <option value="1"></option>
                        <option value="2"></option>
                    </select>
                    <span class="ql-formats">
                        <button class="ql-bold"></button>
                        <button class="ql-italic"></button>
                        <button class="ql-underline"></button>
                        <button class="ql-strike"></button>
                    </span>
                    <span class="ql-formats">
                        <select class="ql-color"></select>
                        <select class="ql-background"></select>
                    </span>
                    <span class="ql-formats">
                        <button class="ql-list" value="ordered"></button>
                        <button class="ql-align" value=""></button>
                        <button class="ql-align" value="center"></button>
                        <button class="ql-align" value="right"></button>
                    </span>
                    <span class="ql-formats">
                        <button class="ql-link"></button>
                        <button class="ql-image"></button>
                    </span>
                </ToolbarContent>
                <EditorContent></EditorContent>
            </BlazoredTextEditor>
            </div>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@OnCancelBtnClick">Anuluj</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@OnSaveDescrBtnClick">Zapisz</MudButton>
        </DialogActions>
    </MudDialog>
</div>

<style>
    @@media (max-width: 400px) {
        .e-dialog.e-popup {
            width: 100% !important;
            height: 100% !important;
        }
    }
</style>

@code {
    [CascadingParameter]
    public AllParamsModel AllParams { get; set; }

    [Parameter]
    public EventCallback<string> DescriptionConfirmation { get; set; }

    public UserInfo? UserInfo { get; set; }
    [Parameter]
    public string SavedDescription { get; set; } = "<p>Tutaj wpisz opis swojej postaci</p>";

    private bool IsDescrDialVisible = false;
    private BlazoredTextEditor? DescrEditor;
    private bool _shouldLoadContent;
    private int _descrEditorLoadAttempts;
    private const int MaxDescrEditorLoadAttempts = 10;
    private string? _pendingDescriptionHtml;

    private async Task OnStartDescriptionDialog()
    {
        IsDescrDialVisible = true;
        _shouldLoadContent = true;
        _descrEditorLoadAttempts = 0;
        _pendingDescriptionHtml = SavedDescription ?? string.Empty;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_shouldLoadContent || _descrEditorLoadAttempts >= MaxDescrEditorLoadAttempts)
            return;

        if (DescrEditor is null)
        {
            _descrEditorLoadAttempts++;
            await Task.Delay(50);
            StateHasChanged();
            return;
        }

        var loaded = await TryLoadDescriptionIntoEditorAsync();
        if (!loaded)
        {
            await Task.Delay(50);
            StateHasChanged();
        }
    }

    private async Task<bool> TryLoadDescriptionIntoEditorAsync()
    {
        if (DescrEditor is null)
            return false;

        try
        {
            var html = _pendingDescriptionHtml ?? SavedDescription ?? string.Empty;
            await DescrEditor.LoadHTMLContent(html);

            if (string.IsNullOrWhiteSpace(html) || IsEmptyEditorHtml(html))
            {
                _shouldLoadContent = false;
                return true;
            }

            var loadedHtml = await DescrEditor.GetHTML();
            if (IsEmptyEditorHtml(loadedHtml))
            {
                _descrEditorLoadAttempts++;
                return false;
            }

            _shouldLoadContent = false;
            return true;
        }
        catch
        {
            _descrEditorLoadAttempts++;
            return false;
        }
    }

    private static bool IsEmptyEditorHtml(string? html) =>
        string.IsNullOrWhiteSpace(html)
        || html.Trim() is "<p><br></p>" or "<p></p>";

    private async Task OnSaveDescrBtnClick()
    {
        if (DescrEditor is not null)
        {
            SavedDescription = await DescrEditor.GetHTML();
        }
        IsDescrDialVisible = false;
        _shouldLoadContent = false;
        _descrEditorLoadAttempts = 0;
        await DescriptionConfirmation.InvokeAsync(SavedDescription);
    }

    private void OnCancelBtnClick()
    {
        IsDescrDialVisible = false;
        _shouldLoadContent = false;
        _descrEditorLoadAttempts = 0;
    }

    protected override async Task OnInitializedAsync()
    {
        UserInfo = await _userService.GetUserInfo();
    }

}
