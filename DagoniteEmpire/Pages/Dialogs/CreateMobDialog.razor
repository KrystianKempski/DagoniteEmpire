@inject ISnackbar Snackbar
@inject IMobRepository _mobRepository
@inject ICampaignRepository _campaignRepository
@inject IChapterRepository _chapterRepository
@inject IDialogService DialogService
@inject IBrowserViewportService _vieportService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <img src="@MyIcon.Helm" width="40x" height="40px" class="helm-icon" />
            @Title — postać moba
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @bind-IsValid="@success">

            <MudPaper Width="320px" Height="320px" Class="pa-2">
                <div class="portrait-relative">
                    <div class="portrait-imageframe">
                        <img src="@NewMob.ImageUrl" class="portrait-image" />
                         <label class="input-label" for="input">@ChooseFile</label>
                        <InputFile id="input" OnChange="HandleImageUpload" class="sr-only" accept=".jpg,.png,.jpeg"></InputFile>
                    </div>
                </div>
            </MudPaper>

            <MudStack Row="true">
                <MudTextField Required="true" @bind-Value="@NewMob.Name" Label="Nazwa"  />
                <MudTextField Required="true" @bind-Value="@NewMob.RaceName" Label="Rasa"  />
                <MudTextField Required="true" @bind-Value="@NewMob.ProfessionName" Label="Profesja" />
                 <MudSelect Required="true" @bind-Value="@NewMob.Relation" Label="Relacja">
                    <MudSelectItem Value="Relation.Ally">Sojusznik</MudSelectItem>
                    <MudSelectItem Value="Relation.Neutral">Neutralny</MudSelectItem>
                    <MudSelectItem Value="Relation.Enemy">Wróg</MudSelectItem>

                </MudSelect> 
            </MudStack>

            <MudTextField Required="true" @bind-Value="@NewMob.Description" Label="Opis" Lines="3" />
            <MudTextField @bind-Value="@NewMob.Notes" Label="Notatki" Lines="3" />
            <MudGrid>
                <MudItem xs="3">
                    <MudNumericField Required="true" @bind-Value="@NewMob.AttackSkillValue" Label="Atak" />
                </MudItem>
                <MudItem xs="3">
                    <MudNumericField Required="true" @bind-Value="@NewMob.ShieldSkillValue" Label="Tarcza" />
                </MudItem>
                <MudItem xs="3">
                    <MudNumericField Required="true" @bind-Value="@NewMob.DodgeSkillValue" Label="Unik" />
                </MudItem>
                <MudItem xs="3">
                    <MudNumericField Required="true" @bind-Value="@NewMob.ArmorSkillValue" Label="Pancerz" />
                </MudItem>
                <MudItem xs="3">
                    <MudNumericField Required="true" @bind-Value="@NewMob.ParrySkillValue" Label="Parowanie" />
                </MudItem>
                <MudItem xs="3">
                    <MudNumericField Required="true" @bind-Value="@NewMob.LiftingSkillValue" Label="Podnoszenie" />
                </MudItem>
                <MudItem xs="3">
                    <MudNumericField Required="true" @bind-Value="@NewMob.PainResSkillValue" Label="Odporność na ból" />
                </MudItem>
                <MudItem xs="3">
                    <MudNumericField Required="true" @bind-Value="@NewMob.WrestlingSkillValue" Label="Zapasy" />
                </MudItem>
                <MudItem xs="3">
                    <MudNumericField Required="true" @bind-Value="@NewMob.PerceptionSkillValue" Label="Percepcja" />
                </MudItem>
                <MudItem xs="3">
                    <MudNumericField Required="true" @bind-Value="@NewMob.WillpowerSkillValue" Label="Siła woli" />
                </MudItem>
                <MudItem xs="3">
                    <MudNumericField Required="true" @bind-Value="@NewMob.CharismaSkillValue" Label="Charyzma" />
                </MudItem>

            </MudGrid>

             <MudGrid>
                <MudItem xs="6">
                    <MudSelect Required="true" ShrinkLabel="true" @bind-Value="@NewMob.MainWeaponName" Label="Broń główna">
                        <MudSelectItem Value="string.Empty">Brak</MudSelectItem>
                        @foreach (string weapon in SD.BasicWeaponsMelee.All)
                        {
                            <MudSelectItem Value="@weapon">@weapon</MudSelectItem>
                        }
                        @foreach (string weapon in SD.BasicWeaponsShooting.All)
                        {
                            <MudSelectItem Value="@weapon">@weapon</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                    <MudItem xs="6">
                    <MudSelect ShrinkLabel="true" @bind-Value="@NewMob.OffWeaponName" Label="Broń drugorzędna">
                        <MudSelectItem Value="string.Empty">Brak</MudSelectItem>
                        @foreach (string weapon in SD.BasicWeaponsMelee.All)
                        {
                            <MudSelectItem Value="@weapon">@weapon</MudSelectItem>
                        }
                        @foreach (string weapon in SD.BasicWeaponsShooting.All)
                        {
                            <MudSelectItem Value="@weapon">@weapon</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6">
                    <MudSelect ShrinkLabel="true"  @bind-Value="@NewMob.ShieldWeaponName" Label="Tarcza">
                        <MudSelectItem Value="string.Empty">Brak</MudSelectItem>
                        @foreach (string shield in SD.BasicShields.All)
                        {
                            <MudSelectItem Value="@shield">@shield</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6">
                    <MudSelect ShrinkLabel="true"  @bind-Value="@NewMob.ArmorName" Label="Pancerz">
                        <MudSelectItem Value="string.Empty">Brak</MudSelectItem>
                        @foreach (string armor in SD.BasicArmors.All)
                        {
                            <MudSelectItem Value="@armor">@armor</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
            <MudPaper Class="py-2" Elevation="0">
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudNumericField Required="true" @bind-Value="@NewMob.MaxWounds" Label="Maksymalne rany" />
                    <MudNumericField @bind-Value="@NewMob.CurrentWounds" Label="Bieżące rany" />
                    <MudNumericField Required="true" Min="0" @bind-Value="@NewMob.Speed" Label="Szybkość (pola)" />
                </MudStack>

                <MudText>Bieżący stan: @NewMob.States</MudText>
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudButton OnClick="ClearStates">Wyczyść stany</MudButton>
                    <MudSelect Value="SelectedState" T="string" ValueChanged="AddState" Label="Dodaj stan" AnchorOrigin="Origin.BottomCenter">
                        @foreach (string state in States.Names.All)
                        {
                            <MudSelectItem Value="@state">@state</MudSelectItem>
                        }
                    </MudSelect>
                    <MudNumericField @bind-Value="@StateDuration" Label="Czas trwania" />
                </MudStack>
         
            </MudPaper>
            <MudStack Row="true" Justify="Justify.SpaceBetween">
                <MudSelect Value="@NewMob.Campaign" T="CampaignDTO" ValueChanged="SelectCampaign" Label="Wybierz kampanię" Placeholder="Wybierz kampanię" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var campaign in Campaigns)
                    {
                        <MudSelectItem Value="@campaign">@campaign.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect ReadOnly="IsCampaignSelected" Value="NewMob.Chapter" T="ChapterDTO" ValueChanged="SelectCharacter" Label="Wybierz rozdział" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var chapter in Chapters)
                    {
                        <MudSelectItem Value="@chapter">@chapter.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudStack>

        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Anuluj</MudButton>
        <MudButton Color="Color.Error" Disabled="@(!success)" OnClick="SaveMobBtn">@Title</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    [Parameter] public MobDTO NewMob { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; } = false;
    [Parameter] public int CampaignId { get; set; } = 0;
    [Parameter] public int ChapterId { get; set; } = 0;
    private string Title = "Utwórz";
    private string SelectedState = string.Empty;
    private IEnumerable<CampaignDTO> Campaigns { get; set; } = new List<CampaignDTO>();
    private IEnumerable<ChapterDTO> Chapters { get; set; } = new List<ChapterDTO>();
    private bool IsCampaignSelected = true;
    private string ChooseFile = "Wybierz plik";
    private int StateDuration = 1;
    private IList<IBrowserFile> files = new List<IBrowserFile>();
    private bool success;
    private void Cancel()
    {
        MudDialog.Cancel();
    }

    protected override async Task OnInitializedAsync()
    {
        if (IsEdit)
        {
            Title = "Edytuj";
        }
        else
        {
            Title = "Dodaj";
        }


        Campaigns = await _campaignRepository.GetAll();
        if (CampaignId > 0)
        {
            NewMob.Campaign = Campaigns.FirstOrDefault(c=>c.Id ==CampaignId) ;
            if(NewMob.Campaign is not null)
                NewMob.CampaignId = CampaignId;
        }
        if (ChapterId > 0)
        {
            NewMob.Chapter = await _chapterRepository.GetById(ChapterId);
            if (NewMob.Chapter is not null)
                NewMob.ChapterId = ChapterId;
        }
    }

    private async Task SaveMobBtn()
    {
        MobDTO updatedMob;

        if (IsEdit)
        {
             updatedMob = await _mobRepository.Update(NewMob);
            
        }else{
            updatedMob = await _mobRepository.Create(NewMob);
        }



        NewMob.Id = updatedMob.Id;

        MudDialog.Close(DialogResult.Ok(NewMob));
        if (IsEdit)
            Snackbar.Add("Zaktualizowano moba", Severity.Success);
        else 
            Snackbar.Add("Utworzono moba", Severity.Success);
    }

    private void UploadFiles(IBrowserFile file)
    {
        files.Add(file);
        //TODO upload the files to the server
    }

    private void AddState(string newStatus)
    {
        NewMob.States = CombatStateString.Add(NewMob.States, newStatus, StateDuration);
    }
    private void ClearStates()
    {
        NewMob.States = string.Empty;
    }

    private async Task SelectCampaign(CampaignDTO campaign)
    {
        Chapters = await _chapterRepository.GetAll(campaign.Id);
        if (campaign.Id > 0)
        {
            IsCampaignSelected = false;
            NewMob.Campaign = campaign;
            NewMob.CampaignId = campaign.Id;
        }
    }
    private void SelectCharacter(ChapterDTO chapter)
    {
        if (chapter.Id > 0)
        {
            NewMob.Chapter = chapter;
            NewMob.ChapterId = chapter.Id;
        }
    }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        try
        {
            if (e.GetMultipleFiles().Count > 0)
            {
                ChooseFile = string.Empty;
                foreach (var file in e.GetMultipleFiles())
                {
                    var parameters = new DialogParameters<CropperDialog> { { x => x.File, e.File } };
                    var dialog = await DialogService.ShowAsync<CropperDialog>("Przytnij portret", parameters, await SetOptions());
                    var result = await dialog.Result;

                    if (result?.Data is not null && !result.Canceled)
                    {
                        NewMob.ImageUrl = (string)result.Data;
                    }
                }
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Błąd przesyłania obrazu: " + ex.ToString(), Severity.Error);
        }
    }
    private async Task<DialogOptions> SetOptions(MaxWidth maxWidth = MaxWidth.Medium)
    {
        var __isFs = await _vieportService.GetCurrentBreakpointAsync() <= Breakpoint.Md;
        return new DialogOptions { MaxWidth = maxWidth, FullScreen = __isFs };
    }
    
}
