
@using System.Globalization;
@using System.Text;
@using DA_Models
@inject ISnackbar Snackbar
@inject IUserService _userService
@inject ISpecialSkillRepository _specialSkillRepository
@inject IDialogService DialogService
@inject IBrowserViewportService _viewportService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <img src="@MyIcon.Anvil" width="40" height="40" class="pr-2" />
            @HeaderName
        </MudText>
    </TitleContent>
    <DialogContent>
        <div class="main-table">
                <div class="wide-screen-table">
                    <div class="d-flex ">
                        <div class="d-flex flex-column flex-grow-1 pe-1">
                            <label class="fw-bold py-1">@L["Item name"]</label>
                        @if (IsInfoMode)
                        {
                            <MudTextField ReadOnly="true" Value="@NewSlot.Equipment.DisplayName(L)"></MudTextField>
                        }
                        else
                        {
                            <MudTextField Placeholder="@(L["Insert item name"])" @bind-Value="@NewSlot.Equipment.Name"></MudTextField>
                        }
                        </div>
                        <div class="d-flex flex-column px-1">
                            <label class="fw-bold py-1">@L["Weight [St]"]</label>
                        <MudNumericField ReadOnly="IsInfoMode" Min=0 T="decimal" Format="F4" HideSpinButtons="true" @bind-Value="@NewSlot.Equipment.Weight"></MudNumericField>
                        </div>
                        <div class="d-flex flex-column  px-1">
                            <label class="fw-bold py-1">@L["Price [Imp]"]</label>
                        <MudNumericField ReadOnly="IsInfoMode" Min=0 T="decimal" Format="F4" HideSpinButtons="true" @bind-Value="@NewSlot.Equipment.Price"></MudNumericField>
                        </div>
                        <div class="d-flex flex-column flex-grow-1 px-1">
                            <label class="fw-bold py-1">@L["Type"]</label>
                            <InputSelect disabled="@IsInfoMode" @bind-Value="NewSlot.Equipment.EquipmentType" class="form-select p-1">
                            @foreach (var eq in SD.EquipmentType.All)
                            {
                                        <option selected="@(eq==NewSlot.Equipment.EquipmentType)" value="@eq">@LocCatalog.Name(eq, L)</option>
                            }
                            </InputSelect>
                        </div>

                        @if (NewSlot.Equipment.EquipmentType == SD.EquipmentType.WeaponMelee)
                        {
                            <div class="d-flex flex-column flex-grow-1 px-1">
                                <label class="fw-bold py-1">@L["Weapon Type"]</label>
                                <InputSelect disabled="@IsInfoMode" @bind-Value="NewSlot.Equipment.RelatedSkill" class="form-select p-1">
                                    @foreach (var eq in MeleeSkills)
                                    {
                                    <option selected="@(eq.Name==NewSlot.Equipment.RelatedSkill)" value="@eq.Name">@LocCatalog.Name(eq.Name, L)</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="d-flex flex-column px-1">
                            <label class="fw-bold py-1">@L["Two-handed"]</label>
                                <div class="justify-content-center mx-auto my-auto">
                                <MudCheckBox T="bool" Disabled="IsInfoMode" @bind-Value="NewSlot.Equipment.IsTwoHanded"></MudCheckBox>
                                </div>
                            </div>
                        }
                        else if (NewSlot.Equipment.EquipmentType == SD.EquipmentType.WeaponRanged)
                        {
                            <div class="d-flex flex-column flex-grow-1 px-1">
                                <label class="fw-bold py-1">@L["Weapon Type"]</label>
                                <InputSelect disabled="@IsInfoMode" @bind-Value="NewSlot.Equipment.RelatedSkill" class="form-select p-1">
                                    @foreach (var eq in ShootingSkills)
                                    {
                                        <option selected="@(eq.Name==NewSlot.Equipment.RelatedSkill)" value="@eq.Name">@LocCatalog.Name(eq.Name, L)</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="d-flex flex-column px-1">
                            <label class="fw-bold py-1">@L["Two-handed"]</label>
                                <div class="justify-content-center mx-auto my-auto">
                                <MudCheckBox T="bool" Disabled="IsInfoMode" @bind-Value="NewSlot.Equipment.IsTwoHanded"></MudCheckBox>
                                </div>
                            </div>
                        }

                        @if (userInfo?.IsAdminOrMG == true && IsInfoMode == false)
                        {
                            <div class="d-flex flex-column px-1">
                                <label class="fw-bold py-1">@L["Approve"]</label>
                                <div class="justify-content-center mx-auto my-auto">
                                    <MudCheckBox T="bool" @bind-Value="NewSlot.Equipment.IsApproved"></MudCheckBox>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="short-screen-table">

                    <div class="d-flex ">
                        <div class="d-flex flex-column flex-grow-1 pe-1">
                            <label class="fw-bold py-1">@L["Item name"]</label>
                        @if (IsInfoMode)
                        {
                            <MudTextField ReadOnly="true" Value="@NewSlot.Equipment.DisplayName(L)"></MudTextField>
                        }
                        else
                        {
                            <MudTextField Placeholder="@(L["Insert item name"])" @bind-Value="@NewSlot.Equipment.Name"></MudTextField>
                        }
                        </div>
                    </div>
                    <div class="d-flex ">
                        <div class="d-flex flex-column px-1">
                            <label class="fw-bold py-1">@L["Weight [St]"]</label>
                        <MudNumericField ReadOnly="IsInfoMode" Min=0 T="decimal" Format="F1" HideSpinButtons="true" @bind-Value="@NewSlot.Equipment.Weight"></MudNumericField>
                        </div>
                        <div class="d-flex flex-column px-1">
                            <label class="fw-bold py-1">@L["Price [Imp]"]</label>
                        <MudNumericField ReadOnly="IsInfoMode" Min=0 T="decimal" Format="F4" HideSpinButtons="true" @bind-Value="@NewSlot.Equipment.Price"></MudNumericField>
                        </div>
                        <div class="d-flex flex-column flex-grow-1 px-1">
                            <label class="fw-bold py-1">@L["Type"]</label>
                            <InputSelect disabled="@IsInfoMode" @bind-Value="NewSlot.Equipment.EquipmentType" class="form-select p-1">
                                @foreach (var eq in SD.EquipmentType.All)
                                {
                                    <option selected="@(eq==NewSlot.Equipment.EquipmentType)" value="@eq">@LocCatalog.Name(eq, L)</option>
                                }
                            </InputSelect>
                        </div>
                        @if (NewSlot.Equipment.EquipmentType == SD.EquipmentType.WeaponMelee)
                        {
                            <div class="d-flex flex-column flex-grow-1 px-1">
                                <label class="fw-bold py-1">@L["Weapon Type"]</label>
                                <InputSelect disabled="@IsInfoMode" @bind-Value="NewSlot.Equipment.RelatedSkill" class="form-select p-1">
                                @foreach (string eq in SD.SpecialSkills.Melee.All)
                                {
                                    <option selected="@(eq==NewSlot.Equipment.RelatedSkill)" value="@eq">@LocCatalog.Name(eq, L)</option>
                                }
                                </InputSelect>
                            </div>
                            <div class="d-flex flex-column px-1">
                            <label class="fw-bold py-1">@L["Two-handed"]</label>
                                <div class="justify-content-center mx-auto my-auto">
                                <MudCheckBox T="bool" Disabled="IsInfoMode" @bind-Value="NewSlot.Equipment.IsTwoHanded"></MudCheckBox>
                                </div>
                            </div>
                        }
                        else if (NewSlot.Equipment.EquipmentType == SD.EquipmentType.WeaponRanged)
                        {
                            <div class="d-flex flex-column flex-grow-1 px-1">
                                <label class="fw-bold py-1">@L["Weapon Type"]</label>
                                <InputSelect disabled="@IsInfoMode" @bind-Value="NewSlot.Equipment.RelatedSkill" class="form-select p-1">
                                    @foreach (string eq in SD.SpecialSkills.Shooting.All)
                                    {
                                        <option selected="@(eq==NewSlot.Equipment.RelatedSkill)" value="@eq">@LocCatalog.Name(eq, L)</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="d-flex flex-column px-1">
                                <label class="fw-bold py-1">@L["Two-handed"]</label>
                                <div class="justify-content-center mx-auto my-auto">
                                <MudCheckBox T="bool" Disabled="IsInfoMode" @bind-Value="NewSlot.Equipment.IsTwoHanded"></MudCheckBox>
                                </div>
                            </div>
                        }
                        @if (userInfo?.IsAdminOrMG == true && IsInfoMode == false)
                        {
                            <div class="d-flex flex-column px-1">
                                <label class="fw-bold py-1">@L["Approve"]</label>
                                <div class="justify-content-center mx-auto my-auto">
                                    <MudCheckBox T="bool" Disabled="IsInfoMode" @bind-Value="NewSlot.Equipment.IsApproved"></MudCheckBox>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="d-flex flex-column flex-grow-1">
                    <label class="fw-bold  p-1">@L["Item description"]</label>
                    @if (IsInfoMode)
                    {
                        <MudTextField ReadOnly="true" Class="" Variant="Variant.Outlined" Typo="Typo.body2" Value="@NewSlot.Equipment.DisplayDescription(L)" Lines="12"></MudTextField>
                    }
                    else
                    {
                        <MudTextField Class="" Variant="Variant.Outlined" Typo="Typo.body2" @bind-Value="@NewSlot.Equipment.Description" Lines="12"></MudTextField>
                    }
       
                </div>

                <label class="fw-bold pt-4">@L["Item traits"]</label>
                @if (NewSlot.Equipment.Traits != null)
                {
                    <div class="traits">
                        <CascadingValue Value="@AllParams">
                            <TraitsComponent IsInfoMode="IsInfoMode" @bind-Traits="@Traits" TraitType="@TraitType" WeaponQualityAvalible="@WeaponQualityAvalible()" ShowFromTemplate="@(!IsEditMode && !IsInfoMode)" OnFromTemplate="FromTemplateAsync"></TraitsComponent>
                        </CascadingValue>
                    </div>
                }
                <label class="warnign-message">@ErrorMessage</label>
        </div>
    </DialogContent>
    <DialogActions>
        @if (IsInfoMode == false)
         {
            <MudButton OnClick="OnCancelBtnClick">@L["Cancel"]</MudButton>
            <MudButton Color="Color.Error" OnClick="OnSaveBtnClick">@L["Save"]</MudButton>
        }
        else
        {
            <MudButton Color="Color.Error" OnClick="OnCancelBtnClick">OK</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    [Parameter] public EquipmentSlotDTO NewSlot { get; set; }
    [Parameter] public bool IsEditMode { get; set; } = false;
    [Parameter] public bool IsInfoMode { get; set; } = false;
    [Parameter] public bool IsWeaponQualityMode { get; set; } = false;
    [Parameter] public AllParamsModel AllParams { get; set; }
    public string TraitType { get; set; } = SD.TraitType_Gear;
    public string HeaderName { get; set; } = "";
    private string ErrorMessage { get; set; } = string.Empty;
    private IEnumerable<SpecialSkillDTO> MeleeSkills = new List<SpecialSkillDTO>();
    private IEnumerable<SpecialSkillDTO> ShootingSkills = new List<SpecialSkillDTO>();
    // NumberFormatInfo nfi = new NumberFormatInfo()
    //     {
    //         CurrencyGroupSeparator = ":"
    //     };
    // String.Format(nfi, "{0:0},-", 2295) //will result in 2:295,-

    public ICollection<TraitDTO>? Traits { get; set; } = new List<TraitDTO>();

    public UserInfo? userInfo { get; set; }


    private bool WeaponQualityAvalible()
    {
        return (NewSlot.Equipment.EquipmentType == SD.EquipmentType.WeaponRanged ||
            NewSlot.Equipment.EquipmentType == SD.EquipmentType.WeaponMelee ||
            NewSlot.Equipment.EquipmentType == SD.EquipmentType.Shield ||
            NewSlot.Equipment.EquipmentType == SD.EquipmentType.Body);
    }

    private async Task OnSaveBtnClick()
    {
        try{

            if (string.IsNullOrEmpty(NewSlot.Equipment.Name) || string.IsNullOrEmpty(NewSlot.Equipment.Description))
            {
                ErrorMessage = $"Create name and item description";
                return;
            }
            if ((NewSlot.Equipment.EquipmentType == SD.EquipmentType.WeaponRanged ||
                NewSlot.Equipment.EquipmentType == SD.EquipmentType.WeaponMelee ) && 
                string.IsNullOrEmpty(NewSlot.Equipment.RelatedSkill))
            {
                ErrorMessage = $"Set related skill of item";
                return;
            }
            if (NewSlot.Equipment != null)
            {
                NewSlot.Equipment.Traits = new List<TraitEquipmentDTO>();
                foreach (var trait in Traits)
                {
                    NewSlot.Equipment.Traits.Add(new TraitEquipmentDTO(trait, NewSlot.Equipment));
                }
                var shortDescr = NewSlot.Equipment.Description; 
                if (shortDescr.Length > 100)
                    shortDescr = shortDescr?[0..100] + "...";
                NewSlot.Equipment.ShortDescr = shortDescr;

                if (NewSlot.Equipment.EquipmentType == SD.EquipmentType.Shield)
                    NewSlot.Equipment.RelatedSkill = SD.SpecialSkills.Melee.Shields;
                if (NewSlot.Equipment.EquipmentType == SD.EquipmentType.Body)
                    NewSlot.Equipment.RelatedSkill = SD.SpecialSkills.Athletics.Armor;
            }
            ErrorMessage = string.Empty;

            MudDialog.Close(DialogResult.Ok(NewSlot));
            string info = "Item ";
            info += IsEditMode ? "edited" : "added";
            Snackbar.Add(info, Severity.Success);
        }catch(Exception ex)
        {
            Snackbar.Add(L["Error adding trait: "] + ex.Message, Severity.Error);
        }
    }
    private void OnCancelBtnClick()
    {
        MudDialog.Close(DialogResult.Cancel());
    }

    private bool HasUnsavedChanges()
    {
        var eq = NewSlot.Equipment;
        if (!string.IsNullOrWhiteSpace(eq.Name)) return true;
        if (!string.IsNullOrWhiteSpace(eq.Description)) return true;
        if (eq.Weight != 0) return true;
        if (eq.Price != 0) return true;
        if (eq.IsTwoHanded) return true;
        if (!string.IsNullOrWhiteSpace(eq.RelatedSkill)) return true;
        if (eq.EquipmentType != SD.EquipmentType.Other) return true;
        if (Traits != null && Traits.Any()) return true;
        return false;
    }

    private async Task FromTemplateAsync()
    {
        if (HasUnsavedChanges())
        {
            bool? confirmed = await DialogService.ShowMessageBoxAsync(
                "Warning",
                "Current changes will be overwritten. Do you want to continue?",
                yesText: "Yes",
                cancelText: "No");
            if (confirmed != true)
                return;
        }

        var isFullScreen = await _viewportService.GetCurrentBreakpointAsync() <= Breakpoint.Md;
        var dialog = await DialogService.ShowAsync<EquipmentTemplateSelectDialog>(
            "Select template",
            new DialogOptions { MaxWidth = MaxWidth.Large, FullScreen = isFullScreen });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not EquipmentDTO template)
            return;

        ApplyTemplate(template);
        ErrorMessage = string.Empty;
        StateHasChanged();
    }

    private void ApplyTemplate(EquipmentDTO template)
    {
        NewSlot.Equipment = CloneEquipmentAsCustom(template);
        Traits = NewSlot.Equipment.Traits?.Cast<TraitDTO>().ToList() ?? new List<TraitDTO>();
    }

    private static EquipmentDTO CloneEquipmentAsCustom(EquipmentDTO source)
    {
        var equipment = new EquipmentDTO
        {
            Id = 0,
            Name = $"custom {source.Name.ToLowerInvariant()}",
            Description = source.Description,
            ShortDescr = source.ShortDescr,
            Price = source.Price,
            Weight = source.Weight,
            IsApproved = false,
            EquipmentType = source.EquipmentType,
            RelatedSkill = source.RelatedSkill,
            IsTwoHanded = source.IsTwoHanded,
            Traits = new List<TraitEquipmentDTO>()
        };

        if (source.Traits is null)
            return equipment;

        foreach (var trait in source.Traits)
        {
            equipment.Traits.Add(new TraitEquipmentDTO
            {
                Id = 0,
                Name = trait.Name,
                Descr = trait.Descr,
                TraitType = trait.TraitType,
                TraitApproved = false,
                IsRemovable = true,
                Bonuses = trait.Bonuses?.Select(b => new BonusDTO(b)).ToList() ?? new List<BonusDTO>()
            });
        }

        return equipment;
    }

    protected override async Task OnInitializedAsync()
    {
        ErrorMessage = string.Empty;
        if (NewSlot.Equipment.Traits is not null && NewSlot.Equipment.Traits.Any())
        {
            Traits = NewSlot.Equipment.Traits.Cast<TraitDTO>().ToList();
        }
        userInfo = await _userService.GetUserInfo();


        if(userInfo?.SelectedCharacter is not null && userInfo.SelectedCharacter.Id != 0)
        {

            MeleeSkills = await (_specialSkillRepository.GetAllFromGroup(userInfo.SelectedCharacter.Id , SD.BaseSkills.Melee));
            ShootingSkills = await (_specialSkillRepository.GetAllFromGroup(userInfo.SelectedCharacter.Id, SD.BaseSkills.Shooting));
        }
        else
        {
            MeleeSkills = CharacterSeeder.GetSpecialSkills().Where(u => u.RelatedBaseSkillName == SD.BaseSkills.Melee);
            ShootingSkills = CharacterSeeder.GetSpecialSkills().Where(u => u.RelatedBaseSkillName == SD.BaseSkills.Shooting);
        }
        HeaderName = IsEditMode ? "Edit" : "Add";
        HeaderName += " item";
        if (NewSlot.Equipment is not null && NewSlot.Equipment.IsApproved)
            HeaderName = "Item info";
        MudDialog.StateHasChanged();
    }

}
