
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            Wybierz bonus do atrybutu i umiejętności człowieka
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudSelect @bind-Value="HumanRaceBonuses.AttributeNameBonus" Margin="Margin.Dense" T="string" Label="Atrybut" Variant="Variant.Filled">
            @foreach (var attr in SD.Attributes.All)
            {
                <MudSelectItem Value="@(attr)" />
            }
        </MudSelect>
        <MudSelect @bind-Value="HumanRaceBonuses.FirstSkillNameBonus" Margin="Margin.Dense" T="string" Label="Umiejętność bazowa 1" Variant="Variant.Filled">
            @foreach (var bs in SD.BaseSkills.All)
            {
                <MudSelectItem Value="@(bs)" />
            }
        </MudSelect>
        <MudSelect @bind-Value="HumanRaceBonuses.SecondSkillNameBonus" Margin="Margin.Dense" T="string" Label="Umiejętność bazowa 2" Variant="Variant.Filled">
            @foreach (var bs in SD.BaseSkills.All)
            {
                <MudSelectItem Value="@(bs)" />
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Anuluj</MudButton>
        <MudButton Color="Color.Error" OnClick="ChooseBonuses">Wybierz</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    [Parameter] public HumanRaceModel HumanRaceBonuses { get; set; }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    protected override async Task OnInitializedAsync()
    {
        HumanRaceBonuses = new();

    }

    private void ChooseBonuses()
    {
        if (string.IsNullOrEmpty(HumanRaceBonuses.AttributeNameBonus))
        {
            Snackbar.Add("Wybierz bonus do atrybutu", Severity.Warning);
            return;
        }
        if (string.IsNullOrEmpty(HumanRaceBonuses.FirstSkillNameBonus))
        {
            Snackbar.Add("Wybierz bonus do pierwszej umiejętności", Severity.Warning);
            return;
        }
        if (string.IsNullOrEmpty(HumanRaceBonuses.SecondSkillNameBonus))
        {
            Snackbar.Add("Wybierz bonus do drugiej umiejętności", Severity.Warning);
            return;
        }
        if (HumanRaceBonuses.SecondSkillNameBonus == HumanRaceBonuses.FirstSkillNameBonus)
        {
            Snackbar.Add("Bonusy do umiejętności bazowych nie mogą być takie same", Severity.Warning);
            return;
        }
        MudDialog.Close(DialogResult.Ok(HumanRaceBonuses));

        Snackbar.Add("Bonusy dodane", Severity.Success);
    }
}
