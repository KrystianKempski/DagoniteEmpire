    protected override async Task OnInitializedAsync()
    {
        try
        {
            UserInfo = await _userService.GetUserInfo();
            _wikiDeployed = _wikiLinkService.IsWikiDeployed();
            await InitializeSignalR();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error in OnInitializedAsync");
            IsLoading = false;
            StateHasChanged();
        }

        handler = async () => await LoadForSelectedCharacter();
        _callbackService.OnChange += handler;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedChapterId == Id && !GoToLastPage)
            return;

        if (_loadedChapterId == Id && GoToLastPage)
        {
            await LoadLastPage();
            return;
        }

        _loadedChapterId = Id;
        await LoadChapter();
    }

    private async Task InitializeSignalR()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(_navigationManager.ToAbsoluteUri(ChatHub.HubUrl))
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<int, int>("NewPost", OnNewPost);
            _hubConnection.On<int, int>("PostUpdated", OnPostUpdated);
            _hubConnection.On<int, int>("PostDeleted", OnPostDeleted);

            if (_hubConnection.State == HubConnectionState.Disconnected)
                await _hubConnection.StartAsync();
            Logger.LogInformation("SignalR connection established for chapter {ChapterId}", Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing SignalR connection");
        }
    }

    private async Task OnNewPost(int chapterId, int postId)
    {
        if (chapterId != Id) return;

        await InvokeAsync(async () =>
        {
            if (Posts.Any(p => p.Id == postId))
                return;

            await AppendPostByIdAsync(postId, forceScrollDown: false);
            StateHasChanged();
            SnackBar.Add(L["New post added!"], Severity.Info);
        });
    }

    private async Task OnPostUpdated(int chapterId, int postId)
    {
        if (chapterId != Id) return;

        await InvokeAsync(async () =>
        {
            var updated = await _postRepository.GetById(postId);
            if (updated.Id != postId)
                return;

            var index = Posts.FindIndex(p => p.Id == postId);
            if (index >= 0)
            {
                Posts[index] = updated;
                StateHasChanged();
            }
        });
    }

    private async Task OnPostDeleted(int chapterId, int postId)
    {
        if (chapterId != Id) return;

        await InvokeAsync(() =>
        {
            Posts.RemoveAll(p => p.Id == postId);
            StateHasChanged();
            SnackBar.Add(L["A post was deleted."], Severity.Info);
        });
    }

    private async Task LoadInitialPostsAsync()
    {
        var totalPages = await GetPageCount();
        _oldestLoadedPage = totalPages;
        Posts = (await _postRepository.GetPage(Id, PostsPerPage, _oldestLoadedPage)).ToList();
        _hasMoreOlder = _oldestLoadedPage > 1;
        _showBackToEnd = false;
        _scrollDown = true;
    }

    [JSInvokable]
    public async Task LoadOlderPostsAsync()
    {
        // Ignore observer hits until the initial scroll-to-bottom has settled,
        // otherwise we prepend older pages while still scrolling and the view
        // jumps to the middle.
        if (!_initialScrolled || _loadingOlder || !_hasMoreOlder)
            return;

        _loadingOlder = true;
        try
        {
            _pendingRestoreHeight = await _jsRuntime.InvokeAsync<double>("PostsLazyLoad.getScrollHeight");

            var nextPage = _oldestLoadedPage - 1;
            var older = (await _postRepository.GetPage(Id, PostsPerPage, nextPage)).ToList();
            _oldestLoadedPage = nextPage;
            _hasMoreOlder = _oldestLoadedPage > 1;

            if (older.Count > 0)
                Posts.InsertRange(0, older);

            // _loadingOlder is cleared in OnAfterRenderAsync after scroll is restored.
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load older posts");
            _pendingRestoreHeight = null;
            _loadingOlder = false;
        }
    }

    [JSInvokable]
    public void SetShowBackToEnd(bool show)
    {
        if (_showBackToEnd == show)
            return;

        _showBackToEnd = show;
        StateHasChanged();
    }

    private async Task ScrollToLatest()
    {
        try
        {
            await _jsRuntime.InvokeVoidAsync("PostsLazyLoad.scrollToBottom", true);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to scroll to latest posts");
        }

        _showBackToEnd = false;
    }

    // Appends a newly created post (own or via SignalR) to the end without
    // discarding the already-loaded older posts.
    private async Task AppendPostByIdAsync(int postId, bool forceScrollDown)
    {
        if (Posts.Any(p => p.Id == postId))
            return;

        var post = await _postRepository.GetById(postId);
        if (post is null || post.Id != postId)
            return;

        Posts.Add(post);

        if (forceScrollDown || !_showBackToEnd)
            _scrollDown = true;
    }

    private async Task EnsureLazyLoadInitializedAsync()
    {
        if (_lazyLoadInitialized || IsLoading || Chapter is null)
            return;

        _dotNetRef ??= DotNetObjectReference.Create(this);
        try
        {
            await _jsRuntime.InvokeVoidAsync("PostsLazyLoad.init", _dotNetRef, PostsTopSentinelId, PostDockId, 800);
            _lazyLoadInitialized = true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to initialize PostsLazyLoad");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_afterRenderInProgress) return;
        _afterRenderInProgress = true;

        try
        {
            if (firstRender)
            {
                var bp = await _viewportService.GetCurrentBreakpointAsync();
                _showDrawerPanelLayout = bp <= Breakpoint.Lg;
                _isNarrowViewport = bp <= Breakpoint.Md;
                StateHasChanged();
            }

            if (_pendingRestoreHeight is not null)
            {
                var prevHeight = _pendingRestoreHeight.Value;
                _pendingRestoreHeight = null;
                try
                {
                    await _jsRuntime.InvokeVoidAsync("PostsLazyLoad.restoreScroll", prevHeight);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to restore scroll after loading older posts");
                }
                _loadingOlder = false;
            }

            if (_scrollDown && !IsLoading)
            {
                _scrollDown = false;
                await Task.Delay(200);
                // Snap to the bottom reliably. On initial load use the "settled"
                // variant so late layout shifts (images, Quill HTML) still land us
                // on the last post; afterwards a single instant scroll is enough.
                if (!_initialScrolled)
                    await _jsRuntime.InvokeVoidAsync("PostsLazyLoad.scrollToBottomSettled");
                else
                    await _jsRuntime.InvokeVoidAsync("PostsLazyLoad.scrollToBottom", false);
                _initialScrolled = true;
            }

            if (_shouldLoadPostEditor)
                await TryLoadPendingPostEditorAsync();

            await SyncOutsideCollapseListenerAsync();

            await EnsureLazyLoadInitializedAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error in OnAfterRenderAsync");
            _scrollDown = false;
        }
        finally
        {
            _afterRenderInProgress = false;
        }
    }

    private async Task LoadForSelectedCharacter()
    {
        try
        {
            UserInfo = await _userService.GetUserInfo();
            if (UserInfo is null) return;
            
            if (UserInfo.SelectedCharacter is null)
            {
                SendPostEnabled = false;
                return;
            }

            int charId = (int)UserInfo.SelectedCharacter.Id;
            if (charId == 0)
            {
                SendPostEnabled = false;
                return;
            }

            if (Chapter?.Characters.FirstOrDefault(c => c.Id == charId) is null
               && UserInfo?.CharacterMG != true
               && UserInfo?.IsAdminOrMG != true)
            {
                SendPostEnabled = false;
            }
            else
            {
                SendPostEnabled = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error in LoadForSelectedCharacter");
            SnackBar.Add(L["Error: "] + ex.Message, Severity.Error);
        }
    }

    private async Task LoadChapter(bool goToLastPage = false)
    {
        try
        {
            IsLoading = true;
            IsLoadingCharacters = true;
            StateHasChanged();

            Chapter = await _chapterRepository.GetById(Id);

            if (Chapter is not null)
            {
                await RefreshBaronCampaignFlagAsync();

                // Load posts (chat-style: newest page first, older loaded lazily)
                await LoadInitialPostsAsync();
                if (GoToLastPage)
                    ClearLastPageQuery();

                // Load characters with AllParams
                CharacterAllParams.Clear();
                if (ApprovedRacesCache.Count == 0)
                {
                    ApprovedRacesCache = (await _raceRepository.GetAllApproved()).ToList();
                }
                
                foreach (var charac in Chapter.Characters)
                {
                    CharacterAllParams[charac.Id] = await LoadCharacter(charac.Id);
                }

                // Load mobs
                await LoadMobs();

                // Load battle phase
                BattlePhase = await _battlePhaseRepository.GetCurrentForChapter(Id);
                if (BattlePhase is not null)
                {
                    OngoingBattle = BattlePhase.BattleOngoing;
                }

                // Load for selected character
                await LoadForSelectedCharacter();

                _items = new List<BreadcrumbItem>
                {
                    new BreadcrumbItem("Campaigns", href: $"/campaignlist/"),
                    new BreadcrumbItem("Chapters", href: $"/campaign/{Chapter.CampaignId}"),
                    new BreadcrumbItem("Posts", href: $"/chapter/{Id}"),
                };
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading chapter {ChapterId}", Id);
            SnackBar.Add(L["Error loading chapter: "] + ex.Message, Severity.Error);
        }
        finally
        {
            IsLoading = false;
            IsLoadingCharacters = false;
            _scrollDown = true;
            StateHasChanged();
        }
    }

    private async Task<AllParamsModel> LoadCharacter(int id)
    {
        AllParamsModel allParams = new();
        var characterTask = _characterRepository.GetById(id);
        var attributesTask = _attributeRepository.GetAll(id);
        var baseSkillsTask = _baseSkillRepository.GetAll(id);
        var specialSkillsTask = _specialSkillRepository.GetAll(id);
        var traitCharactersTask = _traitCharacterRepository.GetAll(id);
        var equipmentSlotsTask = _equipmentSlotRepository.GetAll(id);
        var woundsTask = _woundRepository.GetAll(id);
        var condsTask = _woundRepository.GetAllCond(id);
        var postCountTask = _postRepository.GetCharacterPostCount(id);
        var lastPostDateTask = _postRepository.GetCharacterLastPostDate(id);

        await Task.WhenAll(
            characterTask,
            attributesTask,
            baseSkillsTask,
            specialSkillsTask,
            traitCharactersTask,
            equipmentSlotsTask,
            woundsTask,
            condsTask,
            postCountTask,
            lastPostDateTask);

        allParams.Character = await characterTask;
        allParams.Attributes.FillPropertiesContainer(await attributesTask);
        allParams.BaseSkills = await baseSkillsTask;
        allParams.SpecialSkills.FillPropertiesContainer(await specialSkillsTask);

        var characterTraits = (await traitCharactersTask).ToList();
        allParams.TraitsCharacter = characterTraits.Where(u => u.IsTemporary == false).Cast<TraitDTO>().ToList();
        allParams.TraitsTemporary = characterTraits.Where(u => u.IsTemporary == true).Cast<TraitDTO>().ToList();

        var raceTask = _raceRepository.GetById(allParams.Character.RaceId);
        var professionTask = _professionRepository.GetById(allParams.Character.ProfessionId);
        var professionTraitsTask = _traitProfessionRepository.GetAll(allParams.Character.Id);

        await Task.WhenAll(raceTask, professionTask, professionTraitsTask);

        allParams.CurrentRace = await raceTask;
        allParams.Profession = await professionTask;
        allParams.Profession.Traits = (await professionTraitsTask).ToList();
        allParams.EquipmentSlots = (await equipmentSlotsTask).ToList();
        allParams.Races = ApprovedRacesCache.ToList();

        allParams.SpecialSkills.AddRelatedParametes();
        await BaronReputationCharacterOverlay.ApplyAsync(allParams, _baronyRepo, id);
        allParams.AllTraitsChange();
        allParams.Profession.CalculateClassParams(allParams.Attributes.GetAll());
        ICollection<WoundDTO> wounds = (await woundsTask).ToList();
        ICollection<WoundDTO> conds = (await condsTask).Cast<WoundDTO>().ToList();
        wounds = wounds.Concat(conds).ToList();
        allParams.Health.FillPropertiesContainer(wounds);
        allParams.Health.UpdateHealthBonusesInAttributes();

        allParams.Character.NumberOfPosts = await postCountTask;
        allParams.Character.LastPostDate = await lastPostDateTask;
        return allParams;
    }

    private async Task CreatePost()
    {
        try
        {
            if (PostEditor is not null)
            {
                NewPost.Content = await PostEditor.GetHTML();
            }

            if (string.IsNullOrEmpty(NewPost.Content))
                return;

            IsLoading = true;
            StateHasChanged();
            var createdNewPost = false;
            int? _createdPostId = null;

            if (IsEditMode)
            {
                var result = await _postRepository.Update(NewPost);
                if (result is not null)
                {
                    var index = Posts.FindIndex(p => p.Id == NewPost.Id);
                    if (index >= 0)
                        Posts[index].Content = NewPost.Content;
                    
                    // Notify other clients about the updated post
                    if (_hubConnection is not null)
                    {
                        await _hubConnection.SendAsync("NotifyPostUpdated", Id, NewPost.Id);
                    }
                }
                IsEditMode = false;
                SendButtonText = "Send Post";
            }
            else
            {
                NewPost.ChapterId = Id;
                NewPost.CreatedDate = DateTime.Now;
                
                if (UserInfo?.SelectedCharacter is not null)
                {
                    NewPost.CharacterId = (int)UserInfo.SelectedCharacter.Id;
                    NewPost.Character = UserInfo.SelectedCharacter;
                    if (string.IsNullOrEmpty(GmAsMob.Name) == false)
                    {
                        NewPost.AlternativeName = GmAsMob.Name;
                        NewPost.AlternativeImageUrl = GmAsMob.ImageUrl;
                    }
                }

                var result = await _postRepository.Create(NewPost);
                if (result is not null)
                {
                    createdNewPost = true;
                    _createdPostId = result.Id;
                    if (_hubConnection is not null)
                        await _hubConnection.SendAsync("NotifyNewPost", Id, result.Id);

                    _ = Task.Run(async () =>
                    {
                        try
                        {
                            await _scribeService.IngestPostAsync(result.Id);
                        }
                        catch (Exception ex)
                        {
                            Logger.LogWarning(ex, "Failed to index post {PostId} in SCRIBE", result.Id);
                        }
                    });
                }
            }

            NewPost = new();
            _editorExpanded = false;
            _editorFullScreen = false;
            if (PostEditor is not null)
                await PostEditor.LoadHTMLContent(string.Empty);

            if (createdNewPost && _createdPostId is not null)
                await AppendPostByIdAsync(_createdPostId.Value, forceScrollDown: true);

            IsLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating post");
            SnackBar.Add(L["Error creating post: "] + ex.Message, Severity.Error);
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task EditPost(PostDTO post)
