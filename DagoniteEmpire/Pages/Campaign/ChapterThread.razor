    private async Task LoadMobs()
    {
        try
        {
            Mobs = (await _mobRepository.GetAllForChapter(Id)).ToList();
            foreach (var mob in Mobs)
            {
                mob.BattleProperties = new(mob);
                if (string.IsNullOrEmpty(mob.MainWeaponName) == false)
                {
                    mob.MainWeapon = await _equipmentRepository.GetByName(mob.MainWeaponName);
                }
                if (string.IsNullOrEmpty(mob.OffWeaponName) == false)
                {
                    mob.OffWeapon = await _equipmentRepository.GetByName(mob.OffWeaponName);
                }
                if (string.IsNullOrEmpty(mob.ShieldWeaponName) == false)
                {
                    mob.ShieldWeapon = await _equipmentRepository.GetByName(mob.ShieldWeaponName);
                }
                if (string.IsNullOrEmpty(mob.ArmorName) == false)
                {
                    mob.Armor = await _equipmentRepository.GetByName(mob.ArmorName);
                }
                mob.BattleProperties.CalculateBattleStats();
            }
        }
        catch (Exception ex)
        {
            SnackBar.Add(L["Error while loading mobs: "] + ex.Message, Severity.Error);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _callbackService.OnChange -= handler;

        if (_outsideCollapseRegistered)
        {
            try
            {
                await _jsRuntime.InvokeVoidAsync("QuillPostEditor.disableOutsideClickCollapse", PostDockId);
            }
            catch
            {
                // Ignore – circuit may already be gone during disposal.
            }
            _outsideCollapseRegistered = false;
        }

        if (_lazyLoadInitialized)
        {
            try
            {
                await _jsRuntime.InvokeVoidAsync("PostsLazyLoad.dispose");
            }
            catch
            {
                // Ignore – circuit may already be gone during disposal.
            }
            _lazyLoadInitialized = false;
        }

        _dotNetRef?.Dispose();
        _dotNetRef = null;

        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    // Battle and Dialog Methods
    private async Task SwichBattlePhase()
    {
        if (OngoingBattle)
            await EndBattlePhase();
        else
            await StartBattlePhase();
    }

    private async Task StartBattlePhase()
    {
        if (Chapter is null) return;

        var parameters = new DialogParameters<StartBattleDialog>
        {
            { x => x.CharacterAllParams, CharacterAllParams.Values },
            { x => x.Mobs, Mobs },
        };

        var dialog = await DialogService.ShowAsync<StartBattleDialog>(
            L["Start battle"],
            parameters,
            await SetDialogOptions(MaxWidth.Small));
        var result = await dialog.Result;

        if (result is null || result.Canceled)
            return;

        if (result.Data is not IReadOnlyList<BattleParticipantSnapshot> participants || participants.Count == 0)
        {
            SnackBar.Add(L["Select at least one character."], Severity.Warning);
            return;
        }

        BattlePhase = new(Chapter.CampaignId, Id);
        OngoingBattle = true;
        if (BattlePhase is not null)
            BattlePhase = await _battlePhaseRepository.Update(BattlePhase);
        else
            return;

        await PostBattleStartSummaryAsync(participants);
        SnackBar.Add(L["Battle started!"], Severity.Error);
    }

