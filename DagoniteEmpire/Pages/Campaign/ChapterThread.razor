                await PersistFightAsync(fightResult.Persistence);

            _open = false;
            await RefreshBattleParticipantsAsync();
            await AppendRollToPostEditorAsync(fightResult.RichHtml, fightResult.WrapForThread, fightFormat: true);

            if (!string.IsNullOrEmpty(fightResult.AttackerName))
                SnackBar.Add($"Fight sequence performed. {fightResult.AttackerName} attacks {fightResult.DefenderName}", Severity.Success);

            if (UserInfo?.CharacterMG != true)
