@page "/chapter/{id:int}"
@using DA_Business.Services.Interfaces
@inject NavigationManager _navigationManager
@inject ISnackbar SnackBar
@inject IDialogService DialogService
@inject IJSRuntime _jsRuntime
@inject ICharacterRepository _characterRepository
@inject IMobRepository _mobRepository
@inject IChapterRepository _chapterRepository
@inject IAttributeRepository _attributeRepository
@inject IBaseSkillRepository _baseSkillRepository
@inject ISpecialSkillRepository _specialSkillRepository
@inject ITraitRepository<TraitCharacterDTO> _traitCharacterRepository
@inject ITraitRepository<TraitRaceDTO> _traitRaceRepository
@inject ITraitRepository<TraitEquipmentDTO> _traitEquipmentRepository
@inject ITraitRepository<TraitProfessionDTO> _traitProfessionRepository
@inject IWoundRepository _woundRepository
@inject IBattlePhaseRepository _battlePhaseRepository
@inject IEquipmentRepository _equipmentRepository
@inject IRaceRepository _raceRepository
@inject IProfessionRepository _professionRepository
@inject IEquipmentSlotRepository _equipmentSlotRepository
@inject IPostRepository _postRepository
@inject IUserService _userService
@inject ICampaignRepository _campaignRepository
@inject IBrowserViewportService _vieportService
@inject CallbackService _callbackService
@inject ILogger<ChapterThread> Logger
@implements IDisposable

@using BreadcrumbItem = MudBlazor.BreadcrumbItem;
<PageTitle>Dagonie Empire | Thread</PageTitle>
@if (IsLoading == true)
{
    <LoadingPage></LoadingPage>
    @if (string.IsNullOrWhiteSpace(CurrentDebugStep) == false)
    {
        <MudText Align="Align.Center" Class="mt-4">@CurrentDebugStep</MudText>
    }
}
else
{
    <MudHidden Breakpoint="Breakpoint.LgAndDown" Invert="true">
        @*  <MudHidden Hidden="@(_open == true)"> *@
        <MudButton Style="p-2" OnClick="ToggleDrawer" Variant="Variant.Text" DropShadow="true">
            <img src="@MyIcon.Helm" width="30" height="30" class="helm-icon" />
        </MudButton>            
        @*  </MudHidden> *@

        <MudDrawer Width="320px"  @bind-Open="@_open" Elevation="1" Variant="DrawerVariant.Temporary" ClipMode="DrawerClipMode.Always">
            <div class="px-1 py-2">
                @if (UserInfo?.IsAdminOrMG == true)
                {
                    <MudGrid Justify="Justify.Center" Spacing="1">
                        <MudItem xs="8"><MudButton FullWidth Variant="Variant.Filled" Color="Color.Error" OnClick="SwichBattlePhase">@BattleButton</MudButton></MudItem>
                        @if (OngoingBattle)
                        {
                            <MudItem xs="12"><MudText Align="Align.Center">Turn: @BattlePhase.CurrentTurn</MudText></MudItem>
                            <MudItem xs="6"><MudButton FullWidth OnClick="GenerateFightSequence">Generate fight</MudButton></MudItem>
                            <MudItem xs="6"><MudButton FullWidth OnClick="NextTurn">Next turn</MudButton></MudItem>
                            <MudItem xs="6"><MudButton FullWidth OnClick="EndBattlePhase">End Battle</MudButton></MudItem>
                        }
                        <MudItem xs="6"><MudButton FullWidth OnClick="AddExistingMob">Existing mobs</MudButton></MudItem>
                        <MudItem xs="6"><MudButton FullWidth OnClick="MakeSkillRoll">Make a roll</MudButton></MudItem>
                        <MudItem xs="6"><MudButton FullWidth OnClick="AddTemporaryStatus">Add status</MudButton></MudItem>
                    </MudGrid>
                }
                @if (IsLoadingCharacters == false)
                {
                    <MudPaper MinWidth="300px" Elevation="1" >
                        <MudStack Spacing="2">
                            @foreach (var charac in Chapter.Characters)
                            {
                                <PanelCharacterComponent AllParams="CharacterAllParams[charac.Id]" Id="charac.Id"></PanelCharacterComponent>
                            }
                            @foreach (var mob in Mobs)
                            {
                                <PanelCharacterComponent Mob="mob" Id="mob.Id" IsMob="true"></PanelCharacterComponent>
                            }
                        </MudStack>
                    </MudPaper>
                }
                else
                {
                    <LoadingPage></LoadingPage>
                }
            </div>
        </MudDrawer>

    </MudHidden>


    <div id="mam" class="margin-side container-lg" >

        <MudHidden Breakpoint="Breakpoint.XlAndUp" Invert="true">
            <div class="character-panel">
                @if (UserInfo?.IsAdminOrMG == true)
                {
                    <MudGrid Justify="Justify.Center" Spacing="1">
                        <MudItem xs="8"><MudButton FullWidth Variant="Variant.Filled" Color="Color.Error" OnClick="SwichBattlePhase">@BattleButton</MudButton></MudItem>
                        @if (OngoingBattle)
                        {
                            <MudItem xs="12"><MudText Align="Align.Center">Turn: @BattlePhase.CurrentTurn</MudText></MudItem>
                            <MudItem xs="6"><MudButton FullWidth OnClick="GenerateFightSequence">Generate fight</MudButton></MudItem>
                            <MudItem xs="6"><MudButton FullWidth OnClick="NextTurn">Next turn</MudButton></MudItem>
                            <MudItem xs="6"><MudButton FullWidth OnClick="EndBattlePhase">End Battle</MudButton></MudItem>
                        }
                        <MudItem xs="6"><MudButton FullWidth OnClick="AddExistingMob">Existing mobs</MudButton></MudItem>
                        <MudItem xs="6"><MudButton FullWidth OnClick="MakeSkillRoll">Make a roll</MudButton></MudItem>
                    </MudGrid>
                }
                @if (IsLoadingCharacters == false)
                {
                    <MudPaper Elevation="1">
                        <MudStack Spacing="2">
                            @foreach (var charac in Chapter.Characters)
                            {
                                <PanelCharacterComponent AllParams="CharacterAllParams[charac.Id]" Id="charac.Id"></PanelCharacterComponent>
                            }
                            @foreach (var mob in Mobs)
                            {
                                <PanelCharacterComponent Mob="mob" Id="mob.Id" IsMob="true"></PanelCharacterComponent>
                            }
                        </MudStack>
                    </MudPaper>
                }
                else
                {
                    <LoadingPage></LoadingPage>
                }

            </div>
        </MudHidden>
        @if (OngoingBattle)
        {
            <MudAlert Elevation="12" Severity="Severity.Error" Variant="Variant.Filled">Battle in progress!</MudAlert>
        }

        <MudBreadcrumbs Class="px-0 py-2" Items="_items"></MudBreadcrumbs>
        @if (Chapter is not null)
        {
            <MudText Typo="Typo.h4"><img src="@MyIcon.Quill" width="40" height="40" class="pr-2" />Chapter: @Chapter.Name</MudText>
            <MudText Class="py-2 flex-grow-1" Typo="Typo.h6"> @Chapter.Date, @Chapter.DayTime, @Chapter.Place </MudText>
            <MudText Typo="Typo.caption">Started at: @Chapter.CreatedDate.ToString("dd-MM-yyyy hh:mm")</MudText>

            <MudHidden Breakpoint="Breakpoint.LgAndUp" Invert="true">
                <MudStack>
                    @if(Chapter.Posts is not null){
                        @foreach (var post in Posts)
                        {
                            if (post.Character is not null)
                            {
                                string postId = "post_big_number_" + post.Id.ToString();
                                <MudPaper Class="d-flex flex-row pa-2" Width="100%" MinHeight="300px">
                                    <MudPaper Class="d-flex flex-column pa-2" Width="200px">
                                        @if(post.AlternativeName is null)
                                        {
                                            <MudText Align="Align.Center" Typo="Typo.h5">@post.Character.NPCName</MudText>
                                            <MudImage Src="@post.Character.ImageUrl" Alt="Avatar" Elevation="25" Class="rounded-lg " />
                                        }else{
                                            <MudText Align="Align.Center" Typo="Typo.h5">@post.AlternativeName</MudText>
                                            <MudImage Src="@post.AlternativeImageUrl" Alt="Avatar" Elevation="25" Class="rounded-lg " />
                                        }
                                        @if (CharacterAllParams.Any() && CharacterAllParams.ContainsKey( post.CharacterId))
                                        {
                                            <MudText Align="Align.Center" Class="pt-2" Typo="Typo.caption">Posts: @CharacterAllParams[post.CharacterId].Character.NumberOfPosts.ToString()</MudText>
                                            <MudText Align="Align.Center" Typo="Typo.caption">Last post: @CharacterAllParams[post.CharacterId].Character.LastPostDate.ToString("dd-MM-yyyy")</MudText>
                                        }
                                    </MudPaper>
                                    <MudPaper Class="d-flex flex-column pa-2 flex-grow-1">
                                        <MudStack Spacing="0" Row="true">
                                            <MudText Class="flex-grow-1" Typo="Typo.caption">Posted at: @post.CreatedDate.ToString("dd-MM-yyyy hh:mm")</MudText>
                                            @if (post.CharacterId == UserInfo.SelectedCharacter.Id || UserInfo.CharacterMG == true)
                                            {
                                                <MudIconButton Class="pa-1" Icon="@Icons.Material.Filled.Edit" aria-label="edit" OnClick="@(()=>EditPost(post))"></MudIconButton>
                                                <MudIconButton Class="pa-1" Icon="@Icons.Material.Filled.Delete" aria-label="delete" OnClick="@(()=>DeletePost(post))"></MudIconButton>
                                            }
                                        </MudStack>                                
                                        <div id="@postId" class="ql-editor" style="height:100%; overflow:auto;">
                                            @((MarkupString)(post.Content ?? string.Empty))
                                        </div>
                                    </MudPaper>
                                </MudPaper>
                            }
                        }
                    }
                    <MudPagination @ref="@Pagination" Count="PageCount" Selected="@PageNum" SelectedChanged="SelectPage"></MudPagination>
                </MudStack>
            </MudHidden>
            <MudHidden Breakpoint="Breakpoint.MdAndDown" Invert="true">
                <div class="w-100">
                    <MudStack>
                        @if (Chapter.Posts is not null)
                        {
                            @foreach (var post in Posts)
                            {
                                if (post.Character is not null)
                                {
                                    string postId = "post_small_number_" + post.Id.ToString();

                                    <MudPaper Width="100%" Class="d-flex flex-column pa-2 flex-grow-1">
                                        <MudStack Class="pb-1" Spacing="0" Row="true">
                                            @if(post.AlternativeName is null)
                                            {
                                                <MudAvatar Color="Color.Dark" Style="height:37px; width:37px;"><MudImage ObjectPosition="ObjectPosition.Top" ObjectFit="ObjectFit.Cover" Src="@post.Character.ImageUrl"></MudImage></MudAvatar>
                                                <MudText Class="flex-grow-1 pl-1" Align="Align.Left" Typo="Typo.h6">@post.Character.NPCName</MudText>
                                            }else{
                                                <MudAvatar Color="Color.Dark" Style="height:37px; width:37px;"><MudImage ObjectPosition="ObjectPosition.Top" ObjectFit="ObjectFit.Cover" Src="@post.AlternativeImageUrl"></MudImage></MudAvatar>
                                                <MudText Class="flex-grow-1 pl-1" Align="Align.Left" Typo="Typo.h6">@post.AlternativeName</MudText>

                                            }
                                            @if (post.CharacterId == UserInfo.SelectedCharacter.Id || UserInfo.CharacterMG == true)
                                            {
                                                <MudIconButton Class="pa-1" Icon="@Icons.Material.Filled.Edit" aria-label="edit" OnClick="@(()=>EditPost(post))"></MudIconButton>
                                            }
                                        </MudStack>

                                        <div id="@postId" class="ql-editor" style="height:100%; overflow:auto;">
                                            @((MarkupString)(post.Content ?? string.Empty))
                                        </div>
                                        <MudText Typo="Typo.caption">Posted at: @post.CreatedDate.ToString("dd-MM-yyyy hh:mm")</MudText>
                                    </MudPaper>
                                }
                            }
                        }
                        <MudPagination @ref="Pagination" Count="PageCount" SelectedChanged="SelectPage"></MudPagination>
                    </MudStack>

                </div>
            </MudHidden>
        }
        <div id="bottom-container">
            <MudPaper Width="100%" Height="300px" Square="true" Class="d-flex flex-column my-2 pa-2">
                <BlazoredTextEditor @ref="@PostEditor" ReadOnly="@(!SendPostEnabled)">
                    <ToolbarContent>
                        <select class="ql-header">
                            <option selected=""></option>
                            <option value="1"></option>
                            <option value="2"></option>
                        </select>
                        <span class="ql-formats">
                            <button class="ql-bold"></button>
                            <button class="ql-italic"></button>
                            <button class="ql-underline"></button>
                            <button class="ql-strike"></button>
                        </span>
                        <span class="ql-formats">
                            <select class="ql-color"></select>
                            <select class="ql-background"></select>
                        </span>
                        <span class="ql-formats">
                            <button class="ql-list" value="ordered"></button>
                            <button class="ql-blockquote"></button>
                        </span>
                        <span class="ql-formats">
                            <button class="ql-link"></button>
                        </span>
                    </ToolbarContent>
                    <EditorContent></EditorContent>
                </BlazoredTextEditor>
                <div class="d-flex flex-row">
                    <MudButton Disabled="(SendPostEnabled == false) " Class="mt-2 py-0" OnClick="CreatePost">@SendButtonText</MudButton>
                    @if (IsEditMode)
                    {
                        <MudButton Class="mt-2 py-0" OnClick="CancelEdit">Cancel Edit</MudButton>
                    }
                    @if(UserInfo?.IsAdminOrMG == true)
                    {
                        <MudSelect @bind-Value="GmAsMob" T="MobDTO"  Label="Select Mob">
                            <MudSelectItem Value="new MobDTO()">GM</MudSelectItem>
                            @foreach (var mob in Mobs)
                            {
                                <MudSelectItem Value="mob">@mob.Name</MudSelectItem>                                
                            }

                        </MudSelect>
                    }
                </div>
            </MudPaper>
        </div>       
    </div>
}

<style>
    .e-richtexteditor.e-rte-tb-expand .e-rte-content, .e-richtexteditor.e-rte-tb-expand .e-source-content
    {
    border: none;
    }

    .e-richtexteditor .e-rte-container {
    border: none;
    }

    .e-richtexteditor.e-rte-tb-expand
    {
    border: none;
    }

    .e-richtexteditor .e-rte-content .e-content 
    {
    padding: 4px;
    }

    .e-richtexteditor.e-rte-full-screen{
    top:64px;
    right:56px;
    width:100%;
    }
</style>

@code{
    [Parameter] public int Id { get; set; }
    private ChapterDTO? Chapter { get; set; } = null;
    private List<PostDTO> Posts { get; set; } = new List<PostDTO>();
    private List<CharacterDTO> Characters { get; set; } = new List<CharacterDTO>();
    private IDictionary<int, AllParamsModel?> CharacterAllParams { get; set; } = new Dictionary<int, AllParamsModel?>();
    private ICollection<MobDTO> Mobs = new List<MobDTO>();
    private List<RaceDTO> ApprovedRacesCache { get; set; } = new();
    private BattlePhaseDTO? BattlePhase = null;
    public PostDTO NewPost { get; set; } = new();
    public bool IsLoading { get; set; } = true;
    public bool IsLoadingCharacters { get; set; } = true;    
    private string Title { get; set; } = "Campaign name";
    private bool IsEditMode = false;
    private bool OngoingBattle = false;
    private string SendButtonText { get; set; } = "Send Post";
    private string BattleButton { get; set; } = "Start Battle";
    private int PostsPerPage { get; set; } = 10;
    private int PageNum { get; set; } = 1;
    private int PageCount { get; set; } = 1;
    private bool SendPostEnabled = true;
    private MobDTO GmAsMob = new MobDTO();
    private MudPagination Pagination;
    private BlazoredTextEditor PostEditor;
    private string CurrentDebugStep = string.Empty;


    public UserInfo? UserInfo { get; set; }
    private List<BreadcrumbItem> _items = new List<BreadcrumbItem>();
    private System.Action handler;
    private bool _open = false;
    private bool _scrollDown = true;
    private bool _afterRenderInProgress = false;

    private async Task DebugStep(string message)
    {
        CurrentDebugStep = message;
        Logger.LogWarning("ChapterThread debug: {Message}", message);
        try
        {
            // Guard against occasional render pipeline stalls while preserving progress logging.
            var renderTask = InvokeAsync(StateHasChanged);
            var completedTask = await Task.WhenAny(renderTask, Task.Delay(500));
            if (completedTask == renderTask)
            {
                await renderTask;
            }
            else
            {
                Logger.LogWarning("DebugStep render timed out at: {Message}", message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "DebugStep failed at: {Message}", message);
        }

        await Task.Yield();
    }

    private void ToggleDrawer()
    {
        _open = !_open;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await DebugStep("[1] OnInitializedAsync started");
            await AuthorizeEntry();
            await DebugStep("[2] AuthorizeEntry done");
            PageCount = await GetPageCount();
            await DebugStep($"[3] GetPageCount done: {PageCount}");
            PageNum = PageCount;
            await LoadChapter();
            await DebugStep("[4] LoadChapter done");
        }
        catch (Exception ex)
        {
            IsLoading = false;
            StateHasChanged();
            Logger.LogError(ex, "Error while initializing chapter page");
            SnackBar.Add("Error while initializing chapter page: " + ex.Message, Severity.Error);
        }

        handler = async () => await LoadForSelectedCharacter();
        _callbackService.OnChange += handler;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_afterRenderInProgress)
        {
            return;
        }

        _afterRenderInProgress = true;
        try
        {
            Logger.LogWarning("ChapterThread debug: [AR1] OnAfterRender start firstRender={FirstRender}, scrollDown={ScrollDown}, isLoading={IsLoading}", firstRender, _scrollDown, IsLoading);
            if (firstRender || UserInfo is null)
            {
                UserInfo = await _userService.GetUserInfo();
            }

            if (firstRender)
            {
                await AuthorizeEntry();
                PageCount = await GetPageCount();
                PageNum = PageCount;
                Logger.LogWarning("ChapterThread debug: [AR2] firstRender auth/page init done");
                //await LoadChapter();
            }

            // Avoid repeated scroll attempts while the page is still in loading cycles.
            if (_scrollDown == true && IsLoading == false)
            {
                Logger.LogWarning("ChapterThread debug: [AR3] scrollDown requested");
                _scrollDown = false;
                await Task.Delay(200);

                var scrollTask = _jsRuntime.ScrollToElement("bottom-container").AsTask();
                var completedTask = await Task.WhenAny(scrollTask, Task.Delay(1500));
                if (completedTask == scrollTask)
                {
                    await scrollTask;
                    Logger.LogWarning("ChapterThread debug: [AR4] scrollDown done");
                }
                else
                {
                    Logger.LogWarning("ChapterThread debug: [AR4] scrollDown timeout");
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error in OnAfterRenderAsync for chapter {ChapterId}", Id);
            _scrollDown = false;
        }
        finally
        {
            _afterRenderInProgress = false;
        }
    }

    private async Task AuthorizeEntry()
    {
        UserInfo = await _userService.GetUserInfo();
        if (UserInfo?.IsAuthenticated != true)
        {
            var uri = new Uri(_navigationManager.Uri);
            _navigationManager.NavigateTo($"/account/login?returnUrl={uri.LocalPath}", forceLoad: true);
        }
        if (Id > 0 && UserInfo is not null && UserInfo.IsAdminOrMG == false)
        {

            var res = await _chapterRepository.CheckIfChapterBelongToUser(UserInfo.UserName, Id);
            if (res == false)
            {
                _navigationManager.NavigateTo($"/campaignlist", forceLoad: true);
            }
        }
    }


    private async Task LoadForSelectedCharacter()
    {
        try
        {
            await DebugStep("[LS1] LoadForSelectedCharacter started");
            if (UserInfo is null)
            {
                UserInfo = await GetUserInfoWithTimeout();
                await DebugStep("[LS1A] UserInfo fetched from service");
            }
            else
            {
                await DebugStep("[LS1A] Reusing existing UserInfo");
            }
            await DebugStep($"[LS2] UserInfo loaded: Auth={(UserInfo?.IsAuthenticated == true)}, SelectedId={UserInfo?.SelectedCharacterId ?? 0}");

            if (UserInfo?.SelectedCharacter is null)
            {
                await DebugStep("[LS3] SelectedCharacter is null");
                SendPostEnabled = false;
                NewPost.Content = "Select a character to post in chapter.";
                return;
            }

            int charId = (int)UserInfo.SelectedCharacter.Id;
            if (charId == 0)
            {
                await DebugStep("[LS4] SelectedCharacter.Id == 0");
                SendPostEnabled = false;
                NewPost.Content = "Select a character to post in chapter.";
                return;
            }

            if (Chapter?.Characters.FirstOrDefault(c => c.Id == charId) is null
               && UserInfo?.CharacterMG == false)
            {
                await DebugStep($"[LS5] Selected character {charId} not in chapter");

                NewPost.Content = "Character not present in this chapter!";
                SendPostEnabled = false;
            }
            else
            {
                await DebugStep($"[LS6] Selected character {charId} accepted");
                SendPostEnabled = true;
                NewPost.Content = string.Empty;
            }
            _scrollDown = true;
            await DebugStep("[LS7] LoadForSelectedCharacter finished");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error in LoadForSelectedCharacter for chapter {ChapterId}", Id);
            SnackBar.Add("Error: " + ex.Message, Severity.Error);
        }
        finally
        {
            Logger.LogWarning("ChapterThread debug: [LS8] LoadForSelectedCharacter finally");
        }
    }

    private async Task<UserInfo?> GetUserInfoWithTimeout(int timeoutMs = 3000)
    {
        var getUserInfoTask = _userService.GetUserInfo();
        var completedTask = await Task.WhenAny(getUserInfoTask, Task.Delay(timeoutMs));
        if (completedTask == getUserInfoTask)
        {
            return await getUserInfoTask;
        }

        Logger.LogWarning("GetUserInfo timed out after {TimeoutMs}ms on chapter {ChapterId}", timeoutMs, Id);
        return UserInfo;
    }


    private async Task LoadChapter()
    {
        try
        {
            await DebugStep("[LC1] LoadChapter started");
            IsLoading = true;
            StateHasChanged();

            await DebugStep($"[LC2] Getting chapter by Id={Id}");
            Chapter = await _chapterRepository.GetById(Id);
            if (Chapter is null || Chapter.Id == 0)
            {
                SnackBar.Add("Chapter was not found.", Severity.Error);
                return;
            }
            await DebugStep($"[LC3] Chapter loaded: {Chapter.Name}, Characters count: {Chapter.Characters?.Count ?? 0}");

            PageCount = await GetPageCount();
            await DebugStep($"[LC4] PageCount: {PageCount}");
            Posts = (await _postRepository.GetPage(Id, PostsPerPage, PageNum)).ToList();
            await DebugStep($"[LC5] Posts loaded: {Posts.Count}");

            CharacterAllParams.Clear();
            if (ApprovedRacesCache.Count == 0)
            {
                ApprovedRacesCache = (await _raceRepository.GetAllApproved()).ToList();
            }
            int charIndex = 0;
            foreach (var charac in Chapter.Characters)
            {
                await DebugStep($"[LC6] Loading character {++charIndex}/{Chapter.Characters.Count}: Id={charac.Id}");
                CharacterAllParams[charac.Id] = await LoadCharacter(charac.Id);
            }
            await DebugStep($"[LC7] All characters loaded");

            await DebugStep("[LC8] Loading mobs...");
            await LoadMobs();
            await DebugStep("[LC9] Mobs loaded. Loading for selected character...");
            await LoadForSelectedCharacter();
            await DebugStep("[LC10] LoadForSelectedCharacter done");

            await DebugStep("[LC11] Building breadcrumbs");
            _items = new List<BreadcrumbItem>
            {
                new BreadcrumbItem("Campaigns", href: $"/campaignlist/" ),
                new BreadcrumbItem("Chapters", href: $"/campaign/{Chapter.CampaignId}"),
                new BreadcrumbItem("Posts", href: $"/chapter/{Id}"),
            };

            await DebugStep("[LC12] Breadcrumbs done");
            Title = Chapter.Name;
            await DebugStep("[LC13] Loading battle phase");
            BattlePhase = await GetBattlePhaseWithTimeout();
            if (BattlePhase is not null)
            {
                OngoingBattle = BattlePhase.BattleOngoing;
                BattleButton = OngoingBattle ? "End Battle" : "Start Battle";
            }

            await DebugStep("[LC14] Battle phase handled");
            // _scrollDown = true;
            IsLoadingCharacters = false;
            await DebugStep("[LC15] LoadChapter finished flags set");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error while loading chapter {ChapterId}", Id);
            SnackBar.Add("Error while loading chapter: " + ex.Message, Severity.Error);
        }
        finally
        {
            IsLoading = false;
            await DebugStep("[LCF] LoadChapter finally IsLoading=false");
            StateHasChanged();
            Logger.LogWarning("ChapterThread debug: [LCF] LoadChapter finally IsLoading=false");
        }
    }

    private async Task<BattlePhaseDTO?> GetBattlePhaseWithTimeout(int timeoutMs = 3000)
    {
        var getBattleTask = _battlePhaseRepository.GetCurrentForChapter(Id);
        var completedTask = await Task.WhenAny(getBattleTask, Task.Delay(timeoutMs));
        if (completedTask == getBattleTask)
        {
            return await getBattleTask;
        }

        Logger.LogWarning("GetCurrentForChapter timed out after {TimeoutMs}ms on chapter {ChapterId}", timeoutMs, Id);
        return null;
    }

    private async Task CreatePost()
    {
        try{

            if (PostEditor is not null)
            {
                NewPost.Content = await PostEditor.GetHTML();
            }

            if (string.IsNullOrEmpty(NewPost.Content))
                return;


            IsLoading = true;
            StateHasChanged();
            if (IsEditMode)
            {
                var result = await _postRepository.Update(NewPost);
                if (result is not null)
                {
                    var index =  Posts.FindIndex(p => p.Id == NewPost.Id);
                    if (index >= 0)
                        Posts[index].Content = NewPost.Content;
                }
                IsEditMode = false;
                SendButtonText = "Send Post";
            }
            else
            {
                NewPost.ChapterId = Id;
                NewPost.CreatedDate = DateTime.Now;
                UserInfo = await _userService.GetUserInfo();
                if(UserInfo?.IsAdminOrMG == true &&
                  (UserInfo?.SelectedCharacter?.UserName.ToLower() != "gm" && UserInfo?.SelectedCharacter?.UserName.ToLower() != "gamemaster"))
                {
                    var character = await _characterRepository.GetByName(SD.GameMaster_NPCName);                    
                    NewPost.CharacterId = character.Id;
                    NewPost.Character = character;
                }else{

                    NewPost.ChapterId = Id;
                    NewPost.CharacterId = (int)UserInfo?.SelectedCharacter?.Id;
                    NewPost.Character = UserInfo?.SelectedCharacter;
                    if(string.IsNullOrEmpty(GmAsMob.Name) == false)
                    {
                        NewPost.AlternativeName = GmAsMob.Name;
                        NewPost.AlternativeImageUrl = GmAsMob.ImageUrl;
                    }
                // CharacterAllParams[NewPost.Character.Id].Character.NumberOfPosts++;                
            }

            var result = await _postRepository.Create(NewPost);
            if(result is not null){
                if (NewPost.Character.Id > 0 && UserInfo?.CharacterMG == false)
                {
                    CharacterAllParams[NewPost.Character.Id].Character.NumberOfPosts = await _postRepository.GetCharacterPostCount(NewPost.Character.Id);
                    CharacterAllParams[NewPost.Character.Id].Character.LastPostDate = await _postRepository.GetCharacterLastPostDate(NewPost.Character.Id);
                }
                Posts.Add(NewPost);
                
            }
        }
        NewPost = new();
        if (PostEditor is not null)
        {
            await PostEditor.LoadHTMLContent(string.Empty);
        }


        var newPageCount = await GetPageCount();
        if (newPageCount != PageCount || PageNum != newPageCount)
        {
            PageNum = PageCount = newPageCount;
            Posts = (await _postRepository.GetPage(Id, PostsPerPage, PageNum)).ToList();
            //  Pagination.
        }

        IsLoading = false;       

        StateHasChanged();
        _scrollDown = true;
        }
        catch (Exception)
        {
            SnackBar.Add("Error during creating post",Severity.Error);
        }
    }

