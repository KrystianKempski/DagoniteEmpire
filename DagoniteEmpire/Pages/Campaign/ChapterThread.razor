    private static bool IsEmptyEditorHtml(string? html) =>
        string.IsNullOrWhiteSpace(html)
        || html.Trim() is "<p><br></p>" or "<p></p>";

    private static string TrimTrailingEmptyParagraph(string html)
    {
        var trimmed = html.Trim();
        if (trimmed.EndsWith("<p><br></p>", StringComparison.Ordinal))
            return trimmed[..^11];
        if (trimmed.EndsWith("<p></p>", StringComparison.Ordinal))
            return trimmed[..^7];
        return trimmed;
    }

    private static string WrapAsQuoteBlock(string innerHtml) =>
        $"<blockquote class=\"{RichText.QuoteBlockClass}\">{innerHtml}</blockquote>";

    private async Task AppendRollToPostEditorAsync(string rollRichHtml, bool wrapForThread = false, bool fightFormat = false)
    {
        if (string.IsNullOrEmpty(rollRichHtml))
            return;

        _editorExpanded = true;

        var loadHtml = fightFormat
            ? RichText.ToFightEditorHtml(rollRichHtml)
            : RichText.ToPlainEditorHtml(rollRichHtml);

        if (string.IsNullOrEmpty(loadHtml))
            loadHtml = RichText.ToPlainEditorHtml(rollRichHtml);

        if (string.IsNullOrEmpty(loadHtml))
            return;

        if (wrapForThread)
            loadHtml = RichText.CollapseToSingleParagraph(loadHtml);

        var existingHtml = PostEditor is not null
            ? await PostEditor.GetHTML()
            : NewPost.Content;

        var append = !IsEmptyEditorHtml(existingHtml);
        var applyQuote = wrapForThread;

        if (append)
        {
            var rollBlock = applyQuote ? WrapAsQuoteBlock(loadHtml) : loadHtml;
            loadHtml = TrimTrailingEmptyParagraph(existingHtml) + rollBlock + "<p><br></p>";
            applyQuote = false;
        }

        _pendingPostEditorHtml = loadHtml;
        _pendingPostEditorQuote = applyQuote;
        _pendingPostEditorAppend = false;
        _shouldLoadPostEditor = PostEditor is null;

        if (PostEditor is not null)
            await LoadRollIntoPostEditorAsync(loadHtml, applyQuote, append: false);

        await _jsRuntime.ScrollToElement("bottom-container");
    }

    private async Task LoadRollIntoPostEditorAsync(string html, bool applyQuote, bool append)
    {
        try
        {
            await _jsRuntime.InvokeVoidAsync(
                "QuillPostEditor.loadRollContent",
                PostEditorHostId,
                html,
                applyQuote,
                append);

            await Task.Delay(50);
            await SyncPostEditorContentFromDomAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load roll into post editor");
        }
    }

    private async Task SyncPostEditorContentFromDomAsync()
    {
        try
        {
            var synced = await _jsRuntime.InvokeAsync<string>("QuillPostEditor.getHtml", PostEditorHostId);
            if (!IsEmptyEditorHtml(synced))
                NewPost.Content = synced;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to sync post editor HTML");
        }
    }

    private async Task TryLoadPendingPostEditorAsync()
    {
        if (!_shouldLoadPostEditor || string.IsNullOrEmpty(_pendingPostEditorHtml) || PostEditor is null)
            return;

        try
        {
            await LoadRollIntoPostEditorAsync(
                _pendingPostEditorHtml,
                _pendingPostEditorQuote,
                _pendingPostEditorAppend);
        }
        finally
        {
            _shouldLoadPostEditor = false;
        }
    }

