@page "/chapter/{Id:int}"
@using DA_Business.Services.Interfaces
@using DA_Scribe.Services.Interfaces
@using Microsoft.AspNetCore.SignalR.Client
@using DA_Models.ChatModels
@inject IChapterRepository _chapterRepository
@inject IPostRepository _postRepository
@inject ICharacterRepository _characterRepository
@inject IAttributeRepository _attributeRepository
@inject IBaseSkillRepository _baseSkillRepository
@inject ISpecialSkillRepository _specialSkillRepository
@inject ITraitRepository<TraitCharacterDTO> _traitCharacterRepository
@inject ITraitRepository<TraitProfessionDTO> _traitProfessionRepository
@inject IRaceRepository _raceRepository
@inject IProfessionRepository _professionRepository
@inject IEquipmentSlotRepository _equipmentSlotRepository
@inject IWoundRepository _woundRepository
@inject IMobRepository _mobRepository
@inject IBattlePhaseRepository _battlePhaseRepository
@inject IEquipmentRepository _equipmentRepository
@inject IUserService _userService
@inject IScribeService _scribeService
@inject NavigationManager _navigationManager
@inject ISnackbar SnackBar
@inject IDialogService DialogService
@inject IBrowserViewportService _viewportService
@inject IJSRuntime _jsRuntime
@inject CallbackService _callbackService
@inject ILogger<ChapterThread> Logger
@implements IAsyncDisposable

<PageTitle>Dagonie Empire | Thread</PageTitle>

@if (IsLoading && Chapter is null)
{
    <LoadingPage></LoadingPage>
}
else
{
    @if (_showDrawerPanelLayout)
    {
        <MudHidden Breakpoint="Breakpoint.LgAndDown" Invert="true">
            <MudButton Style="p-2" OnClick="ToggleDrawer" Variant="Variant.Text" DropShadow="true">
                Open Drawer
            </MudButton>

            <MudDrawer Width="320px" @bind-Open="@_open" Elevation="1" Variant="DrawerVariant.Temporary" ClipMode="DrawerClipMode.Always">
                <div class="px-1 py-2">
                    @if (UserInfo?.IsAdminOrMG == true)
                    {
                        <MudGrid Justify="Justify.Center" Spacing="1">
                            <MudItem xs="8"><MudButton FullWidth Variant="Variant.Filled" Color="Color.Error" OnClick="SwichBattlePhase">@BattleButton</MudButton></MudItem>
                            @if (OngoingBattle)
                            {
                                <MudItem xs="12"><MudText Align="Align.Center">Turn: @BattlePhase?.CurrentTurn</MudText></MudItem>
                                <MudItem xs="6"><MudButton FullWidth OnClick="GenerateFightSequence">Generate fight</MudButton></MudItem>
                                <MudItem xs="6"><MudButton FullWidth OnClick="NextTurn">Next turn</MudButton></MudItem>
                                <MudItem xs="6"><MudButton FullWidth OnClick="EndBattlePhase">End Battle</MudButton></MudItem>
                            }
                            <MudItem xs="6"><MudButton FullWidth OnClick="AddExistingMob">Existing mobs</MudButton></MudItem>
                            <MudItem xs="6"><MudButton FullWidth OnClick="MakeSkillRoll">Make a roll</MudButton></MudItem>
                            <MudItem xs="6"><MudButton FullWidth OnClick="AddTemporaryStatus">Add status</MudButton></MudItem>
                        </MudGrid>
                    }
                    @if (IsLoadingCharacters)
                    {
                        <LoadingPage></LoadingPage>
                    }
                    else
                    {
                        <MudPaper MinWidth="300px" Elevation="1">
                            <MudStack Spacing="2">
                                @foreach (var charac in Chapter!.Characters)
                                {
                                    <PanelCharacterComponent AllParams="CharacterAllParams[charac.Id]" Id="charac.Id"></PanelCharacterComponent>
                                }
                                @foreach (var mob in Mobs)
                                {
                                    <PanelCharacterComponent Mob="mob" Id="mob.Id" IsMob="true"></PanelCharacterComponent>
                                }
                            </MudStack>
                        </MudPaper>
                    }
                </div>
            </MudDrawer>
        </MudHidden>
    }

    <div id="mam" class="margin-side container-lg">
        @if (_showDrawerPanelLayout == false)
        {
            <MudHidden Breakpoint="Breakpoint.XlAndUp" Invert="true">
                <div class="character-panel">
                    @if (UserInfo?.IsAdminOrMG == true)
                    {
                        <MudGrid Justify="Justify.Center" Spacing="1">
                            <MudItem xs="8"><MudButton FullWidth Variant="Variant.Filled" Color="Color.Error" OnClick="SwichBattlePhase">@BattleButton</MudButton></MudItem>
                            @if (OngoingBattle)
                            {
                                <MudItem xs="12"><MudText Align="Align.Center">Turn: @BattlePhase?.CurrentTurn</MudText></MudItem>
                                <MudItem xs="6"><MudButton FullWidth OnClick="GenerateFightSequence">Generate fight</MudButton></MudItem>
                                <MudItem xs="6"><MudButton FullWidth OnClick="NextTurn">Next turn</MudButton></MudItem>
                                <MudItem xs="6"><MudButton FullWidth OnClick="EndBattlePhase">End Battle</MudButton></MudItem>
                            }
                            <MudItem xs="6"><MudButton FullWidth OnClick="AddExistingMob">Existing mobs</MudButton></MudItem>
                            <MudItem xs="6"><MudButton FullWidth OnClick="MakeSkillRoll">Make a roll</MudButton></MudItem>
                        </MudGrid>
                    }
                    @if (IsLoadingCharacters)
                    {
                        <LoadingPage></LoadingPage>
                    }
                    else
                    {
                        <MudPaper Elevation="1">
                            <MudStack Spacing="2">
                                @foreach (var charac in Chapter!.Characters)
                                {
                                    <PanelCharacterComponent AllParams="CharacterAllParams[charac.Id]" Id="charac.Id"></PanelCharacterComponent>
                                }
                                @foreach (var mob in Mobs)
                                {
                                    <PanelCharacterComponent Mob="mob" Id="mob.Id" IsMob="true"></PanelCharacterComponent>
                                }
                            </MudStack>
                        </MudPaper>
                    }
                </div>
            </MudHidden>
        }

        @if (OngoingBattle)
        {
            <MudAlert Elevation="12" Severity="Severity.Error" Variant="Variant.Filled">Battle in progress!</MudAlert>
        }

        <MudBreadcrumbs Class="px-0 py-2" Items="_items"></MudBreadcrumbs>
        
        @if (Chapter is not null)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
                <MudText Typo="Typo.h4">Chapter: @Chapter.Name</MudText>
                <WikiNavLink ChapterName="@Chapter.Name" Label="Archiwum wiki" />
            </MudStack>
            <MudText Class="py-2 flex-grow-1" Typo="Typo.h6">@Chapter.Date, @Chapter.DayTime, @Chapter.Place</MudText>
            <MudText Typo="Typo.caption">Started at: @Chapter.CreatedDate.ToString("dd-MM-yyyy hh:mm")</MudText>

            <MudHidden Breakpoint="Breakpoint.LgAndUp" Invert="true">
                <MudStack>
                    @if (Posts.Any())
                    {
                        @foreach (var post in Posts)
                        {
                            @if (post.Character is not null)
                            {
                                <MudPaper Class="d-flex flex-row pa-2" Width="100%" MinHeight="150px">
                                    <MudPaper Class="d-flex flex-column pa-2" Width="150px">
                                        <MudText Align="Align.Center" Typo="Typo.h6">@(post.AlternativeName ?? post.Character.NPCName)</MudText>
                                        <MudImage Src="@(post.AlternativeImageUrl ?? post.Character.ImageUrl)" Alt="Avatar" Elevation="25" Class="rounded-lg" Style="max-width:130px;" />
                                        @if (CharacterAllParams.Any() && CharacterAllParams.ContainsKey(post.CharacterId) && CharacterAllParams[post.CharacterId] is not null)
                                        {
                                            <MudText Align="Align.Center" Class="pt-2" Typo="Typo.caption">Posts: @CharacterAllParams[post.CharacterId]!.Character.NumberOfPosts.ToString()</MudText>
                                        }
                                    </MudPaper>
                                    <MudPaper Class="d-flex flex-column pa-2 flex-grow-1">
                                        <MudStack Spacing="0" Row="true">
                                            <MudText Class="flex-grow-1" Typo="Typo.caption">Posted at: @post.CreatedDate.ToString("dd-MM-yyyy hh:mm")</MudText>
                                            @if (UserInfo?.SelectedCharacter is not null && (post.CharacterId == UserInfo.SelectedCharacter.Id || UserInfo.CharacterMG == true))
                                            {
                                                <MudIconButton Class="pa-1" Icon="@Icons.Material.Filled.Edit" aria-label="edit" OnClick="@(()=>EditPost(post))"></MudIconButton>
                                                <MudIconButton Class="pa-1" Icon="@Icons.Material.Filled.Delete" aria-label="delete" OnClick="@(()=>DeletePost(post))"></MudIconButton>
                                            }
                                        </MudStack>
                                        <div class="ql-editor" style="height:100%; overflow:auto;">
                                            @((MarkupString)(post.Content ?? string.Empty))
                                        </div>
                                    </MudPaper>
                                </MudPaper>
                            }
                        }
                    }
                    else
                    {
                        <MudText>No posts yet</MudText>
                    }
                    <MudPagination @ref="@Pagination" Count="@PageCount" Selected="@PageNum" SelectedChanged="SelectPage"></MudPagination>
                </MudStack>
            </MudHidden>
            
            <MudHidden Breakpoint="Breakpoint.MdAndDown" Invert="true">
                <div class="w-100">
                    <MudStack>
                        @if (Posts.Any())
                        {
                            @foreach (var post in Posts)
                            {
                                @if (post.Character is not null)
                                {
                                    <MudPaper Width="100%" Class="d-flex flex-column pa-2 flex-grow-1">
                                        <MudStack Class="pb-1" Spacing="0" Row="true">
                                            <MudAvatar Color="Color.Dark" Style="height:37px; width:37px;">
                                                <MudImage ObjectPosition="ObjectPosition.Top" ObjectFit="ObjectFit.Cover" Src="@(post.AlternativeImageUrl ?? post.Character.ImageUrl)"></MudImage>
                                            </MudAvatar>
                                            <MudText Class="flex-grow-1 pl-1" Align="Align.Left" Typo="Typo.h6">@(post.AlternativeName ?? post.Character.NPCName)</MudText>
                                            @if (UserInfo?.SelectedCharacter is not null && (post.CharacterId == UserInfo.SelectedCharacter.Id || UserInfo.CharacterMG == true))
                                            {
                                                <MudIconButton Class="pa-1" Icon="@Icons.Material.Filled.Edit" aria-label="edit" OnClick="@(()=>EditPost(post))"></MudIconButton>
                                            }
                                        </MudStack>
                                        <div class="ql-editor" style="height:100%; overflow:auto;">
                                            @((MarkupString)(post.Content ?? string.Empty))
                                        </div>
                                        <MudText Typo="Typo.caption">Posted at: @post.CreatedDate.ToString("dd-MM-yyyy hh:mm")</MudText>
                                    </MudPaper>
                                }
                            }
                        }
                        else
                        {
                            <MudText>No posts yet</MudText>
                        }
                        <MudPagination Count="@PageCount" Selected="@PageNum" SelectedChanged="SelectPage"></MudPagination>
                    </MudStack>
                </div>
            </MudHidden>
        }
        
        <div id="bottom-container">
            <MudPaper Width="100%" Height="300px" Square="true" Class="d-flex flex-column my-2 pa-2">
                <BlazoredTextEditor @ref="@PostEditor" ReadOnly="@(!SendPostEnabled)">
                    <ToolbarContent>
                        <select class="ql-header">
                            <option selected=""></option>
                            <option value="1"></option>
                            <option value="2"></option>
                        </select>
                        <span class="ql-formats">
                            <button class="ql-bold"></button>
                            <button class="ql-italic"></button>
                            <button class="ql-underline"></button>
                            <button class="ql-strike"></button>
                        </span>
                        <span class="ql-formats">
                            <select class="ql-color"></select>
                            <select class="ql-background"></select>
                        </span>
                        <span class="ql-formats">
                            <button class="ql-list" value="ordered"></button>
                            <button class="ql-blockquote"></button>
                        </span>
                        <span class="ql-formats">
                            <button class="ql-link"></button>
                        </span>
                    </ToolbarContent>
                    <EditorContent></EditorContent>
                </BlazoredTextEditor>
                <div class="d-flex flex-row">
                    <MudButton Disabled="@(!SendPostEnabled)" Class="mt-2 py-0" OnClick="CreatePost">@SendButtonText</MudButton>
                    @if (IsEditMode)
                    {
                        <MudButton Class="mt-2 py-0" OnClick="CancelEdit">Cancel Edit</MudButton>
                    }
                    @if (UserInfo?.IsAdminOrMG == true)
                    {
                        <MudSelect @bind-Value="GmAsMob" T="MobDTO" Label="Select Mob">
                            <MudSelectItem Value="GmMobOption">GM</MudSelectItem>
                            @foreach (var mob in Mobs)
                            {
                                <MudSelectItem Value="mob">@mob.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </div>
            </MudPaper>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private ChapterDTO? Chapter { get; set; } = null;
    private List<PostDTO> Posts { get; set; } = new List<PostDTO>();
    private IDictionary<int, AllParamsModel?> CharacterAllParams { get; set; } = new Dictionary<int, AllParamsModel?>();
    private ICollection<MobDTO> Mobs = new List<MobDTO>();
    private BattlePhaseDTO? BattlePhase = null;
    private List<RaceDTO> ApprovedRacesCache { get; set; } = new();
    public PostDTO NewPost { get; set; } = new();
    public UserInfo? UserInfo { get; set; }
    
    public bool IsLoading { get; set; } = true;
    public bool IsLoadingCharacters { get; set; } = true;
    private bool OngoingBattle = false;
    private bool IsEditMode = false;
    private string SendButtonText { get; set; } = "Send Post";
    private string BattleButton { get; set; } = "Start Battle";
    private bool _open = false;
    private bool _showDrawerPanelLayout = true;
    private int PostsPerPage { get; set; } = 10;
    private int PageNum { get; set; } = 1;
    private int PageCount { get; set; } = 1;
    private bool SendPostEnabled = true;
    private static readonly MobDTO GmMobOption = new MobDTO { Id = 0, Name = string.Empty };
    private MobDTO GmAsMob = GmMobOption;
    private MudPagination? Pagination;
    private BlazoredTextEditor? PostEditor;
    private HubConnection? _hubConnection;
    private System.Action? handler;
    private bool _scrollDown = true;
    private bool _afterRenderInProgress = false;
    
    private List<BreadcrumbItem> _items = new List<BreadcrumbItem>
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Campaign", href: "/campaign"),
        new BreadcrumbItem("Chapter", href: null, disabled: true)
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            UserInfo = await _userService.GetUserInfo();
            await LoadChapter();
            await InitializeSignalR();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error in OnInitializedAsync");
            IsLoading = false;
            StateHasChanged();
        }

        handler = async () => await LoadForSelectedCharacter();
        _callbackService.OnChange += handler;
    }

    private async Task InitializeSignalR()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(_navigationManager.ToAbsoluteUri(ChatHub.HubUrl))
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<int, int>("NewPost", OnNewPost);
            _hubConnection.On<int, int>("PostUpdated", OnPostUpdated);

            await _hubConnection.StartAsync();
            Logger.LogInformation("SignalR connection established for chapter {ChapterId}", Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing SignalR connection");
        }
    }

    private async Task OnNewPost(int chapterId, int postId)
    {
        if (chapterId != Id) return;
        
        await InvokeAsync(async () =>
        {
            // Refresh posts to get the new one
            PageCount = await GetPageCount();
            Posts = (await _postRepository.GetPage(Id, PostsPerPage, PageNum)).ToList();
            _scrollDown = true;
            StateHasChanged();
            SnackBar.Add("New post added!", Severity.Info);
        });
    }

    private async Task OnPostUpdated(int chapterId, int postId)
    {
        if (chapterId != Id) return;
        
        await InvokeAsync(async () =>
        {
            // Refresh posts to get the updated one
            Posts = (await _postRepository.GetPage(Id, PostsPerPage, PageNum)).ToList();
            StateHasChanged();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_afterRenderInProgress) return;
        _afterRenderInProgress = true;

        try
        {
            if (firstRender)
            {
                var bp = await _viewportService.GetCurrentBreakpointAsync();
                _showDrawerPanelLayout = bp <= Breakpoint.Lg;
                StateHasChanged();
            }

            if (_scrollDown && !IsLoading)
            {
                _scrollDown = false;
                await Task.Delay(200);
                await _jsRuntime.ScrollToElement("bottom-container");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error in OnAfterRenderAsync");
            _scrollDown = false;
        }
        finally
        {
            _afterRenderInProgress = false;
        }
    }

    private async Task LoadForSelectedCharacter()
    {
        try
        {
            UserInfo = await _userService.GetUserInfo();
            if (UserInfo is null) return;
            
            if (UserInfo.SelectedCharacter is null)
            {
                SendPostEnabled = false;
                return;
            }

            int charId = (int)UserInfo.SelectedCharacter.Id;
            if (charId == 0)
            {
                SendPostEnabled = false;
                return;
            }

            if (Chapter?.Characters.FirstOrDefault(c => c.Id == charId) is null
               && UserInfo?.CharacterMG == false)
            {
                SendPostEnabled = false;
            }
            else
            {
                SendPostEnabled = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error in LoadForSelectedCharacter");
            SnackBar.Add("Error: " + ex.Message, Severity.Error);
        }
    }

    private async Task LoadChapter()
    {
        try
        {
            IsLoading = true;
            IsLoadingCharacters = true;
            StateHasChanged();

            Chapter = await _chapterRepository.GetById(Id);

            if (Chapter is not null)
            {
                // Load posts
                PageCount = await GetPageCount();
                Posts = (await _postRepository.GetPage(Id, PostsPerPage, PageNum)).ToList();

                // Load characters with AllParams
                CharacterAllParams.Clear();
                if (ApprovedRacesCache.Count == 0)
                {
                    ApprovedRacesCache = (await _raceRepository.GetAllApproved()).ToList();
                }
                
                foreach (var charac in Chapter.Characters)
                {
                    CharacterAllParams[charac.Id] = await LoadCharacter(charac.Id);
                }

                // Load mobs
                await LoadMobs();

                // Load battle phase
                BattlePhase = await _battlePhaseRepository.GetCurrentForChapter(Id);
                if (BattlePhase is not null)
                {
                    OngoingBattle = BattlePhase.BattleOngoing;
                    BattleButton = OngoingBattle ? "End Battle" : "Start Battle";
                }

                // Load for selected character
                await LoadForSelectedCharacter();

                _items = new List<BreadcrumbItem>
                {
                    new BreadcrumbItem("Campaigns", href: $"/campaignlist/"),
                    new BreadcrumbItem("Chapters", href: $"/campaign/{Chapter.CampaignId}"),
                    new BreadcrumbItem("Posts", href: $"/chapter/{Id}"),
                };
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading chapter {ChapterId}", Id);
            SnackBar.Add("Error loading chapter: " + ex.Message, Severity.Error);
        }
        finally
        {
            IsLoading = false;
            IsLoadingCharacters = false;
            _scrollDown = true;
            StateHasChanged();
        }
    }

    private async Task<AllParamsModel> LoadCharacter(int id)
    {
        AllParamsModel allParams = new();
        var characterTask = _characterRepository.GetById(id);
        var attributesTask = _attributeRepository.GetAll(id);
        var baseSkillsTask = _baseSkillRepository.GetAll(id);
        var specialSkillsTask = _specialSkillRepository.GetAll(id);
        var traitCharactersTask = _traitCharacterRepository.GetAll(id);
        var equipmentSlotsTask = _equipmentSlotRepository.GetAll(id);
        var woundsTask = _woundRepository.GetAll(id);
        var condsTask = _woundRepository.GetAllCond(id);
        var postCountTask = _postRepository.GetCharacterPostCount(id);
        var lastPostDateTask = _postRepository.GetCharacterLastPostDate(id);

        await Task.WhenAll(
            characterTask,
            attributesTask,
            baseSkillsTask,
            specialSkillsTask,
            traitCharactersTask,
            equipmentSlotsTask,
            woundsTask,
            condsTask,
            postCountTask,
            lastPostDateTask);

        allParams.Character = await characterTask;
        allParams.Attributes.FillPropertiesContainer(await attributesTask);
        allParams.BaseSkills = await baseSkillsTask;
        allParams.SpecialSkills.FillPropertiesContainer(await specialSkillsTask);

        var characterTraits = (await traitCharactersTask).ToList();
        allParams.TraitsCharacter = characterTraits.Where(u => u.IsTemporary == false).Cast<TraitDTO>().ToList();
        allParams.TraitsTemporary = characterTraits.Where(u => u.IsTemporary == true).Cast<TraitDTO>().ToList();

        var raceTask = _raceRepository.GetById(allParams.Character.RaceId);
        var professionTask = _professionRepository.GetById(allParams.Character.ProfessionId);
        var professionTraitsTask = _traitProfessionRepository.GetAll(allParams.Character.Id);

        await Task.WhenAll(raceTask, professionTask, professionTraitsTask);

        allParams.CurrentRace = await raceTask;
        allParams.Profession = await professionTask;
        allParams.Profession.Traits = (await professionTraitsTask).ToList();
        allParams.EquipmentSlots = (await equipmentSlotsTask).ToList();
        allParams.Races = ApprovedRacesCache.ToList();

        allParams.SpecialSkills.AddRelatedParametes();
        allParams.AllTraitsChange();
        allParams.Profession.CalculateClassParams(allParams.Attributes.GetAll());
        ICollection<WoundDTO> wounds = (await woundsTask).ToList();
        ICollection<WoundDTO> conds = (await condsTask).Cast<WoundDTO>().ToList();
        wounds = wounds.Concat(conds).ToList();
        allParams.Health.FillPropertiesContainer(wounds);
        allParams.Health.UpdateHealthBonusesInAttributes();

        allParams.Character.NumberOfPosts = await postCountTask;
        allParams.Character.LastPostDate = await lastPostDateTask;
        return allParams;
    }

    private async Task CreatePost()
    {
        try
        {
            if (PostEditor is not null)
            {
                NewPost.Content = await PostEditor.GetHTML();
            }

            if (string.IsNullOrEmpty(NewPost.Content))
                return;

            IsLoading = true;
            StateHasChanged();

            if (IsEditMode)
            {
                var result = await _postRepository.Update(NewPost);
                if (result is not null)
                {
                    var index = Posts.FindIndex(p => p.Id == NewPost.Id);
                    if (index >= 0)
                        Posts[index].Content = NewPost.Content;
                    
                    // Notify other clients about the updated post
                    if (_hubConnection is not null)
                    {
                        await _hubConnection.SendAsync("NotifyPostUpdated", Id, NewPost.Id);
                    }
                }
                IsEditMode = false;
                SendButtonText = "Send Post";
            }
            else
            {
                NewPost.ChapterId = Id;
                NewPost.CreatedDate = DateTime.Now;
                
                if (UserInfo?.SelectedCharacter is not null)
                {
                    NewPost.CharacterId = (int)UserInfo.SelectedCharacter.Id;
                    NewPost.Character = UserInfo.SelectedCharacter;
                    if (string.IsNullOrEmpty(GmAsMob.Name) == false)
                    {
                        NewPost.AlternativeName = GmAsMob.Name;
                        NewPost.AlternativeImageUrl = GmAsMob.ImageUrl;
                    }
                }

                var result = await _postRepository.Create(NewPost);
                if (result is not null)
                {
                    Posts.Add(NewPost);
                    
                    // Notify other clients about the new post
                    if (_hubConnection is not null)
                    {
                        await _hubConnection.SendAsync("NotifyNewPost", Id, result.Id);
                    }
                    
                    // Index the post in SCRIBE (fire and forget)
                    _ = Task.Run(async () =>
                    {
                        try
                        {
                            await _scribeService.IngestPostAsync(result.Id);
                        }
                        catch (Exception ex)
                        {
                            Logger.LogWarning(ex, "Failed to index post {PostId} in SCRIBE", result.Id);
                        }
                    });
                }
            }

            NewPost = new();
            if (PostEditor is not null)
            {
                await PostEditor.LoadHTMLContent(string.Empty);
            }

            var newPageCount = await GetPageCount();
            if (newPageCount != PageCount || PageNum != newPageCount)
            {
                PageNum = PageCount = newPageCount;
                Posts = (await _postRepository.GetPage(Id, PostsPerPage, PageNum)).ToList();
            }

            IsLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating post");
            SnackBar.Add("Error creating post: " + ex.Message, Severity.Error);
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task EditPost(PostDTO post)
    {
        await _jsRuntime.ScrollToElement("bottom-container");
        NewPost = post;
        IsEditMode = true;
        SendButtonText = "Edit Post";
        if (PostEditor is not null)
        {
            await PostEditor.LoadHTMLContent(NewPost.Content ?? string.Empty);
        }
    }

    private async Task DeletePost(PostDTO post)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Warning",
            "Are you sure you want to delete this post?",
            yesText: "Yes", cancelText: "No");
        if (result is null || result == false)
        {
            return;
        }
        IsLoading = true;
        StateHasChanged();
        int idToDelete = post.Id;

        Posts.Remove(post);
        await _postRepository.Delete(idToDelete);
        IsLoading = false;
        StateHasChanged();
    }

    private void CancelEdit()
    {
        NewPost = new();
        IsEditMode = false;
        SendButtonText = "Send Post";
    }

    private async Task<int> GetPageCount()
    {
        int postCount = await _postRepository.GetPostCount(Id);
        if (postCount == 0) return 1;
        return postCount % PostsPerPage == 0 ? (postCount / PostsPerPage) : (postCount / PostsPerPage) + 1;
    }

    private async Task SelectPage(int page = 1)
    {
        try
        {
            PageNum = page;
            PageCount = await GetPageCount();
            Posts = (await _postRepository.GetPage(Id, PostsPerPage, PageNum)).ToList();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error selecting page {PageNum}", page);
            SnackBar.Add("Error changing page: " + ex.Message, Severity.Error);
        }
    }

    private void ToggleDrawer()
    {
        _open = !_open;
    }

    private async Task LoadMobs()
    {
        try
        {
            Mobs = (await _mobRepository.GetAllForChapter(Id)).ToList();
            foreach (var mob in Mobs)
            {
                mob.BattleProperties = new(mob);
                if (string.IsNullOrEmpty(mob.MainWeaponName) == false)
                {
                    mob.MainWeapon = await _equipmentRepository.GetByName(mob.MainWeaponName);
                }
                if (string.IsNullOrEmpty(mob.OffWeaponName) == false)
                {
                    mob.OffWeapon = await _equipmentRepository.GetByName(mob.OffWeaponName);
                }
                if (string.IsNullOrEmpty(mob.ShieldWeaponName) == false)
                {
                    mob.ShieldWeapon = await _equipmentRepository.GetByName(mob.ShieldWeaponName);
                }
                if (string.IsNullOrEmpty(mob.ArmorName) == false)
                {
                    mob.Armor = await _equipmentRepository.GetByName(mob.ArmorName);
                }
                mob.BattleProperties.CalculateBattleStats();
            }
        }
        catch (Exception ex)
        {
            SnackBar.Add($"Error while loading mobs: " + ex.Message, Severity.Error);
        }
    }

    public async ValueTask DisposeAsync()
