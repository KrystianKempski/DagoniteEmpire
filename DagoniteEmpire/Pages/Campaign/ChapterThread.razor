    private async Task AddBaronyResourcesPost()
    {
        if (Chapter is null || !ShowBaronyResourcesButton)
            return;

        var dialog = await DialogService.ShowAsync<AddBaronyResourcesPostDialog>(
            "Add barony resources",
            new DialogParameters<AddBaronyResourcesPostDialog>(),
            await SetDialogOptions(MaxWidth.ExtraSmall));
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not AddBaronyResourcesPostDialog.ResourcePostResult resourceResult)
            return;

        var actor = await ResolveGameMasterActorAsync();
        if (actor is null)
        {
            SnackBar.Add(L["No character available to assign this post."], Severity.Warning);
            return;
        }

        var post = new PostDTO
        {
            ChapterId = Id,
            CreatedDate = DateTime.Now,
            CharacterId = actor.Id,
            Character = actor,
            AlternativeName = "Barony resources",
            AlternativeImageUrl = SD.GameMaster_Portrait,
            Content = BuildBaronyResourcePostHtml(
                resourceResult.PpbDelta,
                resourceResult.PrestigeDelta,
                resourceResult.HonorDelta,
                resourceResult.FearDelta)
        };

        var created = await _postRepository.Create(post);
        if (created is null)
            return;

        try
        {
            await ApplyBaronyAdventureGrantsAsync(
                resourceResult.PpbDelta,
                resourceResult.PrestigeDelta,
                resourceResult.HonorDelta,
                resourceResult.FearDelta);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to apply barony adventure grants for chapter {ChapterId}", Id);
            SnackBar.Add(L["Post saved, but barony update failed: {0}", ex.Message], Severity.Warning);
        }

        if (_hubConnection is not null)
            await _hubConnection.SendAsync("NotifyNewPost", Id, created.Id);

        await AppendPostByIdAsync(created.Id, forceScrollDown: true);
        StateHasChanged();
    }

    /// <summary>
    /// Mirrors AudiencesPage.AddResourcesAsync: non-cumulative → Events “Adventures”,
    /// cumulative → stocks + Resources balance row, PHP → From Adventures.
    /// </summary>
    private async Task ApplyBaronyAdventureGrantsAsync(
        PpbVector ppbDelta,
        int prestigeDelta,
        int honorDelta,
        int fearDelta)
    {
        var barony = await ResolveBaronCampaignBaronyAsync();
        if (barony is null)
            throw new InvalidOperationException("Could not resolve the barony for this campaign.");

        var turn = Math.Max(1, barony.TurnNumber);
        var fullDelta = ppbDelta?.Clone() ?? new PpbVector();

        if (!fullDelta.IsEmpty)
        {
            var events = await _baronyRepo.GetEvents(barony.Id);
            var adventure = events.FirstOrDefault(e =>
                BaronAdventurePpb.IsAdventureEvent(e.Name)
                && e.StartTurn == turn
                && e.EndTurn == turn);

            if (adventure is null)
            {
                adventure = new BaronyEventDTO
                {
                    BaronyId = barony.Id,
                    Name = BaronAdventurePpb.SummaryRowName,
                    StartTurn = turn,
                    EndTurn = turn,
                    Additive = fullDelta.Clone(),
                    Description = "Campaign chapter grants this turn.",
                };
            }
            else
            {
                var merged = adventure.Additive?.Clone() ?? new PpbVector();
                merged.AddInPlace(fullDelta);
                adventure.Additive = merged;
            }

            await _baronyRepo.SaveEvent(adventure);

            var stockDelta = ResourceCatalog.Slice(fullDelta);
            if (!stockDelta.IsEmpty)
            {
                var stocks = ResourceCatalog.Slice(barony.ResourceStocks);
                stocks.AddInPlace(stockDelta);
                barony.ResourceStocks = stocks;
                barony.FoodInGranaries = stocks[Ppb.Food];
                barony.TreasuryGold = stocks[Ppb.Treasury];
                await _baronyRepo.UpdateBarony(barony);
            }
        }

        if (prestigeDelta != 0 || honorDelta != 0 || fearDelta != 0)
        {
            var phpSources = await _baronyRepo.GetBaronPhpSources(barony.Id);
            var adventurePhp = phpSources.FirstOrDefault(s => BaronAdventurePpb.IsAdventurePhpSource(s.Source));
            if (adventurePhp is null)
            {
                adventurePhp = new BaronPhpSourceDTO
                {
                    BaronyId = barony.Id,
                    Source = BaronAdventurePpb.PhpSourceKey,
                    Description = "Campaign chapter adventure grants.",
                };
            }

            adventurePhp.Prestige += prestigeDelta;
            adventurePhp.Honor += honorDelta;
            adventurePhp.Fear += fearDelta;
            await _baronyRepo.SaveBaronPhpSource(adventurePhp);

            // Keep Barony.Prestige/Honor/Fear in sync with Baron Card totals.
            var audiences = await _baronyRepo.GetAudiences(barony.Id);
            var sources = await _baronyRepo.GetBaronPhpSources(barony.Id);
            var artifacts = await _baronyRepo.GetBaronArtifacts(barony.Id);
            var seat = await _baronyRepo.EnsureSeat(barony.Id);
            var purposes = await _baronyRepo.GetSeatPurposeTemplates(barony.Id);
            var seatPhp = BaronyCalc.SeatPhpContribution(seat, purposes);
            var itemsPhp = BaronyCalc.ArtifactsPhpContribution(artifacts, seat);
            var adventuresPhp = BaronyCalc.AdventuresPhpContribution(audiences, sources);
            var total = BaronyCalc.SumPhpRows(
                BaronyCalc.BuildPhpRows(seatPhp, itemsPhp, sources, adventuresPhp));
            barony.Prestige = total.Prestige;
            barony.Honor = total.Honor;
            barony.Fear = total.Fear;
            await _baronyRepo.UpdateBarony(barony);
        }

        SnackBar.Add(L["Barony resources applied."], Severity.Success);
    }

    private async Task<BaronyDTO?> ResolveBaronCampaignBaronyAsync()
    {
        if (Chapter is null || Chapter.CampaignId <= 0)
            return null;

        var campaign = await _campaignRepository.GetById(Chapter.CampaignId);
        if (campaign is null || campaign.Id <= 0)
            return null;

        var characterIds = Chapter.Characters
            .Select(c => c.Id)
            .Concat(campaign.Characters?.Select(c => c.Id) ?? Enumerable.Empty<int>())
            .Where(id => id > 0)
            .Distinct()
            .ToList();

        foreach (var characterId in characterIds)
        {
            var barony = await _baronyRepo.GetByCharacterId(characterId);
            if (barony is null)
                continue;

            if (string.Equals(campaign.Name, barony.Name, StringComparison.OrdinalIgnoreCase))
                return barony;
        }

        // Fallback: match any barony whose name equals the campaign name.
        var summaries = await _baronyRepo.GetAllSummaries();
        var match = summaries.FirstOrDefault(s =>
            string.Equals(s.Name, campaign.Name, StringComparison.OrdinalIgnoreCase));
        if (match is not null)
            return await _baronyRepo.GetById(match.Id);

        return null;
    }

    private async Task RefreshBaronCampaignFlagAsync()
    {
        _isBaronCampaign = false;
        if (Chapter is null || Chapter.CampaignId <= 0)
            return;

        try
        {
            var barony = await ResolveBaronCampaignBaronyAsync();
            if (barony is not null)
            {
                _isBaronCampaign = true;
                return;
            }

            var campaign = await _campaignRepository.GetById(Chapter.CampaignId);
            if (campaign is not null
                && !string.IsNullOrWhiteSpace(campaign.Description)
                && campaign.Description.StartsWith("Campaign for the barony of", StringComparison.OrdinalIgnoreCase))
            {
                _isBaronCampaign = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to detect baron campaign for chapter {ChapterId}", Id);
            _isBaronCampaign = false;
        }
    }

    private async Task<CharacterDTO?> ResolveGameMasterActorAsync()
    {
        if (UserInfo?.CharacterMG == true && UserInfo.SelectedCharacter is not null)
            return UserInfo.SelectedCharacter;

        try
        {
            var gm = await _characterRepository.GetByName(SD.GameMaster_NPCName);
            if (gm is not null && gm.Id > 0)
            {
                gm.ImageUrl = string.IsNullOrWhiteSpace(gm.ImageUrl) ? SD.GameMaster_Portrait : gm.ImageUrl;
                gm.NPCName = string.IsNullOrWhiteSpace(gm.NPCName) ? SD.GameMaster_NPCName : gm.NPCName;
                return gm;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to resolve Game Master character for barony resources post");
        }

        // Last resort: keep a valid CharacterId for FK, portrait still forced via AlternativeImageUrl.
        return UserInfo?.SelectedCharacter ?? Chapter?.Characters.FirstOrDefault();
    }

    private static string BuildBaronyResourcePostHtml(PpbVector ppbDelta, int prestigeDelta, int honorDelta, int fearDelta)
    {
        static string FormatDelta(decimal value) => value > 0 ? $"+{value:0.#}" : value.ToString("0.#");
        var payload = System.Text.Json.JsonSerializer.Serialize(new
        {
            PpbDelta = ppbDelta,
            PrestigeDelta = prestigeDelta,
            HonorDelta = honorDelta,
            FearDelta = fearDelta
        });

        var sb = new System.Text.StringBuilder();
        sb.Append("<p><strong>Barony resources update</strong><br>");
        foreach (var info in PpbCatalog.All)
        {
            var value = ppbDelta[info.Key];
            if (value == 0m)
                continue;
            AppendColoredResourceLine(sb, info.Name, FormatDelta(value), PpbVisuals.ColorHex(info.Key), PpbVisuals.IconUrl(info.Key));
        }

        if (prestigeDelta != 0)
            AppendColoredResourceLine(sb, "Prestige", FormatDelta(prestigeDelta), "#b08a2e", BaronPhpVisuals.PrestigeIconUrl);
        if (honorDelta != 0)
            AppendColoredResourceLine(sb, "Honor", FormatDelta(honorDelta), "#3a5f8a", BaronPhpVisuals.HonorIconUrl);
        if (fearDelta != 0)
            AppendColoredResourceLine(sb, "Fear", FormatDelta(fearDelta), "#7a3030", BaronPhpVisuals.FearIconUrl);

        // Trim trailing <br> before closing paragraph.
        if (sb.Length >= 4 && sb.ToString(sb.Length - 4, 4) == "<br>")
            sb.Length -= 4;
        sb.Append("</p>");
        sb.Append("<!--BARONY_RESOURCE:").Append(payload).Append("-->");
        return sb.ToString();
    }

    private static void AppendColoredResourceLine(
        System.Text.StringBuilder sb,
        string name,
        string formattedDelta,
        string colorHex,
        string? iconUrl)
    {
        sb.Append("<span style=\"color:").Append(colorHex).Append("; font-weight:600;\">");
        if (!string.IsNullOrEmpty(iconUrl))
        {
            sb.Append("<img src=\"").Append(iconUrl)
              .Append("\" alt=\"\" width=\"14\" height=\"14\" style=\"vertical-align:-2px; margin-right:4px;\" />");
        }
        sb.Append(name).Append(": ").Append(formattedDelta).Append("</span><br>");
    }

    private async Task OpenBattleMap()
    {
        if (Chapter is null) return;

        var participants = Chapter.Characters
            .Where(c => string.IsNullOrWhiteSpace(c.NPCName) == false)
            .Select(c => new BattleMapParticipantDTO
            {
                Label = c.NPCName!,
                IconUrl = !string.IsNullOrEmpty(c.IconUrl) ? c.IconUrl : c.ImageUrl,
                IsMob = false,
                Range = GetCharacterMapRange(c.Id),
                IsAlly = true,
                Condition = GetCharacterCondition(c.Id)
            })
            .Concat(Mobs
                .Where(m => string.IsNullOrWhiteSpace(m.Name) == false)
                .Select(m => new BattleMapParticipantDTO
                {
                    Label = m.Name,
                    IsMob = true,
                    Range = m.Speed,
                    IsAlly = m.Relation == Relation.Ally,
                    Condition = GetMobCondition(m.States)
                }))
            .OrderBy(p => p.Label, StringComparer.OrdinalIgnoreCase)
            .ToList();

        var parameters = new DialogParameters<BattleMapDialog>
        {
            { x => x.ChapterId, Id },
            { x => x.CampaignId, Chapter.CampaignId },
            { x => x.CanEdit, UserInfo?.IsAdminOrMG == true },
            { x => x.Participants, participants }
        };

        var isFs = await _viewportService.GetCurrentBreakpointAsync() <= Breakpoint.Md;
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.False,
            FullWidth = isFs,
            FullScreen = isFs,
            CloseButton = true
        };
        await DialogService.ShowAsync<BattleMapDialog>("Tactical Map", parameters, options);
    }

    // Incapacitating state for the tactical map (greys the token). Dead takes priority.
    private string? GetCharacterCondition(int characterId)
    {
        if (!CharacterAllParams.TryGetValue(characterId, out var allParams) || allParams?.TraitsTemporary is null)
            return null;

        if (allParams.TraitsTemporary.Any(t => t.Name == States.Names.Dead))
            return States.Names.Dead;
        if (allParams.TraitsTemporary.Any(t => t.Name == States.Names.Unconscious))
            return States.Names.Unconscious;
        return null;
    }

    private static string? GetMobCondition(string? states)
    {
        if (CombatStateString.HasState(states, States.Names.Dead))
            return States.Names.Dead;
        if (CombatStateString.HasState(states, States.Names.Unconscious))
            return States.Names.Unconscious;
        return null;
    }

    // Tactical map movement range for a character: 5 + floor(sum of Running / 4).
    private int GetCharacterMapRange(int characterId)
    {
        var runningSum = CharacterAllParams.TryGetValue(characterId, out var allParams) && allParams is not null
            ? allParams.SpecialSkills.Get(SD.SpecialSkills.Acrobatics.Running).SumBonus
            : 0;
        return 5 + (int)Math.Floor(runningSum / 4.0);
    }

    private static bool IsPortraitHidden(PostDTO post) =>
        post.AlternativeImageUrl == SD.PostNoPortrait;

    private static bool IsBattleSummaryPost(PostDTO post) =>
        post.AlternativeName is "Battle turn" or "Battle ended" or "Battle started"
        || (post.AlternativeName?.StartsWith("Battle turn ", StringComparison.Ordinal) ?? false)
        || (post.AlternativeName?.StartsWith("Battle ended ", StringComparison.Ordinal) ?? false);

    private static bool IsBattleEndedPost(PostDTO post) =>
        post.AlternativeName is "Battle ended"
        || (post.AlternativeName?.StartsWith("Battle ended ", StringComparison.Ordinal) ?? false);

    // "Battle ended {phaseId}" posts carry the id of the battle whose log they summarize.
    private static bool TryGetBattlePhaseIdFromPost(PostDTO post, out int phaseId)
    {
        phaseId = 0;
        const string prefix = "Battle ended ";
        if (post.AlternativeName?.StartsWith(prefix, StringComparison.Ordinal) != true)
            return false;

        return int.TryParse(post.AlternativeName.AsSpan(prefix.Length).Trim(), out phaseId) && phaseId > 0;
    }

    private static string GetBattleSummaryHeader(PostDTO post)
    {
        if (post.AlternativeName?.StartsWith("Battle turn ", StringComparison.Ordinal) == true)
            return $"{post.AlternativeName.Trim()} begins";

        if (IsBattleEndedPost(post))
            return "Battle ended";

        if (post.AlternativeName is "Battle turn")
        {
            var match = System.Text.RegularExpressions.Regex.Match(
                post.Content ?? string.Empty,
                @"Battle turn (\d+) begins",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            if (match.Success)
                return $"Battle turn {match.Groups[1].Value} begins";

            return "Battle turn";
        }

        return post.AlternativeName switch
        {
            "Battle started" => "Battle begins",
            "Battle ended" => "Battle ended",
            _ => post.AlternativeName ?? "Battle"
        };
    }

    private static string GetBattleSummaryContent(PostDTO post)
    {
        var content = post.Content ?? string.Empty;
        if (string.IsNullOrEmpty(content))
            return content;

        content = System.Text.RegularExpressions.Regex.Replace(
            content,
            @"<span[^>]*font-size:\s*1\.3em[^>]*>.*?</span>\s*",
            string.Empty,
            System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Singleline);

        var headline = GetBattleSummaryHeader(post);
        if (!string.IsNullOrEmpty(headline))
        {
            var escaped = System.Text.RegularExpressions.Regex.Escape(headline);
            content = System.Text.RegularExpressions.Regex.Replace(
                content,
                $@"<p>\s*<strong>\s*{escaped}\s*</strong>\s*(<br\s*/?>\s*)*",
                "<p>",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        }

        content = System.Text.RegularExpressions.Regex.Replace(
            content,
            @"<p>\s*(<br\s*/?>\s*)+",
            "<p>",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        return content;
    }

    private bool CanEditBattleSummaryPost(PostDTO post) =>
        UserInfo?.IsAdminOrMG == true && IsBattleSummaryPost(post);

    // Single entry point for recording an event. It only persists to the DB now; every summary
    // (turn and battle) reads back from the DB, so there is no in-memory event buffer to keep in sync.
    private async Task AddTurnEvent(BattleTurnEvent e) => await PersistBattleEventAsync(e);

    // Deciding what is worth surfacing in the end-of-battle report:
    // - kills and knock-outs are always Major (that is the outcome of the fight),
    // - wounds are Major only when a player character takes them; mob wounds stay per-turn only,
    // - everything else (states, bleeding pain tests) is Minor.
    private static BattleEventImportance GetEventImportance(BattleTurnEventKind kind, bool targetIsCharacter) => kind switch
    {
        BattleTurnEventKind.Dead or BattleTurnEventKind.Unconscious => BattleEventImportance.Major,
        BattleTurnEventKind.Wound => targetIsCharacter ? BattleEventImportance.Major : BattleEventImportance.Minor,
        _ => BattleEventImportance.Minor,
    };

    // A battle target is a "player character" when its name matches one of the chapter's characters.
    // Mobs (and anything else) are treated as non-character targets.
    private bool IsCharacterTarget(string? targetName)
    {
        if (string.IsNullOrWhiteSpace(targetName) || Chapter is null)
            return false;

        var name = targetName.Trim();
        return Chapter.Characters.Any(c =>
            !string.IsNullOrWhiteSpace(c.NPCName)
            && string.Equals(c.NPCName!.Trim(), name, StringComparison.OrdinalIgnoreCase));
    }

    private async Task PersistBattleEventAsync(BattleTurnEvent e)
    {
        if (BattlePhase is null || BattlePhase.Id < 1)
            return;

        try
        {
            var dto = new BattleEventDTO
            {
                BattlePhaseId = BattlePhase.Id,
                ChapterId = Id,
                CampaignId = Chapter?.CampaignId ?? BattlePhase.CampaignId,
                TurnNumber = BattlePhase.CurrentTurn,
                Kind = e.Kind,
                Importance = GetEventImportance(e.Kind, IsCharacterTarget(e.TargetName)),
                TargetName = GetEventTargetName(e.TargetName),
                CausedBy = e.CausedBy,
                Description = e.Description,
                CreatedDate = DateTime.Now,
            };
            await _battleEventRepository.Create(dto);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to persist battle event for chapter {ChapterId}", Id);
        }
    }

    // Authoritative source for summaries: reads events straight from the DB for the current battle.
    // Pass a turn number to get just that turn's events, or null for the whole battle.
    private async Task<List<BattleTurnEvent>> LoadBattleEventsAsync(int? turnNumber = null)
    {
        if (BattlePhase is null || BattlePhase.Id < 1)
            return new List<BattleTurnEvent>();

        try
        {
            var events = await _battleEventRepository.GetByBattlePhase(BattlePhase.Id);
            return events
                .Where(ev => turnNumber is null || ev.TurnNumber == turnNumber)
                .Select(ev => new BattleTurnEvent(ev.Kind, ev.TargetName, ev.CausedBy, ev.Description))
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load battle events for chapter {ChapterId}", Id);
            return new List<BattleTurnEvent>();
        }
    }

    private async Task RecordFightPersistenceEvents(FightPersistenceSnapshot snapshot)
    {
        var attacker = snapshot.SelectedAttacker;
        var defender = snapshot.SelectedDefender;

        if (snapshot.MobMaxWounds > 0)
        {
            var hpLog = MobHealthModel.FormatHpLog(snapshot.MobWoundsAfter, snapshot.MobMaxWounds);
            var description = snapshot.IgnoredMobDamage > 0
                ? $"{snapshot.AppliedMobDamage} damage ({snapshot.IgnoredMobDamage} ignored), {hpLog}"
                : $"{snapshot.AppliedMobDamage} damage, {hpLog}";
            await AddTurnEvent(new BattleTurnEvent(BattleTurnEventKind.Wound, defender, attacker, description));
        }
        else
        {
            foreach (var wound in snapshot.NewWounds)
            {
                if (!Wounds.IsReportableInTurnSummary(wound.Severity))
                    continue;

                var description = $"{wound.Severity} wound to {wound.Location.ToLower()}";
                await AddTurnEvent(new BattleTurnEvent(BattleTurnEventKind.Wound, defender, attacker, description));
            }

            if (snapshot.NewWounds.Count == 0
                && Wounds.IsReportableInTurnSummary(snapshot.WoundSeverity))
            {
                await AddTurnEvent(new BattleTurnEvent(BattleTurnEventKind.Wound, defender, attacker, $"{snapshot.WoundSeverity} wound"));
            }
        }

        await RecordStateEvents(snapshot.DefenderNewStates, defender, attacker);
        await RecordStateEvents(snapshot.AttackerNewStates, attacker, defender);
    }

    private async Task RecordStateEvents(string? states, string target, string? causedBy)
    {
        if (string.IsNullOrWhiteSpace(states))
            return;

        foreach (var (name, _) in CombatStateString.Parse(states))
        {
            if (name is States.Names.NoTurn or States.Names.HalfTurn)
                continue;

            if (name == States.Names.Unconscious)
                await AddTurnEvent(new BattleTurnEvent(BattleTurnEventKind.Unconscious, target, causedBy, name));
            else if (name == States.Names.Dead)
                await AddTurnEvent(new BattleTurnEvent(BattleTurnEventKind.Dead, target, causedBy, name));
            else
                await AddTurnEvent(new BattleTurnEvent(BattleTurnEventKind.State, target, causedBy, $"{name} state"));
        }
    }

    private async Task RecordStatusAddedEvent(StatusAddedSnapshot status)
    {
        if (status.StateName is States.Names.NoTurn or States.Names.HalfTurn)
            return;

        if (status.StateName == States.Names.Unconscious)
            await AddTurnEvent(new BattleTurnEvent(BattleTurnEventKind.Unconscious, status.TargetName, null, status.StateName));
        else if (status.StateName == States.Names.Dead)
            await AddTurnEvent(new BattleTurnEvent(BattleTurnEventKind.Dead, status.TargetName, null, status.StateName));
        else
            await AddTurnEvent(new BattleTurnEvent(BattleTurnEventKind.State, status.TargetName, null, $"{status.StateName} state ({status.Duration} turns)"));
    }

    private static string BoldWoundDescription(string description)
    {
        var woundIdx = description.IndexOf(" wound", StringComparison.OrdinalIgnoreCase);
        if (woundIdx <= 0)
            return description;

        return RichText.BoldText(description[..woundIdx]) + description[woundIdx..];
    }

    private static string BoldStateDescription(string description)
    {
        const string suffix = " state";
        var stateIdx = description.IndexOf(suffix, StringComparison.OrdinalIgnoreCase);
        if (stateIdx <= 0)
            return RichText.BoldText(description);

        return RichText.BoldText(description[..stateIdx]) + description[stateIdx..];
    }

    private static string FormatCausedBy(string? causedBy) =>
        string.IsNullOrEmpty(causedBy) ? string.Empty : $" (by {RichText.BoldText(causedBy)})";

    private static string FormatWoundLine(BattleTurnEvent e) =>
        $"{BoldWoundDescription(e.Description)}{FormatCausedBy(e.CausedBy)}";

    private static string GetCharacterDisplayName(CharacterDTO character) =>
        !string.IsNullOrWhiteSpace(character.NPCName) ? character.NPCName.Trim()
        : !string.IsNullOrWhiteSpace(character.UserName) ? character.UserName.Trim()
        : $"Character #{character.Id}";

    private string ResolveCharacterDisplayName(int characterId, CharacterDTO? chapterCharacter = null)
    {
        if (CharacterAllParams.TryGetValue(characterId, out var allParams) && allParams?.Character is not null)
            return GetCharacterDisplayName(allParams.Character);

        if (chapterCharacter is not null)
            return GetCharacterDisplayName(chapterCharacter);

        chapterCharacter = Chapter?.Characters.FirstOrDefault(c => c.Id == characterId);
        return chapterCharacter is not null
            ? GetCharacterDisplayName(chapterCharacter)
            : $"Character #{characterId}";
    }

    private static string GetEventTargetName(string? targetName) =>
        string.IsNullOrWhiteSpace(targetName) ? "Unknown" : targetName.Trim();

    private static string FormatTurnEvent(BattleTurnEvent e)
    {
        var target = RichText.BoldText(GetEventTargetName(e.TargetName));
        var causedBy = FormatCausedBy(e.CausedBy);
        return e.Kind switch
        {
            BattleTurnEventKind.Wound => $"{target} received {BoldWoundDescription(e.Description)}{causedBy}",
            BattleTurnEventKind.Unconscious => $"{target} became {RichText.BoldText(States.Names.Unconscious)}{causedBy}",
            BattleTurnEventKind.Dead => $"{target} died{causedBy}",
            BattleTurnEventKind.BleedingPainTest =>
                $"{target} — pain resistance test ({RichText.BoldText(States.Names.Bleeding)}): {e.Description}",
            _ => $"{target} gained {BoldStateDescription(e.Description)}{causedBy}",
        };
    }

    private static string FormatRoundCount(int rounds) =>
        rounds == 1 ? "1 round" : $"{rounds} rounds";

    private string BuildBattleEndSummaryHtml(int rounds, IReadOnlyList<BattleTurnEvent> events)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append("<p>");
        sb.Append($"The battle lasted {RichText.BoldText(FormatRoundCount(rounds))}.");
        sb.Append("<br><br>");

        var casualties = events
            .Where(e => e.Kind is BattleTurnEventKind.Dead or BattleTurnEventKind.Unconscious)
            .ToList();

        if (casualties.Count > 0)
        {
            sb.Append(RichText.BoldText("Casualties:"));
            sb.Append("<br>");
            foreach (var e in casualties)
            {
                sb.Append("&#8226; ");
                sb.Append(FormatTurnEvent(e));
                sb.Append("<br>");
            }
            sb.Append("<br>");
        }

        // Only wounds taken by player characters are notable enough for the end-of-battle report.
        var woundsByTarget = events
            .Where(e => e.Kind == BattleTurnEventKind.Wound && IsCharacterTarget(e.TargetName))
            .GroupBy(e => e.TargetName)
            .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase);

        var hasWounds = woundsByTarget.Any();
        if (hasWounds)
        {
            sb.Append(RichText.BoldText("Wounds:"));
            sb.Append("<br>");
            foreach (var group in woundsByTarget)
            {
                sb.Append(RichText.BoldText(group.Key));
                sb.Append("<br>");
                foreach (var wound in group)
                {
                    sb.Append("&#8226; ");
                    sb.Append(FormatWoundLine(wound));
                    sb.Append("<br>");
                }
                sb.Append("<br>");
            }
        }

        if (casualties.Count == 0 && !hasWounds)
            sb.Append("Nothing notable happened during the battle.");

        sb.Append("</p>");
        return sb.ToString();
    }

    private static bool IsHeroSide(Relation relation) =>
        relation is Relation.Teammate or Relation.Ally or Relation.Neutral;

    private static void AppendParticipantList(System.Text.StringBuilder sb, IReadOnlyList<BattleParticipantSnapshot> participants)
    {
        if (participants.Count == 0)
        {
            sb.Append("—");
            return;
        }

        foreach (var participant in participants)
        {
            sb.Append("&#8226; ");
            sb.Append(RichText.BoldText(participant.Name));
            sb.Append("<br>");
        }
    }

    private void AppendCombatRulesWikiLink(System.Text.StringBuilder sb)
    {
        if (!_wikiDeployed)
            return;

        sb.Append("<br><br>");
        sb.Append($"<a href=\"{CombatRulesWikiPath}\">Zasady walki</a>");
    }

    private string BuildBattleStartSummaryHtml(IReadOnlyList<BattleParticipantSnapshot> participants)
    {
        var heroes = participants
            .Where(p => IsHeroSide(p.Relation))
            .OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
        var opponents = participants
            .Where(p => p.Relation == Relation.Enemy)
            .OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

        var sb = new System.Text.StringBuilder();
        sb.Append("<p>");
        sb.Append("<table style=\"width:100%; border-collapse:collapse;\"><tr>");
        sb.Append("<td style=\"width:50%; vertical-align:top; padding-right:12px;\">");
        sb.Append(RichText.BoldText("Bohaterowie"));
        sb.Append("<br>");
        AppendParticipantList(sb, heroes);
        sb.Append("</td>");
        sb.Append("<td style=\"width:50%; vertical-align:top; padding-left:12px;\">");
        sb.Append(RichText.BoldText("Przeciwnicy"));
        sb.Append("<br>");
        AppendParticipantList(sb, opponents);
        sb.Append("</td>");
        sb.Append("</tr></table>");
        AppendCombatRulesWikiLink(sb);
        sb.Append("</p>");
        return sb.ToString();
    }

    private string BuildTurnSummaryHtml(int endingTurn, IReadOnlyList<BattleTurnEvent> events, bool battleEnding = false)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append("<p>");
        sb.Append(RichText.BoldText($"Summary of turn {endingTurn}:"));
        sb.Append("<br>");
        if (events.Count == 0)
        {
            sb.Append("Nothing notable happened.");
        }
        else
        {
            foreach (var e in events)
            {
                sb.Append("&#8226; ");
                sb.Append(FormatTurnEvent(e));
                sb.Append("<br>");
            }
        }

        if (!battleEnding)
            AppendCombatRulesWikiLink(sb);

        sb.Append("</p>");
        return sb.ToString();
    }

    private async Task PostBattleStartSummaryAsync(IReadOnlyList<BattleParticipantSnapshot> participants)
    {
        if (Chapter is null || UserInfo?.SelectedCharacter is null)
            return;

        var content = BuildBattleStartSummaryHtml(participants);

        var post = new PostDTO
        {
            ChapterId = Id,
            CreatedDate = DateTime.Now,
            Content = content,
            CharacterId = UserInfo.SelectedCharacter.Id,
            Character = UserInfo.SelectedCharacter,
            AlternativeName = "Battle started",
            AlternativeImageUrl = SD.PostNoPortrait,
        };

        var result = await _postRepository.Create(post);
        if (result is null)
            return;

        if (_hubConnection is not null)
            await _hubConnection.SendAsync("NotifyNewPost", Id, result.Id);

        await AppendPostByIdAsync(result.Id, forceScrollDown: true);
        StateHasChanged();
    }

    private async Task PostTurnSummaryAsync(int endingTurn, int startingTurn, bool battleEnding = false)
    {
        if (Chapter is null || UserInfo?.SelectedCharacter is null)
            return;

        var events = await LoadBattleEventsAsync(endingTurn);
        var content = BuildTurnSummaryHtml(endingTurn, events, battleEnding);

        var post = new PostDTO
        {
            ChapterId = Id,
            CreatedDate = DateTime.Now,
            Content = content,
            CharacterId = UserInfo.SelectedCharacter.Id,
            Character = UserInfo.SelectedCharacter,
            AlternativeName = $"Battle turn {startingTurn}",
            AlternativeImageUrl = SD.PostNoPortrait,
        };

        var result = await _postRepository.Create(post);
        if (result is null)
            return;

        if (_hubConnection is not null)
        {
            try
            {
                await _hubConnection.SendAsync("NotifyNewPost", Id, result.Id);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to notify clients about turn summary post {PostId}", result.Id);
            }
        }

        await AppendPostByIdAsync(result.Id, forceScrollDown: true);
        StateHasChanged();
    }

    private async Task PostBattleSummaryAsync(int rounds)
    {
        if (Chapter is null || UserInfo?.SelectedCharacter is null)
            return;

        var events = await LoadBattleEventsAsync();
        var content = BuildBattleEndSummaryHtml(rounds, events);

        var post = new PostDTO
        {
            ChapterId = Id,
            CreatedDate = DateTime.Now,
            Content = content,
            CharacterId = UserInfo.SelectedCharacter.Id,
            Character = UserInfo.SelectedCharacter,
            // Embed the battle id so the post can later link back to that battle's log.
            AlternativeName = BattlePhase is not null ? $"Battle ended {BattlePhase.Id}" : "Battle ended",
            AlternativeImageUrl = SD.PostNoPortrait,
        };

        var result = await _postRepository.Create(post);
        if (result is null)
            return;

        if (_hubConnection is not null)
            await _hubConnection.SendAsync("NotifyNewPost", Id, result.Id);

        await AppendPostByIdAsync(result.Id, forceScrollDown: true);
        StateHasChanged();
    }

