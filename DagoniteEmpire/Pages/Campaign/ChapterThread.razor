    private async Task NextTurn()
    {
        var currentTurn = BattlePhase?.CurrentTurn ?? 0;
        var nextTurn = currentTurn + 1;
        bool? confirmed = await DialogMessageBox.ShowCompactAsync(
            DialogService,
            "Next turn",
            currentTurn > 0
                ? $"End turn {currentTurn}, start turn {nextTurn}?"
                : "Advance to next battle turn?",
            "Temporary states lose 1 turn",
            yesText: "Next turn");
        if (confirmed is not true)
            return;

        try
        {
            IReadOnlyList<BleedingParticipantSnapshot> bleedingParticipants = Array.Empty<BleedingParticipantSnapshot>();
            if (BattlePhase is not null)
                bleedingParticipants = await CaptureBleedingParticipantsAsync();

            await AdvanceTurnStatesAsync();

            if (BattlePhase is not null)
            {
                try
                {
                    await ProcessBleedingTurnTestsAsync(bleedingParticipants);
                    await PostTurnSummaryAsync(BattlePhase.CurrentTurn, BattlePhase.CurrentTurn + 1);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to post turn summary for chapter {ChapterId}", Id);
                    SnackBar.Add(L["Turn summary post failed, but turn states were still advanced."], Severity.Warning);
                }
            }

            if (BattlePhase is not null)
            {
                BattlePhase.CurrentTurn++;
                BattlePhase = await _battlePhaseRepository.Update(BattlePhase);
                SnackBar.Add(L["Turn {0} started", BattlePhase.CurrentTurn], Severity.Info);
            }

            await RefreshBattleParticipantsAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error in Next turn action for chapter {ChapterId}", Id);
            SnackBar.Add(L["Error in Next turn action: "] + ex.Message, Severity.Error);
        }
    }

    private async Task<IReadOnlyList<BleedingParticipantSnapshot>> CaptureBleedingParticipantsAsync()
    {
        if (Chapter is null)
            return Array.Empty<BleedingParticipantSnapshot>();

        var snapshots = new List<BleedingParticipantSnapshot>();

        foreach (var charac in Chapter.Characters)
        {
            var traits = (await _traitCharacterRepository.GetAll(charac.Id)).ToList();
            var bleeding = traits.FirstOrDefault(t => t.IsTemporary && t.Name == States.Names.Bleeding);
            if (bleeding is null || bleeding.TraitValue <= 0)
                continue;

            if (traits.Any(t => t.IsTemporary && t.Name is States.Names.Unconscious or States.Names.Dead))
                continue;

            var painResistance = CharacterAllParams.TryGetValue(charac.Id, out var allParams) && allParams is not null
                ? allParams.SpecialSkills.Get(SD.SpecialSkills.Athletics.PainResistance).SumBonus
                : (await LoadCharacter(charac.Id)).SpecialSkills.Get(SD.SpecialSkills.Athletics.PainResistance).SumBonus;

            snapshots.Add(new BleedingParticipantSnapshot(
                charac.Id,
                null,
                ResolveCharacterDisplayName(charac.Id, charac),
                bleeding.TraitValue,
                painResistance));
        }

        foreach (var mob in Mobs)
        {
            if (!BleedingTurnModel.TryParseMobStateDuration(mob.States, States.Names.Bleeding, out var turnsRemaining)
                || turnsRemaining <= 0)
                continue;

            if (BleedingTurnModel.MobHasState(mob.States, States.Names.Unconscious)
                || BleedingTurnModel.MobHasState(mob.States, States.Names.Dead))
                continue;

            snapshots.Add(new BleedingParticipantSnapshot(
                null,
                mob,
                mob.Name,
                turnsRemaining,
                mob.PainResSkillValue));
        }

        return snapshots;
    }

    private async Task ProcessBleedingTurnTestsAsync(IReadOnlyList<BleedingParticipantSnapshot> participants)
    {
        foreach (var participant in participants)
        {
            var test = BleedingTurnModel.RunPainTest(participant.BleedingTurnsRemaining, participant.PainResistance);
            await RecordBleedingPainTestEvent(participant.DisplayName, test);

            if (test.Passed)
                continue;

            if (participant.CharacterId is int charId)
            {
                await AddFightStatesAsync($"{States.Names.Unconscious}:{test.UnconsciousDuration}, ", charId);
                await AddTurnEvent(new BattleTurnEvent(BattleTurnEventKind.Unconscious, participant.DisplayName, null, States.Names.Unconscious));
            }
            else if (participant.Mob is not null)
            {
                participant.Mob.States = FightSequenceModel.MergeMobStates(
                    participant.Mob.States,
                    $"{States.Names.Unconscious}:{test.UnconsciousDuration}, ");
                await _mobRepository.Update(participant.Mob);
                await AddTurnEvent(new BattleTurnEvent(BattleTurnEventKind.Unconscious, participant.DisplayName, null, States.Names.Unconscious));
            }
        }
    }

    private async Task RecordBleedingPainTestEvent(string targetName, BleedingPainTestResult test)
    {
        var description = $"DC {test.Dc}: {test.ResultText}";
        await AddTurnEvent(new BattleTurnEvent(BattleTurnEventKind.BleedingPainTest, targetName, null, description));
    }

    private async Task AdvanceTurnStatesAsync()
    {
        if (Chapter is not null)
        {
            foreach (var charac in Chapter.Characters)
            {
                var temporaryTraits = (await _traitCharacterRepository.GetAll(charac.Id))
                    .Where(t => t.IsTemporary)
                    .ToList();

                var traitsToDelete = new List<TraitCharacterDTO>();
                foreach (var trait in temporaryTraits)
                {
                    trait.TraitValue = BattleTurnService.DecrementDuration(trait.TraitValue);
                    if (BattleTurnService.IsExpired(trait.TraitValue))
                        traitsToDelete.Add(trait);
                    else
                        await _traitCharacterRepository.Update(trait);
                }

                foreach (var trait in traitsToDelete)
                    await _traitCharacterRepository.Delete(trait.Id);
            }
        }

        foreach (var mob in Mobs)
        {
            mob.States = BattleTurnService.AdvanceMobStates(mob.States);
            await _mobRepository.Update(mob);
        }
    }

    private async Task EndBattlePhase()
    {
        bool? result = await DialogMessageBox.ShowCompactAsync(
            DialogService,
            L["End battle"],
            L["End battle now?"],
            L["All temporary states will be cleared"],
            yesText: L["Yes"],
            cancelText: L["No"]);
        if (result is null || result == false)
        {
            return;
        }

        if (BattlePhase is not null)
        {
            var finalTurnEvents = await LoadBattleEventsAsync(BattlePhase.CurrentTurn);
            if (finalTurnEvents.Count > 0)
            {
                try
                {
                    await PostTurnSummaryAsync(BattlePhase.CurrentTurn, BattlePhase.CurrentTurn, battleEnding: true);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to post final turn summary for chapter {ChapterId}", Id);
                }
            }
        }

        foreach (var characterParams in CharacterAllParams.Values)
        {
            if (characterParams?.TraitsTemporary is null || characterParams.TraitsTemporary.Any() == false) continue;
            foreach (var trait in characterParams.TraitsTemporary)
            {
                if (BattleTurnService.PersistsAfterBattle(trait.Name)) continue;
                await _traitCharacterRepository.Delete(trait.Id);
            }
            characterParams.TraitsTemporary = new List<TraitDTO>();
        }

        foreach (var mob in Mobs)
        {
            mob.States = BattleTurnService.ResolveEndOfBattleMobStates(mob.States);
            await _mobRepository.Update(mob);
        }
        if (BattlePhase is not null)
        {
            var rounds = BattlePhase.CurrentTurn;
            await PostBattleSummaryAsync(rounds);

            BattlePhase.BattleOngoing = OngoingBattle = false;
            BattlePhase = await _battlePhaseRepository.Update(BattlePhase);
            BattlePhase = null;
            await LoadMobs();
            await LoadChapter(goToLastPage: true);
            SnackBar.Add(L["Battle Ended"], Severity.Normal);
        }
    }

    private async Task GenerateFightSequence()
    {
        if (Chapter is null) return;
        var parameters = new DialogParameters<CreateFightSequenceDialog> 
        { 
            { x => x.CharacterAllParams, CharacterAllParams.Values },
            { x => x.Mobs, Mobs },
            { x => x.Date, Chapter.Date },
            { x => x.ChapterId, Id }
        };

        var dialog = await DialogService.ShowAsync<CreateFightSequenceDialog>("Fight sequence", parameters, await SetFightDialogOptions());
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is FightSequenceDialogResult fightResult)
        {
            if (fightResult.Persistence is not null)
                await PersistFightAsync(fightResult.Persistence);

            _open = false;
            await RefreshBattleParticipantsAsync();
            await AppendRollToPostEditorAsync(fightResult.RichHtml, fightResult.WrapForThread, fightFormat: true);

            if (!string.IsNullOrEmpty(fightResult.AttackerName))
                SnackBar.Add(L["Fight sequence performed. {0} attacks {1}", fightResult.AttackerName, fightResult.DefenderName], Severity.Success);

            if (UserInfo?.CharacterMG != true)
            {
                SnackBar.Add(L["Selected character is not Game Master — review the fight result before posting."], Severity.Warning, config =>
                {
                    config.VisibleStateDuration = 60_000;
                    config.ShowCloseIcon = true;
                });
            }

            StateHasChanged();
        }
    }

    private async Task PersistFightAsync(FightPersistenceSnapshot snapshot)
    {
        try
        {
            AllParamsModel? attackerChar = null;
            AllParamsModel? defenderChar = null;
            MobDTO? attackerMob = null;
            MobDTO? defenderMob = null;

            foreach (var charParams in CharacterAllParams.Values)
            {
                if (charParams is null) continue;
                if (charParams.Character.NPCName == snapshot.SelectedAttacker)
                    attackerChar = charParams;
                if (charParams.Character.NPCName == snapshot.SelectedDefender)
                    defenderChar = charParams;
            }

            foreach (var mob in Mobs)
            {
                if (mob is null) continue;
                if (mob.Name == snapshot.SelectedAttacker)
                    attackerMob = mob;
                if (mob.Name == snapshot.SelectedDefender)
                    defenderMob = mob;
            }

            if (attackerChar is not null && string.IsNullOrEmpty(snapshot.AttackerNewStates) == false)
                await AddFightStatesAsync(snapshot.AttackerNewStates, attackerChar.Character.Id);

            if (defenderChar is not null)
            {
                foreach (var wound in snapshot.NewWounds)
                {
                    wound.CharacterId = defenderChar.Character.Id;
                    await _woundRepository.Create(wound);
                }

                if (string.IsNullOrEmpty(snapshot.DefenderNewStates) == false)
                    await AddFightStatesAsync(snapshot.DefenderNewStates, defenderChar.Character.Id);
            }

            if (attackerMob is not null && string.IsNullOrEmpty(snapshot.AttackerNewStates) == false)
            {
                attackerMob.States = FightSequenceModel.MergeMobStates(attackerMob.States, snapshot.AttackerNewStates);
                await _mobRepository.Update(attackerMob);
            }

            if (defenderMob is not null)
            {
                defenderMob.CurrentWounds += snapshot.AppliedMobDamage;
                var overflow = FightSequenceModel.EvaluateMobWoundOverflow(
                    defenderMob.CurrentWounds,
                    defenderMob.MaxWounds);

                if (overflow.IsDead)
                {
                    defenderMob.States = overflow.NewStates;
                }
                else
                {
                    if (string.IsNullOrEmpty(snapshot.DefenderNewStates) == false)
                        defenderMob.States = FightSequenceModel.MergeMobStates(defenderMob.States, snapshot.DefenderNewStates);

                    if (overflow.IsUnconscious
                        && CombatStateString.HasState(defenderMob.States, States.Names.Unconscious) == false)
                    {
                        defenderMob.States = FightSequenceModel.MergeMobStates(defenderMob.States, overflow.NewStates);
                    }
                }

                await _mobRepository.Update(defenderMob);
            }

            await RecordFightPersistenceEvents(snapshot);
        }
        catch (Exception ex)
        {
            SnackBar.Add(L["Error while calculating fight: "] + ex.Message, Severity.Error);
        }
    }

    private async Task AddFightStatesAsync(string stateString, int charId)
    {
        if (string.IsNullOrEmpty(stateString))
            return;

        foreach (var (name, duration) in CombatStateString.Parse(stateString))
        {
            var traits = (await _traitCharacterRepository.GetAll(charId)).ToList();
            if (name == States.Names.NoTurn)
            {
                var halfTurnTrait = traits.FirstOrDefault(t => t.Name == States.Names.HalfTurn);
                if (halfTurnTrait is not null)
                    await _traitCharacterRepository.Delete(halfTurnTrait.Id);
            }

            var existingTrait = traits.FirstOrDefault(t => t.Name == name);
            if (existingTrait is not null)
            {
                existingTrait.TraitValue = duration;
                await _traitCharacterRepository.Update(existingTrait);
            }
            else
            {
                await _traitCharacterRepository.Create(StateSeeder.GetStateDTO(name, false, duration, charId));
            }
        }
    }

