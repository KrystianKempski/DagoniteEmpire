    private async Task ExpandEditor()
    {
        if (_editorExpanded)
            return;

        _isNarrowViewport = await _viewportService.GetCurrentBreakpointAsync() <= Breakpoint.Md;
        _editorExpanded = true;
        StateHasChanged();
        await FocusPostEditorAsync();
        await SyncOutsideCollapseListenerAsync();
    }

    private void CollapseEditor()
    {
        _editorExpanded = false;
        _editorFullScreen = false;
    }

    private void ToggleToolbar()
    {
        _toolbarExpanded = !_toolbarExpanded;
    }

    private async Task ToggleFullScreen()
    {
        _editorFullScreen = !_editorFullScreen;
        if (_editorFullScreen && !_editorExpanded)
            _editorExpanded = true;

        StateHasChanged();
        await SyncOutsideCollapseListenerAsync();
    }

    [JSInvokable]
    public Task CollapseEditorFromJs()
    {
        if (!_editorExpanded)
            return Task.CompletedTask;

        // Never auto-collapse while the editor is maximised.
        if (_editorFullScreen)
            return Task.CompletedTask;

        _editorExpanded = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task FocusPostEditorAsync()
    {
        try
        {
            await _jsRuntime.InvokeVoidAsync("QuillPostEditor.focus", PostEditorHostId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to focus post editor");
        }
    }

    private async Task SyncOutsideCollapseListenerAsync()
    {
        try
        {
            if (_editorExpanded && !_outsideCollapseRegistered)
            {
                _dotNetRef ??= DotNetObjectReference.Create(this);
                await _jsRuntime.InvokeVoidAsync(
                    "QuillPostEditor.enableOutsideClickCollapse",
                    PostDockId,
                    _dotNetRef,
                    nameof(CollapseEditorFromJs));
                _outsideCollapseRegistered = true;
            }
            else if (!_editorExpanded && _outsideCollapseRegistered)
            {
                await _jsRuntime.InvokeVoidAsync("QuillPostEditor.disableOutsideClickCollapse", PostDockId);
                _outsideCollapseRegistered = false;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to sync outside-click collapse listener");
        }
    }

