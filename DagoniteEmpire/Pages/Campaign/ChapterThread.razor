    private async Task NextTurn()
    {
        var currentTurn = BattlePhase?.CurrentTurn ?? 0;
        var nextTurn = currentTurn + 1;
        bool? confirmed = await DialogMessageBox.ShowCompactAsync(
            DialogService,
            "Next turn",
            currentTurn > 0
                ? $"End turn {currentTurn}, start turn {nextTurn}?"
                : "Advance to next battle turn?",
            "Temporary states lose 1 turn",
            yesText: "Next turn");
        if (confirmed is not true)
            return;

        try
        {
            IReadOnlyList<BleedingParticipantSnapshot> bleedingParticipants = Array.Empty<BleedingParticipantSnapshot>();
            if (BattlePhase is not null)
                bleedingParticipants = await CaptureBleedingParticipantsAsync();

            await AdvanceTurnStatesAsync();

            if (BattlePhase is not null)
            {
                try
                {
                    await ProcessBleedingTurnTestsAsync(bleedingParticipants);
                    await PostTurnSummaryAsync(BattlePhase.CurrentTurn, BattlePhase.CurrentTurn + 1);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to post turn summary for chapter {ChapterId}", Id);
                    SnackBar.Add("Turn summary post failed, but turn states were still advanced.", Severity.Warning);
                }
            }

            if (BattlePhase is not null)
            {
                BattlePhase.CurrentTurn++;
                BattlePhase = await _battlePhaseRepository.Update(BattlePhase);
                SnackBar.Add($"Turn {BattlePhase.CurrentTurn} started", Severity.Info);
            }

            await RefreshBattleParticipantsAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error in Next turn action for chapter {ChapterId}", Id);
            SnackBar.Add($"Error in Next turn action: " + ex.Message, Severity.Error);
        }
    }

    private async Task<IReadOnlyList<BleedingParticipantSnapshot>> CaptureBleedingParticipantsAsync()
    {
        if (Chapter is null)
            return Array.Empty<BleedingParticipantSnapshot>();

        var snapshots = new List<BleedingParticipantSnapshot>();

        foreach (var charac in Chapter.Characters)
        {
            var traits = (await _traitCharacterRepository.GetAll(charac.Id)).ToList();
            var bleeding = traits.FirstOrDefault(t => t.IsTemporary && t.Name == States.Names.Bleeding);
            if (bleeding is null || bleeding.TraitValue <= 0)
                continue;

            if (traits.Any(t => t.IsTemporary && t.Name is States.Names.Unconscious or States.Names.Dead))
                continue;

            var painResistance = CharacterAllParams.TryGetValue(charac.Id, out var allParams) && allParams is not null
                ? allParams.SpecialSkills.Get(SD.SpecialSkills.Athletics.PainResistance).SumBonus
                : (await LoadCharacter(charac.Id)).SpecialSkills.Get(SD.SpecialSkills.Athletics.PainResistance).SumBonus;

            snapshots.Add(new BleedingParticipantSnapshot(
                charac.Id,
                null,
                ResolveCharacterDisplayName(charac.Id, charac),
                bleeding.TraitValue,
                painResistance));
        }

        foreach (var mob in Mobs)
        {
            if (!BleedingTurnModel.TryParseMobStateDuration(mob.States, States.Names.Bleeding, out var turnsRemaining)
                || turnsRemaining <= 0)
                continue;

            if (BleedingTurnModel.MobHasState(mob.States, States.Names.Unconscious)
                || BleedingTurnModel.MobHasState(mob.States, States.Names.Dead))
                continue;

            snapshots.Add(new BleedingParticipantSnapshot(
                null,
                mob,
                mob.Name,
                turnsRemaining,
                mob.PainResSkillValue));
        }

        return snapshots;
    }

    private async Task ProcessBleedingTurnTestsAsync(IReadOnlyList<BleedingParticipantSnapshot> participants)
    {
        foreach (var participant in participants)
        {
            var test = BleedingTurnModel.RunPainTest(participant.BleedingTurnsRemaining, participant.PainResistance);
            RecordBleedingPainTestEvent(participant.DisplayName, test);

            if (test.Passed)
                continue;

            if (participant.CharacterId is int charId)
            {
                await AddFightStatesAsync($"{States.Names.Unconscious}:{test.UnconsciousDuration}, ", charId);
                AddTurnEvent(new BattleTurnEvent(BattleTurnEventKind.Unconscious, participant.DisplayName, null, States.Names.Unconscious));
            }
            else if (participant.Mob is not null)
            {
                participant.Mob.States = FightSequenceModel.MergeMobStates(
                    participant.Mob.States,
                    $"{States.Names.Unconscious}:{test.UnconsciousDuration}, ");
                await _mobRepository.Update(participant.Mob);
                AddTurnEvent(new BattleTurnEvent(BattleTurnEventKind.Unconscious, participant.DisplayName, null, States.Names.Unconscious));
            }
        }
    }

    private void RecordBleedingPainTestEvent(string targetName, BleedingPainTestResult test)
    {
        var description = $"DC {test.Dc}: {test.ResultText}";
        _turnEvents.Add(new BattleTurnEvent(BattleTurnEventKind.BleedingPainTest, targetName, null, description));
    }

    private async Task AdvanceTurnStatesAsync()
    {
        if (Chapter is not null)
        {
            foreach (var charac in Chapter.Characters)
            {
                var temporaryTraits = (await _traitCharacterRepository.GetAll(charac.Id))
                    .Where(t => t.IsTemporary)
                    .ToList();

                var traitsToDelete = new List<TraitCharacterDTO>();
                foreach (var trait in temporaryTraits)
                {
                    trait.TraitValue = BattleTurnService.DecrementDuration(trait.TraitValue);
                    if (BattleTurnService.IsExpired(trait.TraitValue))
                        traitsToDelete.Add(trait);
                    else
                        await _traitCharacterRepository.Update(trait);
                }

                foreach (var trait in traitsToDelete)
                    await _traitCharacterRepository.Delete(trait.Id);
            }
        }

        foreach (var mob in Mobs)
        {
            mob.States = BattleTurnService.AdvanceMobStates(mob.States);
            await _mobRepository.Update(mob);
        }
    }

    private async Task EndBattlePhase()
    {
        bool? result = await DialogMessageBox.ShowCompactAsync(
            DialogService,
            "End battle",
            "End battle now?",
            "All temporary states will be cleared",
            yesText: "Yes",
            cancelText: "No");
        if (result is null || result == false)
        {
            return;
        }

        if (_turnEvents.Count > 0 && BattlePhase is not null)
        {
            try
            {
                await PostTurnSummaryAsync(BattlePhase.CurrentTurn, BattlePhase.CurrentTurn, battleEnding: true);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to post final turn summary for chapter {ChapterId}", Id);
            }
        }

        foreach (var characterParams in CharacterAllParams.Values)
        {
            if (characterParams?.TraitsTemporary is null || characterParams.TraitsTemporary.Any() == false) continue;
            foreach (var trait in characterParams.TraitsTemporary)
            {
                if (BattleTurnService.PersistsAfterBattle(trait.Name)) continue;
                await _traitCharacterRepository.Delete(trait.Id);
            }
            characterParams.TraitsTemporary = new List<TraitDTO>();
        }

        foreach (var mob in Mobs)
        {
            mob.States = BattleTurnService.ResolveEndOfBattleMobStates(mob.States);
            await _mobRepository.Update(mob);
        }
        BattleButton = "Start Battle";
        if (BattlePhase is not null)
        {
            var rounds = BattlePhase.CurrentTurn;
            await PostBattleSummaryAsync(rounds);

            BattlePhase.BattleOngoing = OngoingBattle = false;
            BattlePhase = await _battlePhaseRepository.Update(BattlePhase);
            BattlePhase = null;
            await LoadMobs();
            await LoadChapter(goToLastPage: true);
            SnackBar.Add($"Battle Ended", Severity.Normal);
        }
    }

    private async Task GenerateFightSequence()
    {
        if (Chapter is null) return;
