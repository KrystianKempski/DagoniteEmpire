@page "/campaignlist"

@using DA_Business.Services.Interfaces
@using BreadcrumbItem = MudBlazor.BreadcrumbItem;
@inject NavigationManager _navigationManager
@inject ISnackbar _snackBar
@inject IDialogService DialogService
@inject IJSRuntime _jsRuntime
@inject ICharacterRepository _characterRepository
@inject ICampaignRepository _campaignRepository
@inject IChapterRepository _chapterRepository
@inject IUserService _userService
@inject IPostRepository _postRepository
@inject CallbackService callbackService
@implements IDisposable

<PageTitle>Dagonie Empire | Campaigns</PageTitle>
<MudContainer Class="px-3" Fixed="false">
    @if (IsLoading == true){
        <LoadingPage></LoadingPage>
    }else{
        <MudBreadcrumbs Items="_items"></MudBreadcrumbs>
              
        <MudText Typo="Typo.h4" Class="py-3"><img src="@MyIcon.Bookmark" width="40px" height="40px" class="pr-2" />Avalible campaigns for: @UserInfo?.SelectedCharacter?.NPCName</MudText>
        
       
        @if (UserInfo?.HasGlobalCharacterAccess == true)
        {
            <div class="camp">
                <MudPaper Height="100px" Width="100%" Class="pa-3 mb-3 justify-content-center align-content-center" Style="cursor: pointer;" @onclick="CreateCampaign">
                    <MudText Typo="Typo.h5" Align="Align.Center"> Add new Campaign...</MudText>
                </MudPaper>
            </div>
        }
        

        <MudStack>
            @if(Campaigns is not null && Campaigns.Any())
            {
                @foreach(var camp in Campaigns)
                {
                    <div class="d-flex flex-column camp">
                        <MudPaper Class="campaign-tile" Style="position: relative; overflow: hidden; height: 200px;" Width="100%" @onclick="@(()=>ChooseCampaign(camp))">
                            @* Character portraits as background *@
                            <div class="portraits-background">
                                @foreach (var adv in camp.Characters.Take(6))
                                {
                                    <div class="portrait-slice">
                                        @if (!string.IsNullOrEmpty(adv.ImageUrl))
                                        {
                                            <img src="@adv.ImageUrl" alt="@adv.NPCName" />
                                        }
                                        else
                                        {
                                            <div class="portrait-placeholder">@adv.NPCName.ToUpper().First()</div>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="campaign-overlay">
                                <MudStack Spacing="0" Row="true" AlignItems="AlignItems.Center">
                                    <MudText Class="flex-grow-1 campaign-title" Typo="Typo.h5">@camp.Name</MudText>
                                    <span @onclick:stopPropagation="true" @onmousedown:stopPropagation="true">
                                        <WikiNavLink CampaignName="@camp.Name" Label="Wiki" Variant="Variant.Text" Color="Color.Info" Class="pa-0 campaign-action-link" />
                                    </span>
                                    <MudButton Class="campaign-action-icon"
                                               Variant="Variant.Text"
                                               OnClick="@(() => GoToLastPost(camp))"
                                               OnClickStopPropagation="true"
                                               aria-label="last post"
                                               Title="Last post">
                                        <img src="@MyIcon.ScrollWhite" alt="Last post" width="20" height="20" />
                                    </MudButton>
                                    @if (UserInfo?.HasGlobalCharacterAccess == true)
                                    {
                                        <MudIconButton Class="pa-1" Style="color: white;" Icon="@Icons.Material.Filled.Edit" aria-label="edit" OnClick="@(()=>EditCampaign(camp))" OnClickStopPropagation="true"></MudIconButton>
                                        <MudIconButton Class="pa-1" Style="color: white;" Icon="@Icons.Material.Filled.Delete" aria-label="delete" OnClick="@(()=>DeleteCampaign(camp.Id))" OnClickStopPropagation="true"></MudIconButton>
                                    }
                                </MudStack>
                                <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.8);">@camp.CreatedDate.ToString("dd-MM-yyyy")</MudText>
                                <MudText Class="py-1 campaign-description" Typo="Typo.body2">@camp.Description</MudText>
                                <div class="adventurer-names">
                                    @foreach (var adv in camp.Characters)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Style="color: white; background: rgba(255,255,255,0.15);">@adv.NPCName</MudChip>
                                    }
                                </div>
                            </div>
                        </MudPaper>
                    </div>
                }
            }
            else
            {
                <MudText Class="pt-3" Typo="Typo.h5">Not signed into any adventures yet</MudText>
            }
        </MudStack>
    }
    <MudPaper Width="100%" Square="true" Class="ma-2">
    </MudPaper>
</MudContainer>




@code{

    private IEnumerable<CharacterDTO> Characters { get; set; } = new List<CharacterDTO>();
    private List<CampaignDTO> Campaigns { get; set; } = new List<CampaignDTO>();
    public bool IsLoading { get; set; } = true;
    private string Title { get; set; } = "Your characters";
    public CampaignDTO NewCampaign { get; set; } = new();

    public UserInfo? UserInfo { get; set; }
    private List<BreadcrumbItem> _items = new List<BreadcrumbItem>();
    private System.Action handler;


    protected override async Task OnInitializedAsync()
    {
        UserInfo = await _userService.GetUserInfo();
        if (UserInfo?.IsAuthenticated != true)
        {
            var uri = new Uri(_navigationManager.Uri);
            _navigationManager.NavigateTo($"/account/login?returnUrl={uri.LocalPath}", forceLoad: true);
        }
        await LoadCharactersAndCampaigns();
        handler = async () => await LoadForSelectedCharacter();
        callbackService.OnChange += handler;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // if (UserInfo?.IsAuthenticated != true)
            // {
            //     var uri = new Uri(_navigationManager.Uri);
            //     _navigationManager.NavigateTo($"/account/login?returnUrl={uri.LocalPath}", forceLoad: true);
            // }

        }
    }

    public void Dispose()
    {
        callbackService.OnChange -= handler;
    }


    private async Task LoadForSelectedCharacter()
    {
        UserInfo = await _userService.GetUserInfo();
        IsLoading = true;
        StateHasChanged();
        if (UserInfo?.HasGlobalCharacterAccess == true)
        {
            Characters = await _characterRepository.GetAllApproved();
            
            if (UserInfo.CharacterMG == true)
            {
                Campaigns = (await _campaignRepository.GetAll()).ToList();
            }
            else
            {
                if (UserInfo?.SelectedCharacter is not null && UserInfo?.SelectedCharacter.Id > 0)
                    Campaigns = (await _campaignRepository.GetAll(UserInfo.SelectedCharacter.Id)).ToList();
                
            }
        }
        else
        {
            if (UserInfo?.IsDemoSession == true && UserInfo.SelectedCharacterId > 0)
            {
                var demo = await _characterRepository.GetById(UserInfo.SelectedCharacterId);
                Characters = demo.Id > 0 ? new[] { demo } : Array.Empty<CharacterDTO>();
            }
            else
            {
                Characters = await _characterRepository.GetAllApproved(UserInfo?.UserName);
            }
            if (UserInfo?.SelectedCharacter is not null && UserInfo?.SelectedCharacter.Id > 0 )
            {
                Campaigns = (await _campaignRepository.GetAll(UserInfo?.SelectedCharacter?.Id)).ToList();
            }
        }
        IsLoading = false;
        StateHasChanged();
    }

    private async Task LoadCharactersAndCampaigns()
    {
        IsLoading = true;
        StateHasChanged();
        _items = new List<BreadcrumbItem>
        {
            new BreadcrumbItem("Campaigns", href: $"/campaignlist/"),
        };

        await LoadForSelectedCharacter();
        IsLoading = false;
        StateHasChanged();
    }

    private async Task CreateCampaign()
    {

        var parameters = new DialogParameters<CreateCampaignDialog> { { x => x.NewCampaign, NewCampaign } };

        var dialog = await DialogService.ShowAsync<CreateCampaignDialog>("Create Campaign", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            NewCampaign = (CampaignDTO)result.Data;

            NewCampaign.GameMaster = UserInfo?.UserName;

            Campaigns.Add(await _campaignRepository.Create(NewCampaign));
        }
    }
    private async Task EditCampaign(CampaignDTO camp)
    {
        var parameters = new DialogParameters<CreateCampaignDialog> { { x => x.NewCampaign, camp }, { x => x.IsEdit, true } };

        var dialog = await DialogService.ShowAsync<CreateCampaignDialog>("Edit Campaign", parameters);
        var result = await dialog.Result;


        if (!result.Canceled)
        {
            NewCampaign = (CampaignDTO)result.Data;

            int index = Campaigns.FindIndex(u => u.Id == NewCampaign.Id);
            if (index >= 0)
                Campaigns[index] = await _campaignRepository.Update(NewCampaign);
        }
    }


    private async Task DeleteCampaign(int id)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
          "Warning",
          "Are you sure you want to delete this campaign?",
          yesText: "Yes", cancelText: "No");

        if (result is null || result == false)
        {
            return;
        }

        IsLoading = true;
        StateHasChanged();
        if (id != 0)
        {

            IsLoading = true;
            StateHasChanged();

            int index = Campaigns.FindIndex(u => u.Id == id);
            if (index >= 0)
            {
                await _campaignRepository.Delete(id);
                Campaigns = (await _campaignRepository.GetAll()).ToList();
            }

            IsLoading = false;
            StateHasChanged();
            await LoadCharactersAndCampaigns();
            await _jsRuntime.InvokeVoidAsync("HideDeleteConfirmationModal");
        }
        IsLoading = false;
        StateHasChanged();
    }


    private async Task ChooseCampaign(CampaignDTO campaign)
    {
        UserInfo = await _userService.GetUserInfo();
        _navigationManager.NavigateTo($"/campaign/{campaign.Id}");
    }

    private async Task GoToLastPost(CampaignDTO campaign)
    {
        try
        {
            var chapters = (await _chapterRepository.GetAll(campaign.Id)).ToList();
            if (!chapters.Any())
            {
                _snackBar.Add("This campaign does not have any chapters yet.", Severity.Info);
                return;
            }

            var chapterLastPosts = new List<(int ChapterId, DateTime CreatedDate)>();
            foreach (var chapter in chapters)
            {
                var lastPost = (await _postRepository.GetAll(chapter.Id))
                    .OrderByDescending(post => post.CreatedDate)
                    .FirstOrDefault();

                if (lastPost is not null)
                {
                    chapterLastPosts.Add((chapter.Id, lastPost.CreatedDate));
                }
            }

            var latestChapter = chapterLastPosts
                .OrderByDescending(x => x.CreatedDate)
                .FirstOrDefault();

            if (latestChapter.ChapterId == 0)
            {
                _snackBar.Add("No posts have been written in this campaign yet.", Severity.Info);
                return;
            }

            _navigationManager.NavigateTo($"/chapter/{latestChapter.ChapterId}?lastPage=true");
        }
        catch (Exception e)
        {
            _snackBar.Add("Error while going to latest post: " + e.Message, Severity.Error);
        }
    }


}