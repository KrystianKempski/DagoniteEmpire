@using DagoniteEmpire.Shared;
@using DagoniteEmpire.Account.Shared

    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <p> Ups! Brak uprawnień. Zaloguj się, aby zobaczyć treść.</p>
                </NotAuthorized>

            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Nie znaleziono</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert">Przepraszamy, pod tym adresem nic nie ma.</p>
            </LayoutView>
        </NotFound>
    </Router>
