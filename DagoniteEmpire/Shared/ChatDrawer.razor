@using DA_Business.Services
@using DA_Models.ChatModels
@using DagoniteEmpire.Helper
@inject ChatState ChatState
@inject IJSRuntime JsRuntime
@implements IDisposable

<MudDrawer Open="@ChatState.IsOpen"
           OpenChanged="OnOpenChanged"
           Anchor="Anchor.End"
           Elevation="4"
           Variant="DrawerVariant.Temporary"
           Width="420px"
           Class="chat-panel-drawer">
    <MudDrawerHeader Class="chat-panel-header">
        @if (ChatState.IsInThread)
        {
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           Size="Size.Small"
                           Color="Color.Inherit"
                           OnClick="Back" />
            <span class="chat-panel-title">@(ChatState.ThreadTitle ?? L["Chat"])</span>
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Outlined.Forum" Class="mr-2" Style="color:#f5f5f5;opacity:0.9" />
            <span class="chat-panel-title">@L["Chat"]</span>
        }
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Close"
                       Size="Size.Small"
                       Color="Color.Inherit"
                       OnClick="Close" />
    </MudDrawerHeader>

    <div class="chat-panel-body">
        @if (!ChatState.IsInThread)
        {
            <div class="chat-panel-contacts">
                @if (ChatState.IsLoading)
                {
                    <div class="chat-panel-empty">
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Style="color:#9c7a33" />
                    </div>
                }
                else if (!string.IsNullOrEmpty(ChatState.Error))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Outlined" Class="ma-2">@ChatState.Error</MudAlert>
                }
                else if (ChatState.Contacts.Count == 0)
                {
                    <div class="chat-panel-empty">
                        <MudIcon Icon="@Icons.Material.Outlined.ChatBubbleOutline" Style="font-size:2rem;opacity:0.4" />
                        <span>@L["No conversations yet"]</span>
                    </div>
                }
                else
                {
                    @foreach (var contact in ChatState.Contacts)
                    {
                        <button type="button"
                                class="chat-panel-contact @(contact.IsPartyChannel ? "chat-panel-contact--party" : null)"
                                @onclick="@(() => OpenContact(contact))">
                            <span class="chat-panel-avatar @(contact.IsPartyChannel ? "chat-panel-avatar--party" : null) @(contact.PeerIsGameMaster ? "chat-panel-avatar--gm" : null)">
                                @if (!string.IsNullOrWhiteSpace(contact.ImageUrl))
                                {
                                    <img src="@contact.ImageUrl" alt="" />
                                }
                                else if (contact.IsPartyChannel)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" />
                                }
                                else
                                {
                                    @Initials(contact.DisplayName)
                                }
                            </span>
                            <span class="chat-panel-contact-meta">
                                <span class="chat-panel-contact-top">
                                    <span class="chat-panel-contact-name">@contact.DisplayName</span>
                                    @if (contact.UnreadCount > 0)
                                    {
                                        <span class="chat-panel-unread">@contact.UnreadCount</span>
                                    }
                                </span>
                                <span class="chat-panel-preview">@(contact.LastMessagePreview ?? "\u00A0")</span>
                            </span>
                        </button>
                    }
                }
            </div>
        }
        else
        {
            <div class="chat-panel-messages" id="chat-panel-messages">
                @if (ChatState.HasMoreMessages)
                {
                    <div class="chat-panel-load-older">
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="LoadOlder">@L["Load older"]</MudButton>
                    </div>
                }
                @if (ChatState.IsLoading && ChatState.Messages.Count == 0)
                {
                    <div class="chat-panel-empty">
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Style="color:#9c7a33" />
                    </div>
                }
                else if (ChatState.Messages.Count == 0)
                {
                    <div class="chat-panel-empty">
                        <MudIcon Icon="@Icons.Material.Outlined.ChatBubbleOutline" Style="font-size:2rem;opacity:0.4" />
                        <span>@L["No conversations yet"]</span>
                    </div>
                }
                else
                {
                    @foreach (var msg in ChatState.Messages)
                    {
                        <div class="chat-panel-bubble-row @(msg.IsMine ? "mine" : "theirs")">
                            @if (!msg.IsMine)
                            {
                                <span class="chat-panel-avatar chat-panel-avatar--sm">
                                    @if (!string.IsNullOrWhiteSpace(msg.SenderImageUrl))
                                    {
                                        <img src="@msg.SenderImageUrl" alt="" />
                                    }
                                    else
                                    {
                                        @Initials(msg.SenderName)
                                    }
                                </span>
                            }
                            <div class="chat-panel-bubble @(msg.IsMine ? "mine" : "theirs")">
                                @if (!msg.IsMine)
                                {
                                    <span class="chat-panel-sender">@msg.SenderName</span>
                                }
                                <div class="chat-panel-text">@msg.Content</div>
                                <span class="chat-panel-time">@LocalTime(msg.CreatedUtc)</span>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="chat-panel-composer">
                <MudTextField @bind-Value="_draft"
                              Placeholder="@L["Type a message..."]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Lines="2"
                              Immediate="true"
                              OnKeyDown="HandleKeyDown"
                              Disabled="_sending" />
                <button type="button"
                        class="chat-panel-send"
                        disabled="@(_sending || string.IsNullOrWhiteSpace(_draft))"
                        title="@L["Send"]"
                        @onclick="Send">
                    <MudIcon Icon="@Icons.Material.Filled.Send" Size="Size.Small" Style="color:#f5f5f5" />
                </button>
            </div>
        }
    </div>
</MudDrawer>

@code {
    private string _draft = string.Empty;
    private bool _sending;
    private int _lastMessageCount;

    protected override async Task OnInitializedAsync()
    {
        ChatState.OnChange += OnStateChanged;
        await ChatState.EnsureInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ChatState.IsInThread && ChatState.Messages.Count > _lastMessageCount)
        {
            _lastMessageCount = ChatState.Messages.Count;
            try
            {
                await JsRuntime.ScrollToBottom("chat-panel-messages");
            }
            catch
            {
                // Element may not be in DOM yet.
            }
        }
        else
        {
            _lastMessageCount = ChatState.Messages.Count;
        }
    }

    private void OnOpenChanged(bool open)
    {
        if (open)
            _ = ChatState.OpenAsync();
        else
            ChatState.Close();
    }

    private void Close() => ChatState.Close();
    private void Back() => ChatState.BackToContacts();

    private async Task OpenContact(ChatContactDTO contact)
    {
        await ChatState.OpenContactAsync(contact);
        _lastMessageCount = 0;
    }

    private async Task LoadOlder() => await ChatState.LoadOlderAsync();

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await Send();
        }
    }

    private async Task Send()
    {
        if (_sending || string.IsNullOrWhiteSpace(_draft))
            return;

        _sending = true;
        var text = _draft;
        _draft = string.Empty;
        try
        {
            await ChatState.SendAsync(text);
        }
        finally
        {
            _sending = false;
            StateHasChanged();
        }
    }

    // Stored as UTC but the column is "timestamp without time zone", so the value comes back with an
    // unspecified kind and needs tagging before it can be converted.
    private static string LocalTime(DateTime createdUtc) =>
        DateTime.SpecifyKind(createdUtc, DateTimeKind.Utc).ToLocalTime().ToString("g");

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ChatState.OnChange -= OnStateChanged;
    }
}
