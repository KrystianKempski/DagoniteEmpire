@using DA_Business.Services
@inject ChatState ChatState
@implements IDisposable

@if (ChatState.IsVisible)
{
    <MudBadge Content="@(ChatState.UnreadTotal > 0 ? ChatState.UnreadTotal.ToString() : null)"
              Overlap="true"
              Visible="@(ChatState.UnreadTotal > 0)"
              Class="mr-1 chat-panel-launcher">
        <MudIconButton Icon="@Icons.Material.Outlined.Forum"
                       Color="Color.Inherit"
                       Title="@L["Chat"]"
                       OnClick="Toggle" />
    </MudBadge>
}

@code {
    private bool _subscribed;

    protected override async Task OnInitializedAsync()
    {
        if (!_subscribed)
        {
            ChatState.OnChange += OnStateChanged;
            _subscribed = true;
        }

        await ChatState.EnsureInitializedAsync();
    }

    private void Toggle() => ChatState.Toggle();

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (_subscribed)
        {
            ChatState.OnChange -= OnStateChanged;
            _subscribed = false;
        }
    }
}
