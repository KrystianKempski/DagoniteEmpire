
 @inject NavigationManager _navigationManager;
 @inject IUserService _userService
 @inject ICharacterRepository _characterRepository
 @inject ISnackbar _snackbar
 @inject CallbackService callbackService
 @inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage

<AuthorizeView>
    <Authorized>
        <div class="p-2 d-flex align-content-center">
            <div class="big-screen pa-4 justify-center my-4 mud-text-align-center">
                <MudButton Style="@($"color:{Colors.Gray.Lighten5}; background:{Colors.Gray.Darken4};")" Variant="Variant.Filled" Color="Color.Primary">Hi, @context.User.Identity.Name!</MudButton>
            </div>
            <MudMenu Dense="true" Color="Color.Dark">
                <ActivatorContent Context="menuContext">
                    <div tabindex="0" style="cursor: pointer;" @onclick="async () => { await RefreshCharacters(); await menuContext.ToggleAsync(); }">
                        <MudAvatar Size="Size.Small">
                            <MudImage @ref=DisplayImage ObjectPosition="ObjectPosition.Top" ObjectFit="ObjectFit.Cover" Src="@PortraitUrl" />
                        </MudAvatar>
                    </div>
                </ActivatorContent>
                <ChildContent >
                    <MudMenuItem  Disabled>@L["Select character"]</MudMenuItem>
                    @if (UserInfo?.HasGlobalCharacterAccess == true)
                    {
                        <MudMenuItem OnClick="@(e => SelectCharacter())">
                            <div class="d-flex flex-row">
                                <MudAvatar>
                                    <MudImage ObjectPosition="ObjectPosition.Top" ObjectFit="ObjectFit.Cover" Src="@SD.GameMaster_Portrait"></MudImage>
                                </MudAvatar>
                                <MudText Class="align-content-center ps-1">
                                    @SD.GameMaster_NPCName
                                </MudText>
                            </div>
                        </MudMenuItem>
                    }
                    @foreach (CharacterDTO character in Characters)
                    {
                        <MudMenuItem OnClick="@(e => SelectCharacter(character))">
                            <div class="d-flex flex-row">
                                <MudAvatar>
                                    <MudImage ObjectPosition="ObjectPosition.Top" ObjectFit="ObjectFit.Cover" Src="@GetCharacterIconUrl(character)"></MudImage>
                                </MudAvatar>
                                <MudText Class="align-content-center ps-1">
                                    @character.NPCName
                                </MudText>
                            </div>
                        </MudMenuItem>
                    }
                    <MudMenuItem Class="py-3" OnClick="@LogoutAsync">
                        @L["Log Out"]                        
                    </MudMenuItem>
                </ChildContent>
            </MudMenu>
        </div>

        

    </Authorized>
    <NotAuthorized>
        <div class="big-screen pa-4 justify-center my-4 mud-text-align-center">
            <MudButton Style="@($"color:{Colors.Gray.Lighten5}; background:{Colors.Gray.Darken4};")" Variant="Variant.Filled" Color="Color.Primary" Href="Account/Register">@L["Register"]</MudButton>
            <MudButton Style="@($"color:{Colors.Gray.Lighten5}; background:{Colors.Gray.Darken4};")" Variant="Variant.Filled" Color="Color.Secondary" Href="Account/Login">@L["Log in"]</MudButton>
        </div>
        <div class="small-screen">
            <MudMenu Color="Color.Inherit" Icon="@Icons.Material.Filled.AccountCircle">
                <MudMenuItem OnClick="@(() => GoTo("Register"))">@L["Register"]</MudMenuItem>
                <MudMenuItem OnClick="@(() => GoTo("Login"))">@L["Log in"]</MudMenuItem>
            </MudMenu>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    public string PortraitUrl { get; set; } = "/images/def-char-img.webp";
    public IEnumerable<CharacterDTO> Characters { get; set; } = new List<CharacterDTO>();
    public UserInfo? UserInfo {get;set;} = null;
    private MudImage DisplayImage;


    void GoTo(string panel)
    {
        if (panel == "Register")
            _navigationManager.NavigateTo("Account/Register");
        else if (panel == "Login")
            _navigationManager.NavigateTo("Account/Login");
        else if (panel == "Logout")
            _navigationManager.NavigateTo("Account/Logout");
    }

    protected override async Task OnInitializedAsync()
    {
        UserInfo = await _userService.GetUserInfo();
        PortraitUrl = "/images/def-char-img.webp";
        if (UserInfo is null || UserInfo?.UserName is null)
            return;

        Characters = await LoadVisibleCharacters();

        if(UserInfo.SelectedCharacterId > 0)
        {
            UserInfo.SelectedCharacter = Characters.FirstOrDefault(u => u.Id == UserInfo.SelectedCharacterId);
            await _userService.SetSelectedCharId(UserInfo.SelectedCharacterId);
            UserInfo = await _userService.GetUserInfo();
        }
        else if (Characters.Any() && UserInfo.IsAdminOrMG == false)
        {
            UserInfo.SelectedCharacter = Characters.First();
            await _userService.SetSelectedCharId(UserInfo.SelectedCharacter.Id);         
            UserInfo = await _userService.GetUserInfo();
        }
        else if (UserInfo.HasGlobalCharacterAccess){
            await _userService.SetSelectedCharId(-1);
            UserInfo = await _userService.GetUserInfo();
        }

        if (UserInfo?.SelectedCharacter is not null)
        {
            PortraitUrl = GetCharacterIconUrl(UserInfo.SelectedCharacter);
        }

        if (UserInfo?.SelectedCharacter is not null)
        {
            callbackService.SetSelectedChar((int)UserInfo.SelectedCharacter.Id);
        }
    }

    private async Task SelectCharacter(CharacterDTO? character = null)
    {
        try{
            if (UserInfo is null || UserInfo?.UserName is null)
                return;
            if(character == null)
                await _userService.SetSelectedCharId(-1); // set a GM
            else
                await _userService.SetSelectedCharId(character.Id);
            UserInfo = await _userService.GetUserInfo();


            if (UserInfo?.SelectedCharacter is not null)
            {
                PortraitUrl = GetCharacterIconUrl(UserInfo.SelectedCharacter);
            }
            else
            {
                PortraitUrl = SD.DefaultCharacterImage;
            }
            callbackService.SetSelectedChar((int)UserInfo?.SelectedCharacter?.Id);
        }
        catch(Exception ex)
        {
            _snackbar.Add(L["Error: "] + ex.Message, Severity.Error);
        }
    }

    private async Task RefreshCharacters()
    {
        UserInfo = await _userService.GetUserInfo();
        if (UserInfo is null || UserInfo?.UserName is null)
            UserInfo = await _userService.GetUserInfo();
        if (UserInfo is null|| UserInfo?.UserName is null)
            return;

        Characters = await LoadVisibleCharacters();
    }

    private async Task<IEnumerable<CharacterDTO>> LoadVisibleCharacters()
    {
        if (UserInfo?.HasGlobalCharacterAccess == true)
            return await _characterRepository.GetAllApproved();

        if (UserInfo?.IsDemoSession == true)
        {
            var id = UserInfo.SelectedCharacterId;
            if (id <= 0)
                return Array.Empty<CharacterDTO>();
            var character = await _characterRepository.GetById(id);
            return character.Id > 0 ? new[] { character } : Array.Empty<CharacterDTO>();
        }

        return await _characterRepository.GetAllApproved(UserInfo?.UserName);
    }

    private async Task LogoutAsync()
    {
        if (SD.IsDemoUserName(UserInfo?.UserName))
        {
            var t = await _sessionStorage.GetAsync<string>(ProtectedStorageKeys.DemoToken);
            if (t.Success && !string.IsNullOrWhiteSpace(t.Value))
            {
                _navigationManager.NavigateTo($"/Account/DemoExit?t={t.Value}", true);
                return;
            }
        }
        _navigationManager.NavigateTo("Account/Logout");
    }

    private static string GetCharacterIconUrl(CharacterDTO character) =>
        !string.IsNullOrEmpty(character.IconUrl)
            ? character.IconUrl
            : character.ImageUrl ?? SD.DefaultCharacterImage;
}
