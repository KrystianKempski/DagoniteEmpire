@using DA_Business.Services
@inject CampaignChatState ChatState
@implements IDisposable

@if (!AsFab)
{
    @* Always in the AppBar — MudHidden + iOS Safari never reports the breakpoint, so a
       phone-only FAB used to be the only launcher and then sat under the browser chrome. *@
    @if (ChatState.IsVisible)
    {
        <MudBadge Content="@(ChatState.UnreadTotal > 0 ? ChatState.UnreadTotal.ToString() : null)"
                  Overlap="true"
                  Visible="@(ChatState.UnreadTotal > 0)"
                  Class="mr-1 campaign-chat-launcher">
            <MudIconButton Icon="@Icons.Material.Outlined.Forum"
                           Color="Color.Inherit"
                           Title="@L["Chat"]"
                           OnClick="Toggle" />
        </MudBadge>
    }
}
else if (ChatState.IsVisible && !ChatState.IsOpen)
{
    <div class="campaign-chat-fab">
        <MudBadge Content="@(ChatState.UnreadTotal > 0 ? ChatState.UnreadTotal.ToString() : null)"
                  Overlap="true"
                  Visible="@(ChatState.UnreadTotal > 0)"
                  Class="campaign-chat-launcher">
            <button type="button"
                    class="campaign-chat-fab__btn"
                    title="@L["Chat"]"
                    @onclick="Toggle">
                <MudIcon Icon="@Icons.Material.Outlined.Forum" Class="campaign-chat-fab__icon" />
            </button>
        </MudBadge>
    </div>
}

@code {
    /// <summary>When true, render the mobile floating button instead of the AppBar icon.</summary>
    [Parameter] public bool AsFab { get; set; }

    private bool _subscribed;

    protected override async Task OnInitializedAsync()
    {
        if (!_subscribed)
        {
            ChatState.OnChange += OnStateChanged;
            _subscribed = true;
        }

        await ChatState.EnsureInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // ProtectedSessionStorage is unreliable in OnInitialized on iOS WebKit.
        // Reload once JS is ready so a cold phone session still finds the selected character.
        try
        {
            await ChatState.RefreshIdentityAsync();
        }
        catch
        {
            // Visibility stays as-is; character-change callbacks still retry.
        }
    }

    private void Toggle() => ChatState.Toggle();

    private void OnStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (_subscribed)
        {
            ChatState.OnChange -= OnStateChanged;
            _subscribed = false;
        }
    }
}
