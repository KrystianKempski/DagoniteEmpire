@using DA_Business.Services
@inject CampaignChatState ChatState
@implements IDisposable

@if (ChatState.IsVisible)
{
    <MudBadge Content="@(ChatState.UnreadTotal > 0 ? ChatState.UnreadTotal.ToString() : null)"
              Overlap="true"
              Visible="@(ChatState.UnreadTotal > 0)"
              Class="mr-1 campaign-chat-launcher">
        <MudIconButton Icon="@Icons.Material.Outlined.Forum"
                       Color="Color.Inherit"
                       Title="@L["Chat"]"
                       OnClick="Toggle" />
    </MudBadge>
}

@code {
    private bool _subscribed;

    protected override async Task OnInitializedAsync()
    {
        if (!_subscribed)
        {
            ChatState.OnChange += OnStateChanged;
            _subscribed = true;
        }

        await ChatState.EnsureInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // ProtectedSessionStorage is unreliable in OnInitialized on iOS WebKit.
        try
        {
            await ChatState.RefreshIdentityAsync();
        }
        catch
        {
        }
    }

    private void Toggle() => ChatState.Toggle();

    private void OnStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (_subscribed)
        {
            ChatState.OnChange -= OnStateChanged;
            _subscribed = false;
        }
    }
}
