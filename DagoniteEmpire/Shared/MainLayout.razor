@using DA_Business.Services

@inject ISnackbar _snackBar
@inject IJSRuntime _jsRuntime
@inject IUserService _userService
@inject ICharacterRepository _characterRepo
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ChatState ChatState
@inherits LayoutComponentBase
@implements IDisposable

<PageTitle>@L["DagoniteEmpire"]</PageTitle>
<link rel="icon" type="image/svg+xml" href="/icons/Dragon.svg">

<MudThemeProvider/>
<MudPopoverProvider />
<MudDialogProvider 
FullWidth="true" 
MaxWidth="MaxWidth.Large" />
<MudSnackbarProvider />    


<MudLayout>
    <MudAppBar Class="app-bar" Style="@($"color:{Colors.Gray.Lighten5}; background:{Colors.Gray.Darken4};")" Elevation="1">
        <MudHidden Breakpoint="Breakpoint.MdAndDown" Invert="true">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerStartToggle())" />
        </MudHidden>
        <MudButton Class="app-bar-title p-0 m-0" Style="@($"color:{Colors.Gray.Lighten5}; background:{Colors.Gray.Darken4};")" Variant="Variant.Text" DropShadow="true" Color="Color.Primary" Href="#">
            <img src="/icons/Dragon_white.svg" alt="" class="app-bar-dragon-icon" />
            <span class="app-bar-title__text">@L["Dagonite Empire"]</span>
        </MudButton>
        @* Horizontal nav only above drawer breakpoint; on mobile/tablet use MudDrawer instead. *@
        <MudHidden Breakpoint="Breakpoint.MdAndDown">
            <div class="app-bar-nav">
                <AuthorizeView>
                    <Authorized>
                        <CharacterNavButtons></CharacterNavButtons>
                    </Authorized>
                </AuthorizeView>
            </div>
        </MudHidden>

        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <ChatLauncher />
            </Authorized>
        </AuthorizeView>
        <LanguageSwitcher />
        <LoginDisplay />
    </MudAppBar>
    <AuthorizeView>
        <Authorized>
            <ChatDrawer />
        </Authorized>
    </AuthorizeView>
    <MudHidden Breakpoint="Breakpoint.MdAndDown" Invert="true">
        <CascadingValue Value="@_drawerOpen">
            <MudDrawer Style="@($"color:{Colors.Gray.Lighten5}; z-index:2000; background:{Colors.Gray.Darken4};")" @bind-Open="_drawerOpen" Elevation="1">
                <NavMenu OnDrawerChanged="DrawerChange" />
            </MudDrawer>
        </CascadingValue>
    </MudHidden>

    <MudMainContent >   
        @Body
    </MudMainContent>

</MudLayout>



@code {

    private MudTheme Theme = new MudTheme();

    void DrawerStartToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    bool _drawerOpen;


    private void DrawerChange()
    {
        DrawerStartToggle();
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (state.User.Identity?.IsAuthenticated != true)
            {
                await _userService.LogOut();
            }
            else
            {
                // Reclaim the browser push endpoint for this Identity user. Same device can stay
                // subscribed after GM ↔ player logout; without this the tray still follows the old UserId.
                await TryClaimPushSubscriptionAsync();
                await TryApplyDeepLinksAsync();
            }
        }
        catch
        {
            // Ignore during prerender / reconnect — cookie auth is authoritative.
        }
    }

    private async Task TryClaimPushSubscriptionAsync()
    {
        try
        {
            await _jsRuntime.InvokeVoidAsync("dagonitePush.claimForCurrentUser");
        }
        catch
        {
            // Push is optional; missing JS during prerender must not break the layout.
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _ = InvokeAsync(TryApplyDeepLinksAsync);
    }

    private async Task TryApplyDeepLinksAsync()
    {
        // The barony link reloads the page once the right barony is selected, and the stripped URL
        // comes back through LocationChanged — so the chat link gets its turn then.
        if (await TryApplyBaronyCharacterDeepLinkAsync())
            return;

        await TryApplyChatDeepLinkAsync();
    }

    /// <summary>
    /// Barony notifications carry <c>?character={id}</c> because barony pages read their barony from
    /// the selected character. Without it a Game Master running several baronies (or a player with two
    /// baron characters) lands on whichever barony they browsed last and the thread id is dropped.
    /// Returns true when the link was ours, so the caller stops — a switch reloads the page.
    /// </summary>
    private async Task<bool> TryApplyBaronyCharacterDeepLinkAsync()
    {
        try
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
            if (!query.TryGetValue("character", out var raw))
                return false;

            // Always leave with the parameter gone, so a refresh cannot switch characters again.
            var stripped = StripQueryParam(uri, "character");

            if (!int.TryParse(raw.ToString(), out var characterId) || characterId <= 0)
            {
                Navigation.NavigateTo(stripped, replace: true);
                return true;
            }

            var user = await _userService.GetUserInfo();
            if (user is null || !await MaySelectCharacterAsync(user, characterId))
            {
                Navigation.NavigateTo(stripped, replace: true);
                return true;
            }

            if (user.SelectedCharacter?.Id == characterId)
            {
                Navigation.NavigateTo(stripped, replace: true);
                return true;
            }

            await _userService.SetSelectedCharId(characterId);
            // Session storage holds the selection, so the target page has to be rendered afresh.
            Navigation.NavigateTo(stripped, forceLoad: true);
            return true;
        }
        catch
        {
            return false;
        }
    }

    /// <summary>
    /// A link must not hand someone another player's character. Game Masters switch freely — that is
    /// how they visit baronies — everyone else only to a character they own.
    /// </summary>
    private async Task<bool> MaySelectCharacterAsync(UserInfo user, int characterId)
    {
        if (user.IsAdminOrMG == true || user.Role == SD.Role_Admin || user.Role == SD.Role_GameMaster)
            return true;

        if (string.IsNullOrWhiteSpace(user.UserName))
            return false;

        var character = await _characterRepo.GetById(characterId);
        return character.Id == characterId
            && string.Equals(character.UserName, user.UserName, StringComparison.OrdinalIgnoreCase);
    }

    private static string StripQueryParam(Uri uri, string name)
    {
        var kept = Microsoft.AspNetCore.WebUtilities.QueryHelpers
            .ParseQuery(uri.Query)
            .Where(p => !string.Equals(p.Key, name, StringComparison.OrdinalIgnoreCase))
            .SelectMany(p => p.Value.Select(v => (p.Key, Value: v)))
            .ToList();

        var path = string.IsNullOrEmpty(uri.AbsolutePath) ? "/" : uri.AbsolutePath;
        return kept.Count == 0
            ? path
            : Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(
                path,
                kept.Select(p => new KeyValuePair<string, string?>(p.Key, p.Value)));
    }

    private async Task TryApplyChatDeepLinkAsync()
    {
        try
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
            if (!query.TryGetValue("chat", out var chatValue))
                return;

            var raw = chatValue.ToString();
            if (string.IsNullOrWhiteSpace(raw))
                return;

            if (!long.TryParse(raw, out var conversationId) || conversationId <= 0)
                return;

            await ChatState.ApplyDeepLinkAsync(conversationId);

            // Strip the query so refreshing does not reopen forever.
            var path = uri.AbsolutePath;
            if (string.IsNullOrEmpty(path) || path == "/")
                path = "/";
            Navigation.NavigateTo(path, replace: true);
        }
        catch
        {
            // Deep link is best-effort.
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}