<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DA_Scribe</RootNamespace>
    <!-- Semantic Kernel marks Ollama/agents/experimental APIs with these codes -->
    <NoWarn>$(NoWarn);SKEXP0001;SKEXP0010;SKEXP0070;SKEXP0110</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Vector Database -->
    <PackageReference Include="Pgvector" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" />
    
    <!-- Document Parsing -->
    <PackageReference Include="DocumentFormat.OpenXml" />
    
    <!-- HTTP Client for Ollama -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />

    <!-- Semantic Kernel (agent orchestration over Ollama) -->
    <PackageReference Include="Microsoft.SemanticKernel" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Ollama" />
    <PackageReference Include="Microsoft.SemanticKernel.Agents.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DA_DataAccess\DA_DataAccess.csproj" />
    <ProjectReference Include="..\DA_Models\DA_Models.csproj" />
  </ItemGroup>

</Project>
