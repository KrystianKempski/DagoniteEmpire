<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DA_Business.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="DateModel.cs~RFa04e0b4.TMP" />
  </ItemGroup>

  <ItemGroup>
    <!-- Commander skill tree data: keep the docs spreadsheet export as the single source of truth. -->
    <EmbeddedResource Include="..\docs\barony\commander-skill-tree.json">
      <Link>Barony\commander-skill-tree.json</Link>
      <LogicalName>DA_Common.Barony.commander-skill-tree.json</LogicalName>
    </EmbeddedResource>
    <!-- Authored Eastern March map (node positions + trade/road links) seeded globally for every barony. -->
    <EmbeddedResource Include="Barony\SeedData\eastern-march-map.json">
      <LogicalName>DA_Common.Barony.SeedData.eastern-march-map.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

</Project>
